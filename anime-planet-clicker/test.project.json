{
  "name": "PlanetCrackersTest",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "AutoTest": {
        "$path": "tests/AutoTest.server.luau"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        },
        "AutoTestClient": {
          "$path": "tests/AutoTestClient.client.luau"
        }
      },
      "$properties": {
        "CameraMaxZoomDistance": 70
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    },
    "Workspace": {
      "$properties": {
        "Gravity": 196.2,
        "StreamingEnabled": true,
        "StreamingMinRadius": 160,
        "StreamingTargetRadius": 420
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "ShadowMap",
        "Brightness": 2.4,
        "ClockTime": 15,
        "GlobalShadows": true
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "__AutoTest": {
        "$className": "BoolValue"
      }
    }
  }
}