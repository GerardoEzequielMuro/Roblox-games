        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">ko</string>
            <string name="Source"><![CDATA[-- Korean (ko). Same keys as en.luau.
return {
	-- HUD
	["hud.power"] = "파워",
	["hud.ki"] = "KI",
	["hud.rate"] = "{stat}: 펀치당 +{n} · 자동 {auto}/초",
	["hud.moves"] = "기술",
	["hud.auto_train"] = "자동 수련",
	["hud.auto_ki"] = "자동 Ki",
	["hud.auto_fight"] = "자동 전투",
