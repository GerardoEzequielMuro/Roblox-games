	{ kind = "boss", npc = "forge_tyrant", target = 1, sparks = 400_000, gems = 15, guide = "boss" },
	{ kind = "travel", planet = 3, target = 1, sparks = 3_000_000, gems = 10, guide = "none" },
	{ kind = "boss", npc = "rime_empress", target = 1, sparks = 30_000_000, gems = 20, guide = "boss" },
	{ kind = "rebirth", target = 1, sparks = 0, gems = 25, guide = "none" },
	{ kind = "travel", planet = 4, target = 1, sparks = 300_000_000, gems = 15, guide = "none" },
	{ kind = "boss", npc = "tempest_warden", target = 1, sparks = 3_000_000_000, gems = 25, guide = "boss" },
