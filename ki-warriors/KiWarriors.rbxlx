      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">LiveEvents</string>
          <string name="Source"><![CDATA[--!strict
-- Live event schedule (pure; unit-tested with luau.exe). Times are UTC unix seconds.
--   recurring: { id, every, offset, duration } -> active while (now - offset) % every < duration
--   weekly:    { id, fromWday, toWday, allDayUTC } -> active on those UTC weekdays (wraps: 7 -> 1)
-- An admin override { id, endsAt } wins while endsAt > now.
local Config: any = if script then require(script.Parent.Config) :: any else (require :: any)("./Config")

local LiveEvents = {}

export type Active = { id: string, endsAt: number }
export type Override = { id: string, endsAt: number }

local DAY = 86400

local function inWeekRange(wday: number, from: number, to: number): boolean
	if from <= to then
		return wday >= from and wday <= to
	end
	return wday >= from or wday <= to
end

-- Every active event, override first, then recurring, then weekly.
function LiveEvents.active(now: number, override: Override?): { Active }
	local list: { Active } = {}
	local seen: { [string]: boolean } = {}
	if override and override.endsAt > now and Config.LiveEventDefs[override.id] then
		table.insert(list, { id = override.id, endsAt = override.endsAt })
		seen[override.id] = true
	end
	for _, r in Config.LiveEvents.recurring do
		local phase = (now - r.offset) % r.every
		if phase < r.duration and not seen[r.id] then
			table.insert(list, { id = r.id, endsAt = now - phase + r.duration })
			seen[r.id] = true
		end
	end
	for _, w in Config.LiveEvents.weekly do
		local wday = (os.date("!*t", now) :: any).wday :: number
		if inWeekRange(wday, w.fromWday, w.toWday) and not seen[w.id] then
			-- ends at the UTC midnight after the last day of the range
			local dayStart = now - now % DAY
			local d = wday
			local endsAt = dayStart + DAY
			while d ~= w.toWday do
				d = d % 7 + 1
				endsAt += DAY
			end
			table.insert(list, { id = w.id, endsAt = endsAt })
			seen[w.id] = true
		end
	end
	return list
end

function LiveEvents.current(now: number, override: Override?): Active?
	return LiveEvents.active(now, override)[1]
end

-- Next start time of a recurring event (strictly after now) and its id.
function LiveEvents.nextStart(now: number): (number?, string?)
	local best: number?, bestId: string? = nil, nil
	for _, r in Config.LiveEvents.recurring do
		local phase = (now - r.offset) % r.every
		local t = now - phase + r.every
		if not best or t < best then
			best, bestId = t, r.id
		end
	end
	return best, bestId
end

-- Combined multipliers of every active event.
function LiveEvents.effects(active: { Active }): { trainMult: number, sparkMult: number }
	local train, spark = 1, 1
	for _, a in active do
		local def = Config.LiveEventDefs[a.id]
		if def then
			train *= def.trainMult or 1
			spark *= def.sparkMult or 1
		end
	end
	return { trainMult = train, sparkMult = spark }
end

return LiveEvents
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Locale</string>
          <string name="Source"><![CDATA[--!strict
-- Localization. Pure Luau (also loaded by tests/locale_check.luau with luau.exe).
-- Locales/<code>.luau return flat { [key] = "text with {name} placeholders" }.
-- Message values sent by the server are { key = string, args = { ... }? }; any arg that is
-- itself such a table is translated too (e.g. a zone name inside an error message).
local Locale = {}

export type Message = { key: string, args: { [string]: any }? }

Locale.Default = "en"
Locale.Languages = {
	{ code = "en", name = "English", flag = "🇺🇸" },
	{ code = "es", name = "Español", flag = "🇪🇸" },
	{ code = "pt", name = "Português", flag = "🇧🇷" },
	{ code = "fr", name = "Français", flag = "🇫🇷" },
	{ code = "de", name = "Deutsch", flag = "🇩🇪" },
	{ code = "id", name = "Bahasa Indonesia", flag = "🇮🇩" },
	{ code = "tr", name = "Türkçe", flag = "🇹🇷" },
	{ code = "ru", name = "Русский", flag = "🇷🇺" },
	{ code = "ja", name = "日本語", flag = "🇯🇵" },
	{ code = "ko", name = "한국어", flag = "🇰🇷" },
	{ code = "th", name = "ไทย", flag = "🇹🇭" },
	{ code = "vi", name = "Tiếng Việt", flag = "🇻🇳" },
}
Locale.Supported = {} :: { [string]: boolean }
for _, l in Locale.Languages do
	Locale.Supported[l.code] = true
end

local packs: { [string]: { [string]: string } } = {}
local function load(code: string): { [string]: string }?
	local pack = packs[code]
	if pack then
		return pack
	end
	if not Locale.Supported[code] then
		return nil
	end
	local ok, result = pcall(function()
		if script then
			return (require :: any)((script :: any).Parent.Locales[code])
		end
		return (require :: any)("./Locales/" .. code)
	end)
	if ok and type(result) == "table" then
		packs[code] = result
		return result
	end
	return nil
end
Locale.pack = load

-- Proper names (planets, forms, techniques, enemies, currencies...) live in ONE file,
-- Names.luau, shared by every language; a locale pack may still override a key.
local names: { [string]: string }? = nil
local function properName(key: string): string?
	if names == nil then
		local ok, result = pcall(function()
			if script then
				return (require :: any)((script :: any).Parent.Names)
			end
			return (require :: any)("./Names")
		end)
		names = if ok and type(result) == "table" then result else {}
	end
	return (names :: { [string]: string })[key]
end
Locale.properName = properName

-- Placeholders every text may use without passing an argument: they resolve to a proper name.
Locale.AutoArgs = { sparks = "currency.sparks", gems = "currency.gems" } :: { [string]: string }

local function format(lang: string, template: string, args: { [string]: any }?): string
	if not template:find("{", 1, true) then
		return template
	end
	return (template:gsub("{(%w+)}", function(name: string): string
		local v = if args then (args :: any)[name] else nil
		if v == nil then
			local auto = Locale.AutoArgs[name]
			if auto then
				return Locale.t(lang, auto)
			end
			return "{" .. name .. "}"
		elseif type(v) == "table" and type(v.key) == "string" then
			return Locale.t(lang, v.key, v.args)
		end
		return tostring(v)
	end))
end

-- Translated text for key; falls back to English, then to the key itself.
function Locale.t(lang: string, key: string, args: { [string]: any }?): string
	local pack = load(lang)
	local s = (pack and pack[key]) or properName(key)
	if not s and lang ~= Locale.Default then
		local en = load(Locale.Default)
		s = en and en[key]
	end
	return format(lang, s or key, args)
end

-- Renders a server message ({ key, args }) or passes a plain string through.
function Locale.msg(lang: string, m: any): string
	if type(m) == "table" and type(m.key) == "string" then
		return Locale.t(lang, m.key, m.args)
	end
	return if m == nil then "" else tostring(m)
end

-- Roblox LocaleId ("es-es", "pt-br", "zh-cn", "en_us"...) -> supported code (default "en").
function Locale.resolve(localeId: string?): string
	if type(localeId) ~= "string" then
		return Locale.Default
	end
	local base = localeId:lower():match("^(%a+)") or ""
	if base == "in" then
		base = "id" -- legacy Indonesian code
	end
	return if Locale.Supported[base] then base else Locale.Default
end

-- First candidate locale ("es-ar", "", nil...) that maps to a supported language, else the
-- default. The client passes its sources in priority order (see Lang.luau).
function Locale.resolveFirst(...: string?): string
	for i = 1, select("#", ...) do
		local id = select(i, ...)
		if type(id) == "string" then
			local base = id:lower():match("^(%a+)") or ""
			if base == "in" then
				base = "id"
			end
			if Locale.Supported[base] then
				return base
			end
		end
	end
	return Locale.Default
end

-- Server helper: a message the client translates.
function Locale.m(key: string, args: { [string]: any }?): Message
	return { key = key, args = args }
end

return Locale
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="11">
