		cliffLow = Color3.fromRGB(86, 136, 196),
		cliffMid = Color3.fromRGB(150, 200, 240),
		cliffTop = Color3.fromRGB(250, 252, 255),
		accent = Color3.fromRGB(120, 235, 255),
		accent2 = Color3.fromRGB(200, 160, 255),
		foliage = { Color3.fromRGB(60, 130, 140), Color3.fromRGB(240, 250, 255), Color3.fromRGB(110, 200, 230) },
		trunk = Color3.fromRGB(90, 80, 100),
		prop = "pine",
	},
	storm = {
		ground = Color3.fromRGB(104, 116, 150),
		groundMat = Enum.Material.Slate,
		patchA = Color3.fromRGB(134, 140, 180),
		patchB = Color3.fromRGB(74, 84, 120),
		path = Color3.fromRGB(210, 212, 230),
		plaza = Color3.fromRGB(80, 90, 130),
		plazaTrim = Color3.fromRGB(255, 232, 90),
		rock = Color3.fromRGB(70, 78, 108),
		cliffLow = Color3.fromRGB(50, 56, 88),
		cliffMid = Color3.fromRGB(92, 100, 150),
		cliffTop = Color3.fromRGB(200, 210, 245),
		accent = Color3.fromRGB(255, 236, 100),
		accent2 = Color3.fromRGB(120, 230, 255),
		foliage = { Color3.fromRGB(90, 100, 150), Color3.fromRGB(150, 160, 210), Color3.fromRGB(255, 236, 100) },
		trunk = Color3.fromRGB(60, 64, 90),
		prop = "pylon",
	},
	void = {
		ground = Color3.fromRGB(44, 30, 76),
		groundMat = Enum.Material.Slate,
		patchA = Color3.fromRGB(72, 42, 120),
		patchB = Color3.fromRGB(24, 16, 44),
		path = Color3.fromRGB(120, 86, 190),
		plaza = Color3.fromRGB(34, 24, 60),
		plazaTrim = Color3.fromRGB(255, 80, 210),
		rock = Color3.fromRGB(30, 20, 52),
		cliffLow = Color3.fromRGB(18, 12, 34),
		cliffMid = Color3.fromRGB(56, 34, 100),
		cliffTop = Color3.fromRGB(255, 80, 210),
		accent = Color3.fromRGB(255, 80, 210),
		accent2 = Color3.fromRGB(90, 240, 255),
		foliage = { Color3.fromRGB(80, 40, 140), Color3.fromRGB(255, 80, 210), Color3.fromRGB(90, 240, 255) },
		trunk = Color3.fromRGB(24, 16, 40),
		prop = "shard",
	},
}
WorldBuilder.Themes = Themes

---------------------------------------------------------------------------
-- Part helpers
---------------------------------------------------------------------------
local partCount = 0

local function base(parent: Instance, className: string): BasePart
	local p = Instance.new(className) :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	p.CastShadow = false
	p.Parent = parent
	partCount += 1
	return p
end

type Opts = { mat: Enum.Material?, collide: boolean?, shadow: boolean?, trans: number?, name: string?, anim: string? }

local function finish(p: BasePart, color: Color3, o: Opts?)
	p.Color = color
	if o then
		if o.mat then
			p.Material = o.mat
		end
		if o.collide == false then
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
		end
		if o.shadow then
			p.CastShadow = true
		end
		if o.trans then
			p.Transparency = o.trans
		end
		if o.name then
			p.Name = o.name
		end
		if o.anim then
			p:SetAttribute("KiwAnim", o.anim)
		end
	end
end

local function block(parent: Instance, cf: CFrame, size: Vector3, color: Color3, o: Opts?): BasePart
	local p = base(parent, "Part")
	p.Size = size
	p.CFrame = cf
	finish(p, color, o)
	return p
end

-- Upright cylinder: centre position, radius, height.
local function cyl(parent: Instance, pos: Vector3, radius: number, height: number, color: Color3, o: Opts?): BasePart
	local p = base(parent, "Part") :: Part
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(height, radius * 2, radius * 2)
	p.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	finish(p, color, o)
	return p
end

-- Cylinder along any axis (cf's X axis is the cylinder axis after the helper's rotation).
local function rod(parent: Instance, cf: CFrame, radius: number, length: number, color: Color3, o: Opts?): BasePart
	local p = base(parent, "Part") :: Part
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(length, radius * 2, radius * 2)
	p.CFrame = cf
	finish(p, color, o)
	return p
end

local function ball(parent: Instance, pos: Vector3, radius: number, color: Color3, o: Opts?): BasePart
	local p = base(parent, "Part") :: Part
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(radius * 2, radius * 2, radius * 2)
	p.CFrame = CFrame.new(pos)
	finish(p, color, o)
	return p
end

-- Ellipsoid (built-in sphere mesh stretched to the part size).
local function blob(parent: Instance, cf: CFrame, size: Vector3, color: Color3, o: Opts?): BasePart
	local p = base(parent, "Part")
	p.Size = size
	p.CFrame = cf
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = p
	finish(p, color, o)
	return p
end

local function _wedge(parent: Instance, cf: CFrame, size: Vector3, color: Color3, o: Opts?): BasePart
	local p = base(parent, "WedgePart")
	p.Size = size
	p.CFrame = cf
	finish(p, color, o)
	return p
end

local NEON: Opts = { mat = Enum.Material.Neon, collide = false }
local DECOR: Opts = { collide = false }

-- A floating ring. The server only places an invisible marker; each client builds the ring
-- from thin segments and animates it (WorldFx), so it costs one replicated part.
local function ring(parent: Instance, pos: Vector3, radius: number, thick: number, color: Color3, motion: string, phase: number?)
	local p = base(parent, "Part")
	p.Name = "Ring"
	p.Size = Vector3.new(1, 1, 1)
	p.CFrame = CFrame.new(pos)
	p.Transparency = 1
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Color = color
	p:SetAttribute("KiwAnim", "ring")
	p:SetAttribute("KiwRadius", radius)
	p:SetAttribute("KiwThick", thick)
	p:SetAttribute("KiwMotion", motion)
	p:SetAttribute("KiwPhase", phase or 0)
end

local function light(parent: BasePart, color: Color3, range: number, brightness: number?)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness or 1.2
	l.Shadows = false
	l.Parent = parent
end

-- A board with localized text lines. lines: { { key = "zone.x" } | { text = "x4" } }
local function sign(parent: Instance, cf: CFrame, size: Vector3, color: Color3, lines: { { key: string?, text: string?, color: Color3?, n: string? } }): BasePart
	local board = block(parent, cf, size, color, { name = "Sign" })
	board.CanCollide = false
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 24
		gui.LightInfluence = 0
		gui.Brightness = 1
		gui.Parent = board
		local list = Instance.new("UIListLayout")
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.VerticalAlignment = Enum.VerticalAlignment.Center
		list.Parent = gui
		for i, line in lines do
			local t = Instance.new("TextLabel")
			t.BackgroundTransparency = 1
			t.Size = UDim2.new(1, 0, if i == 1 then 0.5 else 0.5 / math.max(1, #lines - 1), 0)
			t.Font = Enum.Font.GothamBlack
			t.TextScaled = true
			t.TextColor3 = line.color or Color3.new(1, 1, 1)
			t.Text = line.text or ""
			t.LayoutOrder = i
			if line.key then
				t:SetAttribute("LocKey", line.key)
				if line.n then
					t:SetAttribute("LocN", line.n)
				end
			end
			local s = Instance.new("UIStroke")
			s.Thickness = 3
			s.Color = Color3.fromRGB(20, 16, 36)
			s.Parent = t
			t.Parent = gui
		end
	end
	return board
end

-- Two-post standing sign.
local function standSign(parent: Instance, pos: Vector3, facing: Vector3, color: Color3, lines: { any }, width: number?)
	local w = width or 16
	local look = CFrame.lookAt(pos, pos + facing)
	for _, side in { -1, 1 } do
		block(parent, look * CFrame.new(side * (w / 2 - 0.6), 4, 0), Vector3.new(1, 8, 1), Color3.fromRGB(60, 52, 70), DECOR)
	end
	sign(parent, look * CFrame.new(0, 8.5, 0), Vector3.new(w, 6, 0.6), color, lines)
end

---------------------------------------------------------------------------
-- Props
---------------------------------------------------------------------------
local function tree(parent: Instance, pos: Vector3, s: number, th: Theme, rng: Random)
	cyl(parent, pos + Vector3.new(0, 4 * s, 0), 0.9 * s, 8 * s, th.trunk, DECOR)
	local c = th.foliage[rng:NextInteger(1, #th.foliage)]
	blob(parent, CFrame.new(pos + Vector3.new(0, 10 * s, 0)), Vector3.new(9, 7.5, 9) * s, c, DECOR)
	blob(parent, CFrame.new(pos + Vector3.new(2 * s, 13 * s, 1 * s)), Vector3.new(6, 5, 6) * s, c:Lerp(Color3.new(1, 1, 1), 0.16), DECOR)
	blob(parent, CFrame.new(pos + Vector3.new(-2.4 * s, 8.4 * s, -1.4 * s)), Vector3.new(5.5, 4.5, 5.5) * s, c:Lerp(Color3.new(0, 0, 0), 0.14), DECOR)
end

local function pine(parent: Instance, pos: Vector3, s: number, th: Theme)
	cyl(parent, pos + Vector3.new(0, 2 * s, 0), 0.7 * s, 4 * s, th.trunk, DECOR)
	for i = 0, 2 do
		local r = (4.2 - i * 1.2) * s
		cyl(parent, pos + Vector3.new(0, (4.4 + i * 2.6) * s, 0), r, 2.4 * s, th.foliage[1]:Lerp(th.foliage[2], i * 0.12), DECOR)
		cyl(parent, pos + Vector3.new(0, (5.7 + i * 2.6) * s, 0), r * 0.82, 0.5 * s, th.foliage[2], DECOR)
	end
end

local function spire(parent: Instance, pos: Vector3, s: number, th: Theme, rng: Random)
	local tilt = CFrame.Angles(math.rad(rng:NextNumber(-10, 10)), rng:NextNumber(0, 6.28), math.rad(rng:NextNumber(-10, 10)))
	local cf = CFrame.new(pos) * tilt
	block(parent, cf * CFrame.new(0, 3 * s, 0), Vector3.new(3.4, 6, 3.4) * s, th.foliage[1], DECOR)
	block(parent, cf * CFrame.new(0, 7.5 * s, 0), Vector3.new(2.4, 4, 2.4) * s, th.foliage[2], DECOR)
	block(parent, cf * CFrame.new(0, 10.4 * s, 0) * CFrame.Angles(0, math.rad(45), 0), Vector3.new(1.3, 2.2, 1.3) * s, th.foliage[3], NEON)
end

local function pylon(parent: Instance, pos: Vector3, s: number, th: Theme)
	cyl(parent, pos + Vector3.new(0, 5 * s, 0), 0.8 * s, 10 * s, th.trunk, DECOR)
	cyl(parent, pos + Vector3.new(0, 10.6 * s, 0), 1.6 * s, 0.8 * s, th.foliage[2], DECOR)
	ball(parent, pos + Vector3.new(0, 12.4 * s, 0), 1.1 * s, th.accent, NEON)
end

local function shard(parent: Instance, pos: Vector3, s: number, th: Theme, rng: Random)
	local c = if rng:NextNumber() < 0.5 then th.accent else th.accent2
	local cf = CFrame.new(pos + Vector3.new(0, (3 + rng:NextNumber(0, 5)) * s, 0)) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, 6.28), rng:NextNumber(-0.5, 0.5))
	local p = block(parent, cf, Vector3.new(1.6, 7, 1.6) * s, c, { mat = Enum.Material.Neon, collide = false, anim = "bob" })
	p:SetAttribute("KiwPhase", rng:NextNumber(0, 6.28))
	block(parent, cf * CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(45), 0), Vector3.new(2.2, 3.2, 2.2) * s, th.foliage[1], DECOR)
end

local function rock(parent: Instance, pos: Vector3, s: number, th: Theme, rng: Random)
	local cf = CFrame.new(pos + Vector3.new(0, 1.2 * s, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6.28), rng:NextNumber(-0.3, 0.3))
	block(parent, cf, Vector3.new(4.5, 3, 3.6) * s, th.rock, { collide = true })
	block(parent, cf * CFrame.new(1.2 * s, 1.4 * s, 0.4 * s) * CFrame.Angles(0.3, 0.6, 0.2), Vector3.new(2.6, 2, 2.4) * s, th.rock:Lerp(Color3.new(1, 1, 1), 0.14), DECOR)
end

local function crystal(parent: Instance, pos: Vector3, s: number, color: Color3, rng: Random)
	for i = 1, 3 do
		local a = rng:NextNumber(0, 6.28)
		local h = (3 + rng:NextNumber(0, 4)) * s
		local cf = CFrame.new(pos + Vector3.new(math.cos(a) * s, h / 2 - 0.4, math.sin(a) * s)) * CFrame.Angles(rng:NextNumber(-0.35, 0.35), a, rng:NextNumber(-0.35, 0.35))
		block(parent, cf, Vector3.new(1.1 * s, h, 1.1 * s), color:Lerp(Color3.new(1, 1, 1), i * 0.1), NEON)
	end
end

local function lamp(parent: Instance, pos: Vector3, th: Theme)
	cyl(parent, pos + Vector3.new(0, 4, 0), 0.35, 8, Color3.fromRGB(50, 46, 62), DECOR)
	local b = ball(parent, pos + Vector3.new(0, 8.6, 0), 0.8, th.accent2, NEON)
	light(b, th.accent2, 18, 0.7)
end

local function scatterProp(parent: Instance, pos: Vector3, th: Theme, rng: Random)
	local s = rng:NextNumber(0.85, 1.5)
	if th.prop == "tree" then
		tree(parent, pos, s, th, rng)
	elseif th.prop == "pine" then
		pine(parent, pos, s, th)
	elseif th.prop == "spire" then
		spire(parent, pos, s, th, rng)
	elseif th.prop == "pylon" then
		pylon(parent, pos, s * 0.9, th)
	else
		shard(parent, pos, s, th, rng)
	end
end

-- Stepped, rounded mountain (reads as a clear silhouette without shadows).
local function mountain(parent: Instance, pos: Vector3, r: number, h: number, th: Theme)
	cyl(parent, pos + Vector3.new(0, h * 0.2 - 6, 0), r, h * 0.4 + 12, th.cliffLow, { collide = true })
	cyl(parent, pos + Vector3.new(0, h * 0.55, 0), r * 0.68, h * 0.34, th.cliffMid, { collide = true })
	cyl(parent, pos + Vector3.new(0, h * 0.82, 0), r * 0.4, h * 0.24, th.cliffMid:Lerp(th.cliffTop, 0.5), DECOR)
	blob(parent, CFrame.new(pos + Vector3.new(0, h * 0.95, 0)), Vector3.new(r * 0.62, h * 0.22, r * 0.62), th.cliffTop, DECOR)
end

---------------------------------------------------------------------------
-- Training zones
---------------------------------------------------------------------------
local ZoneColors: { [string]: Color3 } = {
	dome = Color3.fromRGB(180, 110, 255),
	falls = Color3.fromRGB(80, 190, 255),
	forge = Color3.fromRGB(255, 120, 40),
	crucible = Color3.fromRGB(255, 70, 70),
	cavern = Color3.fromRGB(120, 230, 255),
	spire = Color3.fromRGB(150, 255, 200),
	eye = Color3.fromRGB(255, 236, 100),
	vault = Color3.fromRGB(255, 255, 255),
	anvil = Color3.fromRGB(255, 80, 210),
	singularity = Color3.fromRGB(140, 90, 255),
}

local function buildZone(parent: Instance, center: Vector3, zone: any, th: Theme, toward: Vector3)
	local c = ZoneColors[zone.style] or th.accent
	local r = zone.radius
	local f = Instance.new("Folder")
	f.Name = "Zone_" .. zone.id
	f.Parent = parent
	-- stepped pad with a bright rim and a painted inner disc
	cyl(f, center + Vector3.new(0, 0.35, 0), r + 3, 0.7, th.rock, { collide = true })
	cyl(f, center + Vector3.new(0, 0.8, 0), r, 0.5, Color3.fromRGB(44, 38, 62), { collide = true })
	cyl(f, center + Vector3.new(0, 1.0, 0), r - 1.5, 0.2, c, NEON).Name = "Rim"
	cyl(f, center + Vector3.new(0, 1.06, 0), r - 3.2, 0.2, Color3.fromRGB(56, 48, 80), DECOR)
	cyl(f, center + Vector3.new(0, 1.12, 0), r * 0.55, 0.2, c:Lerp(Color3.fromRGB(40, 34, 60), 0.45), DECOR)
	cyl(f, center + Vector3.new(0, 1.18, 0), r * 0.3, 0.2, c:Lerp(Color3.new(1, 1, 1), 0.25), NEON)
	-- pylons around the pad, joined by a floating ring
	local n = 8
	for i = 1, n do
		local a = i / n * math.pi * 2
		local p = center + Vector3.new(math.cos(a) * (r + 0.5), 0, math.sin(a) * (r + 0.5))
		block(f, CFrame.new(p + Vector3.new(0, 6, 0)) * CFrame.Angles(0, -a, 0), Vector3.new(2.6, 12, 2.6), Color3.fromRGB(58, 50, 84), { collide = true })
		block(f, CFrame.new(p + Vector3.new(0, 12.6, 0)) * CFrame.Angles(0, -a, 0), Vector3.new(3.4, 1.2, 3.4), c, NEON)
		local orb = ball(f, p + Vector3.new(0, 15, 0), 1.2, c:Lerp(Color3.new(1, 1, 1), 0.3), { mat = Enum.Material.Neon, collide = false, anim = "bob" })
		orb:SetAttribute("KiwPhase", i)
		if i % 2 == 0 then
			light(orb, c, 26, 1.4)
		end
	end
	-- centrepiece per style
	local top = center + Vector3.new(0, 1.2, 0)
	local style = zone.style
	if style == "dome" then
		-- gravity dome: translucent shell + heavy rings that spin
		blob(f, CFrame.new(center + Vector3.new(0, 1, 0)), Vector3.new(r * 2 - 4, r * 1.3, r * 2 - 4), c, { mat = Enum.Material.ForceField, collide = false, trans = 0.35 })
		for i = 1, 3 do
			ring(f, top + Vector3.new(0, 6 + i * 5, 0), r * (0.75 - i * 0.14), 1, c:Lerp(Color3.new(1, 1, 1), i * 0.15), "orbit", i * 2)
		end
		for i = 1, 4 do
			local a = i / 4 * math.pi * 2 + 0.4
			local p = top + Vector3.new(math.cos(a) * r * 0.62, 0, math.sin(a) * r * 0.62)
			cyl(f, p + Vector3.new(0, 1.2, 0), 2.6, 2.4, Color3.fromRGB(40, 40, 52), { collide = true })
			cyl(f, p + Vector3.new(0, 2.7, 0), 1.2, 0.8, Color3.fromRGB(90, 90, 110), DECOR)
		end
	elseif style == "falls" then
		-- cliff with a waterfall and lightning rods
		local back = CFrame.lookAt(top, top + toward) * CFrame.new(0, 0, r * 0.72)
		block(f, back * CFrame.new(0, 16, 4), Vector3.new(44, 34, 10), th.cliffLow, { collide = true })
		block(f, back * CFrame.new(0, 34, 5), Vector3.new(36, 6, 12), th.cliffMid, { collide = true })
		block(f, back * CFrame.new(-15, 22, 0), Vector3.new(10, 44, 9), th.cliffMid, { collide = true })
		block(f, back * CFrame.new(15, 20, 0), Vector3.new(10, 40, 9), th.cliffMid, { collide = true })
		local water = block(f, back * CFrame.new(0, 16, -1.2), Vector3.new(18, 33, 1.2), Color3.fromRGB(110, 210, 255), { mat = Enum.Material.Neon, collide = false, trans = 0.15, name = "Waterfall", anim = "water" })
		block(f, back * CFrame.new(-4, 16, -1.9), Vector3.new(2.4, 33, 0.4), Color3.fromRGB(220, 245, 255), NEON)
		block(f, back * CFrame.new(5, 16, -1.9), Vector3.new(1.6, 33, 0.4), Color3.fromRGB(220, 245, 255), NEON)
		light(water, Color3.fromRGB(110, 210, 255), 40, 1.5)
		cyl(f, top + Vector3.new(0, 0.1, 0) + (back.Position - top) * 0.8, 13, 0.3, Color3.fromRGB(90, 190, 250), NEON)
		for _, side in { -1, 1 } do
			local p = (back * CFrame.new(side * 15, 44, 0)).Position
			cyl(f, p + Vector3.new(0, 5, 0), 0.4, 10, Color3.fromRGB(70, 70, 90), DECOR)
			ball(f, p + Vector3.new(0, 10.6, 0), 1.4, Color3.fromRGB(255, 240, 120), { mat = Enum.Material.Neon, collide = false, anim = "pulse" })
		end
	elseif style == "forge" or style == "crucible" then
		cyl(f, top + Vector3.new(0, 1.5, 0), r * 0.34, 3, Color3.fromRGB(40, 34, 38), { collide = true })
		cyl(f, top + Vector3.new(0, 3.1, 0), r * 0.3, 0.4, c, { mat = Enum.Material.Neon, collide = false, anim = "pulse" })
		for i = 1, 4 do
			local a = i / 4 * math.pi * 2
			local p = top + Vector3.new(math.cos(a) * r * 0.6, 0, math.sin(a) * r * 0.6)
			block(f, CFrame.new(p + Vector3.new(0, 4, 0)) * CFrame.Angles(0, -a, math.rad(12)), Vector3.new(3, 8, 3), Color3.fromRGB(50, 40, 44), { collide = true })
			block(f, CFrame.new(p + Vector3.new(0, 8.6, 0)) * CFrame.Angles(0, -a, math.rad(12)), Vector3.new(2, 2, 2), c, NEON)
		end
		local flame = blob(f, CFrame.new(top + Vector3.new(0, 8, 0)), Vector3.new(7, 11, 7), c:Lerp(Color3.fromRGB(255, 240, 150), 0.4), { mat = Enum.Material.Neon, collide = false, anim = "flame" })
		light(flame, c, 46, 2)
	elseif style == "cavern" or style == "spire" then
		for i = 1, 7 do
			local a = i / 7 * math.pi * 2
			local h = 12 + (i % 3) * 7
			local p = top + Vector3.new(math.cos(a) * r * 0.66, h / 2, math.sin(a) * r * 0.66)
			block(f, CFrame.new(p) * CFrame.Angles(math.rad((i % 2) * 8 - 4), a, math.rad(6)), Vector3.new(4, h, 4), Color3.fromRGB(150, 210, 245):Lerp(c, 0.3), { collide = true })
			block(f, CFrame.new(p + Vector3.new(0, h / 2 + 1.5, 0)) * CFrame.Angles(0, a + 0.78, 0), Vector3.new(2.4, 3.4, 2.4), c, NEON)
		end
		local core = block(f, CFrame.new(top + Vector3.new(0, 10, 0)) * CFrame.Angles(0.6, 0.78, 0.4), Vector3.new(5, 5, 5), c, { mat = Enum.Material.Neon, collide = false, anim = "spin" })
		light(core, c, 46, 2)
	elseif style == "eye" then
		for i = 1, 3 do
			ring(f, top + Vector3.new(0, 5 + i * 7, 0), r * (0.9 - i * 0.2), 1.2, if i % 2 == 0 then th.accent2 else c, "orbit", i * 3)
		end
		local eye = ball(f, top + Vector3.new(0, 16, 0), 4, c, { mat = Enum.Material.Neon, collide = false, anim = "pulse" })
		light(eye, c, 50, 2)
	elseif style == "vault" then
		-- the timeless vault: a white room with a giant clock face
		for _, side in { -1, 1 } do
			block(f, CFrame.lookAt(top, top + toward) * CFrame.new(side * r * 0.7, 12, r * 0.5), Vector3.new(4, 24, r), Color3.fromRGB(240, 240, 250), { collide = true })
		end
		local clock = cyl(f, top + Vector3.new(0, 20, 0), 12, 1, Color3.fromRGB(250, 250, 255), { mat = Enum.Material.Neon, collide = false })
		clock.CFrame = CFrame.lookAt(top + Vector3.new(0, 20, 0) - toward * r * 0.7, top + Vector3.new(0, 20, 0)) * CFrame.Angles(0, math.rad(90), 0)
		local hand = block(f, CFrame.lookAt(top + Vector3.new(0, 20, 0) - toward * (r * 0.7 - 1), top + Vector3.new(0, 20, 0)), Vector3.new(1, 10, 0.6), Color3.fromRGB(40, 40, 60), { collide = false, anim = "clock" })
		hand.Name = "Hand"
		light(clock, Color3.new(1, 1, 1), 50, 2)
	else -- anvil / singularity
		local core = ball(f, top + Vector3.new(0, 14, 0), 5, Color3.fromRGB(10, 6, 20), { collide = false, anim = "pulse" })
		for i = 1, 3 do
			ring(f, top + Vector3.new(0, 14, 0), 8 + i * 3, 0.8, if i % 2 == 0 then th.accent2 else c, "orbit", i * 2.1)
		end
		light(core, c, 50, 2)
		block(f, CFrame.new(top + Vector3.new(0, 2, 0)), Vector3.new(10, 4, 6), Color3.fromRGB(30, 22, 50), { collide = true })
	end
	-- sign on the side that faces the plaza
	local signPos = center + toward * (r + 8)
	standSign(f, Vector3.new(signPos.X, 0, signPos.Z), toward, c:Lerp(Color3.fromRGB(30, 24, 50), 0.55), {
		{ key = "zone." .. zone.id },
		{ text = "x" .. Format.abbrev(zone.mult), color = Color3.fromRGB(255, 226, 90) },
		{ key = "world.req_power", n = Format.abbrev(zone.reqPower), color = Color3.fromRGB(200, 230, 255) },
	}, 20)
end

---------------------------------------------------------------------------
-- Camps and boss arenas
---------------------------------------------------------------------------
local function buildCamp(parent: Instance, center: Vector3, camp: any, th: Theme, toward: Vector3, rng: Random)
	local def = Config.Npcs[camp.npc]
	local c = rgb(def.color)
	local acc = rgb(def.accent)
	local f = Instance.new("Folder")
	f.Name = "Camp_" .. camp.npc
	f.Parent = parent
	cyl(f, center + Vector3.new(0, 0.12, 0), camp.radius, 0.2, th.patchB:Lerp(c, 0.18), DECOR)
	cyl(f, center + Vector3.new(0, 0.18, 0), camp.radius * 0.6, 0.2, th.patchB:Lerp(c, 0.32), DECOR)
	-- totems with the enemy colours + banners
	for i = 1, 5 do
		local a = i / 5 * math.pi * 2 + 0.3
		local p = center + Vector3.new(math.cos(a) * camp.radius * 0.92, 0, math.sin(a) * camp.radius * 0.92)
		block(f, CFrame.new(p + Vector3.new(0, 5, 0)) * CFrame.Angles(0, -a, 0), Vector3.new(2.2, 10, 2.2), th.trunk, { collide = true })
		block(f, CFrame.new(p + Vector3.new(0, 8.4, 0)) * CFrame.Angles(0, -a, 0), Vector3.new(3, 2.4, 3), c, DECOR)
		block(f, CFrame.new(p + Vector3.new(0, 11, 0)) * CFrame.Angles(0, -a + 0.78, 0), Vector3.new(1.6, 1.6, 1.6), acc, NEON)
		local flag = block(f, CFrame.new(p + Vector3.new(0, 6.2, 0)) * CFrame.Angles(0, -a, 0) * CFrame.new(0, 0, 2.2), Vector3.new(0.3, 4.4, 3.2), acc, { collide = false, anim = "flag" })
		flag:SetAttribute("KiwPhase", i)
	end
	for _ = 1, 4 do
		local a = rng:NextNumber(0, 6.28)
		local r = camp.radius * rng:NextNumber(0.3, 0.8)
		rock(f, center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r), rng:NextNumber(0.7, 1.3), th, rng)
	end
	local signPos = center + toward * (camp.radius + 8)
	standSign(f, Vector3.new(signPos.X, 0, signPos.Z), toward, Color3.fromRGB(120, 40, 46), {
		{ key = "npc." .. camp.npc },
		{ key = "world.enemy_hp", n = Format.abbrev(def.hp), color = Color3.fromRGB(255, 190, 190) },
	}, 18)
end

local function buildBossArena(parent: Instance, center: Vector3, boss: any, th: Theme, toward: Vector3)
	local def = Config.Npcs[boss.npc]
	local acc = rgb(def.accent)
	local f = Instance.new("Folder")
	f.Name = "Boss_" .. boss.npc
	f.Parent = parent
	local r = boss.radius
	cyl(f, center + Vector3.new(0, 0.2, 0), r + 4, 0.4, th.rock, { collide = true })
	cyl(f, center + Vector3.new(0, 0.5, 0), r, 0.3, Color3.fromRGB(38, 30, 46), { collide = true })
	cyl(f, center + Vector3.new(0, 0.62, 0), r * 0.97, 0.2, acc, NEON)
	cyl(f, center + Vector3.new(0, 0.7, 0), r * 0.93, 0.2, Color3.fromRGB(46, 36, 56), DECOR)
	cyl(f, center + Vector3.new(0, 0.76, 0), r * 0.5, 0.2, acc:Lerp(Color3.fromRGB(30, 24, 40), 0.6), DECOR)
	cyl(f, center + Vector3.new(0, 0.82, 0), r * 0.47, 0.2, Color3.fromRGB(52, 40, 62), DECOR)
	-- claw-like pillars leaning in
	for i = 1, 10 do
		local a = i / 10 * math.pi * 2
		local p = center + Vector3.new(math.cos(a) * (r + 1), 0, math.sin(a) * (r + 1))
		local h = if i % 2 == 0 then 30 else 20
		local cf = CFrame.lookAt(p, Vector3.new(center.X, p.Y, center.Z)) * CFrame.Angles(math.rad(-14), 0, 0)
		block(f, cf * CFrame.new(0, h / 2, 0), Vector3.new(5, h, 5), th.cliffLow, { collide = true })
		block(f, cf * CFrame.new(0, h + 2, 0) * CFrame.Angles(math.rad(-24), 0, 0), Vector3.new(3.4, 7, 3.4), th.cliffMid, DECOR)
		local tip = block(f, cf * CFrame.new(0, h + 6, -1.6) * CFrame.Angles(math.rad(-30), 0, math.rad(45)), Vector3.new(1.8, 1.8, 1.8), acc, { mat = Enum.Material.Neon, collide = false, anim = "pulse" })
		tip:SetAttribute("KiwPhase", i)
		if i % 2 == 0 then
			light(tip, acc, 30, 1.5)
		end
	end
	local signPos = center + toward * (r + 12)
	standSign(f, Vector3.new(signPos.X, 0, signPos.Z), toward, Color3.fromRGB(90, 20, 40), {
		{ key = "npc." .. boss.npc },
		{ key = "world.boss", color = Color3.fromRGB(255, 210, 90) },
		{ key = "world.enemy_hp", n = Format.abbrev(def.hp), color = Color3.fromRGB(255, 190, 190) },
	}, 22)
end

---------------------------------------------------------------------------
-- Plaza, warp gate
---------------------------------------------------------------------------
local function buildPlaza(parent: Instance, center: Vector3, pl: any, th: Theme)
	local f = Instance.new("Folder")
	f.Name = "Plaza"
	f.Parent = parent
	local R = Config.PlazaRadius
	cyl(f, center + Vector3.new(0, 0.2, 0), R, 0.4, th.plaza:Lerp(Color3.new(0, 0, 0), 0.25), { collide = true })
	cyl(f, center + Vector3.new(0, 0.5, 0), R - 3, 0.3, th.plaza, { collide = true })
	cyl(f, center + Vector3.new(0, 0.66, 0), R - 8, 0.2, th.plazaTrim, NEON)
	cyl(f, center + Vector3.new(0, 0.72, 0), R - 10, 0.2, th.plaza:Lerp(Color3.new(1, 1, 1), 0.12), DECOR)
	-- painted sunburst
	for i = 1, 12 do
		local a = i / 12 * math.pi * 2
		local mid = center + Vector3.new(math.cos(a) * (R * 0.5), 0.84, math.sin(a) * (R * 0.5))
		block(f, CFrame.new(mid) * CFrame.Angles(0, -a, 0), Vector3.new(R * 0.62, 0.2, 2.2), th.plaza:Lerp(th.plazaTrim, if i % 2 == 0 then 0.55 else 0.25), DECOR)
	end
	cyl(f, center + Vector3.new(0, 0.9, 0), 17, 0.3, th.plazaTrim:Lerp(th.plaza, 0.4), DECOR)
	-- monument: a floating ki crystal over a stepped base
	cyl(f, center + Vector3.new(0, 1.6, 0), 12, 1.6, th.rock, { collide = true })
	cyl(f, center + Vector3.new(0, 3.0, 0), 8.5, 1.4, th.plaza, { collide = true })
	cyl(f, center + Vector3.new(0, 4.2, 0), 5.5, 1.2, th.plazaTrim, { collide = true })
	local core = block(f, CFrame.new(center + Vector3.new(0, 15, 0)) * CFrame.Angles(math.rad(35), 0, math.rad(45)), Vector3.new(5.5, 5.5, 5.5), th.accent, { mat = Enum.Material.Neon, collide = false, anim = "spinbob", name = "KiCrystal" })
	light(core, th.accent, 50, 1.6)
	block(f, CFrame.new(center + Vector3.new(0, 15, 0)) * CFrame.Angles(0, math.rad(45), 0), Vector3.new(2.6, 13, 2.6), th.accent:Lerp(th.plazaTrim, 0.35), { collide = false, anim = "spinbob" })
	for i = 1, 2 do
		ring(f, center + Vector3.new(0, 15, 0), 8 + i * 2.5, 0.7, th.plazaTrim, "orbit", i * 1.7)
	end
	-- lamps and banner poles around the rim
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2 + math.rad(22.5)
		lamp(f, center + Vector3.new(math.cos(a) * (R - 5), 0.7, math.sin(a) * (R - 5)), th)
	end
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		local p = center + Vector3.new(math.cos(a) * (R + 2), 0, math.sin(a) * (R + 2))
		cyl(f, p + Vector3.new(0, 9, 0), 0.5, 18, Color3.fromRGB(60, 52, 70), DECOR)
		local flag = block(f, CFrame.new(p + Vector3.new(0, 13, 0)) * CFrame.Angles(0, -a + math.rad(90), 0) * CFrame.new(0, 0, 2.6), Vector3.new(0.3, 8, 4.4), if i % 2 == 0 then th.plazaTrim else th.accent, { collide = false, anim = "flag" })
		flag:SetAttribute("KiwPhase", i * 0.9)
	end
	-- spawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.CFrame = CFrame.new(center + Vector3.new(0, 0.4, 22))
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.CanQuery = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Enabled = pl.index == 1
	spawn.Parent = f
	partCount += 1

	-- warp gate
	local gatePos = center + Vector3.new(-34, 0.8, 30)
	local gate = Instance.new("Model")
	gate.Name = "WarpGate"
	gate.Parent = f
	cyl(gate, gatePos + Vector3.new(0, 0.6, 0), 9, 1.2, th.rock, { collide = true })
	cyl(gate, gatePos + Vector3.new(0, 1.3, 0), 7.4, 0.3, th.accent2, NEON)
	local n = 14
	for i = 1, n do
		local a = i / n * math.pi * 2
		local p = gatePos + Vector3.new(0, 9.5 + math.sin(a) * 7.4, math.cos(a) * 7.4)
		block(gate, CFrame.new(p) * CFrame.Angles(a, 0, 0), Vector3.new(2.2, 2.2, 3.6), if i % 2 == 0 then th.plaza else th.accent2, if i % 2 == 0 then DECOR else NEON)
	end
	local disc = rod(gate, CFrame.new(gatePos + Vector3.new(0, 9.5, 0)), 6.4, 0.5, th.accent, { mat = Enum.Material.Neon, collide = false, trans = 0.25, name = "Portal", anim = "pulse" })
	light(disc, th.accent, 40, 2)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "TravelPrompt"
	prompt.ActionText = "Travel"
	prompt.ObjectText = "Warp Gate"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 22
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.B
	prompt:SetAttribute("LocAction", "world.travel")
	prompt:SetAttribute("LocObject", "world.warp_gate")
	prompt.Parent = disc
	standSign(f, gatePos + Vector3.new(0, -0.8, 12), Vector3.new(1, 0, 0.2), Color3.fromRGB(40, 60, 110), { { key = "world.warp_gate" }, { key = "planet." .. pl.id, color = Color3.fromRGB(255, 226, 90) } }, 16)
end

---------------------------------------------------------------------------
-- Planet
---------------------------------------------------------------------------
local function buildPlanet(world: Instance, pl: any, info: { [string]: any })
	local th = Themes[pl.theme]
	local cx, cy, cz = Config.planetCenter(pl.index)
	local center = Vector3.new(cx, cy, cz)
	local rng = Random.new(1000 + pl.index * 77)
	local f = Instance.new("Folder")
	f.Name = "Planet_" .. pl.id
	f.Parent = world
	local R = pl.radius

	-- ground: a thick disc, a darker skirt, painted patches
	cyl(f, center + Vector3.new(0, -8, 0), R, 16, th.ground, { mat = th.groundMat, collide = true, name = "Ground" })
	cyl(f, center + Vector3.new(0, -30, 0), R * 0.82, 30, th.cliffLow, { collide = false })
	cyl(f, center + Vector3.new(0, -58, 0), R * 0.5, 30, th.cliffLow:Lerp(Color3.new(0, 0, 0), 0.3), { collide = false })
	cyl(f, center + Vector3.new(0, 0.04, 0), R - 14, 0.1, th.ground:Lerp(th.patchA, 0.35), { mat = th.groundMat, collide = false })

	local pois: { { pos: Vector3, r: number } } = { { pos = center, r = Config.PlazaRadius + 10 } }
	local function at(offset: { number }): Vector3
		return center + Vector3.new(offset[1], 0, offset[3])
	end
	for _, z in pl.zones do
		table.insert(pois, { pos = at(z.offset), r = z.radius + 12 })
	end
	for _, c in pl.camps do
		table.insert(pois, { pos = at(c.offset), r = c.radius + 8 })
	end
	table.insert(pois, { pos = at(pl.boss.offset), r = pl.boss.radius + 12 })
	if pl.index == Config.Arena.planet then
		table.insert(pois, { pos = at(Config.Arena.offset), r = Config.Arena.wall + 16 })
		table.insert(pois, { pos = at(Config.WishAltar.offset), r = Config.WishAltar.radius + 14 })
		table.insert(pois, { pos = at(Config.WorldBossSite.offset), r = Config.WorldBossSite.radius + 8 })
	end

	local function free(p: Vector3, pad: number): boolean
		for _, poi in pois do
			if ((p - poi.pos) * Vector3.new(1, 0, 1)).Magnitude < poi.r + pad then
				return false
			end
		end
		return true
	end

	-- painted ground patches (flat discs in two tones)
	for i = 1, 26 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(40, R - 50)
		local p = center + Vector3.new(math.cos(a) * r, 0.1 + i * 0.004, math.sin(a) * r)
		local size = rng:NextNumber(16, 46)
		local p1 = blob(f, CFrame.new(p), Vector3.new(size * 2, 0.5, size * rng:NextNumber(1.2, 2)), if i % 2 == 0 then th.patchA else th.patchB, DECOR)
		p1.CFrame = CFrame.new(p) * CFrame.Angles(0, rng:NextNumber(0, 3.14), 0)
	end

	-- paths from the plaza to every point of interest
	for i = 2, #pois do
		local poi = pois[i]
		local d = (poi.pos - center) * Vector3.new(1, 0, 1)
		local from = Config.PlazaRadius - 4
		local len = d.Magnitude - poi.r + 14 - from
		if len > 4 then
			local mid = center + d.Unit * (from + len / 2) + Vector3.new(0, 0.22, 0)
			block(f, CFrame.lookAt(mid, mid + d.Unit), Vector3.new(11, 0.24, len), th.path, DECOR)
			block(f, CFrame.lookAt(mid + Vector3.new(0, 0.05, 0), mid + d.Unit + Vector3.new(0, 0.05, 0)), Vector3.new(6.5, 0.24, len), th.path:Lerp(Color3.new(1, 1, 1), 0.18), DECOR)
		end
	end

	buildPlaza(f, center, pl, th)

	for _, z in pl.zones do
		local zc = at(z.offset)
		buildZone(f, zc, z, th, ((center - zc) * Vector3.new(1, 0, 1)).Unit)
	end
	for _, c in pl.camps do
		local cc = at(c.offset)
		buildCamp(f, cc, c, th, ((center - cc) * Vector3.new(1, 0, 1)).Unit, rng)
	end
	do
		local bc = at(pl.boss.offset)
		buildBossArena(f, bc, pl.boss, th, ((center - bc) * Vector3.new(1, 0, 1)).Unit)
	end

	-- rim mountains
	local nM = 26
	for i = 1, nM do
		local a = i / nM * math.pi * 2 + rng:NextNumber(-0.05, 0.05)
		local r = R + rng:NextNumber(4, 30)
		local h = rng:NextNumber(55, 120)
		mountain(f, center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r), rng:NextNumber(34, 52), h, th)
	end

	-- scattered props
	local placed = 0
	local tries = 0
	while placed < 54 and tries < 400 do
		tries += 1
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(Config.PlazaRadius + 14, R - 40)
		local p = center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		if free(p, 6) then
			placed += 1
			if placed % 6 == 0 then
				rock(f, p, rng:NextNumber(0.8, 1.8), th, rng)
			elseif placed % 9 == 0 then
				crystal(f, p, rng:NextNumber(0.9, 1.6), if placed % 2 == 0 then th.accent else th.accent2, rng)
			else
				scatterProp(f, p, th, rng)
			end
		end
	end

	-- landmarks: floating islands with a crystal, high above the rim
	for i = 1, 4 do
		local a = i / 4 * math.pi * 2 + 0.6
		local p = center + Vector3.new(math.cos(a) * (R * 0.72), 95 + i * 14, math.sin(a) * (R * 0.72))
		local island = blob(f, CFrame.new(p), Vector3.new(60, 24, 60), th.cliffMid, { collide = false, anim = "bob" })
		island:SetAttribute("KiwPhase", i * 1.3)
		island:SetAttribute("KiwAmp", 2.5)
		cyl(f, p + Vector3.new(0, 7, 0), 27, 4, th.ground, { mat = th.groundMat, collide = true })
		crystal(f, p + Vector3.new(0, 9, 0), 2.4, if i % 2 == 0 then th.accent else th.accent2, rng)
	end

	info.centers[pl.index] = center
end

---------------------------------------------------------------------------
-- Planet 1 specials: coliseum, wish altar, world boss crater, master, boards
---------------------------------------------------------------------------
local function buildArena(world: Instance, info: { [string]: any })
	local A = Config.Arena
	local center = info.centers[A.planet] + Vector3.new(A.offset[1], 0, A.offset[3])
	local toward = ((info.centers[A.planet] - center) * Vector3.new(1, 0, 1)).Unit
	local f = Instance.new("Folder")
	f.Name = "Arena"
	f.Parent = world
	local r, w = A.radius, A.wall
	local red, gold, stone = Color3.fromRGB(230, 70, 70), Color3.fromRGB(255, 200, 70), Color3.fromRGB(222, 210, 190)
	cyl(f, center + Vector3.new(0, 0.3, 0), w + 12, 0.6, stone:Lerp(Color3.new(0, 0, 0), 0.3), { collide = true })
	cyl(f, center + Vector3.new(0, 0.9, 0), r, 1, Color3.fromRGB(236, 220, 176), { collide = true, name = "ArenaFloor" })
	cyl(f, center + Vector3.new(0, 1.42, 0), r - 1, 0.1, red, DECOR)
	cyl(f, center + Vector3.new(0, 1.45, 0), r - 3.5, 0.1, Color3.fromRGB(240, 226, 186), DECOR)
	cyl(f, center + Vector3.new(0, 1.48, 0), r * 0.5, 0.1, gold, DECOR)
	cyl(f, center + Vector3.new(0, 1.51, 0), r * 0.5 - 2, 0.1, Color3.fromRGB(240, 226, 186), DECOR)
	cyl(f, center + Vector3.new(0, 1.54, 0), 9, 0.1, red, DECOR)
	-- stands: wall segments with gates on four sides
	local n = 28
	for i = 1, n do
		local a = i / n * math.pi * 2
		local gap = i % 7 == 0
		local p = center + Vector3.new(math.cos(a) * w, 0, math.sin(a) * w)
		local cf = CFrame.lookAt(p, Vector3.new(center.X, 0, center.Z))
		if not gap then
			block(f, cf * CFrame.new(0, 5, 0), Vector3.new(16.5, 10, 5), stone, { collide = true })
			block(f, cf * CFrame.new(0, 12, 4), Vector3.new(16.5, 6, 5), stone:Lerp(Color3.new(0, 0, 0), 0.12), { collide = true })
			block(f, cf * CFrame.new(0, 17, 8), Vector3.new(16.5, 6, 5), stone:Lerp(Color3.new(0, 0, 0), 0.22), { collide = true })
			block(f, cf * CFrame.new(0, 10.4, -0.2), Vector3.new(16.5, 1, 5.6), if i % 2 == 0 then red else gold, DECOR)
			-- crowd: bright blobs on the stands (cheap, and they sell "people are watching")
			for k = -1, 1 do
				blob(f, cf * CFrame.new(k * 5, 16.8, 3.6), Vector3.new(2.6, 3.2, 2.6), Color3.fromHSV(((i * 3 + k) % 10) / 10, 0.6, 0.95), { collide = false, anim = "bob" }):SetAttribute("KiwPhase", i + k)
			end
		else
			for _, side in { -1, 1 } do
				block(f, cf * CFrame.new(side * 7, 9, 0), Vector3.new(3, 18, 5), gold, { collide = true })
			end
			block(f, cf * CFrame.new(0, 19, 0), Vector3.new(17, 3, 5), red, { collide = true })
		end
		if i % 4 == 0 then
			local pole = cf * CFrame.new(0, 28, 9)
			cyl(f, pole.Position, 0.5, 18, Color3.fromRGB(60, 52, 70), DECOR)
			local flag = block(f, pole * CFrame.new(3, 6, 0), Vector3.new(5.4, 4, 0.3), if i % 8 == 0 then red else gold, { collide = false, anim = "flag" })
			flag:SetAttribute("KiwPhase", i)
		end
	end
	local signPos = center + toward * (w + 20)
	standSign(f, Vector3.new(signPos.X, 0, signPos.Z), toward, Color3.fromRGB(150, 36, 46), { { key = "world.arena" }, { key = "world.arena_pvp", color = Color3.fromRGB(255, 226, 90) } }, 24)
	info.arenaCenter = center + Vector3.new(0, 1.5, 0)
end

local function buildAltar(world: Instance, info: { [string]: any })
	local W = Config.WishAltar
	local center = info.centers[W.planet] + Vector3.new(W.offset[1], 0, W.offset[3])
	local f = Instance.new("Folder")
	f.Name = "WishAltar"
	f.Parent = world
	local navy, gold = Color3.fromRGB(36, 40, 88), Color3.fromRGB(255, 214, 90)
	cyl(f, center + Vector3.new(0, 0.5, 0), W.radius + 4, 1, Color3.fromRGB(70, 74, 120), { collide = true })
	cyl(f, center + Vector3.new(0, 1.3, 0), W.radius, 0.8, navy, { collide = true })
	cyl(f, center + Vector3.new(0, 1.74, 0), W.radius - 1.5, 0.1, gold, NEON)
	cyl(f, center + Vector3.new(0, 1.78, 0), W.radius - 2.6, 0.1, navy, DECOR)
	-- monolith with a star window
	block(f, CFrame.new(center + Vector3.new(0, 12, 0)), Vector3.new(7, 22, 3), navy:Lerp(Color3.new(0, 0, 0), 0.3), { collide = true, name = "Monolith" })
	local star = block(f, CFrame.new(center + Vector3.new(0, 16, 0)) * CFrame.Angles(0, 0, math.rad(45)), Vector3.new(4, 4, 3.4), gold, { mat = Enum.Material.Neon, collide = false, anim = "pulse", name = "Star" })
	light(star, gold, 40, 2)
	block(f, CFrame.new(center + Vector3.new(0, 23.6, 0)), Vector3.new(9, 1.4, 4), gold, NEON)
	-- six seal pedestals
	for i = 1, Config.Relics.count do
		local a = i / Config.Relics.count * math.pi * 2
		local p = center + Vector3.new(math.cos(a) * (W.radius - 4), 1.7, math.sin(a) * (W.radius - 4))
		cyl(f, p + Vector3.new(0, 1.5, 0), 1.5, 3, Color3.fromRGB(80, 84, 130), { collide = true })
		local slot = cyl(f, p + Vector3.new(0, 3.1, 0), 1.2, 0.3, rgb(Config.Relics.colors[i]):Lerp(Color3.fromRGB(30, 30, 50), 0.6), DECOR)
		slot.Name = "SealSlot" .. i
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "WishPrompt"
	prompt.ActionText = "Make a wish"
	prompt.ObjectText = "Wish Altar"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 20
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.B
	prompt:SetAttribute("LocAction", "world.make_wish")
	prompt:SetAttribute("LocObject", "world.wish_altar")
	prompt.Parent = star
	local toward = ((info.centers[W.planet] - center) * Vector3.new(1, 0, 1)).Unit
	standSign(f, Vector3.new(center.X, 0, center.Z) + toward * (W.radius + 8), toward, navy, { { key = "world.wish_altar" }, { key = "world.wish_hint", color = gold } }, 18)
	info.altarCenter = center + Vector3.new(0, 1.8, 0)
end

local function buildCrater(world: Instance, info: { [string]: any })
	local S = Config.WorldBossSite
	local center = info.centers[S.planet] + Vector3.new(S.offset[1], 0, S.offset[3])
	local f = Instance.new("Folder")
	f.Name = "WorldBossSite"
	f.Parent = world
	local dark, glow = Color3.fromRGB(40, 44, 78), Color3.fromRGB(120, 255, 230)
	cyl(f, center + Vector3.new(0, 0.16, 0), S.radius, 0.3, dark, DECOR)
	cyl(f, center + Vector3.new(0, 0.2, 0), S.radius * 0.72, 0.3, dark:Lerp(Color3.new(0, 0, 0), 0.3), DECOR)
	cyl(f, center + Vector3.new(0, 0.24, 0), S.radius * 0.4, 0.3, Color3.fromRGB(18, 20, 40), DECOR)
	local rng = Random.new(99)
	for i = 1, 14 do
		local a = i / 14 * math.pi * 2
		local p = center + Vector3.new(math.cos(a) * S.radius, 0, math.sin(a) * S.radius)
		local h = rng:NextNumber(8, 20)
		block(f, CFrame.lookAt(p, Vector3.new(center.X, 0, center.Z)) * CFrame.Angles(math.rad(22), 0, 0) * CFrame.new(0, h / 2, 0), Vector3.new(7, h, 6), dark, { collide = true })
		if i % 2 == 0 then
			block(f, CFrame.new(p + Vector3.new(0, h + 1, 0)) * CFrame.Angles(0.6, a, 0.6), Vector3.new(2, 2, 2), glow, { mat = Enum.Material.Neon, collide = false, anim = "pulse" }):SetAttribute("KiwPhase", i)
		end
	end
	local toward = ((info.centers[S.planet] - center) * Vector3.new(1, 0, 1)).Unit
	local signPos = center + toward * (S.radius + 12)
	standSign(f, Vector3.new(signPos.X, 0, signPos.Z), toward, Color3.fromRGB(30, 50, 110), { { key = "npc.astral_titan" }, { key = "world.worldboss", color = glow } }, 24)
	info.worldBossCenter = center
end

local function buildBoards(world: Instance, info: { [string]: any })
	local center = info.centers[1]
	local f = Instance.new("Folder")
	f.Name = "Boards"
	f.Parent = world
	local boards = {}
	local defs = { { id = "power", key = "board.power", color = Color3.fromRGB(255, 120, 60) }, { id = "rebirths", key = "board.rebirths", color = Color3.fromRGB(170, 110, 255) }, { id = "arena", key = "board.arena", color = Color3.fromRGB(230, 70, 70) } }
	for i, d in defs do
		local a = math.rad(200 + i * 22)
		local p = center + Vector3.new(math.cos(a) * (Config.PlazaRadius - 9), 0.7, math.sin(a) * (Config.PlazaRadius - 9))
		local cf = CFrame.lookAt(p, Vector3.new(center.X, p.Y, center.Z))
		for _, side in { -1, 1 } do
			block(f, cf * CFrame.new(side * 6.5, 7, 0), Vector3.new(1.2, 14, 1.2), Color3.fromRGB(50, 44, 66), { collide = true })
		end
		block(f, cf * CFrame.new(0, 15, 0), Vector3.new(15, 2.6, 1.4), d.color, NEON)
		local board = block(f, cf * CFrame.new(0, 7.6, 0), Vector3.new(12.4, 12.4, 0.8), Color3.fromRGB(26, 22, 44), { collide = true, name = "Board_" .. d.id })
		local gui = Instance.new("SurfaceGui")
		gui.Name = "BoardGui"
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 30
		gui.LightInfluence = 0
		gui.Parent = board
		local title = Instance.new("TextLabel")
		title.Name = "Title"
		title.BackgroundTransparency = 1
		title.Size = UDim2.new(1, 0, 0.13, 0)
		title.Font = Enum.Font.GothamBlack
		title.TextScaled = true
		title.TextColor3 = d.color:Lerp(Color3.new(1, 1, 1), 0.4)
		title:SetAttribute("LocKey", d.key)
		title.Parent = gui
		local list = Instance.new("Frame")
		list.Name = "List"
		list.BackgroundTransparency = 1
		list.Size = UDim2.new(0.92, 0, 0.84, 0)
		list.Position = UDim2.new(0.04, 0, 0.14, 0)
		list.Parent = gui
		local layout = Instance.new("UIListLayout")
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = list
		boards[d.id] = board
	end
	info.boards = boards
end

-- The quest giver: a chunky robed master with a staff (static figure).
local function buildMaster(world: Instance, info: { [string]: any })
	local o = Config.MasterSpot.offset
	local pos = info.centers[1] + Vector3.new(o[1], 0.75, o[3])
	local f = Instance.new("Model")
	f.Name = "Master"
	f.Parent = world
	local robe, skin, sash = Color3.fromRGB(240, 120, 50), Color3.fromRGB(240, 200, 160), Color3.fromRGB(50, 80, 170)
	local cf = CFrame.lookAt(pos, Vector3.new(info.centers[1].X, pos.Y, info.centers[1].Z + 22))
	cyl(f, pos + Vector3.new(0, 0.3, 0), 3.2, 0.6, Color3.fromRGB(90, 84, 110), { collide = true })
	blob(f, cf * CFrame.new(0, 2.6, 0), Vector3.new(4.2, 4.6, 3.4), robe, DECOR)
	block(f, cf * CFrame.new(0, 2.4, -0.1), Vector3.new(4.3, 0.7, 3.5), sash, DECOR)
	ball(f, (cf * CFrame.new(0, 5.6, 0)).Position, 1.5, skin, DECOR)
	blob(f, cf * CFrame.new(0, 4.9, -1.1), Vector3.new(1.6, 2, 0.8), Color3.fromRGB(245, 245, 250), DECOR) -- beard
	blob(f, cf * CFrame.new(0, 6.7, 0.2), Vector3.new(1.2, 1.2, 1.2), Color3.fromRGB(245, 245, 250), DECOR) -- top knot
	for _, side in { -1, 1 } do
		blob(f, cf * CFrame.new(side * 2.3, 3.2, -0.3), Vector3.new(1.3, 2.8, 1.3), robe:Lerp(Color3.new(0, 0, 0), 0.1), DECOR)
		block(f, cf * CFrame.new(side * 0.5, 5.8, -1.4), Vector3.new(0.35, 0.2, 0.1), Color3.fromRGB(30, 26, 40), DECOR)
	end
	rod(f, cf * CFrame.new(2.9, 3.6, -0.8) * CFrame.Angles(0, 0, math.rad(90)), 0.22, 8, Color3.fromRGB(120, 84, 58), DECOR)
	local orb = ball(f, (cf * CFrame.new(2.9, 7.9, -0.8)).Position, 0.8, Color3.fromRGB(90, 230, 255), { mat = Enum.Material.Neon, collide = false, anim = "pulse" })
	light(orb, Color3.fromRGB(90, 230, 255), 18, 1.5)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Tag"
	bb.Size = UDim2.fromOffset(220, 60)
	bb.StudsOffset = Vector3.new(0, 10, 0)
	bb.MaxDistance = 120
	bb.AlwaysOnTop = false
	bb.Adornee = orb
	bb.Parent = orb
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.TextColor3 = Color3.fromRGB(255, 226, 90)
	t:SetAttribute("LocKey", "npc.master")
	local s = Instance.new("UIStroke")
	s.Thickness = 3
	s.Color = Color3.fromRGB(20, 16, 36)
	s.Parent = t
	t.Parent = bb
	info.masterPos = pos
end

function WorldBuilder.build(): { [string]: any }
	partCount = 0
	local world = Instance.new("Folder")
	world.Name = "World"
	local info: { [string]: any } = { centers = {} }
	for _, pl in Config.Planets do
		buildPlanet(world, pl, info)
	end
	buildArena(world, info)
	buildAltar(world, info)
	buildCrater(world, info)
	buildBoards(world, info)
	buildMaster(world, info)
	world.Parent = workspace
	info.partCount = partCount
	world:SetAttribute("PartCount", partCount)
	return info
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="28">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <float name="CameraMinZoomDistance">6</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="29">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="30">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Ads</string>
            <string name="Source"><![CDATA[--!strict
-- Rewarded video ads (client side). A placement's button only shows when its developer
-- product is set (Config.AdProducts), today's cap isn't used up and AdService says a video is
-- available right now. The reward is granted by the server's ProcessReceipt.
local AdService = game:GetService("AdService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(script.Parent.Net)
local Lang = require(script.Parent.Lang)

local Ads = {}

local available = false
local checkedAt = -math.huge
local checking = false

local function anyPlacementLive(): boolean
	for _, id in Config.AdProducts :: { [string]: number } do
		if id ~= 0 then
			return true
		end
	end
	return false
end

-- Asks AdService at most once a minute, only when a placement could be shown.
local function refreshAvailability()
	if checking or os.clock() - checkedAt < 60 or not anyPlacementLive() then
		return
	end
	checking = true
	task.spawn(function()
		local ok, result = pcall(function()
			return (AdService :: any):GetAdAvailabilityNowAsync((Enum :: any).AdFormat.RewardedVideo)
		end)
		available = ok and result ~= nil and (result :: any).AdAvailabilityResult == (Enum :: any).AdAvailabilityResult.IsAvailable
		checkedAt = os.clock()
		checking = false
	end)
end

function Ads.canShow(placement: string): boolean
	local id = (Config.AdProducts :: any)[placement]
	local s = Net.state
	if type(id) ~= "number" or id == 0 or not s or not s.ads or s.ads.left <= 0 then
		return false
	end
	refreshAvailability()
	return available
end

local notify: (string, string?) -> () = function() end
function Ads.setNotifier(fn: (string, string?) -> ())
	notify = fn
end

function Ads.watch(placement: string)
	local ok, res = Net.request("WatchAd", { placement = placement })
	if not ok then
		notify(Lang.msg(res), "error")
	end
	checkedAt = -math.huge -- re-check availability after a video
end

return Ads
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">CharFx</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Character visuals for every fighter the client can see (players and server dummies):
--   * auras built from GEOMETRY (rising flame tongues, shell, ground ring, lightning bolts) plus
--     optional particles / light, so they still read at graphics quality 1
--   * transformation looks: aura colour, glowing head crest, recoloured hair, outline
--   * procedural poses through Motor6D.Transform (punch, charge, block, beam, flight): no
--     animation assets
--   * power tag over the head
-- One Stepped loop (poses) and one RenderStepped loop (auras) for everybody.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Fx = require(script.Parent.Fx)
local CombatFx = require(script.Parent.CombatFx)
local Lang = require(script.Parent.Lang)

local CharFx = {}

local player = Players.LocalPlayer
local WHITE = Color3.new(1, 1, 1)

type Rig = { [string]: any }

local rigs: { [Model]: Rig } = {}
local byFighter: { [number]: Rig } = {}
CharFx.rigs = rigs

local JOINTS = { "Waist", "Neck", "RightShoulder", "LeftShoulder", "RightElbow", "LeftElbow", "RightHip", "LeftHip", "RightKnee", "LeftKnee", "Root" }

local function weld(part: BasePart, to: BasePart, offset: CFrame)
	part.Anchored = false
	part.Massless = true
	part.CFrame = to.CFrame * offset
	local w = Instance.new("Weld")
	w.Part0 = to
	w.Part1 = part
	w.C0 = offset
	w.Parent = part
end

local function newPart(shape: string, size: Vector3, color: Color3, neon: boolean): BasePart
	local p: BasePart
	if shape == "wedge" then
		p = Instance.new("WedgePart")
	elseif shape == "ball" then
		local b = Instance.new("Part")
		b.Shape = Enum.PartType.Ball
		p = b
	elseif shape == "cyl" then
		local b = Instance.new("Part")
		b.Shape = Enum.PartType.Cylinder
		p = b
	else
		p = Instance.new("Part")
	end
	p.Size = size
	p.Color = color
	p.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Name = "KiwCrest"
	return p
end

---------------------------------------------------------------------------
-- Transformation look: crest + hair + outline
---------------------------------------------------------------------------
local function clearCrest(rig: Rig)
	for _, p in rig.crest do
		p:Destroy()
	end
	table.clear(rig.crest)
	for _, h in rig.hair do
		if h.part.Parent then
			h.part.Color = h.color
			if h.texture ~= nil and h.part:IsA("MeshPart") then
				h.part.TextureID = h.texture
			end
			if h.mesh and h.mesh.Parent and h.meshTexture then
				h.mesh.TextureId = h.meshTexture
			end
		end
	end
	table.clear(rig.hair)
	if rig.highlight then
		rig.highlight:Destroy()
		rig.highlight = nil
	end
end

local function applyForm(rig: Rig, form: number)
	clearCrest(rig)
	rig.shownForm = form
	local head = rig.head
	if form <= 0 or not head then
		return
	end
	local c1, c2, style = Fx.formColors(form)
	-- hair takes the form colour (texture off so the colour shows)
	for _, acc in rig.char:GetChildren() do
		if acc:IsA("Accessory") then
			local handle = acc:FindFirstChild("Handle")
			local isHair = acc.AccessoryType == Enum.AccessoryType.Hair or acc.Name:lower():find("hair") ~= nil
			if handle and handle:IsA("BasePart") and isHair then
				local entry = { part = handle, color = handle.Color, texture = nil, mesh = nil, meshTexture = nil }
				if handle:IsA("MeshPart") then
					entry.texture = handle.TextureID
					handle.TextureID = ""
				end
				local mesh = handle:FindFirstChildOfClass("SpecialMesh")
				if mesh then
					entry.mesh = mesh
					entry.meshTexture = mesh.TextureId
					mesh.TextureId = ""
				end
				handle.Color = c1
				table.insert(rig.hair, entry)
			end
		end
	end
	-- crest: a glowing crown behind / above the head, different per style
	local function add(shape: string, size: Vector3, color: Color3, offset: CFrame)
		local p = newPart(shape, size, color, true)
		weld(p, head, offset)
		p.Parent = rig.char
		table.insert(rig.crest, p)
		return p
	end
	local tier = math.min(form, 7)
	if style == "flame" then
		-- fan of flame blades rising behind the head
		local n = 3 + math.min(tier, 2) * 2
		for i = 1, n do
			local k = (i - (n + 1) / 2)
			local h = 2.2 + (1 - math.abs(k) / n) * 2.2 + tier * 0.2
			add("wedge", Vector3.new(0.35, h, 1), if i % 2 == 0 then c2 else c1, CFrame.new(k * 0.42, 0.7 + h * 0.4, 0.75) * CFrame.Angles(math.rad(-16), 0, math.rad(-k * 13)))
		end
	elseif style == "lightning" then
		-- swept-back blades + a halo
		for _, side in { -1, 1 } do
			add("wedge", Vector3.new(0.3, 3.4, 1.2), c1, CFrame.new(side * 0.55, 1.5, 0.9) * CFrame.Angles(math.rad(-38), 0, math.rad(-side * 20)))
			add("wedge", Vector3.new(0.3, 2.2, 0.9), c2, CFrame.new(side * 1.05, 1.0, 0.7) * CFrame.Angles(math.rad(-30), 0, math.rad(-side * 44)))
		end
		add("wedge", Vector3.new(0.35, 4.2, 1.2), c2, CFrame.new(0, 1.9, 1.0) * CFrame.Angles(math.rad(-30), 0, 0))
		local halo = add("cyl", Vector3.new(0.18, 3.6, 3.6), c1, CFrame.new(0, 2.6, 0.2) * CFrame.Angles(0, 0, math.rad(90)))
		halo.Transparency = 0.25
	elseif style == "shadow" then
		-- horns + dark halo
		for _, side in { -1, 1 } do
			add("wedge", Vector3.new(0.5, 2.6, 0.8), c1, CFrame.new(side * 0.85, 1.3, 0) * CFrame.Angles(0, math.rad(90 * side), math.rad(-side * 18)))
			add("wedge", Vector3.new(0.4, 1.6, 0.6), WHITE, CFrame.new(side * 1.25, 2.7, 0) * CFrame.Angles(0, math.rad(90 * side), math.rad(side * 10)))
		end
		local halo = add("cyl", Vector3.new(0.2, 4.4, 4.4), c1, CFrame.new(0, 0.4, 1.1) * CFrame.Angles(0, math.rad(90), 0))
		halo.Transparency = 0.2
		local inner = add("cyl", Vector3.new(0.22, 3.4, 3.4), c2, CFrame.new(0, 0.4, 1.12) * CFrame.Angles(0, math.rad(90), 0))
		inner.Material = Enum.Material.SmoothPlastic
	else -- prism: halo + shards
		local halo = add("cyl", Vector3.new(0.2, 4.8, 4.8), c1, CFrame.new(0, 0.5, 1.1) * CFrame.Angles(0, math.rad(90), 0))
		halo.Transparency = 0.15
		for i = 1, 6 do
			local a = i / 6 * math.pi * 2
			add("block", Vector3.new(0.4, 1.7, 0.4), if i % 2 == 0 then c1 else c2, CFrame.new(math.cos(a) * 2.9, 0.5 + math.sin(a) * 2.9, 1.1) * CFrame.Angles(0, 0, a + math.rad(90)))
		end
	end
	local hl = Instance.new("Highlight")
	hl.Name = "KiwFormOutline"
	hl.FillColor = c1
	hl.FillTransparency = 0.9
	hl.OutlineColor = c2
	hl.OutlineTransparency = 0.1
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Adornee = rig.char
	hl.Parent = rig.char
	rig.highlight = hl
end

-- Race marks (small welded parts; none for terran).
local function applyRace(rig: Rig, race: string?)
	for _, p in rig.marks do
		p:Destroy()
	end
	table.clear(rig.marks)
	rig.race = race
	local head = rig.head
	local def = race and Config.RaceById[race]
	if not head or not def or race == "terran" then
		return
	end
	local c = Color3.fromRGB(def.color[1], def.color[2], def.color[3])
	local function add(shape, size, offset)
		local p = newPart(shape, size, c, true)
		p.Name = "KiwMark"
		weld(p, head, offset)
		p.Parent = rig.char
		table.insert(rig.marks, p)
	end
	if race == "voltari" then
		add("block", Vector3.new(0.25, 0.7, 0.12), CFrame.new(0, 0.32, -0.62) * CFrame.Angles(0, 0, math.rad(20)))
		add("block", Vector3.new(0.25, 0.5, 0.12), CFrame.new(0.12, 0.05, -0.62) * CFrame.Angles(0, 0, math.rad(-30)))
	elseif race == "lumen" then
		for _, side in { -1, 1 } do
			add("block", Vector3.new(0.3, 0.9, 0.3), CFrame.new(side * 0.72, 0.35, 0) * CFrame.Angles(0, 0, math.rad(-side * 25)))
		end
		add("ball", Vector3.new(0.34, 0.34, 0.34), CFrame.new(0, 0.3, -0.62))
	elseif race == "drakhar" then
		for _, side in { -1, 1 } do
			add("wedge", Vector3.new(0.3, 1.1, 0.5), CFrame.new(side * 0.5, 0.95, -0.1) * CFrame.Angles(math.rad(12), 0, math.rad(-side * 14)))
		end
	end
end

---------------------------------------------------------------------------
-- Aura
---------------------------------------------------------------------------
local function releaseAura(rig: Rig)
	for _, p in rig.tongues do
		Fx.release(p)
	end
	table.clear(rig.tongues)
	for _, p in rig.bolts do
		Fx.release(p)
	end
	table.clear(rig.bolts)
	if rig.shell then
		Fx.release(rig.shell)
		rig.shell = nil
	end
	if rig.ring then
		Fx.release(rig.ring)
		rig.ring = nil
	end
	if rig.emitter then
		rig.emitter.Enabled = false
	end
	if rig.light then
		rig.light.Enabled = false
	end
	rig.auraOn = false
end

local function ensureAura(rig: Rig, count: number, withBolts: boolean)
	while #rig.tongues < count do
		local p = Fx.get("blob")
		p:SetAttribute("Phase", math.random())
		p:SetAttribute("Angle", math.random() * math.pi * 2)
		table.insert(rig.tongues, p)
	end
	while #rig.tongues > count do
		Fx.release(table.remove(rig.tongues) :: any)
	end
	if not rig.shell then
		rig.shell = Fx.get("blob")
	end
	if not rig.ring then
		rig.ring = Fx.get("cyl")
	end
	local wantBolts = if withBolts then 3 else 0
	while #rig.bolts < wantBolts * 3 do
		table.insert(rig.bolts, Fx.get("block"))
	end
	while #rig.bolts > wantBolts * 3 do
		Fx.release(table.remove(rig.bolts) :: any)
	end
	if not Fx.lite then
		if not rig.emitter then
			local att = Instance.new("Attachment")
			att.Name = "KiwAura"
			att.Position = Vector3.new(0, -2.6, 0)
			att.Parent = rig.root
			local e = Instance.new("ParticleEmitter")
			e.Speed = NumberRange.new(9, 16)
			e.Lifetime = NumberRange.new(0.5, 0.9)
			e.Rate = 34
			e.SpreadAngle = Vector2.new(24, 24)
			e.EmissionDirection = Enum.NormalId.Top
			e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.4), NumberSequenceKeypoint.new(1, 0.1) })
			e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
			e.LightEmission = 1
			e.Squash = NumberSequence.new(1.6)
			e.Parent = att
			rig.emitter = e
			local l = Instance.new("PointLight")
			l.Range = 22
			l.Brightness = 2
			l.Shadows = false
			l.Parent = rig.root
			rig.light = l
		end
		rig.emitter.Enabled = true
		rig.light.Enabled = true
	end
	rig.auraOn = true
end

local function zigzag(parts: { BasePart }, index: number, from: Vector3, to: Vector3, color: Color3)
	local a = from
	for seg = 1, 3 do
		local t = seg / 3
		local b = from:Lerp(to, t)
		if seg < 3 then
			b += Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 2.2
		end
		local p = parts[(index - 1) * 3 + seg]
		local len = (b - a).Magnitude
		p.Size = Vector3.new(0.22, 0.22, len)
		p.CFrame = CFrame.lookAt(a, b) * CFrame.new(0, 0, -len / 2)
		p.Color = color
		a = b
	end
end

local function updateAura(rig: Rig, now: number, camPos: Vector3)
	local char = rig.char
	local form = char:GetAttribute("Form") or 0
	local charging = char:GetAttribute("Charging") == true
	local beaming = char:GetAttribute("Beam") == true
	local auraColor = Fx.auraColor(char:GetAttribute("Aura"))
	local hum = rig.hum
	local alive = not hum or hum.Health > 0
	local intensity = 0
	if alive then
		if charging then
			intensity = 1.15
		elseif beaming then
			intensity = 0.9
		elseif form > 0 then
			intensity = 0.72
		elseif auraColor then
			intensity = 0.34
		end
	end
	if rig.surge > 0 then
		intensity = math.max(intensity, 0.8) + rig.surge
	end
	local pos = rig.root.Position
	local dist = (camPos - pos).Magnitude
	if intensity <= 0 or dist > (if Fx.lite then 170 else 320) then
		if rig.auraOn then
			releaseAura(rig)
		end
		return
	end
	local c1, c2, style = Fx.formColors(form)
	if form <= 0 and auraColor then
		c1, c2 = auraColor, auraColor:Lerp(WHITE, 0.6)
	end
	if style == "prism" then
		c1 = Color3.fromHSV((now * 0.25) % 1, 0.55, 1)
	end
	local far = dist > 120
	local count = if intensity < 0.5 then 3 elseif Fx.lite or far then 5 else 9
	ensureAura(rig, count, (style == "lightning" or style == "prism") and form > 0 and not far)
	local scale = 0.75 + intensity * 0.45
	local rootCf = CFrame.new(pos)
	local speed = 1.3 + intensity * 0.9
	for i, p in rig.tongues do
		local t = (now * speed + p:GetAttribute("Phase")) % 1
		local a = p:GetAttribute("Angle") + now * 0.6
		local r = (2.3 - t * 1.5) * scale
		local h = (2.2 + math.sin(math.pi * t) * 3.4) * scale
		local w = (1.9 - t * 1.4) * scale
		p.Size = Vector3.new(w, h, w)
		p.CFrame = rootCf * CFrame.new(math.cos(a) * r, -2.8 + t * 7.5 * scale, math.sin(a) * r)
		p.Color = if style == "shadow" and i % 3 == 0 then c2 else c1:Lerp(c2, t * 0.8)
		p.Material = if style == "shadow" and i % 3 == 0 then Enum.Material.SmoothPlastic else Enum.Material.Neon
		p.Transparency = 0.3 + t * 0.62
	end
	local pulse = 1 + math.sin(now * 9) * 0.05
	local shell = rig.shell
	shell.Size = Vector3.new(6.2, 9.4, 6.2) * scale * pulse
	shell.CFrame = rootCf * CFrame.new(0, 0.6, 0)
	shell.Color = c1
	shell.Transparency = 0.86 - math.min(intensity, 1.2) * 0.1
	local ring = rig.ring
	local grounded = hum and hum.FloorMaterial ~= Enum.Material.Air
	if grounded then
		local rr = (5 + math.sin(now * 6) * 0.6) * scale
		ring.Size = Vector3.new(0.25, rr * 2, rr * 2)
		ring.CFrame = rootCf * CFrame.new(0, -2.85, 0) * CFrame.Angles(0, 0, math.rad(90))
		ring.Color = c1
		ring.Transparency = 0.45
	else
		ring.Transparency = 1
	end
	if #rig.bolts > 0 and now >= rig.boltAt then
		rig.boltAt = now + 0.07
		for b = 1, #rig.bolts // 3 do
			local a = math.random() * math.pi * 2
			local from = pos + Vector3.new(math.cos(a) * 1.6, -2.4 + math.random() * 1.5, math.sin(a) * 1.6)
			local to = pos + Vector3.new(math.cos(a + 1) * 3.2, 1.5 + math.random() * 3.5, math.sin(a + 1) * 3.2)
			zigzag(rig.bolts, b, from, to, if style == "prism" then c2 else c2:Lerp(WHITE, 0.4))
		end
	end
	if rig.emitter and rig.emitter.Enabled then
		rig.emitter.Color = ColorSequence.new(c2, c1)
		rig.emitter.Rate = 16 + intensity * 30
		rig.light.Color = c1
		rig.light.Brightness = 1 + intensity * 1.6
	end
end

---------------------------------------------------------------------------
-- Poses
---------------------------------------------------------------------------
local rad = math.rad
local function A(x: number, y: number, z: number): CFrame
	return CFrame.Angles(rad(x), rad(y), rad(z))
end
local POSES: { [string]: { [string]: CFrame } } = {
	charge = {
		Waist = A(-10, 0, 0),
		Neck = A(12, 0, 0),
		RightShoulder = A(-18, 0, 34),
		LeftShoulder = A(-18, 0, -34),
		RightElbow = A(70, 0, 0),
		LeftElbow = A(70, 0, 0),
		RightHip = A(30, 0, 12),
		LeftHip = A(30, 0, -12),
		RightKnee = A(-52, 0, 0),
		LeftKnee = A(-52, 0, 0),
	},
	block = {
		Waist = A(-6, 0, 0),
		RightShoulder = A(105, 0, -42),
		LeftShoulder = A(105, 0, 42),
		RightElbow = A(62, 0, 0),
		LeftElbow = A(62, 0, 0),
		RightHip = A(14, 0, 8),
		LeftHip = A(-10, 0, -8),
	},
	beamCharge = {
		Waist = A(-6, -46, 0),
		Neck = A(0, 40, 0),
		RightShoulder = A(22, 0, 12),
		LeftShoulder = A(60, 0, 56),
		RightElbow = A(74, 0, 0),
		LeftElbow = A(60, 0, 0),
		RightHip = A(22, 0, 14),
		LeftHip = A(-16, 0, -10),
		RightKnee = A(-30, 0, 0),
		LeftKnee = A(-22, 0, 0),
	},
	beamFire = {
		Waist = A(-10, 0, 0),
		RightShoulder = A(92, 0, -14),
		LeftShoulder = A(92, 0, 14),
		RightElbow = A(6, 0, 0),
		LeftElbow = A(6, 0, 0),
		RightHip = A(26, 0, 12),
		LeftHip = A(-22, 0, -12),
		RightKnee = A(-24, 0, 0),
		LeftKnee = A(-10, 0, 0),
	},
	fly = {
		Waist = A(6, 0, 0),
		Neck = A(34, 0, 0),
		RightShoulder = A(-32, 0, 12),
		LeftShoulder = A(-32, 0, -12),
		RightElbow = A(10, 0, 0),
		LeftElbow = A(10, 0, 0),
		RightHip = A(-8, 0, 4),
		LeftHip = A(12, 0, -4),
		RightKnee = A(-8, 0, 0),
		LeftKnee = A(-36, 0, 0),
	},
	hover = {
		RightShoulder = A(-8, 0, 16),
		LeftShoulder = A(-8, 0, -16),
		RightElbow = A(28, 0, 0),
		LeftElbow = A(28, 0, 0),
		RightHip = A(10, 0, 5),
		LeftHip = A(-4, 0, -5),
		RightKnee = A(-26, 0, 0),
		LeftKnee = A(-10, 0, 0),
	},
	punchR = {
		Waist = A(-4, 28, 0),
		RightShoulder = A(96, 0, -10),
		RightElbow = A(4, 0, 0),
		LeftShoulder = A(30, 0, 18),
		LeftElbow = A(96, 0, 0),
	},
	punchL = {
		Waist = A(-4, -28, 0),
		LeftShoulder = A(96, 0, 10),
		LeftElbow = A(4, 0, 0),
		RightShoulder = A(30, 0, -18),
		RightElbow = A(96, 0, 0),
	},
	flinch = {
		Waist = A(16, 0, 0),
		Neck = A(-14, 0, 0),
		RightShoulder = A(-20, 0, 22),
		LeftShoulder = A(-20, 0, -22),
	},
}
local POSE_ORDER = { "hover", "fly", "charge", "block", "beamCharge", "beamFire", "punchR", "punchL", "flinch" }

local function blendTo(current: number, target: number, dt: number, speed: number): number
	if current < target then
		return math.min(target, current + dt * speed)
	end
	return math.max(target, current - dt * speed)
end

local function updatePose(rig: Rig, dt: number, now: number)
	if not rig.r15 then
		return
	end
	local char = rig.char
	local w = rig.w
	local flying = char:GetAttribute("Flying") == true
	local moving = rig.root.AssemblyLinearVelocity.Magnitude > 14
	w.fly = blendTo(w.fly, if flying and moving then 1 else 0, dt, 6)
	w.hover = blendTo(w.hover, if flying and not moving then 1 else 0, dt, 6)
	w.charge = blendTo(w.charge, if char:GetAttribute("Charging") == true then 1 else 0, dt, 9)
	w.block = blendTo(w.block, if char:GetAttribute("Blocking") == true then 1 else 0, dt, 14)
	w.beamCharge = blendTo(w.beamCharge, if char:GetAttribute("Beam") == true then 1 else 0, dt, 9)
	-- beam release: short hold of the firing pose
	w.beamFire = blendTo(w.beamFire, if now - (rig :: any).beamAt < 0.5 then 1 else 0, dt, 12)
	-- punch: fast out (0.07 s), slower back (0.2 s)
	local pt = now - rig.punchAt
	local punch = 0
	if pt < 0.07 then
		punch = pt / 0.07
	elseif pt < 0.3 then
		punch = 1 - (pt - 0.07) / 0.23
	end
	if rig.punchBig then
		punch = math.min(1, punch * 1.25)
	end
	w.punchR = if rig.punchSide == 1 then punch else 0
	w.punchL = if rig.punchSide == -1 then punch else 0
	local ft = now - rig.flinchAt
	w.flinch = if ft < 0.25 then 1 - ft / 0.25 else 0

	local shake = if w.charge > 0.5 then math.sin(now * 60) * 1.4 else 0
	for _, name in JOINTS do
		local m = rig.joints[name]
		if m then
			local cf = m.Transform
			local touched = false
			for _, poseName in POSE_ORDER do
				local weight = w[poseName]
				if weight > 0.01 then
					local target = POSES[poseName][name]
					if target then
						cf = cf:Lerp(target, weight)
						touched = true
					end
				end
			end
			if touched then
				if shake ~= 0 and (name == "RightShoulder" or name == "LeftShoulder") then
					cf *= CFrame.Angles(rad(shake), 0, 0)
				end
				m.Transform = cf
			end
		end
	end
end

---------------------------------------------------------------------------
-- Tag
---------------------------------------------------------------------------
local function updateTag(rig: Rig)
	local char = rig.char
	local power = char:GetAttribute("Power")
	local head = rig.head
	if not power or not head then
		return
	end
	local form = char:GetAttribute("Form") or 0
	local key = power .. ":" .. form
	if rig.tagPower == key then
		return
	end
	rig.tagPower = key
	local bb = rig.tag
	if not bb then
		bb = Instance.new("BillboardGui")
		bb.Name = "KiwTag"
		bb.Size = UDim2.fromOffset(190, 46)
		bb.StudsOffset = Vector3.new(0, 3.1, 0)
		bb.MaxDistance = 140
		bb.LightInfluence = 0
		local t = Instance.new("TextLabel")
		t.Name = "Power"
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 0.62)
		t.Font = Enum.Font.Bangers
		t.TextScaled = true
		local s = Instance.new("UIStroke")
		s.Thickness = 2.5
		s.Color = Color3.fromRGB(20, 14, 34)
		s.Parent = t
		t.Parent = bb
		local f = Instance.new("TextLabel")
		f.Name = "Form"
		f.BackgroundTransparency = 1
		f.Size = UDim2.fromScale(1, 0.38)
		f.Position = UDim2.fromScale(0, 0.62)
		f.Font = Enum.Font.GothamBlack
		f.TextScaled = true
		local s2 = s:Clone()
		s2.Thickness = 2
		s2.Parent = f
		f.Parent = bb
		bb.Adornee = head
		bb.Parent = head
		rig.tag = bb
	end
	local c1 = Fx.formColors(form)
	bb.Power.Text = "⚡ " .. Format.abbrev(power)
	bb.Power.TextColor3 = if form > 0 then c1:Lerp(WHITE, 0.35) else Color3.fromRGB(255, 236, 140)
	bb.Form.Text = if form > 0 then Lang.t("form." .. Config.Forms[form].id) else ""
	bb.Form.TextColor3 = c1
end

---------------------------------------------------------------------------
-- Rig tracking
---------------------------------------------------------------------------
local function addRig(char: Model)
	if rigs[char] then
		return
	end
	local root = char:WaitForChild("HumanoidRootPart", 8)
	local hum = char:WaitForChild("Humanoid", 8)
	if not root or not char.Parent then
		return
	end
	local rig: Rig = {
		beamAt = -10,
		char = char,
		hum = hum,
		root = root,
		head = char:FindFirstChild("Head"),
		joints = {},
		r15 = hum ~= nil and hum.RigType == Enum.HumanoidRigType.R15,
		tongues = {},
		bolts = {},
		boltAt = 0,
		auraOn = false,
		surge = 0,
		shownForm = 0,
		crest = {},
		hair = {},
		w = { fly = 0, hover = 0, charge = 0, block = 0, beamCharge = 0, beamFire = 0, punchR = 0, punchL = 0, flinch = 0 },
		punchAt = -10,
		punchSide = 1,
		punchBig = false,
		flinchAt = -10,
		marks = {},
	}
	local function scan()
		for _, d in char:GetDescendants() do
			if d:IsA("Motor6D") and table.find(JOINTS, d.Name) then
				rig.joints[d.Name] = d
			end
		end
		rig.head = char:FindFirstChild("Head")
	end
	scan()
	task.delay(1.5, scan) -- limbs can stream in after the root
	rigs[char] = rig
	local function bindId()
		local id = char:GetAttribute("FighterId")
		if id then
			byFighter[id] = rig
		end
	end
	bindId()
	char:GetAttributeChangedSignal("FighterId"):Connect(bindId)
	char.AncestryChanged:Connect(function(_, parent)
		if not parent then
			releaseAura(rig)
			clearCrest(rig)
			rigs[char] = nil
			for id, r in byFighter do
				if r == rig then
					byFighter[id] = nil
				end
			end
		end
	end)
end

local function rigOf(d): Rig?
	if d.i and byFighter[d.i] then
		return byFighter[d.i]
	end
	if d.u and d.u ~= 0 then
		local plr = Players:GetPlayerByUserId(d.u)
		if plr and plr.Character then
			return rigs[plr.Character]
		end
	end
	return nil
end
CharFx.rigOf = rigOf

-- Big transformation moment.
local function transformBurst(rig: Rig, form: number)
	local pos = rig.root.Position
	local c1, c2 = Fx.formColors(form)
	local ground = Vector3.new(pos.X, pos.Y - 2.8, pos.Z)
	rig.surge = 1.2
	-- light pillar
	local pillar = Fx.get("cyl")
	pillar.Color = c2
	pillar.Transparency = 0.2
	pillar.Size = Vector3.new(120, 3, 3)
	pillar.CFrame = CFrame.new(pos + Vector3.new(0, 56, 0)) * CFrame.Angles(0, 0, rad(90))
	Fx.tween(pillar, 0.5, { Size = Vector3.new(120, 16, 16), Transparency = 1 })
	task.delay(0.5, Fx.release, pillar)
	local pillar2 = Fx.get("cyl")
	pillar2.Color = c1
	pillar2.Transparency = 0.5
	pillar2.Size = Vector3.new(120, 6, 6)
	pillar2.CFrame = pillar.CFrame
	Fx.tween(pillar2, 0.7, { Size = Vector3.new(120, 26, 26), Transparency = 1 })
	task.delay(0.7, Fx.release, pillar2)
	Fx.burst(pos, 3, 22, c1, 0.5, 0.35)
	Fx.burst(pos, 2, 13, WHITE, 0.3, 0.2)
	Fx.ring(ground, 3, 34, c1, 0.6, 0.8)
	Fx.ring(ground + Vector3.new(0, 0.1, 0), 2, 22, c2, 0.45, 0.5)
	Fx.sparks(pos, c2, 16, 70, 0.8)
	-- ground cracks: slabs thrown up in a ring (geometry, visible at any quality)
	for i = 1, (if Fx.lite then 5 else 9) do
		local a = i / 9 * math.pi * 2
		local at = ground + Vector3.new(math.cos(a) * 7, 0, math.sin(a) * 7)
		local slab = Fx.get("block")
		slab.Material = Enum.Material.Slate
		slab.Color = Color3.fromRGB(96, 88, 92)
		slab.Size = Vector3.new(1.6, 0.9, 1.4)
		slab.CFrame = CFrame.new(at) * CFrame.Angles(math.random(), a, math.random())
		local up = at + Vector3.new(math.cos(a) * 3, 6 + math.random() * 5, math.sin(a) * 3)
		Fx.tween(slab, 0.5, { CFrame = CFrame.new(up) * CFrame.Angles(a, a * 2, 1) })
		task.delay(0.5, function()
			Fx.tween(slab, 0.4, { Size = Vector3.new(0.1, 0.1, 0.1), Transparency = 1 })
			task.wait(0.4)
			Fx.release(slab)
		end)
	end
	local cam = workspace.CurrentCamera
	local dist = if cam then (cam.CFrame.Position - pos).Magnitude else 0
	Fx.shake(math.clamp(1.6 - dist / 100, 0, 1.6))
	if rig.char == player.Character then
		Fx.kick(16)
	end
	Fx.sound("boom", 0.6, 0.55)
end

CharFx.transformBurst = transformBurst

function CharFx.swing(rig: Rig, big: boolean)
	rig.punchAt = os.clock()
	rig.punchSide = -rig.punchSide
	rig.punchBig = big
	-- swing arc in front of the fist (geometry)
	local cf = rig.root.CFrame * CFrame.new(rig.punchSide * 0.9, 0.6, -2.6)
	Fx.flash("blob", cf, Vector3.new(0.5, 0.5, 3.2), WHITE, 0.12, { Size = Vector3.new(0.15, 0.15, 6.5), Transparency = 1, CFrame = cf * CFrame.new(0, 0, -2) }, 0.3)
end

-- Instant feedback for the local player's own punch (the server echo arrives later).
function CharFx.punchNow()
	local char = player.Character
	local rig = char and rigs[char]
	if rig then
		CharFx.swing(rig, false)
	end
end

function CharFx.init()
	local function onPlayer(plr: Player)
		plr.CharacterAdded:Connect(function(char)
			task.spawn(addRig, char)
		end)
		if plr.Character then
			task.spawn(addRig, plr.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, plr in Players:GetPlayers() do
		onPlayer(plr)
	end
	-- server dummies
	local function watchDummies(folder: Instance)
		folder.ChildAdded:Connect(function(c)
			if c:IsA("Model") then
				task.spawn(addRig, c)
			end
		end)
		for _, c in folder:GetChildren() do
			if c:IsA("Model") then
				task.spawn(addRig, c)
			end
		end
	end
	local dummies = workspace:FindFirstChild("Dummies")
	if dummies then
		watchDummies(dummies)
	else
		workspace.ChildAdded:Connect(function(c)
			if c.Name == "Dummies" then
				watchDummies(c)
			end
		end)
	end

	CombatFx.on("swing", function(d)
		local rig = rigOf(d)
		if rig then
			local own = rig.char == player.Character
			-- the local player's punch is already playing (CharFx.punchNow): don't restart it
			if not own or os.clock() - rig.punchAt > 0.25 then
				CharFx.swing(rig, d.f == true)
			elseif d.f then
				rig.punchBig = true
			end
			if own and d.h == 0 then
				Fx.sound("swing", 0.12, 2.2)
			end
		end
	end)
	CombatFx.on("hit", function(d)
		local rig = byFighter[d.v]
		if rig and not d.b then
			rig.flinchAt = os.clock()
		end
	end)
	CombatFx.on("beam", function(d)
		local rig = rigOf(d)
		if rig then
			(rig :: any).beamAt = os.clock()
		end
	end)
	CombatFx.on("form", function(d)
		local rig = rigOf(d)
		if rig then
			applyForm(rig, d.f)
			if d.f > 0 then
				transformBurst(rig, d.f)
			else
				Fx.burst(rig.root.Position, 5, 2, Color3.fromRGB(200, 220, 255), 0.25, 0.5)
			end
		end
	end)
	CombatFx.on("dash", function(d)
		local rig = rigOf(d)
		if rig then
			-- afterimage: a few fading silhouettes (blobs) along the path
			local c1 = Fx.formColors(rig.char:GetAttribute("Form"))
			local from = d.p
			task.spawn(function()
				for i = 1, 4 do
					local at = from:Lerp(rig.root.Position, i / 4)
					Fx.flash("blob", CFrame.new(at), Vector3.new(3, 5.6, 3), c1, 0.28, { Size = Vector3.new(0.6, 6.5, 0.6), Transparency = 1 }, 0.35)
					task.wait(0.025)
				end
			end)
		end
	end)

	RunService.Stepped:Connect(function(_, dt)
		if Fx.frozen() then
			return
		end
		local now = os.clock()
		for _, rig in rigs do
			if rig.root.Parent then
				updatePose(rig, dt, now)
			end
		end
	end)

	local tagAcc = 0
	RunService.RenderStepped:Connect(function(dt)
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		local now = os.clock()
		local camPos = cam.CFrame.Position
		tagAcc += dt
		local doTags = tagAcc > 0.3
		if doTags then
			tagAcc = 0
		end
		for char, rig in rigs do
			if not rig.root.Parent then
				continue
			end
			rig.surge = math.max(0, rig.surge - dt * 1.4)
			updateAura(rig, now, camPos)
			if doTags then
				local form = char:GetAttribute("Form") or 0
				if form ~= rig.shownForm then
					applyForm(rig, form)
				end
				local race = char:GetAttribute("Race")
				if race ~= rig.race then
					applyRace(rig, race)
				end
				updateTag(rig)
			end
		end
	end)
end

return CharFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">CombatFx</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Renders everything the server reports through the Fx remote: projectiles, beams, hits
-- (sparks, damage numbers, hit-stop, shake), shockwaves, boss telegraphs, enemy deaths.
-- All parts are pooled; one RenderStepped loop moves every projectile.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Net = require(script.Parent.Net)
local Fx = require(script.Parent.Fx)

local CombatFx = {}

local player = Players.LocalPlayer
local myId = player.UserId
local WHITE = Color3.new(1, 1, 1)

-- kind -> listeners (CharFx, NpcRender, Hud hook in here)
local listeners: { [string]: { (any) -> () } } = {}
function CombatFx.on(kind: string, fn: (any) -> ())
	listeners[kind] = listeners[kind] or {}
	table.insert(listeners[kind], fn)
end

local function camDist(pos: Vector3): number
	local cam = workspace.CurrentCamera
	return if cam then (cam.CFrame.Position - pos).Magnitude else 0
end
local function visible(pos: Vector3): boolean
	return camDist(pos) < (if Fx.lite then 240 else 420)
end

---------------------------------------------------------------------------
-- Damage numbers (pooled BillboardGuis)
---------------------------------------------------------------------------
local numberPool: { BillboardGui } = {}
local numbersAlive = 0
local function damageNumber(pos: Vector3, text: string, color: Color3, big: boolean)
	if numbersAlive > 28 then
		return
	end
	local bb = table.remove(numberPool)
	if not bb then
		bb = Instance.new("BillboardGui")
		bb.Name = "Dmg"
		bb.AlwaysOnTop = true
		bb.LightInfluence = 0
		bb.ResetOnSpawn = false
		local t = Instance.new("TextLabel")
		t.Name = "T"
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.Font = Enum.Font.Bangers
		t.TextScaled = true
		local s = Instance.new("UIStroke")
		s.Thickness = 2.5
		s.Color = Color3.fromRGB(20, 12, 30)
		s.Parent = t
		local sc = Instance.new("UIScale")
		sc.Parent = t
		t.Parent = bb
	end
	numbersAlive += 1
	local t = bb.T
	local sc = t.UIScale
	bb.Size = if big then UDim2.fromOffset(190, 64) else UDim2.fromOffset(130, 44)
	local offset = Vector3.new((math.random() - 0.5) * 4, 2.5 + math.random() * 1.5, (math.random() - 0.5) * 4)
	bb.StudsOffsetWorldSpace = pos + offset
	t.Text = text
	t.TextColor3 = color
	t.TextTransparency = 0
	t.UIStroke.Transparency = 0
	t.Rotation = (math.random() - 0.5) * 16
	sc.Scale = 0.3
	bb.Parent = player:FindFirstChildOfClass("PlayerGui")
	TweenService:Create(sc, TweenInfo.new(0.16, Enum.EasingStyle.Back), { Scale = if big then 1.25 else 1 }):Play()
	TweenService:Create(bb, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffsetWorldSpace = pos + offset + Vector3.new(0, 4.5, 0) }):Play()
	task.delay(0.45, function()
		TweenService:Create(t, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
		TweenService:Create(t.UIStroke, TweenInfo.new(0.25), { Transparency = 1 }):Play()
	end)
	task.delay(0.72, function()
		bb.Parent = nil
		numbersAlive -= 1
		table.insert(numberPool, bb)
	end)
end
CombatFx.damageNumber = damageNumber

---------------------------------------------------------------------------
-- Projectiles
---------------------------------------------------------------------------
type Shot = { id: number, pos: Vector3, dir: Vector3, speed: number, left: number, core: BasePart, glow: BasePart, tail: BasePart, radius: number, color: Color3, hidden: boolean }
local shots: { [number]: Shot } = {}
local shotCount = 0

local function shotColor(d): (Color3, Color3)
	if d.c == "sun" then
		return Color3.fromRGB(255, 200, 60), Color3.fromRGB(255, 250, 200)
	elseif type(d.c) == "table" then
		return Color3.fromRGB(d.c[1], d.c[2], d.c[3]), WHITE
	end
	local c1, c2 = Fx.formColors(d.f)
	return c1, c2
end

local function addShot(d)
	if shotCount > 60 then
		return
	end
	local c1, c2 = shotColor(d)
	local r = d.z
	local hidden = not visible(d.o)
	local s: Shot = {
		id = d.i,
		pos = d.o,
		dir = d.d,
		speed = d.s,
		left = d.r,
		radius = r,
		color = c1,
		hidden = hidden,
		core = Fx.get("ball"),
		glow = Fx.get("ball"),
		tail = Fx.get("blob"),
	}
	s.core.Size = Vector3.one * r * 0.9
	s.core.Color = c2
	s.glow.Size = Vector3.one * r * 1.7
	s.glow.Color = c1
	s.glow.Transparency = 0.45
	s.tail.Size = Vector3.new(r * 1.1, r * 1.1, r * 5)
	s.tail.Color = c1
	s.tail.Transparency = 0.35
	shots[d.i] = s
	shotCount += 1
	if not hidden then
		-- muzzle flash
		Fx.burst(d.o, r * 0.4, r * 1.6, c2, 0.14, 0.2)
		if d.u == myId then
			Fx.sound("blast", 0.25, 1.5 + math.random() * 0.3)
		end
	end
end

local function removeShot(s: Shot)
	shots[s.id] = nil
	shotCount -= 1
	Fx.release(s.core)
	Fx.release(s.glow)
	Fx.release(s.tail)
end

local function endShot(d)
	local s = shots[d.i]
	local color = if s then s.color else Color3.fromRGB(110, 210, 255)
	local r = if s then s.radius else 4
	if s then
		removeShot(s)
	end
	if not visible(d.p) then
		return
	end
	if d.a and d.a > 0 then
		-- area explosion
		Fx.burst(d.p, 3, d.a, color, 0.45, 0.2)
		Fx.burst(d.p, 2, d.a * 0.6, WHITE, 0.3, 0.1)
		Fx.ring(Vector3.new(d.p.X, math.max(d.p.Y - 2, Config.GroundY + 0.4), d.p.Z), 2, d.a * 1.2, color, 0.5, 0.6)
		Fx.sparks(d.p, color, 14, 60, 0.9)
		Fx.shake(math.clamp(1.4 - camDist(d.p) / 120, 0, 1.4))
		Fx.sound("boom", 0.5, 0.8)
	else
		Fx.burst(d.p, r * 0.5, r * 1.8, color, 0.22, 0.2)
		Fx.burst(d.p, r * 0.3, r * 1.0, WHITE, 0.14, 0.1)
		if d.h then
			Fx.sparks(d.p, color, 6, 26, 0.45)
		end
	end
end

---------------------------------------------------------------------------
-- Beam
---------------------------------------------------------------------------
local function beam(d)
	if not visible(d.o) and not visible(d.o + d.d * d.l) then
		return
	end
	local c1, c2 = Fx.formColors(d.f)
	local len = d.l
	local r = d.z
	local mid = d.o + d.d * (len / 2)
	local axis = CFrame.lookAt(mid, mid + d.d) * CFrame.Angles(0, math.rad(90), 0)
	local hold = 0.28 + 0.25 * d.c
	-- outer glow, body, white core
	local outer = Fx.get("cyl")
	outer.Color = c1
	outer.Transparency = 0.55
	outer.Size = Vector3.new(len, r * 0.6, r * 0.6)
	outer.CFrame = axis
	local body = Fx.get("cyl")
	body.Color = c1
	body.Transparency = 0.15
	body.Size = Vector3.new(len, r * 0.3, r * 0.3)
	body.CFrame = axis
	local core = Fx.get("cyl")
	core.Color = c2:Lerp(WHITE, 0.5)
	core.Size = Vector3.new(len, r * 0.15, r * 0.15)
	core.CFrame = axis
	Fx.tween(outer, 0.09, { Size = Vector3.new(len, r * 2.6, r * 2.6) })
	Fx.tween(body, 0.09, { Size = Vector3.new(len, r * 1.7, r * 1.7) })
	Fx.tween(core, 0.09, { Size = Vector3.new(len, r * 0.9, r * 0.9) })
	-- head (at the hands) and tip
	local head = Fx.get("ball")
	head.Color = c1:Lerp(c2, 0.5)
	head.Transparency = 0.15
	head.Size = Vector3.one * r * 1.0
	head.CFrame = CFrame.new(d.o)
	Fx.tween(head, 0.1, { Size = Vector3.one * r * 2.2 })
	local tip = Fx.get("ball")
	tip.Color = c1
	tip.Transparency = 0.3
	tip.Size = Vector3.one * r * 2
	tip.CFrame = CFrame.new(d.o + d.d * len)
	Fx.tween(tip, 0.12, { Size = Vector3.one * r * 4 })
	-- rings racing down the beam
	for i = 1, (if Fx.lite then 2 else 4) do
		task.delay(i * 0.05, function()
			local from = d.o + d.d * 4
			local ring = Fx.get("cyl")
			ring.Color = c2
			ring.Transparency = 0.3
			ring.Size = Vector3.new(0.6, r * 3.4, r * 3.4)
			ring.CFrame = CFrame.lookAt(from, from + d.d) * CFrame.Angles(0, math.rad(90), 0)
			local to = d.o + d.d * math.min(len, 90)
			Fx.tween(ring, 0.3, { CFrame = CFrame.lookAt(to, to + d.d) * CFrame.Angles(0, math.rad(90), 0), Size = Vector3.new(0.3, r * 5, r * 5), Transparency = 1 }, Enum.EasingStyle.Linear)
			task.delay(0.3, Fx.release, ring)
		end)
	end
	task.delay(hold, function()
		local t = 0.18
		Fx.tween(outer, t, { Size = Vector3.new(len, 0.05, 0.05), Transparency = 1 })
		Fx.tween(body, t, { Size = Vector3.new(len, 0.05, 0.05), Transparency = 1 })
		Fx.tween(core, t, { Size = Vector3.new(len, 0.05, 0.05) })
		Fx.tween(head, t, { Size = Vector3.one * 0.2, Transparency = 1 })
		Fx.tween(tip, t, { Size = Vector3.one * 0.2, Transparency = 1 })
		task.wait(t)
		Fx.release(outer)
		Fx.release(body)
		Fx.release(core)
		Fx.release(head)
		Fx.release(tip)
	end)
	local near = math.clamp(1.3 - camDist(d.o) / 150, 0, 1.3)
	Fx.shake(near * (0.5 + d.c))
	if d.u == myId then
		Fx.kick(6 + 8 * d.c)
		Fx.sound("boom", 0.45, 1.3)
	end
end

---------------------------------------------------------------------------
-- Hits
---------------------------------------------------------------------------
local function hit(d)
	local mine = d.a == myId
	local onMe = d.u == myId
	local pos: Vector3 = d.p
	if not mine and not onMe and not visible(pos) then
		return
	end
	local color = if onMe then Color3.fromRGB(255, 80, 80) elseif d.c then Color3.fromRGB(255, 226, 70) else WHITE
	if d.b then
		-- blocked: blue shield flash
		Fx.burst(pos, 2.4, 4.2, Color3.fromRGB(120, 200, 255), 0.2, 0.45)
	elseif d.k == "melee" or d.k == "npc" then
		-- impact star: two crossed stretched blobs + sparks
		local cf = CFrame.new(pos + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, math.random() * 6.28, math.random() * 6.28)
		Fx.flash("blob", cf, Vector3.new(1, 1, 6), WHITE, 0.14, { Size = Vector3.new(0.2, 0.2, 13), Transparency = 1 })
		Fx.flash("blob", cf * CFrame.Angles(0, math.rad(90), 0), Vector3.new(1, 1, 6), color, 0.14, { Size = Vector3.new(0.2, 0.2, 13), Transparency = 1 })
		Fx.burst(pos, 1, 3.4, color, 0.16, 0.35)
		Fx.sparks(pos, if d.c then Color3.fromRGB(255, 226, 70) else Color3.fromRGB(255, 240, 200), if d.f then 10 else 5, 28, 0.4)
		if d.f then
			Fx.ring(Vector3.new(pos.X, math.max(pos.Y - 2.5, Config.GroundY + 0.4), pos.Z), 2, 16, WHITE, 0.35, 0.5)
			Fx.burst(pos, 2, 9, WHITE, 0.25, 0.4)
		end
	else
		Fx.sparks(pos, color, 5, 24, 0.4)
	end
	if mine then
		Fx.hitStop(if d.f then 0.11 elseif d.c then 0.07 else 0.045)
		Fx.shake(if d.f then 0.9 elseif d.k == "melee" then 0.35 else 0.15)
		if d.k == "melee" then
			Fx.sound("punch", if d.f then 0.55 else 0.3, if d.f then 0.9 else 1.6 + math.random() * 0.4)
		end
	elseif onMe then
		Fx.shake(0.8)
		Fx.sound("punch", 0.4, 0.7)
	end
	if (mine or onMe) and d.d > 0 then
		local text = Format.abbrev(math.max(1, d.d))
		if d.c then
			text ..= "!"
		end
		if onMe then
			text = "-" .. text
		end
		damageNumber(pos, text, color, d.c or d.f or false)
	end
end

---------------------------------------------------------------------------
-- Shockwaves, telegraphs, deaths
---------------------------------------------------------------------------
local function shock(d)
	if not visible(d.p) then
		return
	end
	local c1 = if d.n then Color3.fromRGB(255, 90, 60) else Fx.formColors(d.f)
	local ground = Vector3.new(d.p.X, Config.GroundY + 0.5, d.p.Z)
	Fx.ring(ground, 2, d.r * 1.15, c1, 0.5, 1)
	Fx.ring(ground, 1, d.r * 0.8, WHITE, 0.35, 0.6)
	Fx.burst(d.p, 3, d.r * 0.7, c1, 0.4, 0.35)
	-- debris: ground slabs kicked up in a circle
	local n = if Fx.lite then 6 else 12
	for i = 1, n do
		local a = i / n * math.pi * 2
		local at = ground + Vector3.new(math.cos(a) * d.r * 0.6, 0, math.sin(a) * d.r * 0.6)
		local slab = Fx.get("block")
		slab.Material = Enum.Material.Slate
		slab.Color = Color3.fromRGB(90, 80, 84)
		slab.Size = Vector3.new(3, 5, 2.4)
		slab.CFrame = CFrame.new(at - Vector3.new(0, 3, 0)) * CFrame.Angles(math.random() - 0.5, a, math.random() - 0.5)
		Fx.tween(slab, 0.18, { CFrame = slab.CFrame + Vector3.new(0, 4.5, 0) }, Enum.EasingStyle.Back)
		task.delay(0.55, function()
			Fx.tween(slab, 0.3, { CFrame = slab.CFrame - Vector3.new(0, 6, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.wait(0.3)
			Fx.release(slab)
		end)
	end
	Fx.shake(math.clamp(1.6 - camDist(d.p) / 110, 0, 1.6))
	Fx.sound("boom", 0.6, 0.7)
end

local function telegraph(d)
	if not visible(d.p) then
		return
	end
	local red = Color3.fromRGB(255, 60, 60)
	if d.k == "ring" then
		local cf = CFrame.new(d.p) * CFrame.Angles(0, 0, math.rad(90))
		Fx.flash("cyl", cf, Vector3.new(0.25, d.r * 2, d.r * 2), red, d.t, { Transparency = 0.55 }, 0.85)
		Fx.flash("cyl", cf + Vector3.new(0, 0.08, 0), Vector3.new(0.3, 1, 1), Color3.fromRGB(255, 160, 80), d.t, { Size = Vector3.new(0.3, d.r * 2, d.r * 2) }, 0.45)
	else
		local mid = d.p + d.d * (d.l / 2)
		local cf = CFrame.lookAt(mid, mid + d.d)
		Fx.flash("block", cf, Vector3.new(d.w * 2, 0.25, d.l), red, d.t, { Transparency = 0.55 }, 0.85)
		local start = d.p + d.d * 0.5
		Fx.flash("block", CFrame.lookAt(start, start + d.d), Vector3.new(d.w * 2, 0.3, 1), Color3.fromRGB(255, 160, 80), d.t, { Size = Vector3.new(d.w * 2, 0.3, d.l), CFrame = cf + Vector3.new(0, 0.08, 0) }, 0.45)
	end
end

local function npcDeath(d)
	if not visible(d.p) then
		return
	end
	local def = Config.Npcs[d.k]
	local c = if def then Color3.fromRGB(def.accent[1], def.accent[2], def.accent[3]) else WHITE
	local scale = if def then def.scale else 1
	Fx.burst(d.p, 2 * scale, 7 * scale, c, 0.35, 0.3)
	Fx.burst(d.p, 1 * scale, 4 * scale, WHITE, 0.2, 0.2)
	Fx.sparks(d.p, c, if d.b then 22 else 9, 34 * scale, 0.5 * scale)
	if d.b then
		Fx.ring(Vector3.new(d.p.X, Config.GroundY + 0.5, d.p.Z), 3, 50, c, 0.8, 1.2)
		Fx.shake(1.4)
		Fx.sound("boom", 0.7, 0.6)
	end
end

local function dodge(d)
	if visible(d.p) then
		Fx.burst(d.p, 1.5, 3, Color3.fromRGB(200, 240, 255), 0.18, 0.6)
	end
end

function CombatFx.shotCount(): number
	return shotCount
end

function CombatFx.init()
	local handlers = { shot = addShot, shotEnd = endShot, beam = beam, hit = hit, shock = shock, telegraph = telegraph, npcDeath = npcDeath, dodge = dodge }
	Net.event("Fx").OnClientEvent:Connect(function(kind, d)
		local h = handlers[kind]
		if h then
			h(d)
		end
		local ls = listeners[kind]
		if ls then
			for _, fn in ls do
				task.spawn(fn, d)
			end
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		if Fx.frozen() then
			return
		end
		for _, s in shots do
			if s.left > 0 then
				local step = math.min(s.speed * dt, s.left)
				s.pos += s.dir * step
				s.left -= step
				if s.left <= 0 then
					-- the server's shotEnd normally arrives first; this is the fallback
					task.delay(0.3, function()
						if shots[s.id] == s then
							removeShot(s)
						end
					end)
				end
			end
			local cf = CFrame.lookAt(s.pos, s.pos + s.dir)
			s.core.CFrame = cf
			s.glow.CFrame = cf
			s.tail.CFrame = cf * CFrame.new(0, 0, s.radius * 2.2)
		end
	end)
end

return CombatFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Controls</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Player input -> combat / training intents. Keyboard + mouse here; the touch buttons
-- (UI/TouchControls) call the same Controls.* functions. Local cooldowns mirror the server's
-- so we don't spam remotes; the server is still the authority on every action.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(script.Parent.Net)
local Fx = require(script.Parent.Fx)
local Flight = require(script.Parent.Flight)
local CharFx = require(script.Parent.CharFx)
local NpcRender = require(script.Parent.NpcRender)

local C = Config.Combat
local Controls = {}

local player = Players.LocalPlayer
local isTouch = (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) or workspace:GetAttribute("ForceTouchLayout") == true
Controls.isTouch = isTouch

-- next time each action may fire (client mirror of the server cooldowns)
local nextAt: { [string]: number } = {}
Controls.nextAt = nextAt
Controls.cooldownOf = { melee = C.meleeCooldown, blast = C.blastCooldown, beam = C.beamCooldown, dash = C.dashCooldown, form = 0.8 }
for _, t in Config.Techniques do
	Controls.cooldownOf["t_" .. t.id] = t.cooldown
end
Controls.beamStartedAt = nil :: number?
Controls.charging = false
Controls.blocking = false
Controls.enabled = true -- false while a window / cinematic owns the input
Controls.heldPunch = true
Controls.autoWalking = false

local used = Instance.new("BindableEvent")
Controls.Used = used.Event -- (action: string) for the HUD, tutorial and tests

local function ready(name: string): boolean
	local now = os.clock()
	if (nextAt[name] or 0) > now then
		return false
	end
	nextAt[name] = now + Controls.cooldownOf[name]
	return true
end

local function me(): (Model?, Humanoid?, BasePart?)
	local char = player.Character
	if not char then
		return nil, nil, nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return nil, nil, nil
	end
	return char, hum, char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Controls.ki(): number
	local char = player.Character
	return (char and char:GetAttribute("Ki")) or 0
end

---------------------------------------------------------------------------
-- Aim
---------------------------------------------------------------------------
-- Living things we may aim at: enemy roots, server dummies, other players.
local function targets(): { Vector3 }
	local list = {}
	for root in NpcRender.visuals do
		table.insert(list, root.Position)
	end
	local dummies = workspace:FindFirstChild("Dummies")
	if dummies then
		for _, m in dummies:GetChildren() do
			local r = m:FindFirstChild("HumanoidRootPart")
			if r then
				table.insert(list, r.Position)
			end
		end
	end
	local myChar = player.Character
	if myChar and myChar:GetAttribute("InArena") == true then
		for _, plr in Players:GetPlayers() do
			if plr ~= player and plr.Character and plr.Character:GetAttribute("InArena") == true then
				local r = plr.Character:FindFirstChild("HumanoidRootPart")
				if r then
					table.insert(list, r.Position)
				end
			end
		end
	end
	return list
end

-- Direction of the next shot: mouse ray (PC) or camera look (touch), snapped to the enemy
-- closest to that ray; falls back to the server's auto-fight target, then to the ray itself.
function Controls.aim(): Vector3
	local _, _, root = me()
	local cam = workspace.CurrentCamera
	if not root or not cam then
		return Vector3.new(0, 0, -1)
	end
	local origin = root.Position + Vector3.new(0, 0.6, 0)
	local rayO, rayD
	if isTouch then
		rayO, rayD = cam.CFrame.Position, cam.CFrame.LookVector
	else
		local m = UserInputService:GetMouseLocation()
		local ray = cam:ViewportPointToRay(m.X, m.Y)
		rayO, rayD = ray.Origin, ray.Direction
	end
	local best, bestScore = nil, if isTouch then 26 else 11
	for _, p in targets() do
		local t = (p - rayO):Dot(rayD)
		if t > 0 and (p - origin).Magnitude < 230 then
			local off = (p - (rayO + rayD * t)).Magnitude
			-- allow more slack far away
			local score = off - t * 0.02
			if score < bestScore then
				best, bestScore = p, score
			end
		end
	end
	local point = best
	if not point then
		local hit = workspace:Raycast(rayO, rayD * 600)
		point = if hit then hit.Position else rayO + rayD * 400
	end
	local dir = point - origin
	if dir.Magnitude < 1 then
		return root.CFrame.LookVector
	end
	dir = dir.Unit
	-- on the ground, don't shoot into the floor at your feet
	if not Flight.active and dir.Y < -0.5 then
		dir = (dir * Vector3.new(1, 0, 1) + Vector3.new(0, -0.5, 0)).Unit
	end
	return dir
end

local function faceDir(dir: Vector3)
	local _, _, root = me()
	if root and not Flight.active then
		local flat = dir * Vector3.new(1, 0, 1)
		if flat.Magnitude > 0.05 then
			root.CFrame = CFrame.lookAt(root.Position, root.Position + flat.Unit)
		end
	end
end

---------------------------------------------------------------------------
-- Actions
---------------------------------------------------------------------------
function Controls.punch()
	local _, _, root = me()
	if not root or not Controls.enabled or Controls.blocking then
		return
	end
	if not ready("melee") then
		return
	end
	-- face the nearest enemy in reach so the hit connects where the player expects
	local near = NpcRender.nearest(root.Position, C.meleeRange + 8)
	local aim: any = nil
	if near then
		local flat = (near.Position - root.Position) * Vector3.new(1, 0, 1)
		if flat.Magnitude > 0.1 then
			aim = flat.Unit
			faceDir(aim)
		end
	end
	CharFx.punchNow()
	Net.act("melee", aim)
	used:Fire("melee")
end

function Controls.blast()
	local _, _, root = me()
	if not root or not Controls.enabled or Controls.blocking then
		return
	end
	if Controls.ki() < C.blastCost then
		used:Fire("noKi")
		return
	end
	if not ready("blast") then
		return
	end
	local dir = Controls.aim()
	faceDir(dir)
	Net.act("blast", dir)
	used:Fire("blast")
end

function Controls.beamBegin()
	local _, _, root = me()
	if not root or not Controls.enabled or Controls.blocking or Controls.beamStartedAt then
		return
	end
	if (nextAt.beam or 0) > os.clock() then
		return
	end
	if Controls.ki() < C.beamCostMin then
		used:Fire("noKi")
		return
	end
	Controls.beamStartedAt = os.clock()
	Net.act("beamStart")
	used:Fire("beamStart")
end

function Controls.beamEnd()
	local started = Controls.beamStartedAt
	if not started then
		return
	end
	Controls.beamStartedAt = nil
	local _, _, root = me()
	if not root then
		Net.act("beamRelease", nil)
		return
	end
	local dir = Controls.aim()
	faceDir(dir)
	if os.clock() - started >= C.beamMinCharge then
		nextAt.beam = os.clock() + C.beamCooldown
		used:Fire("beam")
	end
	Net.act("beamRelease", dir)
end

function Controls.block(on: boolean)
	if on and not Controls.enabled then
		return
	end
	if Controls.blocking ~= on then
		Controls.blocking = on
		Net.act("block", on)
		if on then
			used:Fire("block")
		end
	end
end

function Controls.charge(on: boolean)
	if on and (not Controls.enabled or not me()) then
		return
	end
	if Controls.charging ~= on then
		Controls.charging = on
		Net.act("charge", on)
		if on then
			used:Fire("charge")
		end
	end
end

function Controls.dash()
	local _, hum, root = me()
	if not root or not hum or not Controls.enabled then
		return
	end
	if Controls.ki() < C.dashCost then
		used:Fire("noKi")
		return
	end
	if not ready("dash") then
		return
	end
	local cam = workspace.CurrentCamera
	local dir = hum.MoveDirection
	if Flight.active and cam then
		dir = if dir.Magnitude > 0.05 then cam.CFrame.LookVector else root.CFrame.LookVector
	elseif dir.Magnitude < 0.05 then
		dir = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	end
	dir = if dir.Magnitude > 0.01 then dir.Unit else Vector3.new(0, 0, -1)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character, Fx.folder }
	local dist = C.dashDistance
	local hit = workspace:Raycast(root.Position, dir * dist, params)
	if hit then
		dist = math.max(0, (hit.Position - root.Position).Magnitude - 3)
	end
	Net.act("dash")
	root.CFrame = root.CFrame + dir * dist
	root.AssemblyLinearVelocity = dir * 30
	Fx.kick(9)
	Fx.sound("swing", 0.3, 1.2)
	used:Fire("dash")
end

function Controls.toggleFly()
	if not Controls.enabled and not Flight.active then
		return
	end
	Flight.toggle()
	if Flight.active then
		used:Fire("fly")
	end
end

-- Transform into the best unlocked form, or drop back to base.
function Controls.transform(index: number?)
	local char = me()
	if not char or not Controls.enabled then
		return
	end
	local current = char:GetAttribute("Form") or 0
	local want = index
	if want == nil then
		local best = Net.get("forms") or 0
		local preferred = Controls.preferredForm
		if preferred and preferred >= 1 and preferred <= best then
			best = preferred
		end
		want = if current > 0 then 0 else best
	end
	if want == current then
		return
	end
	if want > 0 and not ready("form") then
		return
	end
	Net.act("form", want)
	used:Fire("form")
end
Controls.preferredForm = nil :: number?

function Controls.technique(id: string)
	local _, _, root = me()
	local t = Config.TechniqueById[id]
	if not root or not t or not Controls.enabled then
		return
	end
	local owned = Net.get("techniques")
	if not owned or not owned[id] then
		return
	end
	if Controls.ki() < t.kiCost then
		used:Fire("noKi")
		return
	end
	if not ready("t_" .. id) then
		return
	end
	local dir = Controls.aim()
	faceDir(dir)
	if id == "meteor_dive" then
		-- hop up, then the server slams
		root.AssemblyLinearVelocity = Vector3.new(0, 70, 0)
		task.delay(0.22, function()
			local _, _, r = me()
			if r then
				r.AssemblyLinearVelocity = Vector3.new(0, -150, 0)
			end
		end)
	end
	Net.act("tech", { id = id, dir = dir })
	used:Fire("tech")
end

function Controls.setStat(stat: string)
	local s = Net.state
	if s and s.settings and s.settings.stat ~= stat then
		s.settings.stat = stat -- optimistic
		Net.refresh()
		task.spawn(Net.request, "SetStat", { stat = stat })
	end
end

function Controls.toggleSetting(key: string)
	local s = Net.state
	if s and s.settings then
		local value = not s.settings[key]
		s.settings[key] = value
		Net.refresh()
		task.spawn(Net.request, "SetSetting", { key = key, value = value })
	end
end

---------------------------------------------------------------------------
-- Keyboard / mouse
---------------------------------------------------------------------------
local lastSpace = 0
local function overGui(pos: Vector3): boolean
	local gui = player:FindFirstChildOfClass("PlayerGui")
	if not gui then
		return false
	end
	local inset = GuiService:GetGuiInset()
	for _, o in gui:GetGuiObjectsAtPosition(pos.X, pos.Y - inset.Y) do
		if o:IsA("GuiButton") or o:GetAttribute("BlocksClicks") == true then
			return true
		end
	end
	return false
end

function Controls.init()
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if not processed and not overGui(input.Position) then
				Controls.punch()
			end
			return
		end
		if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local key = input.KeyCode
		if key == Enum.KeyCode.Q then
			Controls.blast()
		elseif key == Enum.KeyCode.R then
			Controls.beamBegin()
		elseif key == Enum.KeyCode.F then
			Controls.block(true)
		elseif key == Enum.KeyCode.E then
			Controls.dash()
		elseif key == Enum.KeyCode.C then
			Controls.charge(true)
		elseif key == Enum.KeyCode.G then
			Controls.transform()
		elseif key == Enum.KeyCode.H then
			Controls.toggleFly()
		elseif key == Enum.KeyCode.T then
			Controls.toggleSetting("autoTrain")
		elseif key == Enum.KeyCode.Space then
			local _, hum = me()
			local now = os.clock()
			if hum then
				if Flight.active then
					if now - lastSpace < 0.28 then
						Flight.stop()
					end
				elseif hum.FloorMaterial == Enum.Material.Air then
					Controls.toggleFly()
				end
			end
			lastSpace = now
		elseif key == Enum.KeyCode.Z or key == Enum.KeyCode.X or key == Enum.KeyCode.V then
			for _, t in Config.Techniques do
				if Enum.KeyCode[t.key] == key then
					Controls.technique(t.id)
				end
			end
		else
			local n = key.Value - Enum.KeyCode.One.Value + 1
			if n >= 1 and n <= #Config.Stats then
				Controls.setStat(Config.Stats[n])
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local key = input.KeyCode
		if key == Enum.KeyCode.R then
			Controls.beamEnd()
		elseif key == Enum.KeyCode.F then
			Controls.block(false)
		elseif key == Enum.KeyCode.C then
			Controls.charge(false)
		end
	end)
	-- hold left mouse to keep punching
	RunService.Heartbeat:Connect(function()
		if not isTouch and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) and not UserInputService:GetFocusedTextBox() then
			local m = UserInputService:GetMouseLocation()
			if (nextAt.melee or 0) <= os.clock() and not overGui(Vector3.new(m.X, m.Y, 0)) and Controls.heldPunch then
				Controls.punch()
			end
		end
		-- auto-fight: walk towards the target the server picked (unless the player steers)
		local char, hum, root = me()
		if char and hum and root then
			local target = char:GetAttribute("AutoTarget")
			if typeof(target) == "Vector3" and not Flight.active then
				local flat = (target - root.Position) * Vector3.new(1, 0, 1)
				if flat.Magnitude > C.meleeRange - 3.5 then
					hum:MoveTo(root.Position + flat.Unit * math.min(flat.Magnitude, 12))
				end
				Controls.autoWalking = true
			elseif Controls.autoWalking then
				Controls.autoWalking = false
				hum:MoveTo(root.Position)
			end
		end
	end)
	-- reset held states on respawn
	player.CharacterAdded:Connect(function()
		Controls.charging = false
		Controls.blocking = false
		Controls.beamStartedAt = nil
	end)
end

return Controls
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Flight</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Flight (client-side movement; the server only knows the Flying flag for other players'
-- poses). Camera-relative in 3D: move where you look, Space / jump = up, Ctrl = down,
-- Shift = boost. Speed comes from the server (FlySpeed attribute, from Agility).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Net = require(script.Parent.Net)
local Fx = require(script.Parent.Fx)

local Flight = {}

local player = Players.LocalPlayer
Flight.active = false
Flight.boost = false -- touch toggle
Flight.descend = false -- touch hold
Flight.ascend = false -- touch hold
Flight.testMove = nil :: Vector3? -- playtest: world-space direction override

local controls = nil
task.spawn(function()
	local ok, module = pcall(function()
		return (require :: any)(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 10))
	end)
	if ok and module then
		controls = module:GetControls()
	end
end)

local att: any = nil
local lv: any = nil
local ao: any = nil
local vel = Vector3.zero
local changed = Instance.new("BindableEvent")
Flight.Changed = changed.Event

local function parts(): (Model?, Humanoid?, BasePart?)
	local char = player.Character
	if not char then
		return nil, nil, nil
	end
	return char, char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Flight.stop()
	if not Flight.active then
		return
	end
	Flight.active = false
	Fx.fovBoost = 0
	local _, hum = parts()
	if lv then
		lv:Destroy()
		lv = nil
	end
	if ao then
		ao:Destroy()
		ao = nil
	end
	if att then
		att:Destroy()
		att = nil
	end
	if hum and hum.Health > 0 then
		hum.PlatformStand = false
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
	end
	Net.act("fly", false)
	changed:Fire(false)
end

function Flight.start()
	if Flight.active then
		return
	end
	local char, hum, root = parts()
	if not char or not hum or not root or hum.Health <= 0 then
		return
	end
	if char:GetAttribute("Charging") == true then
		return
	end
	Flight.active = true
	hum.PlatformStand = true
	att = Instance.new("Attachment")
	att.Name = "KiwFlight"
	att.Parent = root
	lv = Instance.new("LinearVelocity")
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.MaxForce = 1e7
	lv.VectorVelocity = Vector3.new(0, 14, 0)
	lv.Parent = root
	ao = Instance.new("AlignOrientation")
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.MaxTorque = 1e7
	ao.Responsiveness = 28
	ao.CFrame = root.CFrame
	ao.Parent = root
	vel = Vector3.new(0, 14, 0)
	Net.act("fly", true)
	Fx.ring(root.Position - Vector3.new(0, 2.6, 0), 2, 12, Color3.fromRGB(220, 240, 255), 0.35, 0.4)
	changed:Fire(true)
end

function Flight.toggle()
	if Flight.active then
		Flight.stop()
	else
		Flight.start()
	end
end

function Flight.init()
	player.CharacterAdded:Connect(function()
		Flight.active = false
		lv, ao, att = nil, nil, nil
		Fx.fovBoost = 0
		changed:Fire(false)
	end)
	RunService.RenderStepped:Connect(function(dt)
		if not Flight.active then
			return
		end
		local char, hum, root = parts()
		local cam = workspace.CurrentCamera
		if not char or not hum or not root or not cam or hum.Health <= 0 or not lv or not ao then
			Flight.stop()
			return
		end
		if char:GetAttribute("Charging") == true or char:GetAttribute("Beam") == true then
			-- hold still in the air while charging
			vel = vel:Lerp(Vector3.zero, math.min(1, dt * 10))
			lv.VectorVelocity = vel
			return
		end
		local dir = Vector3.zero
		if Flight.testMove then
			dir = Flight.testMove
		elseif controls then
			local mv = controls:GetMoveVector()
			if mv.Magnitude > 0.05 then
				dir = cam.CFrame:VectorToWorldSpace(Vector3.new(mv.X, 0, mv.Z))
			end
		end
		local up = 0
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) or hum.Jump or Flight.ascend then
			up += 1
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or Flight.descend then
			up -= 1
		end
		dir += Vector3.new(0, up, 0)
		local boost = Flight.boost or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
		local speed = (char:GetAttribute("FlySpeed") or 72) * (if boost then 1.7 else 1)
		local want = if dir.Magnitude > 0.05 then dir.Unit * speed * math.min(1, dir.Magnitude) else Vector3.zero
		vel = vel:Lerp(want, math.min(1, dt * 5))
		lv.VectorVelocity = vel
		local flat = Vector3.new(vel.X, 0, vel.Z)
		if flat.Magnitude > 6 then
			local lean = math.clamp(flat.Magnitude / speed, 0, 1) * math.rad(68)
			ao.CFrame = CFrame.lookAt(Vector3.zero, flat.Unit) * CFrame.Angles(-lean, 0, 0)
		else
			local look = cam.CFrame.LookVector * Vector3.new(1, 0, 1)
			if look.Magnitude > 0.05 then
				ao.CFrame = CFrame.lookAt(Vector3.zero, look.Unit)
			end
		end
		Fx.fovBoost = if boost and vel.Magnitude > speed * 0.5 then 12 else math.clamp(vel.Magnitude / 40, 0, 5)
		-- land when pushing down into the ground
		if up < 0 then
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { char, Fx.folder }
			if workspace:Raycast(root.Position, Vector3.new(0, -4.2, 0), params) then
				Flight.stop()
			end
		end
	end)
end

return Flight
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Client effect toolkit: part pool, quality profile (lite for phones), camera shake / FOV
-- kicks, hit-stop clock and the colours of each form. Everything visual runs on the client.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(script.Parent.Net)

local Fx = {}

local player = Players.LocalPlayer

-- Lite profile: phones/tablets by default, or the player's setting. Fewer particles, no
-- dynamic lights, shorter draw distances for effects.
local touchDevice = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
Fx.lite = touchDevice or workspace:GetAttribute("ForceLite") == true
function Fx.refreshQuality()
	local setting = Net.setting("lite")
	Fx.lite = touchDevice or setting == true or workspace:GetAttribute("ForceLite") == true
end
Net.Changed:Connect(function(kind)
	if kind == "full" then
		Fx.refreshQuality()
	end
end)

Fx.folder = Instance.new("Folder")
Fx.folder.Name = "KiwFx"
Fx.folder.Parent = workspace

---------------------------------------------------------------------------
-- Colours
---------------------------------------------------------------------------
local BASE = Color3.fromRGB(110, 210, 255) -- untransformed ki
local BASE2 = Color3.fromRGB(235, 250, 255)
function Fx.formColors(form: number?): (Color3, Color3, string)
	local f = Config.Forms[form or 0]
	if f then
		return Color3.fromRGB(f.color[1], f.color[2], f.color[3]), Color3.fromRGB(f.color2[1], f.color2[2], f.color2[3]), f.style
	end
	return BASE, BASE2, "flame"
end

function Fx.auraColor(auraId: string?): Color3?
	local a = auraId and Config.AuraById[auraId]
	if a then
		return Color3.fromRGB(a.color[1], a.color[2], a.color[3])
	end
	return nil
end

---------------------------------------------------------------------------
-- Pool
---------------------------------------------------------------------------
local pools: { [string]: { BasePart } } = {}
Fx.alive = 0 -- pooled parts currently in use (budget check)
Fx.created = 0

local function make(kind: string): BasePart
	local p: BasePart
	if kind == "ball" then
		local b = Instance.new("Part")
		b.Shape = Enum.PartType.Ball
		p = b
	elseif kind == "cyl" then
		local b = Instance.new("Part")
		b.Shape = Enum.PartType.Cylinder
		p = b
	elseif kind == "blob" then
		p = Instance.new("Part")
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	else
		p = Instance.new("Part")
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Name = "fx_" .. kind
	Fx.created += 1
	return p
end

-- kinds: "ball" | "cyl" | "block" | "blob"
function Fx.get(kind: string): BasePart
	local pool = pools[kind]
	local p = pool and table.remove(pool)
	if not p then
		p = make(kind)
	end
	p.Transparency = 0
	p.Material = Enum.Material.Neon
	p.Parent = Fx.folder
	Fx.alive += 1
	return p
end

function Fx.release(p: BasePart)
	if not p or p.Parent == nil then
		return
	end
	p.Parent = nil
	local kind = p.Name:sub(4)
	local pool = pools[kind]
	if not pool then
		pool = {}
		pools[kind] = pool
	end
	Fx.alive -= 1
	if #pool < 80 then
		table.insert(pool, p)
	else
		p:Destroy()
	end
end

function Fx.tween(obj: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local t = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

-- Pooled part that animates to `props` and returns to the pool.
function Fx.flash(kind: string, cf: CFrame, size: Vector3, color: Color3, time: number, props: { [string]: any }, trans: number?): BasePart
	local p = Fx.get(kind)
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Transparency = trans or 0
	Fx.tween(p, time, props)
	task.delay(time, Fx.release, p)
	return p
end

-- Expanding ring on the ground (flat cylinder).
function Fx.ring(pos: Vector3, fromR: number, toR: number, color: Color3, time: number, thickness: number?)
	local h = thickness or 0.4
	Fx.flash("cyl", CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), Vector3.new(h, fromR * 2, fromR * 2), color, time, { Size = Vector3.new(h * 0.5, toR * 2, toR * 2), Transparency = 1 }, 0.25)
end

-- Expanding sphere shell.
function Fx.burst(pos: Vector3, fromR: number, toR: number, color: Color3, time: number, trans: number?)
	Fx.flash("ball", CFrame.new(pos), Vector3.one * fromR * 2, color, time, { Size = Vector3.one * toR * 2, Transparency = 1 }, trans or 0.3)
end

-- Shards flying out of a point (geometry sparks: visible at any graphics quality).
function Fx.sparks(pos: Vector3, color: Color3, count: number, speed: number, size: number?)
	local n = if Fx.lite then math.ceil(count / 2) else count
	local s = size or 0.5
	for _ = 1, n do
		local dir = Vector3.new(math.random() - 0.5, math.random() * 0.8, math.random() - 0.5)
		if dir.Magnitude < 0.05 then
			dir = Vector3.yAxis
		end
		dir = dir.Unit
		local len = s * (2 + math.random() * 3)
		local from = pos + dir * 0.6
		local to = pos + dir * speed * (0.18 + math.random() * 0.2)
		Fx.flash("block", CFrame.lookAt(from, to), Vector3.new(s * 0.45, s * 0.45, len), color, 0.22 + math.random() * 0.12, { CFrame = CFrame.lookAt(to, to + dir), Size = Vector3.new(0.05, 0.05, len * 0.3), Transparency = 0.6 })
	end
end

---------------------------------------------------------------------------
-- Camera: shake + FOV kick (one RenderStepped for both)
---------------------------------------------------------------------------
local shake = 0
local fovKick = 0
local baseFov = 70
function Fx.shake(amount: number)
	if Net.setting("shake") == false then
		return
	end
	shake = math.min(1.6, math.max(shake, amount))
end
function Fx.kick(amount: number)
	fovKick = math.max(fovKick, amount)
end
Fx.fovBoost = 0 -- sustained (flight boost), set by Flight

-- Hit-stop: a very short freeze of local animation (poses / enemy models / shots) that sells
-- the impact. Other modules read Fx.frozen().
local frozenUntil = 0
function Fx.hitStop(seconds: number)
	frozenUntil = math.max(frozenUntil, os.clock() + seconds)
end
function Fx.frozen(): boolean
	return os.clock() < frozenUntil
end

RunService:BindToRenderStep("KiwCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		if shake > 0.01 then
			local s = shake * 0.7
			hum.CameraOffset = Vector3.new((math.random() - 0.5) * s, (math.random() - 0.5) * s, (math.random() - 0.5) * s * 0.5)
			shake = math.max(0, shake - dt * 3.2)
		elseif hum.CameraOffset.Magnitude > 0 then
			hum.CameraOffset = Vector3.zero
			shake = 0
		end
	end
	fovKick = math.max(0, fovKick - dt * 40)
	local want = baseFov + fovKick + Fx.fovBoost
	if cam.CameraType ~= Enum.CameraType.Scriptable and math.abs(cam.FieldOfView - want) > 0.05 then
		cam.FieldOfView += (want - cam.FieldOfView) * math.min(1, dt * 10)
	end
end)

---------------------------------------------------------------------------
-- Sounds (built-in rbxasset sounds only)
---------------------------------------------------------------------------
local SoundService = game:GetService("SoundService")
local SOUND_IDS = {
	punch = "rbxasset://sounds/impact_explosion_03.mp3",
	swing = "rbxasset://sounds/action_jump.mp3",
	blast = "rbxasset://sounds/action_get_up.mp3",
	boom = "rbxasset://sounds/impact_explosion_03.mp3",
	click = "rbxasset://sounds/volume_slider.ogg",
	land = "rbxasset://sounds/action_jump_land.mp3",
	splash = "rbxasset://sounds/impact_water.mp3",
}
local sounds: { [string]: Sound } = {}
function Fx.sound(name: string, volume: number?, pitch: number?)
	if Net.setting("sfx") == false then
		return
	end
	local id = SOUND_IDS[name]
	if not id then
		return
	end
	local snd = sounds[name]
	if not snd then
		snd = Instance.new("Sound")
		snd.SoundId = id
		snd.Parent = SoundService
		sounds[name] = snd
	end
	snd.Volume = volume or 0.4
	snd.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(snd)
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Lang</string>
            <string name="Source"><![CDATA[--!strict
-- Client language: the saved preference (profile.lang) or the account locale. Static labels
-- register with Lang.bind and re-render live when the language changes; dynamic texts are
-- rebuilt by their windows' refresh functions (Net.Changed "full" fires on a switch).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)
local Net = require(script.Parent.Net)

local Lang = {}

-- Studio preview: the workspace attribute ForceLanguage (e.g. "de") overrides everything.
local forced = workspace:GetAttribute("ForceLanguage")
local forcedCode: string? = if type(forced) == "string" and Locale.Supported[forced] then forced else nil

Lang.code = forcedCode or Locale.resolve(Players.LocalPlayer.LocaleId)
local changed = Instance.new("BindableEvent")
Lang.Changed = changed.Event

type Binding = { prop: string, key: string, args: { [string]: any }? }
-- Strong keys on purpose: Instance proxies in weak tables can be collected while the
-- Instance is still alive. Entries are dropped when the object is destroyed.
local bound: { [Instance]: Binding } = {}

function Lang.t(key: string, args: { [string]: any }?): string
	return Locale.t(Lang.code, key, args)
end

-- Server messages ({ key, args }) or plain strings.
function Lang.msg(m: any): string
	return Locale.msg(Lang.code, m)
end

-- Sets obj[prop] (default "Text") to the translation and keeps it updated.
function Lang.bind(obj: Instance, key: string, args: { [string]: any }?, prop: string?)
	local b: Binding = { prop = prop or "Text", key = key, args = args }
	if not bound[obj] then
		obj.Destroying:Once(function()
			bound[obj] = nil
		end)
	end
	bound[obj] = b;
	(obj :: any)[b.prop] = Lang.t(key, args)
end

function Lang.unbind(obj: Instance)
	bound[obj] = nil
end

-- Upper-cases only plain ASCII (string.upper would mangle UTF-8 letters).
function Lang.upper(s: string): string
	return if s:find("[\128-\255]") then s else s:upper()
end

-- "5 min of Sparks", "25 Gems"... for Config reward entries.
function Lang.rewardLabel(reward: { kind: string, amount: number }): string
	return Lang.t("rewardlabel." .. reward.kind, { n = reward.amount })
end

function Lang.set(code: string)
	if not Locale.Supported[code] then
		code = Locale.Default
	end
	if code == Lang.code then
		return
	end
	Lang.code = code
	for obj, b in bound do
		if obj.Parent then
			(obj :: any)[b.prop] = Lang.t(b.key, b.args)
		end
	end
	changed:Fire(code)
	Net.refresh()
end

-- Follow the saved preference when the server state arrives or changes.
Net.Changed:Connect(function(kind)
	if kind ~= "full" then
		return
	end
	local pref = Net.get("lang")
	local want = forcedCode or (if type(pref) == "string" and Locale.Supported[pref] then pref else Locale.resolve(Players.LocalPlayer.LocaleId))
	if want ~= Lang.code then
		Lang.set(want)
	end
end)

return Lang
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="38">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Ki Warriors: client bootstrap.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

ReplicatedStorage:WaitForChild("Remotes")

local Net = require(script.Parent.Net)
local Purchase = require(script.Parent.Purchase)
local Fx = require(script.Parent.Fx)
local CombatFx = require(script.Parent.CombatFx)
local CharFx = require(script.Parent.CharFx)
local NpcRender = require(script.Parent.NpcRender)
local Flight = require(script.Parent.Flight)
local Controls = require(script.Parent.Controls)
local WorldFx = require(script.Parent.WorldFx)
local UI = script.Parent.UI
local Toasts = require(UI.Toasts)
local Hud = require(UI.Hud)
local TouchControls = require(UI.TouchControls)

Purchase.setNotifier(Toasts.show)
Hud.notify = Toasts.show
Hud.banner = Toasts.banner

CombatFx.init()
CharFx.init()
NpcRender.init()
Flight.init()
Controls.init()
WorldFx.init()
Toasts.init()
Hud.init()
TouchControls.init()

-- Optional UI / feature modules (added round by round); each exposes init().
for _, name in { "Menu", "Tutorial", "QuestTracker", "RelicsClient", "ArenaClient", "Popups" } do
	local module = script.Parent:FindFirstChild(name) or UI:FindFirstChild(name)
	if module then
		local m = (require :: any)(module)
		m.init()
	end
end

-- Knockback from the server (our character is simulated on this client).
Net.event("Knock").OnClientEvent:Connect(function(vel: Vector3)
	local char = Players.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and typeof(vel) == "Vector3" and vel.Magnitude < 400 then
		root.AssemblyLinearVelocity = vel
		Fx.shake(0.6)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--!strict
-- Client networking: remotes, the replicated profile snapshot, and change signals.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Request = Remotes:WaitForChild("Request") :: RemoteFunction

local Net = {}

Net.state = nil :: { [string]: any }?
Net.receivedAt = os.clock()

local changed = Instance.new("BindableEvent")
Net.Changed = changed.Event -- (kind: "full" | "currency")

function Net.event(name: string): RemoteEvent
	return Remotes:WaitForChild(name) :: RemoteEvent
end

-- Returns ok, result (result is an error string when ok == false).
function Net.request(action: string, payload: { [string]: any }?): (boolean, any)
	local ok, a, b = pcall(function()
		return Request:InvokeServer(action, payload)
	end)
	if not ok then
		return false, { key = "toast.connection" }
	end
	return a == true, b
end

-- Fire-and-forget combat / training input.
local Act = Remotes:WaitForChild("Act") :: RemoteEvent
function Net.act(kind: string, arg: any?)
	Act:FireServer(kind, arg)
end

function Net.setting(key: string): any
	local s = Net.state
	return if s and s.settings then s.settings[key] else nil
end

-- Re-run every "full" listener (e.g. after a language switch).
function Net.refresh()
	if Net.state then
		changed:Fire("full")
	end
end

function Net.get(key: string): any
	local s = Net.state
	return if s then s[key] else nil
end

function Net.owns(passKey: string): boolean
	local passes = Net.get("passes")
	return passes ~= nil and passes[passKey] == true
end

Net.event("State").OnClientEvent:Connect(function(snapshot)
	Net.state = snapshot
	Net.receivedAt = os.clock()
	changed:Fire("full")
end)

Net.event("Numbers").OnClientEvent:Connect(function(c)
	local s = Net.state
	if s then
		for k, v in c do
			s[k] = v
		end
		changed:Fire("currency")
	end
end)

-- Initial pull (the push may have happened before this script connected).
task.spawn(function()
	for _ = 1, 40 do
		if Net.state then
			return
		end
		local ok, snap = Net.request("GetState")
		if ok and snap and not Net.state then
			Net.state = snap
			Net.receivedAt = os.clock()
			changed:Fire("full")
			return
		end
		task.wait(0.5)
	end
end)

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">NpcRender</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Client-side enemy models. The server only replicates one invisible root part per enemy
-- (workspace.Enemies); this module builds a procedural model for it (5 archetypes, coloured
-- from Config), smooths its movement and animates walk / windup / flinch. One loop for all.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Fx = require(script.Parent.Fx)
local CombatFx = require(script.Parent.CombatFx)
local Lang = require(script.Parent.Lang)

local NpcRender = {}

local WHITE = Color3.new(1, 1, 1)
local DARK = Color3.fromRGB(24, 18, 34)

type Visual = { [string]: any }
local visuals: { [BasePart]: Visual } = {}
local byFighter: { [number]: Visual } = {}
NpcRender.visuals = visuals

local holder = Instance.new("Folder")
holder.Name = "KiwEnemies"
holder.Parent = workspace

---------------------------------------------------------------------------
-- Model builder
---------------------------------------------------------------------------
local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function build(def): (Model, BasePart, { [string]: Weld }, { BasePart }, { BasePart })
	local s = def.scale or 1
	local c, acc = rgb(def.color), rgb(def.accent)
	local dark = c:Lerp(Color3.new(0, 0, 0), 0.35)
	local model = Instance.new("Model")
	model.Name = def.id
	local pivot = Instance.new("Part")
	pivot.Name = "Pivot"
	pivot.Anchored = true
	pivot.CanCollide = false
	pivot.CanQuery = false
	pivot.CanTouch = false
	pivot.Transparency = 1
	pivot.Size = Vector3.new(1, 1, 1)
	pivot.Parent = model
	model.PrimaryPart = pivot
	local limbs: { [string]: Weld } = {}
	local spin: { BasePart } = {}
	local glow: { BasePart } = {}

	local function part(shape: string, size: Vector3, color: Color3, offset: CFrame, neon: boolean?, to: BasePart?, limb: string?): BasePart
		local p: BasePart
		if shape == "ball" then
			local b = Instance.new("Part")
			b.Shape = Enum.PartType.Ball
			p = b
		elseif shape == "blob" then
			p = Instance.new("Part")
			local m = Instance.new("SpecialMesh")
			m.MeshType = Enum.MeshType.Sphere
			m.Parent = p
		elseif shape == "wedge" then
			p = Instance.new("WedgePart")
		elseif shape == "cyl" then
			local b = Instance.new("Part")
			b.Shape = Enum.PartType.Cylinder
			p = b
		else
			p = Instance.new("Part")
		end
		p.Size = size * s
		p.Color = color
		p.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Massless = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		local w = Instance.new("Weld")
		w.Part0 = to or pivot
		w.Part1 = p
		w.C0 = CFrame.new(offset.Position * s) * (offset - offset.Position)
		w.Parent = p
		p.Parent = model
		if limb then
			limbs[limb] = w
		end
		if neon then
			table.insert(glow, p)
		end
		return p
	end
	local function eyes(y: number, z: number, spread: number, size: number, angry: boolean?)
		for _, side in { -1, 1 } do
			part("ball", Vector3.one * size, WHITE, CFrame.new(side * spread, y, z))
			part("ball", Vector3.one * size * 0.5, DARK, CFrame.new(side * spread, y, z - size * 0.32))
			if angry then
				part("block", Vector3.new(size * 1.3, size * 0.28, 0.2), DARK, CFrame.new(side * spread, y + size * 0.55, z - size * 0.2) * CFrame.Angles(0, 0, math.rad(side * 22)))
			end
		end
	end

	local arch = def.arch
	if arch == "imp" then
		part("blob", Vector3.new(3, 3, 2.6), c, CFrame.new(0, -1.3, 0))
		part("blob", Vector3.new(2, 1.6, 0.4), c:Lerp(WHITE, 0.35), CFrame.new(0, -1.4, -1.15))
		part("ball", Vector3.one * 2.7, c, CFrame.new(0, 0.9, 0))
		eyes(1.0, -1.15, 0.55, 0.7, true)
		part("block", Vector3.new(0.9, 0.22, 0.2), DARK, CFrame.new(0, 0.25, -1.28))
		for _, side in { -1, 1 } do
			part("wedge", Vector3.new(0.4, 1.4, 0.7), acc, CFrame.new(side * 0.85, 2.3, 0) * CFrame.Angles(0, math.rad(side * 90), math.rad(-side * 12)), true)
			part("blob", Vector3.new(0.9, 1.8, 0.9), dark, CFrame.new(side * 1.75, -1.1, 0), false, nil, if side == 1 then "armR" else "armL")
			part("blob", Vector3.new(1.1, 1.0, 1.4), dark, CFrame.new(side * 0.75, -2.7, -0.1), false, nil, if side == 1 then "legR" else "legL")
		end
		part("block", Vector3.new(0.35, 0.35, 1.6), acc, CFrame.new(0, -1.6, 1.7) * CFrame.Angles(math.rad(30), 0, 0), true)
	elseif arch == "brute" then
		part("block", Vector3.new(3.6, 3.2, 2.1), c, CFrame.new(0, -0.2, 0))
		part("block", Vector3.new(2.6, 1.2, 1.9), dark, CFrame.new(0, -2.0, 0))
		part("block", Vector3.new(3.7, 0.5, 2.2), acc, CFrame.new(0, -1.3, 0))
		part("block", Vector3.new(1.8, 1.7, 1.7), c:Lerp(WHITE, 0.12), CFrame.new(0, 2.2, 0))
		eyes(2.35, -0.85, 0.42, 0.42, true)
		part("block", Vector3.new(1.1, 0.24, 0.2), DARK, CFrame.new(0, 1.75, -0.88))
		part("block", Vector3.new(1.9, 0.5, 1.8), acc, CFrame.new(0, 3.2, 0))
		for _, side in { -1, 1 } do
			part("block", Vector3.new(1.7, 1.2, 2.3), acc, CFrame.new(side * 2.5, 1.2, 0))
			local arm = part("block", Vector3.new(1.4, 3.4, 1.4), c, CFrame.new(side * 2.6, -0.6, 0), false, nil, if side == 1 then "armR" else "armL")
			part("block", Vector3.new(1.8, 1.4, 1.8), dark, CFrame.new(0, -1.9, 0), false, arm)
			part("block", Vector3.new(1.3, 1.9, 1.4), dark, CFrame.new(side * 0.85, -2.95, 0), false, nil, if side == 1 then "legR" else "legL")
		end
	elseif arch == "wisp" then
		local core = part("ball", Vector3.one * 2.2, acc, CFrame.new(0, 0, 0), true)
		local shell = part("ball", Vector3.one * 3.6, c, CFrame.new(0, 0, 0))
		shell.Transparency = 0.45
		shell.Material = Enum.Material.Glass
		part("ball", Vector3.one * 1.0, WHITE, CFrame.new(0, 0.1, -1.55))
		part("ball", Vector3.one * 0.5, DARK, CFrame.new(0, 0.1, -1.95))
		for i = 1, 4 do
			local a = i / 4 * math.pi * 2
			local sh = part("block", Vector3.new(0.6, 2.2, 0.6), if i % 2 == 0 then acc else c, CFrame.new(math.cos(a) * 3, 0, math.sin(a) * 3) * CFrame.Angles(0.5, a, 0.4), true)
			table.insert(spin, sh)
		end
		part("wedge", Vector3.new(0.6, 2.2, 1.2), c, CFrame.new(0, -2.4, 0.3) * CFrame.Angles(math.rad(180), 0, 0))
		local _ = core
	elseif arch == "knight" then
		part("block", Vector3.new(2.8, 3, 1.7), c, CFrame.new(0, -0.1, 0))
		part("block", Vector3.new(1.5, 1.7, 0.3), acc, CFrame.new(0, 0.1, -0.9), true)
		part("block", Vector3.new(2.2, 1.0, 1.6), dark, CFrame.new(0, -1.9, 0))
		part("block", Vector3.new(1.7, 1.8, 1.7), c:Lerp(WHITE, 0.2), CFrame.new(0, 2.25, 0))
		part("block", Vector3.new(1.3, 0.34, 0.3), acc, CFrame.new(0, 2.35, -0.78), true)
		part("wedge", Vector3.new(0.4, 1.7, 1.6), acc, CFrame.new(0, 3.7, 0.1), true)
		part("block", Vector3.new(2.7, 3.6, 0.25), acc:Lerp(DARK, 0.45), CFrame.new(0, -0.6, 1.0) * CFrame.Angles(math.rad(-8), 0, 0))
		for _, side in { -1, 1 } do
			part("wedge", Vector3.new(1.4, 1.1, 2), c:Lerp(WHITE, 0.2), CFrame.new(side * 2.0, 1.6, 0) * CFrame.Angles(0, math.rad(side * 90), 0))
			local arm = part("block", Vector3.new(1.1, 3, 1.1), dark, CFrame.new(side * 2.0, -0.4, 0), false, nil, if side == 1 then "armR" else "armL")
			if side == 1 then
				part("block", Vector3.new(0.4, 0.5, 5), acc, CFrame.new(0, -1.5, -2.2), true, arm)
				part("block", Vector3.new(1.4, 0.5, 0.4), dark, CFrame.new(0, -1.5, -0.2), false, arm)
			else
				part("block", Vector3.new(0.4, 2.8, 2.4), c:Lerp(WHITE, 0.2), CFrame.new(-0.7, -0.9, -0.4), false, arm)
				part("block", Vector3.new(0.45, 1, 1), acc, CFrame.new(-0.75, -0.9, -0.4), true, arm)
			end
			part("block", Vector3.new(1.15, 2.1, 1.2), dark, CFrame.new(side * 0.7, -3.0, 0), false, nil, if side == 1 then "legR" else "legL")
		end
	else -- titan
		part("block", Vector3.new(4.2, 3.2, 2.4), c, CFrame.new(0, 0.1, 0))
		part("block", Vector3.new(3, 1.4, 2), dark, CFrame.new(0, -1.9, 0))
		local heart = part("ball", Vector3.one * 1.6, acc, CFrame.new(0, 0.3, -1.05), true)
		local _ = heart
		part("block", Vector3.new(1.9, 1.7, 1.8), c:Lerp(WHITE, 0.1), CFrame.new(0, 2.5, -0.1))
		eyes(2.7, -0.98, 0.45, 0.4, true)
		for i = -2, 2 do
			part("wedge", Vector3.new(0.4, 1.2 + (2 - math.abs(i)) * 0.5, 0.7), acc, CFrame.new(i * 0.42, 3.8 + (2 - math.abs(i)) * 0.22, 0) * CFrame.Angles(0, 0, math.rad(-i * 10)), true)
		end
		for _, side in { -1, 1 } do
			part("block", Vector3.new(2, 1.5, 2.8), acc:Lerp(dark, 0.3), CFrame.new(side * 3.0, 1.5, 0))
			part("wedge", Vector3.new(0.5, 1.6, 1.2), acc, CFrame.new(side * 3.2, 2.9, 0) * CFrame.Angles(0, 0, math.rad(-side * 24)), true)
			local arm = part("block", Vector3.new(1.8, 3.6, 1.8), c, CFrame.new(side * 3.1, -0.6, 0), false, nil, if side == 1 then "armR" else "armL")
			part("block", Vector3.new(2.3, 1.8, 2.3), dark, CFrame.new(0, -2.2, 0), false, arm)
			part("block", Vector3.new(2.35, 0.4, 2.35), acc, CFrame.new(0, -1.5, 0), true, arm)
			part("block", Vector3.new(1.5, 1.7, 1.6), dark, CFrame.new(side * 1.0, -3.0, 0), false, nil, if side == 1 then "legR" else "legL")
		end
		part("block", Vector3.new(3.4, 3.6, 0.3), acc:Lerp(DARK, 0.5), CFrame.new(0, -0.7, 1.35) * CFrame.Angles(math.rad(-10), 0, 0))
	end
	return model, pivot, limbs, spin, glow
end
NpcRender.build = build

---------------------------------------------------------------------------
-- Tracking
---------------------------------------------------------------------------
local function healthBar(v: Visual)
	local def = v.def
	local s = def.scale or 1
	local bb = Instance.new("BillboardGui")
	bb.Name = "Hp"
	bb.Size = if def.boss then UDim2.fromOffset(230, 46) else UDim2.fromOffset(150, 36)
	bb.StudsOffset = Vector3.new(0, 4.6 * s + 1.4, 0)
	bb.MaxDistance = if def.boss then 260 else 110
	bb.LightInfluence = 0
	bb.Adornee = v.pivot
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.fromScale(1, 0.55)
	name.Font = Enum.Font.GothamBlack
	name.TextScaled = true
	name.TextColor3 = if def.boss then Color3.fromRGB(255, 210, 90) else WHITE
	name.Text = Lang.t("npc." .. def.id)
	local st = Instance.new("UIStroke")
	st.Thickness = 2.5
	st.Color = DARK
	st.Parent = name
	name.Parent = bb
	local back = Instance.new("Frame")
	back.BackgroundColor3 = DARK
	back.BorderSizePixel = 0
	back.Size = UDim2.fromScale(1, 0.36)
	back.Position = UDim2.fromScale(0, 0.6)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = back
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = DARK
	stroke.Parent = back
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BackgroundColor3 = if def.boss then Color3.fromRGB(255, 80, 90) else Color3.fromRGB(110, 230, 110)
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(1, 1)
	corner:Clone().Parent = fill
	fill.Parent = back
	local txt = Instance.new("TextLabel")
	txt.BackgroundTransparency = 1
	txt.Size = UDim2.fromScale(1, 1)
	txt.Font = Enum.Font.GothamBold
	txt.TextScaled = true
	txt.TextColor3 = WHITE
	txt.ZIndex = 2
	local st2 = st:Clone()
	st2.Thickness = 1.5
	st2.Parent = txt
	txt.Parent = back
	back.Parent = bb
	bb.Parent = v.pivot
	v.gui = bb
	v.bar = fill
	v.barText = txt
end

local function add(root: BasePart)
	if visuals[root] then
		return
	end
	local def = Config.Npcs[(root:GetAttribute("Kind") or root.Name) :: any]
	if not def then
		return
	end
	local model, pivot, limbs, spin, glow = build(def)
	local rest = {}
	for name, w in limbs do
		rest[name] = w.C0
	end
	local v: Visual = {
		root = root,
		def = def,
		model = model,
		pivot = pivot,
		limbs = limbs,
		rest = rest,
		spin = spin,
		cf = root.CFrame,
		lastPos = root.Position,
		walk = math.random() * 6,
		speed = 0,
		flinchAt = -10,
		shownHp = -1,
		glow = glow,
	}
	pivot.CFrame = root.CFrame
	healthBar(v)
	model.Parent = holder
	visuals[root] = v
	local id = root:GetAttribute("FighterId")
	if id then
		byFighter[id] = v
	end
	-- spawn pop
	Fx.burst(root.Position, 1, 5 * (def.scale or 1), rgb(def.accent), 0.3, 0.5)
end

local function remove(root: BasePart)
	local v = visuals[root]
	if v then
		visuals[root] = nil
		for id, vv in byFighter do
			if vv == v then
				byFighter[id] = nil
			end
		end
		v.model:Destroy()
	end
end

local function step(v: Visual, dt: number, now: number, camPos: Vector3)
	local root = v.root
	local def = v.def
	local s = def.scale or 1
	local target = root.CFrame
	-- smooth the 10 Hz server movement
	local alpha = 1 - math.exp(-dt * 13)
	v.cf = v.cf:Lerp(target, alpha)
	local pos = v.cf.Position
	local moved = (pos - v.lastPos).Magnitude / math.max(dt, 1e-3)
	v.lastPos = pos
	v.speed += (moved - v.speed) * math.min(1, dt * 8)
	local far = (camPos - pos).Magnitude > (if Fx.lite then 130 else 220)
	local state = root:GetAttribute("State")
	local cf = v.cf
	local moving = v.speed > 2
	if moving then
		v.walk += dt * (6 + v.speed * 0.35)
	end
	if not far then
		-- body motion
		local bob = if def.arch == "wisp" then math.sin(now * 2.2 + v.walk) * 0.7 * s else (if moving then math.abs(math.sin(v.walk)) * 0.35 * s else math.sin(now * 2 + v.walk) * 0.08 * s)
		local lean = 0
		if state == "windup" then
			-- rear back, then the server resolves the hit
			lean = 0.32
			local k = math.sin(now * 40) * 0.05
			cf *= CFrame.new(k, 0, 0.6 * s)
		elseif state == "recover" then
			lean = -0.42
			cf *= CFrame.new(0, 0, -1.4 * s)
		elseif state == "charging" then
			lean = -0.5
		end
		local ft = now - v.flinchAt
		if ft < 0.16 then
			local k = 1 - ft / 0.16
			cf *= CFrame.new(0, 0, 0.9 * k * s) * CFrame.Angles(0.3 * k, 0, 0)
		end
		cf = cf * CFrame.new(0, bob, 0) * CFrame.Angles(lean, 0, 0)
		local swing = if moving then math.sin(v.walk) * 0.7 else 0
		local attackArm = if state == "windup" then -2.2 elseif state == "recover" then 1.1 else 0
		for name, w in v.limbs do
			local rest = v.rest[name]
			local a = 0
			if name == "legR" then
				a = swing
			elseif name == "legL" then
				a = -swing
			elseif name == "armR" then
				a = -swing * 0.8 + attackArm
			elseif name == "armL" then
				a = swing * 0.8 + (if def.boss then attackArm else 0)
			end
			-- rotate around the top of the limb
			local half = (w.Part1 :: BasePart).Size.Y / 2
			w.C0 = rest * CFrame.new(0, half, 0) * CFrame.Angles(a, 0, 0) * CFrame.new(0, -half, 0)
		end
		for i, sh in v.spin do
			local w = sh:FindFirstChildOfClass("Weld")
			if w then
				local a = now * 1.6 + i * math.pi / 2
				w.C0 = CFrame.new(math.cos(a) * 3 * s, math.sin(now * 2 + i) * 0.6 * s, math.sin(a) * 3 * s) * CFrame.Angles(0.5, a, 0.4)
			end
		end
	end
	v.pivot.CFrame = cf
	-- health bar
	local hp = root:GetAttribute("Hp") or 0
	if hp ~= v.shownHp and v.bar then
		v.shownHp = hp
		local max = root:GetAttribute("MaxHp") or 1
		v.bar.Size = UDim2.fromScale(math.clamp(hp / max, 0, 1), 1)
		v.barText.Text = Format.abbrev(hp)
	end
end

function NpcRender.visualOf(fighterId: number): Visual?
	return byFighter[fighterId]
end

-- Nearest living enemy to a point (auto-aim, auto-fight walking).
function NpcRender.nearest(pos: Vector3, range: number, dir: Vector3?, minDot: number?): (BasePart?, number)
	local best, bestD = nil, range
	for root, v in visuals do
		local p = root.Position
		local d = (p - pos).Magnitude
		if d < bestD then
			if not dir or (p - pos).Unit:Dot(dir) >= (minDot or 0) then
				best, bestD = root, d
			end
		end
	end
	return best, bestD
end

function NpcRender.init()
	local function watch(folder: Instance)
		folder.ChildAdded:Connect(function(c)
			if c:IsA("BasePart") then
				task.defer(add, c)
			end
		end)
		folder.ChildRemoved:Connect(function(c)
			if c:IsA("BasePart") then
				remove(c)
			end
		end)
		for _, c in folder:GetChildren() do
			if c:IsA("BasePart") then
				add(c)
			end
		end
	end
	task.spawn(function()
		watch(workspace:WaitForChild("Enemies"))
	end)
	CombatFx.on("hit", function(d)
		local v = byFighter[d.v]
		if v then
			v.flinchAt = os.clock()
		end
	end)
	Lang.Changed:Connect(function()
		for _, v in visuals do
			local name = v.gui and v.gui:FindFirstChildOfClass("TextLabel")
			if name then
				name.Text = Lang.t("npc." .. v.def.id)
			end
		end
	end)
	RunService.RenderStepped:Connect(function(dt)
		if Fx.frozen() then
			return
		end
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		local now = os.clock()
		local camPos = cam.CFrame.Position
		for root, v in visuals do
			if root.Parent then
				step(v, dt, now, camPos)
			end
		end
	end)
	local _ = Players
end

return NpcRender
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Purchase</string>
            <string name="Source"><![CDATA[--!strict
-- Robux purchase prompts. Items with id 0 in Config are not live yet.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Lang = require(script.Parent.Lang)

local Purchase = {}

local notify: (string, string?) -> () = function(_text, _kind) end
function Purchase.setNotifier(fn: (string, string?) -> ())
	notify = fn
end

function Purchase.pass(key: string)
	local pass = Config.PassByKey[key]
	if not pass or pass.id == 0 then
		notify(Lang.t("toast.coming_soon", { item = Lang.t("pass." .. key .. ".name") }), "info")
		return
	end
	MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, pass.id)
end

function Purchase.product(key: string)
	local product = Config.ProductByKey[key]
	if not product or product.id == 0 then
		notify(Lang.t("toast.coming_soon", { item = Lang.t("product." .. key .. ".name") }), "info")
		return
	end
	MarketplaceService:PromptProductPurchase(Players.LocalPlayer, product.id)
end

function Purchase.passAvailable(key: string): boolean
	local pass = Config.PassByKey[key]
	return pass ~= nil and pass.id ~= 0
end

function Purchase.productAvailable(key: string): boolean
	local product = Config.ProductByKey[key]
	return product ~= nil and product.id ~= 0
end

return Purchase
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="42">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Combat HUD. Layout follows what the top anime fighters on Roblox do:
--   PC     bottom-left: power + HP + ki + currencies   bottom-centre: auto toggles over the five
--          numbered training slots (+ weights)          bottom-right: the move list with its keys
--   touch  top-left: power + HP + ki + currencies       top-centre: training slots + auto toggles
--          (the bottom corners belong to the thumbstick and the round action buttons)
-- Plus: zone pill, combo counter, boss bar, beam charge meter, low-HP vignette, screen flash
-- and the giant form name when you transform.
-- Pieces that stack share a "dock" so they scale as one block at any resolution.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)
local Net = require(script.Parent.Parent.Net)
local Lang = require(script.Parent.Parent.Lang)
local Fx = require(script.Parent.Parent.Fx)
local Controls = require(script.Parent.Parent.Controls)
local CombatFx = require(script.Parent.Parent.CombatFx)
local NpcRender = require(script.Parent.Parent.NpcRender)

local Hud = {}

local player = Players.LocalPlayer
local new = Theme.new
local touch = Root.isTouch
local C = Config.Combat

local refs: { [string]: any } = {}
Hud.refs = refs
Hud.notify = nil :: any -- set by Main (Toasts.show)
Hud.banner = nil :: any

---------------------------------------------------------------------------
-- Vitals dock: power, form, HP, ki, currencies
---------------------------------------------------------------------------
local function currency(parent: Instance, name: string, icon: string, color: Color3, pos: UDim2): TextLabel
	local f = new("Frame", { Name = name, Size = UDim2.fromOffset(122, 30), Position = pos, BackgroundColor3 = Theme.PanelDark, BackgroundTransparency = 0.25, Parent = parent }, {
		Theme.corner(15),
		Theme.stroke(2.5),
	})
	local medal = new("Frame", { Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(-3, -2), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 2, Parent = f }, {
		Theme.corner(17),
		Theme.stroke(2.5),
		Theme.gradient(Theme.lighten(color, 0.4), color),
	})
	Theme.text({ Text = icon, Stroke = false, Size = UDim2.fromScale(0.66, 0.66), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Parent = medal }).ZIndex = 3
	local value = Theme.text({ Name = "Value", Text = "0", Font = Theme.Display, Size = UDim2.new(1, -42, 1, -4), Position = UDim2.fromOffset(36, 2), MaxTextSize = 24, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.lighten(color, 0.55), Parent = f })
	new("UIScale", { Parent = f })
	refs[name .. "Pill"] = f
	return value
end

local function buildVitals()
	local dock = new("Frame", {
		Name = "Vitals",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(254, 134),
		Position = if touch then UDim2.fromOffset(8, 6) else UDim2.new(0, 10, 1, -10),
		AnchorPoint = if touch then Vector2.zero else Vector2.new(0, 1),
		Parent = Root.gui,
	})
	Root.mount(dock)
	refs.vitals = dock
	-- power line
	local powerRow = new("Frame", { Name = "PowerRow", BackgroundTransparency = 1, Size = UDim2.fromOffset(254, 38), Parent = dock })
	new("UIScale", { Parent = powerRow })
	refs.powerBox = powerRow
	local badge = new("Frame", { Size = UDim2.fromOffset(38, 38), BackgroundColor3 = Color3.new(1, 1, 1), Parent = powerRow }, {
		Theme.corner(19),
		Theme.stroke(3),
		Theme.gradient(Color3.fromRGB(255, 200, 70), Color3.fromRGB(240, 96, 30)),
	})
	Theme.text({ Text = "💥", Stroke = false, Size = UDim2.fromScale(0.66, 0.66), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Parent = badge })
	refs.power = Theme.text({ Name = "Power", Text = "0", Font = Theme.Display, Size = UDim2.fromOffset(120, 38), Position = UDim2.fromOffset(44, 0), MaxTextSize = 38, Stroke = 3, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(255, 226, 110), Parent = powerRow })
	Theme.text({ Key = "hud.power", Size = UDim2.fromOffset(84, 14), Position = UDim2.fromOffset(168, 4), MaxTextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Dim, Parent = powerRow })
	refs.form = Theme.text({ Name = "Form", Text = "", Size = UDim2.fromOffset(88, 18), Position = UDim2.fromOffset(166, 18), MaxTextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, Parent = powerRow })
	-- bars
	refs.hpBar, refs.setHp = Theme.bar({ Name = "HpBar", Size = UDim2.fromOffset(254, 24), Position = UDim2.fromOffset(0, 42), Color = Theme.Green, TextSize = 15, Parent = dock })
	refs.kiBar, refs.setKi = Theme.bar({ Name = "KiBar", Size = UDim2.fromOffset(254, 20), Position = UDim2.fromOffset(0, 70), Color = Theme.Cyan, TextSize = 13, Parent = dock })
	-- currencies + boost line
	refs.sparks = currency(dock, "Sparks", "⚡", Theme.Yellow, UDim2.fromOffset(4, 98))
	refs.gems = currency(dock, "Gems", "💎", Theme.Cyan, UDim2.fromOffset(132, 98))
	refs.boost = Theme.text({ Name = "Boost", Text = "", Size = UDim2.fromOffset(250, 14), Position = if touch then UDim2.fromOffset(2, 132) else UDim2.fromOffset(2, -18), MaxTextSize = 13, TextColor3 = Theme.Yellow, TextXAlignment = Enum.TextXAlignment.Left, Parent = dock })
end

---------------------------------------------------------------------------
-- Training dock: auto toggles + five numbered stat slots + weights
---------------------------------------------------------------------------
local statSlots: { [string]: { frame: TextButton, value: TextLabel, ring: UIStroke, scale: UIScale } } = {}
local SLOT = if touch then 50 else 58

local function toggleButton(key: string, locKey: string, order: number, parent: Instance, w: number): TextButton
	local b = new("TextButton", {
		Name = "Auto_" .. key,
		Size = UDim2.fromOffset(w, 26),
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = order,
		Parent = parent,
	}, { Theme.corner(13), Theme.stroke(2.5), new("UIGradient", { Name = "G", Rotation = 90 }) })
	local dot = new("Frame", { Name = "Dot", Size = UDim2.fromOffset(12, 12), Position = UDim2.fromOffset(7, 7), BackgroundColor3 = Theme.Grey, Parent = b }, { Theme.corner(6), Theme.stroke(1.5) })
	local _ = dot
	Theme.text({ Name = "Label", Text = "", Size = UDim2.new(1, -28, 1, -6), Position = UDim2.fromOffset(23, 3), MaxTextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = b })
	b:SetAttribute("SettingKey", key)
	b:SetAttribute("LocKey", locKey)
	b.Activated:Connect(function()
		Theme.play("click", 0.3)
		Controls.toggleSetting(key)
	end)
	return b
end

local function buildTraining()
	local n = #Config.Stats
	local gap = 8
	local gearW = if touch then 96 else 118
	local w = n * SLOT + (n - 1) * gap + gap + gearW
	local h = 26 + 6 + SLOT + 20
	local dock = new("Frame", {
		Name = "Training",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(w, h),
		Position = if touch then UDim2.new(0.5, 40, 0, 6) else UDim2.new(0.5, 0, 1, -8),
		AnchorPoint = if touch then Vector2.new(0.5, 0) else Vector2.new(0.5, 1),
		Parent = Root.gui,
	})
	Root.mount(dock)
	refs.training = dock
	-- auto toggles (top row on PC, bottom row on touch so the slots sit under the Roblox bar)
	local autos = new("Frame", {
		Name = "Autos",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(w, 26),
		Position = if touch then UDim2.fromOffset(0, SLOT + 24) else UDim2.fromOffset(0, 0),
		Parent = dock,
	}, { Theme.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })
	local bw = math.floor((w - 12) / 3)
	refs.autoTrain = toggleButton("autoTrain", "hud.auto_train", 1, autos, bw)
	refs.autoCharge = toggleButton("autoCharge", "hud.auto_ki", 2, autos, bw)
	refs.autoFight = toggleButton("autoFight", "hud.auto_fight", 3, autos, bw)
	refs.autos = autos
	-- stat slots
	local top = if touch then 0 else 32
	for i, stat in Config.Stats do
		local info = Config.StatInfo[stat]
		local color = Theme.rgb(info.color)
		local b = new("TextButton", {
			Name = "Stat_" .. stat,
			Size = UDim2.fromOffset(SLOT, SLOT),
			Position = UDim2.fromOffset((i - 1) * (SLOT + gap) + SLOT / 2, top + SLOT / 2),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			AutoButtonColor = false,
			Text = "",
			Parent = dock,
		}, {
			Theme.corner(SLOT),
			Theme.gradient(Theme.PanelLight, Theme.PanelDark),
		})
		local ring = new("UIStroke", { Thickness = 3, Color = Theme.White, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = b })
		local scale = new("UIScale", { Parent = b })
		Theme.text({ Text = info.icon, Stroke = false, Size = UDim2.fromScale(0.58, 0.58), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Parent = b })
		if not touch then
			Theme.text({ Text = tostring(i), Font = Theme.Display, Size = UDim2.fromOffset(18, 20), Position = UDim2.fromOffset(-2, -6), MaxTextSize = 20, Stroke = 2.5, Parent = b }).ZIndex = 4
		end
		local value = Theme.text({ Name = "Value", Text = "0", Font = Theme.Display, Size = UDim2.fromOffset(SLOT + gap, 18), Position = UDim2.new(0.5, 0, 1, 2), AnchorPoint = Vector2.new(0.5, 0), MaxTextSize = 18, TextColor3 = Theme.lighten(color, 0.45), Parent = b })
		b.Activated:Connect(function()
			Theme.play("click", 0.3)
			Controls.setStat(stat)
		end)
		statSlots[stat] = { frame = b, value = value, ring = ring, scale = scale }
	end
	-- weights
	local gear = new("TextButton", {
		Name = "Gear",
		Size = UDim2.fromOffset(gearW, SLOT),
		Position = UDim2.fromOffset(n * (SLOT + gap), top),
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Text = "",
		Parent = dock,
	}, { Theme.corner(12), Theme.stroke(3), new("UIGradient", { Name = "G", Rotation = 90 }) })
	Theme.gloss(gear, 12, 0.85)
	new("UIScale", { Parent = gear })
	refs.gearTop = Theme.text({ Name = "Top", Text = "", Size = UDim2.new(1, -8, 0.5, -2), Position = UDim2.fromOffset(4, 3), MaxTextSize = 17, Parent = gear })
	refs.gearBottom = Theme.text({ Name = "Bottom", Text = "", Font = Theme.Display, Size = UDim2.new(1, -8, 0.5, -4), Position = UDim2.new(0, 4, 0.5, 0), MaxTextSize = 20, TextColor3 = Theme.Yellow, Parent = gear })
	gear.Activated:Connect(function()
		local ok, res = Net.request("BuyGear")
		if ok then
			Theme.play("land", 0.5, 1.3)
			Theme.pop(gear, 1.12)
		elseif Hud.notify then
			Hud.notify(Lang.msg(res), "error")
		end
	end)
	refs.gear = gear
	-- selected stat readout: "+12 per rep · auto 1.5/s"
	refs.trainRate = Theme.text({ Name = "Rate", Text = "", Size = UDim2.fromOffset(w, 14), Position = if touch then UDim2.fromOffset(0, SLOT + 52) else UDim2.fromOffset(0, -18), MaxTextSize = 13, TextColor3 = Theme.Yellow, Parent = dock })
end

---------------------------------------------------------------------------
-- Moves dock (PC): the move list with its keys and cooldown fills
---------------------------------------------------------------------------
type Slot = { frame: TextButton, cool: Frame, action: string }
local slots: { Slot } = {}

local function moveSlot(parent: Instance, order: number, icon: string, key: string, locKey: string, action: string, color: Color3, onClick: (() -> ())?): Slot
	local f = new("TextButton", { Name = "Slot_" .. action, Size = UDim2.fromOffset(44, 44), BackgroundColor3 = Theme.PanelDark, BackgroundTransparency = 0.3, AutoButtonColor = false, Text = "", LayoutOrder = order, ClipsDescendants = false, Parent = parent }, {
		Theme.corner(8),
		Theme.stroke(2.5, Theme.lighten(color, 0.25)),
	})
	-- cooldown: a fill of the move colour that drains as the move comes back
	local clip = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClipsDescendants = true, Parent = f }, { Theme.corner(8) })
	local cool = new("Frame", { Name = "Cool", Size = UDim2.fromScale(1, 0), Position = UDim2.fromScale(0, 1), AnchorPoint = Vector2.new(0, 1), BackgroundColor3 = color, BackgroundTransparency = 0.35, BorderSizePixel = 0, Parent = clip })
	Theme.text({ Text = icon, Stroke = false, Size = UDim2.fromScale(0.6, 0.6), Position = UDim2.fromScale(0.5, 0.42), AnchorPoint = Vector2.new(0.5, 0.5), Parent = f }).ZIndex = 2
	local keyLabel = Theme.text({ Text = key, Font = Theme.Display, Size = UDim2.fromOffset(34, 16), Position = UDim2.new(1, 1, 1, 1), AnchorPoint = Vector2.new(1, 1), MaxTextSize = 16, Stroke = 2.5, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Theme.Yellow, Parent = f })
	keyLabel.ZIndex = 4
	f:SetAttribute("LocKey", locKey)
	new("UIScale", { Parent = f })
	if onClick then
		f.Activated:Connect(onClick)
	end
	local s = { frame = f, cool = cool, action = action }
	table.insert(slots, s)
	return s
end

local function buildMoves()
	local dock = new("Frame", {
		Name = "Moves",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(240, 116),
		Position = UDim2.new(1, -10, 1, -10),
		AnchorPoint = Vector2.new(1, 1),
		Parent = Root.gui,
	})
	Root.mount(dock)
	refs.moves = dock
	refs.moveName = Theme.text({ Key = "hud.moves", Size = UDim2.fromOffset(236, 16), Position = UDim2.fromOffset(0, 0), MaxTextSize = 14, TextXAlignment = Enum.TextXAlignment.Right, Font = Theme.FontBold, Parent = dock })
	local grid = new("Frame", { Name = "Grid", BackgroundTransparency = 1, Size = UDim2.fromOffset(240, 96), Position = UDim2.fromOffset(0, 20), Parent = dock }, {
		new("UIGridLayout", { CellSize = UDim2.fromOffset(44, 44), CellPadding = UDim2.fromOffset(5, 6), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Bottom, StartCorner = Enum.StartCorner.TopLeft }),
	})
	moveSlot(grid, 1, "👊", "LMB", "act.punch", "melee", Theme.Red, nil)
	moveSlot(grid, 2, "🔵", "Q", "act.blast", "blast", Theme.Cyan, Controls.blast)
	moveSlot(grid, 3, "☄️", "R", "act.beam", "beam", Theme.Blue, nil)
	moveSlot(grid, 4, "🛡️", "F", "act.block", "block", Theme.Green, nil)
	moveSlot(grid, 5, "💨", "E", "act.dash", "dash", Theme.Yellow, Controls.dash)
	moveSlot(grid, 6, "🔋", "C", "act.charge", "charge", Theme.Purple, nil)
	moveSlot(grid, 7, "🔥", "G", "act.form", "form", Theme.Orange, function()
		Controls.transform()
	end)
	moveSlot(grid, 8, "🕊️", "H", "act.fly", "fly", Theme.Pink, Controls.toggleFly)
	for i, t in Config.Techniques do
		local s = moveSlot(grid, 8 + i, t.icon, t.key, "tech." .. t.id, "t_" .. t.id, Theme.Purple, function()
			Controls.technique(t.id)
		end)
		refs["tech_" .. t.id] = s.frame
	end
	-- hovering a move shows its name over the grid
	for _, s in slots do
		s.frame.MouseEnter:Connect(function()
			Lang.unbind(refs.moveName)
			refs.moveName.Text = Lang.t(s.frame:GetAttribute("LocKey"))
		end)
		s.frame.MouseLeave:Connect(function()
			Lang.bind(refs.moveName, "hud.moves")
		end)
	end
end

---------------------------------------------------------------------------
-- Top-centre: zone pill, boss bar. Centre: combo, beam meter, form title. Overlays.
---------------------------------------------------------------------------
local comboAt = 0
local function buildCombat()
	-- touch: the training dock owns the top centre, so these sit lower / to the right
	local zone = new("Frame", {
		Name = "Zone",
		Size = UDim2.fromOffset(320, 32),
		Position = if touch then UDim2.new(0.5, 40, 0, 118) else UDim2.new(0.5, 0, 0, 8),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		Parent = Root.gui,
	}, { Theme.corner(16), Theme.stroke(3), new("UIGradient", { Name = "G", Rotation = 90 }) })
	new("UIScale", { Parent = zone })
	Root.mount(zone)
	refs.zone = zone
	refs.zoneText = Theme.text({ Size = UDim2.new(1, -20, 1, -8), Position = UDim2.fromOffset(10, 4), MaxTextSize = 19, Parent = zone })

	local boss = new("Frame", { Name = "BossBar", BackgroundTransparency = 1, Size = UDim2.fromOffset(440, 44), Position = if touch then UDim2.new(0.5, 40, 0, 154) else UDim2.new(0.5, 0, 0, 46), AnchorPoint = Vector2.new(0.5, 0), Visible = false, Parent = Root.gui })
	Root.mount(boss)
	refs.boss = boss
	refs.bossName = Theme.text({ Text = "", Size = UDim2.new(1, 0, 0, 20), MaxTextSize = 19, Stroke = 3, TextColor3 = Theme.Yellow, Parent = boss })
	refs.bossBar, refs.setBoss = Theme.bar({ Name = "BossHp", Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 22), Color = Theme.Red, TextSize = 14, Parent = boss })

	local combo = new("Frame", { Name = "Combo", BackgroundTransparency = 1, Size = UDim2.fromOffset(200, 96), Position = if touch then UDim2.new(0.42, 0, 0.44, 0) else UDim2.new(1, -60, 0.4, 0), AnchorPoint = if touch then Vector2.new(0.5, 0.5) else Vector2.new(1, 0.5), Visible = false, Parent = Root.gui })
	new("UIScale", { Parent = combo })
	Root.mount(combo)
	refs.combo = combo
	refs.comboN = Theme.text({ Text = "x2", Font = Theme.Display, Size = UDim2.new(1, 0, 0, 64), MaxTextSize = 64, Stroke = 4, TextColor3 = Theme.Yellow, Rotation = -6, Parent = combo })
	Theme.text({ Key = "hud.hits", Font = Theme.Display, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 60), MaxTextSize = 28, Stroke = 3, Rotation = -6, Parent = combo })

	local beamMeter, setBeam = Theme.bar({ Name = "BeamMeter", Size = UDim2.fromOffset(260, 20), Position = if touch then UDim2.new(0.42, 0, 0.62, 0) else UDim2.new(0.5, 0, 1, -150), AnchorPoint = Vector2.new(0.5, 1), Color = Theme.Blue, TextSize = 13, Parent = Root.gui })
	beamMeter.Visible = false
	Root.mount(beamMeter)
	refs.beamMeter, refs.setBeam = beamMeter, setBeam

	-- giant form name for a second when you transform
	local title = Theme.text({ Name = "FormTitle", Text = "", Font = Theme.Display, Size = UDim2.fromOffset(900, 120), Position = UDim2.fromScale(0.5, 0.3), AnchorPoint = Vector2.new(0.5, 0.5), MaxTextSize = 110, Stroke = 6, Visible = false, Parent = Root.gui })
	new("UIScale", { Parent = title })
	Root.mount(title)
	refs.formTitle = title

	-- full-screen overlays (no input)
	refs.flash = new("Frame", { Name = "Flash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.White, BackgroundTransparency = 1, BorderSizePixel = 0, Parent = Root.overlay })
	refs.hurt = new("Frame", { Name = "Hurt", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Red, BackgroundTransparency = 1, BorderSizePixel = 0, Parent = Root.overlay }, {
		new("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 1), NumberSequenceKeypoint.new(0.7, 1), NumberSequenceKeypoint.new(1, 0) }),
		}),
	})
end

function Hud.flash(color: Color3, strength: number?)
	local f = refs.flash
	f.BackgroundColor3 = color
	f.BackgroundTransparency = 1 - (strength or 0.7)
	TweenService:Create(f, TweenInfo.new(0.45), { BackgroundTransparency = 1 }):Play()
end

local function formTitle(text: string, color: Color3)
	local t = refs.formTitle
	t.Text = text
	t.TextColor3 = Theme.lighten(color, 0.35)
	t.TextTransparency = 0
	t.Visible = true
	local st = t:FindFirstChildOfClass("UIStroke")
	if st then
		st.Transparency = 0
	end
	local sc = t:FindFirstChildOfClass("UIScale")
	sc.Scale = 2.2
	TweenService:Create(sc, TweenInfo.new(0.22, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(0.9, function()
		TweenService:Create(t, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
		if st then
			TweenService:Create(st, TweenInfo.new(0.35), { Transparency = 1 }):Play()
		end
		task.wait(0.36)
		if t.TextTransparency >= 0.99 then
			t.Visible = false
		end
	end)
end

---------------------------------------------------------------------------
-- Refresh
---------------------------------------------------------------------------
local lastPower = -1
local lastSparks, lastGems = -1, -1

local function refreshNumbers()
	local s = Net.state
	if not s then
		return
	end
	if s.power ~= lastPower then
		if lastPower >= 0 and s.power > lastPower then
			Theme.pop(refs.powerBox, 1.05)
		end
		lastPower = s.power
		refs.power.Text = Format.abbrev(s.power)
	end
	if s.sparks ~= lastSparks then
		if lastSparks >= 0 and s.sparks > lastSparks then
			Theme.pop(refs.SparksPill, 1.1)
		end
		lastSparks = s.sparks
		refs.sparks.Text = Format.abbrev(s.sparks)
	end
	if s.gems ~= lastGems then
		if lastGems >= 0 and s.gems > lastGems then
			Theme.pop(refs.GemsPill, 1.1)
		end
		lastGems = s.gems
		refs.gems.Text = Format.abbrev(s.gems)
	end
	for stat, slot in statSlots do
		slot.value.Text = Format.abbrev(s.stats[stat] or 0)
	end
end

local function face(color: Color3): ColorSequence
	return ColorSequence.new(Theme.lighten(color, 0.2), Theme.darken(color, 0.28))
end

local function refreshFull()
	local s = Net.state
	if not s then
		return
	end
	refreshNumbers()
	local selected = s.settings.stat
	for stat, slot in statSlots do
		local on = stat == selected
		local color = Theme.rgb(Config.StatInfo[stat].color)
		slot.ring.Color = if on then color else Theme.White
		slot.ring.Thickness = if on then 5 else 2.5
		slot.ring.Transparency = if on then 0 else 0.35
		slot.scale.Scale = if on then 1.12 else 0.94
		local g = slot.frame:FindFirstChildOfClass("UIGradient")
		if g then
			g.Color = if on then ColorSequence.new(Theme.lighten(color, 0.15), Theme.darken(color, 0.45)) else ColorSequence.new(Theme.PanelLight, Theme.PanelDark)
		end
	end
	refs.trainRate.Text = Lang.t("hud.rate", { stat = Lang.t("stat." .. selected), n = Format.abbrev(math.max(1, s.perRep[selected] or 0)), auto = string.format("%.1f", s.autoRate) })
	for _, key in { "autoTrain", "autoCharge", "autoFight" } do
		local b = refs[key]
		local on = s.settings[key] == true
		b.Label.Text = Lang.t(b:GetAttribute("LocKey")) .. ": " .. Lang.t(if on then "hud.on" else "hud.off")
		b.G.Color = face(if on then Theme.Green else Theme.Grey)
		b.Dot.BackgroundColor3 = if on then Color3.fromRGB(210, 255, 170) else Theme.PanelDark
	end
	-- weights
	local nextTier = Config.Gear[s.gear + 1]
	local cur = string.format("x%g", Formulas.gearMult(s.gear))
	if nextTier then
		refs.gearTop.Text = "🏋️ " .. cur .. " → " .. string.format("x%g", nextTier.mult)
		refs.gearBottom.Text = "⚡ " .. Format.abbrev(nextTier.cost)
		refs.gear.G.Color = Theme.buttonFace(if s.sparks >= nextTier.cost then Theme.Green else Theme.Orange)
	else
		refs.gearTop.Text = "🏋️ " .. cur
		refs.gearBottom.Text = "MAX"
		refs.gear.G.Color = Theme.buttonFace(Theme.Grey)
	end
	-- zone pill
	local zone = Config.ZoneById[s.zone]
	if zone then
		refs.zone.Visible = true
		local g = refs.zone.G
		if s.zoneLocked then
			g.Color = face(Theme.Red)
			refs.zoneText.Text = "🔒 " .. Lang.t("hud.zone_locked", { power = Format.abbrev(zone.reqPower) })
		else
			g.Color = face(Theme.Purple)
			refs.zoneText.Text = Lang.t("zone." .. zone.id) .. "  x" .. Format.abbrev(zone.mult)
		end
	else
		refs.zone.Visible = false
	end
	-- moves: techniques appear once owned; the form slot is dim until a form is unlocked
	for _, t in Config.Techniques do
		local f = refs["tech_" .. t.id]
		if f then
			f.Visible = s.techniques[t.id] == true
		end
	end
	-- boost line
	local parts = {}
	if s.boostLeft and s.boostLeft > 0 then
		table.insert(parts, "🔥 x2 " .. Format.time(s.boostLeft))
	end
	if s.rebirths and s.rebirths > 0 then
		table.insert(parts, "🌟 " .. s.rebirths)
	end
	refs.boost.Text = table.concat(parts, "   ")
end

local function nearestBoss(pos: Vector3): any
	local best, bestD = nil, 170
	for root, v in NpcRender.visuals do
		if v.def.boss then
			local d = (root.Position - pos).Magnitude
			if d < bestD then
				best, bestD = v, d
			end
		end
	end
	return best
end

local lastForm = -1
local function tick()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not char or not hum then
		return
	end
	refs.setHp(hum.Health / math.max(1, hum.MaxHealth), "HP  " .. Format.abbrev(math.ceil(hum.Health)) .. " / " .. Format.abbrev(hum.MaxHealth))
	local ki = char:GetAttribute("Ki") or 0
	refs.setKi(ki, Lang.t("hud.ki") .. "  " .. math.floor(ki * 100 + 0.5) .. "%")
	local form = char:GetAttribute("Form") or 0
	if form ~= lastForm then
		local first = lastForm == -1
		lastForm = form
		local c1 = Fx.formColors(form)
		if form > 0 then
			local name = Lang.t("form." .. Config.Forms[form].id)
			refs.form.Text = name .. " x" .. Format.abbrev(Config.Forms[form].mult)
			refs.form.TextColor3 = Theme.lighten(c1, 0.5)
			Theme.setBarColor(refs.kiBar, c1)
			if not first then
				Hud.flash(Theme.lighten(c1, 0.5), 0.75)
				formTitle(Lang.upper(name) .. "!", c1)
			end
		else
			refs.form.Text = ""
			Theme.setBarColor(refs.kiBar, Theme.Cyan)
		end
	end
	-- low HP vignette
	local frac = hum.Health / math.max(1, hum.MaxHealth)
	refs.hurt.BackgroundTransparency = if frac < 0.3 and hum.Health > 0 then 0.55 + math.sin(os.clock() * 7) * 0.12 else 1
	-- boss bar
	local root = char:FindFirstChild("HumanoidRootPart")
	local boss = root and nearestBoss(root.Position)
	if boss then
		refs.boss.Visible = true
		refs.bossName.Text = Lang.t("npc." .. boss.def.id)
		local hp, max = boss.root:GetAttribute("Hp") or 0, boss.root:GetAttribute("MaxHp") or 1
		refs.setBoss(hp / max, Format.abbrev(hp) .. " / " .. Format.abbrev(max))
	else
		refs.boss.Visible = false
	end
	-- combo fade
	if refs.combo.Visible and os.clock() - comboAt > C.comboWindow + 0.2 then
		refs.combo.Visible = false
	end
end

local function cooldowns()
	local now = os.clock()
	for _, s in slots do
		local total = Controls.cooldownOf[s.action]
		local frac = 0
		if total then
			frac = math.clamp(((Controls.nextAt[s.action] or 0) - now) / total, 0, 1)
		end
		s.cool.Size = UDim2.fromScale(1, frac)
	end
	local started = Controls.beamStartedAt
	if started then
		local charge = math.clamp((now - started) / C.beamMaxCharge, 0, 1)
		refs.beamMeter.Visible = true
		refs.setBeam(charge, if charge >= 1 then "MAX" else math.floor(charge * 100) .. "%")
	elseif refs.beamMeter.Visible then
		refs.beamMeter.Visible = false
	end
end

function Hud.init()
	buildVitals()
	buildTraining()
	if not touch then
		buildMoves()
	end
	buildCombat()

	Net.Changed:Connect(function(kind)
		if kind == "full" then
			refreshFull()
		else
			refreshNumbers()
		end
	end)
	Lang.Changed:Connect(function()
		lastForm = -1
		refreshFull()
	end)
	refreshFull()

	Net.event("Combat").OnClientEvent:Connect(function(kind, a)
		if kind == "combo" then
			comboAt = os.clock()
			if a >= 2 then
				refs.combo.Visible = true
				refs.comboN.Text = "x" .. a
				refs.comboN.TextColor3 = if a % C.comboFinisher == 0 then Theme.Red else Theme.Yellow
				Theme.pop(refs.combo, if a % C.comboFinisher == 0 then 1.5 else 1.22)
			end
		elseif kind == "kill" then
			if Hud.notify and a.b then
				Hud.notify(Lang.t("toast.boss_down", { boss = Lang.t("npc." .. a.n), n = Format.abbrev(a.s), g = a.g }), "success")
			end
		elseif kind == "formUnlocked" then
			if Hud.banner then
				local f = Config.Forms[a]
				Hud.banner(Lang.t("toast.form_unlocked", { form = Lang.t("form." .. f.id), key = if touch then "🔥" else "G" }), Theme.rgb(f.color))
			end
		elseif kind == "planetUnlocked" then
			if Hud.banner then
				Hud.banner(Lang.t("toast.planet_unlocked", { planet = Lang.t("planet." .. Config.Planets[a].id) }), Theme.Cyan)
			end
		end
	end)

	-- rep feedback: a big "+N" in the colour of the stat on every punch
	Controls.Used:Connect(function(action)
		if action == "melee" then
			local s = Net.state
			local char = player.Character
			local head = char and char:FindFirstChild("Head")
			if s and head then
				local stat = s.settings.stat
				local gain = s.perRep[stat] or 1
				CombatFx.damageNumber(head.Position + Vector3.new(0, 1, 0), "+" .. Format.abbrev(math.max(1, gain)) .. " " .. Config.StatInfo[stat].icon, Theme.rgb(Config.StatInfo[stat].color):Lerp(Theme.White, 0.25), true)
				local slot = statSlots[stat]
				if slot then
					slot.scale.Scale = 1.26
					TweenService:Create(slot.scale, TweenInfo.new(0.16), { Scale = 1.12 }):Play()
				end
			end
		elseif action == "noKi" then
			Theme.pop(refs.kiBar, 1.1)
			if Hud.notify then
				Hud.notify(Lang.t("hud.no_ki"), "error")
			end
		end
	end)

	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		cooldowns()
		acc += dt
		if acc >= 0.066 then
			acc = 0
			tick()
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">Root</string>
              <string name="Source"><![CDATA[--!strict
-- The ScreenGuis for the game UI plus resolution scaling and the touch layout flag.
-- Scaling is applied per top-level element through Root.mount (a holder frame with a
-- UIScale), because a UIScale on the ScreenGui itself would also shrink full-screen
-- layouts and edge anchoring.
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)

local Root = {}

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui

-- Phones/tablets: the Roblox thumbstick (bottom-left) and jump button (bottom-right) own
-- those corners, so the HUD moves to the top and panels open at the top.
-- (Studio can't emulate touch: workspace attribute ForceTouchLayout previews it.)
Root.isTouch = (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) or Workspace:GetAttribute("ForceTouchLayout") == true

Root.gui = Theme.new("ScreenGui", {
	Name = "KiWarriorsUI",
	ResetOnSpawn = false,
	ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets, -- stays clear of the Roblox topbar buttons
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = playerGui,
}) :: ScreenGui

-- Full-screen overlay (transformation flash, cinematics), ignores insets, drawn above everything.
Root.overlay = Theme.new("ScreenGui", {
	Name = "KiWarriorsOverlay",
	ResetOnSpawn = false,
	ScreenInsets = Enum.ScreenInsets.None,
	DisplayOrder = 10,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = playerGui,
}) :: ScreenGui

Root.scale = 1
local scales: { UIScale } = {}
local changed = Instance.new("BindableEvent")
Root.Changed = changed.Event

-- Design size 1100x560 of usable (safe-area) space: ~0.8 on a 920x505 phone, capped at 1.1
-- on big monitors so the PC layout stays compact.
local function compute(): number
	local size = Root.gui.AbsoluteSize
	if size.X < 10 or size.Y < 10 then
		local cam = Workspace.CurrentCamera
		if not cam then
			return 1
		end
		size = cam.ViewportSize
	end
	return math.clamp(math.min(size.X / 1100, size.Y / 560), 0.5, 1.1)
end

local playerListShown: boolean? = nil
local function apply()
	Root.scale = compute()
	for _, s in scales do
		s.Scale = Root.scale
	end
	-- The default player list covers the right-side HUD on small screens.
	local cam = Workspace.CurrentCamera
	local show = cam ~= nil and cam.ViewportSize.X >= 1000 and not Root.isTouch
	if show ~= playerListShown then
		playerListShown = show
		pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, show)
		end)
	end
	changed:Fire(Root.scale)
end

-- Wraps a top-level GuiObject in a holder that carries the resolution UIScale. The holder
-- takes the object's Size/Position/AnchorPoint, so edge anchoring keeps working, and the
-- object stays free to use its own UIScale for pop animations.
function Root.mount(obj: GuiObject, parent: Instance?): Frame
	local holder = Theme.new("Frame", {
		Name = obj.Name .. "Holder",
		BackgroundTransparency = 1,
		Size = obj.Size,
		Position = obj.Position,
		AnchorPoint = obj.AnchorPoint,
		ZIndex = obj.ZIndex,
		Parent = parent or Root.gui,
	}) :: Frame
	local s = Theme.new("UIScale", { Scale = Root.scale, Parent = holder }) :: UIScale
	table.insert(scales, s)
	obj.AnchorPoint = Vector2.new(0.5, 0.5)
	obj.Position = UDim2.fromScale(0.5, 0.5)
	obj.Parent = holder
	return holder
end

local function hookCamera()
	local cam = Workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(apply)
	end
	apply()
end
Root.gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(apply)
hookCamera()
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hookCamera)

return Root
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Anime-fighter UI kit: dark glass panels, thick outlines, loud accent colours, chunky
-- buttons. Everything is UICorner / UIStroke / UIGradient: no image assets.
local TweenService = game:GetService("TweenService")

local Lang = require(script.Parent.Parent.Lang)
local Fx = require(script.Parent.Parent.Fx)

local Theme = {}

Theme.Font = Enum.Font.GothamBlack
Theme.FontBold = Enum.Font.GothamBold
Theme.Display = Enum.Font.Bangers -- numbers and short Latin words
Theme.Ink = Color3.fromRGB(18, 14, 34) -- outlines
Theme.Panel = Color3.fromRGB(30, 26, 56)
Theme.PanelLight = Color3.fromRGB(52, 46, 92)
Theme.PanelDark = Color3.fromRGB(18, 15, 36)
Theme.Text = Color3.fromRGB(255, 255, 255)
Theme.Dim = Color3.fromRGB(176, 172, 206)
Theme.Orange = Color3.fromRGB(255, 138, 40)
Theme.Yellow = Color3.fromRGB(255, 214, 64)
Theme.Red = Color3.fromRGB(255, 78, 84)
Theme.Green = Color3.fromRGB(96, 224, 110)
Theme.Cyan = Color3.fromRGB(64, 198, 255)
Theme.Blue = Color3.fromRGB(76, 126, 255)
Theme.Purple = Color3.fromRGB(176, 104, 255)
Theme.Pink = Color3.fromRGB(255, 96, 176)
Theme.Grey = Color3.fromRGB(120, 116, 150)
Theme.White = Color3.new(1, 1, 1)

function Theme.rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

-- new("Frame", { props }, { children })
function Theme.new(className: string, props: { [string]: any }?, children: { any }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				inst[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Theme.corner(r: number?): any
	return Theme.new("UICorner", { CornerRadius = UDim.new(0, r or 12) })
end

function Theme.stroke(thickness: number?, color: Color3?): any
	return Theme.new("UIStroke", { Thickness = thickness or 3, Color = color or Theme.Ink, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function Theme.textStroke(thickness: number?, color: Color3?): any
	return Theme.new("UIStroke", { Thickness = thickness or 2, Color = color or Theme.Ink, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual })
end

function Theme.padding(px: number, py: number?): any
	local u, v = UDim.new(0, px), UDim.new(0, py or px)
	return Theme.new("UIPadding", { PaddingTop = v, PaddingBottom = v, PaddingLeft = u, PaddingRight = u })
end

function Theme.gradient(top: Color3, bottom: Color3, rotation: number?): any
	return Theme.new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = rotation or 90 })
end

function Theme.lighten(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), a)
end

function Theme.darken(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), a)
end

function Theme.list(dir: Enum.FillDirection?, padding: number?, hAlign: Enum.HorizontalAlignment?, vAlign: Enum.VerticalAlignment?): any
	return Theme.new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
	})
end

-- Text label. Extra props: Key/Args (translation), Stroke (false | thickness), MaxTextSize.
function Theme.text(props: { [string]: any }): TextLabel
	local t = Theme.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextColor3 = Theme.Text,
		TextScaled = true,
		Size = UDim2.fromScale(1, 1),
	})
	for k, v in props do
		if k ~= "Parent" and k ~= "Stroke" and k ~= "MaxTextSize" and k ~= "Key" and k ~= "Args" then
			t[k] = v
		end
	end
	if props.Key then
		Lang.bind(t, props.Key, props.Args)
	end
	if props.Stroke ~= false then
		Theme.textStroke(if type(props.Stroke) == "number" then props.Stroke else 2).Parent = t
	end
	Theme.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 36, MinTextSize = 8, Parent = t })
	if props.Parent then
		t.Parent = props.Parent
	end
	return t
end

-- Dark glass panel with an ink outline. Extra props: Corner, StrokeThickness, Accent (top edge colour).
function Theme.panel(props: { [string]: any }): Frame
	local f = Theme.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.06,
		BorderSizePixel = 0,
	}, {
		Theme.corner(props.Corner or 14),
		Theme.stroke(props.StrokeThickness or 3),
		Theme.gradient(props.Top or Theme.PanelLight, props.Bottom or Theme.PanelDark),
	})
	for k, v in props do
		if k ~= "Parent" and k ~= "Corner" and k ~= "StrokeThickness" and k ~= "Accent" and k ~= "Top" and k ~= "Bottom" then
			f[k] = v
		end
	end
	if props.Accent then
		Theme.new("Frame", {
			Name = "Accent",
			Size = UDim2.new(1, -16, 0, 4),
			Position = UDim2.new(0, 8, 0, 3),
			BackgroundColor3 = props.Accent,
			BorderSizePixel = 0,
			ZIndex = (props.ZIndex or 1) + 1,
			Parent = f,
		}, { Theme.corner(2) })
	end
	if props.Parent then
		f.Parent = props.Parent
	end
	return f
end

function Theme.play(name: string, volume: number?, pitch: number?)
	Fx.sound(name, volume, pitch)
end

-- Chunky button face: light top, flat middle and a darker lip along the bottom edge.
function Theme.buttonFace(color: Color3): ColorSequence
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, Theme.lighten(color, 0.36)),
		ColorSequenceKeypoint.new(0.45, color),
		ColorSequenceKeypoint.new(0.84, Theme.darken(color, 0.06)),
		ColorSequenceKeypoint.new(0.85, Theme.darken(color, 0.3)),
		ColorSequenceKeypoint.new(1, Theme.darken(color, 0.36)),
	})
end

function Theme.gloss(parent: GuiObject, corner: number, alpha: number?): Frame
	return Theme.new("Frame", {
		Name = "Gloss",
		Size = UDim2.new(1, -10, 0.38, 0),
		Position = UDim2.new(0, 5, 0, 4),
		BackgroundColor3 = Theme.White,
		BackgroundTransparency = alpha or 0.82,
		BorderSizePixel = 0,
		ZIndex = parent.ZIndex,
		Parent = parent,
	}, { Theme.corner(math.max(4, corner - 4)) })
end

function Theme.shadow(panel: GuiObject, corner: number?)
	local holder = panel.Parent
	if not holder or not holder:IsA("GuiObject") then
		return
	end
	local sh = Theme.new("Frame", {
		Name = "Shadow",
		Size = UDim2.new(1, 8, 1, 8),
		Position = UDim2.new(0.5, 0, 0.5, 9),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(8, 6, 18),
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		ZIndex = panel.ZIndex - 1,
		Visible = panel.Visible,
		Parent = holder,
	}, { Theme.corner((corner or 22) + 4) })
	panel:GetPropertyChangedSignal("Visible"):Connect(function()
		sh.Visible = panel.Visible
	end)
end

export type ButtonOpts = {
	Text: string?,
	Key: string?,
	Args: { [string]: any }?,
	Color: Color3?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	LayoutOrder: number?,
	Parent: Instance?,
	TextSize: number?,
	Corner: number?,
	OnClick: (() -> ())?,
	Name: string?,
	Icon: string?,
	ZIndex: number?,
}

function Theme.button(opts: ButtonOpts): TextButton
	local color = opts.Color or Theme.Blue
	local corner = opts.Corner or 12
	local b = Theme.new("TextButton", {
		Name = opts.Name or "Button",
		Size = opts.Size or UDim2.fromOffset(160, 48),
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.zero,
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = opts.LayoutOrder or 0,
		ZIndex = opts.ZIndex or 1,
	}, {
		Theme.corner(corner),
		Theme.stroke(3),
		Theme.new("UIGradient", { Color = Theme.buttonFace(color), Rotation = 90 }),
	})
	Theme.gloss(b, corner)
	local hasIcon = opts.Icon ~= nil
	if hasIcon then
		local icon = Theme.text({
			Name = "Icon",
			Text = opts.Icon,
			Stroke = false,
			Size = UDim2.new(0, 30, 1, -12),
			Position = UDim2.new(0, 8, 0.5, -1),
			AnchorPoint = Vector2.new(0, 0.5),
			MaxTextSize = 26,
			Parent = b,
		})
		icon.ZIndex = b.ZIndex + 1
	end
	local label = Theme.text({
		Name = "Label",
		Text = opts.Text or "",
		Size = if hasIcon then UDim2.new(1, -46, 1, -10) else UDim2.new(1, -12, 1, -10),
		Position = if hasIcon then UDim2.new(0, 40, 0.5, -1) else UDim2.new(0.5, 0, 0.5, -1),
		AnchorPoint = if hasIcon then Vector2.new(0, 0.5) else Vector2.new(0.5, 0.5),
		MaxTextSize = opts.TextSize or 26,
		Key = opts.Key,
		Args = opts.Args,
		Parent = b,
	})
	label.ZIndex = b.ZIndex + 1
	local scale = Theme.new("UIScale", { Parent = b })
	b.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.92 }):Play()
	end)
	local function release()
		TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	b.MouseButton1Up:Connect(release)
	b.MouseLeave:Connect(release)
	b.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.04 }):Play()
	end)
	if opts.OnClick then
		local cb = opts.OnClick
		b.Activated:Connect(function()
			Theme.play("click", 0.35)
			cb()
		end)
	end
	if opts.Parent then
		b.Parent = opts.Parent
	end
	return b
end

function Theme.setButton(b: TextButton, text: string?, color: Color3?)
	local label = b:FindFirstChild("Label")
	if text and label then
		Lang.unbind(label)
		label.Text = text
	end
	if color then
		local g = b:FindFirstChildOfClass("UIGradient")
		if g then
			g.Color = Theme.buttonFace(color)
		end
	end
end

-- Progress bar: returns the frame and a setter (fraction 0..1, optional text).
function Theme.bar(props: { [string]: any }): (Frame, (number, string?) -> ())
	local color: Color3 = props.Color or Theme.Green
	local back = Theme.new("Frame", {
		Name = props.Name or "Bar",
		Size = props.Size or UDim2.fromOffset(200, 22),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = Theme.PanelDark,
		BorderSizePixel = 0,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	}, { Theme.corner(props.Corner or 8), Theme.stroke(props.Stroke or 2.5) })
	local clip = Theme.new("Frame", { Name = "Clip", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClipsDescendants = true, Parent = back }, { Theme.corner(props.Corner or 8) })
	local fill = Theme.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = clip,
	}, {
		Theme.corner(props.Corner or 8),
		Theme.new("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Theme.lighten(color, 0.45)),
				ColorSequenceKeypoint.new(0.5, color),
				ColorSequenceKeypoint.new(1, Theme.darken(color, 0.25)),
			}),
			Rotation = 90,
		}),
	})
	local label = Theme.text({ Name = "Text", Text = "", Size = UDim2.new(1, -8, 1, -2), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), MaxTextSize = props.TextSize or 16, Font = Theme.FontBold, Parent = back })
	label.ZIndex = 3
	local shown = -1
	local function set(frac: number, text: string?)
		frac = math.clamp(frac, 0, 1)
		if math.abs(frac - shown) > 0.002 then
			shown = frac
			TweenService:Create(fill, TweenInfo.new(0.12), { Size = UDim2.fromScale(frac, 1) }):Play()
		end
		if text and label.Text ~= text then
			label.Text = text
		end
	end
	return back, set
end

function Theme.setBarColor(bar: Frame, color: Color3)
	local fill = bar:FindFirstChild("Fill", true)
	local g = fill and fill:FindFirstChildOfClass("UIGradient")
	if g then
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Theme.lighten(color, 0.45)),
			ColorSequenceKeypoint.new(0.5, color),
			ColorSequenceKeypoint.new(1, Theme.darken(color, 0.25)),
		})
	end
end

-- Little red "!" badge on a button.
function Theme.badge(parent: GuiObject): Frame
	local f = Theme.new("Frame", {
		Name = "Badge",
		Size = UDim2.fromOffset(22, 22),
		Position = UDim2.new(1, -6, 0, -6),
		BackgroundColor3 = Theme.Red,
		Visible = false,
		ZIndex = 10,
		Parent = parent,
	}, { Theme.corner(11), Theme.stroke(2) })
	local t = Theme.text({ Text = "!", Parent = f })
	t.ZIndex = 11
	local pulse = Theme.new("UIScale", { Parent = f })
	TweenService:Create(pulse, TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.22 }):Play()
	return f
end

function Theme.pop(obj: GuiObject, amount: number?)
	local s = obj:FindFirstChildOfClass("UIScale") or Theme.new("UIScale", { Parent = obj })
	s.Scale = amount or 1.15
	TweenService:Create(s, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">Toasts</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Notifications (personal toasts) and the big centre banner (unlocks, events, announcements).
local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)
local Net = require(script.Parent.Parent.Net)
local Lang = require(script.Parent.Parent.Lang)

local Toasts = {}

local stack = Theme.new("Frame", {
	Name = "Toasts",
	BackgroundTransparency = 1,
	Size = if Root.isTouch then UDim2.fromOffset(400, 140) else UDim2.fromOffset(520, 220),
	Position = if Root.isTouch then UDim2.new(0.43, 0, 0.5, 0) else UDim2.new(0.5, 0, 0, 158),
	AnchorPoint = Vector2.new(0.5, 0),
	ZIndex = 40,
	Parent = Root.gui,
}, { Theme.list(Enum.FillDirection.Vertical, 6) })
Root.mount(stack)

local KIND_COLORS = {
	info = Theme.Blue,
	success = Theme.Green,
	error = Theme.Red,
}

local order = 0
local recent: { [string]: number } = {}
function Toasts.show(text: string, kind: string?, duration: number?)
	local now = os.clock()
	if recent[text] and now - recent[text] < 1.6 then
		return -- same message again: do not stack it
	end
	recent[text] = now
	order += 1
	local color = KIND_COLORS[kind or "info"] or Theme.Blue
	local f = Theme.new("Frame", {
		Size = if Root.isTouch then UDim2.fromOffset(380, 36) else UDim2.fromOffset(480, 40),
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = order,
		Parent = stack,
	}, { Theme.corner(12), Theme.stroke(3), Theme.gradient(Theme.lighten(color, 0.15), Theme.darken(color, 0.25)) })
	local sc = Theme.new("UIScale", { Scale = 0.5, Parent = f })
	Theme.text({ Text = text, Size = UDim2.new(1, -24, 1, -10), Position = UDim2.fromOffset(12, 5), MaxTextSize = 22, Parent = f })
	TweenService:Create(sc, TweenInfo.new(0.22, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	if kind == "error" then
		Theme.play("click", 0.4, 0.6)
	end
	task.delay(duration or 2.6, function()
		local t = TweenService:Create(sc, TweenInfo.new(0.2), { Scale = 0 })
		t:Play()
		t.Completed:Wait()
		f:Destroy()
	end)
	local frames = {}
	for _, c in stack:GetChildren() do
		if c:IsA("Frame") then
			table.insert(frames, c)
		end
	end
	if #frames > 4 then
		table.sort(frames, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		frames[1]:Destroy()
	end
end

-- Big banner
local banner = Theme.new("Frame", {
	Name = "Announce",
	Size = if Root.isTouch then UDim2.fromOffset(460, 52) else UDim2.fromOffset(620, 60),
	Position = if Root.isTouch then UDim2.new(0.43, 0, 0.4, 0) else UDim2.new(0.5, 0, 0, 100),
	AnchorPoint = Vector2.new(0.5, 0),
	BackgroundColor3 = Color3.new(1, 1, 1),
	Visible = false,
	ZIndex = 45,
	Parent = Root.gui,
}, { Theme.corner(14), Theme.stroke(4) })
Root.mount(banner).ClipsDescendants = false
local HIDDEN = UDim2.new(0.5, 0, 0.5, -140)
local SHOWN = UDim2.new(0.5, 0, 0.5, 0)
banner.Position = HIDDEN
local bannerGradient = Theme.new("UIGradient", { Rotation = 90, Parent = banner })
local bannerText = Theme.text({ Size = UDim2.new(1, -24, 1, -12), Position = UDim2.fromOffset(12, 6), MaxTextSize = 28, RichText = true, Stroke = 3, Parent = banner })
bannerText.ZIndex = 46
local queue: { { text: string, color: Color3 } } = {}
local busy = false
Toasts.bannersShown = 0

local function nextBanner()
	if busy or #queue == 0 then
		return
	end
	busy = true
	local item = table.remove(queue, 1)
	Toasts.bannersShown += 1
	bannerText.Text = item.text
	bannerGradient.Color = ColorSequence.new(Theme.lighten(item.color, 0.25), Theme.darken(item.color, 0.3))
	banner.Visible = true
	banner.Position = HIDDEN
	TweenService:Create(banner, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Position = SHOWN }):Play()
	Theme.play("land", 0.4, 1.4)
	task.delay(3.2, function()
		local t = TweenService:Create(banner, TweenInfo.new(0.25), { Position = HIDDEN })
		t:Play()
		t.Completed:Wait()
		banner.Visible = false
		busy = false
		nextBanner()
	end)
end

function Toasts.banner(text: string, color: Color3)
	table.insert(queue, { text = text, color = color })
	while #queue > 5 do
		table.remove(queue, 1)
	end
	nextBanner()
end

function Toasts.init()
	Net.event("Notify").OnClientEvent:Connect(function(message, kind)
		Toasts.show(Lang.msg(message), kind)
	end)
	Net.event("Toast").OnClientEvent:Connect(function(data)
		if type(data) == "table" and data.key then
			Toasts.banner(Lang.t(data.key, data.args), if data.color then Theme.rgb(data.color) else Theme.Orange)
		end
	end)
end

return Toasts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">TouchControls</string>
              <string name="Source"><![CDATA[--!nonstrict
-- On-screen combat buttons for phones and tablets. They sit in the right half of the screen,
-- around (never on top of) the Roblox jump button, and call the same Controls.* functions as
-- the keyboard. The thumbstick zone (bottom-left) is left completely free.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)
local Net = require(script.Parent.Parent.Net)
local Controls = require(script.Parent.Parent.Controls)
local Flight = require(script.Parent.Parent.Flight)

local TouchControls = {}
local new = Theme.new

type Btn = { frame: TextButton, cool: Frame, action: string }
local buttons: { [string]: Btn } = {}
TouchControls.buttons = buttons

-- Screen-space layout (fractions of the safe area). Jump button zone: x > 0.75, y > 0.65.
local LAYOUT = {
	punch = { 0.665, 0.835, 98 },
	block = { 0.555, 0.885, 64 },
	charge = { 0.575, 0.70, 64 },
	blast = { 0.72, 0.62, 70 },
	beam = { 0.83, 0.555, 70 },
	dash = { 0.94, 0.50, 64 },
	form = { 0.94, 0.355, 60 },
	fly = { 0.94, 0.215, 60 },
	down = { 0.845, 0.25, 54 },
	boost = { 0.755, 0.28, 54 },
	t_pulse_volley = { 0.845, 0.40, 56 },
	t_meteor_dive = { 0.745, 0.455, 56 },
	t_sunfall = { 0.645, 0.53, 56 },
}
TouchControls.LAYOUT = LAYOUT

local function button(name: string, icon: string, color: Color3): Btn
	local spec = LAYOUT[name]
	local size = spec[3]
	local b = new("TextButton", {
		Name = "Touch_" .. name,
		Size = UDim2.fromOffset(size, size),
		Position = UDim2.fromScale(spec[1], spec[2]),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(40, 40, 52),
		BackgroundTransparency = 0.45,
		AutoButtonColor = false,
		Text = "",
		Parent = Root.gui,
	}, {
		Theme.corner(size),
		Theme.stroke(3, Color3.fromRGB(245, 245, 255)),
	})
	-- thin coloured inner ring: which move this is, without a loud button
	new("Frame", { Name = "Tint", Size = UDim2.new(1, -10, 1, -10), Position = UDim2.fromOffset(5, 5), BackgroundColor3 = color, BackgroundTransparency = 0.72, BorderSizePixel = 0, Parent = b }, { Theme.corner(size) })
	Theme.text({ Text = icon, Stroke = false, Size = UDim2.fromScale(0.6, 0.6), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Parent = b }).ZIndex = 2
	local clip = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 3, Parent = b }, { Theme.corner(size) })
	local cool = new("Frame", { Name = "Cool", Size = UDim2.fromScale(1, 0), Position = UDim2.fromScale(0, 1), AnchorPoint = Vector2.new(0, 1), BackgroundColor3 = color, BackgroundTransparency = 0.35, BorderSizePixel = 0, ZIndex = 3, Parent = clip })
	local sc = new("UIScale", { Parent = b })
	b.MouseButton1Down:Connect(function()
		sc.Scale = 0.9
	end)
	b.MouseButton1Up:Connect(function()
		sc.Scale = 1
	end)
	b.MouseLeave:Connect(function()
		sc.Scale = 1
	end)
	Root.mount(b)
	local entry = { frame = b, cool = cool, action = name }
	buttons[name] = entry
	return entry
end

local function hold(b: Btn, down: () -> (), up: () -> ())
	b.frame.MouseButton1Down:Connect(down)
	b.frame.MouseButton1Up:Connect(up)
	b.frame.MouseLeave:Connect(up)
end

function TouchControls.init()
	if not Root.isTouch then
		return
	end
	local punch = button("punch", "👊", Theme.Red)
	local punching = false
	hold(punch, function()
		punching = true
		Controls.punch()
	end, function()
		punching = false
	end)
	button("blast", "🔵", Theme.Cyan).frame.MouseButton1Down:Connect(Controls.blast)
	hold(button("beam", "☄️", Theme.Blue), Controls.beamBegin, Controls.beamEnd)
	hold(button("block", "🛡️", Theme.Green), function()
		Controls.block(true)
	end, function()
		Controls.block(false)
	end)
	hold(button("charge", "🔋", Theme.Purple), function()
		Controls.charge(true)
	end, function()
		Controls.charge(false)
	end)
	button("dash", "💨", Theme.Yellow).frame.MouseButton1Down:Connect(Controls.dash)
	button("form", "🔥", Theme.Orange).frame.Activated:Connect(function()
		Controls.transform()
	end)
	button("fly", "🕊️", Theme.Pink).frame.Activated:Connect(Controls.toggleFly)
	local down = button("down", "⬇️", Theme.Grey)
	hold(down, function()
		Flight.descend = true
	end, function()
		Flight.descend = false
	end)
	local boost = button("boost", "🚀", Theme.Grey)
	boost.frame.Activated:Connect(function()
		Flight.boost = not Flight.boost
		local tint = boost.frame:FindFirstChild("Tint") :: Frame
		tint.BackgroundColor3 = if Flight.boost then Theme.Yellow else Theme.Grey
		tint.BackgroundTransparency = if Flight.boost then 0.35 else 0.72
	end)
	for _, t in Config.Techniques do
		local b = button("t_" .. t.id, t.icon, Theme.Purple)
		b.frame.MouseButton1Down:Connect(function()
			Controls.technique(t.id)
		end)
	end

	local function refresh()
		local flying = Flight.active
		local downHolder: any, boostHolder: any = down.frame.Parent, boost.frame.Parent
		downHolder.Visible = flying
		boostHolder.Visible = flying
		local owned = Net.get("techniques") or {}
		for _, t in Config.Techniques do
			local holder: any = buttons["t_" .. t.id].frame.Parent
			holder.Visible = owned[t.id] == true
		end
	end
	Flight.Changed:Connect(refresh)
	Net.Changed:Connect(function(kind)
		if kind == "full" then
			refresh()
		end
	end)
	refresh()

	RunService.RenderStepped:Connect(function()
		local now = os.clock()
		if punching and (Controls.nextAt.melee or 0) <= now then
			Controls.punch()
		end
		for name, b in buttons do
			local action = if name == "punch" then "melee" else name
			local total = Controls.cooldownOf[action]
			if total then
				b.cool.Size = UDim2.fromScale(1, math.clamp(((Controls.nextAt[action] or 0) - now) / total, 0, 1))
			end
		end
	end)
end

return TouchControls
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Windows</string>
              <string name="Source"><![CDATA[--!strict
-- Window manager: one modal window at a time, pop-in animation, shared chrome (shadow,
-- glossy header, icon medallion, close button) and a dim layer over the world.
local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)
local Lang = require(script.Parent.Parent.Lang)

local Windows = {}

export type Window = {
	name: string,
	frame: Frame,
	body: Frame,
	onOpen: (() -> ())?,
	onClose: (() -> ())?,
}

local windows: { [string]: Window } = {}
local current: string? = nil
local changed = Instance.new("BindableEvent")
Windows.Changed = changed.Event

-- Dim layer between the world and the HUD while a window is open. It lives in its own
-- full-screen ScreenGui below the main UI, so the HUD stays bright and clickable (you can
-- jump straight to another window). Clicking the dim closes the window.
local dimGui = Theme.new("ScreenGui", {
	Name = "KiWarriorsDim",
	ResetOnSpawn = false,
	ScreenInsets = Enum.ScreenInsets.None,
	DisplayOrder = -1,
	Parent = Root.gui.Parent,
}) :: ScreenGui
local dim = Theme.new("TextButton", {
	Name = "Dim",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.fromRGB(18, 12, 34),
	BackgroundTransparency = 1,
	Text = "",
	AutoButtonColor = false,
	Visible = false,
	Parent = dimGui,
}) :: TextButton

local function setDim(on: boolean)
	if on then
		dim.Visible = true
		TweenService:Create(dim, TweenInfo.new(0.18), { BackgroundTransparency = 0.5 }):Play()
	else
		local t = TweenService:Create(dim, TweenInfo.new(0.15), { BackgroundTransparency = 1 })
		t:Play()
		t.Completed:Once(function()
			if current == nil then
				dim.Visible = false
			end
		end)
	end
end

-- Creates window chrome and returns it; the caller fills `body`. titleKey is a translation key.
function Windows.create(name: string, icon: string, titleKey: string, color: Color3, size: Vector2?): Window
	local sz = size or Vector2.new(720, 470)
	local frame = Theme.panel({
		Name = name .. "Window",
		Size = UDim2.fromOffset(sz.X, sz.Y),
		Position = UDim2.fromScale(0.5, 0.52),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		ZIndex = 20,
		Parent = Root.gui,
		Corner = 22,
		StrokeThickness = 4,
	})
	Theme.new("UIScale", { Parent = frame })
	Root.mount(frame)
	Theme.shadow(frame, 22)
	local header = Theme.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 21,
		Parent = frame,
	}, { Theme.corner(22), Theme.gradient(Theme.lighten(color, 0.3), color) })
	-- square off the header's bottom corners
	Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.new(0, 0, 1, -22),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 21,
		Parent = header,
	}, { Theme.gradient(Theme.lighten(color, 0.04), Theme.darken(color, 0.08)) })
	Theme.gloss(header, 22, 0.82)
	-- dark rule under the header
	Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 4),
		Position = UDim2.new(0, 0, 1, -2),
		BackgroundColor3 = Theme.Ink,
		BorderSizePixel = 0,
		ZIndex = 22,
		Parent = header,
	})
	-- icon medallion poking out of the top-left corner
	local medal = Theme.new("Frame", {
		Name = "Medal",
		Size = UDim2.fromOffset(70, 70),
		Position = UDim2.fromOffset(-16, -18),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 23,
		Parent = frame,
	}, { Theme.corner(35), Theme.stroke(4), Theme.gradient(Theme.White, Theme.lighten(color, 0.55)) })
	local medalIcon = Theme.text({ Text = icon, Stroke = false, Size = UDim2.fromScale(0.66, 0.66), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Parent = medal })
	medalIcon.ZIndex = 24
	local titleLabel = Theme.text({
		Text = "",
		Size = UDim2.new(1, -210, 0, 42),
		Position = UDim2.new(0, 68, 0, 7),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 36,
		Stroke = 3,
		Parent = header,
	})
	titleLabel.ZIndex = 22
	local function setTitle()
		titleLabel.Text = Lang.t(titleKey)
	end
	setTitle()
	Lang.Changed:Connect(setTitle)
	local close = Theme.button({
		Text = "X",
		Color = Theme.Red,
		Size = UDim2.fromOffset(56, 56),
		Position = UDim2.new(1, 16, 0, -16),
		AnchorPoint = Vector2.new(1, 0),
		Corner = 28,
		Parent = frame,
		OnClick = function()
			Windows.close()
		end,
	})
	close.ZIndex = 30
	for _, d in close:GetDescendants() do
		if d:IsA("GuiObject") then
			d.ZIndex = 31
		end
	end
	local body = Theme.new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -28, 1, -76),
		Position = UDim2.new(0, 14, 0, 64),
		ZIndex = 21,
		Parent = frame,
	}) :: Frame
	local w: Window = { name = name, frame = frame, body = body }
	windows[name] = w
	return w
end

function Windows.isOpen(name: string): boolean
	return current == name
end

function Windows.close()
	if not current then
		return
	end
	local w = windows[current]
	current = nil
	if w then
		local s = w.frame:FindFirstChildOfClass("UIScale") :: UIScale
		local t = TweenService:Create(s, TweenInfo.new(0.12), { Scale = 0.85 })
		t:Play()
		t.Completed:Once(function()
			if current ~= w.name then
				w.frame.Visible = false
			end
		end)
		if w.onClose then
			w.onClose()
		end
	end
	setDim(false)
	changed:Fire(nil)
end

function Windows.open(name: string)
	if current == name then
		return
	end
	if current then
		local prev = windows[current]
		if prev then
			prev.frame.Visible = false
			if prev.onClose then
				prev.onClose()
			end
		end
	end
	local w = windows[name]
	if not w then
		return
	end
	current = name
	local s = w.frame:FindFirstChildOfClass("UIScale") :: UIScale
	s.Scale = 0.6
	w.frame.Visible = true
	TweenService:Create(s, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	setDim(true)
	Theme.play("open", 0.3)
	if w.onOpen then
		w.onOpen()
	end
	changed:Fire(name)
end

function Windows.toggle(name: string)
	if current == name then
		Windows.close()
	else
		Windows.open(name)
	end
end

dim.Activated:Connect(function()
	Windows.close()
end)

return Windows
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">WorldFx</string>
            <string name="Source"><![CDATA[--!nonstrict
-- World presentation on the client: per-planet sky and lighting (tweened when you travel),
-- animated props (parts tagged with the KiwAnim attribute by the WorldBuilder), localized
-- signs / prompts, and prompt routing. Post-processing is an extra on top: the planets are
-- coloured to read without it.
local Lighting = game:GetService("Lighting")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(script.Parent.Net)
local Lang = require(script.Parent.Lang)
local Fx = require(script.Parent.Fx)

local WorldFx = {}

local function c(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local SKIES = {
	meadow = { clock = 13.6, brightness = 2.1, ambient = c(120, 130, 150), outdoor = c(150, 160, 175), top = c(255, 250, 235), fog = c(190, 225, 255), density = 0.26, haze = 1.2, stars = 0, tint = c(255, 255, 255), sat = 0.18 },
	volcano = { clock = 17.75, brightness = 2.2, ambient = c(140, 84, 70), outdoor = c(170, 100, 80), top = c(255, 160, 90), fog = c(255, 140, 90), density = 0.34, haze = 2.2, stars = 0, tint = c(255, 236, 224), sat = 0.2 },
	ice = { clock = 8.2, brightness = 2.4, ambient = c(130, 150, 190), outdoor = c(160, 185, 220), top = c(230, 245, 255), fog = c(210, 235, 255), density = 0.3, haze = 1.4, stars = 0, tint = c(236, 246, 255), sat = 0.1 },
	storm = { clock = 18.4, brightness = 1.9, ambient = c(110, 110, 160), outdoor = c(130, 130, 190), top = c(190, 190, 255), fog = c(150, 140, 210), density = 0.36, haze = 2, stars = 1500, tint = c(236, 232, 255), sat = 0.12 },
	void = { clock = 0.3, brightness = 1.6, ambient = c(90, 64, 150), outdoor = c(110, 80, 180), top = c(200, 140, 255), fog = c(60, 30, 110), density = 0.3, haze = 1.6, stars = 5000, tint = c(240, 226, 255), sat = 0.2 },
}

local atmosphere: Atmosphere
local sky: Sky
local grade: ColorCorrectionEffect
local current: string? = nil

local function applySky(theme: string, instant: boolean?)
	local s = SKIES[theme] or SKIES.meadow
	if current == theme then
		return
	end
	current = theme
	local time = if instant then 0 else 1.2
	local info = TweenInfo.new(time, Enum.EasingStyle.Sine)
	TweenService:Create(Lighting, info, { ClockTime = s.clock, Brightness = s.brightness, Ambient = s.ambient, OutdoorAmbient = s.outdoor, ColorShift_Top = s.top }):Play()
	TweenService:Create(atmosphere, info, { Color = s.fog, Decay = s.fog:Lerp(Color3.new(0, 0, 0), 0.3), Density = s.density, Haze = s.haze }):Play()
	TweenService:Create(grade, info, { TintColor = s.tint, Saturation = s.sat }):Play()
	sky.StarCount = s.stars
end

function WorldFx.themeOf(planet: number): string
	local pl = Config.Planets[planet]
	return if pl then pl.theme else "meadow"
end

---------------------------------------------------------------------------
-- Animated props
---------------------------------------------------------------------------
type Prop = { part: BasePart, kind: string, base: CFrame, size: Vector3, phase: number, amp: number, segs: { BasePart }?, radius: number?, shown: boolean? }
local RING_SEGMENTS = 18
local ringFolder = Instance.new("Folder")
ringFolder.Name = "KiwRings"
ringFolder.Parent = workspace

local function buildRing(p: Prop)
	local radius = p.part:GetAttribute("KiwRadius") or 8
	local thick = p.part:GetAttribute("KiwThick") or 0.8
	local segs = {}
	local n = if Fx.lite then 12 else RING_SEGMENTS
	local len = 2 * math.pi * radius / n * 1.08
	for _ = 1, n do
		local seg = Instance.new("Part")
		seg.Anchored = true
		seg.CanCollide = false
		seg.CanQuery = false
		seg.CanTouch = false
		seg.CastShadow = false
		seg.Material = Enum.Material.Neon
		seg.Color = p.part.Color
		seg.Size = Vector3.new(len, thick, thick)
		seg.Parent = ringFolder
		table.insert(segs, seg)
	end
	p.segs = segs
	p.radius = radius
end

local function placeRing(p: Prop, frame: CFrame)
	local segs = p.segs :: { BasePart }
	local n = #segs
	local r = p.radius :: number
	for i, seg in segs do
		local a = i / n * math.pi * 2
		seg.CFrame = frame * CFrame.new(math.cos(a) * r, 0, math.sin(a) * r) * CFrame.Angles(0, -a + math.pi / 2, 0)
	end
end
local props: { [BasePart]: Prop } = {}

local function track(inst: Instance)
	if inst:IsA("BasePart") then
		local kind = inst:GetAttribute("KiwAnim")
		if kind and not props[inst] then
			local p: Prop = { part = inst, kind = kind, base = inst.CFrame, size = inst.Size, phase = inst:GetAttribute("KiwPhase") or 0, amp = inst:GetAttribute("KiwAmp") or 1 }
			props[inst] = p
			if kind == "ring" then
				buildRing(p)
				placeRing(p, p.base)
			end
		end
	end
end

local function animate(now: number, camPos: Vector3)
	local range = if Fx.lite then 260 else 480
	for part, p in props do
		if not part.Parent then
			if p.segs then
				for _, seg in p.segs do
					seg:Destroy()
				end
			end
			props[part] = nil
			continue
		end
		if (p.base.Position - camPos).Magnitude > range then
			continue
		end
		local t = now + p.phase
		local kind = p.kind
		if kind == "ring" then
			placeRing(p, CFrame.new(p.base.Position) * CFrame.Angles(math.sin(t * 0.7) * 0.55, t * 0.6, math.cos(t * 0.5) * 0.55))
		elseif kind == "bob" then
			part.CFrame = p.base + Vector3.new(0, math.sin(t * 1.4) * 0.8 * p.amp, 0)
		elseif kind == "spin" then
			part.CFrame = p.base * CFrame.Angles(t * 0.9, 0, 0)
		elseif kind == "spinbob" then
			part.CFrame = (p.base + Vector3.new(0, math.sin(t * 1.2) * 1.2, 0)) * CFrame.Angles(0, t * 0.8, 0)
		elseif kind == "orbit" then
			part.CFrame = CFrame.new(p.base.Position) * CFrame.Angles(math.sin(t * 0.7) * 0.5, t * 0.6, math.cos(t * 0.5) * 0.5) * CFrame.Angles(0, 0, math.rad(90))
		elseif kind == "pulse" then
			part.Size = p.size * (1 + math.sin(t * 3) * 0.08)
		elseif kind == "flag" then
			part.CFrame = p.base * CFrame.Angles(0, math.sin(t * 2.4) * 0.22, 0)
		elseif kind == "flame" then
			part.Size = p.size * Vector3.new(1 + math.sin(t * 9) * 0.08, 1 + math.sin(t * 7) * 0.16, 1 + math.cos(t * 8) * 0.08)
		elseif kind == "water" then
			part.Transparency = 0.12 + math.sin(t * 5) * 0.06
		elseif kind == "clock" then
			part.CFrame = p.base * CFrame.Angles(0, 0, -t * 1.5)
		end
	end
end

---------------------------------------------------------------------------
-- Localized world text + prompts
---------------------------------------------------------------------------
local labels: { [TextLabel]: boolean } = {}
local prompts: { [ProximityPrompt]: boolean } = {}
local function renderLabel(l: TextLabel)
	local key = l:GetAttribute("LocKey")
	if key then
		l.Text = Lang.t(key, { n = l:GetAttribute("LocN") })
	end
end
local function renderPrompt(p: ProximityPrompt)
	local a, o = p:GetAttribute("LocAction"), p:GetAttribute("LocObject")
	if a then
		p.ActionText = Lang.t(a)
	end
	if o then
		p.ObjectText = Lang.t(o)
	end
end
local function trackText(inst: Instance)
	if inst:IsA("TextLabel") and inst:GetAttribute("LocKey") then
		labels[inst] = true
		renderLabel(inst)
	elseif inst:IsA("ProximityPrompt") then
		prompts[inst] = true
		renderPrompt(inst)
	end
end

-- prompt name -> callback (windows register here)
WorldFx.onPrompt = {} :: { [string]: () -> () }

function WorldFx.init()
	-- lighting rig (all built-in; nothing here is required for the game to read well)
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Offset = 0.1
	atmosphere.Glare = 0.2
	atmosphere.Parent = Lighting
	sky = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky")
	sky.CelestialBodiesShown = true
	sky.SunAngularSize = 16
	sky.MoonAngularSize = 14
	sky.Parent = Lighting
	grade = Instance.new("ColorCorrectionEffect")
	grade.Contrast = 0.06
	grade.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.3
	bloom.Size = 22
	bloom.Threshold = 1.7
	bloom.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.6
	rays.Parent = Lighting
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.GeographicLatitude = 28
	Lighting.ExposureCompensation = -0.12

	applySky(WorldFx.themeOf(Net.get("planet") or 1), true)
	Net.Changed:Connect(function(kind)
		if kind == "full" then
			applySky(WorldFx.themeOf(Net.get("planet") or 1))
		end
	end)

	task.spawn(function()
		local world = workspace:WaitForChild("World")
		world.DescendantAdded:Connect(function(d)
			track(d)
			trackText(d)
		end)
		world.DescendantRemoving:Connect(function(d)
			labels[d] = nil
			prompts[d] = nil
		end)
		for _, d in world:GetDescendants() do
			track(d)
			trackText(d)
		end
	end)
	Lang.Changed:Connect(function()
		for l in labels do
			renderLabel(l)
		end
		for p in prompts do
			renderPrompt(p)
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local cb = WorldFx.onPrompt[prompt.Name]
		if cb then
			cb()
		end
	end)

	RunService.Heartbeat:Connect(function()
		local cam = workspace.CurrentCamera
		if cam then
			animate(os.clock(), cam.CFrame.Position)
		end
	end)
end

return WorldFx
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="50">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-400</float>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <token name="StreamOutBehavior">2</token>
      <bool name="StreamingEnabled">true</bool>
      <int name="StreamingMinRadius">320</int>
      <int name="StreamingTargetRadius">900</int>
    </Properties>
  </Item>
</roblox>