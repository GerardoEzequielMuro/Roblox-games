Config.QuestBonusGems = 15

---------------------------------------------------------------------------
-- Rewards
---------------------------------------------------------------------------
-- kinds: sparks (minutes of income), gems, boost (minutes of x2 training), spins (aura spins)
Config.DailyRewards = {
