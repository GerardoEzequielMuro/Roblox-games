      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Quests</string>
          <string name="Source"><![CDATA[--!strict
-- Daily quests (pure; unit-tested with luau.exe). Everyone gets the same quest kinds on a
-- given UTC day; targets scale with the player's best planet.
local Config: any = if script then require(script.Parent.Config) :: any else (require :: any)("./Config")

local Quests = {}

export type Quest = { kind: string, target: number, gems: number }

function Quests.today(now: number): number
	return now // 86400
end

function Quests.resetsAt(now: number): number
	return (now // 86400 + 1) * 86400
end

function Quests.forDay(day: number, planet: number?): { Quest }
	local pool = Config.QuestPool
	local order = {}
	for i = 1, #pool do
		order[i] = i
	end
	-- Park-Miller PRNG (pure Luau, so the standalone tests get the same picks as Roblox)
	local seed = (math.floor(day) % 2147483646) + 1
	local function nextInt(n: number): number
		seed = (seed * 16807) % 2147483647
		return seed % n + 1
	end
	nextInt(1)
	for i = #order, 2, -1 do
		local j = nextInt(i)
		order[i], order[j] = order[j], order[i]
	end
	local z = math.clamp(planet or 1, 1, #Config.Planets)
	local out: { Quest } = {}
	for k = 1, math.min(Config.QuestsPerDay, #pool) do
		local def = pool[order[k]]
		table.insert(out, { kind = def.kind, target = def.targetByPlanet[math.min(z, #def.targetByPlanet)], gems = def.gems })
	end
	return out
end

return Quests
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Referral</string>
          <string name="Source"><![CDATA[--!strict
-- Referral launch data ("ref:<inviterUserId>"). Pure; unit-tested with luau.exe.
local Referral = {}

function Referral.launchData(userId: number): string
	return "ref:" .. tostring(math.floor(userId))
end

-- Inviter user id from a join's LaunchData, or nil.
function Referral.parse(launchData: any): number?
	if type(launchData) ~= "string" or #launchData > 40 then
		return nil
	end
	local digits = launchData:match("^ref:(%d+)$")
	local n = if digits then tonumber(digits) else nil
	if n and n > 0 then
		return n
	end
	return nil
end

return Referral
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="27">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="28">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="29">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Ki Warriors: server bootstrap.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)

local Services = script.Parent.Services
local WorldBuilder = require(script.Parent.World.WorldBuilder)
local Data = require(Services.Data)
local Remotes = require(Services.Remotes)
local State = require(Services.State)
local Fighters = require(Services.Fighters)
local Combat = require(Services.Combat)
local Training = require(Services.Training)
local Npcs = require(Services.Npcs)
local Auto = require(Services.Auto)
local Progression = require(Services.Progression)

local world = WorldBuilder.build()

State.start()
Fighters.init()
Combat.init()
Training.init()
Npcs.init()
Auto.init()
Progression.init()
-- Optional services (added round by round); each one exposes init(world).
for _, name in { "Arena", "Rewards", "Story", "QuestService", "Relics", "Auras", "WorldBoss", "LiveEventService", "Monetization", "Leaderboard", "Offline", "Social", "Guard" } do
	local module = Services:FindFirstChild(name)
	if module then
		local service = (require :: any)(module)
		service.init(world)
	end
end
Data.startAutosave()

Remotes.handle("GetState", function(player)
	if not State.ready[player] then
		return false, "loading"
	end
	return true, State.snapshot(player)
end)

-- Language preference ("" = follow the Roblox account locale).
Remotes.handle("SetLanguage", function(player, payload)
	local p = Data.get(player)
	local code = payload.lang
	if not p or type(code) ~= "string" or (code ~= "" and not Locale.Supported[code]) then
		return false, Locale.m("msg.unknown_language")
	end
	p.lang = code
	State.dirty(player)
	return true
end)

local function optional(name: string): any
	local module = Services:FindFirstChild(name)
	return if module then (require :: any)(module) else nil
end

local function onCharacter(player: Player, char: Model)
	local f = Fighters.addPlayer(player)
	Fighters.bindCharacter(f, char)
	local p = Data.get(player)
	if p and State.ready[player] then
		char:SetAttribute("Race", p.race)
		char:SetAttribute("Aura", p.auraEquipped)
		char:SetAttribute("Rebirths", p.rebirths)
		char:SetAttribute("VIP", State.owns(player, "VIP"))
		Training.applyMovement(player)
		Progression.placeOnSpawn(player)
	end
end

local function onPlayerAdded(player: Player)
	State.init(player)
	Fighters.addPlayer(player)
	player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)
	Data.load(player)
	if not player.Parent then
		Data.release(player)
		return
	end
	local Monetization = optional("Monetization")
	if Monetization then
		Monetization.loadPasses(player)
	end
	for _, name in { "Offline", "QuestService", "Story" } do
		local s = optional(name)
		if s and s.onJoin then
			s.onJoin(player)
		end
	end
	State.ready[player] = true
	for _, name in { "Social", "LiveEventService", "Leaderboard", "Arena", "WorldBoss", "Auras" } do
		local s = optional(name)
		if s and s.onReady then
			s.onReady(player)
		end
	end
	Combat.refreshForms(player)
	State.sendFull(player)
	if player.Character then
		onCharacter(player, player.Character)
	end
	if not Data.isPersistent(player) then
		Remotes.notify(player, Locale.m("msg.no_save"), "error")
	end
end

local function onPlayerRemoving(player: Player)
	Data.release(player)
	State.cleanup(player)
	Remotes.forget(player)
	Training.forget(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="30">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Arena</string>
            <string name="Source"><![CDATA[--!strict
-- PvP: only inside the Sky Coliseum. Everywhere else players cannot hurt each other.
--   * new-player protection (play time / power), which the player can switch off
--   * rating (win / loss, no farming the same victim), kills pay Sparks from the system
--   * Arena Rush: a short tournament window on a UTC schedule; top 3 scores get Gems
-- Installs Fighters.pvpRule and Fighters.onPlayerKill.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Format = require(ReplicatedStorage.Shared.Format)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Hooks = require(script.Parent.Hooks)
local Fighters = require(script.Parent.Fighters)
local M = Locale.m

type Fighter = Fighters.Fighter
local P = Config.Pvp

local Arena = {}

local center = Vector3.zero
local lastKill: { [string]: number } = {} -- "killerId>victimKey" -> os.clock()
local rushScores: { [Player]: number } = {}
local rushOverride: number? = nil -- test / admin: rush active until this os.time()
local rushWasActive = false
local rushEndsAt = 0

function Arena.inside(pos: Vector3): boolean
	local d = (pos - center) * Vector3.new(1, 0, 1)
	return d.Magnitude <= Config.Arena.radius and pos.Y < center.Y + 140 and pos.Y > center.Y - 20
end

-- New players are shielded until they have played a while or grown past a power level.
function Arena.protected(f: Fighter): boolean
	if f.dummy then
		return f.protected == true
	end
	local player = f.player
	local p = player and Data.get(player)
	if not p then
		return true
	end
	if p.protectionOff then
		return false
	end
	return p.playTime < P.protectSeconds and math.max(State.power(p), p.bestPower) < P.protectPower
end

function Arena.rushActive(now: number): (boolean, number)
	if rushOverride and rushOverride > now then
		return true, rushOverride
	end
	local r = P.rush
	local phase = (now - r.offset) % r.every
	if phase < r.duration then
		return true, now - phase + r.duration
	end
	return false, now - phase + r.every
end

local function victimKey(v: Fighter): string
	return if v.player then tostring(v.player.UserId) else "d:" .. tostring(v.dname)
end

local function payload(): { [string]: any }
	local now = os.time()
	local active, at = Arena.rushActive(now)
	local top = {}
	for player, score in rushScores do
		table.insert(top, { name = player.DisplayName, id = player.UserId, score = score })
	end
	table.sort(top, function(a, b)
		return a.score > b.score
	end)
	while #top > 5 do
		table.remove(top)
	end
	return { rush = active, at = at, top = top, serverTime = now }
end

local function broadcast()
	Remotes.fireAll("Arena", payload())
end

local function endRush()
	local list = {}
	for player, score in rushScores do
		if player.Parent and score >= P.rush.minScore then
			table.insert(list, { player = player, score = score })
		end
	end
	table.sort(list, function(a, b)
		return a.score > b.score
	end)
	for i, entry in list do
		local prize = P.rush.prizes[i]
		if not prize then
			break
		end
		State.addGems(entry.player, prize.gems)
		Remotes.notify(entry.player, M("msg.rush_prize", { place = i, n = prize.gems }), "success")
	end
	if list[1] then
		Remotes.fireAll("Toast", { key = "toast.rush_winner", args = { player = list[1].player.DisplayName, score = list[1].score }, color = { 230, 70, 70 } })
	end
	table.clear(rushScores)
end

-- Test / admin: run a Rush for `seconds` starting now.
function Arena.forceRush(_player: Player?, seconds: number?): boolean
	rushOverride = os.time() + (seconds or 60)
	return true
end

function Arena.endRushNow(_player: Player?): boolean
	rushOverride = nil
	if rushWasActive then
		rushWasActive = false
		endRush()
		broadcast()
	end
	return true
end

local function onKill(killer: Fighter, victim: Fighter)
	local kp = killer.player and Data.get(killer.player)
	local vp = victim.player and Data.get(victim.player)
	local now = os.clock()
	local key = (if killer.player then tostring(killer.player.UserId) else "d:" .. tostring(killer.dname)) .. ">" .. victimKey(victim)
	local fresh = now - (lastKill[key] or -1e9) >= P.repeatKillSeconds
	lastKill[key] = now
	if vp and victim.player then
		vp.pvp.deaths += 1
		if fresh then
			vp.pvp.rating = math.max(P.minRating, vp.pvp.rating - P.lossRating)
		end
		State.dirty(victim.player)
		Remotes.notify(victim.player, M("msg.arena_lost", { player = if killer.player then killer.player.DisplayName else tostring(killer.dname) }), "error")
	end
	if kp and killer.player then
		kp.pvp.kills += 1
		local gained = 0
		if fresh then
			kp.pvp.rating += P.winRating
			gained = State.addSparks(killer.player, State.sparksForMinutes(kp, P.killSparkMinutes), false)
			local active = Arena.rushActive(os.time())
			if active then
				rushScores[killer.player] = (rushScores[killer.player] or 0) + 1
				broadcast()
			end
		end
		Hooks.fire("arenaWin", killer.player, fresh)
		State.dirty(killer.player)
		Remotes.fire("Combat", killer.player, "arenaKill", {
			name = if victim.player then victim.player.DisplayName else tostring(victim.dname),
			rating = kp.pvp.rating,
			sparks = gained,
			fresh = fresh,
		})
	end
	Remotes.fireAll("Fx", "ko", { p = Fighters.position(victim), u = if victim.player then victim.player.UserId else 0 })
end

function Arena.onReady(player: Player)
	Remotes.fire("Arena", player, payload())
end

function Arena.init(world: { [string]: any })
	center = world.arenaCenter or Vector3.zero

	Fighters.pvpRule = function(a: Fighter, v: Fighter): boolean
		if not a.inArena or not v.inArena then
			return false
		end
		return not Arena.protected(a) and not Arena.protected(v)
	end
	Fighters.onPlayerKill = onKill

	State.extras.arena = function(player, p)
		local f = Fighters.ofPlayer(player)
		return {
			protected = if f then Arena.protected(f) else true,
			protectionLeft = math.max(0, P.protectSeconds - p.playTime),
			protectPower = P.protectPower,
		}
	end

	Remotes.handle("SetProtection", function(player, payload)
		local p = Data.get(player)
		if not p or type(payload.off) ~= "boolean" then
			return false, M("msg.bad_request")
		end
		local f = Fighters.ofPlayer(player)
		if f and f.inArena and not payload.off then
			return false, M("msg.leave_arena_first")
		end
		p.protectionOff = payload.off
		State.dirty(player)
		return true
	end)

	-- who is inside (5 Hz) + rush window
	task.spawn(function()
		local acc = 0
		while true do
			task.wait(0.2)
			acc += 0.2
			for _, f in Fighters.list do
				if f.kind == "player" then
					local pos = Fighters.position(f)
					local inside = pos ~= nil and f.alive and Arena.inside(pos)
					if inside ~= f.inArena then
						f.inArena = inside
						Fighters.setAttr(f, "InArena", inside)
						local player = f.player
						if player then
							State.dirty(player)
							if inside then
								if Arena.protected(f) then
									Remotes.notify(player, M("msg.arena_protected", { power = Format.abbrev(P.protectPower) }), "info")
								else
									Remotes.notify(player, M("msg.arena_enter"), "error")
								end
							else
								Remotes.notify(player, M("msg.arena_leave"), "success")
							end
						end
					end
				end
			end
			if acc >= 1 then
				acc = 0
				local active, at = Arena.rushActive(os.time())
				if active ~= rushWasActive then
					rushWasActive = active
					if active then
						rushEndsAt = at
						table.clear(rushScores)
						Remotes.fireAll("Toast", { key = "toast.rush_start", color = { 230, 70, 70 } })
					else
						endRush()
					end
					broadcast()
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		rushScores[player] = nil
	end)
	local _ = rushEndsAt
end

return Arena
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Auras</string>
            <string name="Source"><![CDATA[--!strict
-- Auras: a spin with published odds (Config.Auras weights = percent, they add up to 100),
-- equipping, and the paid-random-items policy check. A spin always gives an aura. Spins cost
-- a banked free spin, the free daily spin, or Gems; the Gems path and the Lucky Aura pass are
-- unavailable where PolicyService says paid random items are restricted.
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Hooks = require(script.Parent.Hooks)
local M = Locale.m

local Auras = {}

local rng = Random.new()

local function today(): number
	return os.time() // 86400
end

local function lucky(player: Player): boolean
	return State.owns(player, "LuckyAura") and not State.randomRestricted[player]
end

function Auras.give(player: Player, id: string)
	local p = Data.get(player)
	if p and Config.AuraById[id] then
		p.auras[id] = (p.auras[id] or 0) + 1
		State.dirty(player)
	end
end

local function equip(player: Player, p: Data.Profile, id: string)
	p.auraEquipped = id
	local char = player.Character
	if char then
		char:SetAttribute("Aura", id)
	end
	State.dirty(player)
end

-- Test hook: mark the player as living where paid random items are restricted.
function Auras.setRestricted(player: Player, restricted: boolean): boolean
	State.randomRestricted[player] = restricted
	State.dirty(player)
	return true
end

function Auras.onReady(player: Player)
	task.spawn(function()
		local ok, info = pcall(function()
			return PolicyService:GetPolicyInfoForPlayerAsync(player)
		end)
		if ok and type(info) == "table" and info.ArePaidRandomItemsRestricted == true then
			State.randomRestricted[player] = true
			State.dirty(player)
		end
	end)
end

function Auras.init()
	State.extras.auraSpin = function(player, p)
		return {
			odds = Formulas.auraOdds(lucky(player)),
			freeToday = p.freeSpinDay ~= today(),
			cost = Config.AuraSpin.gems,
			lucky = lucky(player),
		}
	end

	Remotes.handle("SpinAura", function(player, payload)
		local p = Data.get(player)
		if not p then
			return false, M("msg.error")
		end
		local paid = payload.paid == true
		if paid then
			if State.randomRestricted[player] then
				return false, M("msg.spin_restricted")
			end
			if not State.spendGems(player, Config.AuraSpin.gems) then
				return false, M("msg.need_gems")
			end
		elseif p.freeSpinDay ~= today() then
			p.freeSpinDay = today()
		elseif p.spins > 0 then
			p.spins -= 1
		else
			return false, M("msg.no_spins")
		end
		local id = Formulas.rollAura(rng:NextNumber(), lucky(player))
		local isNew = p.auras[id] == nil
		p.auras[id] = (p.auras[id] or 0) + 1
		-- first aura ever (or a better one than the equipped): equip it
		local cur = Config.AuraById[p.auraEquipped]
		local got = Config.AuraById[id]
		if not cur or got.mult > cur.mult then
			equip(player, p, id)
		end
		Hooks.fire("auraSpin", player, id)
		local rarity = Config.RarityByName[got.rarity]
		if rarity.order >= 5 then
			Remotes.fireAll("Toast", { key = "toast.aura_rare", args = { player = player.DisplayName, aura = { key = "aura." .. id }, rarity = { key = "rarity." .. got.rarity } }, color = rarity.color })
		end
		State.dirty(player)
		return true, { id = id, new = isNew, rarity = got.rarity }
	end)

	Remotes.handle("EquipAura", function(player, payload)
		local p = Data.get(player)
		local id = payload.id
		if not p or type(id) ~= "string" then
			return false, M("msg.bad_request")
		end
		if id ~= "" and not p.auras[id] then
			return false, M("msg.not_owned")
		end
		equip(player, p, id)
		return true
	end)
end

return Auras
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Auto</string>
            <string name="Source"><![CDATA[--!strict
-- Server-driven helpers: auto-charge (refills ki while standing still) and auto-fight (attacks
-- the nearest enemy of the zone at a capped rate; the client only walks towards the target the
-- server picked). Auto-train lives in Training. None of them runs inside the PvP arena.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Data = require(script.Parent.Data)
local State = require(script.Parent.State)
local Fighters = require(script.Parent.Fighters)
local Combat = require(script.Parent.Combat)

type Fighter = Fighters.Fighter
local A = Config.Auto
local C = Config.Combat

local Auto = {}

local nextAttack: { [Player]: number } = {}
local autoCharging: { [Player]: boolean } = {}
Auto.attacks = {} :: { [Player]: number } -- auto-attacks performed (playtest / rate checks)

local function nearestEnemy(f: Fighter, pos: Vector3): (Fighter?, number)
	local best: Fighter? = nil
	local bestD = A.fightRange
	for _, v in Fighters.list do
		if v.kind == "npc" and v.alive then
			local vp = Fighters.position(v)
			if vp then
				local d = (vp - pos).Magnitude - v.radius
				if d < bestD then
					best, bestD = v, d
				end
			end
		end
	end
	return best, bestD
end

local function setTarget(f: Fighter, pos: Vector3?)
	local char = f.char
	if char then
		char:SetAttribute("AutoTarget", pos)
	end
end

local function step(player: Player, now: number)
	local p = Data.get(player)
	local f = Fighters.ofPlayer(player)
	if not p or not f or not f.alive or not f.humanoid then
		return
	end
	local pos = Fighters.position(f)
	if not pos then
		return
	end
	if f.inArena then
		-- no helpers in PvP
		if autoCharging[player] then
			autoCharging[player] = nil
			Combat.setCharge(f, false)
		end
		setTarget(f, nil)
		return
	end
	local moving = f.humanoid.MoveDirection.Magnitude > 0.05
	local resting = autoCharging[player] == true

	-- auto-charge
	if p.settings.autoCharge then
		if resting then
			if f.ki >= A.chargeUntil or now - f.lastDamagedAt < 0.6 or not f.charging then
				autoCharging[player] = nil
				resting = false
				Combat.setCharge(f, false)
			end
		elseif f.ki < A.chargeBelow and not f.charging and not f.blocking and not f.beamStart and now - f.lastDamagedAt > 1.5 and (not moving or p.settings.autoFight) then
			autoCharging[player] = true
			resting = true
			Combat.setCharge(f, true)
		end
	elseif resting then
		autoCharging[player] = nil
		resting = false
		Combat.setCharge(f, false)
	end

	-- auto-fight
	if p.settings.autoFight and not resting then
		local target, dist = nearestEnemy(f, pos)
		if target then
			local tp = Fighters.position(target) :: Vector3
			setTarget(f, tp)
			if now >= (nextAttack[player] or 0) then
				local rate = A.fightPerSecond * (if State.owns(player, "TurboAuto") then Config.Train.turboMult else 1)
				local did = false
				if dist <= C.meleeRange - 1.5 then
					local aim = (tp - pos) * Vector3.new(1, 0, 1)
					did = Combat.melee(f, if aim.Magnitude > 0.1 then aim.Unit else nil) >= 0
				elseif f.ki >= C.blastCost + 0.02 then
					local dir = tp - (pos + Vector3.new(0, 0.6, 0))
					if dir.Magnitude > 0.1 then
						did = Combat.blast(f, dir.Unit)
					end
				end
				if did then
					nextAttack[player] = now + 1 / rate
					Auto.attacks[player] = (Auto.attacks[player] or 0) + 1
				end
			end
		else
			setTarget(f, nil)
		end
	else
		setTarget(f, nil)
	end
end

function Auto.init()
	Players.PlayerRemoving:Connect(function(player)
		nextAttack[player] = nil
		autoCharging[player] = nil
		Auto.attacks[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(0.1)
			local now = os.clock()
			for _, player in Players:GetPlayers() do
				if State.ready[player] then
					step(player, now)
				end
			end
		end
	end)
end

return Auto
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Combat</string>
            <string name="Source"><![CDATA[--!strict
-- Combat actions (server authoritative): melee combo, ki blasts, charged beam, block, dash,
-- ki charge, flight flag, transformations and techniques. Clients only send intents through
-- the Act remote; cooldowns, ki costs, hit detection and damage are decided here.
-- One Heartbeat loop steps every projectile; one 10 Hz loop handles ki / forms / healing.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Hooks = require(script.Parent.Hooks)
local Fighters = require(script.Parent.Fighters)

type Fighter = Fighters.Fighter
local C = Config.Combat

local Combat = {}

-- Training hook (set by the Training service to avoid a require cycle).
Combat.onManualRep = function(_player: Player) end

local rng = Random.new()

---------------------------------------------------------------------------
-- Projectiles
---------------------------------------------------------------------------
type Projectile = {
	id: number,
	owner: Fighter,
	pos: Vector3,
	dir: Vector3,
	speed: number,
	left: number,
	radius: number,
	kind: string,
	damage: number,
	aoe: number?, -- explosion radius
	knock: number,
	fraction: number?,
}
local projectiles: { Projectile } = {}
local nextProjectile = 0
local worldParams = RaycastParams.new()
worldParams.FilterType = Enum.RaycastFilterType.Include

function Combat.projectileCount(): number
	return #projectiles
end

local function spawnProjectile(owner: Fighter, origin: Vector3, dir: Vector3, spec: { [string]: any }): Projectile
	nextProjectile += 1
	local pr: Projectile = {
		id = nextProjectile,
		owner = owner,
		pos = origin,
		dir = dir,
		speed = spec.speed,
		left = spec.range,
		radius = spec.radius,
		kind = spec.kind,
		damage = spec.damage,
		aoe = spec.aoe,
		knock = spec.knock or 0,
		fraction = spec.fraction,
	}
	table.insert(projectiles, pr)
	Remotes.fireAll("Fx", "shot", {
		i = pr.id,
		o = origin,
		d = dir,
		s = pr.speed,
		r = pr.left,
		z = pr.radius,
		k = pr.kind,
		f = owner.form,
		u = if owner.player then owner.player.UserId else 0,
		n = if owner.kind == "npc" then owner.id else 0,
		c = spec.color,
	})
	return pr
end
Combat.spawnProjectile = spawnProjectile

local function explode(pr: Projectile, at: Vector3, direct: Fighter?)
	local hitAny = false
	if pr.aoe then
		for _, v in Fighters.list do
			if Fighters.hostile(pr.owner, v) then
				local vp = Fighters.position(v)
				if vp and (vp - at).Magnitude <= pr.aoe + v.radius then
					Fighters.damage(pr.owner, v, pr.kind, pr.damage, { knock = pr.knock, from = at, fraction = pr.fraction })
					hitAny = true
				end
			end
		end
	elseif direct then
		local crit = pr.owner.kind == "player" and rng:NextNumber() < Combat.critChance(pr.owner)
		Fighters.damage(pr.owner, direct, pr.kind, pr.damage, { knock = pr.knock, crit = crit, fraction = pr.fraction })
		hitAny = true
	end
	Remotes.fireAll("Fx", "shotEnd", { i = pr.id, p = at, h = hitAny, a = pr.aoe or 0 })
end

local function stepProjectiles(dt: number)
	if #projectiles == 0 then
		return
	end
	local world = workspace:FindFirstChild("World")
	worldParams.FilterDescendantsInstances = if world then { world } else {}
	for i = #projectiles, 1, -1 do
		local pr = projectiles[i]
		local step = math.min(pr.speed * dt, pr.left)
		local a = pr.pos
		local b = a + pr.dir * step
		local done = false
		-- fighters
		local bestT: number? = nil
		local bestV: Fighter? = nil
		for _, v in Fighters.list do
			if v ~= pr.owner and v.alive and Fighters.hostile(pr.owner, v) then
				local vp = Fighters.position(v)
				if vp then
					local t = math.clamp((vp - a):Dot(pr.dir), 0, step)
					local closest = a + pr.dir * t
					if (vp - closest).Magnitude <= pr.radius + v.radius then
						if not bestT or t < bestT then
							bestT, bestV = t, v
						end
					end
				end
			end
		end
		if bestV and bestT then
			explode(pr, a + pr.dir * bestT, bestV)
			done = true
		else
			-- world geometry
			local hit = if world then workspace:Raycast(a, pr.dir * (step + 0.5), worldParams) else nil
			if hit then
				explode(pr, hit.Position, nil)
				done = true
			end
		end
		if not done then
			pr.pos = b
			pr.left -= step
			if pr.left <= 0.01 then
				explode(pr, b, nil)
				done = true
			end
		end
		if done then
			table.remove(projectiles, i)
		end
	end
end

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
function Combat.critChance(f: Fighter): number
	local chance = C.critChance
	if f.player then
		local p = Data.get(f.player)
		if p then
			chance += Formulas.upgradeValue("critChance", p.upgrades.critChance or 0)
		end
	end
	return chance
end

local function unit(v: any): Vector3?
	if typeof(v) ~= "Vector3" then
		return nil
	end
	local m = v.Magnitude
	if m ~= m or m < 0.01 or m > 1e6 then
		return nil
	end
	return v / m
end

local function canAct(f: Fighter): boolean
	if not f.alive then
		return false
	end
	local h = f.humanoid
	return h ~= nil and h.Health > 0 and f.root ~= nil and f.root.Parent ~= nil
end

local function stopCharging(f: Fighter)
	if f.charging then
		f.charging = false
		Fighters.setAttr(f, "Charging", false)
	end
end

local function facing(f: Fighter): Vector3
	local root = f.root :: BasePart
	local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	return if look.Magnitude > 0.01 then look.Unit else Vector3.new(0, 0, -1)
end

---------------------------------------------------------------------------
-- Melee
---------------------------------------------------------------------------
-- Returns the number of targets hit. aim (optional) overrides the facing direction.
function Combat.melee(f: Fighter, aim: Vector3?): number
	if not canAct(f) or f.blocking then
		return 0
	end
	if not Fighters.ready(f, "melee", C.meleeCooldown * 0.9) then
		return 0
	end
	stopCharging(f)
	local now = os.clock()
	local origin = Fighters.position(f) :: Vector3
	local look = aim or facing(f)
	local strength = Fighters.stat(f, "strength")
	local base = Formulas.meleeDamage(strength, f.form)
	local combo = if now - f.comboAt <= C.comboWindow then f.combo + 1 else 1
	local finisher = combo % C.comboFinisher == 0
	local hits = 0
	for _, v in Fighters.list do
		if hits >= 3 then
			break
		end
		if Fighters.hostile(f, v) then
			local vp = Fighters.position(v)
			if vp then
				local delta = vp - origin
				local dist = delta.Magnitude - v.radius
				if dist <= C.meleeRange then
					local flat = delta * Vector3.new(1, 0, 1)
					local dot = if flat.Magnitude > 0.1 then flat.Unit:Dot(look) else 1
					if dot >= C.meleeArc or dist < 4 then
						local crit = rng:NextNumber() < Combat.critChance(f)
						local dealt = Fighters.damage(f, v, "melee", base, {
							crit = crit,
							finisher = finisher,
							knock = if finisher then C.finisherKnockback else C.knockback,
						})
						if dealt > 0 then
							hits += 1
						end
					end
				end
			end
		end
	end
	if hits > 0 then
		f.combo = combo
		f.comboAt = now
	elseif now - f.comboAt > C.comboWindow then
		f.combo = 0
	end
	Remotes.fireAll("Fx", "swing", {
		u = if f.player then f.player.UserId else 0,
		i = f.id,
		c = if hits > 0 then combo else 0,
		f = finisher and hits > 0,
		h = hits,
	})
	if f.player and hits > 0 then
		Remotes.fire("Combat", f.player, "combo", combo)
	end
	return hits
end

---------------------------------------------------------------------------
-- Ki blast
---------------------------------------------------------------------------
function Combat.blast(f: Fighter, dir: Vector3, free: boolean?): boolean
	if not canAct(f) or f.blocking then
		return false
	end
	if not free then
		if f.ki + 1e-6 < C.blastCost or not Fighters.ready(f, "blast", C.blastCooldown * 0.9) then
			return false
		end
		Fighters.spendKi(f, C.blastCost)
	end
	stopCharging(f)
	local origin = (Fighters.position(f) :: Vector3) + dir * 2.5 + Vector3.new(0, 0.6, 0)
	spawnProjectile(f, origin, dir, {
		speed = C.blastSpeed,
		range = C.blastRange,
		radius = C.blastRadius,
		kind = "blast",
		damage = Formulas.blastDamage(Fighters.stat(f, "ki"), f.form),
		knock = 18,
	})
	if f.player then
		Hooks.fire("blast", f.player)
	end
	return true
end

---------------------------------------------------------------------------
-- Beam (hold to charge, release to fire)
---------------------------------------------------------------------------
function Combat.beamStart(f: Fighter): boolean
	if not canAct(f) or f.blocking or f.beamStart then
		return false
	end
	if (f.cd.beam or 0) > os.clock() or f.ki < C.beamCostMin then
		return false
	end
	stopCharging(f)
	f.beamStart = os.clock()
	Fighters.setAttr(f, "Beam", true)
	return true
end

-- charge (optional, 0..1) lets the server fire a beam for a dummy / auto-play.
function Combat.beamRelease(f: Fighter, dir: Vector3, forcedCharge: number?): (boolean, number)
	local started = f.beamStart
	f.beamStart = nil
	Fighters.setAttr(f, "Beam", false)
	if not canAct(f) then
		return false, 0
	end
	local held: number
	if forcedCharge then
		held = forcedCharge * C.beamMaxCharge
	elseif started then
		held = os.clock() - started
	else
		return false, 0
	end
	if held < C.beamMinCharge then
		return false, 0
	end
	local charge = math.clamp(held / C.beamMaxCharge, 0, 1)
	local cost = Formulas.beamCost(charge)
	if f.ki < cost then
		-- fire what the bar allows
		charge = math.clamp((f.ki - C.beamCostMin) / (C.beamCostMax - C.beamCostMin), 0, charge)
		cost = math.min(f.ki, Formulas.beamCost(charge))
	end
	if f.ki < C.beamCostMin - 1e-6 then
		return false, 0
	end
	Fighters.spendKi(f, cost)
	f.cd.beam = os.clock() + C.beamCooldown
	local origin = (Fighters.position(f) :: Vector3) + dir * 3 + Vector3.new(0, 0.4, 0)
	local radius = C.beamRadius * (0.6 + 0.4 * charge)
	local damage = Formulas.beamDamage(Fighters.stat(f, "ki"), f.form, charge)
	local hits = 0
	for _, v in Fighters.list do
		if Fighters.hostile(f, v) then
			local vp = Fighters.position(v)
			if vp then
				local t = (vp - origin):Dot(dir)
				if t >= -2 and t <= C.beamRange then
					local closest = origin + dir * math.max(t, 0)
					if (vp - closest).Magnitude <= radius + v.radius then
						local dealt = Fighters.damage(f, v, "beam", damage, { knock = 55 * (0.5 + charge), from = origin, pvpScale = 0.3 + 0.7 * charge })
						if dealt > 0 then
							hits += 1
						end
					end
				end
			end
		end
	end
	Remotes.fireAll("Fx", "beam", {
		o = origin,
		d = dir,
		l = C.beamRange,
		z = radius,
		c = charge,
		f = f.form,
		u = if f.player then f.player.UserId else 0,
		i = f.id,
	})
	if f.player then
		Hooks.fire("beam", f.player, hits)
	end
	return true, hits
end

---------------------------------------------------------------------------
-- Block / charge / dash / fly
---------------------------------------------------------------------------
function Combat.setBlock(f: Fighter, on: boolean)
	if not canAct(f) then
		on = false
	end
	f.blocking = on
	if on then
		stopCharging(f)
	end
	Fighters.setAttr(f, "Blocking", on)
end

function Combat.setCharge(f: Fighter, on: boolean)
	if not canAct(f) or f.blocking then
		on = false
	end
	if on and not f.charging and f.player then
		Hooks.fire("charge", f.player)
	end
	f.charging = on
	Fighters.setAttr(f, "Charging", on)
end

function Combat.dash(f: Fighter): boolean
	if not canAct(f) or f.ki < C.dashCost then
		return false
	end
	if not Fighters.ready(f, "dash", C.dashCooldown * 0.9) then
		return false
	end
	Fighters.spendKi(f, C.dashCost)
	stopCharging(f)
	f.invulnerableUntil = math.max(f.invulnerableUntil, os.clock() + C.dashIFrames)
	Remotes.fireAll("Fx", "dash", { u = if f.player then f.player.UserId else 0, i = f.id, p = Fighters.position(f) })
	if f.player then
		Hooks.fire("dash", f.player)
	end
	return true
end

function Combat.setFly(f: Fighter, on: boolean)
	if not canAct(f) then
		on = false
	end
	if on and not f.flying and f.player then
		Hooks.fire("fly", f.player)
	end
	f.flying = on
	Fighters.setAttr(f, "Flying", on)
end

---------------------------------------------------------------------------
-- Transformations
---------------------------------------------------------------------------
-- Unlocks forms by power (kept through rebirths). Returns the highest unlocked index.
function Combat.refreshForms(player: Player): number
	local p = Data.get(player)
	if not p then
		return 0
	end
	local best = Formulas.bestForm(math.max(p.bestPower, State.power(p)), p.rebirths)
	if best > p.forms then
		local first = p.forms + 1
		p.forms = best
		State.dirty(player)
		for i = first, best do
			Remotes.fire("Combat", player, "formUnlocked", i)
			Hooks.fire("formUnlocked", player, i)
		end
	end
	return p.forms
end

function Combat.setForm(f: Fighter, index: number): boolean
	if not canAct(f) then
		return false
	end
	local maxForm = #Config.Forms
	if f.player then
		maxForm = Combat.refreshForms(f.player)
	end
	if index ~= index or index < 0 or index > maxForm or index % 1 ~= 0 then
		return false
	end
	if index == f.form then
		return true
	end
	if index > 0 then
		if f.ki < 0.05 or not Fighters.ready(f, "form", 0.8) then
			return false
		end
	end
	f.form = index
	Fighters.setAttr(f, "Form", index)
	Remotes.fireAll("Fx", "form", { u = if f.player then f.player.UserId else 0, i = f.id, f = index, p = Fighters.position(f) })
	if f.player and index > 0 then
		Hooks.fire("form", f.player, index)
	end
	return true
end

---------------------------------------------------------------------------
-- Techniques
---------------------------------------------------------------------------
function Combat.technique(f: Fighter, id: string, dir: Vector3): boolean
	local t = Config.TechniqueById[id]
	if not t or not canAct(f) or f.blocking then
		return false
	end
	if f.player then
		local p = Data.get(f.player)
		if not p or not p.techniques[id] then
			return false
		end
	end
	if f.ki < t.kiCost or (f.cd["t_" .. id] or 0) > os.clock() then
		return false
	end
	f.cd["t_" .. id] = os.clock() + t.cooldown
	Fighters.spendKi(f, t.kiCost)
	stopCharging(f)
	local kiStat = Fighters.stat(f, "ki")
	Remotes.fireAll("Fx", "tech", { u = if f.player then f.player.UserId else 0, i = f.id, t = id, p = Fighters.position(f), d = dir })
	if id == "pulse_volley" then
		task.spawn(function()
			for n = 1, t.shots do
				if not canAct(f) then
					break
				end
				local spread = CFrame.lookAt(Vector3.zero, dir) * CFrame.Angles(math.rad(rng:NextNumber(-5, 5)), math.rad(rng:NextNumber(-7, 7)), 0)
				local origin = (Fighters.position(f) :: Vector3) + dir * 2.5 + Vector3.new(0, 0.8, 0)
				spawnProjectile(f, origin, spread.LookVector, {
					speed = C.blastSpeed * 1.15,
					range = C.blastRange,
					radius = C.blastRadius,
					kind = "tech",
					damage = Formulas.blastDamage(kiStat, f.form) * t.dmgMult,
					knock = 14,
				})
				if n < t.shots then
					task.wait(0.09)
				end
			end
		end)
	elseif id == "meteor_dive" then
		task.delay(0.4, function()
			if not canAct(f) then
				return
			end
			local at = Fighters.position(f) :: Vector3
			local damage = Formulas.meleeDamage(Fighters.stat(f, "strength"), f.form) * t.dmgMult
			for _, v in Fighters.list do
				if Fighters.hostile(f, v) then
					local vp = Fighters.position(v)
					if vp and (vp - at).Magnitude <= t.radius + v.radius then
						Fighters.damage(f, v, "tech", damage, { knock = 90, from = at })
					end
				end
			end
			Remotes.fireAll("Fx", "shock", { p = at, r = t.radius, f = f.form })
		end)
	elseif id == "sunfall" then
		local origin = (Fighters.position(f) :: Vector3) + Vector3.new(0, 9, 0) + dir * 3
		spawnProjectile(f, origin, dir, {
			speed = t.speed,
			range = 170,
			radius = 9,
			kind = "tech",
			damage = Formulas.blastDamage(kiStat, f.form) * t.dmgMult,
			aoe = t.radius,
			knock = 80,
			color = "sun",
		})
	end
	if f.player then
		Hooks.fire("technique", f.player, id)
	end
	return true
end

---------------------------------------------------------------------------
-- Ki / forms / healing loop (10 Hz)
---------------------------------------------------------------------------
local function tick(dt: number)
	local now = os.clock()
	for _, f in Fighters.list do
		if f.kind ~= "player" or not f.alive then
			continue
		end
		local player = f.player
		local regen = C.kiRegen
		local drainMult = 1
		if player then
			local p = Data.get(player)
			if p then
				regen *= 1 + Formulas.upgradeValue("kiRegen", p.upgrades.kiRegen or 0)
			end
			if State.owns(player, "KiMastery") then
				regen *= Config.KiMasteryRegen
				drainMult = Config.KiMasteryDrain
			end
		end
		local delta = 0
		if f.charging then
			delta += C.kiChargeRegen * (regen / C.kiRegen) * dt
		elseif not f.beamStart and f.form == 0 then
			-- a form burns ki: no passive regen while transformed (charging still works)
			delta += regen * dt
		end
		if f.form > 0 then
			local form = Config.Forms[f.form]
			delta -= form.drain * drainMult * dt
		end
		f.ki = math.clamp(f.ki + delta, 0, 1)
		if f.form > 0 and f.ki <= 0 then
			f.form = 0
			Fighters.setAttr(f, "Form", 0)
			Remotes.fireAll("Fx", "form", { u = if player then player.UserId else 0, i = f.id, f = 0, p = Fighters.position(f) })
			if player then
				Remotes.notify(player, { key = "msg.form_out_of_ki" }, "info")
			end
		end
		-- replicate the bar in 2% steps
		local shown = math.floor(f.ki * 50 + 0.5) / 50
		Fighters.setAttr(f, "Ki", shown)
		-- out-of-combat healing
		local h = f.humanoid
		if h and h.Health > 0 and h.Health < h.MaxHealth and now - f.lastDamagedAt > C.outOfCombatDelay then
			h.Health = math.min(h.MaxHealth, h.Health + h.MaxHealth * C.outOfCombatHeal * dt)
		end
	end
end

---------------------------------------------------------------------------
-- Act remote
---------------------------------------------------------------------------
local budget: { [Player]: { tokens: number, t: number } } = {}
local ACT_RATE, ACT_BURST = 40, 60

local function onAct(player: Player, kind: any, a: any)
	if type(kind) ~= "string" or not State.ready[player] then
		return
	end
	local b = budget[player]
	local now = os.clock()
	if not b then
		b = { tokens = ACT_BURST, t = now }
		budget[player] = b
	end
	b.tokens = math.min(ACT_BURST, b.tokens + (now - b.t) * ACT_RATE)
	b.t = now
	if b.tokens < 1 then
		return
	end
	b.tokens -= 1
	local f = Fighters.ofPlayer(player)
	if not f then
		return
	end
	if kind == "melee" then
		local aim = unit(a)
		if aim then
			local flat = aim * Vector3.new(1, 0, 1)
			aim = if flat.Magnitude > 0.05 then flat.Unit else nil
		end
		Combat.melee(f, aim)
		Combat.onManualRep(player)
	elseif kind == "blast" then
		local dir = unit(a)
		if dir then
			Combat.blast(f, dir)
		end
	elseif kind == "beamStart" then
		Combat.beamStart(f)
	elseif kind == "beamRelease" then
		local dir = unit(a)
		if dir then
			Combat.beamRelease(f, dir)
		else
			f.beamStart = nil
			Fighters.setAttr(f, "Beam", false)
		end
	elseif kind == "block" then
		Combat.setBlock(f, a == true)
	elseif kind == "charge" then
		Combat.setCharge(f, a == true)
	elseif kind == "dash" then
		Combat.dash(f)
	elseif kind == "fly" then
		Combat.setFly(f, a == true)
	elseif kind == "form" then
		if type(a) == "number" then
			Combat.setForm(f, a)
		end
	elseif kind == "tech" then
		if type(a) == "table" and type(a.id) == "string" then
			local dir = unit(a.dir)
			if dir then
				Combat.technique(f, a.id, dir)
			end
		end
	end
end

function Combat.init()
	Remotes.ActEvent.OnServerEvent:Connect(onAct)
	Players.PlayerRemoving:Connect(function(player)
		budget[player] = nil
	end)
	RunService.Heartbeat:Connect(stepProjectiles)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.1)
			local now = os.clock()
			tick(now - last)
			last = now
		end
	end)
end

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Data</string>
            <string name="Source"><![CDATA[--!strict
-- Player profiles: DataStore load/save with a soft session lock, reconcile, autosave
-- and BindToClose.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Data = {}

export type Profile = {
	version: number,
	stats: { [string]: number },
	sparks: number,
	gems: number,
	bestPower: number,
	rebirths: number,
	planet: number, -- where the player is
	planets: { number }, -- unlocked planet indexes
	gear: number, -- tier index into Config.Gear
	techniques: { [string]: boolean },
	forms: number, -- highest form unlocked (kept through rebirths)
	auras: { [string]: number }, -- owned aura id -> copies
	auraEquipped: string, -- "" = none
	spins: number, -- free aura spins banked
	freeSpinDay: number,
	race: string,
	raceChanges: number,
	upgrades: { [string]: number },
	story: { step: number, progress: number },
	quests: { day: number, list: { any }, progress: { number }, claimed: { boolean }, bonusClaimed: boolean },
	daily: { last: number, streak: number },
	codes: { [string]: boolean },
	purchases: { string },
	boostLeft: number, -- seconds of x2 training (ticks while online)
	settings: { [string]: any },
	lang: string,
	offlinePending: { [string]: number }?, -- stat -> points waiting to be claimed
	offlineSeconds: number,
	referredBy: number,
	referralPaid: boolean,
	referralRewards: number,
	starterBought: boolean,
	ads: { day: number, count: number },
	notifAskedAt: number,
	groupGiftClaimed: boolean,
	relics: { found: { [string]: boolean }, seed: number, nextAt: number },
	wishes: number,
	wishPower: number,
	pvp: { rating: number, kills: number, deaths: number },
	protectionOff: boolean,
	kills: number,
	bossKills: { [string]: number },
	totalReps: number,
	savedAt: number,
	firstJoin: number,
	playTime: number,
	lock: { job: string, t: number }?,
}

local store: DataStore? = nil
local storeOk = false
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
		storeOk = true
	else
		warn("[Data] DataStore unavailable, progress will NOT save:", result)
	end
end

Data.profiles = {} :: { [Player]: Profile }
local loadedOk: { [Player]: boolean } = {}
local LOCK_TTL = 150

local function defaultSettings(): { [string]: any }
	return { stat = "strength", autoTrain = false, autoCharge = false, autoFight = false, music = true, sfx = true, lite = false, shake = true }
end

local function defaultProfile(): Profile
	local stats = {}
	for _, s in Config.Stats do
		stats[s] = Config.StartStat
	end
	local upgrades = {}
	for _, u in Config.Upgrades do
		upgrades[u.id] = 0
	end
	local p: Profile = {
		version = 1,
		stats = stats,
		sparks = 0,
		gems = 0,
		bestPower = 0,
		rebirths = 0,
		planet = 1,
		planets = { 1 },
		gear = 1,
		techniques = {},
		forms = 0,
		auras = {},
		auraEquipped = "",
		spins = 1,
		freeSpinDay = 0,
		race = "terran",
		raceChanges = 0,
		upgrades = upgrades,
		story = { step = 1, progress = 0 },
		quests = { day = -1, list = {}, progress = {}, claimed = {}, bonusClaimed = false },
		daily = { last = 0, streak = 0 },
		codes = {},
		purchases = {},
		boostLeft = 0,
		settings = defaultSettings(),
		lang = "",
		offlinePending = nil,
		offlineSeconds = 0,
		referredBy = 0,
		referralPaid = false,
		referralRewards = 0,
		starterBought = false,
		ads = { day = 0, count = 0 },
		notifAskedAt = 0,
		groupGiftClaimed = false,
		relics = { found = {}, seed = 0, nextAt = 0 },
		wishes = 0,
		wishPower = 0,
		pvp = { rating = Config.Pvp.startRating, kills = 0, deaths = 0 },
		protectionOff = false,
		kills = 0,
		bossKills = {},
		totalReps = 0,
		savedAt = os.time(),
		firstJoin = os.time(),
		playTime = 0,
	}
	return p
end
Data.defaultProfile = defaultProfile

local function num(v: any, default: number): number
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then
		return v
	end
	return default
end

-- Fill keys added in later versions and drop content that no longer exists in Config.
local function reconcile(p: any): Profile
	local def = defaultProfile() :: any
	for k, v in def do
		if p[k] == nil then
			p[k] = v
		end
	end
	if type(p.stats) ~= "table" then
		p.stats = def.stats
	end
	for _, s in Config.Stats do
		p.stats[s] = math.max(Config.StartStat, num(p.stats[s], Config.StartStat))
	end
	for _, u in Config.Upgrades do
		p.upgrades[u.id] = math.clamp(math.floor(num(p.upgrades[u.id], 0)), 0, u.max)
	end
	if type(p.settings) ~= "table" then
		p.settings = defaultSettings()
	end
	for k, v in defaultSettings() do
		if p.settings[k] == nil then
			p.settings[k] = v
		end
	end
	if not table.find(Config.Stats, p.settings.stat) then
		p.settings.stat = "strength"
	end
	p.gear = math.clamp(math.floor(num(p.gear, 1)), 1, #Config.Gear)
	p.forms = math.clamp(math.floor(num(p.forms, 0)), 0, #Config.Forms)
	p.planet = math.clamp(math.floor(num(p.planet, 1)), 1, #Config.Planets)
	if type(p.planets) ~= "table" or #p.planets == 0 then
		p.planets = { 1 }
	end
	if not table.find(p.planets, p.planet) then
		p.planet = 1
	end
	if not Config.RaceById[p.race] then
		p.race = "terran"
	end
	for id in p.auras do
		if not Config.AuraById[id] then
			p.auras[id] = nil
		end
	end
	if p.auraEquipped ~= "" and not p.auras[p.auraEquipped] then
		p.auraEquipped = ""
	end
	for id in p.techniques do
		if not Config.TechniqueById[id] then
			p.techniques[id] = nil
		end
	end
	p.story.step = math.clamp(math.floor(num(p.story.step, 1)), 1, #Config.Story + 1)
	p.sparks = math.max(0, num(p.sparks, 0))
	p.gems = math.max(0, math.floor(num(p.gems, 0)))
	if type(p.pvp) ~= "table" then
		p.pvp = def.pvp
	end
	if type(p.relics) ~= "table" or type(p.relics.found) ~= "table" then
		p.relics = def.relics
	end
	return p :: Profile
end
Data.reconcile = reconcile

local function key(player: Player): string
	return "u_" .. player.UserId
end

function Data.load(player: Player): Profile
	if not storeOk or not store then
		local p = defaultProfile()
		Data.profiles[player] = p
		loadedOk[player] = false
		return p
	end
	local ds = store :: DataStore
	local result: any = nil
	for attempt = 1, 6 do
		local lockedByOther = false
		local ok, err = pcall(function()
			ds:UpdateAsync(key(player), function(old: any)
				local now = os.time()
				if old and old.lock and old.lock.job ~= game.JobId and now - old.lock.t < LOCK_TTL and attempt < 6 then
					lockedByOther = true
					return nil -- abort write, another server still owns the session
				end
				local p = if old then reconcile(old) else defaultProfile()
				p.lock = { job = game.JobId, t = now }
				result = p
				return p
			end)
		end)
		if ok and not lockedByOther and result then
			break
		end
		if not ok then
			warn("[Data] load failed for", player.Name, err)
		end
		result = nil
		task.wait(if lockedByOther then 5 else 2)
		if not player.Parent then
			break
		end
	end
	if not result then
		-- Never overwrite real data with a blank profile: keep this session unsaved.
		warn("[Data] could not load", player.Name, "- session will not save")
		result = defaultProfile()
		loadedOk[player] = false
	else
		loadedOk[player] = true
	end
	Data.profiles[player] = result
	return result
end

function Data.save(player: Player, release: boolean?): boolean
	local p = Data.profiles[player]
	if not p or not loadedOk[player] or not store then
		return false
	end
	local ds = store :: DataStore
	p.savedAt = os.time()
	p.lock = if release then nil else { job = game.JobId, t = os.time() }
	local wrote = false
	local ok, err = pcall(function()
		ds:UpdateAsync(key(player), function(old: any)
			if old and old.lock and old.lock.job ~= game.JobId and os.time() - old.lock.t < LOCK_TTL then
				return nil -- another server owns it now; don't clobber
			end
			wrote = true
			return p
		end)
	end)
	if not ok then
		warn("[Data] save failed for", player.Name, err)
		return false
	end
	return wrote
end

function Data.release(player: Player)
	Data.save(player, true)
	Data.profiles[player] = nil
	loadedOk[player] = nil
end

function Data.get(player: Player): Profile?
	return Data.profiles[player]
end

function Data.isPersistent(player: Player): boolean
	return loadedOk[player] == true
end

function Data.startAutosave()
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for _, player in Players:GetPlayers() do
				task.spawn(Data.save, player)
			end
		end
	end)
	game:BindToClose(function()
		if RunService:IsStudio() and not storeOk then
			return
		end
		local pending = 0
		for _, player in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				Data.save(player, true)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.1)
		end
	end)
end

return Data
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Fighters</string>
            <string name="Source"><![CDATA[--!strict
-- Combatant registry and the one damage pipeline everything goes through.
-- A Fighter is a player, an enemy (NPC) or a "dummy" (a server-driven stand-in for another
-- player, used by the playtest and the showcase). The server owns HP, ki, forms, cooldowns.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Hooks = require(script.Parent.Hooks)

local Fighters = {}

export type Fighter = {
	id: number,
	kind: string, -- "player" | "npc"
	player: Player?,
	dummy: boolean?,
	char: Model?,
	root: BasePart?,
	humanoid: Humanoid?,
	radius: number,
	alive: boolean,
	ki: number,
	form: number,
	blocking: boolean,
	charging: boolean,
	flying: boolean,
	invulnerableUntil: number,
	lastDamagedAt: number,
	lastAttackAt: number,
	combo: number,
	comboAt: number,
	cd: { [string]: number },
	beamStart: number?,
	inArena: boolean,
	-- npc
	def: any?,
	hp: number,
	maxHp: number,
	contributions: { [Player]: number }?,
	knock: Vector3?,
	npc: any?, -- AI state (Npcs service)
	-- dummy
	dstats: { [string]: number }?,
	dname: string?,
	protected: boolean?,
}

local nextId = 0
local list: { Fighter } = {}
local byPlayer: { [Player]: Fighter } = {}
local byId: { [number]: Fighter } = {}

Fighters.list = list
-- PvP rule, installed by the Arena service. Default: players can never hurt each other.
Fighters.pvpRule = function(_attacker: Fighter, _victim: Fighter): boolean
	return false
end
Fighters.onNpcDeath = function(_f: Fighter, _killer: Fighter?) end
Fighters.onPlayerKill = function(_killer: Fighter, _victim: Fighter) end

local function new(kind: string): Fighter
	nextId += 1
	local f: Fighter = {
		id = nextId,
		kind = kind,
		radius = 2,
		alive = true,
		ki = 1,
		form = 0,
		blocking = false,
		charging = false,
		flying = false,
		invulnerableUntil = 0,
		lastDamagedAt = -100,
		lastAttackAt = -100,
		combo = 0,
		comboAt = -100,
		cd = {},
		inArena = false,
		hp = 0,
		maxHp = 0,
	}
	table.insert(list, f)
	byId[f.id] = f
	return f
end

function Fighters.ofPlayer(player: Player): Fighter?
	return byPlayer[player]
end

function Fighters.byId(id: number): Fighter?
	return byId[id]
end

function Fighters.remove(f: Fighter)
	f.alive = false
	byId[f.id] = nil
	local i = table.find(list, f)
	if i then
		table.remove(list, i)
	end
	if f.player and byPlayer[f.player] == f then
		byPlayer[f.player] = nil
	end
end

function Fighters.position(f: Fighter): Vector3?
	local root = f.root
	if root and root.Parent then
		return root.Position
	end
	return nil
end

-- strength, ki, defense of a fighter (NPCs don't use these)
function Fighters.stat(f: Fighter, name: string): number
	if f.dstats then
		return f.dstats[name] or 0
	end
	if f.player then
		local p = Data.get(f.player)
		return if p then p.stats[name] or 0 else 0
	end
	return 0
end

function Fighters.power(f: Fighter): number
	if f.dstats then
		return Formulas.power(f.dstats)
	end
	if f.player then
		local p = Data.get(f.player)
		return if p then Formulas.power(p.stats) else 0
	end
	return 0
end

function Fighters.maxHp(f: Fighter): number
	if f.kind == "npc" then
		return f.maxHp
	end
	return Formulas.maxHp(Fighters.stat(f, "defense"))
end

function Fighters.hp(f: Fighter): number
	if f.kind == "npc" then
		return f.hp
	end
	local h = f.humanoid
	return if h then h.Health else 0
end

local function setAttr(f: Fighter, name: string, value: any)
	local char = f.char
	if char and char:GetAttribute(name) ~= value then
		char:SetAttribute(name, value)
	end
end
Fighters.setAttr = setAttr

-- Keeps Humanoid.MaxHealth in line with Defense, preserving the health fraction.
function Fighters.syncHealth(f: Fighter)
	local h = f.humanoid
	if not h or f.kind ~= "player" then
		return
	end
	local want = Fighters.maxHp(f)
	if math.abs(h.MaxHealth - want) >= 1 then
		local frac = if h.MaxHealth > 0 then h.Health / h.MaxHealth else 1
		h.MaxHealth = want
		if h.Health > 0 then
			h.Health = math.max(1, want * frac)
		end
	end
end

function Fighters.bindCharacter(f: Fighter, char: Model)
	f.char = char
	f.root = char:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	f.humanoid = char:WaitForChild("Humanoid", 10) :: Humanoid?
	f.alive = true
	f.ki = 1
	f.form = 0
	f.blocking = false
	f.charging = false
	f.flying = false
	f.beamStart = nil
	f.combo = 0
	f.invulnerableUntil = os.clock() + Config.Combat.respawnInvulnerable
	local h = f.humanoid
	if h then
		h.MaxHealth = Fighters.maxHp(f)
		h.Health = h.MaxHealth
		h.Died:Connect(function()
			f.alive = false
			f.form = 0
			f.charging = false
			f.blocking = false
			Hooks.fire("playerDied", f)
		end)
	end
	char:SetAttribute("FighterId", f.id)
	char:SetAttribute("Ki", 1)
	char:SetAttribute("Form", 0)
	char:SetAttribute("Charging", false)
	char:SetAttribute("Blocking", false)
	char:SetAttribute("Flying", false)
	char:SetAttribute("Beam", false)
end

function Fighters.addPlayer(player: Player): Fighter
	local existing = byPlayer[player]
	if existing then
		return existing
	end
	local f = new("player")
	f.player = player
	byPlayer[player] = f
	return f
end

function Fighters.addNpc(def: any, root: BasePart, hp: number): Fighter
	local f = new("npc")
	f.def = def
	f.root = root
	f.hp = hp
	f.maxHp = hp
	f.radius = 2.2 * (def.scale or 1)
	f.contributions = {}
	return f
end

-- A server-driven player stand-in. `model` needs a Humanoid and a HumanoidRootPart.
function Fighters.addDummy(model: Model, stats: { [string]: number }, name: string?): Fighter
	local f = new("player")
	f.dummy = true
	f.dstats = stats
	f.dname = name or model.Name
	f.char = model
	f.root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	f.humanoid = model:FindFirstChildOfClass("Humanoid")
	local h = f.humanoid
	if h then
		h.MaxHealth = Fighters.maxHp(f)
		h.Health = h.MaxHealth
		h.Died:Connect(function()
			f.alive = false
		end)
	end
	model:SetAttribute("FighterId", f.id)
	model:SetAttribute("Form", 0)
	model:SetAttribute("Ki", 1)
	return f
end

-- Can `attacker` hurt `victim` at all?
function Fighters.hostile(attacker: Fighter, victim: Fighter): boolean
	if attacker == victim or not victim.alive then
		return false
	end
	if attacker.kind == "npc" then
		return victim.kind == "player" and not victim.dummy
	end
	if victim.kind == "npc" then
		return true
	end
	return Fighters.pvpRule(attacker, victim)
end

export type DamageOpts = {
	crit: boolean?,
	finisher: boolean?,
	knock: number?, -- knockback speed
	from: Vector3?, -- knockback origin (defaults to the attacker)
	fraction: number?, -- NPC -> player: damage as a fraction of max HP (world boss)
	pvpScale: number?,
	silent: boolean?,
}

-- Applies damage. Returns the amount dealt (0 = blocked by rules / invulnerable).
function Fighters.damage(attacker: Fighter?, victim: Fighter, kind: string, raw: number, opts: DamageOpts?): number
	local o: DamageOpts = opts or {}
	local now = os.clock()
	if not victim.alive then
		return 0
	end
	if attacker and not Fighters.hostile(attacker, victim) then
		return 0
	end
	local vpos = Fighters.position(victim)
	if not vpos then
		return 0
	end
	if victim.invulnerableUntil > now then
		if not o.silent then
			Remotes.fireAll("Fx", "dodge", { p = vpos, v = victim.id })
		end
		return 0
	end

	local dmg = raw
	local blocked = false
	if victim.kind == "npc" then
		if o.crit then
			dmg *= Config.Combat.critMult
		end
		if o.finisher then
			dmg *= Config.Combat.finisherMult
		end
		dmg = math.min(dmg, victim.hp)
		victim.hp -= dmg
		if attacker and attacker.player and victim.contributions then
			victim.contributions[attacker.player] = (victim.contributions[attacker.player] or 0) + dmg
		end
		local root = victim.root
		if root then
			root:SetAttribute("Hp", victim.hp)
		end
	else
		blocked = victim.blocking
		if attacker and attacker.kind == "player" then
			-- PvP: fraction of the victim's bar, nudged by the power ratio
			dmg = Formulas.pvpDamage(kind, Fighters.power(attacker), Fighters.power(victim), Fighters.maxHp(victim), o.pvpScale)
			if o.finisher then
				dmg *= 1.6
			end
			if blocked then
				dmg *= 1 - Config.Combat.blockReduction
			end
		elseif o.fraction then
			dmg = Fighters.maxHp(victim) * o.fraction
			if blocked then
				dmg *= 1 - Config.Combat.blockReduction
			end
		else
			dmg = Formulas.mitigate(raw, victim.form, blocked)
		end
		local h = victim.humanoid
		if not h or h.Health <= 0 then
			return 0
		end
		dmg = math.min(dmg, h.Health)
		h.Health -= dmg
	end
	victim.lastDamagedAt = now
	if attacker then
		attacker.lastAttackAt = now
	end

	-- knockback
	local speed = o.knock or 0
	if speed > 0 and not blocked then
		local from = o.from or (attacker and Fighters.position(attacker)) or vpos
		local dir = (vpos - from) * Vector3.new(1, 0, 1)
		dir = if dir.Magnitude > 0.05 then dir.Unit else Vector3.new(0, 0, 1)
		local vel = dir * speed + Vector3.new(0, speed * 0.45, 0)
		if victim.kind == "npc" then
			if not (victim.def and victim.def.boss) then
				victim.knock = vel
			end
		elseif victim.dummy then
			local root = victim.root
			if root then
				root.AssemblyLinearVelocity = vel
			end
		elseif victim.player then
			Remotes.fire("Knock", victim.player, vel)
		end
	end

	if not o.silent then
		Remotes.fireAll("Fx", "hit", {
			p = vpos,
			d = dmg,
			k = kind,
			c = o.crit == true,
			f = o.finisher == true,
			b = blocked,
			a = if attacker and attacker.player then attacker.player.UserId else 0,
			v = victim.id,
			u = if victim.player then victim.player.UserId else 0,
		})
	end
	Hooks.fire("damage", attacker, victim, dmg, kind)

	-- death
	if victim.kind == "npc" then
		if victim.hp <= 0 then
			victim.alive = false
			Fighters.onNpcDeath(victim, attacker)
		end
	else
		local h = victim.humanoid
		if h and h.Health <= 0 then
			victim.alive = false
			if attacker and attacker.kind == "player" then
				Fighters.onPlayerKill(attacker, victim)
			end
		end
	end
	return dmg
end

-- Spend ki (fraction of the bar). Returns false when there isn't enough.
function Fighters.spendKi(f: Fighter, cost: number): boolean
	if f.ki + 1e-6 < cost then
		return false
	end
	f.ki = math.max(0, f.ki - cost)
	return true
end

function Fighters.ready(f: Fighter, name: string, cooldown: number): boolean
	local now = os.clock()
	if (f.cd[name] or 0) > now then
		return false
	end
	f.cd[name] = now + cooldown
	return true
end

function Fighters.init()
	Players.PlayerRemoving:Connect(function(player)
		local f = byPlayer[player]
		if f then
			Fighters.remove(f)
		end
	end)
	-- keep max HP in line with Defense
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, f in list do
				if f.kind == "player" and not f.dummy and f.alive and f.player and State.ready[f.player] then
					Fighters.syncHealth(f)
				end
			end
		end
	end)
end

return Fighters
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Guard</string>
            <string name="Source"><![CDATA[--!strict
-- Movement sanity (anti-teleport) and void rescue. Flight and dashes are real mechanics, so the
-- allowance is generous; what gets corrected is a jump no mechanic can produce (for example
-- warping to another planet without the gate). Server teleports are whitelisted.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Data = require(script.Parent.Data)
local State = require(script.Parent.State)
local Fighters = require(script.Parent.Fighters)
local Progression = require(script.Parent.Progression)

local Guard = {}

local STEP = 0.5
local lastGood: { [Player]: Vector3 } = {}
Guard.corrections = {} :: { [Player]: number }

function Guard.count(player: Player): number
	return Guard.corrections[player] or 0
end

function Guard.init()
	Players.PlayerRemoving:Connect(function(player)
		lastGood[player] = nil
		Guard.corrections[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(STEP)
			local now = os.clock()
			for _, player in Players:GetPlayers() do
				local p = Data.get(player)
				local f = Fighters.ofPlayer(player)
				local pos = f and Fighters.position(f)
				if not p or not f or not pos or not State.ready[player] or not f.alive then
					lastGood[player] = nil
					continue
				end
				-- fell off the planet: back to the plaza
				if pos.Y < Config.GroundY - 160 then
					Progression.placeOnSpawn(player)
					lastGood[player] = nil
					continue
				end
				local teleported = now - (Progression.teleportedAt[player] or -100) < 3
				local prev = lastGood[player]
				if prev and not teleported then
					local fly = Formulas.flySpeed(p.stats.agility, State.owns(player, "FastFlight")) * 1.7
					local allowed = math.max(fly, 170) * STEP * 1.6 + Config.Combat.dashDistance + 40
					if (pos - prev).Magnitude > allowed then
						Guard.corrections[player] = (Guard.corrections[player] or 0) + 1
						Progression.teleport(player, CFrame.new(prev))
						continue
					end
				end
				lastGood[player] = pos
			end
		end
	end)
end

return Guard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Hooks</string>
            <string name="Source"><![CDATA[--!strict
-- Tiny in-process event bus so gameplay services can report what happened (hatched, taps,
-- crafted, gems spent, rebirth) without requiring the services that react to it
-- (quests, announcements, notification prompts). Avoids require cycles.
local Hooks = {}

local listeners: { [string]: { (...any) -> () } } = {}

function Hooks.on(name: string, fn: (...any) -> ())
	local list = listeners[name]
	if not list then
		list = {}
		listeners[name] = list
	end
	table.insert(list, fn)
end

function Hooks.fire(name: string, ...: any)
	local list = listeners[name]
	if not list then
		return
	end
	for _, fn in list do
		local ok, err = pcall(fn :: any, ...)
		if not ok then
			warn("[Hooks]", name, err)
		end
	end
end

return Hooks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Leaderboard</string>
            <string name="Source"><![CDATA[--!strict
-- leaderstats (player list) + global OrderedDataStore boards (Power, Ascensions, Arena rating)
-- shown on the SurfaceGui boards in the plaza and in the ranking window. Power is stored
-- log-encoded so it never overflows the OrderedDataStore integer range.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)

local Leaderboard = {}

local SCALE = 1e9
local stores: { [string]: OrderedDataStore } = {}
do
	for id, name in Config.BoardStores do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore(name :: string)
		end)
		if ok then
			stores[id :: string] = store :: any
		else
			warn("[Leaderboard] OrderedDataStore unavailable:", tostring(store))
		end
	end
end

local function encodePower(n: number): number
	return math.floor(math.log10(math.max(1, n) + 1) * SCALE)
end
local function decodePower(v: number): number
	return 10 ^ (v / SCALE) - 1
end
Leaderboard.encodePower = encodePower
Leaderboard.decodePower = decodePower

local nameCache: { [number]: string } = {}
local function nameOf(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local n = if ok and name then name else ("#" .. userId)
	nameCache[userId] = n
	return n
end

-- Latest rows per board: { { name, value } }
Leaderboard.rows = { power = {}, rebirths = {}, arena = {} } :: { [string]: { { name: string, value: string } } }

function Leaderboard.onReady(player: Player)
	if player:FindFirstChild("leaderstats") then
		return
	end
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local power = Instance.new("StringValue")
	power.Name = "Power"
	power.Value = "0"
	power.Parent = ls
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Ascensions"
	rebirths.Parent = ls
	ls.Parent = player
end

local function updateStats(player: Player)
	local p = Data.get(player)
	local ls = player:FindFirstChild("leaderstats")
	if not p or not ls then
		return
	end
	local power = ls:FindFirstChild("Power") :: StringValue?
	local rebirths = ls:FindFirstChild("Ascensions") :: IntValue?
	if power then
		power.Value = Format.abbrev(State.power(p))
	end
	if rebirths then
		rebirths.Value = p.rebirths
	end
end

local function pushScores()
	for _, player in Players:GetPlayers() do
		local p = Data.get(player)
		if p and Data.isPersistent(player) then
			local key = tostring(player.UserId)
			local values = { power = encodePower(math.max(p.bestPower, State.power(p))), rebirths = p.rebirths, arena = p.pvp.rating }
			for id, store in stores do
				if id ~= "rebirths" or p.rebirths > 0 then
					if id ~= "arena" or p.pvp.kills > 0 then
						pcall(function()
							store:SetAsync(key, values[id])
						end)
					end
				end
			end
		end
	end
end

local function renderBoard(board: BasePart, rows: { { name: string, value: string } })
	local gui = board:FindFirstChild("BoardGui")
	local list = gui and gui:FindFirstChild("List")
	if not list then
		return
	end
	for _, c in list:GetChildren() do
		if c:IsA("TextLabel") then
			c:Destroy()
		end
	end
	local shown = rows
	if #shown == 0 then
		shown = { { name = "No scores yet", value = "" } }
	end
	local medals = { Color3.fromRGB(255, 215, 60), Color3.fromRGB(220, 225, 235), Color3.fromRGB(230, 150, 90) }
	for i, row in shown do
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, 0.095, 0)
		t.Font = Enum.Font.GothamBold
		t.TextScaled = true
		t.TextXAlignment = Enum.TextXAlignment.Left
		t.TextColor3 = medals[i] or Color3.new(1, 1, 1)
		t.Text = if row.value == "" then row.name else string.format("#%d  %s  —  %s", i, row.name, row.value)
		t.LayoutOrder = i
		if row.value == "" then
			t:SetAttribute("LocKey", "world.board_empty")
		end
		t.Parent = list
	end
end

local function fetch(store: OrderedDataStore?, decode: (number) -> string): { { name: string, value: string } }
	local rows = {}
	if not store then
		return rows
	end
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, 10)
	end)
	if not ok or not pages then
		return rows
	end
	for _, entry in (pages :: DataStorePages):GetCurrentPage() do
		local e = entry :: any
		table.insert(rows, { name = nameOf(tonumber(e.key) or 0), value = decode(e.value) })
	end
	return rows
end

function Leaderboard.init(world: { [string]: any })
	local boards: { [string]: BasePart } = world.boards or {}
	for _, board in boards do
		renderBoard(board, {})
	end
	Remotes.handle("GetBoards", function()
		return true, Leaderboard.rows
	end)
	task.spawn(function()
		while true do
			for _, player in Players:GetPlayers() do
				updateStats(player)
			end
			task.wait(1)
		end
	end)
	task.spawn(function()
		task.wait(10)
		while true do
			pcall(pushScores)
			local ok, err = pcall(function()
				Leaderboard.rows.power = fetch(stores.power, function(v)
					return Format.abbrev(decodePower(v))
				end)
				Leaderboard.rows.rebirths = fetch(stores.rebirths, function(v)
					return tostring(v)
				end)
				Leaderboard.rows.arena = fetch(stores.arena, function(v)
					return tostring(v)
				end)
				for id, board in boards do
					renderBoard(board, Leaderboard.rows[id] or {})
				end
			end)
			if not ok then
				warn("[Leaderboard]", err)
			end
			task.wait(Config.LeaderboardUpdateInterval)
		end
	end)
end

return Leaderboard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">LiveEventService</string>
            <string name="Source"><![CDATA[--!strict
-- Live events: the UTC schedule (Power Hour every 3 h, Spark Weekend) plus an admin override
-- (/event <id> <minutes>) shared across servers with MessagingService. Pushes the effects into
-- State.eventEffects (training / Sparks multipliers) and tells clients through LiveEventUpdate.
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local Config = require(ReplicatedStorage.Shared.Config)
local LiveEvents = require(ReplicatedStorage.Shared.LiveEvents)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local M = Locale.m

local LiveEventService = {}

local TOPIC = "KIW_LiveEvent"
local override: LiveEvents.Override? = nil
local lastKey = ""

local function payload(): { [string]: any }
	local now = os.time()
	local active = LiveEvents.active(now, override)
	local nextAt, nextId = LiveEvents.nextStart(now)
	return { active = active, current = active[1], nextAt = nextAt, nextId = nextId, serverTime = now }
end

local function isAdmin(userId: number): boolean
	return table.find(Config.AdminUserIds, userId) ~= nil
end

-- Recomputes the active events; on change updates luck for everyone and notifies clients.
function LiveEventService.refresh(force: boolean?)
	local now = os.time()
	local active = LiveEvents.active(now, override)
	local parts = {}
	for _, a in active do
		table.insert(parts, a.id .. "@" .. a.endsAt)
	end
	local key = table.concat(parts, ",")
	if key == lastKey and not force then
		return
	end
	local started = {}
	for _, a in active do
		if not lastKey:find(a.id .. "@", 1, true) then
			table.insert(started, a.id)
		end
	end
	lastKey = key
	State.eventEffects = LiveEvents.effects(active)
	for _, player in Players:GetPlayers() do
		State.dirty(player)
	end
	local data = payload()
	data.started = started
	Remotes.fireAll("LiveEventUpdate", data)
end

function LiveEventService.onReady(player: Player)
	Remotes.fire("LiveEventUpdate", player, payload())
end

function LiveEventService.setOverride(id: string, endsAt: number)
	override = { id = id, endsAt = endsAt }
	LiveEventService.refresh()
end

-- "/event PowerHour 15" from an admin. Returns ok, message.
function LiveEventService.command(userId: number, text: string): (boolean, Locale.Message)
	if not isAdmin(userId) then
		return false, M("msg.admin_only")
	end
	local id, minutesText = text:match("^%s*/event%s+(%w+)%s+(%d+)%s*$")
	local minutes = tonumber(minutesText)
	if not id or not Config.LiveEventDefs[id] or not minutes or minutes < 1 or minutes > Config.LiveEventMaxMinutes then
		return false, M("msg.event_usage", { max = Config.LiveEventMaxMinutes })
	end
	local endsAt = os.time() + minutes * 60
	LiveEventService.setOverride(id, endsAt)
	if game.PlaceId ~= 0 then
		task.spawn(pcall, function()
			MessagingService:PublishAsync(TOPIC, { id = id, endsAt = endsAt })
		end)
	end
	return true, M("msg.event_started", { event = M("event." .. id), minutes = minutes })
end

function LiveEventService.init()
	State.eventEffects = LiveEvents.effects(LiveEvents.active(os.time(), nil))

	if game.PlaceId ~= 0 then
		task.spawn(function()
			pcall(function()
				MessagingService:SubscribeAsync(TOPIC, function(message)
					local d = message.Data
					if type(d) == "table" and type(d.id) == "string" and Config.LiveEventDefs[d.id] and type(d.endsAt) == "number" then
						override = { id = d.id, endsAt = math.min(d.endsAt, os.time() + Config.LiveEventMaxMinutes * 60) }
						LiveEventService.refresh()
					end
				end)
			end)
		end)
	end

	-- admin chat command
	task.spawn(function()
		local ok, err = pcall(function()
			local cmd = Instance.new("TextChatCommand")
			cmd.Name = "LiveEventCommand"
			cmd.PrimaryAlias = "/event"
			cmd.Triggered:Connect(function(source: TextSource, text: string)
				local player = Players:GetPlayerByUserId(source.UserId)
				if not player then
					return
				end
				local _, message = LiveEventService.command(source.UserId, text)
				Remotes.notify(player, message, "info")
			end)
			cmd.Parent = TextChatService:WaitForChild("TextChatCommands", 10) or TextChatService
		end)
		if not ok then
			warn("[LiveEvents] chat command unavailable:", err)
		end
	end)

	task.spawn(function()
		while true do
			LiveEventService.refresh()
			task.wait(1)
		end
	end)
end

return LiveEventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Monetization</string>
            <string name="Source"><![CDATA[--!strict
-- Game passes (ownership cache + purchase-finished grant) and developer products
-- (ProcessReceipt, idempotent by PurchaseId stored in the profile and saved before
-- returning PurchaseGranted). Nothing sold here is random: the Starter Pack gives a fixed aura.
local AdService = game:GetService("AdService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local M = Locale.m
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Rewards = require(script.Parent.Rewards)
local Relics = require(script.Parent.Relics)
local Training = require(script.Parent.Training)

local Monetization = {}

local MAX_RECEIPTS = 60

-- Lookups read Config every time, so IDs pasted into Config (or set by a test) just work.
local function passByGamepassId(id: number): any
	for _, pass in Config.Passes do
		if pass.id ~= 0 and pass.id == id then
			return pass
		end
	end
	return nil
end
local function productById(id: number): any
	for _, product in Config.Products do
		if product.id ~= 0 and product.id == id then
			return product
		end
	end
	return nil
end
local function adPlacementById(id: number): string?
	for placement, pid in Config.AdProducts :: { [string]: number } do
		if pid ~= 0 and pid == id then
			return placement
		end
	end
	return nil
end

-- Starter Pack: live product, not bought, within 24 h of the first join.
function Monetization.starterState(p: Data.Profile): { available: boolean, endsAt: number, price: number, fullPrice: number }
	local product = Config.ProductByKey.StarterPack
	local endsAt = p.firstJoin + Config.StarterPack.windowSeconds
	local available = product ~= nil and product.id ~= 0 and not p.starterBought and os.time() < endsAt
	return { available = available, endsAt = endsAt, price = if product then product.price else 0, fullPrice = Config.StarterPack.fullPrice }
end

local function adDay(): number
	return os.time() // 86400
end

local function adsLeft(p: Data.Profile): number
	if p.ads.day ~= adDay() then
		return Config.AdDailyCap
	end
	return math.max(0, Config.AdDailyCap - p.ads.count)
end

-- What a product gives. Also used by the playtest (no Robux involved there).
function Monetization.grantProduct(player: Player, key: string): boolean
	local p = Data.get(player)
	local product = Config.ProductByKey[key]
	if not p or not product then
		return false
	end
	if product.kind == "starter" then
		p.starterBought = true
		State.addGems(player, Config.StarterPack.gems)
		p.boostLeft += Config.StarterPack.boostMinutes * 60
		local aura = Config.StarterPack.aura
		p.auras[aura] = (p.auras[aura] or 0) + 1
		if p.auraEquipped == "" then
			p.auraEquipped = aura
			local char = player.Character
			if char then
				char:SetAttribute("Aura", aura)
			end
		end
	elseif product.kind == "wish" then
		Relics.completeSet(player)
	else
		Rewards.grant(player, { kind = product.kind, amount = product.amount })
	end
	State.dirty(player)
	return true
end

local function grantAd(player: Player, p: Data.Profile, placement: string)
	if placement == "AdBoost" then
		p.boostLeft += Config.AdBoostMinutes * 60
		State.dirty(player)
		Remotes.notify(player, M("reward.boost", { n = Config.AdBoostMinutes }), "success")
	elseif placement == "AdSpin" then
		Rewards.grant(player, { kind = "spins", amount = 1 })
	end
end

local function onPassChanged(player: Player)
	Training.applyMovement(player)
	local char = player.Character
	if char then
		char:SetAttribute("VIP", State.owns(player, "VIP"))
	end
	local p = Data.get(player)
	if p and State.owns(player, "VIP") and not p.auras.vip_gold then
		p.auras.vip_gold = 1
	end
	State.dirty(player)
end
Monetization.onPassChanged = onPassChanged

-- Called once per join (yields on web calls).
function Monetization.loadPasses(player: Player)
	local owned = State.passes[player] or {}
	State.passes[player] = owned
	local grantAll = Config.StudioGrantAllPasses and RunService:IsStudio()
	for _, pass in Config.Passes do
		if grantAll then
			owned[pass.key] = true
		elseif pass.id ~= 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.id)
			end)
			if ok and has then
				owned[pass.key] = true
			end
		end
	end
	local p = Data.get(player)
	if p and owned.VIP and not p.auras.vip_gold then
		p.auras.vip_gold = 1
	end
end

local function processReceipt(receipt: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local p = Data.get(player)
	if not p or not State.ready[player] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	if table.find(p.purchases, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- already granted earlier
	end
	local product = productById(receipt.ProductId)
	local adPlacement = adPlacementById(receipt.ProductId)
	if not product and not adPlacement then
		warn("[Monetization] unknown product", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, err = pcall(function()
		if adPlacement then
			grantAd(player, p, adPlacement)
		elseif product then
			Monetization.grantProduct(player, product.key)
		end
	end)
	if not ok then
		warn("[Monetization] grant failed", err)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(p.purchases, purchaseId)
	while #p.purchases > MAX_RECEIPTS do
		table.remove(p.purchases, 1)
	end
	-- Persist before acknowledging, so a crash cannot grant twice or lose the purchase.
	if Data.isPersistent(player) and not Data.save(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if product then
		Remotes.notify(player, M("msg.thanks", { item = M("product." .. product.key .. ".name") }), "success")
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end
Monetization.processReceipt = processReceipt

function Monetization.init()
	MarketplaceService.ProcessReceipt = processReceipt

	State.extras.starter = function(_player, p)
		return Monetization.starterState(p)
	end
	State.extras.ads = function(_player, p)
		return { left = adsLeft(p), boost = Config.AdProducts.AdBoost ~= 0, spin = Config.AdProducts.AdSpin ~= 0 }
	end

	-- Rewarded video: validate the placement and daily cap, then show the ad. The reward
	-- itself arrives through ProcessReceipt (the ad is tied to a developer product).
	Remotes.handle("WatchAd", function(player, payload)
		local p = Data.get(player)
		local placement = payload.placement
		local id = if type(placement) == "string" then (Config.AdProducts :: any)[placement] else nil
		if not p or type(id) ~= "number" or id == 0 then
			return false, M("msg.ad_unavailable")
		end
		if adsLeft(p) <= 0 then
			return false, M("msg.ad_cap")
		end
		if p.ads.day ~= adDay() then
			p.ads = { day = adDay(), count = 0 }
		end
		local ok, result = pcall(function()
			local reward = (AdService :: any):CreateAdRewardFromDevProductId(id)
			return (AdService :: any):ShowRewardedVideoAdAsync(player, reward)
		end)
		if not ok then
			warn("[Monetization] ad failed", result)
			return false, M("msg.ad_unavailable")
		end
		p.ads.count += 1
		State.dirty(player)
		return true, tostring(if typeof(result) == "EnumItem" then (result :: any).Name else result)
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, gamePassId: number, purchased: boolean)
		if not purchased then
			return
		end
		local pass = passByGamepassId(gamePassId)
		if pass then
			State.passes[player] = State.passes[player] or {}
			State.passes[player][pass.key] = true
			onPassChanged(player)
			Remotes.notify(player, M("msg.pass_unlocked", { item = M("pass." .. pass.key .. ".name") }), "success")
		end
	end)
end

return Monetization
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Npcs</string>
            <string name="Source"><![CDATA[--!strict
-- Enemies. The server owns a tiny invisible anchored "root" part per enemy (position, HP and
-- state as attributes) and runs every AI in ONE 10 Hz loop; clients build and animate the
-- visible model around each root (NpcRender). Only planets with players keep enemies spawned.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Hooks = require(script.Parent.Hooks)
local Fighters = require(script.Parent.Fighters)
local Combat = require(script.Parent.Combat)

type Fighter = Fighters.Fighter
local AI = Config.NpcAi

local Npcs = {}

type Npc = {
	f: Fighter,
	def: any,
	planet: number,
	home: Vector3,
	roam: number, -- roam radius around home
	pos: Vector3,
	yaw: number,
	target: Fighter?,
	state: string, -- idle | chase | windup | recover | dead | return
	stateUntil: number,
	attack: string?, -- melee | ranged | slam | volley | charge
	attackDir: Vector3?,
	nextAttackAt: number,
	nextPatternAt: number,
	respawnAt: number,
	wanderTo: Vector3?,
	wanderAt: number,
	spawned: boolean,
	persistent: boolean?, -- world boss: not tied to planet activity, never respawns
	onDeath: ((Npc, Fighter?) -> ())?,
}

local folder: Folder
local npcs: { Npc } = {}
local byFighter: { [Fighter]: Npc } = {}
local activePlanets: { [number]: boolean } = {}
local rng = Random.new()

Npcs.list = npcs

function Npcs.activeCount(): number
	local n = 0
	for _, npc in npcs do
		if npc.spawned then
			n += 1
		end
	end
	return n
end

local function hoverHeight(def: any): number
	local s = def.scale or 1
	if def.arch == "wisp" then
		return 5.5 * s
	end
	return 3 * s
end

local function place(npc: Npc)
	local root = npc.f.root :: BasePart
	root.CFrame = CFrame.new(npc.pos) * CFrame.Angles(0, npc.yaw, 0)
end

local function setState(npc: Npc, state: string, duration: number?)
	npc.state = state
	npc.stateUntil = os.clock() + (duration or 0)
	local root = npc.f.root
	if root then
		root:SetAttribute("State", state)
	end
end

local function spawn(npc: Npc)
	local f = npc.f
	local root = f.root :: BasePart
	f.hp = f.maxHp
	f.alive = true
	f.contributions = {}
	f.knock = nil
	npc.pos = npc.home
	npc.target = nil
	npc.spawned = true
	npc.nextAttackAt = 0
	npc.nextPatternAt = os.clock() + 2
	root:SetAttribute("Hp", f.hp)
	root:SetAttribute("MaxHp", f.maxHp)
	setState(npc, "idle")
	place(npc)
	root.Parent = folder
end

local function despawn(npc: Npc)
	npc.spawned = false
	npc.f.alive = false
	local root = npc.f.root
	if root then
		root.Parent = nil
	end
end

-- Creates an enemy (not yet spawned). hp overrides the Config value (world boss).
function Npcs.create(npcId: string, planet: number, home: Vector3, roam: number, hp: number?): Npc
	local def = Config.Npcs[npcId]
	local s = def.scale or 1
	local root = Instance.new("Part")
	root.Name = npcId
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CastShadow = false
	root.Transparency = 1
	root.Size = Vector3.new(3.5, 6, 3.5) * s
	local y = Config.GroundY + hoverHeight(def)
	local f = Fighters.addNpc(def, root, hp or def.hp)
	f.alive = false
	root:SetAttribute("Kind", npcId)
	root:SetAttribute("FighterId", f.id)
	local npc: Npc = {
		f = f,
		def = def,
		planet = planet,
		home = Vector3.new(home.X, y, home.Z),
		roam = roam,
		pos = Vector3.new(home.X, y, home.Z),
		yaw = rng:NextNumber(0, math.pi * 2),
		state = "dead",
		stateUntil = 0,
		nextAttackAt = 0,
		nextPatternAt = 0,
		respawnAt = 0,
		wanderAt = 0,
		spawned = false,
	}
	f.npc = npc
	table.insert(npcs, npc)
	byFighter[f] = npc
	return npc
end

function Npcs.spawn(npc: Npc)
	spawn(npc)
end

function Npcs.destroy(npc: Npc)
	despawn(npc)
	Fighters.remove(npc.f)
	byFighter[npc.f] = nil
	local i = table.find(npcs, npc)
	if i then
		table.remove(npcs, i)
	end
	local root = npc.f.root
	if root then
		root:Destroy()
	end
end

local function nearestPlayer(npc: Npc, range: number): Fighter?
	local best: Fighter? = nil
	local bestD = range
	for _, f in Fighters.list do
		if f.kind == "player" and not f.dummy and f.alive then
			local p = Fighters.position(f)
			if p then
				local d = (p - npc.pos).Magnitude
				if d < bestD and (p - npc.home).Magnitude < AI.leashRange + npc.roam then
					best, bestD = f, d
				end
			end
		end
	end
	return best
end

local function face(npc: Npc, toward: Vector3)
	local d = toward - npc.pos
	if math.abs(d.X) + math.abs(d.Z) > 0.05 then
		npc.yaw = math.atan2(-d.X, -d.Z)
	end
end

local function moveToward(npc: Npc, toward: Vector3, speed: number, dt: number): number
	local flat = (toward - npc.pos) * Vector3.new(1, 0, 1)
	local dist = flat.Magnitude
	if dist > 0.05 then
		local step = math.min(dist, speed * dt)
		npc.pos += flat.Unit * step
		face(npc, toward)
	end
	return dist
end

local function hit(npc: Npc, victim: Fighter, mult: number, knock: number)
	local def = npc.def
	Fighters.damage(npc.f, victim, "npc", def.dmg * mult, {
		knock = knock,
		fraction = if def.world then Config.WorldBoss.damageMultToPlayers * mult else nil,
	})
end

local function telegraph(kind: string, data: { [string]: any })
	data.k = kind
	Remotes.fireAll("Fx", "telegraph", data)
end

-- Starts an attack (windup). The damage lands in `resolve` when the windup ends.
local function startAttack(npc: Npc, attack: string, target: Fighter)
	local tp = Fighters.position(target) or npc.pos
	npc.attack = attack
	face(npc, tp)
	local enraged = npc.def.boss and npc.f.hp / npc.f.maxHp <= AI.enrageAt
	local speedUp = if enraged then 0.75 else 1
	if attack == "melee" then
		setState(npc, "windup", AI.meleeWindup * speedUp)
	elseif attack == "ranged" then
		setState(npc, "windup", AI.rangedWindup * speedUp)
	elseif attack == "slam" then
		setState(npc, "windup", AI.slamWindup * speedUp)
		telegraph("ring", { p = Vector3.new(npc.pos.X, Config.GroundY + 0.3, npc.pos.Z), r = AI.slamRadius * (npc.def.scale / 2.4), t = AI.slamWindup * speedUp })
	elseif attack == "volley" then
		setState(npc, "windup", 0.7 * speedUp)
	elseif attack == "charge" then
		local dir = (tp - npc.pos) * Vector3.new(1, 0, 1)
		dir = if dir.Magnitude > 0.1 then dir.Unit else Vector3.new(0, 0, 1)
		npc.attackDir = dir
		setState(npc, "windup", AI.chargeWindup * speedUp)
		telegraph("line", { p = Vector3.new(npc.pos.X, Config.GroundY + 0.3, npc.pos.Z), d = dir, l = AI.chargeDistance, w = 9 * (npc.def.scale / 2.4), t = AI.chargeWindup * speedUp })
	end
	local root = npc.f.root
	if root then
		root:SetAttribute("Attack", attack)
	end
end

local function resolve(npc: Npc)
	local attack = npc.attack
	local def = npc.def
	local now = os.clock()
	local target = npc.target
	npc.attack = nil
	if attack == "melee" then
		if target and target.alive then
			local tp = Fighters.position(target)
			if tp and (tp - npc.pos).Magnitude <= AI.meleeRange + npc.f.radius + 3 then
				hit(npc, target, 1, 30)
			end
		end
		npc.nextAttackAt = now + AI.meleeCooldown
		setState(npc, "recover", 0.35)
	elseif attack == "ranged" then
		if target and target.alive then
			local tp = Fighters.position(target)
			if tp then
				local origin = npc.pos + Vector3.new(0, 1, 0)
				local dir = (tp - origin)
				if dir.Magnitude > 0.1 then
					Combat.spawnProjectile(npc.f, origin + dir.Unit * (npc.f.radius + 1), dir.Unit, {
						speed = AI.projectileSpeed,
						range = AI.rangedRange + 40,
						radius = 3,
						kind = "npc",
						damage = def.dmg,
						knock = 16,
						color = def.accent,
					})
				end
			end
		end
		npc.nextAttackAt = now + AI.rangedCooldown
		setState(npc, "recover", 0.3)
	elseif attack == "slam" then
		local radius = AI.slamRadius * (def.scale / 2.4)
		for _, f in Fighters.list do
			if f.kind == "player" and not f.dummy and f.alive then
				local p = Fighters.position(f)
				-- jumping or flying above the ring dodges it
				if p and ((p - npc.pos) * Vector3.new(1, 0, 1)).Magnitude <= radius and p.Y < Config.GroundY + 9 then
					hit(npc, f, AI.slamDamageMult, 70)
				end
			end
		end
		Remotes.fireAll("Fx", "shock", { p = Vector3.new(npc.pos.X, Config.GroundY + 0.5, npc.pos.Z), r = radius, n = npc.f.id })
		npc.nextPatternAt = now + AI.patternCooldown
		setState(npc, "recover", 0.8)
	elseif attack == "volley" then
		if target and target.alive then
			local tp = Fighters.position(target)
			if tp then
				local origin = npc.pos + Vector3.new(0, 2, 0)
				local base = CFrame.lookAt(origin, tp)
				for i = 1, AI.volleyShots do
					local a = (i - (AI.volleyShots + 1) / 2) * math.rad(9)
					local dir = (base * CFrame.Angles(0, a, 0)).LookVector
					Combat.spawnProjectile(npc.f, origin + dir * (npc.f.radius + 1), dir, {
						speed = AI.projectileSpeed * 0.9,
						range = 150,
						radius = 3.4,
						kind = "npc",
						damage = def.dmg * 0.8,
						knock = 20,
						color = def.accent,
						fraction = if def.world then Config.WorldBoss.damageMultToPlayers * 0.8 else nil,
					})
				end
			end
		end
		npc.nextPatternAt = now + AI.patternCooldown
		setState(npc, "recover", 0.6)
	elseif attack == "charge" then
		setState(npc, "charging", AI.chargeDistance / AI.chargeSpeed)
		npc.f.cd.chargeHit = 0
	end
end

local function reward(npc: Npc, killer: Fighter?)
	local def = npc.def
	local contributions: { [Player]: number } = npc.f.contributions or {}
	for player in contributions do
		local p = Data.get(player)
		if p and player.Parent then
			local gained = 0
			if def.sparks > 0 then
				gained = State.addSparks(player, def.sparks, true)
			end
			if def.gems then
				State.addGems(player, def.gems)
			end
			p.kills += 1
			if def.boss then
				p.bossKills[def.id] = (p.bossKills[def.id] or 0) + 1
				State.dirty(player)
			end
			Remotes.fire("Combat", player, "kill", { n = def.id, s = gained, g = def.gems or 0, b = def.boss == true })
			Hooks.fire("npcKilled", player, def.id, def)
		end
	end
	local _ = killer
end

local function die(npc: Npc, killer: Fighter?)
	Remotes.fireAll("Fx", "npcDeath", { i = npc.f.id, p = npc.pos, k = npc.def.id, b = npc.def.boss == true })
	if npc.onDeath then
		npc.onDeath(npc, killer)
	else
		reward(npc, killer)
	end
	npc.state = "dead"
	npc.respawnAt = os.clock() + npc.def.respawn
	npc.spawned = false
	local root = npc.f.root
	if root then
		root.Parent = nil
	end
end

local function think(npc: Npc, dt: number, now: number)
	local def = npc.def
	local f = npc.f
	-- knockback
	local knock = f.knock
	if knock then
		npc.pos += Vector3.new(knock.X, 0, knock.Z) * dt
		f.knock = if knock.Magnitude > 6 then knock * 0.55 else nil
	end

	if npc.state == "windup" then
		if npc.target then
			local tp = Fighters.position(npc.target)
			if tp and npc.attack ~= "charge" and npc.attack ~= "slam" then
				face(npc, tp)
			end
		end
		if now >= npc.stateUntil then
			resolve(npc)
		end
		return
	elseif npc.state == "charging" then
		local dir = npc.attackDir or Vector3.new(0, 0, 1)
		npc.pos += dir * AI.chargeSpeed * dt
		for _, v in Fighters.list do
			if v.kind == "player" and not v.dummy and v.alive and (v.cd["charged" .. f.id] or 0) < now then
				local p = Fighters.position(v)
				if p and (p - npc.pos).Magnitude <= 8 * (def.scale / 2.4) + 3 then
					v.cd["charged" .. f.id] = now + 1
					hit(npc, v, 1.6, 80)
				end
			end
		end
		if now >= npc.stateUntil then
			npc.nextPatternAt = now + AI.patternCooldown
			setState(npc, "recover", 0.7)
		end
		return
	elseif npc.state == "recover" then
		if now >= npc.stateUntil then
			setState(npc, "chase")
		end
		return
	end

	-- target upkeep
	local target = npc.target
	if target then
		local tp = Fighters.position(target)
		if not target.alive or not tp or (tp - npc.home).Magnitude > AI.leashRange + npc.roam then
			npc.target = nil
			target = nil
		end
	end
	if not target then
		-- whoever hit us last, or whoever walks in
		target = nearestPlayer(npc, AI.aggroRange * (if def.boss then 1.4 else 1))
		if not target and next(f.contributions or {}) then
			target = nearestPlayer(npc, AI.leashRange)
		end
		npc.target = target
	end

	if not target then
		-- go home, heal, wander a little
		local homeDist = ((npc.home - npc.pos) * Vector3.new(1, 0, 1)).Magnitude
		if homeDist > npc.roam then
			moveToward(npc, npc.home, def.speed, dt)
			if npc.state ~= "return" then
				setState(npc, "return")
			end
		else
			if npc.state ~= "idle" then
				setState(npc, "idle")
				if f.hp < f.maxHp then
					f.hp = f.maxHp
					f.contributions = {}
					local root = f.root
					if root then
						root:SetAttribute("Hp", f.hp)
					end
				end
			end
			if not def.boss then
				if now >= npc.wanderAt then
					npc.wanderAt = now + rng:NextNumber(3, 7)
					local a = rng:NextNumber(0, math.pi * 2)
					local r = rng:NextNumber(0, npc.roam)
					npc.wanderTo = npc.home + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
				end
				if npc.wanderTo then
					if moveToward(npc, npc.wanderTo, def.speed * 0.35, dt) < 1 then
						npc.wanderTo = nil
					end
				end
			end
		end
		return
	end

	if npc.state ~= "chase" then
		setState(npc, "chase")
	end
	local tp = Fighters.position(target) :: Vector3
	local flatDist = ((tp - npc.pos) * Vector3.new(1, 0, 1)).Magnitude
	local dist3 = (tp - npc.pos).Magnitude
	local enraged = def.boss and f.hp / f.maxHp <= AI.enrageAt

	if def.ai == "boss" then
		if now >= npc.nextPatternAt then
			local roll = rng:NextNumber()
			local pattern = if flatDist < AI.slamRadius * 0.8 and roll < 0.55 then "slam" elseif roll < 0.5 then "volley" else "charge"
			if flatDist > 80 then
				pattern = "volley"
			end
			npc.nextPatternAt = now + AI.patternCooldown * (if enraged then 0.7 else 1) + 1.5
			startAttack(npc, pattern, target)
			return
		end
		if dist3 <= AI.meleeRange + f.radius and now >= npc.nextAttackAt then
			startAttack(npc, "melee", target)
			return
		end
		if flatDist > AI.meleeRange + f.radius - 2 then
			moveToward(npc, tp, def.speed * (if enraged then 1.25 else 1), dt)
		else
			face(npc, tp)
		end
	elseif def.ai == "ranged" then
		if flatDist > AI.rangedRange then
			moveToward(npc, tp, def.speed, dt)
		elseif flatDist < AI.rangedKeep * 0.6 then
			-- back off
			local away = npc.pos + (npc.pos - tp) * Vector3.new(1, 0, 1)
			moveToward(npc, away, def.speed * 0.7, dt)
			face(npc, tp)
		else
			face(npc, tp)
		end
		if dist3 <= AI.rangedRange + 25 and now >= npc.nextAttackAt then
			startAttack(npc, "ranged", target)
		end
	else
		if dist3 <= AI.meleeRange + f.radius then
			face(npc, tp)
			if now >= npc.nextAttackAt then
				startAttack(npc, "melee", target)
			end
		else
			moveToward(npc, tp, def.speed, dt)
		end
	end
end

local function refreshActivePlanets()
	local active: { [number]: boolean } = {}
	for _, player in Players:GetPlayers() do
		local p = Data.get(player)
		if p and State.ready[player] then
			active[p.planet] = true
		end
	end
	activePlanets = active
end

function Npcs.init()
	folder = Instance.new("Folder")
	folder.Name = "Enemies"
	folder.Parent = workspace

	Fighters.onNpcDeath = function(f: Fighter, killer: Fighter?)
		local npc = byFighter[f]
		if npc then
			die(npc, killer)
		end
	end

	for _, pl in Config.Planets do
		local cx, _, cz = Config.planetCenter(pl.index)
		for _, camp in pl.camps do
			for i = 1, camp.count do
				local a = (i / camp.count) * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
				local r = camp.radius * rng:NextNumber(0.25, 0.85)
				local home = Vector3.new(cx + camp.offset[1] + math.cos(a) * r, 0, cz + camp.offset[3] + math.sin(a) * r)
				Npcs.create(camp.npc, pl.index, home, 12)
			end
		end
		local b = pl.boss
		Npcs.create(b.npc, pl.index, Vector3.new(cx + b.offset[1], 0, cz + b.offset[3]), 6)
	end

	task.spawn(function()
		local last = os.clock()
		local acc = 0
		while true do
			task.wait(1 / AI.tickRate)
			local now = os.clock()
			local dt = math.min(now - last, 0.3)
			last = now
			acc += dt
			if acc >= 1 then
				acc = 0
				refreshActivePlanets()
			end
			for _, npc in npcs do
				if npc.persistent then
					if npc.spawned then
						think(npc, dt, now)
						place(npc)
					end
					continue
				end
				local active = activePlanets[npc.planet] == true
				if npc.spawned then
					if not active then
						despawn(npc)
						npc.respawnAt = 0
					else
						think(npc, dt, now)
						if npc.spawned then
							place(npc)
						end
					end
				elseif active and now >= npc.respawnAt then
					spawn(npc)
				end
			end
		end
	end)
end

return Npcs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Offline</string>
            <string name="Source"><![CDATA[--!strict
-- Offline training: while away, the selected stat keeps training at a fraction of the
-- auto-train rate (capped at 4 h, 8 h with VIP). On join the gain waits as offlinePending
-- and is claimed with ClaimOffline. An unclaimed amount is only replaced by a larger one.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Format = require(ReplicatedStorage.Shared.Format)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Combat = require(script.Parent.Combat)
local M = Locale.m

local Offline = {}

function Offline.capSeconds(player: Player): number
	return if State.owns(player, "VIP") then Config.Offline.vipCapSeconds else Config.Offline.capSeconds
end

-- Call after passes are loaded (uses the live per-rep gain, without a training zone).
function Offline.compute(player: Player, now: number?)
	local p = Data.get(player)
	if not p then
		return
	end
	local t = now or os.time()
	local seconds = math.clamp(t - (p.savedAt or t), 0, Offline.capSeconds(player))
	if seconds < Config.Offline.minSeconds then
		return
	end
	local stat = p.settings.stat
	local gain = State.gainPerRep(player, p, stat) * State.autoRate(player, p) * Config.Offline.rate * seconds
	local pending = p.offlinePending
	local current = if pending then pending[stat] or 0 else 0
	if gain > current then
		p.offlinePending = { [stat] = gain }
		p.offlineSeconds = seconds
		State.dirty(player)
	end
end

function Offline.onJoin(player: Player)
	Offline.compute(player)
end

-- Test hook: pretend the last save was `seconds` ago.
function Offline.fake(player: Player, seconds: number): any
	local p = Data.get(player)
	if not p then
		return nil
	end
	p.savedAt = os.time() - seconds
	p.offlinePending = nil
	Offline.compute(player)
	return { pending = p.offlinePending, seconds = p.offlineSeconds, cap = Offline.capSeconds(player), perRep = State.gainPerRep(player, p, p.settings.stat), rate = State.autoRate(player, p) }
end

function Offline.init()
	State.extras.offline = function(_player, p)
		return { pending = p.offlinePending, seconds = p.offlineSeconds or 0 }
	end
	Remotes.handle("ClaimOffline", function(player)
		local p = Data.get(player)
		local pending = p and p.offlinePending
		if not p or not pending then
			return false, M("msg.nothing_to_claim")
		end
		local total = 0
		for stat, amount in pending do
			if p.stats[stat] then
				p.stats[stat] += amount
				total += amount
			end
		end
		p.offlinePending = nil
		p.offlineSeconds = 0
		local power = State.power(p)
		if power > p.bestPower then
			p.bestPower = power
			Combat.refreshForms(player)
		end
		State.dirty(player)
		return true, M("reward.offline", { n = Format.abbrev(total) })
	end)
end

return Offline
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Progression</string>
            <string name="Source"><![CDATA[--!strict
-- Planets (unlock / travel / spawn placement), techniques, gem upgrades, races and rebirth.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Hooks = require(script.Parent.Hooks)
local Fighters = require(script.Parent.Fighters)
local M = Locale.m

local Progression = {}

-- Server teleports are whitelisted for the movement sanity check.
Progression.teleportedAt = {} :: { [Player]: number }

function Progression.spawnCFrame(planet: number): CFrame
	local cx, cy, cz = Config.planetCenter(planet)
	return CFrame.new(cx, cy + 6, cz + 18) * CFrame.Angles(0, math.rad(180), 0)
end

function Progression.teleport(player: Player, cf: CFrame)
	local char = player.Character
	if not char then
		return
	end
	Progression.teleportedAt[player] = os.clock()
	task.spawn(function()
		pcall(function()
			player:RequestStreamAroundAsync(cf.Position, 5)
		end)
		if char.Parent then
			local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				root.AssemblyLinearVelocity = Vector3.zero
			end
			char:PivotTo(cf)
			Progression.teleportedAt[player] = os.clock()
		end
	end)
end

function Progression.toPlanet(player: Player, planet: number)
	local p = Data.get(player)
	if not p then
		return
	end
	p.planet = planet
	local f = Fighters.ofPlayer(player)
	if f then
		f.invulnerableUntil = math.max(f.invulnerableUntil, os.clock() + 3)
	end
	Progression.teleport(player, Progression.spawnCFrame(planet))
	Hooks.fire("travel", player, planet)
	State.dirty(player)
end

function Progression.placeOnSpawn(player: Player)
	local p = Data.get(player)
	if p then
		Progression.teleport(player, Progression.spawnCFrame(p.planet))
	end
end

function Progression.doRebirth(player: Player): (boolean, any)
	local p = Data.get(player)
	if not p then
		return false, M("msg.error")
	end
	local need = Formulas.rebirthRequirement(p.rebirths)
	if State.power(p) < need then
		return false, M("msg.need_power")
	end
	p.rebirths += 1
	for _, s in Config.Stats do
		p.stats[s] = Config.StartStat
	end
	p.sparks = 0
	p.gear = 1
	p.planets = { 1 }
	p.bestPower = 0
	State.addGems(player, Config.Rebirth.gems)
	local f = Fighters.ofPlayer(player)
	if f then
		f.form = 0
		Fighters.setAttr(f, "Form", 0)
	end
	Progression.toPlanet(player, 1)
	Hooks.fire("rebirth", player, p.rebirths)
	Remotes.fireAll("Fx", "rebirth", { u = player.UserId, n = p.rebirths })
	State.dirty(player)
	return true, p.rebirths
end

function Progression.init()
	Remotes.handle("Travel", function(player, payload)
		local p = Data.get(player)
		local index = payload.planet
		if not p or type(index) ~= "number" or not Config.Planets[index] then
			return false, M("msg.bad_request")
		end
		local f = Fighters.ofPlayer(player)
		if not f or not f.alive then
			return false, M("msg.error")
		end
		if os.clock() - f.lastDamagedAt < 4 then
			return false, M("msg.in_combat")
		end
		local pl = Config.Planets[index]
		if not table.find(p.planets, index) then
			if math.max(State.power(p), p.bestPower) < pl.reqPower then
				return false, M("msg.need_power")
			end
			if not State.spendSparks(player, pl.cost) then
				return false, M("msg.need_sparks")
			end
			table.insert(p.planets, index)
			Remotes.fire("Combat", player, "planetUnlocked", index)
		end
		Progression.toPlanet(player, index)
		return true
	end)

	Remotes.handle("BuyTechnique", function(player, payload)
		local p = Data.get(player)
		local t = if type(payload.id) == "string" then Config.TechniqueById[payload.id] else nil
		if not p or not t then
			return false, M("msg.bad_request")
		end
		if p.techniques[t.id] then
			return false, M("msg.already_owned")
		end
		if math.max(State.power(p), p.bestPower) < t.reqPower then
			return false, M("msg.need_power")
		end
		if not State.spendSparks(player, t.cost) then
			return false, M("msg.need_sparks")
		end
		p.techniques[t.id] = true
		Hooks.fire("techniqueBought", player, t.id)
		State.dirty(player)
		return true
	end)

	Remotes.handle("BuyUpgrade", function(player, payload)
		local p = Data.get(player)
		local u = if type(payload.id) == "string" then Config.UpgradeById[payload.id] else nil
		if not p or not u then
			return false, M("msg.bad_request")
		end
		local level = p.upgrades[u.id] or 0
		if level >= u.max then
			return false, M("msg.maxed")
		end
		if not State.spendGems(player, Formulas.upgradeCost(u.id, level)) then
			return false, M("msg.need_gems")
		end
		p.upgrades[u.id] = level + 1
		State.dirty(player)
		return true, level + 1
	end)

	Remotes.handle("SetRace", function(player, payload)
		local p = Data.get(player)
		local r = if type(payload.id) == "string" then Config.RaceById[payload.id] else nil
		if not p or not r then
			return false, M("msg.bad_request")
		end
		if p.race == r.id then
			return true
		end
		if p.raceChanges > 0 and not State.spendGems(player, Config.RaceChangeGems) then
			return false, M("msg.need_gems")
		end
		p.raceChanges += 1
		p.race = r.id
		local char = player.Character
		if char then
			char:SetAttribute("Race", r.id)
		end
		State.dirty(player)
		return true
	end)

	Remotes.handle("Rebirth", function(player)
		return Progression.doRebirth(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		Progression.teleportedAt[player] = nil
	end)
end

return Progression
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[--!strict
-- Daily quests: 3 per UTC day (Shared/Quests), progress from gameplay hooks, gem rewards and a
-- gem bonus for finishing all three. Progress is pushed with the small "Quests" event
-- (throttled) instead of full state snapshots.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Quests = require(ReplicatedStorage.Shared.Quests)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Rewards = require(script.Parent.Rewards)
local Hooks = require(script.Parent.Hooks)
local M = Locale.m

local QuestService = {}

local dirty: { [Player]: boolean } = {}
local lastPush: { [Player]: number } = {}
local PUSH_INTERVAL = 2

-- Makes sure the profile holds today's quests (fresh list at the first access of a new day).
function QuestService.ensure(player: Player, forcedKinds: { string }?): Data.Profile?
	local p = Data.get(player)
	if not p then
		return nil
	end
	local day = Quests.today(os.time())
	if p.quests.day ~= day or forcedKinds then
		local planet = State.bestPlanet(p)
		local list = Quests.forDay(day, planet)
		if forcedKinds then
			local byKind = {}
			for _, def in Config.QuestPool do
				byKind[def.kind] = def
			end
			list = {}
			for _, kind in forcedKinds do
				local def = byKind[kind]
				if def then
					table.insert(list, { kind = kind, target = def.targetByPlanet[math.min(planet, #def.targetByPlanet)], gems = def.gems })
				end
			end
		end
		p.quests = { day = day, list = list, progress = {}, claimed = {}, bonusClaimed = false }
		for i in list do
			p.quests.progress[i] = 0
			p.quests.claimed[i] = false
		end
		dirty[player] = true
	end
	return p
end

function QuestService.snapshot(player: Player): { [string]: any }?
	local p = QuestService.ensure(player)
	if not p then
		return nil
	end
	local list = {}
	for i, q in p.quests.list do
		table.insert(list, { kind = q.kind, target = q.target, gems = q.gems, progress = math.min(p.quests.progress[i] or 0, q.target), claimed = p.quests.claimed[i] == true })
	end
	return { list = list, bonusClaimed = p.quests.bonusClaimed, bonus = Config.QuestBonusGems, resetsAt = Quests.resetsAt(os.time()), serverTime = os.time() }
end

function QuestService.add(player: Player, kind: string, amount: number)
	local p = QuestService.ensure(player)
	if not p or amount <= 0 then
		return
	end
	for i, q in p.quests.list do
		if q.kind == kind and not p.quests.claimed[i] then
			local before = p.quests.progress[i] or 0
			if before < q.target then
				p.quests.progress[i] = math.min(q.target, before + amount)
				dirty[player] = true
			end
		end
	end
end

-- Test hook: replace today's list with the given kinds.
function QuestService.force(player: Player, kinds: { string }): any
	QuestService.ensure(player, kinds)
	State.dirty(player)
	return QuestService.snapshot(player)
end

function QuestService.onJoin(player: Player)
	QuestService.ensure(player)
end

function QuestService.init()
	State.extras.quests = function(player)
		return QuestService.snapshot(player)
	end

	Hooks.on("reps", function(player: Player, n: number)
		QuestService.add(player, "reps", n)
	end)
	Hooks.on("npcKilled", function(player: Player, _id: string, def: any)
		QuestService.add(player, if def.boss then "boss" else "defeat", 1)
	end)
	Hooks.on("blast", function(player: Player)
		QuestService.add(player, "blasts", 1)
	end)
	Hooks.on("relic", function(player: Player)
		QuestService.add(player, "relic", 1)
	end)
	Hooks.on("arenaWin", function(player: Player)
		QuestService.add(player, "arena", 1)
	end)

	Remotes.handle("ClaimQuest", function(player, payload)
		local p = QuestService.ensure(player)
		local i = payload.i
		if not p or type(i) ~= "number" or not p.quests.list[i] then
			return false, M("msg.bad_request")
		end
		local q = p.quests.list[i]
		if p.quests.claimed[i] then
			return false, M("msg.already_claimed")
		end
		if (p.quests.progress[i] or 0) < q.target then
			return false, M("msg.not_ready")
		end
		p.quests.claimed[i] = true
		dirty[player] = true
		State.dirty(player)
		return true, Rewards.grant(player, { kind = "gems", amount = q.gems })
	end)

	Remotes.handle("ClaimQuestBonus", function(player)
		local p = QuestService.ensure(player)
		if not p then
			return false, M("msg.error")
		end
		if p.quests.bonusClaimed then
			return false, M("msg.already_claimed")
		end
		for i in p.quests.list do
			if not p.quests.claimed[i] then
				return false, M("msg.quests_first")
			end
		end
		p.quests.bonusClaimed = true
		dirty[player] = true
		State.dirty(player)
		return true, Rewards.grant(player, { kind = "gems", amount = Config.QuestBonusGems })
	end)

	-- play-time quests + day rollover + throttled progress pushes
	task.spawn(function()
		local acc = 0
		while true do
			task.wait(0.5)
			acc += 0.5
			local minute = acc >= 60
			if minute then
				acc -= 60
			end
			for _, player in Players:GetPlayers() do
				if State.ready[player] then
					if minute then
						QuestService.add(player, "minutes", 1)
					end
					QuestService.ensure(player)
					local now = os.clock()
					if dirty[player] and now - (lastPush[player] or 0) >= PUSH_INTERVAL then
						dirty[player] = nil
						lastPush[player] = now
						Remotes.fire("Quests", player, { daily = QuestService.snapshot(player) })
					end
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
		lastPush[player] = nil
	end)
end

return QuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Relics</string>
            <string name="Source"><![CDATA[--!strict
-- Astral Seals: six per-player collectibles scattered over the planets the player has
-- unlocked. Each player has their own set (only you see and collect yours).
-- With all six, the Wish Altar grants one wish; the set then reappears after a cooldown.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Hooks = require(script.Parent.Hooks)
local Fighters = require(script.Parent.Fighters)
local Rewards = require(script.Parent.Rewards)
local M = Locale.m

local Relics = {}

local altar = Vector3.zero

-- The six spots of a set: deterministic from the profile seed and the unlocked planets.
function Relics.spots(p: Data.Profile): { { planet: number, pos: Vector3 } }
	local candidates = {}
	for _, index in p.planets do
		local pl = Config.Planets[index]
		if pl then
			local cx, cy, cz = Config.planetCenter(index)
			for _, o in pl.relicSpots do
				table.insert(candidates, { planet = index, pos = Vector3.new(cx + o[1], cy + 4, cz + o[3]) })
			end
		end
	end
	table.sort(candidates, function(a, b)
		if a.planet ~= b.planet then
			return a.planet < b.planet
		end
		if a.pos.X ~= b.pos.X then
			return a.pos.X < b.pos.X
		end
		return a.pos.Z < b.pos.Z
	end)
	local rng = Random.new(p.relics.seed * 7919 + 17)
	for i = #candidates, 2, -1 do
		local j = rng:NextInteger(1, i)
		candidates[i], candidates[j] = candidates[j], candidates[i]
	end
	local out = {}
	for i = 1, math.min(Config.Relics.count, #candidates) do
		out[i] = candidates[i]
	end
	return out
end

function Relics.count(p: Data.Profile): number
	local n = 0
	for _ in p.relics.found do
		n += 1
	end
	return n
end

function Relics.snapshot(p: Data.Profile): { [string]: any }
	local list = {}
	local now = os.time()
	local available = now >= p.relics.nextAt
	if available then
		for i, spot in Relics.spots(p) do
			table.insert(list, { i = i, planet = spot.planet, pos = spot.pos, found = p.relics.found[tostring(i)] == true })
		end
	end
	return { list = list, found = Relics.count(p), total = Config.Relics.count, nextAt = p.relics.nextAt, serverTime = now, wishes = p.wishes, wishPower = p.wishPower }
end

-- Marks every seal as found (Wish Now product, tests).
function Relics.completeSet(player: Player): boolean
	local p = Data.get(player)
	if not p then
		return false
	end
	p.relics.nextAt = 0
	for i = 1, Config.Relics.count do
		p.relics.found[tostring(i)] = true
	end
	State.dirty(player)
	return true
end

function Relics.skipCooldown(player: Player): boolean
	local p = Data.get(player)
	if p then
		p.relics.nextAt = 0
		State.dirty(player)
	end
	return true
end

function Relics.init(world: { [string]: any })
	altar = world.altarCenter or Vector3.zero

	State.extras.relics = function(_player, p)
		return Relics.snapshot(p)
	end

	Remotes.handle("CollectRelic", function(player, payload)
		local p = Data.get(player)
		local f = Fighters.ofPlayer(player)
		local i = payload.i
		if not p or not f or type(i) ~= "number" then
			return false, M("msg.bad_request")
		end
		if os.time() < p.relics.nextAt then
			return false, M("msg.not_ready")
		end
		local spot = Relics.spots(p)[i]
		local pos = Fighters.position(f)
		if not spot or not pos then
			return false, M("msg.bad_request")
		end
		if p.relics.found[tostring(i)] then
			return false, M("msg.already_claimed")
		end
		if (pos - spot.pos).Magnitude > Config.Relics.pickupRadius + 8 then
			return false, M("msg.too_far")
		end
		p.relics.found[tostring(i)] = true
		Hooks.fire("relic", player, i)
		State.dirty(player)
		return true, Relics.count(p)
	end)

	Remotes.handle("Wish", function(player, payload)
		local p = Data.get(player)
		local f = Fighters.ofPlayer(player)
		if not p or not f or type(payload.id) ~= "string" then
			return false, M("msg.bad_request")
		end
		local wish = nil
		for _, w in Config.Wishes do
			if w.id == payload.id then
				wish = w
			end
		end
		if not wish then
			return false, M("msg.bad_request")
		end
		if Relics.count(p) < Config.Relics.count then
			return false, M("msg.need_seals", { n = Config.Relics.count - Relics.count(p) })
		end
		local pos = Fighters.position(f)
		if not pos or (pos - altar).Magnitude > Config.WishAltar.radius + 24 then
			return false, M("msg.go_to_altar")
		end
		if wish.id == "power" and p.wishPower >= Config.WishPowerMax then
			return false, M("msg.maxed")
		end
		local text
		if wish.sparkMinutes then
			text = Rewards.grant(player, { kind = "sparks", amount = wish.sparkMinutes })
		elseif wish.gems then
			text = Rewards.grant(player, { kind = "gems", amount = wish.gems })
		elseif wish.boostMinutes then
			text = Rewards.grant(player, { kind = "boost", amount = wish.boostMinutes })
		elseif wish.spins then
			text = Rewards.grant(player, { kind = "spins", amount = wish.spins })
		else
			p.wishPower += 1
			text = M("reward.wish_power", { n = math.floor(p.wishPower * 5) })
		end
		p.wishes += 1
		p.relics.found = {}
		p.relics.seed += 1
		p.relics.nextAt = os.time() + Config.Relics.resetSeconds
		Hooks.fire("wish", player, wish.id)
		Remotes.fireAll("Fx", "wish", { p = altar, u = player.UserId })
		Remotes.fireAll("Toast", { key = "toast.wish_made", args = { player = player.DisplayName }, color = { 255, 214, 90 } })
		State.dirty(player)
		task.spawn(Data.save, player)
		return true, text
	end)
end

return Relics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Remotes</string>
            <string name="Source"><![CDATA[--!strict
-- Creates ReplicatedStorage.Remotes and routes Request(action, payload) to handlers,
-- with a per-player token-bucket rate limit.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)
local M = Locale.m

local Remotes = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"

-- Server -> client events
local events: { [string]: RemoteEvent } = {}
for _, name in { "State", "Numbers", "Notify", "Toast", "Reward", "LiveEventUpdate", "AskNotifications", "Quests", "Fx", "Combat", "Knock", "WorldBoss", "Arena" } do
	local e = Instance.new("RemoteEvent")
	e.Name = name
	e.Parent = folder
	events[name] = e
end

-- Client -> server combat / training inputs (fire-and-forget; every kind has its own
-- cooldown or token bucket in Combat / Training)
local actEvent = Instance.new("RemoteEvent")
actEvent.Name = "Act"
actEvent.Parent = folder
Remotes.ActEvent = actEvent

local request = Instance.new("RemoteFunction")
request.Name = "Request"
request.Parent = folder

type Handler = (player: Player, payload: any) -> (boolean, any?)
local handlers: { [string]: Handler } = {}
local budget: { [Player]: { tokens: number, t: number } } = {}
local RATE = 12 -- requests per second sustained
local BURST = 30

function Remotes.handle(action: string, fn: Handler)
	handlers[action] = fn
end

function Remotes.fire(name: string, player: Player, ...: any)
	events[name]:FireClient(player, ...)
end

function Remotes.fireAll(name: string, ...: any)
	events[name]:FireAllClients(...)
end

-- message: a Locale message ({ key, args }); the client renders it in the player's language.
function Remotes.notify(player: Player, message: Locale.Message, kind: string?)
	events.Notify:FireClient(player, message, kind or "info")
end

function Remotes.forget(player: Player)
	budget[player] = nil
end

request.OnServerInvoke = function(player: Player, action: any, payload: any)
	if type(action) ~= "string" then
		return false, M("msg.bad_request")
	end
	local b = budget[player]
	local now = os.clock()
	if not b then
		b = { tokens = BURST, t = now }
		budget[player] = b
	end
	b.tokens = math.min(BURST, b.tokens + (now - b.t) * RATE)
	b.t = now
	if b.tokens < 1 then
		return false, M("msg.slow_down")
	end
	b.tokens -= 1
	local fn = handlers[action]
	if not fn then
		return false, M("msg.unknown_action")
	end
	if payload ~= nil and type(payload) ~= "table" then
		return false, M("msg.bad_request")
	end
	local ok, a, b2 = pcall(fn, player, payload or {})
	if not ok then
		warn("[Remotes]", action, "error:", a)
		return false, M("msg.error")
	end
	return a, b2
end

folder.Parent = ReplicatedStorage

return Remotes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[--!strict
-- Retention rewards: daily streak, free gifts by session time, codes, friend boost.
-- Rewards.grant is the single place that turns a { kind, amount } into something on the
-- profile (also used by quests, wishes, referrals and developer products).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Format = require(ReplicatedStorage.Shared.Format)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local M = Locale.m

local Rewards = {}

export type Reward = { kind: string, amount: number }

-- kinds: sparks (minutes of income) | gems | boost (minutes of x2 training) | spins (aura spins)
function Rewards.grant(player: Player, reward: Reward): Locale.Message
	local p = Data.get(player)
	if not p then
		return M("msg.error")
	end
	if reward.kind == "sparks" then
		local amount = State.sparksForMinutes(p, reward.amount)
		State.addSparks(player, amount, false)
		Remotes.fire("Reward", player, { kind = "sparks", amount = amount })
		return M("reward.sparks", { n = Format.abbrev(amount) })
	elseif reward.kind == "gems" then
		State.addGems(player, reward.amount)
		Remotes.fire("Reward", player, { kind = "gems", amount = reward.amount })
		return M("reward.gems", { n = reward.amount })
	elseif reward.kind == "boost" then
		p.boostLeft += reward.amount * 60
		State.dirty(player)
		Remotes.fire("Reward", player, { kind = "boost", amount = reward.amount })
		return M("reward.boost", { n = reward.amount })
	elseif reward.kind == "spins" then
		p.spins += reward.amount
		State.dirty(player)
		Remotes.fire("Reward", player, { kind = "spins", amount = reward.amount })
		return M("reward.spins", { n = reward.amount })
	end
	return M("msg.error")
end

-- Friendship is looked up once per pair (web call) and cached for the server's lifetime.
local friendCache: { [string]: boolean } = {}
local function areFriends(a: Player, b: Player): boolean
	local lo, hi = math.min(a.UserId, b.UserId), math.max(a.UserId, b.UserId)
	local key = lo .. ":" .. hi
	local cached = friendCache[key]
	if cached ~= nil then
		return cached
	end
	local ok, isFriend = pcall(function()
		return a:IsFriendsWithAsync(b.UserId)
	end)
	if not ok then
		return false
	end
	friendCache[key] = isFriend == true
	return isFriend == true
end

function Rewards.refreshFriends()
	for _, player in Players:GetPlayers() do
		if State.ready[player] then
			local n = 0
			for _, other in Players:GetPlayers() do
				if other ~= player and areFriends(player, other) then
					n += 1
				end
			end
			local bonus = math.min(Config.FriendBoostMax, n * Config.FriendBoostPerFriend)
			if bonus ~= State.friendBonus[player] then
				State.friendBonus[player] = bonus
				State.dirty(player)
			end
		end
	end
end

function Rewards.dailyState(p: Data.Profile): { [string]: any }
	local now = os.time()
	local today = now // 86400
	local lastDay = p.daily.last // 86400
	return {
		canClaim = p.daily.last == 0 or today > lastDay,
		streak = if p.daily.last ~= 0 and today - lastDay > 1 then 0 else p.daily.streak,
		nextAt = (today + 1) * 86400,
	}
end

function Rewards.init()
	State.extras.dailyState = function(_player, p)
		return Rewards.dailyState(p)
	end

	Remotes.handle("ClaimDaily", function(player)
		local p = Data.get(player)
		if not p then
			return false, M("msg.error")
		end
		local st = Rewards.dailyState(p)
		if not st.canClaim then
			return false, M("msg.daily_wait")
		end
		local day = (st.streak % #Config.DailyRewards) + 1
		p.daily.streak = st.streak + 1
		p.daily.last = os.time()
		local text = Rewards.grant(player, Config.DailyRewards[day])
		if State.owns(player, "VIP") then
			State.addGems(player, Config.VipDailyGems)
		end
		State.dirty(player)
		task.spawn(Data.save, player)
		return true, text
	end)

	Remotes.handle("ClaimGift", function(player, payload)
		local i = payload.index
		local gift = if type(i) == "number" then Config.Gifts[i] else nil
		local claimed = State.giftsClaimed[player]
		if not gift or not claimed then
			return false, M("msg.bad_request")
		end
		if claimed[i] then
			return false, M("msg.already_claimed")
		end
		local elapsed = os.time() - (State.sessionStart[player] or os.time())
		if elapsed + 1 < gift.minutes * 60 then
			return false, M("msg.not_ready")
		end
		claimed[i] = true
		local text = Rewards.grant(player, gift.reward)
		State.dirty(player)
		return true, text
	end)

	Remotes.handle("RedeemCode", function(player, payload)
		local p = Data.get(player)
		if not p or type(payload.code) ~= "string" or #payload.code > 30 then
			return false, M("msg.invalid_code")
		end
		local code = payload.code:upper():gsub("%s", "")
		local reward = Config.Codes[code]
		if not reward then
			return false, M("msg.invalid_code")
		end
		if p.codes[code] then
			return false, M("msg.already_redeemed")
		end
		p.codes[code] = true
		local text = Rewards.grant(player, reward)
		State.dirty(player)
		return true, text
	end)

	task.spawn(function()
		while true do
			task.wait(15)
			pcall(Rewards.refreshFriends)
		end
	end)
end

return Rewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Social</string>
            <string name="Source"><![CDATA[--!strict
-- Social features:
--   * referrals: invitee gift on join, inviter credited after the first 10 minutes of the
--     invitee (DataStore keyed by inviter), drained on join and every 120 s
--   * share-link prompt, group-join gift aura, notification opt-in ask
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Referral = require(ReplicatedStorage.Shared.Referral)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Rewards = require(script.Parent.Rewards)
local Hooks = require(script.Parent.Hooks)
local M = Locale.m

local Social = {}

local live = game.PlaceId ~= 0 -- DataStores only work in a published place

local refStore: DataStore? = nil
if live then
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(Config.ReferralStore)
	end)
	if ok then
		refStore = store
	end
end

-- Invitee side, on join. Returns true when the invitee gift was granted.
function Social.applyReferral(player: Player, launchData: any): boolean
	local p = Data.get(player)
	local inviter = Referral.parse(launchData)
	if not p or not inviter or inviter == player.UserId or p.referredBy ~= 0 or p.playTime >= Config.ReferralMinPlaySeconds then
		return false
	end
	p.referredBy = inviter
	Rewards.grant(player, Config.ReferralInviteeGift :: any)
	Remotes.notify(player, M("msg.referral_welcome"), "success")
	State.dirty(player)
	return true
end

-- Invitee side: after 10 minutes of play, credit the inviter once.
local function creditInviter(player: Player)
	local p = Data.get(player)
	if not p or p.referredBy == 0 or p.referralPaid or p.playTime < Config.ReferralMinPlaySeconds then
		return
	end
	p.referralPaid = true
	local store = refStore
	if not store then
		return
	end
	local inviter, me = p.referredBy, player.UserId
	task.spawn(function()
		local ok, err = pcall(function()
			store:UpdateAsync(tostring(inviter), function(old: any)
				local list = if type(old) == "table" then old else {}
				for _, e in list do
					if e.u == me then
						return list
					end
				end
				table.insert(list, { u = me, t = os.time() })
				while #list > 50 do
					table.remove(list, 1)
				end
				return list
			end)
		end)
		if not ok then
			warn("[Social] referral credit failed", err)
		end
	end)
end
Social.creditInviter = creditInviter

-- Inviter side: take the pending entries and grant one reward per friend (lifetime cap).
local function drainReferrals(player: Player)
	local p = Data.get(player)
	local store = refStore
	if not p or not store or not Data.isPersistent(player) then
		return
	end
	local taken: { any } = {}
	local ok = pcall(function()
		store:UpdateAsync(tostring(player.UserId), function(old: any)
			if type(old) ~= "table" or #old == 0 then
				return nil
			end
			taken = old
			return {}
		end)
	end)
	if not ok then
		return
	end
	for _ in taken do
		if p.referralRewards >= Config.ReferralLifetimeCap then
			break
		end
		p.referralRewards += 1
		Rewards.grant(player, Config.ReferralInviterGift :: any)
		Remotes.notify(player, M("msg.referral_reward"), "success")
	end
end

-- Notification opt-in ask (after the first form or the first ascension, at most weekly).
local function maybeAskNotifications(player: Player)
	local p = Data.get(player)
	if not p or os.time() - p.notifAskedAt <= Config.NotifAskInterval then
		return
	end
	p.notifAskedAt = os.time()
	Remotes.fire("AskNotifications", player)
end
Social.maybeAskNotifications = maybeAskNotifications

function Social.onReady(player: Player)
	local ok, joinData = pcall(function()
		return player:GetJoinData()
	end)
	if ok and type(joinData) == "table" then
		Social.applyReferral(player, joinData.LaunchData)
	end
	task.spawn(drainReferrals, player)
	if Config.GroupId ~= 0 then
		task.spawn(function()
			local okGroup, member = pcall(function()
				return (player :: any):IsInGroupAsync(Config.GroupId)
			end)
			if okGroup and member then
				State.groupMember[player] = true
				State.dirty(player)
			end
		end)
	end
end

function Social.init()
	Hooks.on("form", function(player: Player, index: number)
		if index >= 2 then
			maybeAskNotifications(player)
		end
	end)
	Hooks.on("rebirth", function(player: Player)
		maybeAskNotifications(player)
	end)

	Remotes.handle("ShareLink", function(player)
		local ok, err = pcall(function()
			(SocialService :: any):PromptLinkSharingAsync(player, {
				LaunchData = Referral.launchData(player.UserId),
				ExpirationSeconds = Config.ReferralLinkSeconds,
			})
		end)
		if not ok then
			warn("[Social] link sharing unavailable:", err)
			return false, M("msg.share_unavailable")
		end
		return true
	end)

	Remotes.handle("ClaimGroupGift", function(player)
		local p = Data.get(player)
		if not p or Config.GroupId == 0 then
			return false, M("msg.group_unavailable")
		end
		if p.groupGiftClaimed then
			return false, M("msg.already_claimed")
		end
		local ok, member = pcall(function()
			return (player :: any):IsInGroupAsync(Config.GroupId)
		end)
		if not ok or not member then
			return false, M("msg.join_group_first")
		end
		p.groupGiftClaimed = true
		State.groupMember[player] = true
		p.auras[Config.GroupGiftAura] = (p.auras[Config.GroupGiftAura] or 0) + 1
		State.dirty(player)
		return true, M("msg.group_gift", { aura = M("aura." .. Config.GroupGiftAura) })
	end)

	State.extras.social = function(_player, p)
		return { groupGiftClaimed = p.groupGiftClaimed, referralRewards = p.referralRewards, referredBy = p.referredBy, groupId = Config.GroupId }
	end

	-- referral upkeep
	task.spawn(function()
		local acc = 0
		while true do
			task.wait(30)
			acc += 30
			for _, player in Players:GetPlayers() do
				if State.ready[player] then
					creditInviter(player)
					if acc >= 120 then
						task.spawn(drainReferrals, player)
					end
				end
			end
			if acc >= 120 then
				acc = 0
			end
		end
	end)
end

return Social
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
-- Derived stats, currency helpers and state replication.
--   State.dirty(player)      full snapshot (throttled)
--   State.touch(player)      only the fast numbers (stats, sparks, gems) at 5 Hz
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)

local State = {}

State.ready = {} :: { [Player]: boolean }
State.passes = {} :: { [Player]: { [string]: boolean } }
State.sessionStart = {} :: { [Player]: number }
State.giftsClaimed = {} :: { [Player]: { [number]: boolean } }
State.zone = {} :: { [Player]: { id: string, mult: number, locked: boolean }? }
State.friendBonus = {} :: { [Player]: number }
State.groupMember = {} :: { [Player]: boolean }
State.randomRestricted = {} :: { [Player]: boolean } -- PolicyService: paid random items
State.eventEffects = { trainMult = 1, sparkMult = 1 }
-- Other services add keys to the snapshot: extras[name] = function(player, profile) -> value
State.extras = {} :: { [string]: (Player, Data.Profile) -> any }

local fullDirty: { [Player]: boolean } = {}
local lightDirty: { [Player]: boolean } = {}

function State.init(player: Player)
	State.passes[player] = {}
	State.sessionStart[player] = os.time()
	State.giftsClaimed[player] = {}
	State.friendBonus[player] = 0
end

function State.cleanup(player: Player)
	State.ready[player] = nil
	State.passes[player] = nil
	State.sessionStart[player] = nil
	State.giftsClaimed[player] = nil
	State.zone[player] = nil
	State.friendBonus[player] = nil
	State.groupMember[player] = nil
	State.randomRestricted[player] = nil
	fullDirty[player] = nil
	lightDirty[player] = nil
end

function State.owns(player: Player, passKey: string): boolean
	local owned = State.passes[player]
	return owned ~= nil and owned[passKey] == true
end

function State.power(p: Data.Profile): number
	return Formulas.power(p.stats)
end

function State.auraMult(p: Data.Profile): number
	local a = Config.AuraById[p.auraEquipped]
	return if a then a.mult else 1
end

function State.socialBonus(player: Player): number
	local b = State.friendBonus[player] or 0
	if player.MembershipType == Enum.MembershipType.Premium then
		b += Config.PremiumBonus
	end
	if State.groupMember[player] then
		b += Config.GroupBonus
	end
	return b
end

function State.trainContext(player: Player, p: Data.Profile, stat: string): Formulas.TrainContext
	local zone = State.zone[player]
	local race = Config.RaceById[p.race]
	return {
		zoneMult = if zone and not zone.locked then zone.mult else 1,
		gearTier = p.gear,
		rebirths = p.rebirths,
		upgradeLevel = p.upgrades.trainPower or 0,
		auraMult = State.auraMult(p),
		wishPower = p.wishPower,
		passDouble = State.owns(player, "DoubleTraining"),
		vip = State.owns(player, "VIP"),
		boost = p.boostLeft > 0,
		eventMult = State.eventEffects.trainMult,
		socialBonus = State.socialBonus(player),
		raceBonus = if race and race.bonus == stat then race.amount else 0,
	}
end

function State.gainPerRep(player: Player, p: Data.Profile, stat: string): number
	return Formulas.trainGain(State.trainContext(player, p, stat))
end

function State.autoRate(player: Player, p: Data.Profile): number
	return Formulas.autoRate(p.upgrades.autoSpeed or 0, State.owns(player, "TurboAuto"))
end

function State.bestPlanet(p: Data.Profile): number
	local best = 1
	for _, i in p.planets do
		best = math.max(best, i)
	end
	return best
end

function State.sparkMult(player: Player, p: Data.Profile): number
	local m = 1 + Formulas.upgradeValue("sparkGain", p.upgrades.sparkGain or 0)
	if State.owns(player, "DoubleSparks") then
		m *= 2
	end
	local race = Config.RaceById[p.race]
	if race and race.bonus == "sparks" then
		m *= 1 + race.amount
	end
	return m * State.eventEffects.sparkMult
end

-- scaled = true applies the player's Spark multipliers (enemy drops); false = exact amount.
function State.addSparks(player: Player, amount: number, scaled: boolean?): number
	local p = Data.get(player)
	if not p or amount ~= amount or amount <= 0 then
		return 0
	end
	if scaled then
		amount *= State.sparkMult(player, p)
	end
	amount = math.floor(amount + 0.5)
	p.sparks += amount
	lightDirty[player] = true
	return amount
end

function State.spendSparks(player: Player, amount: number): boolean
	local p = Data.get(player)
	if not p or amount < 0 or p.sparks < amount then
		return false
	end
	p.sparks -= amount
	lightDirty[player] = true
	return true
end

function State.addGems(player: Player, amount: number)
	local p = Data.get(player)
	if p and amount == amount and amount > 0 then
		p.gems += math.floor(amount)
		lightDirty[player] = true
	end
end

function State.spendGems(player: Player, amount: number): boolean
	local p = Data.get(player)
	if not p or amount < 0 or p.gems < amount then
		return false
	end
	p.gems -= amount
	lightDirty[player] = true
	return true
end

-- "Minutes of Sparks" rewards scale with the best planet the player has reached.
function State.sparksForMinutes(p: Data.Profile, minutes: number): number
	return math.floor(Formulas.sparksPerMinute(State.bestPlanet(p)) * minutes)
end

function State.snapshot(player: Player): { [string]: any }
	local p = Data.get(player) :: Data.Profile
	local perRep = {}
	for _, s in Config.Stats do
		perRep[s] = State.gainPerRep(player, p, s)
	end
	local zone = State.zone[player]
	local snap: { [string]: any } = {
		stats = p.stats,
		power = State.power(p),
		bestPower = p.bestPower,
		sparks = p.sparks,
		gems = p.gems,
		rebirths = p.rebirths,
		planet = p.planet,
		planets = p.planets,
		gear = p.gear,
		techniques = p.techniques,
		forms = p.forms,
		auras = p.auras,
		auraEquipped = p.auraEquipped,
		spins = p.spins,
		race = p.race,
		raceChanges = p.raceChanges,
		upgrades = p.upgrades,
		story = p.story,
		settings = p.settings,
		lang = p.lang,
		boostLeft = p.boostLeft,
		passes = State.passes[player] or {},
		perRep = perRep,
		zone = if zone then zone.id else "",
		zoneLocked = if zone then zone.locked else false,
		autoRate = State.autoRate(player, p),
		sparkMult = State.sparkMult(player, p),
		socialBonus = State.socialBonus(player),
		eventEffects = State.eventEffects,
		rebirthReq = Formulas.rebirthRequirement(p.rebirths),
		daily = p.daily,
		codes = p.codes,
		playTime = p.playTime,
		sessionStart = State.sessionStart[player],
		giftsClaimed = State.giftsClaimed[player],
		wishes = p.wishes,
		wishPower = p.wishPower,
		pvp = p.pvp,
		protectionOff = p.protectionOff,
		kills = p.kills,
		bossKills = p.bossKills,
		totalReps = p.totalReps,
		firstJoin = p.firstJoin,
		serverTime = os.time(),
		persistent = Data.isPersistent(player),
		randomRestricted = State.randomRestricted[player] == true,
	}
	for name, fn in State.extras do
		local ok, value = pcall(fn, player, p)
		if ok then
			snap[name] = value
		else
			warn("[State] extra", name, value)
		end
	end
	return snap
end

function State.sendFull(player: Player)
	if State.ready[player] and Data.get(player) then
		fullDirty[player] = nil
		lightDirty[player] = nil
		Remotes.fire("State", player, State.snapshot(player))
	end
end

function State.dirty(player: Player)
	fullDirty[player] = true
end

function State.touch(player: Player)
	lightDirty[player] = true
end

function State.start()
	task.spawn(function()
		while true do
			task.wait(0.2)
			for _, player in Players:GetPlayers() do
				if not State.ready[player] then
					continue
				end
				if fullDirty[player] then
					State.sendFull(player)
				elseif lightDirty[player] then
					lightDirty[player] = nil
					local p = Data.get(player)
					if p then
						Remotes.fire("Numbers", player, { stats = p.stats, power = State.power(p), sparks = p.sparks, gems = p.gems, boostLeft = p.boostLeft, totalReps = p.totalReps })
					end
				end
			end
		end
	end)
	-- play time + timed boost
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in Players:GetPlayers() do
				local p = Data.get(player)
				if p and State.ready[player] then
					p.playTime += 1
					if p.boostLeft > 0 then
						p.boostLeft = math.max(0, p.boostLeft - 1)
						if p.boostLeft == 0 then
							fullDirty[player] = true
						end
					end
				end
			end
		end
	end)
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Story</string>
            <string name="Source"><![CDATA[--!strict
-- Story: one linear chain of objectives (Config.Story). The first steps are the first-minute
-- tutorial. Progress comes from gameplay hooks; finishing a step pays its reward on the spot
-- and moves on. The client shows the current step in the tracker (p.story + Config.Story).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Hooks = require(script.Parent.Hooks)

local Story = {}

local dirty: { [Player]: boolean } = {}

local function current(p: Data.Profile): any
	return Config.Story[p.story.step]
end

local complete: (Player, Data.Profile) -> ()

-- Steps that are "reach a value" are checked against the current state.
local function evaluate(player: Player, p: Data.Profile)
	local step = current(p)
	if not step then
		return
	end
	local value: number? = nil
	if step.kind == "power" then
		value = math.max(State.power(p), p.bestPower)
	elseif step.kind == "gear" then
		value = p.gear
	elseif step.kind == "technique" then
		local n = 0
		for _ in p.techniques do
			n += 1
		end
		value = n
	elseif step.kind == "travel" then
		value = if table.find(p.planets, step.planet) then 1 else 0
	elseif step.kind == "rebirth" then
		value = p.rebirths
	elseif step.kind == "form" then
		-- needs actually transforming; handled by the hook
		value = nil
	end
	if value and value ~= p.story.progress then
		p.story.progress = math.min(value, step.target)
		dirty[player] = true
	end
	if p.story.progress >= step.target then
		complete(player, p)
	end
end

complete = function(player: Player, p: Data.Profile)
	local step = current(p)
	if not step then
		return
	end
	local index = p.story.step
	if step.sparks and step.sparks > 0 then
		State.addSparks(player, step.sparks, false)
	end
	if step.gems and step.gems > 0 then
		State.addGems(player, step.gems)
	end
	p.story.step = index + 1
	p.story.progress = 0
	Remotes.fire("Quests", player, { storyDone = index, sparks = step.sparks or 0, gems = step.gems or 0 })
	Hooks.fire("storyStep", player, index)
	State.dirty(player)
	-- the next step may already be satisfied (e.g. "reach 150 power")
	evaluate(player, p)
end

local function add(player: Player, kind: string, amount: number, match: ((any) -> boolean)?)
	local p = Data.get(player)
	if not p then
		return
	end
	local step = current(p)
	if not step or step.kind ~= kind or (match and not match(step)) then
		return
	end
	p.story.progress = math.min(step.target, p.story.progress + amount)
	dirty[player] = true
	if p.story.progress >= step.target then
		complete(player, p)
	end
end
Story.add = add

function Story.onJoin(player: Player)
	local p = Data.get(player)
	if p then
		evaluate(player, p)
	end
end

function Story.init()
	Hooks.on("reps", function(player: Player, n: number, _stat: string, zone: string)
		add(player, "reps", n)
		add(player, "zone", n, function(step)
			return step.zone == zone
		end)
		local p = Data.get(player)
		if p and current(p) and current(p).kind == "power" then
			evaluate(player, p)
		end
	end)
	Hooks.on("blast", function(player: Player)
		add(player, "blasts", 1)
	end)
	Hooks.on("charge", function(player: Player)
		add(player, "charge", 1)
	end)
	Hooks.on("fly", function(player: Player)
		add(player, "fly", 1)
	end)
	Hooks.on("beam", function(player: Player)
		add(player, "beam", 1)
	end)
	Hooks.on("dash", function(player: Player)
		add(player, "dash", 1)
	end)
	Hooks.on("form", function(player: Player)
		add(player, "form", 1)
	end)
	Hooks.on("relic", function(player: Player)
		add(player, "relic", 1)
	end)
	Hooks.on("npcKilled", function(player: Player, npcId: string, def: any)
		add(player, if def.boss then "boss" else "defeat", 1, function(step)
			return step.npc == npcId
		end)
	end)
	for _, name in { "gear", "techniqueBought", "travel", "rebirth" } do
		Hooks.on(name, function(player: Player)
			local p = Data.get(player)
			if p then
				evaluate(player, p)
			end
		end)
	end

	-- progress pushes (throttled: reps update it several times a second)
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, player in Players:GetPlayers() do
				if dirty[player] and State.ready[player] then
					dirty[player] = nil
					local p = Data.get(player)
					if p then
						Remotes.fire("Quests", player, { story = { step = p.story.step, progress = p.story.progress } })
					end
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
	end)
end

return Story
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Training</string>
            <string name="Source"><![CDATA[--!strict
-- Stat training: manual reps (every punch is a rep of the selected stat, token bucket),
-- automatic reps, training zones (multiplier while standing inside with enough power) and
-- the movement stats (walk speed / jump power from Agility and Jump).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Format = require(ReplicatedStorage.Shared.Format)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Hooks = require(script.Parent.Hooks)
local Fighters = require(script.Parent.Fighters)
local Combat = require(script.Parent.Combat)
local M = Locale.m

local Training = {}

local bucket: { [Player]: { tokens: number, t: number } } = {}
local autoAcc: { [Player]: number } = {}

-- Adds n reps of a stat. Returns the points gained.
function Training.rep(player: Player, stat: string, n: number): number
	local p = Data.get(player)
	if not p or n <= 0 or p.stats[stat] == nil then
		return 0
	end
	local gain = State.gainPerRep(player, p, stat) * n
	p.stats[stat] += gain
	p.totalReps += n
	local power = State.power(p)
	if power > p.bestPower then
		p.bestPower = power
		Combat.refreshForms(player)
	end
	local zone = State.zone[player]
	Hooks.fire("reps", player, n, stat, if zone and not zone.locked then zone.id else "")
	State.touch(player)
	return gain
end

-- One manual rep (called for every punch the client sends), capped by a token bucket.
function Training.manual(player: Player)
	local p = Data.get(player)
	if not p then
		return
	end
	local b = bucket[player]
	local now = os.clock()
	if not b then
		b = { tokens = Config.Train.manualBurst, t = now }
		bucket[player] = b
	end
	b.tokens = math.min(Config.Train.manualBurst, b.tokens + (now - b.t) * Config.Train.manualPerSecond)
	b.t = now
	if b.tokens < 1 then
		return
	end
	b.tokens -= 1
	Training.rep(player, p.settings.stat, 1)
end

-- Zone the player is standing in (on their current planet).
local function findZone(player: Player, p: Data.Profile): { id: string, mult: number, locked: boolean }?
	local f = Fighters.ofPlayer(player)
	local pos = f and Fighters.position(f)
	if not pos then
		return nil
	end
	local pl = Config.Planets[p.planet]
	local cx, _, cz = Config.planetCenter(p.planet)
	for _, z in pl.zones do
		local dx, dz = pos.X - (cx + z.offset[1]), pos.Z - (cz + z.offset[3])
		if dx * dx + dz * dz <= z.radius * z.radius and pos.Y < 140 then
			return { id = z.id, mult = z.mult, locked = math.max(State.power(p), p.bestPower) < z.reqPower }
		end
	end
	return nil
end

function Training.applyMovement(player: Player)
	local p = Data.get(player)
	local f = Fighters.ofPlayer(player)
	local h = f and f.humanoid
	if not p or not f or not h or h.Health <= 0 then
		return
	end
	local speed = if f.charging or f.beamStart then 0 else Formulas.walkSpeed(p.stats.agility)
	if f.blocking then
		speed *= 0.45
	end
	if math.abs(h.WalkSpeed - speed) > 0.05 then
		h.WalkSpeed = speed
	end
	local jump = Formulas.jumpPower(p.stats.jump)
	h.UseJumpPower = true
	if math.abs(h.JumpPower - jump) > 0.05 then
		h.JumpPower = jump
	end
	local char = f.char
	if char then
		local fly = Formulas.flySpeed(p.stats.agility, State.owns(player, "FastFlight"))
		if char:GetAttribute("FlySpeed") ~= fly then
			char:SetAttribute("FlySpeed", fly)
		end
		local power = State.power(p)
		if char:GetAttribute("Power") ~= power then
			char:SetAttribute("Power", power)
		end
	end
end

function Training.forget(player: Player)
	bucket[player] = nil
	autoAcc[player] = nil
end

function Training.init()
	Combat.onManualRep = Training.manual

	Remotes.handle("SetStat", function(player, payload)
		local p = Data.get(player)
		local stat = payload.stat
		if not p or type(stat) ~= "string" or not table.find(Config.Stats, stat) then
			return false, M("msg.bad_request")
		end
		p.settings.stat = stat
		State.dirty(player)
		return true
	end)

	Remotes.handle("SetSetting", function(player, payload)
		local p = Data.get(player)
		local key, value = payload.key, payload.value
		if not p or type(key) ~= "string" or type(value) ~= "boolean" then
			return false, M("msg.bad_request")
		end
		if key ~= "autoTrain" and key ~= "autoCharge" and key ~= "autoFight" and key ~= "music" and key ~= "sfx" and key ~= "lite" and key ~= "shake" then
			return false, M("msg.bad_request")
		end
		p.settings[key] = value
		State.dirty(player)
		return true
	end)

	Remotes.handle("BuyGear", function(player)
		local p = Data.get(player)
		if not p then
			return false, M("msg.error")
		end
		local nextTier = Config.Gear[p.gear + 1]
		if not nextTier then
			return false, M("msg.maxed")
		end
		if not State.spendSparks(player, nextTier.cost) then
			return false, M("msg.need_sparks")
		end
		p.gear += 1
		Hooks.fire("gear", player, p.gear)
		State.dirty(player)
		return true, p.gear
	end)

	-- zones + movement (4 Hz), auto-train (accumulated per player)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.25)
			local now = os.clock()
			local dt = now - last
			last = now
			for _, player in Players:GetPlayers() do
				local p = Data.get(player)
				if not p or not State.ready[player] then
					continue
				end
				local zone = findZone(player, p)
				local prev = State.zone[player]
				if (zone and zone.id) ~= (prev and prev.id) or (zone and prev and zone.locked ~= prev.locked) then
					State.zone[player] = zone
					State.dirty(player)
					if zone and zone.locked then
						Remotes.notify(player, M("msg.zone_locked", { zone = M("zone." .. zone.id), power = Format.abbrev(Config.ZoneById[zone.id].reqPower) }), "error")
					end
				end
				Training.applyMovement(player)
				if p.settings.autoTrain then
					local f = Fighters.ofPlayer(player)
					if f and f.alive then
						local acc = (autoAcc[player] or 0) + dt * State.autoRate(player, p)
						local n = math.floor(acc)
						autoAcc[player] = acc - n
						if n > 0 then
							Training.rep(player, p.settings.stat, n)
						end
					end
				end
			end
		end
	end)
end

return Training
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">WorldBoss</string>
            <string name="Source"><![CDATA[--!strict
-- World boss event: the Astral Titan lands in the crater on planet 1 on a UTC schedule (every
-- 30 minutes, identical in every server), scaled to the strongest player. Everyone who helped
-- is paid by contribution tier. Its hits take a fraction of the HP bar, so new and veteran
-- players can fight it together.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Hooks = require(script.Parent.Hooks)
local Npcs = require(script.Parent.Npcs)
local Rewards = require(script.Parent.Rewards)
local M = Locale.m

local W = Config.WorldBoss
local WorldBoss = {}

local site = Vector3.zero
local boss: any = nil
local endsAt = 0
local lastCycle = -1
local forced = false

local function nextSpawn(now: number): number
	return (now // W.every + 1) * W.every
end

-- Which event boss a half hour gets (same in every server).
function WorldBoss.pick(cycle: number): string
	local list = W.rotation
	return list[cycle % #list + 1]
end
local currentId = W.npc

local function payload(): { [string]: any }
	local now = os.time()
	return {
		npc = if boss then currentId else WorldBoss.pick(now // W.every + 1),
		active = boss ~= nil,
		endsAt = endsAt,
		nextAt = nextSpawn(now),
		serverTime = now,
		id = if boss then boss.f.id else 0,
		site = site,
	}
end

local function broadcast()
	Remotes.fireAll("WorldBoss", payload())
end

local function remove()
	if boss then
		local b = boss
		boss = nil
		Npcs.destroy(b)
	end
end

local function pay(npc: any)
	local contributions: { [Player]: number } = npc.f.contributions or {}
	local total = 0
	for _, d in contributions do
		total += d
	end
	for player, d in contributions do
		local p = Data.get(player)
		if p and player.Parent and total > 0 then
			local share = d / total
			for _, tier in W.tiers do
				if share >= tier.min then
					State.addGems(player, tier.gems)
					Rewards.grant(player, { kind = "sparks", amount = tier.sparkMinutes })
					p.bossKills[currentId] = (p.bossKills[currentId] or 0) + 1
					p.kills += 1
					Remotes.notify(player, M("msg.worldboss_reward", { pct = math.floor(share * 100 + 0.5), n = tier.gems }), "success")
					Hooks.fire("npcKilled", player, currentId, Config.Npcs[currentId])
					State.dirty(player)
					break
				end
			end
		end
	end
end

function WorldBoss.spawn(seconds: number?, id: string?)
	remove()
	currentId = id or WorldBoss.pick(os.time() // W.every)
	local best = 0
	local count = 0
	for _, player in Players:GetPlayers() do
		local p = Data.get(player)
		if p and State.ready[player] then
			count += 1
			best = math.max(best, Formulas.meleeDamage(p.stats.strength, 0))
		end
	end
	local hp = Formulas.worldBossHp(best, count)
	local npc = Npcs.create(currentId, Config.WorldBossSite.planet, site, 8, hp)
	npc.persistent = true
	npc.onDeath = function(n)
		pay(n)
		Remotes.fireAll("Toast", { key = "toast.worldboss_down", args = { boss = { key = "npc." .. currentId } }, color = { 120, 255, 230 } })
		task.defer(function()
			if boss == n then
				boss = nil
				forced = false
				Npcs.destroy(n)
				broadcast()
			end
		end)
	end
	Npcs.spawn(npc)
	boss = npc
	endsAt = os.time() + (seconds or W.duration)
	Remotes.fireAll("Toast", { key = "toast.worldboss_spawn", args = { boss = { key = "npc." .. currentId } }, color = { 120, 255, 230 } })
	Remotes.fireAll("Fx", "worldBoss", { p = site })
	broadcast()
end

-- Test / admin.
function WorldBoss.force(_player: Player?, arg: any): any
	forced = true
	local seconds = if type(arg) == "table" then arg.seconds else arg
	WorldBoss.spawn(seconds or 120, if type(arg) == "table" then arg.id else W.npc)
	return if boss then { id = boss.f.id, hp = boss.f.maxHp, pos = boss.pos, npc = currentId } else nil
end

function WorldBoss.info(_player: Player?): any
	return if boss then { id = boss.f.id, hp = boss.f.hp, maxHp = boss.f.maxHp, pos = boss.pos, alive = boss.f.alive } else nil
end

function WorldBoss.onReady(player: Player)
	Remotes.fire("WorldBoss", player, payload())
end

function WorldBoss.init(world: { [string]: any })
	site = world.worldBossCenter or Vector3.zero
	State.extras.worldBoss = function()
		return payload()
	end
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.time()
			local cycle = now // W.every
			if boss then
				if now >= endsAt then
					remove()
					forced = false
					Remotes.fireAll("Toast", { key = "toast.worldboss_gone", args = { boss = { key = "npc." .. currentId } }, color = { 120, 140, 200 } })
					broadcast()
				end
			elseif not forced and cycle ~= lastCycle and lastCycle ~= -1 and #Players:GetPlayers() > 0 then
				-- a new half hour just started
				WorldBoss.spawn(W.duration)
			end
			lastCycle = cycle
		end
	end)
end

return WorldBoss
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="54">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the whole world from code: one themed planet per Config.Planets entry (ground, painted
-- patches, rim mountains, plaza, warp gate, training zones, enemy camps, boss arena, props,
-- landmarks) plus the PvP coliseum, wish altar and world-boss crater on planet 1.
-- Looks are carried by colour, shape and silhouette (no textures, no uploaded assets), so the
-- world still reads at graphics quality 1 where shadows, glow and post-processing are off.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)

local WorldBuilder = {}

local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

type Theme = {
	ground: Color3,
	groundMat: Enum.Material,
	patchA: Color3,
	patchB: Color3,
	path: Color3,
	plaza: Color3,
	plazaTrim: Color3,
	rock: Color3,
	cliffLow: Color3,
	cliffMid: Color3,
	cliffTop: Color3,
	accent: Color3, -- bright (crystals, lamps)
	accent2: Color3,
	foliage: { Color3 },
	trunk: Color3,
	prop: string,
	rockMat: Enum.Material?, -- cliffs, rocks, pads (default Rock)
	foliageMat: Enum.Material?, -- tree crowns, bushes (default Grass)
	pathMat: Enum.Material?, -- paths (default Ground)
}

local Themes: { [string]: Theme } = {
	meadow = {
		ground = Color3.fromRGB(96, 178, 84),
		groundMat = Enum.Material.Grass,
		patchA = Color3.fromRGB(124, 200, 98),
		patchB = Color3.fromRGB(74, 150, 78),
		path = Color3.fromRGB(226, 198, 142),
		plaza = Color3.fromRGB(188, 172, 140),
		plazaTrim = Color3.fromRGB(255, 176, 64),
		rock = Color3.fromRGB(140, 142, 152),
		cliffLow = Color3.fromRGB(84, 120, 96),
		cliffMid = Color3.fromRGB(112, 156, 112),
		cliffTop = Color3.fromRGB(186, 222, 150),
		accent = Color3.fromRGB(90, 230, 255),
		accent2 = Color3.fromRGB(255, 214, 72),
		foliage = { Color3.fromRGB(64, 160, 72), Color3.fromRGB(96, 190, 84), Color3.fromRGB(255, 150, 190) },
		trunk = Color3.fromRGB(122, 84, 58),
		prop = "tree",
		rockMat = Enum.Material.Rock,
		foliageMat = Enum.Material.Grass,
		pathMat = Enum.Material.Ground,
	},
	volcano = {
		ground = Color3.fromRGB(84, 58, 56),
		groundMat = Enum.Material.Basalt,
		patchA = Color3.fromRGB(116, 70, 56),
		patchB = Color3.fromRGB(54, 40, 44),
		path = Color3.fromRGB(150, 116, 100),
		plaza = Color3.fromRGB(70, 60, 66),
		plazaTrim = Color3.fromRGB(255, 120, 40),
		rock = Color3.fromRGB(60, 46, 48),
		cliffLow = Color3.fromRGB(48, 34, 38),
		cliffMid = Color3.fromRGB(92, 50, 44),
		cliffTop = Color3.fromRGB(255, 120, 40),
		accent = Color3.fromRGB(255, 130, 30),
		accent2 = Color3.fromRGB(255, 220, 90),
		foliage = { Color3.fromRGB(40, 30, 34), Color3.fromRGB(70, 44, 40), Color3.fromRGB(255, 100, 40) },
		trunk = Color3.fromRGB(40, 30, 32),
		prop = "spire",
		rockMat = Enum.Material.Basalt,
		foliageMat = Enum.Material.Basalt,
		pathMat = Enum.Material.Slate,
	},
	ice = {
		ground = Color3.fromRGB(214, 234, 250),
		groundMat = Enum.Material.Snow,
		patchA = Color3.fromRGB(246, 250, 255),
		patchB = Color3.fromRGB(170, 210, 242),
		path = Color3.fromRGB(136, 184, 226),
		plaza = Color3.fromRGB(150, 186, 222),
		plazaTrim = Color3.fromRGB(90, 200, 255),
		rock = Color3.fromRGB(150, 190, 225),
		cliffLow = Color3.fromRGB(86, 136, 196),
		cliffMid = Color3.fromRGB(150, 200, 240),
		cliffTop = Color3.fromRGB(250, 252, 255),
		accent = Color3.fromRGB(120, 235, 255),
		accent2 = Color3.fromRGB(200, 160, 255),
		foliage = { Color3.fromRGB(60, 130, 140), Color3.fromRGB(240, 250, 255), Color3.fromRGB(110, 200, 230) },
		trunk = Color3.fromRGB(90, 80, 100),
		prop = "pine",
		rockMat = Enum.Material.Glacier,
		foliageMat = Enum.Material.Snow,
		pathMat = Enum.Material.Ice,
	},
	storm = {
		ground = Color3.fromRGB(104, 116, 150),
		groundMat = Enum.Material.Slate,
		patchA = Color3.fromRGB(134, 140, 180),
		patchB = Color3.fromRGB(74, 84, 120),
		path = Color3.fromRGB(210, 212, 230),
		plaza = Color3.fromRGB(80, 90, 130),
		plazaTrim = Color3.fromRGB(255, 232, 90),
		rock = Color3.fromRGB(70, 78, 108),
		cliffLow = Color3.fromRGB(50, 56, 88),
		cliffMid = Color3.fromRGB(92, 100, 150),
		cliffTop = Color3.fromRGB(200, 210, 245),
		accent = Color3.fromRGB(255, 236, 100),
		accent2 = Color3.fromRGB(120, 230, 255),
		foliage = { Color3.fromRGB(90, 100, 150), Color3.fromRGB(150, 160, 210), Color3.fromRGB(255, 236, 100) },
		trunk = Color3.fromRGB(60, 64, 90),
		prop = "pylon",
		rockMat = Enum.Material.Slate,
		foliageMat = Enum.Material.Slate,
		pathMat = Enum.Material.Pavement,
	},
	desert = {
		ground = Color3.fromRGB(226, 190, 120),
		groundMat = Enum.Material.Sand,
		patchA = Color3.fromRGB(240, 210, 146),
