	{ kind = "power", target = 1_000, sparks = 300, guide = "none" },
	{ kind = "form", target = 1, sparks = 400, gems = 5, guide = "none" },
	{ kind = "defeat", npc = "raider", target = 5, sparks = 600, guide = "camp" },
