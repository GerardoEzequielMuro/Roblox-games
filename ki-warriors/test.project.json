{
  "name": "KiWarriorsTest",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "AutoTest": {
        "$path": "tests/AutoTest.server.luau"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        },
        "AutoTestClient": {
          "$path": "tests/AutoTestClient.client.luau"
        }
      },
      "$properties": {
        "CameraMaxZoomDistance": 60,
        "CameraMinZoomDistance": 6
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    },
    "Workspace": {
      "$properties": {
        "Gravity": 196.2,
        "StreamingEnabled": true,
        "StreamingMinRadius": 320,
        "StreamingTargetRadius": 900,
        "StreamOutBehavior": "Opportunistic",
        "FallenPartsDestroyHeight": -400
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "Brightness": 2.6,
        "ClockTime": 13.6,
        "GlobalShadows": true
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "__AutoTest": {
        "$className": "BoolValue"
      },
      "ModelLibrary": {
        "$path": "assets/models"
      }
    }
  }
}