            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Cards</string>
              <string name="Source"><![CDATA[--!strict
-- Non-blocking bottom-centre cards: a title and a column of big buttons, auto-hidden after a while.
-- Used by the "Stuck on stage N?" skip offer (P0-1) and the notification opt-in (P0-8).
-- On touch screens the card sits between the thumbstick (left 35%) and the jump button (right 25%).
local Kit = require(script.Parent.Kit)

local Cards = {}

export type CardButton = { name: string, text: string, color: Color3, onClick: () -> () }

local WIDTH = 440
local BTN_H = 54
local GAP = 8
local TITLE_H = 52

local region: Frame? = nil
local token = 0

local function ensure(): Frame
	if region then
		return region
	end
	local r = Kit.region("Card", Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -12), Vector2.new(WIDTH, 200))
	r.ZIndex = 15
	r.Visible = false
	Kit.onLayout(function(touch, area, scale)
		local h = r.Size.Y.Offset
		local s = scale
		if touch then
			-- centre of the free band between thumbstick and jump button
			s = math.min(scale, area.X * 0.4 / WIDTH, area.Y * 0.55 / h)
			r.Position = UDim2.new(0.55, 0, 1, -8)
		else
			s = math.min(scale, area.Y * 0.5 / h)
			r.Position = UDim2.new(0.5, 0, 1, -12)
		end
		Kit.setScale(r, s)
	end)
	region = r
	return r
end

function Cards.hide(name: string?)
	local r = region
	if r and (name == nil or r:GetAttribute("Card") == name) then
		r.Visible = false
		token += 1
	end
end

function Cards.current(): string?
	local r = region
	if r and r.Visible then
		return r:GetAttribute("Card") :: string?
	end
	return nil
end

-- title: already-translated text. Returns the card frame.
function Cards.show(name: string, title: string, buttons: { CardButton }, seconds: number?): Frame
	local r = ensure()
	for _, c in r:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	token += 1
	local my = token
	local h = TITLE_H + #buttons * (BTN_H + GAP) + 10
	r.Size = UDim2.fromOffset(WIDTH, h)
	r:SetAttribute("Card", name)
	local body = Kit.frame(r, UDim2.fromScale(1, 1), UDim2.new(), Kit.C.panel)
	body.Name = "Body"
	Kit.corner(body, 20)
	Kit.stroke(body, Kit.C.ink, 4)
	local t = Kit.bold(body, title, UDim2.new(1, -70, 0, 40), UDim2.fromOffset(14, 8), Kit.C.orange, nil, 32)
	t.TextXAlignment = Enum.TextXAlignment.Left
	Kit.button(body, "X", UDim2.fromOffset(44, 44), UDim2.new(1, -8, 0, 6), Kit.C.red, function()
		Cards.hide(name)
	end, Vector2.new(1, 0), 26).Name = "Close"
	for i, b in buttons do
		local btn = Kit.button(body, b.text, UDim2.new(1, -24, 0, BTN_H), UDim2.fromOffset(12, TITLE_H + (i - 1) * (BTN_H + GAP)), b.color, function()
			Cards.hide(name)
			b.onClick()
		end, nil, 26)
		btn.Name = b.name
	end
	r.Visible = true
	Kit.relayout()
	Kit.pop(body, 0.6)
	if seconds then
		task.delay(seconds, function()
			if token == my then
				Cards.hide(name)
			end
		end)
	end
	return body
end

return Cards
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Celebrate</string>
              <string name="Source"><![CDATA[--!strict
-- Stage-reached celebration: big pop-up text, UI confetti rain and a 3D particle burst.
-- No sounds (no uploaded assets); everything is tween/particle based.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.Kit)
local Lang = require(script.Parent.Parent.Lang)

local Celebrate = {}

local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"
local CONFETTI_COLORS = {
	Kit.C.pink,
	Kit.C.yellow,
	Kit.C.blue,
	Kit.C.green,
	Kit.C.purple,
	Kit.C.orange,
}

local region: Frame? = nil
local confettiLayer: Frame? = nil

local function ensure(): (Frame, Frame)
	if region and confettiLayer then
		return region, confettiLayer
	end
	local r = Kit.region("Celebrate", Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.36), Vector2.new(700, 260))
	r.ZIndex = 30
	local layer = Kit.frame(Kit.gui(), UDim2.fromScale(1, 1), UDim2.new(), nil)
	layer.Name = "Confetti"
	layer.ZIndex = 29
	layer.ClipsDescendants = true
	region, confettiLayer = r, layer
	return r, layer
end

local function confetti(count: number)
	local _, layer = ensure()
	local h = layer.AbsoluteSize.Y
	for _ = 1, count do
		local size = math.random(8, 16)
		local piece = Kit.frame(layer, UDim2.fromOffset(size, size * 0.6), UDim2.new(math.random(), 0, 0, -20), CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)])
		piece.ZIndex = 29
		piece.Rotation = math.random(0, 360)
		local duration = 1.6 + math.random() * 1.2
		local drift = (math.random() - 0.5) * 0.25
		TweenService:Create(piece, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(piece.Position.X.Scale + drift, 0, 0, h + 30),
			Rotation = piece.Rotation + math.random(-540, 540),
		}):Play()
		task.delay(duration + 0.05, function()
			piece:Destroy()
		end)
	end
end

local function burst3D()
	local char = Players.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARKLES
	e.Rate = 0
	e.Lifetime = NumberRange.new(0.8, 1.4)
	e.Speed = NumberRange.new(18, 30)
	e.SpreadAngle = Vector2.new(60, 60)
	e.Acceleration = Vector3.new(0, -40, 0)
	e.Size = NumberSequence.new(0.7, 0.1)
	e.LightEmission = 0.8
	e.EmissionDirection = Enum.NormalId.Top
	e.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Kit.C.pink),
		ColorSequenceKeypoint.new(0.33, Kit.C.yellow),
		ColorSequenceKeypoint.new(0.66, Kit.C.blue),
		ColorSequenceKeypoint.new(1, Kit.C.green),
	})
	e.Parent = root
	e:Emit(45)
	task.delay(2, function()
		e:Destroy()
	end)
end

local showing = 0
-- `ribbon` = two colours: the subtitle sits on a banner in those colours (new world, win).
function Celebrate.show(title: string, subtitle: string?, big: boolean?, ribbon: { Color3 }?)
	local r = ensure()
	showing += 1
	local my = showing
	for _, c in r:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local t = Kit.bold(r, title, UDim2.new(1, 0, 0, if big then 130 else 100), UDim2.fromScale(0.5, 0), Kit.C.yellow, Vector2.new(0.5, 0), if big then 110 else 84)
	t.Rotation = -3
	Kit.pop(t, 0.2)
	if subtitle then
		local y = if big then 140 else 108
		if ribbon then
			local band = Kit.frame(r, UDim2.new(0.94, 0, 0, 68), UDim2.new(0.5, 0, 0, y - 6), Color3.new(1, 1, 1), Vector2.new(0.5, 0))
			band.Name = "Ribbon"
			band.ClipsDescendants = true
			Kit.corner(band, 18)
			Kit.stroke(band, Kit.C.ink, 4)
			Kit.gradient(band, ribbon[1], ribbon[2] or ribbon[1], 0)
			Kit.pop(band, 0.2)
			-- a bright sweep across the banner
			local shine = Kit.frame(band, UDim2.new(0.16, 0, 1.6, 0), UDim2.fromScale(-0.25, -0.3), Color3.new(1, 1, 1))
			shine.BackgroundTransparency = 0.6
			shine.Rotation = 14
			TweenService:Create(shine, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, 0.25), { Position = UDim2.fromScale(1.15, -0.3) }):Play()
		end
		local s = Kit.bold(r, subtitle, UDim2.new(if ribbon then 0.88 else 1, 0, 0, 56), UDim2.new(0.5, 0, 0, y), Kit.C.white, Vector2.new(0.5, 0), 44)
		Kit.pop(s, 0.4)
	end
	confetti(if big then 110 else 45)
	burst3D()
	task.delay(if big then 4 else 2.2, function()
		if showing ~= my then
			return
		end
		for _, c in r:GetChildren() do
			if c:IsA("TextLabel") then
				TweenService:Create(c, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
				local st = c:FindFirstChildOfClass("UIStroke")
				if st then
					TweenService:Create(st, TweenInfo.new(0.3), { Transparency = 1 }):Play()
				end
			elseif c:IsA("Frame") then
				c:Destroy() -- ribbon
			end
		end
	end)
end

function Celebrate.stage(data: { [string]: any })
	local stage = tonumber(data.stage) or 0
	local coins = tonumber(data.coins) or 0
	local sub = if coins > 0 then Lang.t("celebrate.coins", { n = coins }) else nil
	local title = Lang.t("celebrate.stage", { n = stage })
	if data.world then
		local theme = Config.Themes[data.world :: number]
		if theme then
			Celebrate.show(title, Lang.t("celebrate.world", { n = data.world, name = { key = "world." .. data.world } }), true, { theme.platform:Lerp(Kit.C.ink, 0.3), theme.accent:Lerp(Kit.C.ink, 0.3) })
			return
		end
	end
	if stage >= 100 then
		return -- the Win event shows its own celebration
	end
	Celebrate.show(title, sub, false)
end

return Celebrate
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">EventBar</string>
              <string name="Source"><![CDATA[--!strict
-- Live-event pill under the stats row (P0-6): "2x Coins Weekend · ends in 1:02:03", or the
-- starter-pack x2 coins boost; plus a banner when an event starts.
local Workspace = game:GetService("Workspace")

local Net = require(script.Parent.Parent.Net)
local Lang = require(script.Parent.Parent.Lang)
local Kit = require(script.Parent.Kit)
local Hud = require(script.Parent.Hud)
local Celebrate = require(script.Parent.Celebrate)

local EventBar = {}

type Active = { id: string, endsAt: number }
local current: Active? = nil
local upcoming: { id: string, startsAt: number }? = nil

local function clock(sec: number): string
	sec = math.max(0, math.floor(sec))
	local h, m, s = sec // 3600, (sec % 3600) // 60, sec % 60
	if h > 0 then
		return ("%d:%02d:%02d"):format(h, m, s)
	end
	return ("%d:%02d"):format(m, s)
end

function EventBar.current(): Active?
	return current
end

function EventBar.init()
	local W = 360
	local bar = Kit.region("EventBar", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 150), Vector2.new(W, 38))
	bar.Visible = false
	local body = Kit.frame(bar, UDim2.fromScale(1, 1), UDim2.new(), Kit.C.orange)
	body.Name = "Body"
	Kit.corner(body, 19)
	Kit.stroke(body, Kit.darker(Kit.C.orange, 0.45), 3)
	Kit.gradient(body, Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 210, 160), 0)
	local label = Kit.bold(body, "", UDim2.new(1, -20, 1, -8), UDim2.fromOffset(10, 4), Kit.C.white, nil, 24)
	label.Name = "Text"
	Kit.onLayout(function()
		local s = Hud.topScale or 1
		Kit.setScale(bar, s)
		bar.Position = UDim2.new(0.5, 0, 0, math.floor((Hud.STATS_TOP + 52) * s))
	end)

	local function tick()
		local now = Workspace:GetServerTimeNow()
		local ev = current
		if ev and ev.endsAt <= now then
			ev = nil
		end
		local boostEnds = tonumber(Net.state.boostEndsAt) or 0
		if ev then
			body.BackgroundColor3 = if ev.id == "SkipSaleHour" then Kit.C.blue else Kit.C.orange
			Kit.setText(label, "event.ends", { name = { key = "event." .. ev.id }, time = clock(ev.endsAt - now) })
		elseif boostEnds > now then
			body.BackgroundColor3 = Kit.C.green
			Kit.setText(label, "boost.active", { time = clock(boostEnds - now) })
		end
		local show = ev ~= nil or boostEnds > now
		bar.Visible = show
		Hud.setEventBarVisible(show)
	end

	Net.on("LiveEventUpdate", function(cur: any, nxt: any)
		local prevId = current and current.id
		current = if type(cur) == "table" and type(cur.id) == "string" then cur else nil
		upcoming = if type(nxt) == "table" then nxt else nil
		if current and current.id ~= prevId then
			Celebrate.show(Lang.t("event.started", { name = { key = "event." .. current.id } }), nil, false)
		end
		tick()
	end)
	task.spawn(function()
		while true do
			tick()
			task.wait(1)
		end
	end)
end

function EventBar.upcoming()
	return upcoming
end

return EventBar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- Always-on HUD: coins / wins / run-timer pills (under the progress bar), menu grid (left), Skip
-- Stage + checkpoint / lobby buttons (right; clear of the mobile thumbstick and jump button).
local GroupService = game:GetService("GroupService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Referral = require(ReplicatedStorage.Shared.Referral)
local RunTime = require(ReplicatedStorage.Shared.RunTime)
local Net = require(script.Parent.Parent.Net)
local Kit = require(script.Parent.Kit)
local Lang = require(script.Parent.Parent.Lang)
local Toast = require(script.Parent.Toast)

local Hud = {}

local productPrice: { [number]: number } = {}

local function fetchPrice(id: number, onPrice: (number) -> ())
	if id == 0 then
		return
	end
	if productPrice[id] then
		onPrice(productPrice[id])
		return
	end
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(id, Enum.InfoType.Product)
		end)
		if ok and info and info.PriceInRobux then
			productPrice[id] = info.PriceInRobux
			onPrice(info.PriceInRobux)
		end
	end)
end
Hud.fetchPrice = fetchPrice

-- Cached Robux price of a product (nil until fetched / when the id is 0).
function Hud.priceOf(id: number): number?
	return productPrice[id]
end

Hud.topScale = 1 -- scale of the top-centre HUD rows (EventBar follows it)

-- Skip n stages: free skip first, then Robux product, then (Studio only, id 0) dev skip.
function Hud.skip(n: number)
	local s = Net.state
	if (s.stage or 0) >= 100 then
		Toast.show(Lang.t("toast.at_top"), "info")
		return
	end
	if n == 1 and (s.freeSkips or 0) > 0 then
		local ok, msg = Net.request("UseFreeSkip")
		if not ok and msg then
			Toast.show(msg, "error")
		end
		return
	end
	local id = if n == 10 then Config.Products.Skip10 else Config.Products.SkipStage
	if id ~= 0 then
		MarketplaceService:PromptProductPurchase(Players.LocalPlayer, id)
	elseif s.studio and Config.StudioFreeSkips then
		local ok, msg = Net.request("DevSkip", { n = n })
		if ok then
			Toast.show(Lang.t("toast.studio_skip"), "info")
		elseif msg then
			Toast.show(msg, "error")
		end
	end
end

local function pill(parent: Instance, x: number, color: Color3, w: number): (TextLabel, Frame)
	local f = Kit.frame(parent, UDim2.fromOffset(w, 48), UDim2.fromOffset(x, 0), color)
	Kit.corner(f, 24)
	Kit.stroke(f, Kit.darker(color, 0.45), 3)
	Kit.gradient(f, Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 205))
	local iconBg = Kit.frame(f, UDim2.fromOffset(40, 40), UDim2.fromOffset(4, 4), Color3.fromRGB(255, 255, 255))
	Kit.corner(iconBg, 20)
	local label = Kit.bold(f, "0", UDim2.new(1, -60, 1, -10), UDim2.fromOffset(52, 5), Kit.C.white, nil, 30)
	label.TextXAlignment = Enum.TextXAlignment.Left
	return label, iconBg
end

local MENU_CELL = 80
local MENU_GAP = 12
local MENU_COLS = 3

local function menuButton(parent: Instance, order: number, name: string, text: string, icon: string, color: Color3, onClick: () -> ()): (TextButton, Frame)
	local b = Kit.button(parent, "", UDim2.fromOffset(MENU_CELL, MENU_CELL), UDim2.new(), color, onClick)
	b.Name = name
	b.LayoutOrder = order
	Kit.text(b, icon, UDim2.new(1, 0, 0, 44), UDim2.fromOffset(0, 2), Kit.C.white, nil, 38)
	Kit.bold(b, text, UDim2.new(1, 0, 0, 22), UDim2.new(0, 0, 1, -24), Kit.C.white, nil, 18)
	local badge = Kit.frame(b, UDim2.fromOffset(24, 24), UDim2.new(1, -10, 0, -10), Kit.C.red)
	Kit.corner(badge, 12)
	Kit.stroke(badge, Kit.C.white, 2)
	Kit.bold(badge, "!", UDim2.fromScale(1, 1), UDim2.new(), Kit.C.white, nil, 18)
	badge.Visible = false
	badge.ZIndex = 3
	return b, badge
end

local function invite()
	local player = Players.LocalPlayer
	local ok, can = pcall(function()
		return SocialService:CanSendGameInviteAsync(player)
	end)
	if not ok or not can then
		Toast.show(Lang.t("toast.invite_unavailable"), "info")
		return
	end
	local options = Instance.new("ExperienceInviteOptions")
	options.LaunchData = Referral.make(player.UserId)
	options.PromptMessage = Lang.t("invite.prompt")
	local shown = pcall(function()
		SocialService:PromptGameInvite(player, options)
	end)
	if not shown then
		Toast.show(Lang.t("toast.invite_unavailable"), "info")
	end
end

local function joinGroup()
	task.spawn(function()
		pcall(function()
			GroupService:PromptJoinAsync(Config.GroupId)
		end)
		local ok, msg = Net.request("ClaimGroupGift")
		if msg then
			Toast.show(msg, if ok then "success" else "info")
		end
	end)
end

-- Layout (all sizes are design pixels; each region is scaled as one unit by Kit):
--   top centre : progress bar (Progress.luau); under it coins / wins / run timer; under that the
--                live-event / boost pill (EventBar.luau) when something is running
--   left       : 3-column menu grid (starter pack, shop, store, rewards, settings, invite, share,
--                group), clear of the chat window (PC) and of the thumbstick (touch)
--   right      : SKIP STAGE + Skip 10 + Checkpoint + Lobby. Touch: bottom edge kept above the
--                jump button zone (bottom 35%); PC: bottom-right corner, under the player list.
Hud.STATS_TOP = 96 -- design px from the top of the safe area (progress bar is 10..94)
Hud.STATS_W = 520
Hud.eventBarVisible = false
local relayout: () -> () = function() end
function Hud.setEventBarVisible(v: boolean)
	if Hud.eventBarVisible ~= v then
		Hud.eventBarVisible = v
		relayout()
	end
end

function Hud.init()
	local stats = Kit.region("Stats", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, Hud.STATS_TOP), Vector2.new(Hud.STATS_W, 48))
	local coinLabel, coinIcon = pill(stats, 0, Kit.C.yellow, 180)
	Kit.coin(coinIcon, 32, UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
	local winsLabel, winsIcon = pill(stats, 190, Kit.C.purple, 120)
	Kit.text(winsIcon, "🏆", UDim2.fromScale(0.8, 0.8), UDim2.fromScale(0.1, 0.1), Kit.C.ink, nil, 26)
	-- run timer (P0-2): grey + "not ranked" once the run used a skip
	local timer = Kit.frame(stats, UDim2.fromOffset(200, 48), UDim2.fromOffset(320, 0), Kit.C.blue)
	timer.Name = "RunTimer"
	Kit.corner(timer, 24)
	local timerStroke = Kit.stroke(timer, Kit.darker(Kit.C.blue, 0.45), 3)
	Kit.gradient(timer, Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 205))
	local timerIcon = Kit.frame(timer, UDim2.fromOffset(40, 40), UDim2.fromOffset(4, 4), Color3.fromRGB(255, 255, 255))
	Kit.corner(timerIcon, 20)
	Kit.text(timerIcon, "⏱", UDim2.fromScale(0.8, 0.8), UDim2.fromScale(0.1, 0.1), Kit.C.ink, nil, 26)
	local timerLabel = Kit.bold(timer, "00:00.000", UDim2.new(1, -58, 0, 28), UDim2.fromOffset(50, 4), Kit.C.white, nil, 26)
	timerLabel.Name = "Time"
	timerLabel.TextXAlignment = Enum.TextXAlignment.Left
	local timerNote = Kit.text(timer, "", UDim2.new(1, -58, 0, 14), UDim2.fromOffset(50, 31), Color3.fromRGB(240, 240, 255), nil, 13)
	timerNote.Name = "Note"
	timerNote.TextXAlignment = Enum.TextXAlignment.Left

	local left = Kit.region("Menu", Vector2.new(0, 0.5), UDim2.new(0, 12, 0.55, 0), Vector2.new(MENU_COLS * MENU_CELL + (MENU_COLS - 1) * MENU_GAP, MENU_CELL))
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(MENU_CELL, MENU_CELL)
	grid.CellPadding = UDim2.fromOffset(MENU_GAP, MENU_GAP)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.FillDirectionMaxCells = MENU_COLS
	grid.Parent = left
	local starterBtn = menuButton(left, 0, "Starter", "@hud.starter", "🎁", Kit.C.red, function()
		Kit.toggle("starter")
	end)
	local starterPulse = Instance.new("UIScale")
	starterPulse.Parent = starterBtn:FindFirstChildOfClass("TextLabel")
	TweenService:Create(starterPulse, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.15 }):Play()
	starterBtn.Visible = false
	menuButton(left, 1, "Shop", "@hud.shop", "🛍", Kit.C.pink, function()
		Kit.toggle("shop")
	end)
	menuButton(left, 2, "Store", "@hud.store", "💎", Kit.C.green, function()
		Kit.toggle("store")
	end)
	local _, rewardsBadge = menuButton(left, 3, "Rewards", "@hud.rewards", "🎁", Kit.C.orange, function()
		Kit.toggle("rewards")
	end)
	menuButton(left, 4, "Settings", "@hud.settings", "⚙", Kit.C.grey, function()
		Kit.toggle("settings")
	end)
	menuButton(left, 5, "Invite", "@hud.invite", "👋", Kit.C.blue, invite)
	menuButton(left, 6, "Share", "@hud.share", "🔗", Kit.C.purple, function()
		local ok, msg = Net.request("ShareLink")
		if not ok and msg then
			Toast.show(msg, "info")
		end
	end)
	local groupBtn = menuButton(left, 7, "Group", "@hud.group", "⭐", Kit.C.yellow, joinGroup)
	groupBtn.Visible = false

	local right = Kit.region("Actions", Vector2.new(1, 1), UDim2.new(1, -12, 1, -12), Vector2.new(210, 228))
	local skip = Kit.button(right, "", UDim2.fromOffset(210, 100), UDim2.fromOffset(0, 0), Kit.C.green, function()
		Hud.skip(1)
	end)
	skip.Name = "SkipStage"
	local skipTitle = Kit.bold(skip, "@hud.skip", UDim2.new(1, 0, 0, 46), UDim2.fromOffset(0, 8), Kit.C.white, nil, 40)
	local skipSub = Kit.bold(skip, "", UDim2.new(1, 0, 0, 30), UDim2.fromOffset(0, 54), Color3.fromRGB(255, 255, 200), nil, 26)
	-- gentle "breathing" so the button draws the eye
	local skipScale = Instance.new("UIScale")
	skipScale.Parent = skipTitle
	TweenService:Create(skipScale, TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.05 }):Play()

	local skip10 = Kit.button(right, "@hud.skip10", UDim2.fromOffset(210, 56), UDim2.fromOffset(0, 108), Kit.C.blue, function()
		Hud.skip(10)
	end, nil, 28)
	skip10.Name = "Skip10"
	local back = Kit.button(right, "@hud.checkpoint", UDim2.fromOffset(132, 56), UDim2.fromOffset(0, 172), Kit.C.orange, function()
		Net.request("ReturnToCheckpoint")
	end, nil, 20)
	back.Name = "Checkpoint"
	Kit.singleLine(back, 22)
	local lobby = Kit.button(right, "@hud.lobby", UDim2.fromOffset(70, 56), UDim2.fromOffset(140, 172), Kit.C.grey, function()
		Net.request("GoToLobby")
	end, nil, 20)
	lobby.Name = "Lobby"
	Kit.singleLine(lobby, 22)

	local progress = Kit.gui():FindFirstChild("Progress") :: Frame?
	local function menuHeight(): number
		local n = 0
		for _, c in left:GetChildren() do
			if c:IsA("GuiButton") and c.Visible then
				n += 1
			end
		end
		local rows = math.max(1, math.ceil(n / MENU_COLS))
		return rows * MENU_CELL + (rows - 1) * MENU_GAP
	end
	Kit.onLayout(function(touch, area, scale)
		local topScale = scale
		local mh = menuHeight()
		left.Size = UDim2.fromOffset(left.Size.X.Offset, mh)
		if touch then
			-- menu below the top bar, above the thumbstick (bottom-left 40%): shrink it to fit
			local top = math.floor(area.Y * 0.16)
			left.AnchorPoint = Vector2.new(0, 0)
			left.Position = UDim2.new(0, 12, 0, top)
			Kit.setScale(left, math.min(scale, (area.Y * 0.6 - 8 - top) / mh))
			-- action column: bottom at 64% of the height (the jump button owns the bottom 35%),
			-- shrunk if needed so it still fits under the top edge
			local bottom = math.floor(area.Y * 0.64)
			local rs = math.min(scale, (bottom - 8) / 228)
			Kit.setScale(right, rs)
			right.Position = UDim2.new(1, -12, 0, bottom)
			-- the progress bar + stats must end before the action column starts
			local rightX = area.X - 12 - 210 * rs
			topScale = math.min(scale, 2 * (rightX - 8 - area.X / 2) / Hud.STATS_W)
		else
			left.AnchorPoint = Vector2.new(0, 0.5)
			left.Position = UDim2.new(0, 12, 0.55, 0)
			-- keep the grid between the chat window and the bottom edge
			Kit.setScale(left, math.min(scale, (area.Y * 0.62) / mh))
			right.Position = UDim2.new(1, -12, 1, -12)
		end
		topScale = math.max(topScale, 0.3)
		if progress then
			Kit.setScale(progress, topScale)
		end
		Kit.setScale(stats, topScale)
		stats.Position = UDim2.new(0.5, 0, 0, math.floor(Hud.STATS_TOP * topScale))
		Hud.topScale = topScale
		local rows = Hud.STATS_TOP + 52 + (if Hud.eventBarVisible then 44 else 0)
		Kit.hudTop = math.floor(rows * topScale)
	end)
	relayout = function()
		Kit.relayout()
	end

	local skipPrice: number? = nil
	fetchPrice(Config.Products.SkipStage, function(p)
		skipPrice = p
	end)
	local skip10Price: number? = nil
	fetchPrice(Config.Products.Skip10, function(p)
		skip10Price = p
	end)

	local function refresh()
		local s = Net.state
		local stage = s.stage or 0
		Kit.setRaw(coinLabel, Kit.formatNumber(s.coins or 0))
		Kit.setRaw(winsLabel, ("%d"):format(s.wins or 0))
		local free = s.freeSkips or 0
		local studioSkip = s.studio == true and Config.StudioFreeSkips
		local canBuy = Config.Products.SkipStage ~= 0
		skip.Visible = stage < 100 and (free > 0 or canBuy or studioSkip)
		if free > 0 then
			Kit.setText(skipTitle, "hud.free_skip")
			Kit.setText(skipSub, "hud.skips_left", { n = free })
		elseif skipPrice then
			Kit.setText(skipTitle, "hud.skip")
			Kit.setText(skipSub, "hud.price", { price = skipPrice })
		else
			Kit.setText(skipTitle, "hud.skip")
			Kit.setText(skipSub, if canBuy then "hud.robux" else "hud.studio_test")
		end
		skip10.Visible = stage < 100 and (Config.Products.Skip10 ~= 0 or studioSkip)
		if skip10Price then
			Kit.setText(skip10, "hud.skip10_price", { price = skip10Price })
		else
			Kit.setText(skip10, "hud.skip10")
		end
		local playClaimable = false
		local claimed = {}
		for _, i in (s.playClaimed or {}) :: { number } do
			claimed[i] = true
		end
		for i, r in Config.PlaytimeRewards do
			if not claimed[i] and Net.playSeconds() >= r.minutes * 60 then
				playClaimable = true
			end
		end
		rewardsBadge.Visible = (s.daily and s.daily.canClaim) or playClaimable
		-- menu extras: starter pack while on sale, group gift while unclaimed
		local starterOn = type(s.starter) == "table" and s.starter.available == true
		local groupOn = s.groupGift == true
		if starterBtn.Visible ~= starterOn or groupBtn.Visible ~= groupOn then
			starterBtn.Visible = starterOn
			groupBtn.Visible = groupOn
			Kit.relayout()
		end
		-- timer look
		local run = s.run
		local ranked = type(run) ~= "table" or run.valid ~= false
		timer.BackgroundColor3 = if ranked then Kit.C.blue else Kit.C.grey
		timerStroke.Color = Kit.darker(timer.BackgroundColor3, 0.45)
		if ranked then
			if type(run) == "table" and (run.best or 0) > 0 then
				Kit.setText(timerNote, "run.best", { time = RunTime.format(run.best) })
			else
				Kit.setRaw(timerNote, "")
			end
		else
			Kit.setText(timerNote, "run.unranked")
		end
	end

	-- run clock: server time based, so it survives respawns and matches the ranked result
	task.spawn(function()
		while true do
			local run = Net.state.run
			local ms = 0
			if type(run) == "table" then
				if run.finalMs then
					ms = run.finalMs
				elseif run.start then
					ms = (Workspace:GetServerTimeNow() - run.start) * 1000
				end
			end
			Kit.setRaw(timerLabel, RunTime.format(ms))
			task.wait(0.1)
		end
	end)

	Net.changed:Connect(function(new, prev)
		refresh()
		if prev.coins and new.coins and new.coins > prev.coins then
			Kit.pop(coinLabel.Parent :: Frame, 0.85)
		end
	end)
	Lang.changed:Connect(refresh)
	task.spawn(function()
		while true do
			task.wait(5)
			refresh()
		end
	end)
	refresh()
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">Intro</string>
              <string name="Source"><![CDATA[--!strict
-- Title card shown for a couple of seconds when you join: game name, tagline, and the ten world
-- colours popping in. Covers the moment the character and the tower are still streaming in, then
-- fades away. Never blocks input.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.Kit)
local Progress = require(script.Parent.Progress)

local Intro = {}

Intro.HOLD = 2.3 -- seconds on screen before the fade
Intro.FADE = 0.6

function Intro.play()
	local gui = Instance.new("ScreenGui")
	gui.Name = "SkyTowerIntro"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 50
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local card = Instance.new("CanvasGroup")
	card.Name = "Card"
	card.Size = UDim2.fromScale(1, 1)
	card.BorderSizePixel = 0
	card.BackgroundColor3 = Color3.new(1, 1, 1)
	card.Active = false
	card.Parent = gui
	Kit.gradient(card, Color3.fromRGB(70, 150, 255), Color3.fromRGB(150, 110, 255), 90)

	local title = Kit.bold(card, string.upper(Config.GameName), UDim2.fromScale(0.84, 0.24), UDim2.fromScale(0.5, 0.4), Kit.C.yellow, Vector2.new(0.5, 0.5), 120)
	title.Name = "Title"
	title.Rotation = -2
	local stroke = title:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Thickness = 5
	end
	Kit.pop(title, 0.5)
	local tagline = Kit.bold(card, "@intro.tagline", UDim2.fromScale(0.8, 0.09), UDim2.fromScale(0.5, 0.58), Kit.C.white, Vector2.new(0.5, 0.5), 44)
	tagline.Name = "Tagline"

	-- ten world dots, popping in one after another
	local row = Kit.frame(card, UDim2.fromScale(0.6, 0.06), UDim2.fromScale(0.5, 0.7), nil, Vector2.new(0.5, 0.5))
	row.Name = "Worlds"
	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Horizontal
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.VerticalAlignment = Enum.VerticalAlignment.Center
	list.Padding = UDim.new(0.02, 0)
	list.Parent = row
	for i, color in Progress.WORLD_COLORS do
		local dot = Kit.frame(row, UDim2.fromScale(0.07, 1), UDim2.new(), color)
		dot.LayoutOrder = i
		local ratio = Instance.new("UIAspectRatioConstraint")
		ratio.Parent = dot
		Kit.corner(dot, 100)
		Kit.stroke(dot, Kit.C.ink, 3)
		local scale = Instance.new("UIScale")
		scale.Scale = 0
		scale.Parent = dot
		TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, 0.25 + i * 0.09), { Scale = 1 }):Play()
	end

	task.delay(Intro.HOLD, function()
		local fade = TweenService:Create(card, TweenInfo.new(Intro.FADE, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { GroupTransparency = 1 })
		fade:Play()
		fade.Completed:Wait()
		gui:Destroy()
	end)
end

return Intro
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--!strict
-- Cartoony UI kit: palette, builders, screen regions that scale with the viewport
-- (UIScale per region, bigger on touch devices), and a one-panel-at-a-time modal system.
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local TextService = game:GetService("TextService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Lang = require(script.Parent.Parent.Lang)

local Kit = {}

---------------------------------------------------------------------------------------------
-- Localized text: any text passed to the builders as "@some.key" is translated, and every
-- object set through Kit.setText is re-translated live when the language changes.
---------------------------------------------------------------------------------------------
type Bound = { key: string, args: { [string]: any }?, prop: string }
-- Strong table (Instance keys in weak tables get dropped while the Instance is still alive);
-- entries are removed when the object is destroyed.
local bound: { [Instance]: Bound } = {}

local function applyBound(obj: Instance, b: Bound)
	(obj :: any)[b.prop] = Lang.t(b.key, b.args)
end

function Kit.setText(obj: Instance, key: string, args: { [string]: any }?, prop: string?)
	local b = { key = key, args = args, prop = prop or "Text" }
	if not bound[obj] then
		obj.Destroying:Once(function()
			bound[obj] = nil
		end)
	end
	bound[obj] = b
	applyBound(obj, b)
end

-- Plain (untranslated) text, e.g. numbers; drops any key bound to the object.
function Kit.setRaw(obj: Instance, text: string)
	bound[obj] = nil;
	(obj :: any).Text = text
end

local function setInitial(obj: Instance, text: string)
	if string.sub(text, 1, 1) == "@" then
		Kit.setText(obj, string.sub(text, 2))
	else
		(obj :: any).Text = text
	end
end

Lang.changed:Connect(function()
	for obj, b in bound do
		applyBound(obj, b)
	end
end)

Kit.Font = Enum.Font.FredokaOne
Kit.C = {
	ink = Color3.fromRGB(45, 40, 80),
	white = Color3.fromRGB(255, 255, 255),
	panel = Color3.fromRGB(255, 250, 242),
	card = Color3.fromRGB(255, 255, 255),
	blue = Color3.fromRGB(70, 160, 255),
	green = Color3.fromRGB(70, 205, 105),
	yellow = Color3.fromRGB(255, 200, 45),
	pink = Color3.fromRGB(255, 105, 170),
	red = Color3.fromRGB(255, 80, 90),
	purple = Color3.fromRGB(150, 100, 255),
	orange = Color3.fromRGB(255, 150, 50),
	grey = Color3.fromRGB(170, 170, 190),
	dark = Color3.fromRGB(35, 35, 60),
}

function Kit.darker(c: Color3, f: number?): Color3
	return c:Lerp(Color3.new(0, 0, 0), f or 0.25)
end

function Kit.corner(parent: Instance, radius: number?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 14)
	c.Parent = parent
	return c
end

function Kit.stroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color or Kit.C.ink
	s.Thickness = thickness or 3
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

function Kit.gradient(parent: Instance, a: Color3, b: Color3, rotation: number?): UIGradient
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(a, b)
	g.Rotation = rotation or 90
	g.Parent = parent
	return g
end

function Kit.frame(parent: Instance, size: UDim2, pos: UDim2, color: Color3?, anchor: Vector2?): Frame
	local f = Instance.new("Frame")
	f.Size = size
	f.Position = pos
	f.AnchorPoint = anchor or Vector2.zero
	f.BackgroundColor3 = color or Kit.C.panel
	f.BackgroundTransparency = if color then 0 else 1
	f.BorderSizePixel = 0
	f.Parent = parent
	return f
end

function Kit.text(parent: Instance, text: string, size: UDim2, pos: UDim2, color: Color3?, anchor: Vector2?, maxSize: number?): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = size
	t.Position = pos
	t.AnchorPoint = anchor or Vector2.zero
	t.Font = Kit.Font
	setInitial(t, text)
	t.TextColor3 = color or Kit.C.white
	t.TextScaled = true
	t.RichText = true
	local c = Instance.new("UITextSizeConstraint")
	c.MaxTextSize = maxSize or 40
	c.Parent = t
	t.Parent = parent
	return t
end

-- Outlined white text (for text on colourful backgrounds).
function Kit.bold(parent: Instance, text: string, size: UDim2, pos: UDim2, color: Color3?, anchor: Vector2?, maxSize: number?): TextLabel
	local t = Kit.text(parent, text, size, pos, color, anchor, maxSize)
	local s = Instance.new("UIStroke")
	s.Color = Kit.C.ink
	s.Thickness = 2.5
	s.Parent = t
	return t
end

-- Button states. The face gradient ends in a darker "lip" (the 3D base of the button):
--   rest    : lip visible, scale 1
--   hover   : scale 1.04 + white outline (mouse only)
--   pressed : the face slides down over the lip, scale 0.95
-- Released / activated: springs back to rest (or hover).
local LIP = 0.86
local function faceGradient(): ColorSequence
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(0.45, Color3.fromRGB(240, 240, 240)),
		ColorSequenceKeypoint.new(LIP, Color3.fromRGB(215, 215, 215)),
		ColorSequenceKeypoint.new(LIP + 0.01, Color3.fromRGB(150, 150, 150)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 150, 150)),
	})
end

local function wireStates(btn: GuiButton, border: UIStroke, face: UIGradient)
	local scale = btn:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	scale.Parent = btn
	local hovered, down = false, false
	local function update(spring: boolean)
		local target = if down then 0.95 elseif hovered then 1.04 else 1
		local info = if spring then TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out) else TweenInfo.new(0.07)
		TweenService:Create(scale, info, { Scale = target }):Play()
		TweenService:Create(face, TweenInfo.new(0.07), { Offset = Vector2.new(0, if down then 1 - LIP else 0) }):Play()
		-- the outline follows the button colour (panels recolour buttons for on / off states)
		border.Color = if hovered and not down then Color3.new(1, 1, 1) else btn.BackgroundColor3:Lerp(Color3.new(0, 0, 0), 0.45)
	end
	btn.MouseEnter:Connect(function()
		hovered = true
		update(false)
	end)
	btn.MouseLeave:Connect(function()
		hovered, down = false, false
		update(true)
	end)
	btn.MouseButton1Down:Connect(function()
		down = true
		update(false)
	end)
	btn.MouseButton1Up:Connect(function()
		down = false
		update(true)
	end)
	btn:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
		update(false)
	end)
	-- touch taps and gamepad activations don't always send Down / Up: give them the same dip
	btn.Activated:Connect(function()
		if not down then
			down = true
			update(false)
			task.delay(0.08, function()
				down = false
				update(true)
			end)
		end
	end)
end

-- Chunky 3D-ish button: coloured face over a darker "shadow" base.
function Kit.button(parent: Instance, text: string, size: UDim2, pos: UDim2, color: Color3, onClick: () -> (), anchor: Vector2?, maxText: number?): TextButton
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = pos
	b.AnchorPoint = anchor or Vector2.zero
	b.BackgroundColor3 = color
	b.AutoButtonColor = false
	b.Font = Kit.Font
	setInitial(b, text)
	b.TextColor3 = Kit.C.white
	b.TextScaled = true
	b.RichText = true
	b.Parent = parent
	Kit.corner(b, 14)
	local st = Kit.stroke(b, Kit.darker(color, 0.45), 3)
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	local face = Instance.new("UIGradient")
	face.Color = faceGradient()
	face.Rotation = 90
	face.Parent = b
	local ts = Instance.new("UITextSizeConstraint")
	ts.MaxTextSize = maxText or 30
	ts.Parent = b
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 6)
	pad.PaddingRight = UDim.new(0, 6)
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = b
	local textStroke = Instance.new("UIStroke")
	textStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	textStroke.Color = Kit.darker(color, 0.5)
	textStroke.Thickness = 2
	textStroke.Parent = b
	wireStates(b, st, face)
	b.Activated:Connect(onClick)
	return b
end

-- Drawn coin (the coin emoji is missing from Roblox's emoji font).
function Kit.coin(parent: Instance, size: number, pos: UDim2, anchor: Vector2?): Frame
	local c = Kit.frame(parent, UDim2.fromOffset(size, size), pos, Color3.fromRGB(255, 205, 40), anchor)
	Kit.corner(c, size)
	Kit.stroke(c, Color3.fromRGB(200, 130, 10), math.max(2, size * 0.09))
	local inner = Kit.frame(c, UDim2.fromScale(0.56, 0.56), UDim2.fromScale(0.5, 0.5), Color3.fromRGB(255, 225, 100), Vector2.new(0.5, 0.5))
	Kit.corner(inner, size)
	Kit.stroke(inner, Color3.fromRGB(225, 160, 20), math.max(1, size * 0.06))
	return c
end

-- Keeps a short label on ONE line at the biggest size that fits (TextScaled would rather break a
-- long word like "Checkpoint" in two than shrink it). Re-fits on text / size / language changes.
function Kit.singleLine(obj: TextButton, maxSize: number)
	obj.TextScaled = false
	obj.TextWrapped = false
	local busy = false
	local function fit()
		if busy then
			return
		end
		busy = true
		local pad = obj:FindFirstChildOfClass("UIPadding")
		local padX = if pad then pad.PaddingLeft.Offset + pad.PaddingRight.Offset else 0
		local padY = if pad then pad.PaddingTop.Offset + pad.PaddingBottom.Offset else 0
		-- design (unscaled) box: TextSize is scaled by the region's UIScale just like Size
		local w = obj.Size.X.Offset - padX - 4
		local h = obj.Size.Y.Offset - padY
		local size = math.min(maxSize, math.floor(h))
		local plain = string.gsub(obj.Text, "<[^>]+>", "")
		while size > 8 do
			local ok, bounds = pcall(function()
				return TextService:GetTextSize(plain, size, obj.Font, Vector2.new(10000, 10000))
			end)
			if not ok or bounds.X <= w then
				break
			end
			size -= 1
		end
		obj.TextSize = size
		busy = false
	end
	obj:GetPropertyChangedSignal("Text"):Connect(fit)
	obj:GetPropertyChangedSignal("Size"):Connect(fit)
	fit()
end

function Kit.pop(obj: GuiObject, from: number?)
	local scale = obj:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	scale.Parent = obj
	scale.Scale = from or 0.4
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

function Kit.formatNumber(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

function Kit.formatTime(sec: number): string
	sec = math.max(0, math.floor(sec))
	local h = sec // 3600
	local m = (sec % 3600) // 60
	local s = sec % 60
	if h > 0 then
		return ("%dh %02dm"):format(h, m)
	end
	return ("%d:%02d"):format(m, s)
end

---------------------------------------------------------------------------------------------
-- ScreenGui + scaled regions
---------------------------------------------------------------------------------------------
local gui: ScreenGui? = nil
type Region = { frame: Frame, scale: UIScale, fit: Vector2? }
local regions: { Region } = {}

function Kit.isTouch(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function baseScale(): (number, Vector2)
	local cam = Workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
	local s = math.min(vp.X / 1280, vp.Y / 720)
	if s < 1 then
		s = s ^ 0.6 -- shrink less than linearly on small screens so buttons stay tappable
	end
	if Kit.isTouch() then
		s *= 1.25 -- bigger touch targets on phones/tablets
	end
	return math.clamp(s, 0.55, 1.5), vp
end

type LayoutFn = (touch: boolean, area: Vector2, scale: number) -> ()
local layoutFns: { LayoutFn } = {}
local playerListOn: boolean? = nil

-- Usable area of the ScreenGui (the viewport minus the Roblox top bar, see CoreUISafeInsets).
function Kit.area(): Vector2
	local size = if gui then gui.AbsoluteSize else Vector2.zero
	if size.X < 10 then
		local cam = Workspace.CurrentCamera
		size = if cam then cam.ViewportSize else Vector2.new(1280, 720)
	end
	return size
end

local function rescale()
	local s, vp = baseScale()
	local area = Kit.area()
	for _, r in regions do
		local v = s
		if r.fit then
			-- panels: as big as the screen allows (capped), so their buttons stay tappable on
			-- phones regardless of the HUD scale, and never past the screen edges
			v = math.min(Kit.PANEL_MAX_SCALE, (area.X - 24) / r.fit.X, (area.Y - 24) / r.fit.Y)
			-- the drop shadow (22 design px below the panel) only where it fits on screen: on
			-- phones the panel takes the whole height and the dim veil does the separating
			local window = r.frame:FindFirstChild("Window")
			if window then
				local room = math.min((area.Y - v * r.fit.Y) / 2 - area.Y * 0.02, (area.X - v * r.fit.X) / 2)
				for _, c in window:GetChildren() do
					if c.Name == "Shadow" and c:IsA("GuiObject") then
						c.Visible = room >= 26 * v
					end
				end
			end
		end
		r.scale.Scale = v
	end
	-- The default player list covers the right side on phones/small windows: hide it there.
	local wantList = not Kit.isTouch() and vp.X >= 1000
	if wantList ~= playerListOn then
		playerListOn = wantList
		pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, wantList)
		end)
	end
	local touch = Kit.isTouch()
	for _, fn in layoutFns do
		fn(touch, area, s)
	end
end

-- Re-runs every layout function (e.g. after a HUD element was shown or hidden).
function Kit.relayout()
	rescale()
end

-- Registers a function that re-positions regions whenever the screen size / input mode changes.
function Kit.onLayout(fn: LayoutFn)
	table.insert(layoutFns, fn)
	local s = baseScale()
	fn(Kit.isTouch(), Kit.area(), s)
end

Kit.PANEL_MAX_SCALE = 1.1

-- Overrides one region's scale (call from an onLayout function; the next rescale resets it first).
function Kit.setScale(region: Frame, value: number)
	local sc = region:FindFirstChildOfClass("UIScale")
	if sc then
		sc.Scale = value
	end
end

-- Bottom edge (px from the top of the safe area) of the always-on top-centre HUD; Hud keeps it updated.
Kit.hudTop = 0

-- Current base UI scale (what regions without `fit` use).
function Kit.scale(): number
	return (baseScale())
end

function Kit.gui(): ScreenGui
	if gui then
		return gui
	end
	local g = Instance.new("ScreenGui")
	g.Name = "SkyTowerUI"
	g.ResetOnSpawn = false
	-- keep everything below the Roblox top bar (menu / chat buttons) and inside notches
	g.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	g.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = g
	local function hook()
		local cam = Workspace.CurrentCamera
		if cam then
			cam:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
		end
		rescale()
	end
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hook)
	g:GetPropertyChangedSignal("AbsoluteSize"):Connect(rescale)
	UserInputService.LastInputTypeChanged:Connect(rescale)
	hook()
	return g
end

-- A transparent container of `designSize` pixels, anchored on screen, scaled as one unit.
function Kit.region(name: string, anchor: Vector2, pos: UDim2, designSize: Vector2, fitScreen: boolean?): Frame
	local f = Kit.frame(Kit.gui(), UDim2.fromOffset(designSize.X, designSize.Y), pos, nil, anchor)
	f.Name = name
	local s = Instance.new("UIScale")
	s.Parent = f
	table.insert(regions, { frame = f, scale = s, fit = if fitScreen then designSize else nil })
	rescale()
	return f
end

---------------------------------------------------------------------------------------------
-- Panels (modal windows, one open at a time)
---------------------------------------------------------------------------------------------
type Panel = { root: Frame, onOpen: (() -> ())? }
local panels: { [string]: Panel } = {}
local current: string? = nil
local panelChanged = Instance.new("BindableEvent")
Kit.panelChanged = panelChanged.Event

-- Dark veil behind the open panel (covers the whole screen, top bar included). Tapping it closes
-- the panel.
local dim: TextButton? = nil
local function ensureDim(): TextButton
	if dim then
		return dim
	end
	local g = Kit.gui()
	local d = Instance.new("TextButton")
	d.Name = "Dim"
	d.Text = ""
	d.AutoButtonColor = false
	d.BackgroundColor3 = Color3.fromRGB(15, 15, 35)
	d.BackgroundTransparency = 1
	d.BorderSizePixel = 0
	d.ZIndex = 9
	d.Visible = false
	d.Parent = g
	local probe = Kit.frame(g, UDim2.fromOffset(1, 1), UDim2.new(), nil)
	probe.Name = "Origin"
	Kit.onLayout(function()
		local cam = Workspace.CurrentCamera
		local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
		local inset = GuiService:GetGuiInset()
		-- AbsolutePosition is measured from under the top bar: shift up / left to the real corner
		d.Position = UDim2.fromOffset(-probe.AbsolutePosition.X, -probe.AbsolutePosition.Y - inset.Y)
		d.Size = UDim2.fromOffset(vp.X, vp.Y)
	end)
	d.Activated:Connect(function()
		Kit.close()
	end)
	dim = d
	return d
end

local function showDim(on: boolean)
	local d = ensureDim()
	if on then
		d.Visible = true
		TweenService:Create(d, TweenInfo.new(0.18), { BackgroundTransparency = 0.5 }):Play()
	else
		d.BackgroundTransparency = 1
		d.Visible = false
	end
end

function Kit.panel(name: string, title: string, color: Color3): (Frame, Frame)
	local root = Kit.region("Panel_" .. name, Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.52), Vector2.new(640, 460), true)
	root.Visible = false
	root.ZIndex = 10
	ensureDim()
	-- "Window" is what pops open: a soft drop shadow under the body
	local window = Kit.frame(root, UDim2.fromScale(1, 1), UDim2.fromScale(0.5, 0.5), nil, Vector2.new(0.5, 0.5))
	window.Name = "Window"
	for i, spread in { 14, 7 } do
		local shadow = Kit.frame(window, UDim2.new(1, spread * 2, 1, spread * 2), UDim2.new(0.5, 0, 0.5, 8), Color3.new(0, 0, 0), Vector2.new(0.5, 0.5))
		shadow.Name = "Shadow"
		shadow.BackgroundTransparency = if i == 1 then 0.88 else 0.8
		Kit.corner(shadow, 24 + spread)
	end
	local body = Kit.frame(window, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), Kit.C.panel)
	body.Name = "Body"
	Kit.corner(body, 24)
	Kit.stroke(body, Kit.C.ink, 4)
	local header = Kit.frame(body, UDim2.new(1, 0, 0, 64), UDim2.fromScale(0, 0), color)
	Kit.corner(header, 24)
	Kit.gradient(header, Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 215))
	local headerFill = Kit.frame(header, UDim2.new(1, 0, 0, 24), UDim2.new(0, 0, 1, -24), Kit.darker(color, 0.12))
	headerFill.Name = "SquareBottom"
	local headerLine = Kit.frame(header, UDim2.new(1, 0, 0, 4), UDim2.new(0, 0, 1, -2), Kit.darker(color, 0.4))
	headerLine.Name = "Line"
	Kit.bold(header, title, UDim2.new(1, -140, 1, -12), UDim2.fromOffset(24, 6), Kit.C.white, nil, 38).TextXAlignment = Enum.TextXAlignment.Left
	Kit.button(header, "X", UDim2.fromOffset(52, 52), UDim2.new(1, -10, 0.5, 0), Kit.C.red, function()
		Kit.close()
	end, Vector2.new(1, 0.5), 30)
	Kit.relayout() -- decides whether this panel's shadow fits
	local content = Kit.frame(body, UDim2.new(1, -32, 1, -84), UDim2.fromOffset(16, 72), nil)
	content.Name = "Content"
	panels[name] = { root = root }
	return content, root
end

function Kit.onOpen(name: string, fn: () -> ())
	local p = panels[name]
	if p then
		p.onOpen = fn
	end
end

function Kit.open(name: string)
	for n, p in panels do
		p.root.Visible = n == name
	end
	local p = panels[name]
	if not p then
		return
	end
	current = name
	showDim(true)
	Kit.pop(p.root:FindFirstChild("Window") :: Frame, 0.6)
	if p.onOpen then
		p.onOpen()
	end
	panelChanged:Fire(name)
end

function Kit.close()
	for _, p in panels do
		p.root.Visible = false
	end
	current = nil
	showDim(false)
	panelChanged:Fire(nil)
end

function Kit.toggle(name: string)
	if current == name then
		Kit.close()
	else
		Kit.open(name)
	end
end

function Kit.current(): string?
	return current
end

-- Scrolling grid used by shop/store panels.
function Kit.grid(parent: Instance, cell: Vector2, size: UDim2?, pos: UDim2?): ScrollingFrame
	local sf = Instance.new("ScrollingFrame")
	sf.Size = size or UDim2.fromScale(1, 1)
	sf.Position = pos or UDim2.fromScale(0, 0)
	sf.BackgroundTransparency = 1
	sf.BorderSizePixel = 0
	sf.ScrollBarThickness = 8
	sf.ScrollBarImageColor3 = Kit.C.ink
	sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
	sf.CanvasSize = UDim2.new()
	sf.ScrollingDirection = Enum.ScrollingDirection.Y
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(cell.X, cell.Y)
	layout.CellPadding = UDim2.fromOffset(12, 12)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = sf
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.Parent = sf
	sf.Parent = parent
	return sf
end

function Kit.card(parent: Instance, order: number): Frame
	local c = Kit.frame(parent, UDim2.fromOffset(100, 100), UDim2.new(), Kit.C.card)
	c.LayoutOrder = order
	Kit.corner(c, 16)
	Kit.stroke(c, Color3.fromRGB(220, 210, 235), 3)
	return c
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">Progress</string>
              <string name="Source"><![CDATA[--!strict
-- Tower progress bar: your % plus avatar dots for everyone else in the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Segments = require(ReplicatedStorage.Shared.Segments)
local Kit = require(script.Parent.Kit)

local Progress = {}

local TOTAL = 100
local BAR_W = 500
local thumbs: { [number]: string } = {}

-- One colour per world (10 stages each), in tower order: the bar shows which world you are in
-- and what is coming.
Progress.WORLD_COLORS = {
	Color3.fromRGB(110, 205, 90), -- Grassy Hills
	Color3.fromRGB(255, 140, 205), -- Candy Land
	Color3.fromRGB(140, 210, 255), -- Frozen Peaks
	Color3.fromRGB(240, 190, 100), -- Desert Ruins
	Color3.fromRGB(255, 110, 40), -- Lava Caves
	Color3.fromRGB(60, 195, 200), -- Ocean Reef
	Color3.fromRGB(165, 225, 50), -- Toxic Factory
	Color3.fromRGB(190, 205, 255), -- Cloud Kingdom
	Color3.fromRGB(185, 85, 255), -- Neon Space
	Color3.fromRGB(255, 205, 60), -- Rainbow Summit
}

local function worldSequence(): ColorSequence
	local points = {}
	for _, stop in Segments.colorStops(#Progress.WORLD_COLORS) do
		table.insert(points, ColorSequenceKeypoint.new(stop.t, Progress.WORLD_COLORS[stop.index]))
	end
	return ColorSequence.new(points)
end

local function reveal(p: number): NumberSequence
	local points = {}
	for _, stop in Segments.revealStops(p) do
		table.insert(points, NumberSequenceKeypoint.new(stop.t, stop.value))
	end
	return NumberSequence.new(points)
end

local function headshot(userId: number): string
	local cached = thumbs[userId]
	if cached then
		return cached
	end
	thumbs[userId] = "" -- in flight
	task.spawn(function()
		local ok, url = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
		end)
		thumbs[userId] = if ok then url else ""
	end)
	return ""
end

local function stageOf(p: Player): number
	local v = p:GetAttribute("Stage")
	if type(v) == "number" then
		return v
	end
	local ls = p:FindFirstChild("leaderstats")
	local st = ls and ls:FindFirstChild("Stage")
	if st and st:IsA("IntValue") then
		return st.Value
	end
	return 0
end

function Progress.init()
	local r = Kit.region("Progress", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 10), Vector2.new(BAR_W + 40, 84))
	local track = Kit.frame(r, UDim2.fromOffset(BAR_W, 22), UDim2.new(0.5, 0, 0, 44), Color3.fromRGB(255, 255, 255), Vector2.new(0.5, 0))
	Kit.corner(track, 11)
	Kit.stroke(track, Kit.C.ink, 3)
	-- the whole bar in pale world colours, and on top of it the part you've climbed at full
	-- strength (same gradient, revealed up to your progress)
	local ghost = Kit.frame(track, UDim2.fromScale(1, 1), UDim2.new(), Color3.fromRGB(255, 255, 255))
	ghost.Name = "Worlds"
	Kit.corner(ghost, 11)
	local ghostGradient = Instance.new("UIGradient")
	ghostGradient.Color = worldSequence()
	ghostGradient.Transparency = NumberSequence.new(0.72)
	ghostGradient.Parent = ghost
	local fill = Kit.frame(track, UDim2.fromScale(1, 1), UDim2.new(), Color3.fromRGB(255, 255, 255))
	fill.Name = "Fill"
	Kit.corner(fill, 11)
	local fillGradient = Instance.new("UIGradient")
	fillGradient.Color = worldSequence()
	fillGradient.Transparency = reveal(0)
	fillGradient.Parent = fill
	local shownFraction = -1
	local pct = Kit.bold(track, "0%", UDim2.fromScale(1, 1.1), UDim2.fromScale(0, -0.05), Kit.C.white, nil, 20)
	pct.ZIndex = 3
	-- milestone ticks every 10 stages
	for i = 1, 9 do
		local tick = Kit.frame(track, UDim2.new(0, 2, 1, 0), UDim2.fromScale(i / 10, 0), Kit.C.ink)
		tick.BackgroundTransparency = 0.55
		tick.ZIndex = 2
	end
	local markers = Kit.frame(r, UDim2.fromOffset(BAR_W, 40), UDim2.new(0.5, 0, 0, 2), nil, Vector2.new(0.5, 0))
	markers.Name = "Markers"

	local dots: { [Player]: ImageLabel } = {}
	local function dotFor(p: Player): ImageLabel
		local d = dots[p]
		if d then
			return d
		end
		local isMe = p == Players.LocalPlayer
		local size = if isMe then 36 else 26
		local img = Instance.new("ImageLabel")
		img.Size = UDim2.fromOffset(size, size)
		img.AnchorPoint = Vector2.new(0.5, 1)
		img.BackgroundColor3 = if isMe then Kit.C.yellow else Color3.fromRGB(230, 230, 245)
		img.ZIndex = if isMe then 5 else 4
		Kit.corner(img, size)
		Kit.stroke(img, if isMe then Kit.C.orange else Kit.C.ink, if isMe then 3 else 2)
		local name = Kit.bold(img, p.DisplayName, UDim2.fromOffset(90, 16), UDim2.new(0.5, 0, 0, -16), Kit.C.white, Vector2.new(0.5, 0), 14)
		name.Visible = not isMe
		name.Name = "NameTag"
		img.Parent = markers
		dots[p] = img
		return img
	end

	Players.PlayerRemoving:Connect(function(p)
		local d = dots[p]
		if d then
			d:Destroy()
			dots[p] = nil
		end
	end)

	task.spawn(function()
		while true do
			local me = Players.LocalPlayer
			local myStage = stageOf(me)
			local fraction = math.clamp(myStage / TOTAL, 0, 1)
			if fraction ~= shownFraction then
				shownFraction = fraction
				fillGradient.Transparency = reveal(fraction)
			end
			Kit.setText(pct, "progress.label", { stage = myStage, total = TOTAL, pct = math.floor(myStage / TOTAL * 100) })
			local shown = 0
			for _, p in Players:GetPlayers() do
				if p == me or shown < 15 then
					if p ~= me then
						shown += 1
					end
					local d = dotFor(p)
					d.Position = UDim2.new(math.clamp(stageOf(p) / TOTAL, 0, 1), 0, 1, if p == me then 2 else 0)
					if d.Image == "" then
						d.Image = headshot(p.UserId)
					end
				end
			end
			task.wait(0.5)
		end
	end)
end

return Progress
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">Prompts</string>
              <string name="Source"><![CDATA[--!strict
-- Server-triggered cards:
--   OfferSkip (P0-1)        "Stuck on stage N?" after a death streak: free skip / watch a video /
--                           buy a skip (Studio with product ids at 0: free dev skip).
--   AskNotifications (P0-8) "Want a ping when 2x Coins Weekend starts?" -> ExperienceNotificationService.
local AdService = game:GetService("AdService")
local ExperienceNotificationService = game:GetService("ExperienceNotificationService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(script.Parent.Parent.Net)
local Lang = require(script.Parent.Parent.Lang)
local Kit = require(script.Parent.Kit)
local Cards = require(script.Parent.Cards)
local Toast = require(script.Parent.Toast)
local Hud = require(script.Parent.Hud)

local Prompts = {}

local OFFER_SECONDS = 10

local function adAvailable(): boolean
	if Config.Products.AdSkip == 0 then
		return false
	end
	local ok, result = pcall(function()
		return AdService:GetAdAvailabilityNowAsync(Enum.AdFormat.RewardedVideo)
	end)
	return ok and type(result) == "table" and result.AdAvailabilityResult == Enum.AdAvailabilityResult.IsAvailable
end

local function say(ok: boolean, msg: string?, _data: any?)
	if msg then
		Toast.show(msg, if ok then "success" else "error")
	end
end

function Prompts.offerSkip(data: { [string]: any })
	local s = Net.state
	local stage = tonumber(data.stage) or ((s.stage or 0) + 1)
	local buttons: { Cards.CardButton } = {}
	local free = s.freeSkips or tonumber(data.freeSkips) or 0
	if free > 0 then
		table.insert(buttons, {
			name = "FreeSkip",
			text = Lang.t("offer.free", { n = free }),
			color = Kit.C.green,
			onClick = function()
				say(Net.request("UseFreeSkip"))
			end,
		})
	end
	-- ask AdService only when the card opens (it can yield), then show the card
	if data.adAvailableHint and adAvailable() then
		table.insert(buttons, {
			name = "AdSkip",
			text = Lang.t("offer.ad"),
			color = Kit.C.purple,
			onClick = function()
				say(Net.request("WatchAd", { placement = "skip" }))
			end,
		})
	end
	if Config.Products.SkipStage ~= 0 then
		local price = Hud.priceOf(Config.Products.SkipStage)
		table.insert(buttons, {
			name = "PaidSkip",
			text = if price then Lang.t("offer.paid", { price = price }) else Lang.t("offer.paid_noprice"),
			color = Kit.C.blue,
			onClick = function()
				MarketplaceService:PromptProductPurchase(Players.LocalPlayer, Config.Products.SkipStage)
			end,
		})
	elseif s.studio and Config.StudioFreeSkips then
		table.insert(buttons, {
			name = "PaidSkip",
			text = Lang.t("offer.studio"),
			color = Kit.C.blue,
			onClick = function()
				say(Net.request("DevSkip", { n = 1 }))
			end,
		})
	end
	if #buttons == 0 then
		return
	end
	Cards.show("offer", Lang.t("offer.title", { n = stage }), buttons, OFFER_SECONDS)
end

function Prompts.askNotifications()
	local ok, can = pcall(function()
		return ExperienceNotificationService:CanPromptOptInAsync()
	end)
	if not ok or not can then
		return -- not eligible (or Studio): nothing to ask
	end
	Cards.show("notify", Lang.t("notify.title"), {
		{
			name = "Yes",
			text = Lang.t("notify.yes"),
			color = Kit.C.green,
			onClick = function()
				pcall(function()
					ExperienceNotificationService:PromptOptIn()
				end)
			end,
		},
		{ name = "No", text = Lang.t("notify.no"), color = Kit.C.grey, onClick = function() end },
	}, 15)
end

function Prompts.init()
	Net.on("OfferSkip", function(data)
		task.spawn(Prompts.offerSkip, if type(data) == "table" then data else {})
	end)
	Net.on("AskNotifications", function()
		task.spawn(Prompts.askNotifications)
	end)
	-- a skip / new checkpoint makes the offer pointless
	Net.changed:Connect(function(new, prev)
		if prev.stage and new.stage ~= prev.stage then
			Cards.hide("offer")
		end
	end)
end

return Prompts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">RewardsPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Daily reward, play-time rewards (5/15/30/60 min this session) and codes.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(script.Parent.Parent.Net)
local Kit = require(script.Parent.Kit)
local Toast = require(script.Parent.Toast)

local RewardsPanel = {}

local function say(ok: boolean, msg: string?, _extra: any?)
	if msg then
		Toast.show(msg, if ok then "success" else "error")
	end
end

function RewardsPanel.init()
	local content = Kit.panel("rewards", "@panel.rewards", Kit.C.orange)

	-- daily ------------------------------------------------------------------------------------
	local daily = Kit.frame(content, UDim2.new(0.5, -8, 0, 170), UDim2.fromOffset(0, 0), Kit.C.card)
	Kit.corner(daily, 16)
	Kit.stroke(daily, Color3.fromRGB(220, 210, 235), 3)
	Kit.text(daily, "@rewards.daily", UDim2.new(1, -20, 0, 34), UDim2.fromOffset(10, 8), Kit.C.ink, nil, 30)
	local dailyInfo = Kit.text(daily, "", UDim2.new(1, -20, 0, 50), UDim2.fromOffset(10, 44), Color3.fromRGB(110, 105, 140), nil, 20)
	local dailyBtn = Kit.button(daily, "@rewards.claim", UDim2.new(1, -20, 0, 56), UDim2.new(0, 10, 1, -66), Kit.C.green, function()
		say(Net.request("ClaimDaily"))
	end)

	-- codes ---------------------------------------------------------------------------------------
	local codes = Kit.frame(content, UDim2.new(0.5, -8, 0, 170), UDim2.new(0.5, 8, 0, 0), Kit.C.card)
	Kit.corner(codes, 16)
	Kit.stroke(codes, Color3.fromRGB(220, 210, 235), 3)
	Kit.text(codes, "@rewards.codes", UDim2.new(1, -20, 0, 34), UDim2.fromOffset(10, 8), Kit.C.ink, nil, 30)
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, -20, 0, 48)
	box.Position = UDim2.fromOffset(10, 46)
	box.BackgroundColor3 = Color3.fromRGB(245, 242, 250)
	Kit.setText(box, "rewards.enter_code", nil, "PlaceholderText")
	box.Text = ""
	box.Font = Kit.Font
	box.TextScaled = true
	box.TextColor3 = Kit.C.ink
	box.ClearTextOnFocus = false
	Kit.corner(box, 12)
	Kit.stroke(box, Color3.fromRGB(200, 190, 220), 2)
	local tsc = Instance.new("UITextSizeConstraint")
	tsc.MaxTextSize = 26
	tsc.Parent = box
	box.Parent = codes
	Kit.button(codes, "@rewards.redeem", UDim2.new(1, -20, 0, 56), UDim2.new(0, 10, 1, -66), Kit.C.blue, function()
		local ok, msg = Net.request("RedeemCode", { code = box.Text })
		say(ok, msg)
		if ok then
			box.Text = ""
		end
	end)

	-- play time -----------------------------------------------------------------------------------
	Kit.text(content, "@rewards.playtime", UDim2.new(1, 0, 0, 30), UDim2.fromOffset(0, 180), Kit.C.ink, nil, 26)
	local rows: { { btn: TextButton, bar: Frame, label: TextLabel } } = {}
	local n = #Config.PlaytimeRewards
	for i, r in Config.PlaytimeRewards do
		local w = 1 / n
		local cell = Kit.frame(content, UDim2.new(w, -8, 0, 160), UDim2.new(w * (i - 1), 4, 0, 214), Kit.C.card)
		Kit.corner(cell, 14)
		Kit.stroke(cell, Color3.fromRGB(220, 210, 235), 3)
		local minutes = Kit.text(cell, "", UDim2.new(1, -10, 0, 26), UDim2.fromOffset(5, 4), Kit.C.ink, nil, 24)
		Kit.setText(minutes, "rewards.minutes", { n = r.minutes })
		local rewardText = Kit.text(cell, "", UDim2.new(1, -10, 0, 36), UDim2.fromOffset(5, 30), Color3.fromRGB(200, 140, 20), nil, 20)
		if r.freeSkips > 0 then
			Kit.setText(rewardText, "rewards.coins_skips", { coins = r.coins, n = r.freeSkips })
		else
			Kit.setText(rewardText, "rewards.coins", { coins = r.coins })
		end
		local track = Kit.frame(cell, UDim2.new(1, -16, 0, 8), UDim2.fromOffset(8, 70), Color3.fromRGB(230, 225, 240))
		Kit.corner(track, 5)
		local bar = Kit.frame(track, UDim2.fromScale(0, 1), UDim2.new(), Kit.C.green)
		Kit.corner(bar, 5)
		local label = Kit.text(cell, "", UDim2.new(1, -10, 0, 20), UDim2.fromOffset(5, 80), Color3.fromRGB(110, 105, 140), nil, 16)
		local btn = Kit.button(cell, "@rewards.claim", UDim2.new(1, -16, 0, 48), UDim2.new(0, 8, 1, -54), Kit.C.green, function()
			say(Net.request("ClaimPlaytime", { index = i }))
		end, nil, 20)
		rows[i] = { btn = btn, bar = bar, label = label }
	end

	local function refresh()
		local s = Net.state
		local d = s.daily or {}
		local day = d.day or 1
		local amount = Config.DailyRewards[math.min(day, #Config.DailyRewards)]
		if Net.hasPass("VIP") then
			amount *= 2
		end
		if d.canClaim then
			Kit.setText(dailyInfo, "rewards.day_streak", { day = day, coins = amount })
			Kit.setText(dailyBtn, "rewards.claim_now")
			dailyBtn.BackgroundColor3 = Kit.C.green
		else
			Kit.setText(dailyInfo, "rewards.next_in", { time = Kit.formatTime((d.nextIn or 0) - (os.clock() - Net.stateAt)) })
			Kit.setText(dailyBtn, "rewards.claimed")
			dailyBtn.BackgroundColor3 = Kit.C.grey
		end
		local claimed = {}
		for _, i in (s.playClaimed or {}) :: { number } do
			claimed[i] = true
		end
		local played = Net.playSeconds()
		for i, r in Config.PlaytimeRewards do
			local row = rows[i]
			local need = r.minutes * 60
			local k = math.clamp(played / need, 0, 1)
			row.bar.Size = UDim2.fromScale(k, 1)
			if claimed[i] then
				Kit.setText(row.btn, "rewards.done")
				row.btn.BackgroundColor3 = Kit.C.grey
				Kit.setText(row.label, "rewards.claimed")
			elseif k >= 1 then
				Kit.setText(row.btn, "rewards.claim_now")
				row.btn.BackgroundColor3 = Kit.C.green
				Kit.setText(row.label, "rewards.ready")
			else
				Kit.setText(row.btn, "rewards.wait")
				row.btn.BackgroundColor3 = Kit.C.grey
				Kit.setRaw(row.label, Kit.formatTime(need - played))
			end
		end
	end

	Kit.onOpen("rewards", refresh)
	Net.changed:Connect(function()
		if Kit.current() == "rewards" then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if Kit.current() == "rewards" then
				refresh()
			end
		end
	end)
end

return RewardsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">SettingsPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Settings: coil toggles (speed / gravity; if the pass isn't owned the toggle offers it), the
-- visual-effects switch for slow devices, and the language picker.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(script.Parent.Parent.Net)
local Kit = require(script.Parent.Kit)
local Toast = require(script.Parent.Toast)
local Lang = require(script.Parent.Parent.Lang)
local Locale = require(ReplicatedStorage.Shared.Locale)

local SettingsPanel = {}

type Row = { key: string, pass: string?, title: string, desc: string }
local ROWS: { Row } = {
	{ key = "speedCoil", pass = "SpeedCoil", title = "@settings.speed", desc = "@settings.speed_desc" },
	{ key = "gravityCoil", pass = "GravityCoil", title = "@settings.gravity", desc = "@settings.gravity_desc" },
	{ key = "effects", pass = nil, title = "@settings.effects", desc = "@settings.effects_desc" },
}
local ROW_H = 64
local ROW_PITCH = 70
local LANG_TOP = #ROWS * ROW_PITCH -- 210
local LANG_H = 45
local LANG_PITCH = 49

local function isOn(row: Row): boolean
	local settings = Net.state.settings or {}
	-- effects default to on (profiles saved before the switch existed have no value yet)
	return if row.key == "effects" then settings.effects ~= false else settings[row.key] == true
end

function SettingsPanel.init()
	local content = Kit.panel("settings", "@panel.settings", Kit.C.grey)
	local buttons: { [string]: TextButton } = {}
	for i, row in ROWS do
		local card = Kit.frame(content, UDim2.new(1, 0, 0, ROW_H), UDim2.fromOffset(0, (i - 1) * ROW_PITCH), Kit.C.card)
		Kit.corner(card, 16)
		Kit.stroke(card, Color3.fromRGB(220, 210, 235), 3)
		local t = Kit.text(card, row.title, UDim2.new(1, -196, 0, 30), UDim2.fromOffset(18, 4), Kit.C.ink, nil, 27)
		t.TextXAlignment = Enum.TextXAlignment.Left
		local d = Kit.text(card, row.desc, UDim2.new(1, -196, 0, 22), UDim2.fromOffset(18, 36), Color3.fromRGB(110, 105, 140), nil, 18)
		d.TextXAlignment = Enum.TextXAlignment.Left
		local pass = row.pass
		buttons[row.key] = Kit.button(card, "", UDim2.fromOffset(160, 50), UDim2.new(1, -10, 0.5, 0), Kit.C.green, function()
			if pass and not Net.hasPass(pass) then
				local id = Config.Passes[pass] or 0
				if id ~= 0 then
					MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, id)
				else
					Toast.show(Lang.t("toast.pass_not_on_sale"), "info")
				end
				return
			end
			local ok, msg = Net.request("SetSetting", { key = row.key, value = not isOn(row) })
			if not ok and msg then
				Toast.show(msg, "error")
			end
		end, Vector2.new(1, 0.5), 26)
		buttons[row.key].Name = "Toggle_" .. row.key
	end

	-- language picker: 4 x 3 grid of flag + native name (saved in the profile, applied live)
	local langTitle = Kit.text(content, "@settings.language", UDim2.new(1, 0, 0, 22), UDim2.fromOffset(0, LANG_TOP - 1), Kit.C.ink, nil, 22)
	langTitle.TextXAlignment = Enum.TextXAlignment.Left
	local langButtons: { [string]: TextButton } = {}
	for i, code in Locale.LANGS do
		local col, row = (i - 1) % 4, (i - 1) // 4
		local info = Locale.NATIVE[code]
		local b = Kit.button(content, info.flag .. " " .. info.name, UDim2.new(0.25, -6, 0, LANG_H), UDim2.new(col * 0.25, col * 2, 0, LANG_TOP + 22 + row * LANG_PITCH), Kit.C.blue, function()
			local ok, msg = Net.request("SetLanguage", { lang = code })
			if ok then
				Toast.show(Lang.t("toast.language", { name = info.name }), "success")
			elseif msg then
				Toast.show(msg, "error")
			end
		end, nil, 20)
		b.Name = "Lang_" .. code
		langButtons[code] = b
	end

	local function refresh()
		for code, b in langButtons do
			b.BackgroundColor3 = if code == Lang.code then Kit.C.green else Kit.C.blue
		end
		for _, row in ROWS do
			local b = buttons[row.key]
			if row.pass and not Net.hasPass(row.pass) then
				Kit.setText(b, "settings.get_pass")
				b.BackgroundColor3 = Kit.C.yellow
			elseif isOn(row) then
				Kit.setText(b, "settings.on")
				b.BackgroundColor3 = Kit.C.green
			else
				Kit.setText(b, "settings.off")
				b.BackgroundColor3 = Kit.C.red
			end
		end
	end
	Kit.onOpen("settings", refresh)
	Net.changed:Connect(refresh)
	Lang.changed:Connect(refresh)
end

return SettingsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Coins shop: trails and effects. Buying/equipping is validated by the server.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(script.Parent.Parent.Net)
local Kit = require(script.Parent.Kit)
local Toast = require(script.Parent.Toast)
local Lang = require(script.Parent.Parent.Lang)

local ShopPanel = {}

local function colorSeq(colors: { Color3 }): ColorSequence
	if #colors == 1 then
		return ColorSequence.new(colors[1])
	end
	local kps = {}
	for i, c in colors do
		table.insert(kps, ColorSequenceKeypoint.new((i - 1) / (#colors - 1), c))
	end
	return ColorSequence.new(kps)
end

type Txt = { key: string, args: { [string]: any }? }
local function T(key: string, args: { [string]: any }?): Txt
	return { key = key, args = args }
end

local function card(grid: Instance, order: number, name: Txt, colors: { Color3 }, buttonText: Txt, buttonColor: Color3, onClick: () -> ())
	local c = Kit.card(grid, order)
	local swatch = Kit.frame(c, UDim2.new(1, -20, 0, 70), UDim2.fromOffset(10, 10), Color3.new(1, 1, 1))
	Kit.corner(swatch, 12)
	local g = Instance.new("UIGradient")
	g.Color = colorSeq(colors)
	g.Parent = swatch
	local label = Kit.text(c, "", UDim2.new(1, -16, 0, 30), UDim2.fromOffset(8, 84), Kit.C.ink, nil, 26)
	Kit.setText(label, name.key, name.args)
	local btn = Kit.button(c, "", UDim2.new(1, -20, 0, 54), UDim2.new(0, 10, 1, -62), buttonColor, onClick, nil, 24)
	Kit.setText(btn, buttonText.key, buttonText.args)
end

local function act(action: string, id: string)
	local ok, msg = Net.request(action, { id = id })
	if msg then
		Toast.show(msg, if ok then "success" else "error")
	end
end

function ShopPanel.init()
	local content = Kit.panel("shop", "@panel.shop", Kit.C.pink)
	local tab = "trails"
	local grid = Kit.grid(content, Vector2.new(180, 200), UDim2.new(1, 0, 1, -64), UDim2.fromOffset(0, 64))
	local tabs: { [string]: TextButton } = {}

	local function rebuild()
		for _, c in grid:GetChildren() do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		local s = Net.state
		local owned = (s.trails or {}) :: { [string]: boolean }
		local ownedFx = (s.effects or {}) :: { [string]: boolean }
		for name, b in tabs do
			b.BackgroundColor3 = if name == tab then Kit.C.pink else Kit.C.grey
		end
		if tab == "trails" then
			local order = 0
			if (s.wins or 0) > 0 then
				local w = s.wins :: number
				local col = Config.RebirthColors[((w - 1) % #Config.RebirthColors) + 1]
				local equipped = s.equippedTrail == "rebirth"
				card(grid, order, T("shop.rebirth", { n = w }), { col, col:Lerp(Color3.new(1, 1, 1), 0.5) }, T(if equipped then "shop.unequip" else "shop.equip"), if equipped then Kit.C.grey else Kit.C.blue, function()
					act("EquipTrail", "rebirth")
				end)
			end
			for i, t in Config.Trails do
				order = i
				local equipped = s.equippedTrail == t.id
				if t.pass then
					local has = Net.hasPass(t.pass)
					card(grid, order, T("trail." .. t.id), t.colors, T(if not has then "shop.vip_only" elseif equipped then "shop.unequip" else "shop.equip"), if has then (if equipped then Kit.C.grey else Kit.C.blue) else Kit.C.yellow, function()
						if has then
							act("EquipTrail", t.id)
						else
							Kit.open("store")
						end
					end)
				elseif t.exclusive and not owned[t.id] then
					-- Starter Pack / group exclusives are never sold for coins
					local starter = t.exclusive == "StarterPack"
					card(grid, order, T("trail." .. t.id), t.colors, T(if starter then "shop.starter_only" else "shop.group_only"), Kit.C.grey, function()
						local st = Net.state.starter
						if starter and type(st) == "table" and st.available then
							Kit.open("starter")
						end
					end)
				elseif owned[t.id] then
					card(grid, order, T("trail." .. t.id), t.colors, T(if equipped then "shop.unequip" else "shop.equip"), if equipped then Kit.C.grey else Kit.C.blue, function()
						act("EquipTrail", t.id)
					end)
				else
					card(grid, order, T("trail." .. t.id), t.colors, T("shop.price", { price = Kit.formatNumber(t.price) }), Kit.C.green, function()
						act("BuyTrail", t.id)
					end)
				end
			end
		else
			for i, e in Config.Effects do
				local equipped = s.equippedEffect == e.id
				local colors = { e.color, e.color:Lerp(Color3.new(1, 1, 1), 0.6) }
				if ownedFx[e.id] then
					card(grid, i, T("effect." .. e.id), colors, T(if equipped then "shop.unequip" else "shop.equip"), if equipped then Kit.C.grey else Kit.C.blue, function()
						act("EquipEffect", e.id)
					end)
				else
					card(grid, i, T("effect." .. e.id), colors, T("shop.price", { price = Kit.formatNumber(e.price) }), Kit.C.green, function()
						act("BuyEffect", e.id)
					end)
				end
			end
		end
	end

	tabs.trails = Kit.button(content, "@shop.trails", UDim2.fromOffset(160, 54), UDim2.fromOffset(0, 0), Kit.C.pink, function()
		tab = "trails"
		rebuild()
	end)
	tabs.effects = Kit.button(content, "@shop.effects", UDim2.fromOffset(160, 54), UDim2.fromOffset(172, 0), Kit.C.grey, function()
		tab = "effects"
		rebuild()
	end)
	local coins = Kit.text(content, "", UDim2.fromOffset(250, 40), UDim2.new(1, 0, 0, 3), Kit.C.ink, Vector2.new(1, 0), 30)
	coins.TextXAlignment = Enum.TextXAlignment.Right

	Kit.onOpen("shop", rebuild)
	Lang.changed:Connect(function()
		if Kit.current() == "shop" then
			rebuild()
		end
	end)
	Net.changed:Connect(function()
		Kit.setText(coins, "shop.price", { price = Kit.formatNumber(Net.state.coins or 0) })
		if Kit.current() == "shop" then
			rebuild()
		end
	end)
end

return ShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">StarterPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Starter Pack (P0-4): one-time popup when a first-day player reaches stage 3, and a panel behind
-- the pulsing menu button while the pack is on sale (product id set, not bought, first 24 h).
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(script.Parent.Parent.Net)
local Kit = require(script.Parent.Kit)
local Hud = require(script.Parent.Hud)

local StarterPanel = {}

local popupShown = false

local function available(): boolean
	local st = Net.state.starter
	return type(st) == "table" and st.available == true
end

function StarterPanel.init()
	local content = Kit.panel("starter", "@starter.title", Kit.C.red)
	local badge = Kit.frame(content, UDim2.fromOffset(150, 150), UDim2.fromOffset(10, 10), Kit.C.yellow)
	Kit.corner(badge, 75)
	Kit.stroke(badge, Kit.darker(Kit.C.yellow, 0.45), 4)
	badge.Rotation = -8
	Kit.bold(badge, "@starter.discount", UDim2.fromScale(0.9, 0.5), UDim2.fromScale(0.05, 0.25), Kit.C.white, nil, 56)
	local was = Kit.text(content, "", UDim2.new(1, -190, 0, 36), UDim2.fromOffset(180, 16), Color3.fromRGB(150, 140, 170), nil, 30)
	was.TextXAlignment = Enum.TextXAlignment.Left
	local items = Kit.text(content, "", UDim2.new(1, -190, 0, 96), UDim2.fromOffset(180, 58), Kit.C.ink, nil, 28)
	items.TextXAlignment = Enum.TextXAlignment.Left
	items.TextWrapped = true
	local ends = Kit.text(content, "", UDim2.new(1, 0, 0, 34), UDim2.fromOffset(0, 190), Kit.C.red, nil, 28)
	local buy = Kit.button(content, "", UDim2.fromOffset(340, 76), UDim2.new(0.5, 0, 1, -86), Kit.C.green, function()
		if Config.Products.StarterPack ~= 0 then
			MarketplaceService:PromptProductPurchase(Players.LocalPlayer, Config.Products.StarterPack)
		end
	end, Vector2.new(0.5, 0), 34)
	buy.Name = "Buy"

	local function refresh()
		Kit.setText(was, "starter.was", { price = Config.StarterPackAnchorPrice })
		Kit.setText(items, "starter.items", { n = Config.StarterPackSkips, minutes = Config.StarterBoostSeconds // 60 })
		local price = Hud.priceOf(Config.Products.StarterPack)
		if price then
			Kit.setText(buy, "starter.buy", { price = price })
		else
			Kit.setText(buy, "starter.buy_noprice")
		end
		local st = Net.state.starter
		local left = if type(st) == "table" then (tonumber(st.endsAt) or 0) - os.time() else 0
		Kit.setText(ends, "starter.ends", { time = Kit.formatTime(left) })
	end
	Kit.onOpen("starter", refresh)
	Hud.fetchPrice(Config.Products.StarterPack, function()
		refresh()
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if Kit.current() == "starter" then
				if not available() then
					Kit.close()
				else
					refresh()
				end
			end
		end
	end)
	-- one-time popup at stage 3 during the first day
	Net.changed:Connect(function(new)
		if popupShown or not available() then
			return
		end
		local st = new.starter
		if (new.stage or 0) >= 3 and type(st) == "table" and st.firstSession and Kit.current() == nil then
			popupShown = true
			Kit.open("starter")
		end
	end)
end

return StarterPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">StorePanel</string>
              <string name="Source"><![CDATA[--!strict
-- Robux store: developer products and game passes. IDs of 0 are hidden.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(script.Parent.Parent.Net)
local Kit = require(script.Parent.Kit)

local StorePanel = {}

type Item = { key: string, name: string, desc: string, icon: string, color: Color3, isPass: boolean }

local ITEMS: { Item } = {
	{ key = "SkipStage", name = "Skip Stage", desc = "Jump to the next checkpoint", icon = "⏭", color = Kit.C.green, isPass = false },
	{ key = "Skip10", name = "Skip 10 Stages", desc = "Leap 10 checkpoints ahead", icon = "🚀", color = Kit.C.blue, isPass = false },
	{ key = "VIP", name = "VIP", desc = "[VIP] tag, gold trail, +50% coins, 2x daily", icon = "👑", color = Kit.C.yellow, isPass = true },
	{ key = "SpeedCoil", name = "Speed Coil", desc = "Run 50% faster (toggle)", icon = "⚡", color = Kit.C.orange, isPass = true },
	{ key = "GravityCoil", name = "Gravity Coil", desc = "Floaty low-gravity jumps (toggle)", icon = "🪐", color = Kit.C.purple, isPass = true },
	{ key = "DoubleCoins", name = "2x Coins", desc = "Double coins forever", icon = "💰", color = Kit.C.yellow, isPass = true },
	{ key = "Coins500", name = "500 Coins", desc = "Coin pack", icon = "💰", color = Kit.C.pink, isPass = false },
	{ key = "Coins2500", name = "2,500 Coins", desc = "Big coin pack", icon = "💰", color = Kit.C.pink, isPass = false },
}

local prices: { [number]: number } = {}

local function idOf(item: Item): number
	if item.isPass then
		return Config.Passes[item.key] or 0
	end
	return Config.Products[item.key] or 0
end

function StorePanel.init()
	local content = Kit.panel("store", "@panel.store", Kit.C.green)
	local grid = Kit.grid(content, Vector2.new(280, 132))
	local empty = Kit.text(content, "@store.empty", UDim2.fromScale(1, 0.4), UDim2.fromScale(0, 0.3), Kit.C.ink, nil, 28)

	local function rebuild()
		for _, c in grid:GetChildren() do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		local count = 0
		for i, item in ITEMS do
			local id = idOf(item)
			if id ~= 0 then
				count += 1
				local c = Kit.card(grid, i)
				local iconBg = Kit.frame(c, UDim2.fromOffset(80, 80), UDim2.fromOffset(12, 20), item.color)
				Kit.corner(iconBg, 18)
				Kit.text(iconBg, item.icon, UDim2.fromScale(0.8, 0.8), UDim2.fromScale(0.1, 0.1), Kit.C.white, nil, 50)
				local title = Kit.text(c, "@store." .. item.key .. ".name", UDim2.fromOffset(170, 30), UDim2.fromOffset(102, 10), Kit.C.ink, nil, 26)
				title.TextXAlignment = Enum.TextXAlignment.Left
				local desc = Kit.text(c, "@store." .. item.key .. ".desc", UDim2.fromOffset(170, 30), UDim2.fromOffset(102, 40), Color3.fromRGB(110, 105, 140), nil, 16)
				desc.TextXAlignment = Enum.TextXAlignment.Left
				local owned = item.isPass and Net.hasPass(item.key)
				local btn = Kit.button(c, "", UDim2.fromOffset(166, 52), UDim2.fromOffset(102, 72), if owned then Kit.C.grey else Kit.C.green, function()
					if owned then
						return
					end
					if item.isPass then
						MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, id)
					else
						MarketplaceService:PromptProductPurchase(Players.LocalPlayer, id)
					end
				end, nil, 22)
				if owned then
					Kit.setText(btn, "store.owned")
				elseif prices[id] then
					Kit.setText(btn, "hud.price", { price = prices[id] })
				else
					Kit.setText(btn, "store.buy")
				end
				if not prices[id] and not owned then
					task.spawn(function()
						local ok, info = pcall(function()
							return MarketplaceService:GetProductInfo(id, if item.isPass then Enum.InfoType.GamePass else Enum.InfoType.Product)
						end)
						if ok and info and info.PriceInRobux then
							prices[id] = info.PriceInRobux
							Kit.setText(btn, "hud.price", { price = info.PriceInRobux })
						end
					end)
				end
			end
		end
		empty.Visible = count == 0
	end

	Kit.onOpen("store", rebuild)
	Net.changed:Connect(function()
		if Kit.current() == "store" then
			rebuild()
		end
	end)
end

return StorePanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">Toast</string>
              <string name="Source"><![CDATA[--!strict
-- Stacked toast notifications at the top of the screen.
local TweenService = game:GetService("TweenService")

local Kit = require(script.Parent.Kit)

local Toast = {}

local region: Frame? = nil
local COLORS: { [string]: Color3 } = {
	info = Kit.C.blue,
	success = Kit.C.green,
	warn = Kit.C.orange,
	error = Kit.C.red,
	coins = Kit.C.yellow,
}

local function getRegion(): Frame
	if region then
		return region
	end
	local r = Kit.region("Toasts", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 100), Vector2.new(520, 220))
	r.ZIndex = 20
	Kit.onLayout(function()
		r.Position = UDim2.new(0.5, 0, 0, Kit.hudTop + 6) -- under the progress bar + stats row
	end)
	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.Padding = UDim.new(0, 8)
	list.Parent = r
	region = r
	return r
end

local order = 0
function Toast.show(text: string, kind: string?)
	local r = getRegion()
	order += 1
	local color = COLORS[kind or "info"] or Kit.C.blue
	local f = Kit.frame(r, UDim2.fromOffset(460, 50), UDim2.new(), color)
	f.LayoutOrder = order
	Kit.corner(f, 25)
	Kit.stroke(f, Kit.darker(color, 0.45), 3)
	Kit.gradient(f, Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 210))
	local label = Kit.bold(f, text, UDim2.new(1, -24, 1, -10), UDim2.fromOffset(12, 5), Kit.C.white, nil, 26)
	Kit.pop(f, 0.5)
	task.delay(3, function()
		local ti = TweenInfo.new(0.35)
		TweenService:Create(f, ti, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(label, ti, { TextTransparency = 1 }):Play()
		local st = f:FindFirstChildOfClass("UIStroke")
		if st then
			TweenService:Create(st, ti, { Transparency = 1 }):Play()
		end
		local ls = label:FindFirstChildOfClass("UIStroke")
		if ls then
			TweenService:Create(ls, ti, { Transparency = 1 }):Play()
		end
		task.wait(0.4)
		f:Destroy()
	end)
	-- keep at most 4
	local kids = {}
	for _, c in r:GetChildren() do
		if c:IsA("Frame") then
			table.insert(kids, c)
		end
	end
	if #kids > 4 then
		table.sort(kids, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		kids[1]:Destroy()
	end
end

return Toast
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">WinPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Shown when you reach stage 100 (or use the pedestal in the victory room): rebirth or stay.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(script.Parent.Parent.Net)
local Kit = require(script.Parent.Kit)
local Toast = require(script.Parent.Toast)

local WinPanel = {}

function WinPanel.init()
	local content = Kit.panel("win", "@panel.win", Kit.C.yellow)
	local title = Kit.bold(content, "", UDim2.new(1, 0, 0, 70), UDim2.fromOffset(0, 10), Kit.C.yellow, nil, 60)
	local info = Kit.text(content, "", UDim2.new(1, -40, 0, 90), UDim2.fromOffset(20, 90), Kit.C.ink, nil, 26)
	info.TextWrapped = true
	local swatch = Kit.frame(content, UDim2.fromOffset(260, 26), UDim2.new(0.5, 0, 0, 190), Kit.C.pink, Vector2.new(0.5, 0))
	Kit.corner(swatch, 13)
	Kit.button(content, "@win.rebirth", UDim2.fromOffset(330, 70), UDim2.new(0.5, -175, 1, -80), Kit.C.green, function()
		local ok, msg = Net.request("Rebirth")
		if ok then
			Kit.close()
		elseif msg then
			Toast.show(msg, "error")
		end
	end, Vector2.new(0.5, 0), 30)
	Kit.button(content, "@win.stay", UDim2.fromOffset(200, 70), UDim2.new(0.5, 110, 1, -80), Kit.C.grey, function()
		Kit.close()
	end, Vector2.new(0.5, 0), 28)

	Kit.onOpen("win", function()
		local wins = Net.state.wins or 0
		local nextColor = Config.RebirthColors[((math.max(wins, 1) - 1) % #Config.RebirthColors) + 1]
		Kit.setText(title, "win.wins", { n = wins })
		Kit.setText(info, "win.info")
		swatch.BackgroundColor3 = nextColor
	end)
end

return WinPanel
]]></string>
            </Properties>
