          <string name="Name">Ambience</string>
          <string name="Source"><![CDATA[--!strict
-- Look of the sky at every height of the tower. PURE Luau (no Roblox types: colours are {r, g, b}
-- in 0..255) so tests/visual_test.luau can check it with the standalone luau.exe.
--
-- Each world (10 stages) has one lighting profile. The client samples its camera height every
-- frame and blends the two neighbouring profiles around each world boundary, so climbing takes you
-- from a sunny meadow through a golden desert, a red-lit cave and a starry night to a sunrise.

local Ambience = {}

export type RGB = { number }
export type Profile = {
	clock: number, -- Lighting.ClockTime (0..24)
	brightness: number,
	exposure: number, -- Lighting.ExposureCompensation
	ambient: RGB,
	outdoor: RGB, -- Lighting.OutdoorAmbient
	density: number, -- Atmosphere
	haze: number,
	glare: number,
	atmColor: RGB,
	atmDecay: RGB,
	tint: RGB, -- ColorCorrection.TintColor
	saturation: number,
	contrast: number,
	bloom: number, -- Bloom.Intensity
	bloomSize: number,
	bloomThreshold: number,
	rays: number, -- SunRays.Intensity
	stars: number, -- Sky.StarCount
}

-- One profile per world, in tower order (same order as Config.Themes).
Ambience.Profiles = {
	-- 1 Grassy Hills: clear early afternoon
	{ clock = 14.5, brightness = 2.6, exposure = 0, ambient = { 150, 155, 168 }, outdoor = { 175, 182, 195 }, density = 0.27, haze = 0.8, glare = 0.2, atmColor = { 200, 228, 255 }, atmDecay = { 150, 195, 255 }, tint = { 255, 255, 255 }, saturation = 0.18, contrast = 0.06, bloom = 0.3, bloomSize = 24, bloomThreshold = 1.7, rays = 0.06, stars = 0 },
	-- 2 Candy Land: warm pink late afternoon
	{ clock = 16.4, brightness = 2.7, exposure = 0.05, ambient = { 150, 120, 145 }, outdoor = { 190, 150, 180 }, density = 0.3, haze = 1.0, glare = 0.35, atmColor = { 255, 214, 236 }, atmDecay = { 255, 170, 215 }, tint = { 255, 240, 250 }, saturation = 0.3, contrast = 0.04, bloom = 0.35, bloomSize = 28, bloomThreshold = 1.6, rays = 0.09, stars = 0 },
	-- 3 Frozen Peaks: cold, misty morning
	{ clock = 9.6, brightness = 2.3, exposure = 0.1, ambient = { 125, 145, 175 }, outdoor = { 160, 185, 215 }, density = 0.33, haze = 1.5, glare = 0.1, atmColor = { 215, 236, 255 }, atmDecay = { 170, 205, 245 }, tint = { 232, 243, 255 }, saturation = -0.08, contrast = 0.08, bloom = 0.35, bloomSize = 30, bloomThreshold = 1.5, rays = 0.04, stars = 0 },
	-- 4 Desert Ruins: golden hour
	{ clock = 17.35, brightness = 2.7, exposure = 0, ambient = { 150, 120, 85 }, outdoor = { 200, 160, 110 }, density = 0.3, haze = 1.3, glare = 0.7, atmColor = { 255, 214, 150 }, atmDecay = { 255, 160, 80 }, tint = { 255, 240, 214 }, saturation = 0.2, contrast = 0.1, bloom = 0.35, bloomSize = 26, bloomThreshold = 1.6, rays = 0.16, stars = 0 },
	-- 5 Lava Caves: dark red dusk, glowing embers
	{ clock = 17.7, brightness = 2.2, exposure = 0.1, ambient = { 165, 105, 95 }, outdoor = { 185, 115, 95 }, density = 0.38, haze = 1.9, glare = 0.4, atmColor = { 215, 110, 75 }, atmDecay = { 150, 50, 35 }, tint = { 255, 222, 205 }, saturation = 0.12, contrast = 0.2, bloom = 0.5, bloomSize = 28, bloomThreshold = 1.3, rays = 0.05, stars = 400 },
	-- 6 Ocean Reef: teal, thick "underwater" haze
	{ clock = 12.2, brightness = 2.2, exposure = 0.05, ambient = { 70, 140, 160 }, outdoor = { 90, 175, 195 }, density = 0.38, haze = 1.4, glare = 0.15, atmColor = { 110, 215, 225 }, atmDecay = { 30, 130, 190 }, tint = { 214, 248, 255 }, saturation = 0.24, contrast = 0.05, bloom = 0.4, bloomSize = 30, bloomThreshold = 1.5, rays = 0.12, stars = 0 },
	-- 7 Toxic Factory: sickly green smog at dusk
	{ clock = 17.6, brightness = 2.1, exposure = 0, ambient = { 130, 150, 105 }, outdoor = { 150, 175, 115 }, density = 0.34, haze = 1.7, glare = 0.3, atmColor = { 185, 215, 140 }, atmDecay = { 110, 145, 60 }, tint = { 236, 255, 214 }, saturation = 0.05, contrast = 0.14, bloom = 0.45, bloomSize = 30, bloomThreshold = 1.4, rays = 0.05, stars = 200 },
	-- 8 Cloud Kingdom: bright white morning above the clouds
	{ clock = 8.4, brightness = 2.6, exposure = 0, ambient = { 170, 175, 200 }, outdoor = { 215, 220, 240 }, density = 0.24, haze = 0.8, glare = 0.4, atmColor = { 240, 244, 255 }, atmDecay = { 205, 220, 255 }, tint = { 255, 252, 244 }, saturation = 0.1, contrast = 0.02, bloom = 0.4, bloomSize = 28, bloomThreshold = 1.7, rays = 0.2, stars = 0 },
	-- 9 Neon Space: midnight, stars, neon bloom
	{ clock = 0.2, brightness = 1.4, exposure = 0.1, ambient = { 75, 60, 130 }, outdoor = { 90, 75, 150 }, density = 0.16, haze = 0.4, glare = 0, atmColor = { 40, 28, 90 }, atmDecay = { 16, 10, 48 }, tint = { 236, 228, 255 }, saturation = 0.34, contrast = 0.18, bloom = 0.5, bloomSize = 26, bloomThreshold = 1.35, rays = 0, stars = 5000 },
	-- 10 Rainbow Summit: sunrise gold and pink
	{ clock = 6.35, brightness = 2.5, exposure = 0, ambient = { 160, 135, 150 }, outdoor = { 215, 180, 170 }, density = 0.25, haze = 1.0, glare = 0.6, atmColor = { 255, 226, 190 }, atmDecay = { 255, 150, 170 }, tint = { 255, 246, 236 }, saturation = 0.34, contrast = 0.08, bloom = 0.4, bloomSize = 28, bloomThreshold = 1.6, rays = 0.22, stars = 800 },
} :: { Profile }

-- The blend starts BELOW the boundary pad (you see the next world coming) and ends a little above it.
Ambience.BLEND_BELOW = 22
Ambience.BLEND_ABOVE = 8

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function lerpRGB(a: RGB, b: RGB, t: number): RGB
	return { lerp(a[1], b[1], t), lerp(a[2], b[2], t), lerp(a[3], b[3], t) }
end

-- Shortest way round the 24 h clock (23 -> 1 goes through midnight, not back through noon).
function Ambience.lerpClock(a: number, b: number, t: number): number
	local d = (b - a) % 24
	if d > 12 then
		d -= 24
	end
	return (a + d * t) % 24
end

-- Heights of the world boundaries (top of pads 10, 20 ... 90) from the pad heights of a map.
function Ambience.bounds(padY: { [number]: number }): { number }
	local out = {}
	local worlds = #Ambience.Profiles
	for w = 1, worlds - 1 do
		local y = padY[w * 10]
		if y == nil then
			break
		end
		table.insert(out, y)
	end
	return out
end

-- Which two worlds the height `y` is between, and how far (0 = all `a`, 1 = all `b`).
function Ambience.blend(y: number, bounds: { number }): (number, number, number)
	local world = 1
	for i, by in bounds do
		if y >= by - Ambience.BLEND_BELOW then
			world = i + 1
		end
	end
	if world == 1 then
		return 1, 1, 0
	end
	local by = bounds[world - 1]
	local t = (y - (by - Ambience.BLEND_BELOW)) / (Ambience.BLEND_BELOW + Ambience.BLEND_ABOVE)
	if t >= 1 then
		return world, world, 0
	end
	t = math.clamp(t, 0, 1)
	return world - 1, world, t * t * (3 - 2 * t) -- smoothstep
end

function Ambience.mix(a: Profile, b: Profile, t: number): Profile
	if t <= 0 then
		return a
	elseif t >= 1 then
		return b
	end
	return {
		clock = Ambience.lerpClock(a.clock, b.clock, t),
		brightness = lerp(a.brightness, b.brightness, t),
		exposure = lerp(a.exposure, b.exposure, t),
		ambient = lerpRGB(a.ambient, b.ambient, t),
		outdoor = lerpRGB(a.outdoor, b.outdoor, t),
		density = lerp(a.density, b.density, t),
		haze = lerp(a.haze, b.haze, t),
		glare = lerp(a.glare, b.glare, t),
		atmColor = lerpRGB(a.atmColor, b.atmColor, t),
		atmDecay = lerpRGB(a.atmDecay, b.atmDecay, t),
		tint = lerpRGB(a.tint, b.tint, t),
		saturation = lerp(a.saturation, b.saturation, t),
		contrast = lerp(a.contrast, b.contrast, t),
		bloom = lerp(a.bloom, b.bloom, t),
		bloomSize = lerp(a.bloomSize, b.bloomSize, t),
		bloomThreshold = lerp(a.bloomThreshold, b.bloomThreshold, t),
		rays = lerp(a.rays, b.rays, t),
		stars = lerp(a.stars, b.stars, t),
	}
end

-- The profile to show at height `y`.
function Ambience.sample(y: number, bounds: { number }): Profile
	local a, b, t = Ambience.blend(y, bounds)
	return Ambience.mix(Ambience.Profiles[a], Ambience.Profiles[b], t)
end

-- The world (1..10) whose look dominates at height `y`.
function Ambience.worldAt(y: number, bounds: { number }): number
	local a, b, t = Ambience.blend(y, bounds)
	return if t >= 0.5 then b else a
end

return Ambience
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Sky Tower Obby: every tunable number and every Creator Dashboard ID lives here.
-- Any ID left at 0 hides that item (button/stall/badge is simply skipped).

local Config = {}

Config.GameName = "Sky Tower Obby"
Config.DataStoreName = "SkyTowerObby_v1"
Config.WinsBoardStore = "SkyTowerObby_Wins_v1"
Config.FastestBoardStore = "SkyTowerObby_Fastest_v1" -- OrderedDataStore: best run in ms (ascending)
Config.ReferralStore = "SkyTowerObby_Referrals_v1" -- DataStore: inviter id -> pending invitee rewards
Config.MapSeed = 777 -- same seed => identical tower on every server
Config.AutosaveInterval = 90

-- Monetization ---------------------------------------------------------------------------
Config.Products = {
	SkipStage = 0, -- Developer Product: skip 1 stage (top earner in obbies)
	Skip10 = 0, -- Developer Product: skip 10 stages
	Coins500 = 0, -- Developer Product: 500 coins
	Coins2500 = 0, -- Developer Product: 2,500 coins
	AdSkip = 0, -- Developer Product used only as the reward holder of the rewarded-video ad skip
	StarterPack = 0, -- Developer Product: first-24-hour starter pack (suggested 49 R$)
} :: { [string]: number }

Config.Passes = {
	SpeedCoil = 0, -- WalkSpeed 24 (toggle in Settings)
	GravityCoil = 0, -- lower gravity while jumping (toggle in Settings)
	VIP = 0, -- [VIP] chat tag, gold trail, +50% coins, bigger daily reward
	DoubleCoins = 0, -- x2 coins from every source
} :: { [string]: number }

Config.BadgeIds = {
	Winner = 0, -- awarded on reaching stage 100
	Stage50 = 0, -- optional: halfway there
	FirstRebirth = 0, -- optional
} :: { [string]: number }

-- In Studio only: when a product ID is 0 the Skip button still shows and skips for free,
-- so the whole loop can be tested without publishing.
Config.StudioFreeSkips = true

-- Skip offer after a death streak + rewarded-video ads (P0-1) -------------------------------
Config.SkipOfferAfterDeaths = 4 -- deaths/falls on the same stage before the "Stuck?" card (and every +4)
Config.SkipOfferCooldown = 90 -- seconds between two offers
Config.AdDailyCap = 6 -- rewarded-video ad skips per player per UTC day

-- Starter pack (P0-4) ---------------------------------------------------------------------------
Config.StarterPackWindow = 24 * 3600 -- on sale during the first 24 h after the first join
Config.StarterPackSkips = 3
Config.StarterBoostSeconds = 30 * 60 -- x2 coins boost
Config.StarterPackAnchorPrice = 169 -- crossed-out "value" shown on the offer (display only)

-- Invites / referrals (P0-3) ---------------------------------------------------------------------
Config.ReferralMaxRewards = 25 -- lifetime cap of inviter rewards
Config.ReferralInviteeGift = { coins = 50, freeSkips = 1 }
Config.ReferralInviterGift = { coins = 100, freeSkips = 1 }
Config.ReferralPayStage = 5 -- the invitee must reach this stage for the inviter to be paid

-- Group reward (P0-7). 0 = hidden. -----------------------------------------------------------------
Config.GroupId = 0
Config.GroupGift = { coins = 150, freeSkips = 1, trail = "group" }

-- Notification opt-in (P0-8) -----------------------------------------------------------------------
Config.NotifyAskCooldown = 7 * 86400

-- Live events (P0-6): wday Sunday = 1 ... Saturday = 7 (os.date("!*t")) -----------------------------
Config.LiveEvents = {
	{ id = "DoubleCoinsWeekend", kind = "weekly", fromWday = 7, toWday = 1, allDayUTC = true },
	{ id = "SkipSaleHour", kind = "daily", hourUTC = 20, duration = 3600 },
} :: { any } -- see Shared/LiveEvents.luau (EventDef)
Config.AdminUserIds = {} :: { number } -- may use the /event <id> <minutes> chat command

-- Overhead titles by wins (P0-5) ---------------------------------------------------------------------
Config.Titles = {
	{ wins = 0, name = "Climber" },
	{ wins = 1, name = "Sky Walker" },
	{ wins = 5, name = "Cloud Runner" },
	{ wins = 15, name = "Tower Legend" },
	{ wins = 50, name = "Sky God" },
}

-- Gameplay ---------------------------------------------------------------------------------
Config.MaxStageJump = 3 -- a checkpoint more than this ahead of your current one is ignored
Config.CheckpointTouchRadius = 14 -- server check: root must really be near the pad
Config.FallLimit = 28 -- studs below your checkpoint => teleported back (no death)
Config.SpeedCoilWalkSpeed = 24
Config.GravityCoilFactor = 0.55 -- effective gravity multiplier with the gravity coil on
Config.BounceHeight = 24 -- must match Layout.Physics.bounceHeight
Config.GlassRevealDistance = 16

-- Coins --------------------------------------------------------------------------------------
Config.CoinsPerStage = function(stage: number): number
	return 5 + math.floor(stage / 10) * 2
end
Config.CoinPickupValue = 3
Config.CoinsPerWin = 250
Config.VIPCoinBonus = 0.5 -- +50%

-- Rewards -------------------------------------------------------------------------------------
Config.DailyRewards = { 25, 40, 60, 80, 100, 150, 250 } -- by streak day (day 7+ repeats last)
Config.DailyFreeSkipOnDay = 7 -- streak day that also gives a free skip
Config.DailyCooldown = 20 * 3600 -- can claim again after 20 h
Config.DailyStreakWindow = 48 * 3600 -- miss this and the streak resets

export type PlaytimeReward = { minutes: number, coins: number, freeSkips: number }
Config.PlaytimeRewards = {
	{ minutes = 5, coins = 30, freeSkips = 0 },
	{ minutes = 15, coins = 75, freeSkips = 0 },
	{ minutes = 30, coins = 150, freeSkips = 1 },
	{ minutes = 60, coins = 300, freeSkips = 2 },
} :: { PlaytimeReward }

export type Code = { coins: number, freeSkips: number?, expires: number? }
Config.Codes = {
	RELEASE = { coins = 100 },
	SKYHIGH = { coins = 150, freeSkips = 1 },
	CLOUDS = { coins = 50 },
} :: { [string]: Code }

-- Cosmetics -----------------------------------------------------------------------------------
-- exclusive = only granted by something else ("StarterPack", "Group"); never sold for coins
export type Trail = { id: string, name: string, price: number, colors: { Color3 }, pass: string?, exclusive: string? }
Config.Trails = {
	{ id = "white", name = "Cloud", price = 100, colors = { Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 230, 255) } },
	{ id = "mint", name = "Mint", price = 250, colors = { Color3.fromRGB(120, 255, 200), Color3.fromRGB(40, 200, 160) } },
	{ id = "fire", name = "Fire", price = 500, colors = { Color3.fromRGB(255, 220, 60), Color3.fromRGB(255, 60, 20) } },
	{ id = "ocean", name = "Ocean", price = 800, colors = { Color3.fromRGB(90, 200, 255), Color3.fromRGB(20, 60, 220) } },
	{ id = "candy", name = "Candy", price = 1200, colors = { Color3.fromRGB(255, 120, 200), Color3.fromRGB(140, 220, 255) } },
	{ id = "toxic", name = "Toxic", price = 1800, colors = { Color3.fromRGB(180, 255, 40), Color3.fromRGB(30, 140, 30) } },
	{ id = "galaxy", name = "Galaxy", price = 3000, colors = { Color3.fromRGB(160, 80, 255), Color3.fromRGB(20, 10, 60) } },
	{
		id = "rainbow",
		name = "Rainbow",
		price = 6000,
		colors = {
			Color3.fromRGB(255, 60, 60),
			Color3.fromRGB(255, 200, 40),
			Color3.fromRGB(60, 220, 90),
			Color3.fromRGB(60, 140, 255),
			Color3.fromRGB(190, 80, 255),
		},
	},
	{ id = "gold", name = "VIP Gold", price = 0, pass = "VIP", colors = { Color3.fromRGB(255, 230, 120), Color3.fromRGB(230, 160, 20) } },
	{ id = "starter", name = "Starter Star", price = 0, exclusive = "StarterPack", colors = { Color3.fromRGB(255, 250, 150), Color3.fromRGB(255, 120, 200), Color3.fromRGB(120, 200, 255) } },
	{ id = "group", name = "Crew", price = 0, exclusive = "Group", colors = { Color3.fromRGB(120, 255, 170), Color3.fromRGB(60, 120, 255) } },
} :: { Trail }

export type Effect = { id: string, name: string, price: number, kind: string, color: Color3 }
Config.Effects = {
	{ id = "sparkles", name = "Sparkles", price = 400, kind = "Sparkles", color = Color3.fromRGB(255, 240, 120) },
	{ id = "stars", name = "Star Aura", price = 1500, kind = "Aura", color = Color3.fromRGB(140, 220, 255) },
	{ id = "smoke", name = "Smoke", price = 900, kind = "Smoke", color = Color3.fromRGB(230, 230, 240) },
	{ id = "flames", name = "Flames", price = 2500, kind = "Fire", color = Color3.fromRGB(255, 120, 30) },
} :: { Effect }

-- Rebirth trails: one colour per win, cycling.
Config.RebirthColors = {
	Color3.fromRGB(255, 90, 90),
	Color3.fromRGB(255, 170, 50),
	Color3.fromRGB(255, 240, 80),
	Color3.fromRGB(90, 230, 120),
	Color3.fromRGB(80, 200, 255),
	Color3.fromRGB(150, 110, 255),
	Color3.fromRGB(255, 110, 220),
}

-- Worlds / themes: one per 10 stages -----------------------------------------------------------
export type Theme = {
	name: string,
	platform: Color3,
	alt: Color3,
	accent: Color3,
	material: Enum.Material,
	pad: Color3,
	sky: Color3, -- fog / ambient tint used by the client while you are in this world
}

Config.Themes = {
	{ name = "Grassy Hills", platform = Color3.fromRGB(125, 220, 95), alt = Color3.fromRGB(185, 140, 90), accent = Color3.fromRGB(255, 230, 90), material = Enum.Material.Grass, pad = Color3.fromRGB(90, 220, 255), sky = Color3.fromRGB(170, 220, 255) },
	{ name = "Candy Land", platform = Color3.fromRGB(255, 150, 210), alt = Color3.fromRGB(255, 240, 250), accent = Color3.fromRGB(120, 220, 255), material = Enum.Material.SmoothPlastic, pad = Color3.fromRGB(255, 230, 90), sky = Color3.fromRGB(255, 205, 235) },
	{ name = "Frozen Peaks", platform = Color3.fromRGB(190, 235, 255), alt = Color3.fromRGB(120, 180, 230), accent = Color3.fromRGB(255, 255, 255), material = Enum.Material.Ice, pad = Color3.fromRGB(80, 255, 200), sky = Color3.fromRGB(215, 240, 255) },
	{ name = "Desert Ruins", platform = Color3.fromRGB(235, 200, 130), alt = Color3.fromRGB(190, 140, 80), accent = Color3.fromRGB(80, 200, 220), material = Enum.Material.Sandstone, pad = Color3.fromRGB(255, 120, 90), sky = Color3.fromRGB(255, 225, 170) },
	{ name = "Lava Caves", platform = Color3.fromRGB(80, 70, 80), alt = Color3.fromRGB(120, 60, 50), accent = Color3.fromRGB(255, 120, 30), material = Enum.Material.Basalt, pad = Color3.fromRGB(255, 200, 60), sky = Color3.fromRGB(255, 150, 110) },
	{ name = "Ocean Reef", platform = Color3.fromRGB(80, 190, 200), alt = Color3.fromRGB(250, 220, 170), accent = Color3.fromRGB(255, 120, 140), material = Enum.Material.Slate, pad = Color3.fromRGB(255, 240, 120), sky = Color3.fromRGB(150, 220, 240) },
	{ name = "Toxic Factory", platform = Color3.fromRGB(120, 130, 140), alt = Color3.fromRGB(170, 230, 60), accent = Color3.fromRGB(255, 220, 40), material = Enum.Material.DiamondPlate, pad = Color3.fromRGB(170, 255, 60), sky = Color3.fromRGB(200, 230, 170) },
	{ name = "Cloud Kingdom", platform = Color3.fromRGB(250, 250, 255), alt = Color3.fromRGB(200, 215, 255), accent = Color3.fromRGB(255, 210, 90), material = Enum.Material.SmoothPlastic, pad = Color3.fromRGB(120, 200, 255), sky = Color3.fromRGB(235, 240, 255) },
	{ name = "Neon Space", platform = Color3.fromRGB(40, 30, 70), alt = Color3.fromRGB(0, 255, 230), accent = Color3.fromRGB(255, 60, 220), material = Enum.Material.Neon, pad = Color3.fromRGB(255, 255, 90), sky = Color3.fromRGB(110, 90, 180) },
	{ name = "Rainbow Summit", platform = Color3.fromRGB(255, 210, 80), alt = Color3.fromRGB(255, 120, 120), accent = Color3.fromRGB(120, 160, 255), material = Enum.Material.Glass, pad = Color3.fromRGB(255, 255, 255), sky = Color3.fromRGB(255, 240, 200) },
} :: { Theme }

Config.KillColor = Color3.fromRGB(255, 30, 40)

return Config
]]></string>
