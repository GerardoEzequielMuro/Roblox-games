          <string name="Name">Ambience</string>
          <string name="Source"><![CDATA[--!strict
-- Look of the sky at every height of the tower. PURE Luau (no Roblox types: colours are {r, g, b}
-- in 0..255) so tests/visual_test.luau can check it with the standalone luau.exe.
--
-- Each world (10 stages) has one lighting profile. The client samples its camera height every
-- frame and blends the two neighbouring profiles around each world boundary, so climbing takes you
-- from a sunny meadow through a golden desert, a red-lit cave and a starry night to a sunrise.

local Ambience = {}

export type RGB = { number }
export type Profile = {
	clock: number, -- Lighting.ClockTime (0..24)
	brightness: number,
	exposure: number, -- Lighting.ExposureCompensation
	ambient: RGB,
	outdoor: RGB, -- Lighting.OutdoorAmbient
	density: number, -- Atmosphere
	haze: number,
	glare: number,
	atmColor: RGB,
	atmDecay: RGB,
	tint: RGB, -- ColorCorrection.TintColor
	saturation: number,
	contrast: number,
	bloom: number, -- Bloom.Intensity
	bloomSize: number,
	bloomThreshold: number,
	rays: number, -- SunRays.Intensity
	stars: number, -- Sky.StarCount
}

-- One profile per world, in tower order (same order as Config.Themes).
Ambience.Profiles = {
	-- 1 Grassy Hills: clear early afternoon
	{ clock = 14.5, brightness = 2.6, exposure = 0, ambient = { 150, 155, 168 }, outdoor = { 175, 182, 195 }, density = 0.27, haze = 0.8, glare = 0.2, atmColor = { 200, 228, 255 }, atmDecay = { 150, 195, 255 }, tint = { 255, 255, 255 }, saturation = 0.18, contrast = 0.06, bloom = 0.3, bloomSize = 24, bloomThreshold = 1.7, rays = 0.06, stars = 0 },
	-- 2 Candy Land: warm pink late afternoon
	{ clock = 16.4, brightness = 2.7, exposure = 0.05, ambient = { 150, 120, 145 }, outdoor = { 190, 150, 180 }, density = 0.3, haze = 1.0, glare = 0.35, atmColor = { 255, 214, 236 }, atmDecay = { 255, 170, 215 }, tint = { 255, 240, 250 }, saturation = 0.3, contrast = 0.04, bloom = 0.35, bloomSize = 28, bloomThreshold = 1.6, rays = 0.09, stars = 0 },
	-- 3 Frozen Peaks: cold, misty morning
	{ clock = 9.6, brightness = 2.3, exposure = 0.1, ambient = { 125, 145, 175 }, outdoor = { 160, 185, 215 }, density = 0.33, haze = 1.5, glare = 0.1, atmColor = { 215, 236, 255 }, atmDecay = { 170, 205, 245 }, tint = { 232, 243, 255 }, saturation = -0.08, contrast = 0.08, bloom = 0.35, bloomSize = 30, bloomThreshold = 1.5, rays = 0.04, stars = 0 },
	-- 4 Desert Ruins: golden hour
	{ clock = 17.35, brightness = 2.7, exposure = 0, ambient = { 150, 120, 85 }, outdoor = { 200, 160, 110 }, density = 0.3, haze = 1.3, glare = 0.7, atmColor = { 255, 214, 150 }, atmDecay = { 255, 160, 80 }, tint = { 255, 240, 214 }, saturation = 0.2, contrast = 0.1, bloom = 0.35, bloomSize = 26, bloomThreshold = 1.6, rays = 0.16, stars = 0 },
	-- 5 Lava Caves: dark red dusk, glowing embers
	{ clock = 17.7, brightness = 2.2, exposure = 0.1, ambient = { 165, 105, 95 }, outdoor = { 185, 115, 95 }, density = 0.38, haze = 1.9, glare = 0.4, atmColor = { 215, 110, 75 }, atmDecay = { 150, 50, 35 }, tint = { 255, 222, 205 }, saturation = 0.12, contrast = 0.2, bloom = 0.5, bloomSize = 28, bloomThreshold = 1.3, rays = 0.05, stars = 400 },
	-- 6 Ocean Reef: teal, thick "underwater" haze
	{ clock = 12.2, brightness = 2.2, exposure = 0.05, ambient = { 70, 140, 160 }, outdoor = { 90, 175, 195 }, density = 0.38, haze = 1.4, glare = 0.15, atmColor = { 110, 215, 225 }, atmDecay = { 30, 130, 190 }, tint = { 214, 248, 255 }, saturation = 0.24, contrast = 0.05, bloom = 0.4, bloomSize = 30, bloomThreshold = 1.5, rays = 0.12, stars = 0 },
	-- 7 Toxic Factory: sickly green smog at dusk
	{ clock = 17.6, brightness = 2.1, exposure = 0, ambient = { 130, 150, 105 }, outdoor = { 150, 175, 115 }, density = 0.34, haze = 1.7, glare = 0.3, atmColor = { 185, 215, 140 }, atmDecay = { 110, 145, 60 }, tint = { 236, 255, 214 }, saturation = 0.05, contrast = 0.14, bloom = 0.45, bloomSize = 30, bloomThreshold = 1.4, rays = 0.05, stars = 200 },
	-- 8 Cloud Kingdom: bright white morning above the clouds
	{ clock = 8.4, brightness = 2.6, exposure = 0, ambient = { 170, 175, 200 }, outdoor = { 215, 220, 240 }, density = 0.24, haze = 0.8, glare = 0.4, atmColor = { 240, 244, 255 }, atmDecay = { 205, 220, 255 }, tint = { 255, 252, 244 }, saturation = 0.1, contrast = 0.02, bloom = 0.4, bloomSize = 28, bloomThreshold = 1.7, rays = 0.2, stars = 0 },
	-- 9 Neon Space: midnight, stars, neon bloom
	{ clock = 0.2, brightness = 1.4, exposure = 0.1, ambient = { 75, 60, 130 }, outdoor = { 90, 75, 150 }, density = 0.16, haze = 0.4, glare = 0, atmColor = { 40, 28, 90 }, atmDecay = { 16, 10, 48 }, tint = { 236, 228, 255 }, saturation = 0.34, contrast = 0.18, bloom = 0.5, bloomSize = 26, bloomThreshold = 1.35, rays = 0, stars = 5000 },
	-- 10 Rainbow Summit: sunrise gold and pink
	{ clock = 6.35, brightness = 2.5, exposure = 0, ambient = { 160, 135, 150 }, outdoor = { 215, 180, 170 }, density = 0.25, haze = 1.0, glare = 0.6, atmColor = { 255, 226, 190 }, atmDecay = { 255, 150, 170 }, tint = { 255, 246, 236 }, saturation = 0.34, contrast = 0.08, bloom = 0.4, bloomSize = 28, bloomThreshold = 1.6, rays = 0.22, stars = 800 },
} :: { Profile }

-- The blend starts BELOW the boundary pad (you see the next world coming) and ends a little above it.
Ambience.BLEND_BELOW = 22
Ambience.BLEND_ABOVE = 8

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function lerpRGB(a: RGB, b: RGB, t: number): RGB
	return { lerp(a[1], b[1], t), lerp(a[2], b[2], t), lerp(a[3], b[3], t) }
end

-- Shortest way round the 24 h clock (23 -> 1 goes through midnight, not back through noon).
function Ambience.lerpClock(a: number, b: number, t: number): number
	local d = (b - a) % 24
	if d > 12 then
		d -= 24
	end
	return (a + d * t) % 24
end

-- Heights of the world boundaries (top of pads 10, 20 ... 90) from the pad heights of a map.
function Ambience.bounds(padY: { [number]: number }): { number }
	local out = {}
	local worlds = #Ambience.Profiles
	for w = 1, worlds - 1 do
		local y = padY[w * 10]
		if y == nil then
			break
		end
		table.insert(out, y)
	end
	return out
end

-- Which two worlds the height `y` is between, and how far (0 = all `a`, 1 = all `b`).
function Ambience.blend(y: number, bounds: { number }): (number, number, number)
	local world = 1
	for i, by in bounds do
		if y >= by - Ambience.BLEND_BELOW then
			world = i + 1
		end
	end
	if world == 1 then
		return 1, 1, 0
	end
	local by = bounds[world - 1]
	local t = (y - (by - Ambience.BLEND_BELOW)) / (Ambience.BLEND_BELOW + Ambience.BLEND_ABOVE)
	if t >= 1 then
		return world, world, 0
	end
	t = math.clamp(t, 0, 1)
	return world - 1, world, t * t * (3 - 2 * t) -- smoothstep
end

function Ambience.mix(a: Profile, b: Profile, t: number): Profile
	if t <= 0 then
		return a
	elseif t >= 1 then
		return b
	end
	return {
		clock = Ambience.lerpClock(a.clock, b.clock, t),
		brightness = lerp(a.brightness, b.brightness, t),
		exposure = lerp(a.exposure, b.exposure, t),
		ambient = lerpRGB(a.ambient, b.ambient, t),
		outdoor = lerpRGB(a.outdoor, b.outdoor, t),
		density = lerp(a.density, b.density, t),
		haze = lerp(a.haze, b.haze, t),
		glare = lerp(a.glare, b.glare, t),
		atmColor = lerpRGB(a.atmColor, b.atmColor, t),
		atmDecay = lerpRGB(a.atmDecay, b.atmDecay, t),
		tint = lerpRGB(a.tint, b.tint, t),
		saturation = lerp(a.saturation, b.saturation, t),
		contrast = lerp(a.contrast, b.contrast, t),
		bloom = lerp(a.bloom, b.bloom, t),
		bloomSize = lerp(a.bloomSize, b.bloomSize, t),
		bloomThreshold = lerp(a.bloomThreshold, b.bloomThreshold, t),
		rays = lerp(a.rays, b.rays, t),
		stars = lerp(a.stars, b.stars, t),
	}
end

-- The profile to show at height `y`. `profiles` = the ten profiles of the tower in climbing order
-- (default: Ambience.Profiles, i.e. tower 1).
function Ambience.sample(y: number, bounds: { number }, profiles: { Profile }?): Profile
	local list = profiles or Ambience.Profiles
	local a, b, t = Ambience.blend(y, bounds)
	return Ambience.mix(list[a], list[b], t)
end

-- A tower's mood (Shared/TowerStyle.Moods) applied on top of a world profile. A neutral mood
-- returns the profile itself. The result always stays bright enough to read the obstacles.
export type Mood = {
	clock: number,
	clockMix: number,
	bright: number,
	tint: RGB,
	haze: RGB,
	density: number,
	saturation: number,
	stars: number,
}
Ambience.MIN_BRIGHTNESS = 1.1
Ambience.MIN_AMBIENT_SUM = 210

function Ambience.grade(p: Profile, m: Mood): Profile
	if m.clockMix <= 0 and m.bright == 1 and m.density == 0 and m.saturation == 0 and m.stars == 0 and m.tint[1] + m.tint[2] + m.tint[3] == 765 then
		return p
	end
	local function mul(a: RGB, b: RGB): RGB
		return { a[1] * b[1] / 255, a[2] * b[2] / 255, a[3] * b[3] / 255 }
	end
	local light = math.max(m.bright, 0.8)
	local ambient = { p.ambient[1] * light, p.ambient[2] * light, p.ambient[3] * light }
	local sum = ambient[1] + ambient[2] + ambient[3]
	if sum < Ambience.MIN_AMBIENT_SUM then
		local k = Ambience.MIN_AMBIENT_SUM / math.max(sum, 1)
		ambient = { math.min(255, ambient[1] * k), math.min(255, ambient[2] * k), math.min(255, ambient[3] * k) }
	end
	return {
		clock = Ambience.lerpClock(p.clock, m.clock, m.clockMix),
		brightness = math.max(Ambience.MIN_BRIGHTNESS, p.brightness * m.bright),
		exposure = p.exposure,
		ambient = ambient,
		outdoor = { p.outdoor[1] * light, p.outdoor[2] * light, p.outdoor[3] * light },
		density = math.clamp(p.density + m.density, 0.12, 0.5),
		haze = p.haze,
		glare = p.glare,
		atmColor = lerpRGB(p.atmColor, m.haze, 0.55),
		atmDecay = lerpRGB(p.atmDecay, m.haze, 0.45),
		tint = mul(p.tint, m.tint),
		saturation = math.clamp(p.saturation + m.saturation, -0.3, 0.5),
		contrast = p.contrast,
		bloom = p.bloom,
		bloomSize = p.bloomSize,
		bloomThreshold = p.bloomThreshold,
		rays = p.rays,
		stars = math.min(10000, p.stars + m.stars),
	}
end

-- The world (1..10) whose look dominates at height `y`.
function Ambience.worldAt(y: number, bounds: { number }): number
	local a, b, t = Ambience.blend(y, bounds)
	return if t >= 0.5 then b else a
end

return Ambience
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Sky Tower Obby: every tunable number and every Creator Dashboard ID lives here.
-- Any ID left at 0 hides that item (button/stall/badge is simply skipped).

local TowerStyle = require(script.Parent.TowerStyle)
local Rules = require(script.Parent.Rules)
local Pricing = require(script.Parent.Pricing)
local Economy = require(script.Parent.Economy)

local Config = {}

Config.GameName = "Sky Tower Obby"
Config.DataStoreName = "SkyTowerObby_v1"
Config.WinsBoardStore = "SkyTowerObby_Wins_v1"
Config.FastestBoardStore = "SkyTowerObby_Fastest_v1" -- OrderedDataStore: best run in ms (ascending)
Config.StageBoardStore = "SkyTowerObby_Stage_v1" -- OrderedDataStore: best stage of the 1,000 (descending)
Config.ReferralStore = "SkyTowerObby_Referrals_v1" -- DataStore: inviter id -> pending invitee rewards
Config.MapSeed = 777 -- same seed => identical tower on every server
Config.AutosaveInterval = 90

-- Monetization ---------------------------------------------------------------------------
Config.Products = {
	SkipStage = 0, -- Developer Product: skip 1 stage, levels 1-300 (19 R$)
	SkipStageHigh = 0, -- Developer Product: skip 1 stage, levels 301-1000 (29 R$). 0 = SkipStage is used
	Skip10 = 0, -- Developer Product: skip 10 stages (149 R$)
	DoubleJump5 = 0, -- Developer Product: double jump for 5 minutes (9 R$)
	Coins500 = 0, -- Developer Product: 500 coins (49 R$)
	Coins2500 = 0, -- Developer Product: 2,500 coins (199 R$)
	Coins7000 = 0, -- Developer Product: 7,000 coins (499 R$)
	AdSkip = 0, -- Developer Product used only as the reward holder of the rewarded-video ad skip
	StarterPack = 0, -- Developer Product: first-24-hour starter pack (59 R$)
} :: { [string]: number }

Config.Passes = {
	SpeedCoil = 0, -- WalkSpeed 24 (toggle in Settings). 99 R$
	GravityCoil = 0, -- lower gravity while jumping (toggle in Settings). 69 R$
	Fusion = 0, -- both coils in one pass (139 R$ vs 168 separately)
	DoubleJump = 0, -- one extra jump in the air, for ever (the shop sells it for 5 minutes)
	InfiniteRevives = 0, -- unlimited pocket checkpoints (179 R$)
	VIP = 0, -- [VIP] chat tag, gold trail, +50% coins, bigger daily reward (299 R$)
	DoubleCoins = 0, -- x2 coins from every source (195 R$)
} :: { [string]: number }

-- Intended Robux prices (what to type in the Creator Dashboard). Shared/Pricing is the source.
Config.Prices = Pricing

Config.BadgeIds = {
	Winner = 0, -- awarded on reaching stage 100
	Stage50 = 0, -- optional: halfway there
	FirstRebirth = 0, -- optional
} :: { [string]: number }

-- Studio test tools (the free "Skip (Studio test)" buttons, used while product IDs are 0).
-- They need BOTH RunService:IsStudio() AND a flag (Rules.studioTools): this one, or the Workspace
-- attribute "StudioTestTools" = true (test.project.json sets it). Off by default, so a normal
-- Studio playtest looks exactly like the published game; a published game never shows them.
Config.StudioFreeSkips = false
Config.StudioToolsAttribute = "StudioTestTools"
-- In Studio only: treat every pass whose ID is 0 as owned (to try coils / VIP without publishing).
-- Leave it off to play in Studio exactly as a new player would.
Config.StudioOwnsPasses = false

-- Skip offer after a death streak + rewarded-video ads (P0-1) -------------------------------
Config.SkipOfferAfterDeaths = 4 -- deaths/falls on the same stage before the "Stuck?" card (and every +4)
Config.SkipOfferCooldown = 90 -- seconds between two offers
Config.AdDailyCap = 6 -- rewarded-video ad skips per player per UTC day

-- Starter pack (P0-4) ---------------------------------------------------------------------------
Config.StarterPackWindow = 24 * 3600 -- on sale during the first 24 h after the first join
Config.StarterPackSkips = 5
Config.StarterPackCoins = 500 -- a Coins500 pack
Config.StarterBoostSeconds = 30 * 60 -- x2 coins boost
-- Crossed-out "value": what the skips + coins cost separately at list price (Shared/Pricing). The
-- trail and the boost are a free extra and are not counted, so the badge never overstates it.
Config.StarterPackAnchorPrice = Pricing.starterValue(Config.StarterPackSkips, Config.StarterPackCoins)
Config.StarterPackDiscountPct = Pricing.discountPct(Config.StarterPackAnchorPrice, Pricing.Products.StarterPack)

-- Invites / referrals (P0-3) ---------------------------------------------------------------------
Config.ReferralMaxRewards = 25 -- lifetime cap of inviter rewards
Config.ReferralInviteeGift = { coins = 50, freeSkips = 1 }
Config.ReferralInviterGift = { coins = 100, freeSkips = 1 }
Config.ReferralPayStage = 5 -- the invitee must reach this stage for the inviter to be paid

-- Group reward (P0-7). 0 = hidden. -----------------------------------------------------------------
Config.GroupId = 0
Config.GroupGift = { coins = 150, freeSkips = 1, trail = "group" }

-- Notification opt-in (P0-8) -----------------------------------------------------------------------
Config.NotifyAskCooldown = 7 * 86400

-- Live events (P0-6): wday Sunday = 1 ... Saturday = 7 (os.date("!*t")) -----------------------------
Config.LiveEvents = {
	{ id = "DoubleCoinsWeekend", kind = "weekly", fromWday = 7, toWday = 1, allDayUTC = true },
	{ id = "SkipSaleHour", kind = "daily", hourUTC = 20, duration = 3600 },
} :: { any } -- see Shared/LiveEvents.luau (EventDef)
Config.AdminUserIds = {} :: { number } -- may use the /event <id> <minutes> chat command

-- Overhead titles by wins (P0-5) ---------------------------------------------------------------------
Config.Titles = {
	{ wins = 0, name = "Climber" },
	{ wins = 1, name = "Sky Walker" },
	{ wins = 5, name = "Cloud Runner" },
	{ wins = 15, name = "Tower Legend" },
	{ wins = 50, name = "Sky God" },
}

-- Gameplay ---------------------------------------------------------------------------------
-- The classic obby character. The map is calibrated against these (Shared/Layout.Physics); the
-- server enforces them on every character and tests/layout_test.luau refuses a higher jump.
Config.JumpPower = 50 -- 6.37 studs
Config.WalkSpeed = 16
Config.MaxStageJump = 3 -- a checkpoint more than this ahead of your current one is ignored
Config.CheckpointTouchRadius = 14 -- server check: root must really be near the pad
Config.FallLimit = 28 -- studs below your checkpoint => teleported back (no death)
Config.SpeedCoilWalkSpeed = 24
Config.GravityCoilFactor = 0.55 -- effective gravity multiplier with the gravity coil on
Config.BounceHeight = 24 -- must match Layout.Physics.bounceHeight
Config.GlassRevealDistance = 16

-- Coins --------------------------------------------------------------------------------------
Config.CoinsPerStage = Rules.coinsForStage -- 5 + 2 per world reached (capped at 55)
Config.CoinsPerTower = Economy.CoinsPerTower -- bonus for every summit (stage 100, 200 ... 1000)
Config.CoinPickupValue = Economy.CoinPickupValue
Config.CoinsPerWin = Economy.CoinsPerWin
Config.VIPCoinBonus = 0.5 -- +50%

-- Rewards -------------------------------------------------------------------------------------
Config.DailyRewards = Economy.DailyRewards -- by streak day (day 7+ repeats last)
Config.DailyFreeSkipOnDay = Economy.DailyFreeSkipOnDay -- streak day that also gives a free skip
Config.DailyCooldown = Economy.DailyCooldown -- can claim again after 20 h
Config.DailyStreakWindow = Economy.DailyStreakWindow -- miss this and the streak resets

export type PlaytimeReward = Economy.PlaytimeReward
Config.PlaytimeRewards = Economy.PlaytimeRewards

export type Code = Economy.Code
Config.Codes = Economy.Codes

-- Cosmetics -----------------------------------------------------------------------------------
-- exclusive = only granted by something else ("StarterPack", "Group"); never sold for coins
-- exclusive "Gift" = tower gifts (Shared/Gifts), "Lounge" = free in the Winner's Lounge (Shared/Perks)
export type Trail = { id: string, name: string, price: number, colors: { Color3 }, pass: string?, exclusive: string? }
Config.Trails = {
	{ id = "white", name = "Cloud", price = Economy.TrailPrice.white, colors = { Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 230, 255) } },
	{ id = "mint", name = "Mint", price = Economy.TrailPrice.mint, colors = { Color3.fromRGB(120, 255, 200), Color3.fromRGB(40, 200, 160) } },
	{ id = "fire", name = "Fire", price = Economy.TrailPrice.fire, colors = { Color3.fromRGB(255, 220, 60), Color3.fromRGB(255, 60, 20) } },
	{ id = "ocean", name = "Ocean", price = Economy.TrailPrice.ocean, colors = { Color3.fromRGB(90, 200, 255), Color3.fromRGB(20, 60, 220) } },
	{ id = "candy", name = "Candy", price = Economy.TrailPrice.candy, colors = { Color3.fromRGB(255, 120, 200), Color3.fromRGB(140, 220, 255) } },
	{ id = "toxic", name = "Toxic", price = Economy.TrailPrice.toxic, colors = { Color3.fromRGB(180, 255, 40), Color3.fromRGB(30, 140, 30) } },
	{ id = "galaxy", name = "Galaxy", price = Economy.TrailPrice.galaxy, colors = { Color3.fromRGB(160, 80, 255), Color3.fromRGB(20, 10, 60) } },
	{
		id = "rainbow",
		name = "Rainbow",
		price = Economy.TrailPrice.rainbow,
		colors = {
			Color3.fromRGB(255, 60, 60),
			Color3.fromRGB(255, 200, 40),
			Color3.fromRGB(60, 220, 90),
			Color3.fromRGB(60, 140, 255),
			Color3.fromRGB(190, 80, 255),
		},
	},
	{ id = "gold", name = "VIP Gold", price = 0, pass = "VIP", colors = { Color3.fromRGB(255, 230, 120), Color3.fromRGB(230, 160, 20) } },
	{ id = "starter", name = "Starter Star", price = 0, exclusive = "StarterPack", colors = { Color3.fromRGB(255, 250, 150), Color3.fromRGB(255, 120, 200), Color3.fromRGB(120, 200, 255) } },
	{ id = "group", name = "Crew", price = 0, exclusive = "Group", colors = { Color3.fromRGB(120, 255, 170), Color3.fromRGB(60, 120, 255) } },
	{ id = "summit", name = "Summit Flame", price = 0, exclusive = "Gift", colors = { Color3.fromRGB(255, 250, 200), Color3.fromRGB(255, 160, 40), Color3.fromRGB(255, 60, 30) } },
	{ id = "comet", name = "Comet", price = 0, exclusive = "Gift", colors = { Color3.fromRGB(255, 255, 255), Color3.fromRGB(120, 220, 255), Color3.fromRGB(90, 60, 255) } },
	{ id = "lounge_neon", name = "Neon", price = 0, exclusive = "Lounge", colors = { Color3.fromRGB(0, 255, 230), Color3.fromRGB(255, 60, 220) } },
	{ id = "lounge_sunrise", name = "Sunrise", price = 0, exclusive = "Lounge", colors = { Color3.fromRGB(255, 240, 150), Color3.fromRGB(255, 140, 120), Color3.fromRGB(190, 110, 255) } },
} :: { Trail }

export type Effect = { id: string, name: string, price: number, kind: string, color: Color3, exclusive: string? }
Config.Effects = {
	{ id = "sparkles", name = "Sparkles", price = Economy.EffectPrice.sparkles, kind = "Sparkles", color = Color3.fromRGB(255, 240, 120) },
	{ id = "stars", name = "Star Aura", price = Economy.EffectPrice.stars, kind = "Aura", color = Color3.fromRGB(140, 220, 255) },
	{ id = "smoke", name = "Smoke", price = Economy.EffectPrice.smoke, kind = "Smoke", color = Color3.fromRGB(230, 230, 240) },
	{ id = "flames", name = "Flames", price = Economy.EffectPrice.flames, kind = "Fire", color = Color3.fromRGB(255, 120, 30) },
	{ id = "aurora", name = "Aurora", price = 0, kind = "Aura", color = Color3.fromRGB(120, 255, 200), exclusive = "Gift" },
	{ id = "lounge_stars", name = "Starlight", price = 0, kind = "Aura", color = Color3.fromRGB(255, 240, 160), exclusive = "Lounge" },
} :: { Effect }

-- Rebirth trails: one colour per win, cycling.
Config.RebirthColors = {
	Color3.fromRGB(255, 90, 90),
	Color3.fromRGB(255, 170, 50),
	Color3.fromRGB(255, 240, 80),
	Color3.fromRGB(90, 230, 120),
	Color3.fromRGB(80, 200, 255),
	Color3.fromRGB(150, 110, 255),
	Color3.fromRGB(255, 110, 220),
}

-- Worlds / themes: one per 10 stages -----------------------------------------------------------
export type Theme = {
	name: string,
	platform: Color3,
	alt: Color3,
	accent: Color3,
	material: Enum.Material,
	pad: Color3,
	sky: Color3, -- fog / ambient tint used by the client while you are in this world
}

local MATERIALS = {
	Enum.Material.Grass,
	Enum.Material.SmoothPlastic,
	Enum.Material.Ice,
	Enum.Material.Sandstone,
	Enum.Material.Basalt,
	Enum.Material.Slate,
	Enum.Material.DiamondPlate,
	Enum.Material.SmoothPlastic,
	Enum.Material.Neon,
	Enum.Material.Glass,
}
local WORLD_NAMES = { "Grassy Hills", "Candy Land", "Frozen Peaks", "Desert Ruins", "Lava Caves", "Ocean Reef", "Toxic Factory", "Cloud Kingdom", "Neon Space", "Rainbow Summit" }

local function c3(v: { number }): Color3
	return Color3.fromRGB(v[1], v[2], v[3])
end
Config.c3 = c3

-- The theme of world look `style` (1..10) as tower `tower` (1..10) paints it: the palettes and
-- the per-tower colour shift live in Shared/TowerStyle (pure, unit-tested).
local themeCache: { [number]: Theme } = {}
function Config.theme(tower: number, style: number): Theme
	local key = tower * 100 + style
	local cached = themeCache[key]
	if cached then
		return cached
	end
	local pal = TowerStyle.palette(tower, style)
	local theme: Theme = {
		name = WORLD_NAMES[style],
		platform = c3(pal.platform),
		alt = c3(pal.alt),
		accent = c3(pal.accent),
		material = MATERIALS[style],
		pad = c3(pal.pad),
		sky = c3(pal.sky),
	}
	themeCache[key] = theme
	return theme
end

-- Tower 1 (the original Sky Tower), by world.
Config.Themes = {} :: { Theme }
for style = 1, #TowerStyle.Worlds do
	Config.Themes[style] = Config.theme(1, style)
end

Config.KillColor = c3(TowerStyle.KILL)

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">DecorPlan</string>
          <string name="Source"><![CDATA[--!strict
-- Where the scenery goes. PURE Luau (no Roblox APIs) so tests/visual_test.luau can prove that no
-- decoration ever reaches into the playable lane. server/Scenery.luau turns each piece into parts.
--
-- Three kinds of piece per world:
--   outer : a floating set piece (island, planet, smokestack...) far outside the spiral
--   core  : an ornament stuck to the core pillar (vine, icicle, pipe, crystal...)
--   ring  : one big halo around the whole tower at the world boundary ("gate" to the next world)
local DecorPlan = {}

-- The caller passes the Layout module (shared modules don't require each other, so this file runs
-- unchanged under Roblox and under the standalone luau.exe).
export type LayoutLike = {
	STAGES: number,
	SIDES: number,
	START_ANGLE: number,
	RING_RADIUS: number,
	MAX_LAT_EXTENT: number,
	CORE_RADIUS: number,
	newRng: (seed: number) -> { next: () -> number, range: (a: number, b: number) -> number, int: (a: number, b: number) -> number },
}

export type Piece = {
	kind: string, -- outer | core | ring
	world: number, -- 1..10
	x: number,
	y: number,
	z: number,
	angle: number, -- around the tower axis (radians)
	dist: number, -- distance from the tower axis
	size: number, -- bounding radius of everything the piece may build
	variant: number, -- 1..3, picks one of the world's prop shapes
	seed: number, -- for the builder's own small random details
}

DecorPlan.OUTER_PER_WORLD = 9
DecorPlan.CORE_PER_WORLD = 12
DecorPlan.RING_RADIUS = 86
DecorPlan.RING_TUBE = 3 -- half thickness of the halo

-- The lane: every surface of a stage lies within MAX_LAT_EXTENT of the straight line between two
-- pads, and the pads sit at RING_RADIUS.
DecorPlan.CLEARANCE = 8 -- studs kept free on both sides of the lane

-- (inner, outer) distance of the lane from the tower axis: ~42.5 and ~69.5 studs.
function DecorPlan.lane(Layout: LayoutLike): (number, number)
	local apothem = Layout.RING_RADIUS * math.cos(math.pi / Layout.SIDES)
	return apothem - Layout.MAX_LAT_EXTENT, Layout.RING_RADIUS + Layout.MAX_LAT_EXTENT
end

-- Outer pieces keep clear of two built-up places:
--   * the ground under the first world (the lobby island / a tower's base island): nothing floats
--     lower than GROUND_CLEARANCE above pad 0;
--   * the summit room and the lounge beyond it, which stick out from the last pad: the top of the
--     last world is kept free on that side of the tower (SUMMIT_WEDGE radians each way).
DecorPlan.GROUND_CLEARANCE = 38
DecorPlan.SUMMIT_WEDGE = 0.8
DecorPlan.SUMMIT_DEPTH = 55

function DecorPlan.summitAngle(Layout: LayoutLike): number
	return (Layout.START_ANGLE + Layout.STAGES * 2 * math.pi / Layout.SIDES) % (2 * math.pi)
end

local function angleDistance(a: number, b: number): number
	local d = math.abs(a - b) % (2 * math.pi)
	return math.min(d, 2 * math.pi - d)
end
DecorPlan.angleDistance = angleDistance

export type Options = {
	tower: number?, -- 1..10: each tower gets its own arrangement
	outer: number?, -- outer pieces per world (default OUTER_PER_WORLD)
	core: number?, -- core ornaments per world (default CORE_PER_WORLD)
}

-- padY[k] = height of the top of checkpoint pad k (0..STAGES) of one tower. Positions are
-- relative to that tower's axis.
function DecorPlan.generate(seed: number, padY: { [number]: number }, Layout: LayoutLike, options: Options?): { Piece }
	local opts: Options = options or {}
	local rng = Layout.newRng(seed + 4242 + ((opts.tower or 1) - 1) * 977)
	local pieces: { Piece } = {}
	local worlds = Layout.STAGES // 10
	local _, laneOuter = DecorPlan.lane(Layout)
	local summit = DecorPlan.summitAngle(Layout)
	for w = 1, worlds do
		local y0 = padY[(w - 1) * 10]
		local y1 = padY[w * 10]
		local band = y1 - y0

		local nOuter = opts.outer or DecorPlan.OUTER_PER_WORLD
		local a0 = rng.range(0, math.pi * 2)
		for i = 1, nOuter do
			local size = rng.range(13, 24)
			local minDist = laneOuter + DecorPlan.CLEARANCE + size
			local dist = minDist + rng.range(6, 58)
			-- golden-angle steps: consecutive heights end up on different sides of the tower
			local angle = a0 + i * 2.399963 + rng.range(-0.25, 0.25)
			local y = y0 + band * ((i - 0.5) / nOuter) + rng.range(-5, 5)
			if w == 1 then
				local floor = y0 + DecorPlan.GROUND_CLEARANCE
				y = floor + (y1 - floor) * ((i - 0.5) / nOuter) + rng.range(0, 4)
			end
			if w == worlds and y > y1 - DecorPlan.SUMMIT_DEPTH and angleDistance(angle, summit) < DecorPlan.SUMMIT_WEDGE then
				angle += math.pi -- the other side of the tower
			end
			table.insert(pieces, {
				kind = "outer",
				world = w,
				x = math.cos(angle) * dist,
				y = y,
				z = math.sin(angle) * dist,
				angle = angle,
				dist = dist,
				size = size,
				variant = rng.int(1, 3),
				seed = rng.int(1, 1000000),
			})
		end

		local nCore = opts.core or DecorPlan.CORE_PER_WORLD
		local c0 = rng.range(0, math.pi * 2)
		for i = 1, nCore do
			local size = rng.range(4, 7.5)
			local angle = c0 + i * 2.399963 + rng.range(-0.3, 0.3)
			local y = y0 + band * ((i - 0.5) / nCore) + rng.range(-3, 3)
			local dist = Layout.CORE_RADIUS
			table.insert(pieces, {
				kind = "core",
				world = w,
				x = math.cos(angle) * dist,
				y = y,
				z = math.sin(angle) * dist,
				angle = angle,
				dist = dist,
				size = size,
				variant = rng.int(1, 3),
				seed = rng.int(1, 1000000),
			})
		end

		if w < worlds then
			-- a little above the boundary pad so the halo frames the milestone banner
			table.insert(pieces, {
				kind = "ring",
				world = w + 1,
				x = 0,
				y = y1 + 16,
				z = 0,
				angle = 0,
				dist = DecorPlan.RING_RADIUS,
				size = DecorPlan.RING_TUBE,
				variant = 1,
				seed = rng.int(1, 1000000),
			})
		end
	end
	return pieces
end

-- True when the piece (with its whole bounding radius) stays out of the lane + clearance.
function DecorPlan.clearOfLane(p: Piece, Layout: LayoutLike): boolean
	local inner, outer = DecorPlan.lane(Layout)
	if p.kind == "core" then
		return p.dist + p.size <= inner - DecorPlan.CLEARANCE
	end
	return p.dist - p.size >= outer + DecorPlan.CLEARANCE
end

return DecorPlan
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--!strict
-- Coin economy numbers (what the free player earns and what the cosmetics cost). PURE Luau, no
-- Roblox APIs, so sim/pacing_sim.luau and tests/pacing_test.luau can load the REAL numbers
-- (Config requires this module and re-exports every field, like it does with Shared/Pricing).
-- Robux prices are NOT here: they live in Shared/Pricing.
local Economy = {}

Economy.CoinsPerTower = 250 -- bonus for every summit (stage 100, 200 ... 1000)
Economy.CoinPickupValue = 3
Economy.CoinsPerWin = 250

Economy.DailyRewards = { 25, 40, 60, 80, 100, 150, 250 } -- by streak day (day 7+ repeats last)
Economy.DailyFreeSkipOnDay = 7 -- streak day that also gives a free skip
Economy.DailyCooldown = 20 * 3600 -- can claim again after 20 h
Economy.DailyStreakWindow = 48 * 3600 -- miss this and the streak resets

export type PlaytimeReward = { minutes: number, coins: number, freeSkips: number }
Economy.PlaytimeRewards = {
	{ minutes = 1, coins = 20, freeSkips = 0 }, -- first gift inside the first minute
	{ minutes = 5, coins = 30, freeSkips = 0 },
	{ minutes = 15, coins = 75, freeSkips = 0 },
	{ minutes = 30, coins = 150, freeSkips = 1 },
	{ minutes = 60, coins = 300, freeSkips = 2 },
} :: { PlaytimeReward }

export type Code = { coins: number, freeSkips: number?, expires: number? }
Economy.Codes = {
	RELEASE = { coins = 100 },
	SKYHIGH = { coins = 150, freeSkips = 1 },
	CLOUDS = { coins = 50 },
} :: { [string]: Code }

-- Coin prices of the cosmetics sold in the menu shop (Config.Trails / Config.Effects take them
-- from here; the free / exclusive ones have no entry).
Economy.TrailPrice = {
	white = 20,
	mint = 50,
	fire = 160,
	ocean = 350,
	candy = 650,
	toxic = 1200,
	galaxy = 3000,
	rainbow = 6000,
} :: { [string]: number }

Economy.EffectPrice = {
	sparkles = 100,
	smoke = 400,
	stars = 900,
	flames = 2500,
} :: { [string]: number }

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Gifts</string>
          <string name="Source"><![CDATA[--!strict
-- The gift at the top of every tower: ten different, fixed rewards (nothing random, nothing to
-- buy). PURE Luau. The HUD shows the next one in advance; server/Gifts.luau grants them.
local Gifts = {}

export type Gift = {
	id: number, -- 1..10, also the tower whose summit gives it
	stage: number, -- 100, 200 ... 1000
	kind: string, -- trail | pet | coins | effect | title | dailySkip | skin | hat
	value: any, -- id of the cosmetic, or the number for coins / dailySkip
	icon: string, -- emoji for the HUD chip and the gift plinth
}

Gifts.List = {
	{ id = 1, stage = 100, kind = "trail", value = "summit", icon = "🔥" }, -- Summit Flame trail (+ the free lounge)
	{ id = 2, stage = 200, kind = "pet", value = "cloudling", icon = "☁" }, -- a little cloud that rides on your shoulder
	{ id = 3, stage = 300, kind = "coins", value = 1.5, icon = "🍀" }, -- Lucky Charm: x1.5 coins for ever
	{ id = 4, stage = 400, kind = "effect", value = "aurora", icon = "🌈" }, -- Aurora aura
	{ id = 5, stage = 500, kind = "title", value = "legend", icon = "🏅" }, -- "Halfway Legend" title in gold
	{ id = 6, stage = 600, kind = "dailySkip", value = 1, icon = "🎟" }, -- +1 free skip with every daily reward
	{ id = 7, stage = 700, kind = "skin", value = "glow_rainbow", icon = "✨" }, -- Rainbow glow skin
	{ id = 8, stage = 800, kind = "trail", value = "comet", icon = "☄" }, -- Comet trail
	{ id = 9, stage = 900, kind = "coins", value = 2, icon = "💎" }, -- Diamond Charm: x2 coins for ever
	{ id = 10, stage = 1000, kind = "hat", value = "crown", icon = "👑" }, -- Sky Crown + "Conqueror of 1000" title
} :: { Gift }

function Gifts.at(stage: number): Gift?
	for _, g in Gifts.List do
		if g.stage == stage then
			return g
		end
	end
	return nil
end

-- The next gift somebody whose best stage is `best` is climbing towards (nil = has them all).
function Gifts.next(best: number): Gift?
	for _, g in Gifts.List do
		if g.stage > best then
			return g
		end
	end
	return nil
end

-- Gifts that a player with this best stage must own (used to back-fill old profiles).
function Gifts.earned(best: number): { Gift }
	local out = {}
	for _, g in Gifts.List do
		if best >= g.stage then
			table.insert(out, g)
		end
	end
	return out
end

-- Permanent coin multiplier from the charms (the best one counts, they do not stack).
function Gifts.coinMult(owned: { [string]: boolean }): number
	local mult = 1
	for _, g in Gifts.List do
		if g.kind == "coins" and owned[tostring(g.id)] then
			mult = math.max(mult, g.value :: number)
		end
	end
	return mult
end

-- Extra free skips per daily reward.
function Gifts.dailySkips(owned: { [string]: boolean }): number
	local n = 0
	for _, g in Gifts.List do
		if g.kind == "dailySkip" and owned[tostring(g.id)] then
			n += g.value :: number
		end
	end
	return n
end

return Gifts
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Icons</string>
          <string name="Source"><![CDATA[--!strict
-- HUD icon images (shared pack in assets/icons, drawn by tools/icons/make_icons.py at the repo root).
-- The ids between the GENERATED markers are written by tools/icons/upload_assets.py; do not edit by hand.
-- An empty id means "not uploaded yet": callers must fall back to their emoji glyph, so the game
-- keeps working before the upload.
local Icons = {}

Icons.ids = {
	-- BEGIN GENERATED
	aura = "",
	auto = "",
	bolt = "",
	book = "",
	calendar = "",
	cash = "",
	check = "",
	clock = "",
	close = "",
	cloud = "",
	coin = "",
	crown = "",
	egg = "",
	fist = "",
	flame = "",
	gem = "",
	gift = "",
	group = "",
	heart = "",
	invite = "",
	lock = "",
	luck = "",
	magnet = "",
	map = "",
	orb = "",
	paw = "",
	pickaxe = "",
	planet = "",
	quest = "",
	rebirth = "",
	rocket = "",
	settings = "",
	shield = "",
	shop = "",
	skull = "",
	sound = "",
	sprout = "",
	star = "",
	sword = "",
	tap = "",
	target = "",
	teleport = "",
	ticket = "",
	trophy = "",
	upgrade = "",
	wheel = "",
	-- END GENERATED
} :: { [string]: string }

-- The emoji glyphs this game uses in its UI, and the drawn icon that replaces each one once it is
-- uploaded (UI/Kit.icon). A glyph without an entry (or whose icon has no id yet) stays an emoji.
Icons.GLYPHS = {
	["🏆"] = "trophy",
	["🎁"] = "gift",
	["🛍"] = "shop",
	["🛒"] = "shop",
	["💎"] = "gem",
	["⚙"] = "settings",
	["👋"] = "invite",
	["⭐"] = "star",
	["🌟"] = "star",
	["🚀"] = "rocket",
	["👑"] = "crown",
	["⚡"] = "bolt",
	["🪐"] = "planet",
	["📍"] = "map",
	["💰"] = "cash",
	["🛡"] = "shield",
	["🧲"] = "magnet",
	["⏫"] = "upgrade",
	["🌀"] = "teleport",
	["☁"] = "cloud",
	["🔥"] = "flame",
	["🍀"] = "luck",
	["🎟"] = "ticket",
	["🔒"] = "lock",
	["✅"] = "check",
	["❌"] = "close",
	["⏱"] = "clock",
	["🕐"] = "clock",
	["📅"] = "calendar",
	["👥"] = "group",
	["💀"] = "skull",
	["🔄"] = "rebirth",
} :: { [string]: string }

-- Icon name for an emoji glyph (a trailing variation selector U+FE0F is ignored), nil if none.
function Icons.forGlyph(glyph: string): string?
	local name = Icons.GLYPHS[glyph]
	if name then
		return name
	end
	local stripped = string.gsub(glyph, "\u{FE0F}", "")
	return Icons.GLYPHS[stripped]
end

-- Image for an emoji glyph: "rbxassetid://..." once its icon is uploaded, nil otherwise.
function Icons.forGlyphImage(glyph: string): string?
	local name = Icons.forGlyph(glyph)
	return if name then Icons.get(name) else nil
end

-- "rbxassetid://<id>" when the icon is uploaded, nil otherwise.
function Icons.get(name: string): string?
	local id = Icons.ids[name]
	if id and id ~= "" then
		return "rbxassetid://" .. id
	end
	return nil
end

return Icons
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Layout</string>
          <string name="Source"><![CDATA[--!strict
-- Sky Tower layout math. PURE Luau: no Roblox APIs (no Vector3, CFrame, Random, game),
-- so it can be unit-tested with the standalone luau.exe (see tests/layout_test.luau).
--
-- The game is 1,000 stages: ten towers of 100. Each tower is a hexagonal spiral: checkpoint pad k
-- (0..100) sits on a circle of radius RING_RADIUS at angle START_ANGLE + k * 60deg, and climbs by
-- a per-stage rise. Every stage is a straight run of SPAN studs between two pads, described in a
-- local frame:
--   s   = distance along the stage direction (0 = previous pad centre, SPAN = next pad centre)
--   lat = sideways offset (positive = towards the tower centre)
--   y   = height relative to the previous pad top
-- "nodes" are the surfaces the player must stand on, in order. "hazards" are everything else.
--
-- Stage numbers are GLOBAL (1..1000): tower t holds stages (t-1)*100+1 .. t*100, and its pad k is
-- the checkpoint of global stage (t-1)*100+k. Towers stand TOWER_SPACING studs apart along +X and
-- are only built while somebody is climbing them (server/Towers.luau).

local Layout = {}

Layout.STAGES = 100 -- per tower
Layout.TOWERS = 10
Layout.TOTAL = Layout.STAGES * Layout.TOWERS
Layout.TOWER_SPACING = 2400
Layout.SIDES = 6
Layout.RING_RADIUS = 60
Layout.START_ANGLE = math.pi / 2
Layout.BASE_Y = 2 -- top of pad 0 of every tower
Layout.PAD_RADIUS = 6
Layout.PAD_THICK = 1.2
Layout.MAX_LAT_EXTENT = 9.5 -- |lat| + width/2 of any node stays inside this (keeps clear of the core pillar)
Layout.CORE_RADIUS = 22
Layout.DEFAULT_SEED = 777
-- Shop decks: a wooden terrace on the OUTER side of the first pad of every world (pads 10, 20 ..
-- 90 of each tower), reached by a short bridge. Sizes live here so the layout test can prove no
-- deck ever touches the route (tests/layout_test.luau).
Layout.SHOP_NEAR = 7.5 -- pad centre -> near edge of the deck
Layout.SHOP_DEPTH = 14
Layout.SHOP_WIDTH = 23
Layout.SHOP_HEADROOM = 7.5 -- clear height over the deck (a character is 5 studs tall)

-- True for the pads (slot inside the tower) that carry a shop deck.
function Layout.hasShop(slot: number): boolean
	return slot > 0 and slot % 10 == 0 and slot < Layout.STAGES
end

-- Classic obby character: JumpPower 50 (a 6.37 stud jump), WalkSpeed 16, gravity 196.2.
-- server/init enforces these on every character and tests/layout_test.luau fails if the jump is
-- ever raised: the whole map is calibrated against it.
local JUMP_POWER = 50
local GRAVITY = 196.2
Layout.Physics = {
	walkSpeed = 16,
	jumpPower = JUMP_POWER,
	gravity = GRAVITY,
	jumpHeight = JUMP_POWER * JUMP_POWER / (2 * GRAVITY), -- 6.371
	bounceHeight = 24, -- apex height a bounce pad launches you to (client applies the velocity)
}
Layout.MAX_JUMP_POWER = 50 -- tests refuse anything higher

-- A single hop never climbs more than this (70% of the jump apex), whatever the difficulty.
Layout.MAX_STEP = 4.4
-- No jump ever uses more than this share of the physical reach (edge to edge at WalkSpeed).
Layout.MAX_REACH = 0.93

-- Obstacle library, in unlock order.
Layout.Kinds = {
	"jumps",
	"killbricks",
	"beam",
	"conveyor",
	"truss",
	"bounce",
	"disappear",
	"moving",
	"spinner",
	"ice",
	"glass",
	"falling",
	"laser",
	"lava",
	"wallhop",
	"wind",
	"mixed",
}

-- Global stage at which each kind enters the random pool.
Layout.Unlock = {
	jumps = 1,
	killbricks = 1,
	beam = 2,
	conveyor = 3,
	truss = 4,
	bounce = 6,
	disappear = 8,
	moving = 9,
	spinner = 11,
	ice = 14,
	glass = 17,
	falling = 21,
	laser = 24,
	lava = 28,
	wallhop = 31,
	wind = 36,
	mixed = 41,
} :: { [string]: number }

-- Hand-picked kinds for the first stages so the tutorial curve is smooth.
Layout.Fixed = {
	[1] = "jumps",
	[2] = "killbricks",
	[3] = "beam",
	[4] = "truss",
	[5] = "jumps",
	[6] = "bounce",
	[7] = "conveyor",
	[8] = "disappear",
	[9] = "moving",
	[10] = "killbricks",
} :: { [number]: string }

export type Vec = { x: number, y: number, z: number }

export type Node = {
	kind: string, -- platform | beam | moving | disappear | ice | conveyor | bounce | glass | falling | truss | ledge
	s: number,
	lat: number,
	y: number, -- top surface height (relative)
	len: number, -- along s
	width: number, -- along lat
	thick: number,
	yBottom: number?, -- truss only: bottom of the climbable part
	moveAxis: string?, -- moving only: "lat" | "y"
	moveAmp: number?,
	movePeriod: number?,
	movePhase: number?,
	pushLat: number?, -- conveyor velocity (lateral component)
	pushS: number?, -- conveyor velocity (along s, negative = pushes back)
	delay: number?, -- disappear / falling: seconds after touch
}

export type Hazard = {
	kind: string, -- killstrip | killcube | spinner | lava | wall | laser | wind
	s: number,
	lat: number,
	y: number, -- bottom (relative)
	len: number,
	width: number,
	height: number,
	speed: number?, -- spinner rad/s
	bars: number?, -- spinner bar count
	period: number?, -- lava / laser cycle seconds
	maxRise: number?, -- lava: top height at peak (relative)
	duty: number?, -- laser: share of the period the beam is ON
	phase: number?, -- laser: 0..1 offset into the period
	push: number?, -- wind: lateral speed (studs/s, sign = direction along lat)
}

export type Coin = { id: number, s: number, lat: number, y: number }

export type Stage = {
	index: number, -- global stage number (1..1000)
	slot: number, -- 1..100 inside its tower
	tower: number,
	kind: string,
	theme: number, -- look of the world this stage belongs to (index into Config.Themes)
	difficulty: number,
	reach: number, -- share of the physical jump reach this stage aims for
	from: Vec,
	to: Vec,
	dirX: number,
	dirZ: number,
	span: number,
	rise: number,
	nodes: { Node },
	hazards: { Hazard },
	coins: { Coin },
	maxRel: number, -- highest structure top, relative to from.y
}

export type Map = {
	seed: number,
	tower: number,
	origin: Vec, -- world position of the tower axis at y = 0
	pads: { [number]: Vec }, -- 0..STAGES (top-centre of each checkpoint pad), world coordinates
	stages: { Stage }, -- 1..STAGES (stage i has global index (tower-1)*100+i)
}

---------------------------------------------------------------------------------------------
-- Deterministic RNG (Park-Miller). Products stay < 2^53 so it is bit-exact everywhere.
---------------------------------------------------------------------------------------------
export type Rng = {
	next: () -> number,
	range: (a: number, b: number) -> number,
	int: (a: number, b: number) -> number,
}

function Layout.newRng(seed: number): Rng
	local state = (math.floor(math.abs(seed)) % 2147483646) + 1
	local function nextValue(): number
		state = (state * 48271) % 2147483647
		return (state - 1) / 2147483646
	end
	return {
		next = nextValue,
		range = function(a: number, b: number): number
			return a + (b - a) * nextValue()
		end,
		int = function(a: number, b: number): number
			return math.min(b, a + math.floor(nextValue() * (b - a + 1)))
		end,
	}
end

---------------------------------------------------------------------------------------------
-- Physics helpers
---------------------------------------------------------------------------------------------
local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end
Layout.lerp = lerp

-- Time in the air when jumping (apex jumpH) and landing dh studs higher. nil = unreachable.
function Layout.airTime(dh: number, jumpH: number?): number?
	local P = Layout.Physics
	local h = jumpH or P.jumpHeight
	local v0 = math.sqrt(2 * P.gravity * h)
	local disc = v0 * v0 - 2 * P.gravity * dh
	if disc < 0 then
		return nil
	end
	return (v0 + math.sqrt(disc)) / P.gravity
end

-- Max horizontal edge-to-edge distance you can clear at WalkSpeed, landing dh higher.
function Layout.maxGap(dh: number, jumpH: number?): number
	local t = Layout.airTime(dh, jumpH)
	if not t then
		return 0
	end
	return Layout.Physics.walkSpeed * t
end

---------------------------------------------------------------------------------------------
-- Difficulty. Two curves over the GLOBAL stage number g (1..1000):
--   difficulty(g) 0..1 : sizes and speeds (platform size, mover speed, fade delay, kill bricks...)
--   reach(g)           : share of the physical jump reach the gaps aim for
-- Easy for the first ten stages (don't lose the newcomer), properly hard from the middle of
-- tower 1, and creeping towards the limit over towers 2..10.
---------------------------------------------------------------------------------------------
function Layout.towerOf(g: number): number
	return math.clamp((math.max(g, 1) - 1) // Layout.STAGES + 1, 1, Layout.TOWERS)
end

-- 1..100: position of global stage g inside its tower.
function Layout.slotOf(g: number): number
	return (math.max(g, 1) - 1) % Layout.STAGES + 1
end

function Layout.difficulty(g: number): number
	local base
	if g <= Layout.STAGES then
		base = 0.8 * ((g - 1) / (Layout.STAGES - 1)) ^ 0.55
	else
		base = 0.78 + 0.22 * ((g - Layout.STAGES) / (Layout.TOTAL - Layout.STAGES)) ^ 0.7
	end
	-- a small saw-tooth inside every 10-stage world: each world ends harder than it starts
	local inWorld = ((g - 1) % 10) / 9
	return math.clamp(base + inWorld * 0.04, 0, 1)
end

function Layout.reach(g: number): number
	if g <= 10 then
		return lerp(0.42, 0.58, (g - 1) / 9)
	elseif g <= 50 then
		return lerp(0.6, 0.84, (g - 11) / 39)
	elseif g <= Layout.STAGES then
		return lerp(0.84, 0.93, ((g - 51) / 49) ^ 0.8)
	end
	return lerp(0.93, 0.93, ((g - Layout.STAGES - 1) / (Layout.TOTAL - Layout.STAGES - 1)) ^ 0.6)
end

-- Checkpoint spacing: every pad saves up to stage 50; after that only some do (the others are rest
-- pads: you stand on them, but a fall takes you back to the last saving pad). Milestone pads
-- (every 10 stages: world entrances, shops) always save.
function Layout.isSave(g: number): boolean
	if g <= 50 or g % 10 == 0 then
		return true
	elseif g <= 300 then
		return g % 2 == 0
	end
	local r = g % 10
	return r == 3 or r == 6
end

-- Which of the ten world looks global stage g uses. Tower 1 plays them in order; every later
-- tower starts three worlds further round, so no two towers open the same way.
function Layout.themeFor(g: number): number
	local stage = math.max(g, 1)
	local world = (Layout.slotOf(stage) - 1) // 10
	return (world + (Layout.towerOf(stage) - 1) * 3) % 10 + 1
end

-- 1..10: which world (10-stage block) of its tower global stage g is in.
function Layout.worldSlot(g: number): number
	return (Layout.slotOf(g) - 1) // 10 + 1
end

function Layout.towerOrigin(tower: number): Vec
	return { x = (tower - 1) * Layout.TOWER_SPACING, y = 0, z = 0 }
end

---------------------------------------------------------------------------------------------
-- Node / hazard helpers
---------------------------------------------------------------------------------------------
type Ctx = { rng: Rng, d: number, reach: number, span: number, rise: number, s0: number, s1: number }

-- Gap the generator aims for on a hop that climbs dh: `reach` of the physical limit, with a
-- little noise, never above MAX_REACH. Returns a huge number when the hop is too tall.
local function gapFor(c: Ctx, dh: number, scale: number?): number
	if dh > Layout.MAX_STEP then
		return 1e6
	end
	local limit = Layout.maxGap(math.max(dh, 0))
	if limit < 2.5 then
		return 1e6
	end
	local share = (c.reach + c.rng.range(-0.025, 0.025)) * (scale or 1)
	return math.clamp(limit * share, 1.2, limit * Layout.MAX_REACH)
end

local function node(kind: string, s: number, lat: number, y: number, len: number, width: number): Node
	return { kind = kind, s = s, lat = lat, y = y, len = len, width = width, thick = 1.2 }
end

local function clampLat(lat: number, width: number): number
	local lim = Layout.MAX_LAT_EXTENT - width / 2
	return math.clamp(lat, -lim, lim)
end

type ChainOpts = {
	kind: string,
	s0: number, -- where the run starts (edge of the previous surface)
	s1: number, -- where it ends (edge of the next surface)
	y0: number, -- height of the surface before the run
	y1: number, -- height of the surface after the run
	desiredLen: number,
	minLen: number,
	width: number,
	latAmp: number,
	gapScale: number?,
	maxN: number?,
}

-- Fills [s0, s1] with n platforms separated by equal gaps, climbing linearly from y0 to y1.
-- Picks n so platform length is closest to desiredLen. Returns nodes and the gap used.
local function chain(c: Ctx, o: ChainOpts): ({ Node }, number)
	local rng = c.rng
	local span = o.s1 - o.s0
	local bestN, bestG, bestL, bestScore = 0, 0, 0, math.huge
	local fallN, fallG, fallL = 0, 0, 0
	for n = 1, o.maxN or 14 do
		local dh = (o.y1 - o.y0) / (n + 1)
		local g = gapFor(c, dh, o.gapScale)
		local L = (span - (n + 1) * g) / n
		if L >= o.minLen then
			local score = math.abs(L - o.desiredLen)
			if score < bestScore then
				bestN, bestG, bestL, bestScore = n, g, L, score
			end
		end
		-- safety net: the platform count whose (shrunk) gaps still fit with the shortest platforms
		if g < 1e5 and fallN == 0 then
			local gFit = math.min(g, (span - n * o.minLen) / (n + 1))
			if gFit >= 1 then
				fallN, fallG, fallL = n, gFit, (span - (n + 1) * gFit) / n
			end
		end
	end
	if bestN == 0 then
		bestN, bestG, bestL = fallN, fallG, fallL
	end
	if bestN == 0 then
		-- cannot happen with the spans and rises used by the kinds below; keep the stage walkable
		bestN, bestG = 6, 1.5
		bestL = (span - (bestN + 1) * bestG) / bestN
	end
	local nodes = {}
	local dh = (o.y1 - o.y0) / (bestN + 1)
	local prevLat = 0
	for j = 1, bestN do
		local s = o.s0 + bestG * j + bestL * (j - 0.5)
		-- zig-zag: alternate side, bounded so lateral step never exceeds the platform width
		local lat = 0
		if o.latAmp > 0 then
			local side = if j % 2 == 0 then 1 else -1
			lat = side * rng.range(o.latAmp * 0.4, o.latAmp)
			lat = math.clamp(lat, prevLat - o.width, prevLat + o.width)
		end
		lat = clampLat(lat, o.width)
		prevLat = lat
		table.insert(nodes, node(o.kind, s, lat, o.y0 + dh * j, bestL, o.width))
	end
	return nodes, bestG
end

-- A kill cube on one half of a platform (stay on the safe side).
local function killCube(n: Node, side: number): Hazard
	return { kind = "killcube", s = n.s, lat = n.lat + side * n.width * 0.25, y = n.y, len = math.min(1.6, n.len * 0.4), width = n.width * 0.4, height = 1.6 }
end

---------------------------------------------------------------------------------------------
-- Stage kinds. Each returns nodes + hazards for a stage of the given span/rise.
-- (StageGenerator has the matching Roblox builder for every kind.)
---------------------------------------------------------------------------------------------
type KindResult = { nodes: { Node }, hazards: { Hazard } }

local Kinds: { [string]: (Ctx) -> KindResult } = {}

-- Classic jumps over gaps; later on, every other platform carries a kill cube.
function Kinds.jumps(c: Ctx): KindResult
	local nodes = chain(c, {
		kind = "platform",
		s0 = c.s0,
		s1 = c.s1,
		y0 = 0,
		y1 = c.rise,
		desiredLen = lerp(6, 2.6, c.d),
		minLen = 2.4,
		width = lerp(6, 2.5, c.d),
		latAmp = 3,
	})
	local hazards: { Hazard } = {}
	if c.d > 0.35 then
		for i, n in nodes do
			if i % 2 == 0 and n.len >= 3.4 and n.width >= 3.4 then
				table.insert(hazards, killCube(n, if (i // 2) % 2 == 0 then 1 else -1))
			end
		end
	end
	return { nodes = nodes, hazards = hazards }
end

-- Floor pieces separated by neon-red kill strips (jump the strip or die).
function Kinds.killbricks(c: Ctx): KindResult
	local nodes, g = chain(c, {
		kind = "platform",
		s0 = c.s0,
		s1 = c.s1,
		y0 = 0,
		y1 = c.rise,
		desiredLen = lerp(7, 3.4, c.d),
		minLen = 3,
		width = 8,
		latAmp = 0,
		gapScale = lerp(0.85, 0.95, c.d),
	})
	local hazards: { Hazard } = {}
	local prevEnd, prevY = c.s0, 0
	for i, n in nodes do
		local startS = n.s - n.len / 2
		local low = math.min(prevY, n.y)
		table.insert(hazards, {
			kind = "killstrip",
			s = (prevEnd + startS) / 2,
			lat = 0,
			y = low - 1.2,
			len = g,
			width = 8,
			height = 1.2,
		})
		prevEnd, prevY = n.s + n.len / 2, n.y
		-- kill cubes on the platforms themselves: every other one from early on, all of them later
		if n.len >= 3.2 and ((c.d > 0.2 and i % 2 == 0) or c.d > 0.6) then
			table.insert(hazards, killCube(n, if i % 2 == 0 then 1 else -1))
		end
	end
	table.insert(hazards, {
		kind = "killstrip",
		s = (prevEnd + c.s1) / 2,
		lat = 0,
		y = math.min(prevY, c.rise) - 1.2,
		len = g,
		width = 8,
		height = 1.2,
	})
	return { nodes = nodes, hazards = hazards }
end

-- Long narrow beams.
function Kinds.beam(c: Ctx): KindResult
	local nodes = chain(c, {
		kind = "beam",
		s0 = c.s0,
		s1 = c.s1,
		y0 = 0,
		y1 = c.rise,
		desiredLen = lerp(11, 14, c.d),
		minLen = 6,
		width = lerp(2.4, 1, c.d),
		latAmp = lerp(1.2, 2.2, c.d),
		gapScale = lerp(0.6, 0.92, c.d),
	})
	return { nodes = nodes, hazards = {} }
end

-- Conveyor belts pushing you backwards or sideways.
function Kinds.conveyor(c: Ctx): KindResult
	local nodes = chain(c, {
		kind = "conveyor",
		s0 = c.s0,
		s1 = c.s1,
		y0 = 0,
		y1 = c.rise,
		desiredLen = lerp(10, 12, c.d),
		minLen = 6,
		width = lerp(6, 4.5, c.d),
		latAmp = 2,
		gapScale = lerp(0.75, 0.92, c.d),
	})
	local hazards: { Hazard } = {}
	for i, n in nodes do
		if i % 2 == 1 then
			n.pushS = -lerp(6, 10, c.d)
			n.pushLat = 0
		else
			local side = if c.rng.next() < 0.5 then -1 else 1
			n.pushS = 0
			n.pushLat = side * lerp(5, 10, c.d)
			if c.d > 0.5 then
				-- a kill rail along the edge the belt carries you to
				table.insert(hazards, { kind = "killcube", s = n.s, lat = n.lat + side * (n.width / 2 - 0.3), y = n.y, len = n.len * 0.7, width = 0.6, height = 1.2 })
			end
		end
	end
	return { nodes = nodes, hazards = hazards }
end

-- Walk to a truss, climb it, walk off the top.
function Kinds.truss(c: Ctx): KindResult
	local rng = c.rng
	local nodes: { Node } = {}
	local g1 = gapFor(c, 0, lerp(0.7, 0.9, c.d))
	local walk = rng.range(8, 12)
	local a1 = node("platform", c.s0 + g1 + walk / 2, 0, 0, walk, lerp(6, 4, c.d))
	table.insert(nodes, a1)
	local trussS = a1.s + walk / 2 + 1 -- 2x2 truss glued to the end of the walkway
	local topY = c.rise - 2.5
	local t = node("truss", trussS, 0, topY, 2, 2)
	t.yBottom = 0
	table.insert(nodes, t)
	-- landing on top of the truss, then hops to the pad
	local landingStart = trussS + 1
	local landLen = lerp(5, 3.5, c.d)
	table.insert(nodes, node("platform", landingStart + landLen / 2, 0, topY, landLen, lerp(6, 4, c.d)))
	local rest = chain(c, {
		kind = "platform",
		s0 = landingStart + landLen,
		s1 = c.s1,
		y0 = topY,
		y1 = c.rise,
		desiredLen = lerp(6, 3, c.d),
		minLen = 2.6,
		width = lerp(5, 3, c.d),
		latAmp = 2,
		maxN = 5,
	})
	for _, n in rest do
		table.insert(nodes, n)
	end
	return { nodes = nodes, hazards = {} }
end

-- Bounce pad launches you up to a high ledge.
function Kinds.bounce(c: Ctx): KindResult
	local nodes: { Node } = {}
	local g1 = gapFor(c, 0, 0.8)
	local padLen = lerp(6, 4, c.d)
	local b = node("bounce", c.s0 + g1 + padLen / 2, 0, 0, padLen, lerp(6, 4, c.d))
	table.insert(nodes, b)
	-- the high ledge the bounce throws you onto, g2 past the pad, then hops to the checkpoint
	local highY = c.rise - 2.5
	local g2 = lerp(2, 5, c.d)
	local ledgeLen = lerp(7, 4, c.d)
	local ledge = node("platform", b.s + padLen / 2 + g2 + ledgeLen / 2, 0, highY, ledgeLen, lerp(6, 4, c.d))
	table.insert(nodes, ledge)
	local rest = chain(c, {
		kind = "platform",
		s0 = ledge.s + ledgeLen / 2,
		s1 = c.s1,
		y0 = highY,
		y1 = c.rise,
		desiredLen = lerp(7, 3.2, c.d),
		minLen = 2.8,
		width = lerp(5, 3.2, c.d),
		latAmp = 2,
		maxN = 6,
	})
	for _, n in rest do
		table.insert(nodes, n)
	end
	return { nodes = nodes, hazards = {} }
end

-- Platforms that fade away shortly after you touch them.
function Kinds.disappear(c: Ctx): KindResult
	local nodes = chain(c, {
		kind = "disappear",
		s0 = c.s0,
		s1 = c.s1,
		y0 = 0,
		y1 = c.rise,
		desiredLen = lerp(6, 3, c.d),
		minLen = 2.6,
		width = lerp(6, 2.8, c.d),
		latAmp = 3,
	})
	for _, n in nodes do
		n.delay = lerp(0.9, 0.45, c.d) -- floor: under ~0.45 s nobody can hop on in time
	end
	return { nodes = nodes, hazards = {} }
end

-- Platforms sliding side to side (or up and down later on).
function Kinds.moving(c: Ctx): KindResult
	local nodes = chain(c, {
		kind = "moving",
		s0 = c.s0,
		s1 = c.s1,
		y0 = 0,
		y1 = c.rise,
		desiredLen = lerp(7, 4, c.d),
		minLen = 3.6,
		width = lerp(7, 3.6, c.d),
		latAmp = 0,
		maxN = 6,
		gapScale = 0.85,
	})
	for i, n in nodes do
		local vertical = c.d > 0.4 and i % 2 == 0
		n.moveAxis = if vertical then "y" else "lat"
		n.moveAmp = if vertical then lerp(2, 3, c.d) else math.min(lerp(3.5, 6.5, c.d), Layout.MAX_LAT_EXTENT - n.width / 2)
		n.movePeriod = lerp(4.8, 2.05, c.d)
		n.movePhase = c.rng.next()
	end
	return { nodes = nodes, hazards = {} }
end

-- Wide platforms with rotating kill bars you must jump over.
function Kinds.spinner(c: Ctx): KindResult
	local nodes = chain(c, {
		kind = "platform",
		s0 = c.s0,
		s1 = c.s1,
		y0 = 0,
		y1 = c.rise,
		desiredLen = lerp(18, 13, c.d),
		minLen = 11,
		width = lerp(14, 11, c.d),
		latAmp = 0,
		gapScale = lerp(0.6, 0.88, c.d), -- the easy kinds ramp too, so no kind stays a free stage late on
		maxN = 3,
	})
	local hazards: { Hazard } = {}
	for _, n in nodes do
		table.insert(hazards, {
			kind = "spinner",
			s = n.s,
			lat = n.lat,
			y = n.y + 0.9,
			len = math.min(n.len, n.width) - 0.5, -- bar length (diameter)
			width = 1,
			height = 1,
			speed = lerp(1.3, 3.4, c.d) * (if c.rng.next() < 0.5 then -1 else 1),
			bars = if c.d > 0.8 then 3 elseif c.d > 0.4 then 2 else 1,
		})
	end
	return { nodes = nodes, hazards = hazards }
end

-- Frictionless ice platforms.
function Kinds.ice(c: Ctx): KindResult
	local nodes = chain(c, {
		kind = "ice",
		s0 = c.s0,
		s1 = c.s1,
		y0 = 0,
		y1 = c.rise,
		desiredLen = lerp(7, 4, c.d),
		minLen = 3,
		width = lerp(6, 3.6, c.d),
		latAmp = 2,
		gapScale = 0.9,
	})
	return { nodes = nodes, hazards = {} }
end

-- Glass platforms that are invisible until you are close.
function Kinds.glass(c: Ctx): KindResult
	local nodes = chain(c, {
		kind = "glass",
		s0 = c.s0,
		s1 = c.s1,
		y0 = 0,
		y1 = c.rise,
		desiredLen = lerp(6, 3.4, c.d),
		minLen = 3,
		width = lerp(5, 3.0, c.d),
		latAmp = 3,
		gapScale = 0.9,
	})
	return { nodes = nodes, hazards = {} }
end

-- Platforms that drop shortly after you land.
function Kinds.falling(c: Ctx): KindResult
	local nodes = chain(c, {
		kind = "falling",
		s0 = c.s0,
		s1 = c.s1,
		y0 = 0,
		y1 = c.rise,
		desiredLen = lerp(6, 3, c.d),
		minLen = 2.6,
		width = lerp(5, 2.8, c.d),
		latAmp = 2,
	})
	for _, n in nodes do
		n.delay = lerp(0.8, 0.45, c.d)
	end
	return { nodes = nodes, hazards = {} }
end

-- Walkways crossed by laser gates that switch on and off: wait for the gap, then run.
function Kinds.laser(c: Ctx): KindResult
	local nodes = chain(c, {
		kind = "platform",
		s0 = c.s0,
		s1 = c.s1,
		y0 = 0,
		y1 = c.rise,
		desiredLen = lerp(17, 13, c.d),
		minLen = 10,
		width = lerp(8, 6, c.d),
		latAmp = 0,
		gapScale = lerp(0.6, 0.88, c.d),
		maxN = 3,
	})
	local hazards: { Hazard } = {}
	local spacing = lerp(6.5, 3.6, c.d)
	local period = lerp(3.2, 1.9, c.d)
	local duty = lerp(0.45, 0.6, c.d)
	for _, n in nodes do
		-- 2.5 studs of landing room at both ends of the walkway
		local room = n.len - 5
		local gates = math.clamp(math.floor(room / spacing) + 1, 1, 4)
		for j = 1, gates do
			local offset = if gates == 1 then 0 else (j - 1) / (gates - 1) - 0.5
			table.insert(hazards, {
				kind = "laser",
				s = n.s + offset * math.min(room, spacing * (gates - 1)),
				lat = n.lat,
				y = n.y,
				len = 0.6,
				width = n.width,
				height = 7,
				period = period,
				duty = duty,
				phase = c.rng.next(),
			})
		end
	end
	return { nodes = nodes, hazards = hazards }
end

-- Staircase over a lava floor that rises on a timer.
function Kinds.lava(c: Ctx): KindResult
	local nodes = chain(c, {
		kind = "platform",
		s0 = c.s0,
		s1 = c.s1,
		y0 = 0,
		y1 = c.rise,
		desiredLen = lerp(5, 3, c.d),
		minLen = 2.6,
		width = lerp(5, 2.8, c.d),
		latAmp = 3,
		gapScale = 0.88, -- the rising lava is the pressure
	})
	local lavaStart, lavaEnd = c.s0 + 1, c.s1 - 1
	return {
		nodes = nodes,
		hazards = {
			{
				kind = "lava",
				s = (lavaStart + lavaEnd) / 2,
				lat = 0,
				y = -6,
				len = lavaEnd - lavaStart,
				width = 18,
				height = 2,
				period = lerp(12, 6.5, c.d),
				maxRise = c.rise * 0.55,
			},
		},
	}
end

-- Small ledges stuck to a tall wall, climbing up (the obby "wall hop" section).
function Kinds.wallhop(c: Ctx): KindResult
	local side = if c.rng.next() < 0.5 then 1 else -1
	local ledgeW = lerp(3, 2.2, c.d)
	local nodes = chain(c, {
		kind = "ledge",
		s0 = c.s0,
		s1 = c.s1,
		y0 = 0,
		y1 = c.rise,
		desiredLen = lerp(3.5, 2.2, c.d),
		minLen = 2,
		width = ledgeW,
		latAmp = 0,
		gapScale = lerp(0.72, 0.82, c.d), -- tiny ledges at full reach were the hardest stage of each tower by far
	})
	local ledgeLat = side * 4
	for _, n in nodes do
		n.lat = ledgeLat
	end
	local wallLat = side * (4 + ledgeW / 2 + 0.5)
	return {
		nodes = nodes,
		hazards = {
			{
				kind = "wall",
				s = (c.s0 + c.s1) / 2,
				lat = wallLat,
				y = -3,
				len = c.s1 - c.s0,
				width = 1,
				height = c.rise + 9,
			},
		},
	}
end

-- Platforms in a cross-wind that pushes you sideways while you are in the air; the wind changes
-- side between zones. WIND_MAX_SHARE of WalkSpeed at most, so steering against it always works.
Layout.WIND_MAX_SHARE = 0.6
function Kinds.wind(c: Ctx): KindResult
	local nodes = chain(c, {
		kind = "platform",
		s0 = c.s0,
		s1 = c.s1,
		y0 = 0,
		y1 = c.rise,
		desiredLen = lerp(7, 4, c.d),
		minLen = 3.5,
		width = lerp(7, 4.2, c.d),
		latAmp = 2,
		gapScale = lerp(0.85, 0.95, c.d),
	})
	local hazards: { Hazard } = {}
	local zones = if c.d > 0.5 then 3 else 2
	local zoneLen = (c.s1 - c.s0) / zones
	local push = math.min(lerp(4, 9, c.d), Layout.Physics.walkSpeed * Layout.WIND_MAX_SHARE)
	local side = if c.rng.next() < 0.5 then -1 else 1
	for z = 1, zones do
		table.insert(hazards, {
			kind = "wind",
			s = c.s0 + zoneLen * (z - 0.5),
			lat = 0,
			y = -4,
			len = zoneLen,
			width = Layout.MAX_LAT_EXTENT * 2,
			height = c.rise + 16,
			push = side * push,
		})
		side = -side
	end
	return { nodes = nodes, hazards = hazards }
end

-- A bit of everything: each platform of the run is a different kind (solid, fading, dropping,
-- ice, sliding), with kill cubes on the solid ones. The first and last are always solid.
function Kinds.mixed(c: Ctx): KindResult
	local nodes = chain(c, {
		kind = "platform",
		s0 = c.s0,
		s1 = c.s1,
		y0 = 0,
		y1 = c.rise,
		desiredLen = lerp(6, 3.2, c.d),
		minLen = 2.8,
		width = lerp(6, 3.1, c.d),
		latAmp = 2.5,
		gapScale = 0.9,
	})
	local hazards: { Hazard } = {}
	local cycle = { "disappear", "ice", "falling", "moving", "platform" }
	local offset = c.rng.int(0, #cycle - 1)
	local prevMoving = false
	for i, n in nodes do
		if i > 1 and i < #nodes then
			local kind = cycle[(i + offset) % #cycle + 1]
			if kind == "moving" and prevMoving then
				kind = "platform"
			end
			n.kind = kind
			if kind == "disappear" then
				n.delay = lerp(0.8, 0.3, c.d)
			elseif kind == "falling" then
				n.delay = lerp(0.7, 0.3, c.d)
			elseif kind == "moving" then
				n.moveAxis = "lat"
				n.moveAmp = math.min(lerp(2.5, 4.5, c.d), Layout.MAX_LAT_EXTENT - n.width / 2 - math.abs(n.lat))
				n.movePeriod = lerp(4.5, 2.4, c.d)
				n.movePhase = c.rng.next()
			elseif kind == "platform" and c.d > 0.5 and n.len >= 3.2 and n.width >= 3.4 then
				table.insert(hazards, killCube(n, if i % 2 == 0 then 1 else -1))
			end
			prevMoving = kind == "moving"
		end
	end
	return { nodes = nodes, hazards = hazards }
end

Layout.KindBuilders = Kinds

-- Vertical rise per kind (min, max). Every value >= 8 so the stage six steps higher on the
-- same side of the hexagon is always >= 48 studs overhead.
Layout.Rise = {
	jumps = { 8, 11 },
	killbricks = { 8, 10 },
	beam = { 8, 10 },
	conveyor = { 8, 10 },
	truss = { 14, 20 },
	bounce = { 14, 18 },
	disappear = { 8, 11 },
	moving = { 8, 10 },
	spinner = { 8, 10 },
	ice = { 8, 11 },
	glass = { 8, 11 },
	falling = { 8, 11 },
	laser = { 8, 10 },
	lava = { 10, 14 },
	wallhop = { 12, 16 },
	wind = { 8, 11 },
	mixed = { 8, 11 },
} :: { [string]: { number } }

---------------------------------------------------------------------------------------------
-- Map generation
---------------------------------------------------------------------------------------------
local function padPosition(origin: Vec, k: number, y: number): Vec
	local a = Layout.START_ANGLE + k * (2 * math.pi / Layout.SIDES)
	return { x = origin.x + Layout.RING_RADIUS * math.cos(a), y = origin.y + y, z = origin.z + Layout.RING_RADIUS * math.sin(a) }
end

local function pickKind(rng: Rng, g: number, prev1: string?, prev2: string?): string
	local fixed = Layout.Fixed[g]
	if fixed then
		return fixed
	end
	local pool = {}
	for _, k in Layout.Kinds do
		if g >= Layout.Unlock[k] and k ~= prev1 and k ~= prev2 then
			table.insert(pool, k)
		end
	end
	return pool[rng.int(1, #pool)]
end

-- Generates one tower (default: the first). The same (seed, tower) always gives the same map.
function Layout.generate(seed: number?, tower: number?): Map
	local sd = seed or Layout.DEFAULT_SEED
	local t = math.clamp(math.floor(tower or 1), 1, Layout.TOWERS)
	-- tower 1 keeps the plain seed; the others get their own stream
	local rng = Layout.newRng(sd + (t - 1) * 104729)
	local origin = Layout.towerOrigin(t)
	local pads: { [number]: Vec } = {}
	pads[0] = padPosition(origin, 0, Layout.BASE_Y)
	local stages: { Stage } = {}
	local prev1: string?, prev2: string? = nil, nil
	for i = 1, Layout.STAGES do
		local g = (t - 1) * Layout.STAGES + i
		local kind = pickKind(rng, g, prev1, prev2)
		prev2, prev1 = prev1, kind
		local r = Layout.Rise[kind]
		local rise = math.floor(rng.range(r[1], r[2]) * 2 + 0.5) / 2
		local from = pads[i - 1]
		local to = padPosition(origin, i, from.y - origin.y + rise)
		pads[i] = to
		local dx, dz = to.x - from.x, to.z - from.z
		local span = math.sqrt(dx * dx + dz * dz)
		local d = Layout.difficulty(g)
		local ctx: Ctx = {
			rng = rng,
			d = d,
			reach = Layout.reach(g),
			span = span,
			rise = rise,
			s0 = Layout.PAD_RADIUS,
			s1 = span - Layout.PAD_RADIUS,
		}
		local result = Kinds[kind](ctx)
		-- coins: 1 (2 later) above static-ish nodes
		local coins: { Coin } = {}
		local candidates = {}
		for _, n in result.nodes do
			if n.kind ~= "moving" and n.kind ~= "truss" then
				table.insert(candidates, n)
			end
		end
		if #candidates == 0 then
			candidates = table.clone(result.nodes)
		end
		local count = if d > 0.5 then 2 else 1
		for j = 1, math.min(count, #candidates) do
			local n = candidates[rng.int(1, #candidates)]
			table.insert(coins, { id = g * 10 + j, s = n.s, lat = n.lat, y = n.y + 3 })
		end
		local maxRel = rise
		for _, n in result.nodes do
			maxRel = math.max(maxRel, n.y + (if n.moveAxis == "y" then (n.moveAmp or 0) else 0))
		end
		for _, h in result.hazards do
			if h.kind ~= "wind" then
				local top = h.y + h.height
				if h.kind == "lava" then
					top = h.maxRise or top
				end
				maxRel = math.max(maxRel, top)
			end
		end
		table.insert(stages, {
			index = g,
			slot = i,
			tower = t,
			kind = kind,
			theme = Layout.themeFor(g),
			difficulty = d,
			reach = ctx.reach,
			from = from,
			to = to,
			dirX = dx / span,
			dirZ = dz / span,
			span = span,
			rise = rise,
			nodes = result.nodes,
			hazards = result.hazards,
			coins = coins,
			maxRel = maxRel + 4, -- + character/bar clearance
		})
	end
	return { seed = sd, tower = t, origin = origin, pads = pads, stages = stages }
end

-- Local stage coordinates -> world position (returns x, y, z). lat>0 points to the tower centre.
function Layout.toWorld(st: Stage, s: number, lat: number, yRel: number): (number, number, number)
	-- perpendicular pointing inward: pads go counter-clockwise, so the centre is to the left
	local px, pz = -st.dirZ, st.dirX
	-- make sure (px,pz) points toward the tower axis
	local axisX = (st.tower - 1) * Layout.TOWER_SPACING
	local mx = st.from.x + st.dirX * st.span / 2 - axisX
	local mz = st.from.z + st.dirZ * st.span / 2
	if px * -mx + pz * -mz < 0 then
		px, pz = -px, -pz
	end
	return st.from.x + st.dirX * s + px * lat, st.from.y + yRel, st.from.z + st.dirZ * s + pz * lat
end

-- Top of the highest checkpoint pad (victory room floor).
function Layout.topY(map: Map): number
	return map.pads[Layout.STAGES].y
end

return Layout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">LiveEvents</string>
          <string name="Source"><![CDATA[--!strict
-- Scheduled live events (pure Luau, unit-tested). All times are UTC unix seconds.
--   weekly: { id, kind = "weekly", fromWday, toWday, allDayUTC = true }  (wday: Sunday = 1 ... Saturday = 7,
--           as in os.date("!*t")); active from fromWday 00:00 through toWday 23:59:59, wrapping the week.
--   daily:  { id, kind = "daily", hourUTC, duration }  active for `duration` s from hourUTC:00 every day.
-- An override { id, endsAt } (admin /event command) wins while it lasts.
local LiveEvents = {}

export type EventDef = {
	id: string,
	kind: string,
	fromWday: number?,
	toWday: number?,
	allDayUTC: boolean?,
	hourUTC: number?,
	duration: number?,
}
export type Active = { id: string, endsAt: number }
export type Upcoming = { id: string, startsAt: number }

local DAY = 86400

local function dayStart(t: number): number
	return t - (t % DAY)
end

local function wdayOf(t: number): number
	-- 1970-01-01 was a Thursday (wday 5)
	return ((t // DAY + 4) % 7) + 1
end
LiveEvents.wdayOf = wdayOf

-- If `def` is active at `now`, returns when it ends; else nil.
local function activeUntil(def: EventDef, now: number): number?
	if def.kind == "weekly" then
		local from, to = def.fromWday or 7, def.toWday or 1
		local span = ((to - from) % 7) + 1 -- days in the window
		local wd = wdayOf(now)
		local into = (wd - from) % 7 -- days since the window's first day
		if into < span then
			return dayStart(now) + (span - into) * DAY
		end
		return nil
	elseif def.kind == "daily" then
		local startH = (def.hourUTC or 0) * 3600
		local dur = def.duration or 3600
		local sinceStart = (now - dayStart(now) - startH) % DAY
		if sinceStart < dur then
			return now - sinceStart + dur
		end
		return nil
	end
	return nil
end

-- Next start strictly after `now` (or now's window start if already active is NOT returned).
local function nextStartOf(def: EventDef, now: number): number?
	if def.kind == "weekly" then
		local from = def.fromWday or 7
		local wd = wdayOf(now)
		local days = (from - wd) % 7
		local t = dayStart(now) + days * DAY
		if t <= now then
			t += 7 * DAY
		end
		return t
	elseif def.kind == "daily" then
		local t = dayStart(now) + (def.hourUTC or 0) * 3600
		if t <= now then
			t += DAY
		end
		return t
	end
	return nil
end

function LiveEvents.current(now: number, defs: { EventDef }, override: Active?): Active?
	if override and override.endsAt > now then
		return { id = override.id, endsAt = override.endsAt }
	end
	for _, def in defs do
		local ends = activeUntil(def, now)
		if ends then
			return { id = def.id, endsAt = ends }
		end
	end
	return nil
end

-- Is event `id` active now (scheduled or overridden)?
function LiveEvents.isActive(id: string, now: number, defs: { EventDef }, override: Active?): boolean
	if override and override.endsAt > now and override.id == id then
		return true
	end
	for _, def in defs do
		if def.id == id and activeUntil(def, now) then
			return true
		end
	end
	return false
end

function LiveEvents.nextStart(now: number, defs: { EventDef }): Upcoming?
	local best: Upcoming? = nil
	for _, def in defs do
		local t = nextStartOf(def, now)
		if t and (best == nil or t < best.startsAt) then
			best = { id = def.id, startsAt = t }
		end
	end
	return best
end

return LiveEvents
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Locale</string>
          <string name="Source"><![CDATA[--!strict
-- Translations. One flat table per language in Shared/Locales/<code>.luau ({ [key] = "text {arg}" }).
-- PURE Luau apart from the default loader (Roblox `script`), so tests/locale_test.luau can run it with
-- luau.exe by calling Locale.setLoader.
--
-- Messages that travel server -> client are "specs": { key = "msg.x", args = { n = 3 } }. An arg can
-- itself be a spec (e.g. a trail name { key = "trail.fire" }), and Locale.message also accepts a list
-- of specs (joined with a space) or a plain string (returned as is).

local Locale = {}

export type Spec = { key: string, args: { [string]: any }? }
type Table = { [string]: string }

Locale.DEFAULT = "en"
Locale.LANGS = { "en", "es", "pt", "fr", "de", "id", "tr", "ru", "ja", "ko", "th", "vi" }
Locale.NATIVE = {
	en = { flag = "🇺🇸", name = "English" },
	es = { flag = "🇪🇸", name = "Español" },
	pt = { flag = "🇧🇷", name = "Português" },
	fr = { flag = "🇫🇷", name = "Français" },
	de = { flag = "🇩🇪", name = "Deutsch" },
	id = { flag = "🇮🇩", name = "Bahasa Indonesia" },
	tr = { flag = "🇹🇷", name = "Türkçe" },
	ru = { flag = "🇷🇺", name = "Русский" },
	ja = { flag = "🇯🇵", name = "日本語" },
	ko = { flag = "🇰🇷", name = "한국어" },
	th = { flag = "🇹🇭", name = "ไทย" },
	vi = { flag = "🇻🇳", name = "Tiếng Việt" },
} :: { [string]: { flag: string, name: string } }

local supported: { [string]: boolean } = {}
for _, code in Locale.LANGS do
	supported[code] = true
end

function Locale.isSupported(code: string): boolean
	return supported[code] == true
end

local cache: { [string]: Table } = {}
local loader: ((code: string) -> Table?)? = nil

-- Default loader: the ModuleScripts in Shared/Locales (Roblox only).
local function defaultLoader(code: string): Table?
	local s: any = script -- nil under the standalone luau.exe
	if typeof(s) ~= "Instance" then
		return nil
	end
	local folder = s.Parent and s.Parent:FindFirstChild("Locales")
	local mod = folder and folder:FindFirstChild(code)
	if not mod then
		return nil
	end
	return (require :: any)(mod)
end

function Locale.setLoader(fn: (code: string) -> Table?)
	loader = fn
	table.clear(cache)
end

local function tableFor(code: string): Table?
	local t = cache[code]
	if t then
		return t
	end
	local load = loader or defaultLoader
	local ok, result = pcall(load, code)
	if ok and type(result) == "table" then
		cache[code] = result
		return result
	end
	return nil
end

local function argText(lang: string, v: any): string
	if type(v) == "table" and type(v.key) == "string" then
		return Locale.t(lang, v.key, v.args)
	end
	return tostring(v)
end

-- Translated text for `key`, falling back to English and then to the key itself.
function Locale.t(lang: string, key: string, args: { [string]: any }?): string
	local tbl = tableFor(lang)
	local text = tbl and tbl[key]
	if text == nil and lang ~= Locale.DEFAULT then
		local en = tableFor(Locale.DEFAULT)
		text = en and en[key]
	end
	if text == nil then
		return key
	end
	if args then
		local a = args
		text = string.gsub(text, "{([%w_]+)}", function(name: string)
			local v = a[name]
			if v == nil then
				return "{" .. name .. "}"
			end
			return argText(lang, v)
		end)
	end
	return text
end

-- Accepts a plain string, a spec, or a list of specs.
function Locale.message(lang: string, msg: any): string?
	if msg == nil then
		return nil
	end
	if type(msg) == "string" then
		return msg
	end
	if type(msg) ~= "table" then
		return tostring(msg)
	end
	if type(msg.key) == "string" then
		return Locale.t(lang, msg.key, msg.args)
	end
	local parts = {}
	for _, m in msg do
		local s = Locale.message(lang, m)
		if s then
			table.insert(parts, s)
		end
	end
	return table.concat(parts, " ")
end

-- Roblox LocaleId ("es-es", "pt-br", "zh-cn", "en-us"...) -> a supported code (default "en").
function Locale.resolve(localeId: string?): string
	local id = string.lower(tostring(localeId or ""))
	local base = string.match(id, "^(%a%a)") or ""
	if base == "in" then
		base = "id" -- old Java-style code for Indonesian
	end
	if supported[base] then
		return base
	end
	return Locale.DEFAULT
end

function Locale.spec(key: string, args: { [string]: any }?): Spec
	return { key = key, args = args }
end

return Locale
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="13">
