      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">ModelFit</string>
          <string name="Source"><![CDATA[--!strict
-- Pure helpers for the model slots (no Roblox types, so they run in plain `luau` tests).
local ModelFit = {}

-- Uniform scale that makes `size` fit inside `target` (keeps proportions). Zero-size axes are ignored.
function ModelFit.fitScale(size: { number }, target: { number }): number
	local best = math.huge
	for i = 1, 3 do
		local s, t = size[i], target[i]
		if s and t and s > 1e-4 and t > 1e-4 then
			best = math.min(best, t / s)
		end
	end
	if best == math.huge then
		return 1
	end
	return best
end

-- Deterministic hash of a position (rounded to whole studs), always in 0..2^32-1.
function ModelFit.posHash(x: number, z: number): number
	local ix, iz = math.floor(x + 0.5), math.floor(z + 0.5)
	local h = (ix * 73856093 + iz * 19349663) % 4294967296
	h = (h * 2654435761) % 4294967296
	return h
end

-- Picks among `count` variants (1..count) from a position; same position -> same variant.
function ModelFit.pickVariant(count: number, x: number, z: number): number
	if count <= 1 then
		return 1
	end
	return (ModelFit.posHash(x, z) // 7) % count + 1
end

-- Usable names for a slot given the library's names (a set): "slot", "slot_1", "slot_2"... (gaps ok).
function ModelFit.variantNames(slot: string, has: { [string]: boolean }, maxVariants: number?): { string }
	local out: { string } = {}
	if has[slot] then
		table.insert(out, slot)
	end
	for i = 1, maxVariants or 12 do
		local n = slot .. "_" .. i
		if has[n] then
			table.insert(out, n)
		end
	end
	return out
end

-- A model of `parts` parts is allowed within the per-slot cap and the global budget.
function ModelFit.withinBudget(parts: number, slotCap: number, usedTotal: number, totalCap: number): boolean
	return parts > 0 and parts <= slotCap and usedTotal + parts <= totalCap
end

return ModelFit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Perks</string>
          <string name="Source"><![CDATA[--!strict
-- The Winner's Lounge: free items for everybody who has reached stage 100, handed out in the room
-- at the top of tower 1. PURE Luau catalogue + rules (server/Lounge.luau applies them).
--
-- kind
--   travel  : the teleporter (to the start of any world you have already reached)
--   roam    : glider / cloud. "Explore mode": checkpoints do not count while one is on, and turning
--             it off returns you to your checkpoint, so they cannot be used to skip stages
--   ability : dash / triple jump. They do count for progress, but the run is "assisted"
--   glow    : body glow colours
--   jumpfx  : an effect every time you jump
--   trail / effect : free cosmetics (ids in Config.Trails / Config.Effects, exclusive = "Lounge")
local Perks = {}

-- `gift` = only for owners of that tower gift (the rainbow glow is the gift of stage 700).
export type Perk = { id: string, kind: string, icon: string, color: { number }?, gift: number? }

Perks.UNLOCK_STAGE = 100

Perks.List = {
	{ id = "teleport", kind = "travel", icon = "🌀" },
	{ id = "glider", kind = "roam", icon = "🪂" },
	{ id = "cloud", kind = "roam", icon = "☁" },
	{ id = "dash", kind = "ability", icon = "💨" },
	{ id = "triplejump", kind = "ability", icon = "🦘" },
	{ id = "glow_gold", kind = "glow", icon = "🟡", color = { 255, 205, 60 } },
	{ id = "glow_cyan", kind = "glow", icon = "🔵", color = { 90, 225, 255 } },
	{ id = "glow_pink", kind = "glow", icon = "🟣", color = { 255, 110, 210 } },
	{ id = "glow_green", kind = "glow", icon = "🟢", color = { 110, 240, 130 } },
	{ id = "glow_rainbow", kind = "glow", icon = "🌈", color = { 255, 120, 220 }, gift = 7 },
	{ id = "jumpfx_ring", kind = "jumpfx", icon = "⭕", color = { 255, 255, 255 } },
	{ id = "jumpfx_stars", kind = "jumpfx", icon = "⭐", color = { 255, 230, 90 } },
	{ id = "lounge_neon", kind = "trail", icon = "🎆" },
	{ id = "lounge_sunrise", kind = "trail", icon = "🌅" },
	{ id = "lounge_stars", kind = "effect", icon = "🌟" },
} :: { Perk }

local byId: { [string]: Perk } = {}
for _, p in Perks.List do
	byId[p.id] = p
end

function Perks.get(id: string): Perk?
	return byId[id]
end

function Perks.unlocked(best: number): boolean
	return best >= Perks.UNLOCK_STAGE
end

-- Dash: a short burst, then a cooldown.
Perks.DASH_SPEED = 70
Perks.DASH_TIME = 0.18
Perks.DASH_COOLDOWN = 2.5
-- Glider: falling speed is capped at this while it is open.
Perks.GLIDE_FALL_SPEED = 9
-- Cloud: flying speed.
Perks.CLOUD_SPEED = 40

-- Extra jumps available in the air.
function Perks.airJumps(tripleJumpOn: boolean, doubleJumpActive: boolean): number
	if tripleJumpOn then
		return 2
	elseif doubleJumpActive then
		return 1
	end
	return 0
end

-- Teleporter destinations: the lobby (0) and the first pad of every world already reached, i.e.
-- every multiple of 10 up to `best`. The summit of the last tower is included when reached.
function Perks.travelTargets(best: number): { number }
	local out = { 0 }
	local g = 10
	while g <= best do
		table.insert(out, g)
		g += 10
	end
	return out
end

function Perks.canTravel(best: number, target: number): boolean
	return Perks.unlocked(best) and target >= 0 and target % 10 == 0 and target <= best
end

return Perks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">Powerups</string>
          <string name="Source"><![CDATA[--!strict
-- Shop-zone items: advantages bought with coins on the way up (one shop at the entrance of every
-- world). PURE Luau: catalogue + the purchase / expiry logic, run by server/Shops.luau on the saved
-- profile. Nothing here is random: every purchase gives exactly what the pedestal says.
--
-- kind
--   timed   : works for `seconds` from the purchase (buying again adds time, up to MAX_TIMED)
--   charge  : a counter (max `max`), one is spent each time it triggers
--   instant : happens at once
-- `pass` = a game pass (Config.Passes) that gives the same thing permanently.
-- `robux` = a developer product (Config.Products) that sells the same item for Robux.
local Powerups = {}

export type Item = {
	id: string,
	price: number, -- coins
	kind: string,
	seconds: number?,
	max: number?,
	pass: string?,
	robux: string?,
	icon: string,
	color: { number },
}

Powerups.MAX_TIMED = 30 * 60

Powerups.List = {
	{ id = "speed", price = 60, kind = "timed", seconds = 180, pass = "SpeedCoil", icon = "⚡", color = { 255, 205, 60 } }, -- WalkSpeed 24
	{ id = "gravity", price = 60, kind = "timed", seconds = 180, pass = "GravityCoil", icon = "🪶", color = { 140, 200, 255 } }, -- low gravity
	{ id = "doublejump", price = 90, kind = "timed", seconds = 300, pass = "DoubleJump", icon = "⏫", color = { 120, 235, 150 } }, -- one extra jump in the air
	{ id = "shield", price = 40, kind = "charge", max = 3, icon = "🛡", color = { 120, 170, 255 } }, -- survives one kill brick / laser hit
	{ id = "magnet", price = 50, kind = "timed", seconds = 300, icon = "🧲", color = { 255, 110, 120 } }, -- pulls in nearby coins
	{ id = "skip", price = 150, kind = "instant", robux = "SkipStage", icon = "⏭", color = { 90, 215, 110 } }, -- skips the next stage
	{ id = "pocket", price = 80, kind = "charge", max = 3, pass = "InfiniteRevives", icon = "📍", color = { 255, 150, 60 } }, -- portable checkpoint
} :: { Item }

local byId: { [string]: Item } = {}
for _, item in Powerups.List do
	byId[item.id] = item
end

function Powerups.get(id: string): Item?
	return byId[id]
end

-- The part of a profile the shop works on.
export type State = {
	coins: number,
	boosts: { [string]: number }, -- id -> os.time() when it ends
	charges: { [string]: number },
}

function Powerups.active(boosts: { [string]: number }, id: string, now: number): boolean
	return (boosts[id] or 0) > now
end

function Powerups.remaining(boosts: { [string]: number }, id: string, now: number): number
	return math.max(0, (boosts[id] or 0) - now)
end

-- Buys with coins. Returns ok and, when it fails, a locale key. Mutates `state` only on success.
-- "instant" items are paid here; the caller performs them (and refunds if it cannot).
function Powerups.buy(state: State, id: string, now: number): (boolean, string?)
	local item = byId[id]
	if not item then
		return false, "err.not_for_sale"
	end
	if state.coins < item.price then
		return false, "err.not_enough_coins"
	end
	if item.kind == "timed" then
		local left = Powerups.remaining(state.boosts, id, now)
		if left + (item.seconds or 0) > Powerups.MAX_TIMED then
			return false, "err.boost_full"
		end
		state.boosts[id] = now + left + (item.seconds or 0)
	elseif item.kind == "charge" then
		local have = state.charges[id] or 0
		if have >= (item.max or 1) then
			return false, "err.max_charges"
		end
		state.charges[id] = have + 1
	end
	state.coins -= item.price
	return true, nil
end

-- Spends one charge. False when there is none.
function Powerups.use(state: State, id: string): boolean
	local have = state.charges[id] or 0
	if have <= 0 then
		return false
	end
	state.charges[id] = have - 1
	return true
end

-- Drops expired boosts (keeps the saved profile small). Returns how many were removed.
function Powerups.sweep(boosts: { [string]: number }, now: number): number
	local n = 0
	for id, endsAt in boosts do
		if endsAt <= now then
			boosts[id] = nil
			n += 1
		end
	end
	return n
end

return Powerups
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Pricing</string>
          <string name="Source"><![CDATA[--!strict
-- Robux price list (reference) + the pure rules that depend on it. PURE Luau, unit-tested by
-- tests/pricing_test.luau.
--
-- The REAL price of every product / pass is the one set in the Creator Dashboard (the game reads it
-- with MarketplaceService:GetProductInfo). This table is the intended price list: it is what the
-- owner types into the Dashboard, what the economy checks run against, and what the Starter Pack's
-- crossed-out "value" is computed from, so the anchor can never drift from real prices.
-- Source: docs/research/top-juegos-y-precios.md section 4.2 (obby references).
local Pricing = {}

Pricing.Products = {
	SkipStage = 19, -- 1 stage, levels 1-300
	SkipStageHigh = 29, -- 1 stage, levels 301-1000
	Skip10 = 149, -- 10 stages (vs 190-290 bought one by one)
	DoubleJump5 = 9, -- double jump for 5 minutes: the impulse first purchase
	Coins500 = 49, -- coin ladder: 10.2 / 12.6 / 14.0 coins per R$
	Coins2500 = 199,
	Coins7000 = 499,
	StarterPack = 59,
	AdSkip = 0, -- not sold: reward holder of the rewarded video
} :: { [string]: number }

Pricing.Passes = {
	SpeedCoil = 99,
	GravityCoil = 69,
	Fusion = 139, -- speed + gravity coil in one pass (both sold separately for 168)
	DoubleJump = 99,
	InfiniteRevives = 179,
	DoubleCoins = 195,
	VIP = 299,
} :: { [string]: number }

-- Coins each coin pack gives (Monetization and the store read this, so text and grant agree).
Pricing.CoinPacks = {
	Coins500 = 500,
	Coins2500 = 2500,
	Coins7000 = 7000,
} :: { [string]: number }

-- Levels 1..SkipLowMax use the cheap skip, the rest the dearer one.
Pricing.SkipLowMax = 300

-- The stage a skip would land on is `at + 1`: its band decides the product.
function Pricing.skipKey(at: number): string
	if at + 1 <= Pricing.SkipLowMax then
		return "SkipStage"
	end
	return "SkipStageHigh"
end

-- Product id to prompt for a 1-stage skip from `at`. `ids` = Config.Products. When the id of the
-- band is not created yet (0) the other band's id is used, so selling never stops for want of it.
function Pricing.skipProductId(ids: { [string]: number }, at: number): number
	local key = Pricing.skipKey(at)
	local other = if key == "SkipStage" then "SkipStageHigh" else "SkipStage"
	local id = ids[key] or 0
	if id ~= 0 then
		return id
	end
	return ids[other] or 0
end

-- Crossed-out "value" of the Starter Pack: what its skips and coins cost if bought separately at
-- today's list prices (the exclusive trail and the boost are a free extra, NOT counted).
function Pricing.starterValue(skips: number, coins: number): number
	local total = skips * Pricing.Products.SkipStage
	for key, amount in Pricing.CoinPacks do
		if amount == coins then
			total += Pricing.Products[key]
			return total
		end
	end
	-- coins that match no pack: priced at the smallest pack's rate, rounded up
	local small = Pricing.CoinPacks.Coins500
	return total + math.ceil(coins / small * Pricing.Products.Coins500)
end

-- Honest "-N%" badge: real discount of `price` against `value`, rounded down.
function Pricing.discountPct(value: number, price: number): number
	if value <= 0 or price >= value then
		return 0
	end
	return math.floor((1 - price / value) * 100)
end

-- Robux -> coins per R$ of a pack (for the ladder test and the owner's reference).
function Pricing.coinsPerRobux(key: string): number
	return (Pricing.CoinPacks[key] or 0) / (Pricing.Products[key] or 1)
end

return Pricing
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">Quality</string>
          <string name="Source"><![CDATA[--!strict
-- Lite profile: which devices get the cheaper look. PURE Luau (tests/visual_test.luau).
--
-- The game has to look good with the graphics slider at minimum: what makes a world
-- recognisable (sky colour, platform colours, shapes) never depends on post-processing. The lite
-- profile only removes what a slow device pays for and barely sees: bloom and sun rays, scenery
-- particles and point lights, half of the ambient particles, a shorter radius for cosmetic loops.
-- PC at normal quality never gets it.
local Quality = {}

Quality.LITE_MAX_LEVEL = 3 -- graphics slider 1..3 of 10 (0 = automatic)
Quality.NEAR = 170 -- studs from the camera within which cosmetic loops run
Quality.NEAR_LITE = 110
Quality.WEATHER_RATE_LITE = 0.5

-- "QualityLevel7" -> 7; "Automatic" (or anything else) -> 0
function Quality.level(savedName: string): number
	return tonumber(savedName:match("(%d+)$")) or 0
end

-- touchOnly: a phone / tablet without keyboard. level: graphics slider (0 = automatic).
-- forced: the ForceLite attribute (tests, minimum-graphics screenshots).
function Quality.isLite(touchOnly: boolean, level: number, forced: boolean): boolean
	return forced or touchOnly or (level > 0 and level <= Quality.LITE_MAX_LEVEL)
end

return Quality
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">Referral</string>
          <string name="Source"><![CDATA[--!strict
-- Invite / share-link launch data: "ref:<inviterUserId>" (pure Luau, unit-tested).
local Referral = {}

function Referral.make(userId: number): string
	return "ref:" .. tostring(math.floor(userId))
end

-- Returns the inviter's UserId, or nil for anything that isn't exactly "ref:<digits>".
function Referral.parse(launchData: any): number?
	if type(launchData) ~= "string" or #launchData > 40 then
		return nil
	end
	local digits = string.match(launchData, "^ref:(%d+)$")
	if not digits then
		return nil
	end
	local id = tonumber(digits)
	if not id or id <= 0 then
		return nil
	end
	return id
end

return Referral
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">Rules</string>
          <string name="Source"><![CDATA[--!strict
-- Progress rules for the 1,000-stage climb. PURE Luau (tests/rules_test.luau): the server
-- (Checkpoints, Towers) and the HUD both ask this module, so they can never disagree.
--
-- Vocabulary
--   stage  : the saved checkpoint (where you respawn). 0 = lobby.
--   at     : the highest pad reached since the last respawn (>= stage). Rest pads raise `at`
--            without saving.
--   summit : a multiple of 100. Its pad is the top of a tower; the next tower starts on the other
--            side of the portal, on that tower's base pad ("onBase").
local Rules = {}

-- Set once by whoever requires both modules (shared modules don't require each other).
export type LayoutLike = {
	STAGES: number,
	TOWERS: number,
	TOTAL: number,
	towerOf: (g: number) -> number,
	slotOf: (g: number) -> number,
	isSave: (g: number) -> boolean,
}

function Rules.isSummit(L: LayoutLike, stage: number): boolean
	return stage > 0 and stage % L.STAGES == 0
end

-- Can pad `g` be claimed by somebody whose highest pad is `at`? In order, at most `maxJump`
-- ahead, and never across a portal: the pads of the next tower only count once you stand on its
-- base (onBase).
function Rules.canReach(L: LayoutLike, at: number, g: number, maxJump: number, onBase: boolean): boolean
	if g <= at or g > L.TOTAL or g > at + maxJump then
		return false
	end
	if Rules.isSummit(L, at) and not onBase then
		return false -- on a summit: take the portal first
	end
	-- all pads between at+1 and g are on the same tower
	return L.towerOf(at + 1) == L.towerOf(g)
end

-- Where a skip of `n` stages lands (nil = no skip possible). A skip never crosses a portal: it
-- stops at the summit.
function Rules.skipTarget(L: LayoutLike, at: number, n: number, onBase: boolean): number?
	if at >= L.TOTAL or n < 1 then
		return nil
	end
	if Rules.isSummit(L, at) and not onBase then
		return nil
	end
	local summit = (at // L.STAGES + 1) * L.STAGES
	return math.min(at + n, summit)
end

export type Spot = { tower: number, pad: number }

-- Where the character stands for a given saved stage. nil = the lobby.
function Rules.spawn(L: LayoutLike, stage: number, inLobby: boolean, onBase: boolean): Spot?
	if inLobby or stage <= 0 then
		return nil
	end
	if Rules.isSummit(L, stage) then
		local tower = stage // L.STAGES
		if onBase and tower < L.TOWERS then
			return { tower = tower + 1, pad = 0 }
		end
		return { tower = tower, pad = L.STAGES }
	end
	return { tower = L.towerOf(stage), pad = L.slotOf(stage) }
end

-- The pad (tower, local index) that checkpoint `g` lives on when you walk onto it.
function Rules.padOf(L: LayoutLike, g: number): Spot
	if g <= 0 then
		return { tower = 1, pad = 0 }
	end
	return { tower = L.towerOf(g), pad = L.slotOf(g) }
end

-- Towers that must exist for a player: the one they stand on, and the next one from the last ten
-- stages of a tower on (so the portal never waits for a build).
function Rules.towersNeeded(L: LayoutLike, stage: number, at: number, onBase: boolean): { number }
	local set: { [number]: boolean } = {}
	local spot = Rules.spawn(L, stage, false, onBase)
	set[if spot then spot.tower else 1] = true
	local here = math.max(at, stage)
	local tower, slot = 1, 0
	if here > 0 then
		if Rules.isSummit(L, here) then
			if onBase and here < L.TOTAL then
				tower, slot = here // L.STAGES + 1, 0
			else
				tower, slot = here // L.STAGES, L.STAGES
			end
		else
			tower, slot = L.towerOf(here), L.slotOf(here)
		end
	end
	set[tower] = true
	if slot > L.STAGES - 10 and tower < L.TOWERS then
		set[tower + 1] = true
	end
	local out = {}
	for t in set do
		table.insert(out, t)
	end
	table.sort(out)
	return out
end

-- Portal at the summit of `tower`: open for anybody who has ever reached that summit.
function Rules.portalOpen(L: LayoutLike, best: number, tower: number): boolean
	return tower >= 1 and tower < L.TOWERS and best >= tower * L.STAGES
end

-- Walking (Touched) into the portal on the summit of `tower`. Explicit requests (the prompt, the
-- HUD button) go through portalOpen alone; a touch must never change progress by accident:
--   * not in explore mode (glider / cloud fly past old portals; pads don't count then, and neither
--     does a portal),
--   * not backwards: somebody whose checkpoint is past this summit (e.g. back in the lobby and
--     wandering up tower 1) would lose it.
function Rules.portalTouchAllowed(L: LayoutLike, stage: number, tower: number, roaming: boolean): boolean
	return not roaming and stage <= tower * L.STAGES
end

---------------------------------------------------------------------------------------------
-- Summit rewards (Wins +1 on tower 1, the summit coin bonus): once per summit per run.
-- `runTop` = the highest summit already rewarded in the current run (saved in the profile, reset
-- by a rebirth). Without it a teleport to the world just below a summit (or a rejoin after one)
-- would pay the summit again for a 10-stage climb, and Top Wins could be farmed.
---------------------------------------------------------------------------------------------
function Rules.summitRewarded(L: LayoutLike, runTop: number, g: number): boolean
	return Rules.isSummit(L, g) and g > runTop
end

-- The summit a stage climbs towards (its own tower's top): 1..100 -> 100, 101..200 -> 200.
function Rules.summitOf(L: LayoutLike, g: number): number
	if g <= 0 then
		return 0
	end
	return math.min(math.ceil(g / L.STAGES), L.TOWERS) * L.STAGES
end

-- runTop after a teleporter trip to `target` (0 = the lobby: progress is kept, nothing changes).
-- Landing below a summit gives up that summit's reward for the rest of the run.
function Rules.runTopAfterTravel(L: LayoutLike, runTop: number, target: number): number
	if target <= 0 then
		return runTop
	end
	return math.max(runTop, Rules.summitOf(L, target))
end

-- Server-wide announcement ("X reached the summit of Tower N!") for a summit EARNED on foot
-- (reason "reach") and paid for the first time in this run. A skip, a teleport or a repeat of a
-- summit already paid this run never broadcasts, so it cannot be spammed. "top" = stage 1000.
function Rules.announceKind(L: LayoutLike, stage: number, rewarded: boolean, reason: string): string?
	if reason ~= "reach" or not rewarded or not Rules.isSummit(L, stage) then
		return nil
	end
	return if stage >= L.TOTAL then "top" else "summit"
end

-- Back-fill for profiles saved before runTop existed: every summit at or below the saved stage
-- was already rewarded in this run.
function Rules.runTopFromStage(L: LayoutLike, stage: number): number
	return math.clamp(stage // L.STAGES, 0, L.TOWERS) * L.STAGES
end

---------------------------------------------------------------------------------------------
-- Studio-only test tools (the free "Skip (Studio test)" buttons). Never in a published game:
-- they need BOTH Studio and an explicit test flag (Config.StudioTestTools, or the Workspace
-- attribute "StudioTestTools" that only test.project.json sets).
---------------------------------------------------------------------------------------------
function Rules.studioTools(isStudio: boolean, configFlag: boolean, workspaceFlag: boolean): boolean
	return isStudio and (configFlag or workspaceFlag)
end

-- Coins for reaching stage g for the first time in a run (5 early, +2 per world, capped).
function Rules.coinsForStage(g: number): number
	return 5 + 2 * math.min(math.max(g, 0) // 10, 25)
end

---------------------------------------------------------------------------------------------
-- HUD: the Skip Stage button
---------------------------------------------------------------------------------------------
export type SkipView = {
	visible: boolean,
	title: string, -- locale key
	sub: string, -- locale key ("" = none)
	free: boolean,
}

-- `productId` = Config.Products.SkipStage (0 = not on sale). The free Studio skip exists ONLY in
-- Studio: with studio = false it is never shown, whatever Config says.
function Rules.skipButton(L: LayoutLike, at: number, onBase: boolean, freeSkips: number, productId: number, studio: boolean, studioFreeSkips: boolean): SkipView
	local possible = Rules.skipTarget(L, at, 1, onBase) ~= nil
	if possible and freeSkips > 0 then
		return { visible = true, title = "hud.free_skip", sub = "hud.skips_left", free = true }
	end
	if possible and productId ~= 0 then
		return { visible = true, title = "hud.skip", sub = "hud.robux", free = false }
	end
	if possible and studio and studioFreeSkips then
		return { visible = true, title = "hud.skip", sub = "hud.studio_test", free = true }
	end
	return { visible = false, title = "hud.skip", sub = "", free = false }
end

function Rules.skip10Visible(L: LayoutLike, at: number, onBase: boolean, productId: number, studio: boolean, studioFreeSkips: boolean): boolean
	return Rules.skipTarget(L, at, 10, onBase) ~= nil and (productId ~= 0 or (studio and studioFreeSkips))
end

---------------------------------------------------------------------------------------------
-- Ranking: a run only counts for Fastest Climb when nothing helped.
---------------------------------------------------------------------------------------------
export type Help = {
	skipped: boolean?, -- any skip (paid, free, ad, coins)
	joinedMidRun: boolean?,
	coil: boolean?, -- speed / gravity coil switched on (pass or timed)
	powerup: boolean?, -- double jump, shield hit absorbed, magnet, pocket checkpoint
	ability: boolean?, -- dash / triple jump
	roam: boolean?, -- glider / cloud
	travelled: boolean?, -- teleporter
}

function Rules.ranked(help: Help): boolean
	for _, v in help :: { [string]: any } do
		if v then
			return false
		end
	end
	return true
end

return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">RunTime</string>
          <string name="Source"><![CDATA[--!strict
-- Speedrun time formatting (pure Luau, unit-tested in tests/p0_test.luau).
local RunTime = {}

-- 754567 -> "12:34.567"; an hour or more -> "1:02:03.004". Negative / nil -> "00:00.000".
function RunTime.format(ms: number?): string
	local v = math.max(0, math.floor(tonumber(ms) or 0))
	local millis = v % 1000
	local totalSec = v // 1000
	local sec = totalSec % 60
	local totalMin = totalSec // 60
	if totalMin >= 60 then
		return ("%d:%02d:%02d.%03d"):format(totalMin // 60, totalMin % 60, sec, millis)
	end
	return ("%02d:%02d.%03d"):format(totalMin, sec, millis)
end

return RunTime
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">Segments</string>
          <string name="Source"><![CDATA[--!strict
-- Keypoint maths for the world-coloured progress bar. PURE Luau (tests/visual_test.luau).
-- Roblox ColorSequence / NumberSequence rules: first keypoint at 0, last at 1, times strictly
-- increasing, at most 20 keypoints.
local Segments = {}

Segments.EPS = 0.001
Segments.MAX_KEYPOINTS = 20

export type ColorStop = { t: number, index: number }
export type ValueStop = { t: number, value: number }

-- n equal hard-edged segments: two keypoints per segment (start and end share segment `index`).
function Segments.colorStops(n: number): { ColorStop }
	n = math.clamp(math.floor(n), 1, Segments.MAX_KEYPOINTS // 2)
	local out: { ColorStop } = {}
	for i = 1, n do
		local a = (i - 1) / n
		local b = i / n
		table.insert(out, { t = a, index = i })
		table.insert(out, { t = if i == n then 1 else b - Segments.EPS, index = i })
	end
	return out
end

-- Transparency that shows the first fraction `p` of a bar and hides the rest, with a hard edge.
function Segments.revealStops(p: number): { ValueStop }
	if p ~= p or p <= Segments.EPS then
		return { { t = 0, value = 1 }, { t = 1, value = 1 } }
	elseif p >= 1 - Segments.EPS then
		return { { t = 0, value = 0 }, { t = 1, value = 0 } }
	end
	p = math.clamp(p, 2 * Segments.EPS, 1 - 2 * Segments.EPS)
	return {
		{ t = 0, value = 0 },
		{ t = p - Segments.EPS, value = 0 },
		{ t = p, value = 1 },
		{ t = 1, value = 1 },
	}
end

return Segments
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">TowerStyle</string>
          <string name="Source"><![CDATA[--!strict
-- The look of each of the ten towers. PURE Luau (colours are {r, g, b} in 0..255).
--
-- The ten world palettes (Grassy Hills ... Rainbow Summit) are defined once here. Every tower
-- plays those ten worlds (in a rotated order, see Layout.themeFor) through its own "mood":
--   * a palette shift baked into the colour of the parts (hue / saturation / value), so the towers
--     look different even with graphics at minimum, where there is no bloom or atmosphere;
--   * a lighting grade applied on top of the world's sky profile (Shared/Ambience).
-- Tower 1 is neutral: it is the original Sky Tower.
local TowerStyle = {}

export type RGB = { number }
export type World = { key: string, platform: RGB, alt: RGB, accent: RGB, pad: RGB, sky: RGB }
export type Mood = {
	key: string, -- locale key suffix: tower.<key>
	hue: number, -- degrees added to the hue of every palette colour
	sat: number, -- saturation multiplier
	val: number, -- value (brightness) multiplier
	core: RGB, -- accent of the tower's core pillar, halos and portal
	clock: number, -- time of day the tower leans towards
	clockMix: number, -- 0 = keep each world's own time, 1 = always `clock`
	bright: number, -- brightness multiplier
	tint: RGB, -- colour-correction tint multiplied in
	haze: RGB, -- atmosphere colour multiplied in
	density: number, -- added to the atmosphere density
	saturation: number, -- added to the colour-correction saturation
	stars: number, -- added to the star count
}

TowerStyle.Worlds = {
	{ key = "world.1", platform = { 125, 220, 95 }, alt = { 185, 140, 90 }, accent = { 255, 230, 90 }, pad = { 90, 220, 255 }, sky = { 170, 220, 255 } },
	{ key = "world.2", platform = { 255, 150, 210 }, alt = { 255, 240, 250 }, accent = { 120, 220, 255 }, pad = { 255, 230, 90 }, sky = { 255, 205, 235 } },
	{ key = "world.3", platform = { 190, 235, 255 }, alt = { 120, 180, 230 }, accent = { 255, 255, 255 }, pad = { 80, 255, 200 }, sky = { 215, 240, 255 } },
	{ key = "world.4", platform = { 235, 200, 130 }, alt = { 190, 140, 80 }, accent = { 80, 200, 220 }, pad = { 255, 150, 60 }, sky = { 255, 225, 170 } },
	{ key = "world.5", platform = { 80, 70, 80 }, alt = { 120, 70, 60 }, accent = { 255, 150, 40 }, pad = { 255, 200, 60 }, sky = { 255, 150, 110 } },
	{ key = "world.6", platform = { 80, 190, 200 }, alt = { 250, 220, 170 }, accent = { 255, 140, 170 }, pad = { 255, 240, 120 }, sky = { 150, 220, 240 } },
	{ key = "world.7", platform = { 120, 130, 140 }, alt = { 170, 230, 60 }, accent = { 255, 220, 40 }, pad = { 170, 255, 60 }, sky = { 200, 230, 170 } },
	{ key = "world.8", platform = { 250, 250, 255 }, alt = { 200, 215, 255 }, accent = { 255, 210, 90 }, pad = { 120, 200, 255 }, sky = { 235, 240, 255 } },
	{ key = "world.9", platform = { 40, 30, 70 }, alt = { 0, 255, 230 }, accent = { 255, 60, 220 }, pad = { 255, 255, 90 }, sky = { 110, 90, 180 } },
	{ key = "world.10", platform = { 255, 210, 80 }, alt = { 255, 150, 120 }, accent = { 120, 160, 255 }, pad = { 255, 255, 255 }, sky = { 255, 240, 200 } },
} :: { World }

TowerStyle.Moods = {
	{ key = "1", hue = 0, sat = 1, val = 1, core = { 255, 205, 70 }, clock = 14.5, clockMix = 0, bright = 1, tint = { 255, 255, 255 }, haze = { 255, 255, 255 }, density = 0, saturation = 0, stars = 0 }, -- Sky
	{ key = "2", hue = 22, sat = 1.05, val = 1, core = { 255, 140, 60 }, clock = 17.6, clockMix = 0.6, bright = 0.95, tint = { 255, 228, 205 }, haze = { 255, 215, 185 }, density = 0.02, saturation = 0.05, stars = 0 }, -- Sunset
	{ key = "3", hue = 215, sat = 0.9, val = 0.82, core = { 120, 150, 255 }, clock = 0.5, clockMix = 0.85, bright = 0.62, tint = { 205, 215, 255 }, haze = { 70, 85, 160 }, density = -0.04, saturation = 0.05, stars = 3500 }, -- Midnight
	{ key = "4", hue = 200, sat = 0.5, val = 0.85, core = { 255, 240, 120 }, clock = 15, clockMix = 0.4, bright = 0.78, tint = { 205, 215, 232 }, haze = { 150, 160, 178 }, density = 0.1, saturation = -0.2, stars = 0 }, -- Storm
	{ key = "5", hue = 165, sat = 0.8, val = 1.08, core = { 120, 245, 255 }, clock = 10, clockMix = 0.4, bright = 1, tint = { 225, 245, 255 }, haze = { 190, 232, 255 }, density = 0, saturation = 0.1, stars = 0 }, -- Crystal
	{ key = "6", hue = -32, sat = 1.12, val = 0.92, core = { 255, 120, 40 }, clock = 17.9, clockMix = 0.6, bright = 0.9, tint = { 255, 212, 190 }, haze = { 225, 120, 80 }, density = 0.05, saturation = 0.08, stars = 300 }, -- Inferno
	{ key = "7", hue = 190, sat = 0.42, val = 1.12, core = { 190, 235, 255 }, clock = 8.2, clockMix = 0.5, bright = 1, tint = { 222, 238, 255 }, haze = { 226, 240, 255 }, density = 0.06, saturation = -0.15, stars = 0 }, -- Frozen
	{ key = "8", hue = 80, sat = 1, val = 0.92, core = { 170, 255, 60 }, clock = 17, clockMix = 0.45, bright = 0.85, tint = { 228, 255, 208 }, haze = { 172, 215, 125 }, density = 0.04, saturation = 0, stars = 0 }, -- Toxic
	{ key = "9", hue = 268, sat = 1.05, val = 0.7, core = { 200, 90, 255 }, clock = 2, clockMix = 0.9, bright = 0.58, tint = { 228, 208, 255 }, haze = { 45, 25, 85 }, density = -0.08, saturation = 0.12, stars = 5000 }, -- Void
	{ key = "10", hue = 305, sat = 0.92, val = 1.08, core = { 255, 255, 255 }, clock = 6.4, clockMix = 0.5, bright = 1, tint = { 255, 240, 246 }, haze = { 255, 218, 228 }, density = 0, saturation = 0.15, stars = 800 }, -- Rainbow
} :: { Mood }

-- Colour of the things that kill you. No palette colour may be mistaken for it (see isDanger).
TowerStyle.KILL = { 255, 30, 40 }

local function toHSV(c: RGB): (number, number, number)
	local r, g, b = c[1] / 255, c[2] / 255, c[3] / 255
	local max, min = math.max(r, g, b), math.min(r, g, b)
	local d = max - min
	local h = 0
	if d > 0 then
		if max == r then
			h = ((g - b) / d) % 6
		elseif max == g then
			h = (b - r) / d + 2
		else
			h = (r - g) / d + 4
		end
		h *= 60
	end
	local s = if max == 0 then 0 else d / max
	return h, s, max
end
TowerStyle.toHSV = toHSV

local function fromHSV(h: number, s: number, v: number): RGB
	h = h % 360
	local c = v * s
	local x = c * (1 - math.abs((h / 60) % 2 - 1))
	local m = v - c
	local r, g, b
	if h < 60 then
		r, g, b = c, x, 0
	elseif h < 120 then
		r, g, b = x, c, 0
	elseif h < 180 then
		r, g, b = 0, c, x
	elseif h < 240 then
		r, g, b = 0, x, c
	elseif h < 300 then
		r, g, b = x, 0, c
	else
		r, g, b = c, 0, x
	end
	return { math.floor((r + m) * 255 + 0.5), math.floor((g + m) * 255 + 0.5), math.floor((b + m) * 255 + 0.5) }
end
TowerStyle.fromHSV = fromHSV

-- A strong red reads as "this kills you": keep it for kill bricks only.
function TowerStyle.isDanger(c: RGB): boolean
	local h, s, v = toHSV(c)
	return (h >= 342 or h <= 14) and s >= 0.6 and v >= 0.6
end

-- One palette colour seen through a tower's mood. Never lands on "danger red": it is pushed
-- to orange instead.
function TowerStyle.shift(c: RGB, mood: Mood): RGB
	local h, s, v = toHSV(c)
	-- near-greys keep their hue (rotating noise would tint white platforms at random)
	local nh = if s < 0.08 then h else (h + mood.hue) % 360
	local out = fromHSV(nh, math.clamp(s * mood.sat, 0, 1), math.clamp(v * mood.val, 0.16, 1))
	if TowerStyle.isDanger(out) then
		local _, s2, v2 = toHSV(out)
		out = fromHSV(28, s2, v2)
	end
	return out
end

function TowerStyle.mood(tower: number): Mood
	return TowerStyle.Moods[math.clamp(math.floor(tower), 1, #TowerStyle.Moods)]
end

-- The five colours of world look `style` (1..10) on tower `tower`.
function TowerStyle.palette(tower: number, style: number): World
	local w = TowerStyle.Worlds[math.clamp(math.floor(style), 1, #TowerStyle.Worlds)]
	local m = TowerStyle.mood(tower)
	return {
		key = w.key,
		platform = TowerStyle.shift(w.platform, m),
		alt = TowerStyle.shift(w.alt, m),
		accent = TowerStyle.shift(w.accent, m),
		pad = TowerStyle.shift(w.pad, m),
		sky = TowerStyle.shift(w.sky, m),
	}
end

return TowerStyle
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="36">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="37">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Sky Tower Obby: server bootstrap. Builds the lobby and the first tower, wires services, handles
-- the player lifecycle. Towers 2..10 are built on demand (Towers.luau).
local Players = game:GetService("Players")

local Data = require(script.Data)
local Remotes = require(script.Remotes)
local Session = require(script.Session)
local StageGenerator = require(script.StageGenerator)
local Obstacles = require(script.Obstacles)
local Towers = require(script.Towers)
local Cosmetics = require(script.Cosmetics)
local Checkpoints = require(script.Checkpoints)
local Shops = require(script.Shops)
local Lounge = require(script.Lounge)
local Monetization = require(script.Monetization)
local Rewards = require(script.Rewards)
local Leaderboard = require(script.Leaderboard)
local Referrals = require(script.Referrals)
local Events = require(script.Events)
local Nametags = require(script.Nametags)

Players.RespawnTime = 1.5

local lobby = StageGenerator.buildLobby()
Obstacles.init()
Cosmetics.init()
Rewards.init()
Checkpoints.init(lobby, function(player, info)
	local p = Data.get(player)
	if p then
		Leaderboard.record(player, p.wins, true)
		if info.newBest and info.runMs then
			Leaderboard.recordFastest(player, info.runMs)
		end
		Data.save(player)
	end
end, function(player, best)
	Leaderboard.recordStage(player, best, best % 100 == 0)
end)
Shops.init()
Lounge.init()
Towers.init() -- builds tower 1 (yields a few frames) and starts the on-demand sweep
Referrals.init()
Events.init()
Nametags.init()
Monetization.init()
Leaderboard.init(lobby.board, lobby.fastBoard, lobby.stageBoard)
Data.startAutosave()

for panel, prompt in lobby.stalls do
	prompt.Triggered:Connect(function(player)
		Remotes.fire("OpenPanel", player, panel)
	end)
end

Remotes.handle("GetState", function(player)
	Session.push(player)
	Events.sendTo(player) -- the join-time LiveEventUpdate can arrive before the client listens
	return true
end)

local function onCharacter(player: Player, char: Model)
	-- CharacterAdded and the "already spawned" path can both fire for the first character
	if char:GetAttribute("SetUp") then
		return
	end
	char:SetAttribute("SetUp", true)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if not root or not Data.get(player) then
		return
	end
	task.wait() -- let the default spawn finish before moving
	local s = Session.get(player)
	if s and s.roam then
		-- died while exploring: explore mode ends with the character
		s.roam = nil
		player:SetAttribute("Roam", nil)
	end
	Checkpoints.teleport(player) -- may build the player's tower first
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.Died:Connect(function()
			Checkpoints.noteDeath(player) -- death streak -> skip offer (P0-1)
		end)
	end
	-- The avatar's body parts and accessories can still be arriving (CharacterAppearanceLoaded
	-- fires after CharacterAdded). Pieces welded to a Head / Torso that the appearance then
	-- replaces are left loose and fall off the character ("disassembled" look), so the welded
	-- extras wait for the full appearance, and are re-applied if a body part is swapped later.
	Cosmetics.applyTrail(player)
	Cosmetics.applyEffect(player)
	Cosmetics.applyCoils(player)
	Session.push(player)
	if not player:HasAppearanceLoaded() then
		local loaded = false
		local conn = player.CharacterAppearanceLoaded:Connect(function()
			loaded = true
		end)
		local t0 = os.clock()
		while not loaded and os.clock() - t0 < 8 and char.Parent and player.Parent do
			task.wait(0.1)
		end
		conn:Disconnect()
	end
	if not char.Parent or player.Character ~= char then
		return
	end
	char:WaitForChild("Head", 5)
	Cosmetics.applyAll(player)
	Nametags.update(player)
	Session.push(player)
	local pendingRefresh = false
	char.ChildAdded:Connect(function(child)
		if pendingRefresh or not (child.Name == "Head" or child.Name == "UpperTorso" or child.Name == "Torso") then
			return
		end
		pendingRefresh = true
		task.delay(0.2, function()
			pendingRefresh = false
			if char.Parent and player.Character == char then
				Cosmetics.applyExtras(player)
				Nametags.update(player)
			end
		end)
	end)
end

local function onPlayerAdded(player: Player)
	Session.start(player)
	player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)
	Data.load(player)
	if not player.Parent then
		return
	end
	Monetization.loadPasses(player)
	local s = Session.get(player)
	local p = Data.get(player)
	if s and p then
		s.loaded = true
		s.at = p.stage
		s.coinStage = p.stage
		-- a session that starts mid-climb can't set a ranked time (P0-2)
		s.run = { start = nil, valid = p.stage == 0 }
		if p.stage ~= 0 then
			s.help.joinedMidRun = true
		end
	end
	Towers.sweep() -- start building the tower this player will need
	Referrals.onJoin(player)
	Session.push(player)
	if not Data.isPersistent(player) then
		Remotes.notify(player, Remotes.M("warn.no_save"), "warn")
	end
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	local p = Data.get(player)
	if p then
		Leaderboard.record(player, p.wins, true)
		Leaderboard.recordStage(player, p.best, true)
	end
	Data.release(player)
	Session.stop(player)
	Remotes.forget(player)
end)

-- Keep clients' play-time counters honest.
task.spawn(function()
	while true do
		task.wait(60)
		Session.pushAll()
	end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">Checkpoints</string>
          <string name="Source"><![CDATA[--!strict
-- Progress through the 1,000 stages: checkpoints (saving pads and rest pads), respawning,
-- fall-catching, skips, summits (win, gift, portal to the next tower) and rebirth.
-- The rules themselves are in Shared/Rules (pure, unit-tested); this module applies them.
-- Anti-exploit: checkpoints must be reached in order (at most Config.MaxStageJump ahead, never
-- across a portal), the character must really be standing near the pad, and only the server ever
-- changes stage / coins.
local BadgeService = game:GetService("BadgeService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Rules = require(ReplicatedStorage.Shared.Rules)
local Gifts = require(ReplicatedStorage.Shared.Gifts)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local Session = require(script.Parent.Session)
local StageGenerator = require(script.Parent.StageGenerator)
local Towers = require(script.Parent.Towers)
local Referrals = require(script.Parent.Referrals)
local Cosmetics = require(script.Parent.Cosmetics)

local Checkpoints = {}

local L = Layout :: any
local lobbySpawn = CFrame.new(0, 4, 115)
export type WinInfo = { runMs: number?, newBest: boolean }
local onWin: ((Player, WinInfo) -> ())? = nil
local onBest: ((Player, number) -> ())? = nil
local MIN_SECONDS_PER_CHECKPOINT = 0.8

local function awardBadge(player: Player, badgeId: number)
	if badgeId == 0 then
		return
	end
	task.spawn(function()
		local ok, has = pcall(function()
			return BadgeService:UserHasBadgeAsync(player.UserId, badgeId)
		end)
		if ok and not has then
			pcall(function()
				BadgeService:AwardBadge(player.UserId, badgeId)
			end)
		end
	end)
end

-- The highest pad the player holds right now.
local function atOf(p: Data.Profile, s: Session.S): number
	return math.max(s.at, p.stage)
end

local function pocketOf(p: Data.Profile, s: Session.S): CFrame?
	local pk = p.pocket
	if pk and pk.stage == p.stage and p.stage > 0 and not s.inLobby then
		return CFrame.new(pk.x, pk.y, pk.z)
	end
	return nil
end

-- Where the character is put for the saved checkpoint. Builds the tower if needed (may yield).
function Checkpoints.spawnCFrame(player: Player): CFrame
	local p = Data.get(player)
	local s = Session.get(player)
	if not p or not s then
		return lobbySpawn
	end
	local pocket = pocketOf(p, s)
	if pocket then
		return pocket
	end
	local spot = Rules.spawn(L, p.stage, s.inLobby, p.base)
	if not spot then
		return lobbySpawn
	end
	return Towers.standing(spot)
end

-- Puts the character on its checkpoint (after a death, a fall, a skip, a portal...). Yields while
-- a tower is built or the destination streams in.
function Checkpoints.teleport(player: Player)
	local cf = Checkpoints.spawnCFrame(player)
	pcall(function()
		player:RequestStreamAroundAsync(cf.Position, 4)
	end)
	local p = Data.get(player)
	local s = Session.get(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not p or not s or not char or not root then
		return
	end
	-- back on the checkpoint: progress since the last save is lost (pocket checkpoints keep it)
	local pk = p.pocket
	s.at = if pk and pk.stage == p.stage and not s.inLobby then math.max(pk.at, p.stage) else p.stage
	-- the spawn CFrames put a default R15 root 3.5 studs over the floor; taller avatars (bigger
	-- HipHeight) are lifted so their feet never start inside the pad / spawn
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum and hum.RigType == Enum.HumanoidRigType.R15 then
		local lift = hum.HipHeight + root.Size.Y / 2 - 3
		if lift > 0 then
			cf += Vector3.new(0, lift, 0)
		end
	end
	root.AssemblyLinearVelocity = Vector3.zero
	char:PivotTo(cf)
end

local function grantGift(player: Player, p: Data.Profile, gift: Gifts.Gift)
	p.gifts[tostring(gift.id)] = true
	if gift.kind == "trail" then
		p.trails[gift.value :: string] = true
	elseif gift.kind == "effect" then
		p.effects[gift.value :: string] = true
	elseif gift.kind == "skin" then
		p.perks.glow = "glow_rainbow"
	end
	Remotes.fire("Gift", player, { id = gift.id, stage = gift.stage })
	Cosmetics.applyAll(player)
end

-- Moves the player's progress to pad `g` (already validated) and rewards new progress.
-- reason "reach" = walked onto it; anything else (skip, freeSkip, ad, coins) saves there.
local function advanceTo(player: Player, g: number, reason: string)
	local p = Data.get(player)
	local s = Session.get(player)
	if not p or not s then
		return
	end
	local from = atOf(p, s)
	if g <= from then
		return
	end
	g = math.min(g, Layout.TOTAL)
	-- speedrun: the run starts on leaving stage 0; anything that helps makes it unranked
	local run = s.run
	if from == 0 and run.start == nil then
		-- what happened before leaving stage 0 (a power-up bought and already expired, explore
		-- mode switched off again...) is not part of the run: only what is still on counts
		if not s.help.joinedMidRun then
			s.help = {}
			run.valid = true
		end
		run.start = Workspace:GetServerTimeNow()
		Session.refreshHelp(player)
	end
	if reason ~= "reach" then
		Session.assist(player, "skipped")
	end
	s.deaths = { stage = g, count = 0 }
	local coins = 0
	for stage = from + 1, g do
		if stage > s.coinStage then
			coins += Session.addCoins(player, Rules.coinsForStage(stage))
		end
	end
	s.coinStage = math.max(s.coinStage, g)
	s.at = g
	local save = reason ~= "reach" or Layout.isSave(g)
	if save then
		p.stage = g
		p.base = false
		p.pocket = nil
	end
	local isBest = g > p.best
	p.best = math.max(p.best, g)
	s.lastCheckpointAt = os.clock()
	s.inLobby = false
	local summit = Rules.isSummit(L, g)
	local newWorld = (g // 10) > (from // 10) and not summit
	Remotes.fire("Celebrate", player, {
		stage = g,
		coins = coins,
		reason = reason,
		save = save,
		world = if newWorld then g // 10 + 1 else nil,
		style = if newWorld then Layout.themeFor(g + 1) else nil,
	})
	if g >= 50 and from < 50 then
		awardBadge(player, Config.BadgeIds.Stage50)
	end
	Referrals.onStage(player, g)
	-- notification opt-in: first world change (stage 10) or a summit, at most once a week
	if ((from < 10 and g >= 10) or summit) and os.time() - p.notifAskedAt > Config.NotifyAskCooldown then
		p.notifAskedAt = os.time()
		Remotes.fire("AskNotifications", player)
	end
	if summit then
		local tower = g // Layout.STAGES
		-- the win and the summit bonus are paid once per summit per run (Rules.summitRewarded):
		-- a teleport to the world under a summit, or a rejoin, can't farm them
		local rewarded = Rules.summitRewarded(L, p.runTop, g)
		if rewarded then
			p.runTop = g
			Session.addCoins(player, Config.CoinsPerTower)
		end
		-- server-wide shout-out for a summit earned on foot (the others see it, not the climber)
		local kind = Rules.announceKind(L, g, rewarded, reason)
		if kind then
			local msg = if kind == "top"
				then Remotes.M("msg.announce_top", { name = player.DisplayName })
				else Remotes.M("msg.announce_summit", { name = player.DisplayName, tower = { key = "tower." .. tostring(tower) } })
			for _, other in Players:GetPlayers() do
				if other ~= player then
					Remotes.notify(other, msg, "info")
				end
			end
		end
		local gift = Gifts.at(g)
		local newGift = gift ~= nil and not p.gifts[tostring(gift.id)]
		if gift and newGift then
			grantGift(player, p, gift)
		end
		local info: WinInfo = { runMs = nil, newBest = false }
		if tower == 1 and rewarded then
			p.wins += 1
			awardBadge(player, Config.BadgeIds.Winner)
			if p.wins == 1 and p.equippedTrail == "" then
				p.equippedTrail = "rebirth"
			end
			if run.start and run.valid then
				local ms = math.floor((Workspace:GetServerTimeNow() - run.start) * 1000)
				run.finalMs = ms
				info.runMs = ms
				if p.bestRunMs == 0 or ms < p.bestRunMs then
					p.bestRunMs = ms
					info.newBest = true
				end
			elseif run.start then
				run.finalMs = math.floor((Workspace:GetServerTimeNow() - run.start) * 1000)
			end
		end
		Remotes.fire("Win", player, {
			tower = tower,
			wins = p.wins,
			runMs = info.runMs,
			newBest = info.newBest,
			best = p.bestRunMs,
			gift = if newGift and gift then gift.id else nil,
		})
		if tower == 1 and rewarded and onWin then
			onWin(player, info)
		end
	end
	if isBest and onBest then
		onBest(player, p.best)
	end
	Session.push(player)
end

-- Returns "ok", "ignore" (never counts) or "retry" (might count a moment later: cooldown, or the
-- server hasn't seen the character arrive yet - Touched can fire before the replicated position).
function Checkpoints.reach(player: Player, g: number): string
	local p = Data.get(player)
	local s = Session.get(player)
	if not p or not s then
		return "ignore"
	end
	if s.roam then
		return "ignore" -- explore mode (glider / cloud): pads don't count
	end
	if g == p.stage and s.inLobby then
		s.inLobby = false -- walked back to their pad
		return "ok"
	end
	if not Rules.canReach(L, atOf(p, s), g, Config.MaxStageJump, p.base) then
		return "ignore" -- behind, too far ahead, or on the other side of a portal
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health <= 0 then
		return "ignore"
	end
	if os.clock() - s.lastCheckpointAt < MIN_SECONDS_PER_CHECKPOINT then
		return "retry"
	end
	local pad = Towers.pad(g)
	if not pad then
		return "ignore"
	end
	local d = root.Position - pad.Position
	if Vector3.new(d.X, 0, d.Z).Magnitude > Config.CheckpointTouchRadius or d.Y < -3 or d.Y > 12 then
		return "retry"
	end
	advanceTo(player, g, "reach")
	return "ok"
end

-- A player standing still on a pad does not fire Touched again, so a touch that was too early
-- (cooldown / position not replicated yet) is re-checked for a couple of seconds.
local pending: { [Player]: { [number]: boolean } } = {}
local function onPadTouched(player: Player, k: number)
	if Checkpoints.reach(player, k) ~= "retry" then
		return
	end
	local mine = pending[player]
	if not mine then
		mine = {}
		pending[player] = mine
	end
	if mine[k] then
		return
	end
	mine[k] = true
	task.spawn(function()
		for _ = 1, 10 do
			task.wait(0.25)
			if not player.Parent or Checkpoints.reach(player, k) ~= "retry" then
				break
			end
		end
		mine[k] = nil
	end)
end

local busy: { [Player]: boolean } = {} -- a teleport / portal is in flight
Players.PlayerRemoving:Connect(function(player)
	pending[player] = nil
	busy[player] = nil
end)

local function teleportAsync(player: Player)
	if busy[player] then
		return
	end
	busy[player] = true
	task.spawn(function()
		local ok, err = (pcall :: any)(Checkpoints.teleport, player)
		busy[player] = nil
		if not ok then
			warn("[Checkpoints] teleport failed:", err)
		end
	end)
end
Checkpoints.teleportAsync = teleportAsync

-- Paid / free / coin skips. Returns false when there is nothing to skip (summit before the
-- portal, or stage 1000). A skip never crosses a portal.
function Checkpoints.skip(player: Player, n: number, reason: string): boolean
	local p = Data.get(player)
	local s = Session.get(player)
	if not p or not s then
		return false
	end
	local target = Rules.skipTarget(L, atOf(p, s), n, p.base)
	if not target then
		return false
	end
	advanceTo(player, target, reason)
	teleportAsync(player)
	return true
end

function Checkpoints.canSkip(player: Player): boolean
	local p = Data.get(player)
	local s = Session.get(player)
	return p ~= nil and s ~= nil and Rules.skipTarget(L, atOf(p, s), 1, p.base) ~= nil
end

-- Back to stage 0 for a new ranked run. Everything earned (best stage, gifts, coins, wins) stays,
-- and the lounge teleporter still reaches every world already visited.
function Checkpoints.rebirth(player: Player): (boolean, any?)
	local p = Data.get(player)
	local s = Session.get(player)
	if not p or not s then
		return false, nil
	end
	if atOf(p, s) < Layout.STAGES then
		return false, Remotes.M("err.reach_100")
	end
	p.stage = 0
	p.base = false
	p.runTop = 0
	p.pocket = nil
	s.at = 0
	s.coinStage = 0
	s.collected = {}
	s.inLobby = false
	s.roam = nil
	player:SetAttribute("Roam", nil)
	s.run = { start = nil, valid = true }
	s.help = {}
	s.deaths = { stage = 0, count = 0 }
	Session.push(player)
	teleportAsync(player)
	local c = Config.RebirthColors[((math.max(p.wins, 1) - 1) % #Config.RebirthColors) + 1]
	Remotes.notify(player, Remotes.M("msg.rebirth", { n = p.wins }), "success")
	player:SetAttribute("RebirthColor", c)
	if p.wins == 1 then
		awardBadge(player, Config.BadgeIds.FirstRebirth)
	end
	return true
end

-- A death or a fall on the current stage. Every Config.SkipOfferAfterDeaths in a row (and at most
-- once per Config.SkipOfferCooldown) the client gets an OfferSkip card.
function Checkpoints.noteDeath(player: Player)
	local p = Data.get(player)
	local s = Session.get(player)
	if not p or not s or s.inLobby or Rules.skipTarget(L, p.stage, 1, p.base) == nil then
		return
	end
	if s.deaths.stage ~= p.stage then
		s.deaths = { stage = p.stage, count = 0 }
	end
	s.deaths.count += 1
	local n = s.deaths.count
	if n % Config.SkipOfferAfterDeaths == 0 and os.clock() - s.lastOfferAt >= Config.SkipOfferCooldown then
		s.lastOfferAt = os.clock()
		Remotes.fire("OfferSkip", player, { stage = p.stage + 1, freeSkips = p.freeSkips, adAvailableHint = true })
	end
end

-- The portal at the summit of `tower`: on to the base of the next one. Open for anybody who has
-- ever reached that summit.
local lastPortal: { [Player]: number } = {}
function Checkpoints.enterPortal(player: Player, tower: number): boolean
	local p = Data.get(player)
	local s = Session.get(player)
	if not p or not s or busy[player] then
		return false
	end
	if os.clock() - (lastPortal[player] or 0) < 2 then
		return false
	end
	lastPortal[player] = os.clock()
	if not Rules.portalOpen(L, p.best, tower) then
		Remotes.notify(player, Remotes.M("err.portal_locked", { n = tower * Layout.STAGES }), "info")
		return false
	end
	local summit = tower * Layout.STAGES
	if p.stage ~= summit then
		Session.assist(player, "travelled") -- came here by the teleporter / exploring
	end
	p.stage = summit
	p.base = true
	p.pocket = nil
	s.at = summit
	s.inLobby = false
	s.roam = nil
	player:SetAttribute("Roam", nil)
	busy[player] = true
	task.spawn(function()
		local ok, err = pcall(function()
			Towers.ensure(tower + 1)
			Checkpoints.teleport(player)
		end)
		busy[player] = nil
		if not ok then
			warn("[Checkpoints] portal failed:", err)
		end
		Remotes.fire("TowerEnter", player, { tower = tower + 1 })
		Session.push(player)
	end)
	return true
end

function Checkpoints.goToLobby(player: Player): boolean
	local s = Session.get(player)
	if not s then
		return false
	end
	s.inLobby = true
	s.roam = nil
	player:SetAttribute("Roam", nil)
	teleportAsync(player)
	Session.push(player)
	return true
end

-- Lounge teleporter: `stage` is a world start already reached (validated by the caller).
function Checkpoints.travel(player: Player, stage: number)
	local p = Data.get(player)
	local s = Session.get(player)
	if not p or not s then
		return
	end
	if stage <= 0 then
		Checkpoints.goToLobby(player) -- never "travel" to stage 0: that would wipe the checkpoint
		return
	end
	Session.assist(player, "travelled")
	p.runTop = Rules.runTopAfterTravel(L, p.runTop, stage)
	p.stage = stage
	p.base = false
	p.pocket = nil
	s.at = stage
	s.inLobby = false
	s.roam = nil
	player:SetAttribute("Roam", nil)
	s.deaths = { stage = stage, count = 0 }
	Session.push(player)
	teleportAsync(player)
end

function Checkpoints.init(lobby: StageGenerator.Lobby, winCallback: (Player, WinInfo) -> (), bestCallback: (Player, number) -> ())
	lobbySpawn = lobby.lobbySpawn
	onWin = winCallback
	onBest = bestCallback

	Towers.onBuilt(function(tower)
		for g, pad in tower.pads do
			pad.Touched:Connect(function(hit)
				local model = hit:FindFirstAncestorOfClass("Model")
				local player = model and Players:GetPlayerFromCharacter(model)
				if player then
					onPadTouched(player, g)
				end
			end)
		end
		local portal = tower.portal
		if portal then
			portal.Touched:Connect(function(hit)
				local model = hit:FindFirstAncestorOfClass("Model")
				local player = model and Players:GetPlayerFromCharacter(model)
				local p = player and Data.get(player)
				local s = player and Session.get(player)
				-- walking into it must never move progress by accident (explore mode, or a
				-- checkpoint further up than this summit): the prompt / HUD button still work
				if player and p and s and Rules.portalTouchAllowed(L, p.stage, tower.tower, s.roam ~= nil) then
					Checkpoints.enterPortal(player, tower.tower)
				end
			end)
		end
		for _, pr in tower.prompts do
			if pr.kind == "rebirth" then
				pr.prompt.Triggered:Connect(function(player)
					local p = Data.get(player)
					if p and p.best >= Layout.STAGES then
						Remotes.fire("OpenPanel", player, "win")
					end
				end)
			elseif pr.kind == "portal" then
				pr.prompt.Triggered:Connect(function(player)
					Checkpoints.enterPortal(player, tower.tower)
				end)
			elseif pr.kind == "home" then
				pr.prompt.Triggered:Connect(function(player)
					Checkpoints.goToLobby(player)
				end)
			end
		end
	end)

	Remotes.handle("ReturnToCheckpoint", function(player)
		local s = Session.get(player)
		if s then
			s.inLobby = false
		end
		teleportAsync(player)
		return true
	end)
	Remotes.handle("GoToLobby", function(player)
		return Checkpoints.goToLobby(player)
	end)
	Remotes.handle("Rebirth", function(player)
		return Checkpoints.rebirth(player)
	end)
	Remotes.handle("EnterPortal", function(player)
		-- HUD button on a summit: same as walking into the portal
		local p = Data.get(player)
		local s = Session.get(player)
		if not p or not s or not Rules.isSummit(L, p.stage) or p.base then
			return false, Remotes.M("err.not_available")
		end
		return Checkpoints.enterPortal(player, p.stage // Layout.STAGES)
	end)
	Remotes.handle("UseFreeSkip", function(player)
		local p = Data.get(player)
		if not p or p.freeSkips <= 0 then
			return false, Remotes.M("err.no_free_skips")
		end
		if not Checkpoints.canSkip(player) then
			return false, Remotes.M("err.at_top")
		end
		p.freeSkips -= 1
		Checkpoints.skip(player, 1, "freeSkip")
		return true
	end)
	-- Studio-only: product IDs are 0 while developing, so let the Skip button work for free.
	Remotes.handle("DevSkip", function(player, payload)
		if not Session.studioTools() then
			return false, Remotes.M("err.not_available")
		end
		local n = if payload.n == 10 then 10 else 1
		return Checkpoints.skip(player, n, "skip")
	end)

	-- Fall catcher: far below your last pad => back to the checkpoint (no death). Only the living:
	-- a dead body sliding off the pad is already counted by Humanoid.Died.
	task.spawn(function()
		while true do
			task.wait(0.25)
			for _, player in Players:GetPlayers() do
				local p = Data.get(player)
				local s = Session.get(player)
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if p and s and root and hum and hum.Health > 0 and not s.inLobby and not s.roam and not busy[player] then
					local at = atOf(p, s)
					local floorY: number? = nil
					if at > 0 then
						local spot = Rules.spawn(L, at, false, p.base and Rules.isSummit(L, at))
						local tower = spot and Towers.get(spot.tower)
						if spot and tower then
							floorY = if spot.pad == 0 then tower.baseCFrame.Position.Y else (tower.padCFrames[at] or tower.baseCFrame).Position.Y
						end
					end
					local pk = p.pocket
					if floorY and pk and pk.stage == p.stage then
						floorY = math.min(floorY, pk.y)
					end
					if floorY and root.Position.Y < floorY - Config.FallLimit then
						Checkpoints.noteDeath(player)
						teleportAsync(player)
					end
				end
			end
		end
	end)
end

return Checkpoints
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">Cosmetics</string>
          <string name="Source"><![CDATA[--!strict
-- Trails, effects, coils (speed / gravity) and the coins shop. All prices and ownership are
-- checked on the server; the client only asks.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Perks = require(ReplicatedStorage.Shared.Perks)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local Session = require(script.Parent.Session)

local Cosmetics = {}

local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"

local trailById: { [string]: Config.Trail } = {}
for _, t in Config.Trails do
	trailById[t.id] = t
end
local effectById: { [string]: Config.Effect } = {}
for _, e in Config.Effects do
	effectById[e.id] = e
end

local function colorSeq(colors: { Color3 }): ColorSequence
	if #colors == 1 then
		return ColorSequence.new(colors[1])
	end
	local kps = {}
	for i, c in colors do
		table.insert(kps, ColorSequenceKeypoint.new((i - 1) / (#colors - 1), c))
	end
	return ColorSequence.new(kps)
end

local function clearTagged(char: Model, name: string)
	for _, d in char:GetDescendants() do
		if d.Name == name then
			d:Destroy()
		end
	end
end

local function trailColors(player: Player, p: Data.Profile): { Color3 }?
	local id = p.equippedTrail
	if id == "rebirth" then
		if p.wins <= 0 then
			return nil
		end
		local c = Config.RebirthColors[((p.wins - 1) % #Config.RebirthColors) + 1]
		return { c, c:Lerp(Color3.new(1, 1, 1), 0.5) }
	end
	local t = trailById[id]
	if not t then
		return nil
	end
	if t.pass and not Session.hasPass(player, t.pass) then
		return nil
	end
	if not t.pass and not p.trails[id] then
		return nil
	end
	return t.colors
end

function Cosmetics.applyTrail(player: Player)
	local char = player.Character
	local p = Data.get(player)
	if not char or not p then
		return
	end
	clearTagged(char, "SkyTrail")
	clearTagged(char, "SkyTrailA0")
	clearTagged(char, "SkyTrailA1")
	local colors = trailColors(player, p)
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not colors or not root then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Name = "SkyTrailA0"
	a0.Position = Vector3.new(0, 0.9, 0)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Name = "SkyTrailA1"
	a1.Position = Vector3.new(0, -0.9, 0)
	a1.Parent = root
	local trail = Instance.new("Trail")
	trail.Name = "SkyTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = colorSeq(colors)
	trail.Lifetime = 0.6
	trail.LightEmission = 0.6
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.WidthScale = NumberSequence.new(1, 0.2)
	trail.FaceCamera = true
	trail.Parent = root
end

function Cosmetics.applyEffect(player: Player)
	local char = player.Character
	local p = Data.get(player)
	if not char or not p then
		return
	end
	clearTagged(char, "SkyEffect")
	local e = effectById[p.equippedEffect]
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not e or not root or not p.effects[e.id] then
		return
	end
	local inst: Instance
	if e.kind == "Sparkles" then
		local s = Instance.new("Sparkles")
		s.SparkleColor = e.color
		inst = s
	elseif e.kind == "Smoke" then
		local s = Instance.new("Smoke")
		s.Color = e.color
		s.Opacity = 0.15
		s.RiseVelocity = 2
		s.Size = 0.8
		inst = s
	elseif e.kind == "Fire" then
		local f = Instance.new("Fire")
		f.Color = e.color
		f.SecondaryColor = Color3.fromRGB(255, 230, 90)
		f.Size = 3
		f.Heat = 6
		inst = f
	else
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = SPARKLES
		pe.Color = ColorSequence.new(e.color)
		pe.Rate = 14
		pe.Lifetime = NumberRange.new(0.8, 1.4)
		pe.Speed = NumberRange.new(1, 3)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Size = NumberSequence.new(0.5, 0)
		pe.LightEmission = 1
		inst = pe
	end
	inst.Name = "SkyEffect"
	inst.Parent = root
end

-- Speed coil: WalkSpeed. Gravity coil: a VectorForce cancelling part of gravity.
-- (The character is simulated by its owner's client; forces/properties created here replicate.)
function Cosmetics.applyCoils(player: Player)
	local char = player.Character
	local p = Data.get(player)
	if not char or not p then
		return
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hum or not root then
		return
	end
	-- the classic obby jump, whatever the avatar or the place defaults say
	hum.UseJumpPower = true
	hum.JumpPower = Config.JumpPower
	hum.WalkSpeed = if Session.speedOn(player, p) then Config.SpeedCoilWalkSpeed else Config.WalkSpeed
	-- abilities run on the owner's client; these attributes tell it what it may do
	player:SetAttribute("AirJumps", Session.airJumps(player, p))
	player:SetAttribute("Dash", Perks.unlocked(p.best) and p.perks.dash == true)
	clearTagged(char, "GravityCoil")
	if Session.gravityOn(player, p) then
		local att = Instance.new("Attachment")
		att.Name = "GravityCoil"
		att.Parent = root
		local vf = Instance.new("VectorForce")
		vf.Name = "GravityCoil"
		vf.Attachment0 = att
		vf.RelativeTo = Enum.ActuatorRelativeTo.World
		vf.ApplyAtCenterOfMass = true
		local mass = root.AssemblyMass
		vf.Force = Vector3.new(0, mass * Workspace.Gravity * (1 - Config.GravityCoilFactor), 0)
		vf.Parent = root
	end
end

local function weldTo(part: BasePart, to: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = false
	local w = Instance.new("WeldConstraint")
	w.Part0 = to
	w.Part1 = part
	w.Parent = part
end

local function bit(parent: Instance, shape: Enum.PartType, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, to: BasePart): Part
	local p = Instance.new("Part")
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	-- weld (unanchored, massless, no collision) BEFORE it enters the character: a bare Part in a
	-- character for even one physics step can push or trip the avatar
	weldTo(p, to)
	p.Parent = parent
	return p
end

-- Gift cosmetics worn by the character: the shoulder cloud (stage 200), the crown (stage 1000)
-- and the body glow picked in the Winner's Lounge (or the rainbow glow of stage 700).
function Cosmetics.applyExtras(player: Player)
	local char = player.Character
	local p = Data.get(player)
	if not char or not p then
		return
	end
	for _, name in { "SkyPet", "SkyCrown", "SkyGlow" } do
		local old = char:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	local torso = (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")) :: BasePart?
	local head = char:FindFirstChild("Head") :: BasePart?
	if p.gifts["2"] and torso then
		local pet = Instance.new("Model")
		pet.Name = "SkyPet"
		pet.Parent = char
		local at = torso.CFrame * CFrame.new(1.7, 1.7, 0.2)
		local white = Color3.fromRGB(255, 255, 255)
		bit(pet, Enum.PartType.Ball, Vector3.new(1.1, 1.1, 1.1), at, white, Enum.Material.SmoothPlastic, torso)
		bit(pet, Enum.PartType.Ball, Vector3.new(0.8, 0.8, 0.8), at * CFrame.new(-0.5, -0.12, 0), white, Enum.Material.SmoothPlastic, torso)
		bit(pet, Enum.PartType.Ball, Vector3.new(0.8, 0.8, 0.8), at * CFrame.new(0.5, -0.12, 0), white, Enum.Material.SmoothPlastic, torso)
		for _, x in { -0.2, 0.2 } do
			bit(pet, Enum.PartType.Ball, Vector3.new(0.16, 0.16, 0.16), at * CFrame.new(x, 0.08, -0.52), Color3.fromRGB(40, 40, 60), Enum.Material.SmoothPlastic, torso)
		end
	end
	if p.gifts["10"] and head then
		local crown = Instance.new("Model")
		crown.Name = "SkyCrown"
		crown.Parent = char
		local gold = Color3.fromRGB(255, 205, 70)
		local at = head.CFrame * CFrame.new(0, head.Size.Y / 2 + 0.2, 0)
		bit(crown, Enum.PartType.Cylinder, Vector3.new(0.35, 1.5, 1.5), at * CFrame.Angles(0, 0, math.pi / 2), gold, Enum.Material.Neon, head)
		for i = 0, 4 do
			local a = i / 5 * math.pi * 2
			bit(crown, Enum.PartType.Block, Vector3.new(0.26, 0.6, 0.26), at * CFrame.new(math.cos(a) * 0.62, 0.42, math.sin(a) * 0.62), gold, Enum.Material.Neon, head)
		end
	end
	local glow = Perks.get(tostring(p.perks.glow or ""))
	if glow and glow.kind == "glow" and Perks.unlocked(p.best) and (not glow.gift or p.gifts[tostring(glow.gift)]) then
		local c = glow.color or { 255, 255, 255 }
		local h = Instance.new("Highlight")
		h.Name = "SkyGlow"
		h.FillColor = Color3.fromRGB(c[1], c[2], c[3])
		h.OutlineColor = Color3.fromRGB(c[1], c[2], c[3])
		h.FillTransparency = 0.72
		h.OutlineTransparency = 0.05
		h.DepthMode = Enum.HighlightDepthMode.Occluded
		h:SetAttribute("Rainbow", glow.id == "glow_rainbow") -- clients cycle the hue
		h.Parent = char
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:SetAttribute("JumpFx", if Perks.unlocked(p.best) then tostring(p.perks.jumpfx or "") else "")
	end
end

function Cosmetics.applyAll(player: Player)
	Cosmetics.applyTrail(player)
	Cosmetics.applyEffect(player)
	Cosmetics.applyCoils(player)
	Cosmetics.applyExtras(player)
	player:SetAttribute("VIP", Session.hasPass(player, "VIP"))
end

function Cosmetics.init()
	Remotes.handle("BuyTrail", function(player, payload)
		local p = Data.get(player)
		local t = trailById[tostring(payload.id)]
		if not p or not t or t.pass or t.exclusive then
			return false, Remotes.M("err.not_for_sale")
		end
		if p.trails[t.id] then
			return false, Remotes.M("err.already_owned")
		end
		if p.coins < t.price then
			return false, Remotes.M("err.not_enough_coins")
		end
		p.coins -= t.price
		p.trails[t.id] = true
		p.equippedTrail = t.id
		Cosmetics.applyTrail(player)
		Session.push(player)
		return true, Remotes.M("msg.bought_trail", { name = Remotes.M("trail." .. t.id) })
	end)
	Remotes.handle("EquipTrail", function(player, payload)
		local p = Data.get(player)
		if not p then
			return false
		end
		local id = tostring(payload.id or "")
		if id ~= "" and id ~= "rebirth" then
			local t = trailById[id]
			if not t then
				return false, Remotes.M("err.unknown_trail")
			end
			if t.pass and not Session.hasPass(player, t.pass) then
				return false, Remotes.M("err.requires_pass", { pass = Remotes.M("store." .. t.pass .. ".name") })
			end
			if not t.pass and not p.trails[id] then
				return false, Remotes.M("err.not_owned")
			end
		elseif id == "rebirth" and p.wins <= 0 then
			return false, Remotes.M("err.win_once")
		end
		p.equippedTrail = if p.equippedTrail == id then "" else id
		Cosmetics.applyTrail(player)
		Session.push(player)
		return true
	end)
	Remotes.handle("BuyEffect", function(player, payload)
		local p = Data.get(player)
		local e = effectById[tostring(payload.id)]
		if not p or not e or e.exclusive then
			return false, Remotes.M("err.not_for_sale")
		end
		if p.effects[e.id] then
			return false, Remotes.M("err.already_owned")
		end
		if p.coins < e.price then
			return false, Remotes.M("err.not_enough_coins")
		end
		p.coins -= e.price
		p.effects[e.id] = true
		p.equippedEffect = e.id
		Cosmetics.applyEffect(player)
		Session.push(player)
		return true, Remotes.M("msg.bought", { name = Remotes.M("effect." .. e.id) })
	end)
	Remotes.handle("EquipEffect", function(player, payload)
		local p = Data.get(player)
		if not p then
			return false
		end
		local id = tostring(payload.id or "")
		if id ~= "" and not p.effects[id] then
			return false, Remotes.M("err.not_owned")
		end
		p.equippedEffect = if p.equippedEffect == id then "" else id
		Cosmetics.applyEffect(player)
		Session.push(player)
		return true
	end)
	Remotes.handle("SetLanguage", function(player, payload)
		local p = Data.get(player)
		if not p then
			return false
		end
		local lang = tostring(payload.lang or "")
		if lang ~= "" and not Locale.isSupported(lang) then
			return false, Remotes.M("err.bad_language")
		end
		p.lang = lang
		Session.push(player)
		return true
	end)
	Remotes.handle("SetSetting", function(player, payload)
		local p = Data.get(player)
		if not p then
			return false
		end
		local key = payload.key
		-- "effects" (glow, particles, camera kicks) is applied by each client from the State push
		if key ~= "speedCoil" and key ~= "gravityCoil" and key ~= "effects" then
			return false, Remotes.M("err.unknown_setting")
		end
		(p.settings :: any)[key] = payload.value == true
		Cosmetics.applyCoils(player)
		Session.refreshHelp(player) -- a coil switched on mid-run makes the run assisted
		Session.push(player)
		return true
	end)
end

return Cosmetics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">Data</string>
          <string name="Source"><![CDATA[--!strict
-- Player profiles: DataStore load/save with a soft session lock, reconcile, autosave and BindToClose.
-- (Adapted from the huerta-tycoon Data service.)
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Gifts = require(ReplicatedStorage.Shared.Gifts)
local Powerups = require(ReplicatedStorage.Shared.Powerups)
local Rules = require(ReplicatedStorage.Shared.Rules)

local Data = {}

export type Profile = {
	version: number,
	stage: number, -- saved checkpoint, 0..1000 (0 = lobby start)
	best: number, -- highest stage ever reached
	base: boolean, -- on a summit (stage 100, 200...): already took the portal to the next tower
	runTop: number, -- highest summit already rewarded in this run (Rules.summitRewarded; 0 after a rebirth)
	gifts: { [string]: boolean }, -- tower gifts owned, by gift id ("1".."10", Shared/Gifts)
	boosts: { [string]: number }, -- shop power-ups: id -> os.time() when it ends (Shared/Powerups)
	charges: { [string]: number }, -- shop charges: shield, pocket
	perks: { [string]: any }, -- Winner's Lounge: taken[id] = true, plus dash / triplejump (on/off), glow, jumpfx
	pocket: { stage: number, at: number, x: number, y: number, z: number }?, -- portable checkpoint
	wins: number,
	coins: number,
	totalCoins: number,
	freeSkips: number,
	trails: { [string]: boolean },
	equippedTrail: string, -- "" = none, "rebirth" = rebirth colour
	effects: { [string]: boolean },
	equippedEffect: string,
	settings: { speedCoil: boolean, gravityCoil: boolean, effects: boolean },
	lang: string, -- "" = follow the account locale; else a Locale.LANGS code
	bestRunMs: number, -- fastest valid climb 0 -> 100 (0 = none)
	ads: { day: number, count: number }, -- rewarded-video skips watched today (UTC day number)
	referredBy: number, -- inviter UserId (0 = none)
	referralPaid: boolean, -- inviter already credited for this player
	referralRewards: number, -- rewards received as an inviter (capped)
	starterBought: boolean,
	boostEndsAt: number, -- os.time() when the x2 coins boost ends
	groupGiftClaimed: boolean,
	notifAskedAt: number,
	purchases: { string }, -- recent processed receipt ids (idempotent ProcessReceipt)
	daily: { lastClaim: number, streak: number },
	codes: { [string]: boolean },
	savedAt: number,
	firstJoin: number,
	playTime: number,
	lock: { job: string, t: number }?,
}

local store: DataStore? = nil
local storeOk = false
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
		storeOk = true
	else
		warn("[Data] DataStore unavailable, progress will NOT save:", result)
	end
end

Data.profiles = {} :: { [Player]: Profile }
local loadedOk: { [Player]: boolean } = {}
local LOCK_TTL = 150

local function defaultProfile(): Profile
	return {
		version = 2,
		stage = 0,
		best = 0,
		base = false,
		runTop = 0,
		gifts = {},
		boosts = {},
		charges = {},
		perks = {},
		wins = 0,
		coins = 0,
		totalCoins = 0,
		freeSkips = 0,
		trails = {},
		equippedTrail = "",
		effects = {},
		equippedEffect = "",
		-- coils start OFF: a new player meets the map with the plain classic jump
		settings = { speedCoil = false, gravityCoil = false, effects = true },
		lang = "",
		bestRunMs = 0,
		ads = { day = 0, count = 0 },
		referredBy = 0,
		referralPaid = false,
		referralRewards = 0,
		starterBought = false,
		boostEndsAt = 0,
		groupGiftClaimed = false,
		notifAskedAt = 0,
		purchases = {},
		daily = { lastClaim = 0, streak = 0 },
		codes = {},
		savedAt = os.time(),
		firstJoin = os.time(),
		playTime = 0,
	}
end
Data.defaultProfile = defaultProfile

-- Fill any keys added in later versions and sanitise values.
local function reconcile(p: any): Profile
	local def = defaultProfile() :: any
	-- saved before the once-per-run summit rule: the summits under the saved stage were paid
	if type(p.runTop) ~= "number" then
		p.runTop = Rules.runTopFromStage(Layout :: any, math.floor(tonumber(p.stage) or 0))
	end
	-- a corrupted / hand-edited entry must not break the loop below
	if type(p.settings) ~= "table" then
		p.settings = nil
	end
	for k, v in def do
		if p[k] == nil then
			p[k] = v
		end
	end
	for k, v in def.settings do
		if p.settings[k] == nil then
			p.settings[k] = v
		end
	end
	if (tonumber(p.version) or 1) < 2 then
		-- v1 profiles were created with both coils switched on by default
		p.settings.speedCoil = false
		p.settings.gravityCoil = false
		p.version = 2
	end
	p.stage = math.clamp(math.floor(tonumber(p.stage) or 0), 0, Layout.TOTAL)
	p.best = math.clamp(math.max(tonumber(p.best) or 0, p.stage), 0, Layout.TOTAL)
	p.runTop = math.clamp(math.floor(p.runTop), 0, Layout.TOTAL)
	-- gifts are earned by the best stage: nobody who got there is left without one
	for _, gift in Gifts.earned(p.best) do
		p.gifts[tostring(gift.id)] = true
		if gift.kind == "trail" then
			p.trails[gift.value] = true
		elseif gift.kind == "effect" then
			p.effects[gift.value] = true
		end
	end
	Powerups.sweep(p.boosts, os.time())
	return p :: Profile
end

local function key(player: Player): string
	return "u_" .. player.UserId
end

function Data.load(player: Player): Profile
	if not storeOk or not store then
		local p = defaultProfile()
		Data.profiles[player] = p
		loadedOk[player] = false
		return p
	end
	local ds = store :: DataStore
	local result: any = nil
	for attempt = 1, 6 do
		local lockedByOther = false
		local ok, err = pcall(function()
			ds:UpdateAsync(key(player), function(old: any)
				local now = os.time()
				if old and old.lock and old.lock.job ~= game.JobId and now - old.lock.t < LOCK_TTL and attempt < 6 then
					lockedByOther = true
					return nil -- abort write
				end
				local p = if old then reconcile(old) else defaultProfile()
				p.lock = { job = game.JobId, t = now }
				result = p
				return p
			end)
		end)
		if ok and not lockedByOther and result then
			break
		end
		if not ok then
			warn("[Data] load failed for", player.Name, err)
		end
		result = nil
		task.wait(if lockedByOther then 5 else 2)
		if not player.Parent then
			break
		end
	end
	if not result then
		-- Never overwrite real data with a blank profile: keep this session unsaved.
		warn("[Data] could not load", player.Name, "- session will not save")
		result = defaultProfile()
		loadedOk[player] = false
	else
		loadedOk[player] = true
	end
	Data.profiles[player] = result
	return result
end

function Data.save(player: Player, release: boolean?)
	local p = Data.profiles[player]
	if not p or not loadedOk[player] or not store then
		return
	end
	local ds = store :: DataStore
	p.savedAt = os.time()
	p.lock = if release then nil else { job = game.JobId, t = os.time() }
	local ok, err = pcall(function()
		ds:UpdateAsync(key(player), function(old: any)
			if old and old.lock and old.lock.job ~= game.JobId and os.time() - old.lock.t < LOCK_TTL then
				return nil -- another server owns it now; don't clobber
			end
			return p
		end)
	end)
	if not ok then
		warn("[Data] save failed for", player.Name, err)
	end
end

function Data.release(player: Player)
	Data.save(player, true)
	Data.profiles[player] = nil
	loadedOk[player] = nil
end

function Data.isPersistent(player: Player): boolean
	return loadedOk[player] == true
end

function Data.get(player: Player): Profile?
	return Data.profiles[player]
end

function Data.startAutosave()
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for _, player in Players:GetPlayers() do
				task.spawn(Data.save, player)
			end
		end
	end)
	game:BindToClose(function()
		if RunService:IsStudio() and not storeOk then
			return
		end
		local pending = 0
		for _, player in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				Data.save(player, true)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.1)
		end
	end)
end

return Data
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">Events</string>
          <string name="Source"><![CDATA[--!strict
-- Live events (P0-6): 2x Coins Weekend and Skip Sale Hour on a UTC schedule (Shared/LiveEvents),
-- plus an admin override (/event <id> <minutes>) broadcast to every server with MessagingService.
-- Effects live where coins / receipts are handled (Session.bonusMult, Monetization.saleBonus).
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local Config = require(ReplicatedStorage.Shared.Config)
local LiveEvents = require(ReplicatedStorage.Shared.LiveEvents)
local Remotes = require(script.Parent.Remotes)
local Session = require(script.Parent.Session)

local Events = {}

local TOPIC = "STO_LiveEvent"
local lastKey = ""

local function validId(id: any): boolean
	for _, def in Config.LiveEvents do
		if def.id == id then
			return true
		end
	end
	return false
end

-- current = { id, endsAt }?, upcoming = { id, startsAt }?
function Events.snapshot(): (LiveEvents.Active?, LiveEvents.Upcoming?)
	local now = os.time()
	return LiveEvents.current(now, Config.LiveEvents :: any, Session.eventOverride), LiveEvents.nextStart(now, Config.LiveEvents :: any)
end

function Events.sendTo(player: Player)
	local cur, nxt = Events.snapshot()
	Remotes.fire("LiveEventUpdate", player, cur, nxt)
end

local function broadcastIfChanged(force: boolean?)
	local cur, nxt = Events.snapshot()
	local key = (cur and (cur.id .. cur.endsAt) or "-") .. "|" .. (nxt and (nxt.id .. nxt.startsAt) or "-")
	if force or key ~= lastKey then
		lastKey = key
		Remotes.fireAll("LiveEventUpdate", cur, nxt)
	end
end

-- Admin / test hook: run `id` until `endsAt` (os.time); endsAt <= now clears the override.
function Events.setOverride(id: string, endsAt: number)
	if endsAt <= os.time() then
		Session.eventOverride = nil
	else
		Session.eventOverride = { id = id, endsAt = endsAt }
	end
	broadcastIfChanged(true)
end

local function isAdmin(userId: number): boolean
	return table.find(Config.AdminUserIds, userId) ~= nil
end

function Events.init()
	task.spawn(function() -- SubscribeAsync yields (and fails in unpublished places)
		pcall(function()
			MessagingService:SubscribeAsync(TOPIC, function(message)
				local d = message.Data
				if type(d) == "table" and validId(d.id) and type(d.endsAt) == "number" then
					Events.setOverride(d.id, d.endsAt)
				end
			end)
		end)
	end)

	-- /event <id> <minutes>   (Config.AdminUserIds only)
	local cmd = Instance.new("TextChatCommand")
	cmd.Name = "LiveEventCommand"
	cmd.PrimaryAlias = "/event"
	cmd.Triggered:Connect(function(source: TextSource, text: string)
		if not isAdmin(source.UserId) then
			return
		end
		local id, minutes = string.match(text, "^/event%s+(%S+)%s+(%d+)")
		if not id or not validId(id) then
			return
		end
		local endsAt = os.time() + (tonumber(minutes) or 0) * 60
		Events.setOverride(id :: string, endsAt)
		pcall(function()
			MessagingService:PublishAsync(TOPIC, { id = id, endsAt = endsAt })
		end)
	end)
	cmd.Parent = TextChatService

	Players.PlayerAdded:Connect(function(player)
		task.defer(Events.sendTo, player)
	end)
	task.spawn(function()
		while true do
			broadcastIfChanged(false)
			task.wait(5)
		end
	end)
end

return Events
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">Leaderboard</string>
          <string name="Source"><![CDATA[--!strict
-- Global boards in the lobby, each backed by an OrderedDataStore:
--   "Top Wins" (most wins, descending), "Fastest Climb" (best unassisted run 0 -> 100 in ms,
--   ascending) and "Highest Stage" (best stage of the 1,000, descending).
-- Rows are localized on each client (LocKey / LocArgs attributes, see client/World/WorldText).
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local RunTime = require(ReplicatedStorage.Shared.RunTime)
local StageGenerator = require(script.Parent.StageGenerator)

local Leaderboard = {}

local ROWS = 10
local REFRESH = 60

local function openStore(name: string): OrderedDataStore?
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(name)
	end)
	if ok then
		return result
	end
	warn("[Leaderboard] OrderedDataStore unavailable:", result)
	return nil
end

local winsStore = openStore(Config.WinsBoardStore)
local fastStore = openStore(Config.FastestBoardStore)
local stageStore = openStore(Config.StageBoardStore)

local nameCache: { [number]: string } = {}
local lastWrite: { [number]: number } = {}
local lastStageWrite: { [number]: number } = {}

local function nameOf(userId: number): string
	local cached = nameCache[userId]
	if cached then
		return cached
	end
	local p = Players:GetPlayerByUserId(userId)
	if p then
		nameCache[userId] = p.DisplayName
		return p.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and name then name else ("User " .. userId)
	nameCache[userId] = result
	return result
end

local function write(ds: OrderedDataStore?, userId: number, value: number)
	if not ds then
		return
	end
	local store = ds :: OrderedDataStore
	task.spawn(function()
		local ok, err = pcall(function()
			store:SetAsync(tostring(userId), value)
		end)
		if not ok then
			warn("[Leaderboard] write failed", err)
		end
	end)
end

function Leaderboard.record(player: Player, wins: number, force: boolean?)
	if wins <= 0 then
		return
	end
	local now = os.clock()
	if not force and lastWrite[player.UserId] and now - lastWrite[player.UserId] < 30 then
		return
	end
	lastWrite[player.UserId] = now
	write(winsStore, player.UserId, wins)
end

-- Best stage ever reached (1..1000). Throttled: a climber sets a new best every few seconds.
function Leaderboard.recordStage(player: Player, best: number, force: boolean?)
	if best <= 0 then
		return
	end
	local now = os.clock()
	if not force and lastStageWrite[player.UserId] and now - lastStageWrite[player.UserId] < 60 then
		return
	end
	lastStageWrite[player.UserId] = now
	write(stageStore, player.UserId, best)
end

-- New personal best run (ms). Lower is better.
function Leaderboard.recordFastest(player: Player, ms: number)
	if ms > 0 then
		write(fastStore, player.UserId, ms)
	end
end

local function buildBoard(board: BasePart, titleKey: string, titleColor: Color3): { TextLabel }
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 30
	sg.LightInfluence = 0
	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 0.14)
	title.BackgroundColor3 = titleColor
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(60, 40, 10)
	StageGenerator.loc(title, titleKey)
	title.Parent = sg
	local rows = {}
	for i = 1, ROWS do
		local row = Instance.new("TextLabel")
		row.Size = UDim2.fromScale(0.94, 0.078)
		row.Position = UDim2.fromScale(0.03, 0.155 + (i - 1) * 0.084)
		row.BackgroundColor3 = if i % 2 == 0 then Color3.fromRGB(55, 60, 105) else Color3.fromRGB(70, 76, 130)
		row.Font = Enum.Font.GothamBold
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = if i == 1 then Color3.fromRGB(255, 220, 80) elseif i <= 3 then Color3.fromRGB(220, 230, 255) else Color3.fromRGB(255, 255, 255)
		row.Text = ("%d. ..."):format(i)
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0.03, 0)
		pad.Parent = row
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.25, 0)
		corner.Parent = row
		row.Parent = sg
		table.insert(rows, row)
	end
	sg.Parent = board
	return rows
end

local function runBoard(rows: { TextLabel }, ds: OrderedDataStore?, ascending: boolean, rowKey: string, format: (number) -> any)
	task.spawn(function()
		while true do
			if ds then
				local store = ds :: OrderedDataStore
				local ok, pages = pcall(function()
					return store:GetSortedAsync(ascending, ROWS)
				end)
				if ok and pages then
					local entries = pages:GetCurrentPage()
					for i = 1, ROWS do
						local e = entries[i]
						if e then
							local uid = tonumber(e.key) or 0
							StageGenerator.loc(rows[i], rowKey, { rank = i, name = nameOf(uid), value = format(e.value) })
						else
							rows[i]:SetAttribute("LocKey", nil)
							rows[i].Text = ("%d. -"):format(i)
						end
					end
				end
			else
				StageGenerator.loc(rows[1], "board.unavailable")
			end
			task.wait(REFRESH)
		end
	end)
end

function Leaderboard.init(winsBoard: BasePart, fastBoard: BasePart, stageBoard: BasePart)
	runBoard(buildBoard(stageBoard, "board.stage", Color3.fromRGB(150, 255, 170)), stageStore, false, "board.row", function(v)
		return v
	end)
	runBoard(buildBoard(winsBoard, "board.wins", Color3.fromRGB(255, 190, 50)), winsStore, false, "board.row", function(v)
		return v
	end)
	runBoard(buildBoard(fastBoard, "board.fastest", Color3.fromRGB(120, 220, 255)), fastStore, true, "board.row_time", function(v)
		return RunTime.format(v)
	end)
end

return Leaderboard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">Lounge</string>
          <string name="Source"><![CDATA[--!strict
-- The Winner's Lounge (the terrace beyond the summit room of tower 1): free items for everybody
-- whose best stage is 100 or more. Catalogue and rules: Shared/Perks.
--   travel  : opens the teleporter panel; "Travel" moves your checkpoint to the start of a world
--             you have already reached (the run becomes assisted)
--   roam    : glider / cloud = explore mode. Pads don't count while it is on and switching it off
--             puts you back on your checkpoint, so it cannot be used to skip stages
--   ability : dash / triple jump, on or off (they count for progress; the run is assisted)
--   glow / jumpfx / trail / effect : cosmetics
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Perks = require(ReplicatedStorage.Shared.Perks)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local Session = require(script.Parent.Session)
local Towers = require(script.Parent.Towers)
local Checkpoints = require(script.Parent.Checkpoints)
local Cosmetics = require(script.Parent.Cosmetics)

local Lounge = {}

local M = Remotes.M

-- Explore mode on / off. `id` = "glider" | "cloud" | "" (off).
function Lounge.setRoam(player: Player, id: string): (boolean, any?)
	local p = Data.get(player)
	local s = Session.get(player)
	if not p or not s then
		return false
	end
	if id == "" then
		if s.roam then
			s.roam = nil
			player:SetAttribute("Roam", nil)
			Session.push(player)
			Checkpoints.teleportAsync(player) -- back where your progress is
			return true, M("msg.roam_off")
		end
		return true
	end
	local perk = Perks.get(id)
	if not perk or perk.kind ~= "roam" or not Perks.unlocked(p.best) or p.perks[id] ~= true then
		return false, M("err.lounge_locked")
	end
	s.roam = id
	player:SetAttribute("Roam", id)
	Session.assist(player, "roam")
	Session.push(player)
	return true, M("msg.roam_on")
end

-- Takes (or toggles) a lounge item.
function Lounge.take(player: Player, id: string): (boolean, any?)
	local p = Data.get(player)
	local s = Session.get(player)
	local perk = Perks.get(id)
	if not p or not s or not perk then
		return false, M("err.not_available")
	end
	if not Perks.unlocked(p.best) then
		return false, M("err.lounge_locked")
	end
	if perk.gift and not p.gifts[tostring(perk.gift)] then
		return false, M("err.need_gift", { n = perk.gift * 100 })
	end
	local name = M("perk." .. id .. ".name")
	if perk.kind == "travel" then
		Remotes.fire("OpenPanel", player, "travel")
		return true
	elseif perk.kind == "roam" then
		p.perks[id] = true
		if s.roam == id then
			return Lounge.setRoam(player, "")
		end
		return Lounge.setRoam(player, id)
	elseif perk.kind == "ability" then
		p.perks[id] = not (p.perks[id] == true)
		Cosmetics.applyCoils(player)
		Session.refreshHelp(player)
		Session.push(player)
		return true, M(if p.perks[id] then "msg.perk_on" else "msg.perk_off", { name = name })
	elseif perk.kind == "glow" or perk.kind == "jumpfx" then
		p.perks[perk.kind] = if p.perks[perk.kind] == id then "" else id
		Cosmetics.applyExtras(player)
		Session.push(player)
		return true, M(if p.perks[perk.kind] == id then "msg.perk_on" else "msg.perk_off", { name = name })
	elseif perk.kind == "trail" then
		p.trails[id] = true
		p.equippedTrail = id
		Cosmetics.applyTrail(player)
		Session.push(player)
		return true, M("msg.perk_on", { name = name })
	elseif perk.kind == "effect" then
		p.effects[id] = true
		p.equippedEffect = id
		Cosmetics.applyEffect(player)
		Session.push(player)
		return true, M("msg.perk_on", { name = name })
	end
	return false, M("err.not_available")
end

function Lounge.init()
	Towers.onBuilt(function(tower)
		for _, pr in tower.prompts do
			if pr.kind == "lounge" then
				pr.prompt.Triggered:Connect(function(player)
					local ok, msg = Lounge.take(player, pr.id)
					if msg then
						Remotes.notify(player, msg, if ok then "success" else "info")
					end
				end)
			end
		end
	end)
	Remotes.handle("TakePerk", function(player, payload)
		return Lounge.take(player, tostring(payload.id))
	end)
	Remotes.handle("SetRoam", function(player, payload)
		return Lounge.setRoam(player, tostring(payload.id or ""))
	end)
	Remotes.handle("Travel", function(player, payload)
		local p = Data.get(player)
		local target = tonumber(payload.stage)
		if not p or not target or not Perks.canTravel(p.best, target) then
			return false, M("err.travel_locked")
		end
		if target == 0 then
			-- the "Lobby" button: go there and KEEP the checkpoint (travel(0) used to save stage 0,
			-- wiping the player's progress)
			return Checkpoints.goToLobby(player)
		end
		Checkpoints.travel(player, target)
		return true
	end)
end

return Lounge
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">Monetization</string>
          <string name="Source"><![CDATA[--!strict
-- Game passes (cached per session) and Developer Products (idempotent ProcessReceipt).
local AdService = game:GetService("AdService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Pricing = require(ReplicatedStorage.Shared.Pricing)
local Powerups = require(ReplicatedStorage.Shared.Powerups)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local Session = require(script.Parent.Session)
local Checkpoints = require(script.Parent.Checkpoints)
local Cosmetics = require(script.Parent.Cosmetics)

local Monetization = {}

local MAX_RECEIPTS = 60

-- productId -> handler(player) -> message (a Remotes.M spec or a list of them)
type Grant = (Player, Data.Profile) -> any
local productHandlers: { [number]: Grant } = {}
local M = Remotes.M

local function formatCoins(n: number): string
	local digits = tostring(math.floor(n)):reverse()
	local grouped = digits:gsub("(%d%d%d)", "%1,")
	return (grouped:reverse():gsub("^,", ""))
end

local function register(id: number, fn: Grant)
	if id ~= 0 then
		productHandlers[id] = fn
	end
end

-- Skip Sale Hour (P0-6): a skip bought while the event runs also gives +1 free skip.
local function saleBonus(p: Data.Profile, msg: Remotes.Msg): any
	if Session.eventActive("SkipSaleHour") then
		p.freeSkips += 1
		return { msg, M("msg.sale_bonus") }
	end
	return msg
end

-- One grant for both price bands (19 R$ up to level 300, 29 R$ above): the client offers the band
-- of the level you are on; what is granted is the same either way.
local function grantSkip(player: Player, p: Data.Profile): any
	if Checkpoints.skip(player, 1, "skip") then
		return saleBonus(p, M("msg.stage_skipped"))
	end
	p.freeSkips += 1 -- already at the top: keep it for the next run
	return saleBonus(p, M("msg.saved_skip"))
end
register(Config.Products.SkipStage, grantSkip)
register(Config.Products.SkipStageHigh, grantSkip)
register(Config.Products.Skip10, function(player, p)
	if Checkpoints.skip(player, 10, "skip") then
		return saleBonus(p, M("msg.skipped_ahead"))
	end
	p.freeSkips += 10
	return saleBonus(p, M("msg.saved_10_skips"))
end)
-- Rewarded video (P0-1): the ad reward arrives as a receipt for the AdSkip product.
register(Config.Products.AdSkip, function(player, p)
	if Checkpoints.skip(player, 1, "ad") then
		return M("msg.stage_skipped")
	end
	p.freeSkips += 1
	return M("msg.saved_skip")
end)

-- Starter pack (P0-4). Exposed for the Studio test harness (product ids are 0 there).
function Monetization.grantStarter(_player: Player, p: Data.Profile): Remotes.Msg
	p.starterBought = true
	p.freeSkips += Config.StarterPackSkips
	p.coins += Config.StarterPackCoins
	p.totalCoins += Config.StarterPackCoins
	p.trails.starter = true
	p.boostEndsAt = math.max(os.time(), p.boostEndsAt) + Config.StarterBoostSeconds
	return M("msg.starter_thanks", { n = Config.StarterPackSkips, coins = Config.StarterPackCoins, minutes = Config.StarterBoostSeconds // 60 })
end
register(Config.Products.StarterPack, function(player, p)
	return Monetization.grantStarter(player, p)
end)
-- Coin packs (amounts in Shared/Pricing.CoinPacks). Bought coins are not multiplied by boosts.
for key, amount in Pricing.CoinPacks do
	register(Config.Products[key] or 0, function(_player, p)
		p.coins += amount
		p.totalCoins += amount
		return M("msg.coins_added", { n = formatCoins(amount) })
	end)
end

-- Double jump for 5 minutes (9 R$). Stacks like the coin shop's timed power-ups (up to the cap).
-- Like the pass and the shop version it makes the run unranked (Session.refreshHelp).
register(Config.Products.DoubleJump5, function(player, p)
	local seconds = 300
	local now = os.time()
	local left = Powerups.remaining(p.boosts, "doublejump", now)
	p.boosts.doublejump = now + math.min(left + seconds, Powerups.MAX_TIMED)
	Cosmetics.applyCoils(player)
	Session.refreshHelp(player)
	return M("msg.doublejump_added", { minutes = seconds // 60 })
end)

local function passNameById(id: number): string?
	for name, pid in Config.Passes do
		if pid == id and pid ~= 0 then
			return name
		end
	end
	return nil
end

function Monetization.loadPasses(player: Player)
	local s = Session.get(player)
	if not s then
		return
	end
	for name, id in Config.Passes do
		if id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
			end)
			if ok and owns then
				s.passes[name] = true
			end
		end
	end
end

local function utcDay(): number
	return os.time() // 86400
end

function Monetization.init()
	-- Rewarded video ad skip: the server shows the ad; the grant comes through ProcessReceipt.
	Remotes.handle("WatchAd", function(player, payload)
		local p = Data.get(player)
		if not p or Config.Products.AdSkip == 0 or payload.placement ~= "skip" then
			return false, M("err.not_available")
		end
		if p.ads.day ~= utcDay() then
			p.ads = { day = utcDay(), count = 0 }
		end
		if p.ads.count >= Config.AdDailyCap then
			return false, M("err.ad_cap")
		end
		local ok, result = pcall(function()
			local reward = AdService:CreateAdRewardFromDevProductId(Config.Products.AdSkip)
			return AdService:ShowRewardedVideoAdAsync(player, reward)
		end)
		if not ok then
			warn("[Monetization] rewarded ad failed:", result)
			return false, M("err.ad_unavailable")
		end
		p.ads.count += 1
		return true
	end)

	MarketplaceService.ProcessReceipt = function(info)
		local player = Players:GetPlayerByUserId(info.PlayerId)
		if not player then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local p = Data.get(player)
		if not p or not Data.isPersistent(player) then
			-- Profile not loaded (or DataStore down): Roblox will retry later.
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local receiptId = tostring(info.PurchaseId)
		if table.find(p.purchases, receiptId) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		local handler = productHandlers[info.ProductId]
		if not handler then
			warn("[Monetization] unknown product", info.ProductId)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local ok, msg = pcall(handler, player, p)
		if not ok then
			warn("[Monetization] grant failed", msg)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		table.insert(p.purchases, receiptId)
		while #p.purchases > MAX_RECEIPTS do
			table.remove(p.purchases, 1)
		end
		Data.save(player)
		Remotes.notify(player, msg, "success")
		Session.push(player)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local name = passNameById(passId)
		local s = Session.get(player)
		if not name or not s then
			return
		end
		s.passes[name] = true
		Cosmetics.applyAll(player)
		Remotes.notify(player, M("msg.thanks_pass", { name = M("store." .. name .. ".name") }), "success")
		Session.push(player)
	end)
end

return Monetization
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">Nametags</string>
          <string name="Source"><![CDATA[--!strict
-- Overhead name tag (P0-5): display name, "Stage N · 🏆 W" and a title earned by wins.
-- The two localized lines carry LocKey / LocArgs attributes, so each client renders them in its own
-- language (client/World/WorldText.luau). Updated from Session.push (stage / win / rebirth).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Data = require(script.Parent.Data)
local Session = require(script.Parent.Session)
local StageGenerator = require(script.Parent.StageGenerator)

local Nametags = {}

local GOLD = Color3.fromRGB(255, 215, 80)

function Nametags.titleIndex(wins: number): number
	local idx = 1
	for i, t in Config.Titles do
		if wins >= t.wins then
			idx = i
		end
	end
	return idx
end

local function line(parent: Instance, name: string, y: number, h: number, color: Color3): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(1, h)
	l.Position = UDim2.fromScale(0, y)
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = color
	l.TextStrokeTransparency = 0.2
	l.TextStrokeColor3 = Color3.fromRGB(25, 25, 45)
	l.Parent = parent
	return l
end

local function ensure(player: Player): BillboardGui?
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not char or not head then
		return nil
	end
	local bb = head:FindFirstChild("SkyTag") :: BillboardGui?
	if bb then
		return bb
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	local g = Instance.new("BillboardGui")
	g.Name = "SkyTag"
	g.Size = UDim2.fromScale(6, 1.6)
	g.StudsOffset = Vector3.new(0, 2.6, 0)
	g.MaxDistance = 80
	g.AlwaysOnTop = false
	g.LightInfluence = 0
	line(g, "NameLine", 0, 0.42, Color3.new(1, 1, 1))
	line(g, "StageLine", 0.42, 0.3, Color3.fromRGB(200, 235, 255))
	line(g, "TitleLine", 0.72, 0.28, Config.RebirthColors[1])
	g.Adornee = head
	g.Parent = head
	return g
end

function Nametags.update(player: Player)
	local p = Data.get(player)
	local g = ensure(player)
	if not p or not g then
		return
	end
	local vip = Session.hasPass(player, "VIP")
	local nameLine = g:FindFirstChild("NameLine") :: TextLabel
	nameLine.Text = if vip then "[VIP] " .. player.DisplayName else player.DisplayName
	nameLine.TextColor3 = if vip then GOLD else Color3.new(1, 1, 1)
	local s = Session.get(player)
	local stage = math.max(if s then s.at else 0, p.stage)
	local stageLine = g:FindFirstChild("StageLine") :: TextLabel
	if stageLine:GetAttribute("S") ~= stage or stageLine:GetAttribute("W") ~= p.wins then
		stageLine:SetAttribute("S", stage)
		stageLine:SetAttribute("W", p.wins)
		StageGenerator.loc(stageLine, "tag.stage", { n = stage, w = p.wins })
	end
	-- title: the tower gifts (stage 1000, stage 500) outrank the titles earned by wins
	local idx = Nametags.titleIndex(p.wins)
	local key, color = "title." .. idx, Config.RebirthColors[((idx - 1) % #Config.RebirthColors) + 1]
	if p.gifts["10"] then
		key, color = "title.conqueror", GOLD
	elseif p.gifts["5"] then
		key, color = "title.legend", GOLD
	end
	local titleLine = g:FindFirstChild("TitleLine") :: TextLabel
	if titleLine:GetAttribute("K") ~= key then
		titleLine:SetAttribute("K", key)
		titleLine.TextColor3 = color
		StageGenerator.loc(titleLine, key)
	end
end

function Nametags.init()
	Session.onPush(Nametags.update)
end

return Nametags
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">Obstacles</string>
          <string name="Source"><![CDATA[--!strict
-- Server-side runtime for the tagged obstacle parts built by StageGenerator:
--   Kill (touch = death), Disappear (fade after touch), Falling (drop after touch),
--   Mover (anchored platform on a sine path; AssemblyLinearVelocity set so riders are carried),
--   Spinner (anchored kill bars), Lava (kill slab rising on a timer), Laser (timed kill gate),
--   Coin (pickup, per-player, once per run).
-- Bounce pads, glass reveal and wind are client-side (they act on the local character / view).
--
-- Towers come and go (server/Towers.luau), so obstacles are registered per tower with
-- Obstacles.add(folder) and dropped with Obstacles.remove(folder).
--
-- Only what is near a player runs: every animated obstacle knows its stage, and ONE Heartbeat
-- loop moves those of the stages inside some player's window. The rest sleep where they are, so
-- an empty stretch of tower costs neither CPU nor network.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local Session = require(script.Parent.Session)

local Obstacles = {}

-- Stages around a player that stay awake: two behind (you see them when you look down / fall
-- back), eight ahead (six stages up is the run directly overhead).
Obstacles.AWAKE_BEHIND = 2
Obstacles.AWAKE_AHEAD = 8

-- Set by server/Shops.luau: returns true when something (a shield) absorbed the hit.
Obstacles.absorb = nil :: ((player: Player) -> boolean)?

local function playerFromHit(hit: BasePart): (Player?, Humanoid?)
	local model = hit:FindFirstAncestorOfClass("Model")
	if not model then
		return nil, nil
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	local player = Players:GetPlayerFromCharacter(model)
	return player, hum
end

-- Every lethal obstacle goes through here.
function Obstacles.kill(player: Player?, hum: Humanoid)
	if hum.Health <= 0 then
		return
	end
	if player then
		local s = Session.get(player)
		if s and os.clock() < s.shieldUntil then
			return
		end
		local absorb = Obstacles.absorb
		if absorb and absorb(player) then
			return
		end
	end
	hum.Health = 0
end

local function bindKill(part: BasePart)
	part.Touched:Connect(function(hit)
		local player, hum = playerFromHit(hit)
		if hum then
			Obstacles.kill(player, hum)
		end
	end)
end

-- The glyph painted on a platform (StageGenerator.topIcon) must vanish with it.
local function setIcon(part: BasePart, on: boolean)
	local icon = part:FindFirstChild("Icon")
	if icon and icon:IsA("SurfaceGui") then
		icon.Enabled = on
	end
end

local function bindDisappear(part: BasePart)
	local busy = false
	local baseT = part.Transparency
	local delay = (part:GetAttribute("Delay") :: number?) or 0.6
	part.Touched:Connect(function(hit)
		if busy then
			return
		end
		local player = playerFromHit(hit)
		if not player then
			return
		end
		busy = true
		TweenService:Create(part, TweenInfo.new(delay), { Transparency = 0.85 }):Play()
		task.wait(delay)
		part.CanCollide = false
		part.Transparency = 1
		setIcon(part, false)
		task.wait(2.5)
		part.CanCollide = true
		setIcon(part, true)
		TweenService:Create(part, TweenInfo.new(0.3), { Transparency = baseT }):Play()
		task.wait(0.3)
		busy = false
	end)
end

local function bindFalling(part: BasePart)
	local busy = false
	local home = part.CFrame
	local delay = (part:GetAttribute("Delay") :: number?) or 0.5
	part.Touched:Connect(function(hit)
		if busy then
			return
		end
		if not playerFromHit(hit) then
			return
		end
		busy = true
		-- shake
		local t0 = os.clock()
		while os.clock() - t0 < delay do
			part.CFrame = home * CFrame.new((math.random() - 0.5) * 0.3, 0, (math.random() - 0.5) * 0.3)
			task.wait(0.05)
		end
		part.CFrame = home
		local drop = TweenService:Create(part, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			CFrame = home - Vector3.new(0, 45, 0),
			Transparency = 1,
		})
		drop:Play()
		drop.Completed:Wait()
		part.CanCollide = false
		setIcon(part, false)
		task.wait(2.5)
		part.CFrame = home
		part.CanCollide = true
		setIcon(part, true)
		TweenService:Create(part, TweenInfo.new(0.3), { Transparency = 0 }):Play()
		task.wait(0.3)
		busy = false
	end)
end

-- Gives a coin to a player who is really next to it. Used by the touch and by the coin magnet.
function Obstacles.collectCoin(player: Player, part: BasePart, reach: number): boolean
	local coinId = part:GetAttribute("CoinId")
	local s = Session.get(player)
	local p = Data.get(player)
	if type(coinId) ~= "number" or not s or not p or s.collected[coinId] then
		return false
	end
	local root = (player.Character and player.Character:FindFirstChild("HumanoidRootPart")) :: BasePart?
	if not root or (root.Position - part.Position).Magnitude > reach then
		return false -- touch spoof / far away
	end
	s.collected[coinId] = true
	local got = Session.addCoins(player, Config.CoinPickupValue)
	Remotes.fire("CoinCollected", player, coinId, got)
	Session.push(player)
	return true
end

local function bindCoin(part: BasePart)
	part.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		if player then
			Obstacles.collectCoin(player, part, 12)
		end
	end)
end

---------------------------------------------------------------------------------------------
-- animated obstacles, grouped by stage
---------------------------------------------------------------------------------------------
type Mover = { part: BasePart, home: CFrame, axis: Vector3, amp: number, period: number, phase: number }
type Spinner = { part: BasePart, center: Vector3, speed: number, angle0: number }
type Lava = { part: BasePart, bottom: number, minTop: number, maxTop: number, period: number, cf: CFrame }
type Laser = { part: BasePart, period: number, duty: number, phase: number, state: number }
type StageSet = { movers: { Mover }, spinners: { Spinner }, lavas: { Lava }, lasers: { Laser }, coins: { BasePart } }

local stages: { [number]: StageSet } = {}
local owner: { [number]: Instance } = {} -- stage -> the tower folder it came from

local function setFor(stage: number, root: Instance): StageSet
	local set = stages[stage]
	if not set then
		set = { movers = {}, spinners = {}, lavas = {}, lasers = {}, coins = {} }
		stages[stage] = set
		owner[stage] = root
	end
	return set
end

-- Laser states: 0 off, 1 warming up (it is about to fire), 2 on.
Obstacles.LASER_WARN = 0.35
local LASER_LOOK = { [0] = 0.94, [1] = 0.72, [2] = 0.3 }

local function laserState(l: Laser, t: number): number
	local f = (t / l.period + l.phase) % 1
	if f < l.duty then
		return 2
	elseif f > 1 - Obstacles.LASER_WARN / l.period then
		return 1
	end
	return 0
end

-- Coins of a stage (for the magnet).
function Obstacles.coinsOf(stage: number): { BasePart }
	local set = stages[stage]
	return if set then set.coins else {}
end

-- Registers every tagged obstacle under `root` (a tower folder).
function Obstacles.add(root: Instance)
	for _, inst in root:GetDescendants() do
		if not inst:IsA("BasePart") then
			continue
		end
		local stage = (inst:GetAttribute("Stage") :: number?) or 0
		if CollectionService:HasTag(inst, "Kill") then
			bindKill(inst)
		end
		if CollectionService:HasTag(inst, "Disappear") then
			bindDisappear(inst)
		elseif CollectionService:HasTag(inst, "Falling") then
			bindFalling(inst)
		elseif CollectionService:HasTag(inst, "Coin") then
			bindCoin(inst)
			table.insert(setFor(stage, root).coins, inst)
		elseif CollectionService:HasTag(inst, "Mover") then
			table.insert(setFor(stage, root).movers, {
				part = inst,
				home = inst.CFrame,
				axis = (inst:GetAttribute("Axis") :: Vector3?) or Vector3.xAxis,
				amp = (inst:GetAttribute("Amp") :: number?) or 4,
				period = (inst:GetAttribute("Period") :: number?) or 4,
				phase = (inst:GetAttribute("Phase") :: number?) or 0,
			})
		elseif CollectionService:HasTag(inst, "Laser") then
			table.insert(setFor(stage, root).lasers, {
				part = inst,
				period = (inst:GetAttribute("Period") :: number?) or 3,
				duty = (inst:GetAttribute("Duty") :: number?) or 0.5,
				phase = (inst:GetAttribute("Phase") :: number?) or 0,
				state = 2,
			})
		end
		if CollectionService:HasTag(inst, "Spinner") then
			table.insert(setFor(stage, root).spinners, {
				part = inst,
				center = (inst:GetAttribute("Center") :: Vector3?) or inst.Position,
				speed = (inst:GetAttribute("Speed") :: number?) or 2,
				angle0 = (inst:GetAttribute("Angle0") :: number?) or 0,
			})
		elseif CollectionService:HasTag(inst, "Lava") then
			table.insert(setFor(stage, root).lavas, {
				part = inst,
				bottom = (inst:GetAttribute("Bottom") :: number?) or inst.Position.Y,
				minTop = (inst:GetAttribute("MinTop") :: number?) or inst.Position.Y,
				maxTop = (inst:GetAttribute("MaxTop") :: number?) or inst.Position.Y,
				period = (inst:GetAttribute("Period") :: number?) or 10,
				cf = inst.CFrame,
			})
		end
	end
end

-- Forgets the obstacles of a tower that is about to be destroyed.
function Obstacles.remove(root: Instance)
	for stage, from in owner do
		if from == root then
			stages[stage] = nil
			owner[stage] = nil
		end
	end
end

-- Stage numbers that currently have somebody close enough to matter.
local awake: { number } = {}
local awakeSet: { [number]: boolean } = {}

local function refreshAwake()
	table.clear(awakeSet)
	table.clear(awake)
	for _, player in Players:GetPlayers() do
		local s = Session.get(player)
		local p = Data.get(player)
		if s and p then
			local here = if s.inLobby then 0 else math.max(s.at, p.stage)
			for g = math.max(1, here - Obstacles.AWAKE_BEHIND), here + Obstacles.AWAKE_AHEAD do
				if stages[g] and not awakeSet[g] then
					awakeSet[g] = true
					table.insert(awake, g)
				end
			end
		end
	end
end
Obstacles.refreshAwake = refreshAwake

function Obstacles.isAwake(stage: number): boolean
	return awakeSet[stage] == true
end

-- How many animated obstacles exist / are running (for the performance probe and its budget).
function Obstacles.census(): (number, number)
	local total, running = 0, 0
	for stage, set in stages do
		local n = #set.movers + #set.spinners + #set.lavas + #set.lasers
		total += n
		if awakeSet[stage] then
			running += n
		end
	end
	return total, running
end

-- Root position inside the box of `part` (grown by `margin` sideways)?
local function inside(part: BasePart, pos: Vector3, margin: number): boolean
	local rel = part.CFrame:PointToObjectSpace(pos)
	local half = part.Size / 2
	return math.abs(rel.X) < half.X + margin and math.abs(rel.Z) < half.Z + margin and rel.Y > -half.Y - 3 and rel.Y < half.Y + 3
end

function Obstacles.init()
	local parts: { BasePart } = {}
	local cframes: { CFrame } = {}
	local sinceAwake = 1
	RunService.Heartbeat:Connect(function(dt)
		sinceAwake += dt
		if sinceAwake >= 0.5 then
			sinceAwake = 0
			refreshAwake()
		end
		local t = Workspace:GetServerTimeNow()
		table.clear(parts)
		table.clear(cframes)
		for _, stage in awake do
			local set = stages[stage]
			if not set then
				continue
			end
			for _, m in set.movers do
				local w = 2 * math.pi / m.period
				local x = t * w + m.phase * 2 * math.pi
				table.insert(parts, m.part)
				table.insert(cframes, m.home + m.axis * (math.sin(x) * m.amp))
				-- velocity = derivative of the path, so humanoids standing on it ride along
				m.part.AssemblyLinearVelocity = m.axis * (math.cos(x) * m.amp * w)
			end
			for _, sp in set.spinners do
				table.insert(parts, sp.part)
				-- wrap in double precision first: CFrame.Angles takes float32, and t (~1.7e9 s) * speed
				-- would otherwise lose all sub-radian precision and the bars would barely move
				table.insert(cframes, CFrame.new(sp.center) * CFrame.Angles(0, (sp.angle0 + t * sp.speed) % (2 * math.pi), 0))
			end
			for _, l in set.lavas do
				-- cycle: 35% low, 40% rising, 10% at peak, 15% draining
				local phase = (t % l.period) / l.period
				local k
				if phase < 0.35 then
					k = 0
				elseif phase < 0.75 then
					k = (phase - 0.35) / 0.4
				elseif phase < 0.85 then
					k = 1
				else
					k = 1 - (phase - 0.85) / 0.15
				end
				local top = l.minTop + (l.maxTop - l.minTop) * k
				local height = math.max(0.5, top - l.bottom)
				local size = l.part.Size
				if math.abs(size.Y - height) > 0.02 then
					l.part.Size = Vector3.new(size.X, height, size.Z)
					local c = l.cf
					l.part.CFrame = CFrame.new(c.Position.X, l.bottom + height / 2, c.Position.Z) * c.Rotation
				end
			end
		end
		if #parts > 0 then
			Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end)

	-- Slow loop (10 Hz): laser gates switch on and off (a property change only when the state
	-- changes), and the kill checks that Touched cannot do: a laser that fires while you stand in
	-- it, lava that rises into a standing character.
	task.spawn(function()
		while true do
			task.wait(0.1)
			local t = Workspace:GetServerTimeNow()
			for _, stage in awake do
				local set = stages[stage]
				if not set or (#set.lasers == 0 and #set.lavas == 0) then
					continue
				end
				for _, l in set.lasers do
					local state = laserState(l, t)
					if state ~= l.state then
						l.state = state
						l.part.Transparency = LASER_LOOK[state]
					end
				end
				for _, player in Players:GetPlayers() do
					local char = player.Character
					local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if not root or not hum or hum.Health <= 0 then
						continue
					end
					for _, l in set.lasers do
						if l.state == 2 and inside(l.part, root.Position, 0.9) then
							Obstacles.kill(player, hum)
						end
					end
					for _, l in set.lavas do
						local top = l.part.Position.Y + l.part.Size.Y / 2
						local rel = l.part.CFrame:PointToObjectSpace(root.Position)
						local half = l.part.Size / 2
						if math.abs(rel.X) < half.X and math.abs(rel.Z) < half.Z and root.Position.Y - 2.5 < top and root.Position.Y > l.bottom - 3 then
							Obstacles.kill(player, hum)
						end
					end
				end
			end
		end
	end)
end

return Obstacles
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">Referrals</string>
          <string name="Source"><![CDATA[--!strict
-- Invites and referral rewards (P0-3).
--   * Invitee joins with LaunchData "ref:<inviterId>" (game invite or share link) and is new
--     (best < 5): +1 free skip +50 coins, remembered in profile.referredBy.
--   * When that invitee first reaches Config.ReferralPayStage, an entry is appended to the
--     inviter's key in a DataStore (works across servers / while the inviter is offline).
--   * The inviter drains the key on join and every 120 s: +1 free skip +100 coins per entry,
--     lifetime cap Config.ReferralMaxRewards.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")

local Config = require(ReplicatedStorage.Shared.Config)
local Referral = require(ReplicatedStorage.Shared.Referral)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local Session = require(script.Parent.Session)

local Referrals = {}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.ReferralStore)
	end)
	if ok then
		store = result
	end
end

type Entry = { u: number, t: number }
local MAX_ENTRIES = 50

-- Applies an invite to a freshly loaded player. Returns true when the invitee gift was given.
function Referrals.applyInvite(player: Player, launchData: any): boolean
	local p = Data.get(player)
	local inviter = Referral.parse(launchData)
	if not p or not inviter or inviter == player.UserId then
		return false
	end
	if p.referredBy ~= 0 or p.best >= Config.ReferralPayStage then
		return false -- only new players, only once
	end
	p.referredBy = inviter
	local gift = Config.ReferralInviteeGift
	p.coins += gift.coins
	p.totalCoins += gift.coins
	p.freeSkips += gift.freeSkips
	Remotes.notify(player, Remotes.M("msg.invited_gift", { coins = gift.coins, n = gift.freeSkips }), "success")
	Session.push(player)
	return true
end

-- Called when the player reaches a new stage: credits the inviter once.
function Referrals.onStage(player: Player, stage: number)
	local p = Data.get(player)
	if not p or p.referredBy == 0 or p.referralPaid or stage < Config.ReferralPayStage then
		return
	end
	p.referralPaid = true
	local inviter = p.referredBy
	local ds = store
	if not ds then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			ds:UpdateAsync(tostring(inviter), function(old: any)
				local list: { Entry } = if type(old) == "table" then old else {}
				for _, e in list do
					if e.u == player.UserId then
						return nil -- already queued
					end
				end
				if #list >= MAX_ENTRIES then
					return nil
				end
				table.insert(list, { u = player.UserId, t = os.time() })
				return list
			end)
		end)
		if not ok then
			warn("[Referrals] queue failed", err)
		end
	end)
end

-- Grants pending referral rewards to an online inviter.
function Referrals.drain(player: Player)
	local p = Data.get(player)
	local ds = store
	if not p or not ds or not Data.isPersistent(player) then
		return
	end
	local taken: { Entry } = {}
	local ok, err = pcall(function()
		ds:UpdateAsync(tostring(player.UserId), function(old: any)
			if type(old) ~= "table" or #old == 0 then
				taken = {}
				return nil
			end
			taken = old
			return {}
		end)
	end)
	if not ok then
		warn("[Referrals] drain failed", err)
		return
	end
	Referrals.grantInviter(player, #taken)
end

-- +gift per referred friend, respecting the lifetime cap. Returns how many were granted.
function Referrals.grantInviter(player: Player, count: number): number
	local p = Data.get(player)
	if not p or count <= 0 then
		return 0
	end
	local room = math.max(0, Config.ReferralMaxRewards - p.referralRewards)
	local n = math.min(count, room)
	if n <= 0 then
		return 0
	end
	local gift = Config.ReferralInviterGift
	p.referralRewards += n
	p.coins += gift.coins * n
	p.totalCoins += gift.coins * n
	p.freeSkips += gift.freeSkips * n
	Remotes.notify(player, Remotes.M("msg.referral_reward", { friends = n, coins = gift.coins * n, n = gift.freeSkips * n }), "success")
	Session.push(player)
	Data.save(player)
	return n
end

function Referrals.onJoin(player: Player)
	local ok, joinData = pcall(function()
		return player:GetJoinData()
	end)
	if ok and type(joinData) == "table" then
		Referrals.applyInvite(player, joinData.LaunchData)
	end
	task.spawn(Referrals.drain, player)
end

function Referrals.init()
	-- "Share link": the link carries the same launch data as a game invite
	Remotes.handle("ShareLink", function(player)
		local ok, err = pcall(function()
			SocialService:PromptLinkSharingAsync(player, {
				LaunchData = Referral.make(player.UserId),
				ExpirationSeconds = 7 * 86400,
			})
		end)
		if not ok then
			warn("[Referrals] link sharing unavailable:", err)
			return false, Remotes.M("err.not_available")
		end
		return true
	end)
	task.spawn(function()
		while true do
			task.wait(120)
			for _, player in Players:GetPlayers() do
				task.spawn(Referrals.drain, player)
			end
		end
	end)
end

return Referrals
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- Creates ReplicatedStorage.Remotes and routes Request(action, payload) to handlers, with a
-- per-player token-bucket rate limit. (Adapted from the huerta-tycoon Remotes service.)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local EVENT_NAMES = {
	"State",
	"Notify",
	"Celebrate",
	"CoinCollected",
	"OpenPanel",
	"Win",
	"OfferSkip", -- P0-1: death streak on a stage -> "Stuck?" card
	"LiveEventUpdate", -- P0-6: (current {id, endsAt}?, next {id, startsAt}?)
	"AskNotifications", -- P0-8: ask for the notification opt-in
	"Gift", -- a tower gift was granted: { id, stage }
	"TowerEnter", -- arrived at the base of a tower through a portal: { tower }
	"Shield", -- a shield absorbed a hit: { left }
}
local events: { [string]: RemoteEvent } = {}
for _, name in EVENT_NAMES do
	local e = Instance.new("RemoteEvent")
	e.Name = name
	e.Parent = folder
	events[name] = e
end

local request = Instance.new("RemoteFunction")
request.Name = "Request"
request.Parent = folder

-- Messages are never English sentences: they are { key, args } specs (see Shared/Locale) that each
-- client translates into its own language. Remotes.M builds one.
export type Msg = { key: string, args: { [string]: any }? }
function Remotes.M(key: string, args: { [string]: any }?): Msg
	return { key = key, args = args }
end
local M = Remotes.M

type Handler = (player: Player, payload: any) -> (boolean, any?, any?)
local handlers: { [string]: Handler } = {}
local budget: { [Player]: { tokens: number, t: number } } = {}
local RATE = 8 -- requests per second sustained
local BURST = 16

function Remotes.handle(action: string, fn: Handler)
	handlers[action] = fn
end

function Remotes.fire(name: string, player: Player, ...: any)
	events[name]:FireClient(player, ...)
end

function Remotes.fireAll(name: string, ...: any)
	events[name]:FireAllClients(...)
end

-- Toast on one client. `msg` = Remotes.M(key, args) (or a list of them).
function Remotes.notify(player: Player, msg: any, kind: string?)
	events.Notify:FireClient(player, msg, kind or "info")
end

function Remotes.forget(player: Player)
	budget[player] = nil
end

request.OnServerInvoke = function(player: Player, action: any, payload: any)
	if type(action) ~= "string" then
		return false, M("err.bad_request")
	end
	local b = budget[player]
	local now = os.clock()
	if not b then
		b = { tokens = BURST, t = now }
		budget[player] = b
	end
	b.tokens = math.min(BURST, b.tokens + (now - b.t) * RATE)
	b.t = now
	if b.tokens < 1 then
		return false, M("err.slow_down")
	end
	b.tokens -= 1
	local fn = handlers[action]
	if not fn then
		return false, M("err.unknown_action")
	end
	if payload ~= nil and type(payload) ~= "table" then
		return false, M("err.bad_request")
	end
	local ok, a, b2, c = pcall(fn, player, payload or {})
	if not ok then
		warn("[Remotes]", action, "error:", a)
		return false, M("err.generic")
	end
	return a, b2, c
end

folder.Parent = ReplicatedStorage

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">Rewards</string>
          <string name="Source"><![CDATA[--!strict
-- Retention rewards: daily streak, codes, and in-session play-time rewards.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Gifts = require(ReplicatedStorage.Shared.Gifts)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local Session = require(script.Parent.Session)

local Rewards = {}

function Rewards.init()
	Remotes.handle("ClaimDaily", function(player)
		local p = Data.get(player)
		if not p then
			return false
		end
		local can, _, day = Session.dailyInfo(p)
		if not can then
			return false, Remotes.M("err.come_back")
		end
		p.daily.streak = day
		p.daily.lastClaim = os.time()
		local reward = Config.DailyRewards[math.min(day, #Config.DailyRewards)]
		if Session.hasPass(player, "VIP") then
			reward *= 2
		end
		reward *= Session.bonusMult(p)
		p.coins += reward
		p.totalCoins += reward
		local msg: { Remotes.Msg } = { Remotes.M("msg.daily", { day = day, coins = reward }) }
		-- day 7 of the streak, plus the stage-600 gift (a free skip with every daily reward)
		local skips = (if day % Config.DailyFreeSkipOnDay == 0 then 1 else 0) + Gifts.dailySkips(p.gifts)
		if skips > 0 then
			p.freeSkips += skips
			table.insert(msg, Remotes.M("msg.plus_free_skips", { n = skips }))
		end
		Session.push(player)
		return true, msg
	end)

	Remotes.handle("RedeemCode", function(player, payload)
		local p = Data.get(player)
		if not p then
			return false
		end
		local code = string.upper((string.gsub(tostring(payload.code or ""), "%s", "")))
		if #code == 0 or #code > 24 then
			return false, Remotes.M("err.invalid_code")
		end
		local c = Config.Codes[code]
		if not c then
			return false, Remotes.M("err.invalid_code")
		end
		if c.expires and os.time() > c.expires then
			return false, Remotes.M("err.code_expired")
		end
		if p.codes[code] then
			return false, Remotes.M("err.already_redeemed")
		end
		p.codes[code] = true
		local coins = c.coins * Session.bonusMult(p)
		p.coins += coins
		p.totalCoins += coins
		local msg: { Remotes.Msg } = { Remotes.M("msg.code", { coins = coins }) }
		if c.freeSkips then
			p.freeSkips += c.freeSkips
			table.insert(msg, Remotes.M("msg.plus_free_skips", { n = c.freeSkips }))
		end
		Session.push(player)
		return true, msg
	end)

	-- Join-the-group reward (P0-7)
	Remotes.handle("ClaimGroupGift", function(player)
		local p = Data.get(player)
		if not p or Config.GroupId == 0 then
			return false, Remotes.M("err.not_available")
		end
		if p.groupGiftClaimed then
			return false, Remotes.M("err.already_claimed")
		end
		local ok, member = pcall(function()
			return player:IsInGroupAsync(Config.GroupId)
		end)
		if not ok then
			ok, member = pcall(function()
				return (player :: any):IsInGroup(Config.GroupId)
			end)
		end
		if not ok or not member then
			return false, Remotes.M("err.join_group_first")
		end
		local gift = Config.GroupGift
		p.groupGiftClaimed = true
		p.coins += gift.coins
		p.totalCoins += gift.coins
		p.freeSkips += gift.freeSkips
		p.trails[gift.trail] = true
		Session.push(player)
		return true, Remotes.M("msg.group_gift", { coins = gift.coins, n = gift.freeSkips })
	end)

	Remotes.handle("ClaimPlaytime", function(player, payload)
		local p = Data.get(player)
		local s = Session.get(player)
		if not p or not s then
			return false
		end
		local idx = tonumber(payload.index)
		local r = idx and Config.PlaytimeRewards[idx]
		if not idx or not r then
			return false, Remotes.M("err.unknown_reward")
		end
		if s.playClaimed[idx] then
			return false, Remotes.M("err.already_claimed")
		end
		if os.clock() - s.joined < r.minutes * 60 then
			return false, Remotes.M("err.keep_playing")
		end
		s.playClaimed[idx] = true
		local got = Session.addCoins(player, r.coins)
		p.freeSkips += r.freeSkips
		Session.push(player)
		local msg: { Remotes.Msg } = { Remotes.M("msg.playtime", { coins = got }) }
		if r.freeSkips > 0 then
			table.insert(msg, Remotes.M("msg.plus_free_skips", { n = r.freeSkips }))
		end
		return true, msg
	end)
end

return Rewards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">Scenery</string>
          <string name="Source"><![CDATA[--!strict
-- Everything you look at but never stand on: floating set pieces per world, ornaments on the core
-- pillar, the halo "gates" between worlds, the lobby island dressing and the props hanging under
-- the platforms. Positions come from the pure Shared/DecorPlan (unit-tested to stay out of the
-- lane); this file only turns them into parts.
--
-- Rules that keep it safe and cheap:
--   * every part made by `deco` is anchored with CanCollide / CanTouch / CanQuery off and no
--     shadow, so scenery can never change how a stage plays or block the camera;
--   * no uploaded assets: Parts, built-in SpecialMesh shapes, native materials and the particle
--     textures that ship with Roblox (rbxasset://);
--   * part / light / emitter counts are capped (checked by the Studio playtest).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.Layout)
local DecorPlan = require(ReplicatedStorage.Shared.DecorPlan)
local TowerStyle = require(ReplicatedStorage.Shared.TowerStyle)
local Gifts = require(ReplicatedStorage.Shared.Gifts)
local Powerups = require(ReplicatedStorage.Shared.Powerups)
local Perks = require(ReplicatedStorage.Shared.Perks)

local ModelSlots = require(script.Parent.World.ModelSlots)

local Scenery = {}

local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local WHITE = rgb(255, 255, 255)
local GOLD = rgb(255, 205, 70)

type Rng = Layout.Rng

---------------------------------------------------------------------------------------------
-- part helpers
---------------------------------------------------------------------------------------------
-- While a list is being recorded, every decoration part made goes into it (see withMood).
local recording: { BasePart }? = nil

local function deco(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Parent = parent
	if recording then
		table.insert(recording, p)
	end
	return p
end
Scenery.deco = deco

-- A part you can stand on (shop decks, the lounge floor, base islands).
local function solid(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = deco(parent, size, cf, color, material)
	p.CanCollide = true
	p.CanQuery = true
	return p
end

-- Runs `build` and then repaints every decoration part it made with the tower's mood (hue /
-- saturation / value shift, Shared/TowerStyle): the scenery of each tower is a different colour
-- in the parts themselves, which still shows with graphics at minimum. Tower 1 is left as is.
local function withMood(tower: number, build: () -> ())
	if tower <= 1 then
		build()
		return
	end
	local outer = recording
	local list: { BasePart } = {}
	recording = list
	build()
	recording = outer
	local mood = TowerStyle.mood(tower)
	for _, part in list do
		local c = part.Color
		local shifted = TowerStyle.shift({ math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }, mood)
		part.Color = Color3.fromRGB(shifted[1], shifted[2], shifted[3])
		if outer then
			table.insert(outer, part)
		end
	end
end
Scenery.withMood = withMood

type LocFn = (label: Instance, key: string, args: { [string]: any }?) -> ()

-- Upright cylinder: `cf` is the centre, Y is the axis.
local function cyl(parent: Instance, diameter: number, height: number, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = deco(parent, Vector3.new(height, diameter, diameter), cf * CFrame.Angles(0, 0, math.pi / 2), color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function ball(parent: Instance, diameter: number, pos: Vector3, color: Color3, material: Enum.Material?): Part
	local p = deco(parent, Vector3.new(diameter, diameter, diameter), CFrame.new(pos), color, material)
	p.Shape = Enum.PartType.Ball
	return p
end

-- Ellipsoid (built-in sphere mesh, no asset): flat clouds, domes, gumdrops.
local function blob(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = deco(parent, size, cf, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

-- Cone pointing up (built-in wedge-free trick: a very tapered FileMesh is an asset, so cones are
-- stacked shrinking cylinders instead).
local function cone(parent: Instance, diameter: number, height: number, base: CFrame, color: Color3, material: Enum.Material?, steps: number?)
	local n = steps or 3
	for i = 1, n do
		local k = 1 - (i - 1) / n
		cyl(parent, diameter * k, height / n, base * CFrame.new(0, (i - 0.5) * height / n, 0), color, material)
	end
end

local lightCount, emitterCount = 0, 0

local function light(parent: BasePart, color: Color3, range: number, brightness: number)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = parent
	lightCount += 1
end

type EmitterOpts = {
	texture: string,
	color: Color3,
	color2: Color3?,
	rate: number,
	life: number,
	speed: number,
	size: number,
	size2: number?,
	spread: number?,
	accel: Vector3?,
	emission: number?,
	transparency: number?,
	face: Enum.NormalId?,
}
local function emitter(parent: BasePart, o: EmitterOpts): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = o.texture
	e.Color = ColorSequence.new(o.color, o.color2 or o.color)
	e.Rate = o.rate
	e.Lifetime = NumberRange.new(o.life * 0.7, o.life)
	e.Speed = NumberRange.new(o.speed * 0.6, o.speed)
	e.Size = NumberSequence.new(o.size, o.size2 or o.size)
	e.SpreadAngle = Vector2.new(o.spread or 20, o.spread or 20)
	e.Acceleration = o.accel or Vector3.zero
	e.LightEmission = o.emission or 0
	local t = o.transparency or 0
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.15, t),
		NumberSequenceKeypoint.new(0.8, t),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.EmissionDirection = o.face or Enum.NormalId.Top
	e.Parent = parent
	emitterCount += 1
	return e
end

-- Floating island: a top disc over rock that tapers to a point.
local function island(parent: Instance, cf: CFrame, r: number, top: Color3, topMat: Enum.Material, rock: Color3, rockMat: Enum.Material?)
	local depth = 2.4 + r * 1.45 -- top of the disc (at cf) down to the tip of the rock
	ModelSlots.spawn("island", cf * CFrame.new(0, -depth, 0), Vector3.new(r * 2, depth, r * 2), parent, function()
		cyl(parent, r * 2, 2.4, cf * CFrame.new(0, -1.2, 0), top, topMat)
		local mat = rockMat or Enum.Material.Slate
		cyl(parent, r * 1.7, r * 0.45, cf * CFrame.new(0, -2.4 - r * 0.225, 0), rock, mat)
		cyl(parent, r * 1.1, r * 0.5, cf * CFrame.new(r * 0.08, -2.4 - r * 0.7, 0), rock:Lerp(Color3.new(), 0.12), mat)
		cyl(parent, r * 0.5, r * 0.5, cf * CFrame.new(r * 0.12, -2.4 - r * 1.2, -r * 0.05), rock:Lerp(Color3.new(), 0.22), mat)
		return nil
	end, { maxParts = 120 })
end

local function tree(parent: Instance, base: CFrame, h: number, trunk: Color3, leaves: Color3, leafMat: Enum.Material?)
	ModelSlots.spawn("tree", base, Vector3.new(h * 0.95, h * 1.725, h * 0.95), parent, function()
		cyl(parent, h * 0.18, h, base * CFrame.new(0, h / 2, 0), trunk, Enum.Material.Wood)
		ball(parent, h * 0.95, (base * CFrame.new(0, h + h * 0.25, 0)).Position, leaves, leafMat or Enum.Material.Grass)
		return nil
	end, { maxParts = 60 })
end

local function pine(parent: Instance, base: CFrame, h: number, leaves: Color3)
	ModelSlots.spawn("pine", base, Vector3.new(h * 0.62, h * 1.05, h * 0.62), parent, function()
		cyl(parent, h * 0.12, h * 0.3, base * CFrame.new(0, h * 0.15, 0), rgb(110, 80, 60), Enum.Material.Wood)
		cone(parent, h * 0.62, h * 0.8, base * CFrame.new(0, h * 0.25, 0), leaves, Enum.Material.Grass, 3)
		return nil
	end, { maxParts = 60 })
end

---------------------------------------------------------------------------------------------
-- outer set pieces, one builder per world. `cf` faces the tower, `r` is the footprint radius.
---------------------------------------------------------------------------------------------
type OuterBuilder = (parent: Instance, cf: CFrame, r: number, variant: number, rng: Rng) -> ()
local Outer: { OuterBuilder } = {}

-- 1 Grassy Hills: meadow islands with trees, one windmill in three
Outer[1] = function(parent, cf, r, variant, rng)
	island(parent, cf, r, rgb(105, 200, 90), Enum.Material.Grass, rgb(140, 105, 75))
	if variant == 3 then
		local h = r * 1.3
		ModelSlots.spawn("windmill", cf, Vector3.new(r * 1.9, r * 2.1, r * 1.9), parent, function()
			cone(parent, r * 0.55, h, cf, rgb(245, 235, 215), Enum.Material.SmoothPlastic, 2)
			cone(parent, r * 0.5, r * 0.35, cf * CFrame.new(0, h, 0), rgb(200, 80, 70), Enum.Material.SmoothPlastic, 2)
			local hub = cf * CFrame.new(0, h * 0.85, -r * 0.3)
			for i = 0, 3 do
				deco(parent, Vector3.new(r * 0.16, r * 0.95, 0.4), hub * CFrame.Angles(0, 0, i * math.pi / 2 + 0.4) * CFrame.new(0, r * 0.5, 0), rgb(250, 245, 235), Enum.Material.Wood)
			end
			return nil
		end)
	else
		for i = 1, 3 do
			local a = rng.range(0, math.pi * 2)
			local d = rng.range(0.15, 0.6) * r
			tree(parent, cf * CFrame.new(math.cos(a) * d, 0, math.sin(a) * d), rng.range(0.35, 0.55) * r, rgb(130, 90, 60), rgb(70, 175, 80):Lerp(rgb(190, 220, 90), rng.next() * 0.5))
		end
		ball(parent, r * 0.3, (cf * CFrame.new(-r * 0.5, r * 0.08, r * 0.3)).Position, rgb(150, 150, 155), Enum.Material.Slate)
	end
end

-- 2 Candy Land: lollipops on frosting islands, cupcakes
Outer[2] = function(parent, cf, r, variant, rng)
	local pinks = { rgb(255, 120, 190), rgb(120, 220, 255), rgb(255, 230, 90), rgb(170, 130, 255) }
	if variant == 3 then
		-- cupcake
		ModelSlots.spawn("cupcake", cf * CFrame.new(0, -r * 0.85, 0), Vector3.new(r * 1.9, r * 2.5, r * 1.9), parent, function()
			cyl(parent, r * 1.5, r * 0.5, cf * CFrame.new(0, -r * 0.15, 0), rgb(255, 230, 150))
			cyl(parent, r * 1.25, r * 0.5, cf * CFrame.new(0, -r * 0.6, 0), rgb(245, 205, 120))
			blob(parent, Vector3.new(r * 1.9, r * 0.8, r * 1.9), cf * CFrame.new(0, r * 0.25, 0), rgb(255, 150, 210))
			blob(parent, Vector3.new(r * 1.35, r * 0.7, r * 1.35), cf * CFrame.new(0, r * 0.7, 0), rgb(255, 245, 250))
			blob(parent, Vector3.new(r * 0.8, r * 0.55, r * 0.8), cf * CFrame.new(0, r * 1.1, 0), rgb(255, 150, 210))
			ball(parent, r * 0.35, (cf * CFrame.new(0, r * 1.45, 0)).Position, rgb(230, 30, 60))
			return nil
		end)
	else
		island(parent, cf, r, rgb(255, 245, 250), Enum.Material.SmoothPlastic, rgb(255, 150, 210), Enum.Material.SmoothPlastic)
		for i = 1, 2 do
			local x = (i - 1.5) * r * 0.8
			local h = rng.range(0.9, 1.4) * r
			local c = pinks[rng.int(1, #pinks)]
			cyl(parent, r * 0.07, h, cf * CFrame.new(x, h / 2, 0), WHITE)
			local face = cf * CFrame.new(x, h + r * 0.3, 0) * CFrame.Angles(math.pi / 2, 0, 0)
			cyl(parent, r * 0.75, r * 0.12, face, c)
			cyl(parent, r * 0.45, r * 0.14, face, WHITE)
			cyl(parent, r * 0.2, r * 0.16, face, c)
		end
		for i = 1, 3 do
			local a = rng.range(0, math.pi * 2)
			blob(parent, Vector3.new(r * 0.26, r * 0.22, r * 0.26), cf * CFrame.new(math.cos(a) * r * 0.6, r * 0.05, math.sin(a) * r * 0.6), pinks[rng.int(1, #pinks)])
		end
	end
end

-- 3 Frozen Peaks: icebergs, snowy islands with pines and a snowman
Outer[3] = function(parent, cf, r, variant, rng)
	if variant == 3 then
		island(parent, cf, r, rgb(245, 250, 255), Enum.Material.Snow, rgb(140, 190, 230), Enum.Material.Ice)
		for i = 1, 3 do
			local a = rng.range(0, math.pi * 2)
			local d = rng.range(0.2, 0.6) * r
			pine(parent, cf * CFrame.new(math.cos(a) * d, 0, math.sin(a) * d), rng.range(0.5, 0.8) * r, rgb(230, 245, 250):Lerp(rgb(70, 140, 110), 0.55))
		end
		local s = cf * CFrame.new(r * 0.5, 0, -r * 0.4)
		ModelSlots.spawn("snowman", s * CFrame.new(0, -r * 0.02, 0), Vector3.new(r * 0.3, r * 0.6, r * 0.3), parent, function()
			ball(parent, r * 0.3, (s * CFrame.new(0, r * 0.13, 0)).Position, WHITE, Enum.Material.Snow)
			ball(parent, r * 0.22, (s * CFrame.new(0, r * 0.34, 0)).Position, WHITE, Enum.Material.Snow)
			ball(parent, r * 0.15, (s * CFrame.new(0, r * 0.5, 0)).Position, WHITE, Enum.Material.Snow)
			return nil
		end, { maxParts = 100 })
	else
		for i = 1, 5 do
			local a = i / 5 * math.pi * 2 + rng.range(-0.3, 0.3)
			local d = if i == 1 then 0 else rng.range(0.3, 0.6) * r
			local h = if i == 1 then r * 1.9 else rng.range(0.7, 1.4) * r
			local w = if i == 1 then r * 0.6 else rng.range(0.3, 0.5) * r
			local shard = deco(parent, Vector3.new(w, h, w), cf * CFrame.new(math.cos(a) * d, h * 0.1, math.sin(a) * d) * CFrame.Angles(rng.range(-0.25, 0.25), rng.range(0, 1.5), rng.range(-0.25, 0.25)), rgb(170, 225, 255):Lerp(WHITE, rng.next() * 0.4), Enum.Material.Ice)
			shard.Transparency = 0.12
		end
		blob(parent, Vector3.new(r * 1.6, r * 0.35, r * 1.6), cf * CFrame.new(0, -r * 0.35, 0), rgb(245, 250, 255), Enum.Material.Snow)
	end
end

-- 4 Desert Ruins: stepped pyramids with a glowing capstone, mesas with broken columns
Outer[4] = function(parent, cf, r, variant, rng)
	local sand = rgb(235, 200, 130)
	local stone = rgb(205, 165, 100)
	if variant == 3 then
		ModelSlots.spawn("pyramid", cf * CFrame.new(0, -r * 1.05, 0), Vector3.new(r * 1.7, r * 2.2, r * 1.7), parent, function()
			for i = 0, 3 do
				local w = r * 1.7 * (1 - i * 0.24)
				deco(parent, Vector3.new(w, r * 0.32, w), cf * CFrame.new(0, -r * 0.4 + i * r * 0.32, 0), if i % 2 == 0 then sand else stone, Enum.Material.Sandstone)
			end
			local cap = deco(parent, Vector3.new(r * 0.3, r * 0.3, r * 0.3), cf * CFrame.new(0, r * 0.95, 0) * CFrame.Angles(0, math.pi / 4, 0), rgb(80, 230, 240), Enum.Material.Neon)
			light(cap, rgb(80, 230, 240), 30, 1.5)
			cyl(parent, r * 1.2, r * 0.5, cf * CFrame.new(0, -r * 0.8, 0), stone:Lerp(Color3.new(), 0.15), Enum.Material.Sandstone)
			return nil
		end)
	else
		island(parent, cf, r, sand, Enum.Material.Sand, rgb(190, 140, 80), Enum.Material.Sandstone)
		local n = 4
		for i = 1, n do
			local x = (i - (n + 1) / 2) * r * 0.42
			local h = if rng.next() < 0.35 then rng.range(0.25, 0.5) * r else r * 0.9
			cyl(parent, r * 0.16, h, cf * CFrame.new(x, h / 2, 0), rgb(240, 220, 175), Enum.Material.Sandstone)
			if h > r * 0.8 then
				deco(parent, Vector3.new(r * 0.24, r * 0.08, r * 0.24), cf * CFrame.new(x, h + r * 0.04, 0), stone, Enum.Material.Sandstone)
			end
		end
		deco(parent, Vector3.new(r * 0.9, r * 0.12, r * 0.22), cf * CFrame.new(-r * 0.2, r * 1.0, 0), stone, Enum.Material.Sandstone)
		-- a palm
		local p = cf * CFrame.new(r * 0.55, 0, r * 0.45)
		cyl(parent, r * 0.07, r * 0.7, p * CFrame.new(0, r * 0.35, 0) * CFrame.Angles(0, 0, 0.12), rgb(150, 110, 70), Enum.Material.Wood)
		for i = 0, 3 do
			deco(parent, Vector3.new(r * 0.5, 0.3, r * 0.13), p * CFrame.new(0, r * 0.72, 0) * CFrame.Angles(0, i * math.pi / 2, -0.35) * CFrame.new(r * 0.22, 0, 0), rgb(70, 170, 90), Enum.Material.Grass)
		end
	end
end

-- 5 Lava Caves: volcanic rocks with a lava pool, basalt spikes with glowing cores
Outer[5] = function(parent, cf, r, variant, rng)
	local basalt = rgb(62, 54, 60)
	local lava = rgb(255, 110, 25)
	if variant == 3 then
		for i = 1, 5 do
			local a = i / 5 * math.pi * 2
			local d = if i == 1 then 0 else rng.range(0.35, 0.6) * r
			local h = if i == 1 then r * 2 else rng.range(0.8, 1.5) * r
			local w = if i == 1 then r * 0.55 else rng.range(0.25, 0.42) * r
			local tilt = CFrame.Angles(rng.range(-0.2, 0.2), rng.range(0, 1.5), rng.range(-0.2, 0.2))
			deco(parent, Vector3.new(w, h, w), cf * CFrame.new(math.cos(a) * d, 0, math.sin(a) * d) * tilt, basalt, Enum.Material.Basalt)
			if i <= 2 then
				deco(parent, Vector3.new(w * 0.24, h * 0.8, w + 0.2), cf * CFrame.new(math.cos(a) * d, 0, math.sin(a) * d) * tilt, lava, Enum.Material.Neon)
			end
		end
	else
		cyl(parent, r * 1.9, r * 0.5, cf * CFrame.new(0, -r * 0.25, 0), basalt, Enum.Material.Basalt)
		cyl(parent, r * 1.2, r * 0.6, cf * CFrame.new(0, -r * 0.8, 0), basalt:Lerp(Color3.new(), 0.2), Enum.Material.Basalt)
		cyl(parent, r * 0.5, r * 0.5, cf * CFrame.new(r * 0.1, -r * 1.3, 0), basalt:Lerp(Color3.new(), 0.3), Enum.Material.Basalt)
		local pool = cyl(parent, r * 1.2, 0.5, cf * CFrame.new(0, 0.1, 0), lava, Enum.Material.Neon)
		light(pool, lava, 36, 2)
		emitter(pool, { texture = FIRE, color = rgb(255, 190, 60), color2 = rgb(255, 60, 20), rate = 5, life = 2.2, speed = 7, size = 1.6, size2 = 0.2, spread = 25, emission = 1 })
		-- a lava fall off the edge
		deco(parent, Vector3.new(r * 0.22, r * 1.5, 0.5), cf * CFrame.new(0, -r * 0.75, -r * 0.93), lava, Enum.Material.Neon)
		for i = 1, 3 do
			local a = i * 2.1
			deco(parent, Vector3.new(r * 0.28, rng.range(0.4, 0.8) * r, r * 0.28), cf * CFrame.new(math.cos(a) * r * 0.78, r * 0.2, math.sin(a) * r * 0.78) * CFrame.Angles(0.15, a, 0.1), basalt:Lerp(Color3.new(), 0.1), Enum.Material.Basalt)
		end
	end
end

-- 6 Ocean Reef: coral rocks with bubbles, giant jellyfish
Outer[6] = function(parent, cf, r, variant, rng)
	local corals = { rgb(255, 120, 140), rgb(255, 170, 80), rgb(190, 110, 255), rgb(255, 230, 120) }
	if variant == 3 then
		local c = corals[rng.int(1, #corals)]
		local dome = blob(parent, Vector3.new(r * 1.5, r * 0.9, r * 1.5), cf * CFrame.new(0, r * 0.4, 0), c, Enum.Material.Neon)
		dome.Transparency = 0.35
		blob(parent, Vector3.new(r * 1.0, r * 0.5, r * 1.0), cf * CFrame.new(0, r * 0.35, 0), WHITE, Enum.Material.Neon).Transparency = 0.5
		for i = 1, 6 do
			local a = i / 6 * math.pi * 2
			local h = rng.range(1.0, 1.9) * r
			local tentacle = deco(parent, Vector3.new(r * 0.07, h, r * 0.07), cf * CFrame.new(math.cos(a) * r * 0.42, r * 0.2 - h / 2, math.sin(a) * r * 0.42) * CFrame.Angles(rng.range(-0.12, 0.12), 0, rng.range(-0.12, 0.12)), c:Lerp(WHITE, 0.3), Enum.Material.Neon)
			tentacle.Transparency = 0.3
		end
		light(dome, c, 28, 1.2)
	else
		blob(parent, Vector3.new(r * 2, r * 0.9, r * 2), cf * CFrame.new(0, -r * 0.3, 0), rgb(235, 215, 170), Enum.Material.Sand)
		blob(parent, Vector3.new(r * 1.2, r * 1.1, r * 1.2), cf * CFrame.new(r * 0.1, -r * 0.8, 0), rgb(90, 140, 150), Enum.Material.Slate)
		for i = 1, 4 do
			local a = i / 4 * math.pi * 2 + rng.range(-0.4, 0.4)
			local base = cf * CFrame.new(math.cos(a) * r * 0.5, 0, math.sin(a) * r * 0.5)
			local c = corals[rng.int(1, #corals)]
			local h = rng.range(0.5, 0.9) * r
			for j = -1, 1 do
				cyl(parent, r * 0.1, h * (1 - math.abs(j) * 0.25), base * CFrame.Angles(0, 0, j * 0.45) * CFrame.new(0, h * 0.45, 0), c)
			end
		end
		-- seaweed + bubbles
		for i = 1, 2 do
			deco(parent, Vector3.new(r * 0.12, r * 1.3, 0.3), cf * CFrame.new((i - 1.5) * r * 0.5, r * 0.5, r * 0.3) * CFrame.Angles(0.1, i, 0.1), rgb(50, 170, 120), Enum.Material.Grass)
		end
		local src = deco(parent, Vector3.new(r * 0.8, 0.4, r * 0.8), cf * CFrame.new(0, r * 0.2, 0), WHITE)
		src.Transparency = 1
		emitter(src, { texture = SPARKLES, color = rgb(220, 250, 255), rate = 4, life = 4, speed = 6, size = 0.9, size2 = 1.6, spread = 12, emission = 0.6, transparency = 0.3 })
	end
end

-- 7 Toxic Factory: smokestack platforms, goo tanks
Outer[7] = function(parent, cf, r, variant, rng)
	local steel = rgb(110, 118, 128)
	local goo = rgb(170, 255, 60)
	if variant == 3 then
		local tank = cyl(parent, r * 1.2, r * 1.5, cf * CFrame.new(0, r * 0.2, 0), steel, Enum.Material.Metal)
		cyl(parent, r * 1.25, r * 0.5, cf * CFrame.new(0, r * 0.2, 0), goo, Enum.Material.Neon)
		cyl(parent, r * 1.3, r * 0.12, cf * CFrame.new(0, r * 0.97, 0), rgb(70, 75, 85), Enum.Material.DiamondPlate)
		cyl(parent, r * 1.3, r * 0.12, cf * CFrame.new(0, -r * 0.57, 0), rgb(70, 75, 85), Enum.Material.DiamondPlate)
		-- pipe to nowhere
		cyl(parent, r * 0.2, r * 1.2, cf * CFrame.new(r * 0.8, -r * 0.2, 0), rgb(200, 170, 60), Enum.Material.Metal)
		deco(parent, Vector3.new(r * 0.5, r * 0.2, r * 0.2), cf * CFrame.new(r * 0.62, r * 0.4, 0), rgb(200, 170, 60), Enum.Material.Metal)
		-- drip
		deco(parent, Vector3.new(r * 0.12, r * 1.1, r * 0.12), cf * CFrame.new(0, -r * 1.15, 0), goo, Enum.Material.Neon)
		light(tank, goo, 30, 1.4)
	else
		deco(parent, Vector3.new(r * 1.8, r * 0.18, r * 1.4), cf * CFrame.new(0, -r * 0.09, 0), steel, Enum.Material.DiamondPlate)
		deco(parent, Vector3.new(r * 1.5, r * 0.5, r * 1.1), cf * CFrame.new(0, -r * 0.43, 0), rgb(80, 86, 96), Enum.Material.Metal)
		-- hazard stripe along the front edge
		for i = -3, 3 do
			deco(parent, Vector3.new(r * 0.24, r * 0.2, 0.3), cf * CFrame.new(i * r * 0.25, -r * 0.09, -r * 0.71), if i % 2 == 0 then rgb(255, 215, 40) else rgb(35, 35, 40))
		end
		for i = 1, 2 do
			local x = (i - 1.5) * r * 0.9
			local h = rng.range(1.2, 1.9) * r
			local stack = cyl(parent, r * 0.36, h, cf * CFrame.new(x, h / 2, 0), rgb(150, 90, 70), Enum.Material.Brick)
			cyl(parent, r * 0.4, r * 0.18, cf * CFrame.new(x, h * 0.75, 0), rgb(240, 240, 240))
			cyl(parent, r * 0.4, r * 0.18, cf * CFrame.new(x, h * 0.75 - r * 0.2, 0), rgb(220, 60, 60))
			if i == 1 then
				local top = deco(parent, Vector3.new(r * 0.3, 0.4, r * 0.3), cf * CFrame.new(x, h, 0), WHITE)
				top.Transparency = 1
				emitter(top, { texture = SMOKE, color = rgb(170, 220, 90), color2 = rgb(90, 110, 70), rate = 3, life = 5, speed = 6, size = 3, size2 = 9, spread = 10, transparency = 0.45 })
			end
			stack.Name = "Stack"
		end
		-- barrels
		for i = 1, 3 do
			cyl(parent, r * 0.2, r * 0.28, cf * CFrame.new(rng.range(-0.6, 0.6) * r, r * 0.14, r * 0.45), if i == 2 then goo else rgb(255, 215, 40), if i == 2 then Enum.Material.Neon else Enum.Material.Metal)
		end
	end
end

-- 8 Cloud Kingdom: golden towers on clouds, cloud gates
Outer[8] = function(parent, cf, r, variant, rng)
	local function cloud(at: CFrame, s: number)
		blob(parent, Vector3.new(s * 2, s * 0.7, s * 1.5), at, WHITE)
		blob(parent, Vector3.new(s * 1.2, s * 0.8, s * 1.1), at * CFrame.new(-s * 0.55, s * 0.18, s * 0.1), WHITE)
		blob(parent, Vector3.new(s * 1.3, s * 0.9, s * 1.2), at * CFrame.new(s * 0.5, s * 0.2, -s * 0.1), rgb(240, 244, 255))
		blob(parent, Vector3.new(s * 0.9, s * 0.6, s * 0.9), at * CFrame.new(0, s * 0.36, 0), WHITE)
	end
	cloud(cf * CFrame.new(0, -r * 0.2, 0), r)
	if variant == 3 then
		for _, x in { -r * 0.45, r * 0.45 } do
			cyl(parent, r * 0.2, r * 1.2, cf * CFrame.new(x, r * 0.6, 0), WHITE, Enum.Material.Marble)
			ball(parent, r * 0.26, (cf * CFrame.new(x, r * 1.28, 0)).Position, GOLD, Enum.Material.Neon)
		end
		deco(parent, Vector3.new(r * 1.2, r * 0.16, r * 0.26), cf * CFrame.new(0, r * 1.1, 0), GOLD, Enum.Material.SmoothPlastic)
	else
		local h = rng.range(1.1, 1.6) * r
		local tower = cyl(parent, r * 0.5, h, cf * CFrame.new(0, h / 2, 0), WHITE, Enum.Material.Marble)
		cyl(parent, r * 0.58, r * 0.1, cf * CFrame.new(0, h * 0.62, 0), GOLD)
		cyl(parent, r * 0.66, r * 0.12, cf * CFrame.new(0, h, 0), rgb(235, 238, 250), Enum.Material.Marble)
		cone(parent, r * 0.62, r * 0.7, cf * CFrame.new(0, h + r * 0.06, 0), rgb(120, 170, 255), Enum.Material.SmoothPlastic, 3)
		ball(parent, r * 0.12, (cf * CFrame.new(0, h + r * 0.82, 0)).Position, GOLD, Enum.Material.Neon)
		-- glowing windows
		for i = 0, 1 do
			deco(parent, Vector3.new(r * 0.1, r * 0.2, r * 0.52), cf * CFrame.new(0, h * (0.35 + i * 0.4), 0) * CFrame.Angles(0, i * math.pi / 2, 0), rgb(255, 230, 140), Enum.Material.Neon)
		end
		tower.Name = "CloudTower"
	end
end

-- 9 Neon Space: ringed planets with a moon, neon crystal frames
Outer[9] = function(parent, cf, r, variant, rng)
	local neons = { rgb(0, 255, 230), rgb(255, 60, 220), rgb(255, 240, 80), rgb(120, 110, 255) }
	local c = neons[rng.int(1, #neons)]
	if variant == 3 then
		-- wireframe cube: 12 neon edges
		local s = r * 1.1
		local tilt = cf * CFrame.Angles(0.5, 0.7, 0.2)
		for _, axis in { "x", "y", "z" } do
			for _, a in { -1, 1 } do
				for _, b in { -1, 1 } do
					local size, offset
					if axis == "x" then
						size, offset = Vector3.new(s, 0.5, 0.5), Vector3.new(0, a * s / 2, b * s / 2)
					elseif axis == "y" then
						size, offset = Vector3.new(0.5, s, 0.5), Vector3.new(a * s / 2, 0, b * s / 2)
					else
						size, offset = Vector3.new(0.5, 0.5, s), Vector3.new(a * s / 2, b * s / 2, 0)
					end
					deco(parent, size, tilt * CFrame.new(offset), c, Enum.Material.Neon)
				end
			end
		end
		local core = ball(parent, s * 0.35, tilt.Position, neons[rng.int(1, #neons)], Enum.Material.Neon)
		light(core, c, 34, 1.6)
	else
		local planet = ball(parent, r * 1.3, cf.Position, rgb(60, 45, 120):Lerp(c, 0.35), Enum.Material.SmoothPlastic)
		blob(parent, Vector3.new(r * 0.5, r * 0.3, r * 0.5), cf * CFrame.new(r * 0.3, r * 0.45, -r * 0.35), c, Enum.Material.Neon).Transparency = 0.2
		local tilt = cf * CFrame.Angles(rng.range(0.2, 0.5), 0, rng.range(-0.4, 0.4))
		local ring = cyl(parent, r * 2.4, 0.4, tilt, c, Enum.Material.Neon)
		ring.Transparency = 0.45
		cyl(parent, r * 1.9, 0.5, tilt, rgb(255, 255, 255), Enum.Material.Neon).Transparency = 0.7
		ball(parent, r * 0.3, (cf * CFrame.new(r * 1.2, r * 0.7, 0)).Position, rgb(220, 220, 235), Enum.Material.Slate)
		light(planet, c, 30, 1)
	end
end

-- 10 Rainbow Summit: rainbow arches, golden crystal islands
Outer[10] = function(parent, cf, r, variant, rng)
	local bands = { rgb(255, 80, 90), rgb(255, 190, 50), rgb(90, 220, 110), rgb(80, 160, 255), rgb(190, 100, 255) }
	if variant == 1 then
		local segs = 9
		for b, color in bands do
			local radius = r * (1.0 - (b - 1) * 0.11)
			for i = 0, segs - 1 do
				local a = (i + 0.5) / segs * math.pi
				local len = math.pi * radius / segs * 1.08
				local seg = deco(parent, Vector3.new(len, r * 0.1, r * 0.16), cf * CFrame.new(math.cos(a) * radius, math.sin(a) * radius - r * 0.4, 0) * CFrame.Angles(0, 0, a + math.pi / 2), color, Enum.Material.Neon)
				seg.Transparency = 0.15
			end
		end
		for _, x in { -r * 0.85, r * 0.85 } do
			blob(parent, Vector3.new(r * 0.9, r * 0.4, r * 0.7), cf * CFrame.new(x, -r * 0.4, 0), WHITE)
		end
	else
		island(parent, cf, r * 0.85, rgb(255, 215, 90), Enum.Material.SmoothPlastic, rgb(255, 150, 130), Enum.Material.SmoothPlastic)
		for i = 1, 5 do
			local a = i / 5 * math.pi * 2
			local d = if i == 1 then 0 else r * 0.42
			local h = if i == 1 then r * 1.5 else rng.range(0.5, 1.0) * r
			local w = if i == 1 then r * 0.3 else r * 0.18
			local crystal = deco(parent, Vector3.new(w, h, w), cf * CFrame.new(math.cos(a) * d, h * 0.4, math.sin(a) * d) * CFrame.Angles(rng.range(-0.3, 0.3), a, rng.range(-0.3, 0.3)), bands[((i - 1) % #bands) + 1], Enum.Material.Neon)
			crystal.Transparency = 0.1
			if i == 1 then
				light(crystal, WHITE, 34, 1.5)
				emitter(crystal, { texture = SPARKLES, color = rgb(255, 240, 150), color2 = rgb(255, 130, 220), rate = 5, life = 2.5, speed = 4, size = 1.2, size2 = 0.2, spread = 180, emission = 0.9 })
			end
		end
	end
end

---------------------------------------------------------------------------------------------
-- core ornaments. `cf` sits on the pillar surface: -Z points into the pillar, +Y is up.
---------------------------------------------------------------------------------------------
type CoreBuilder = (parent: Instance, cf: CFrame, s: number, variant: number, rng: Rng) -> ()
local Core: { CoreBuilder } = {}

-- Axis of the tower being built (core ornaments that wrap the whole pillar are centred on it).
local towerAxis = Vector3.zero

local function ringBand(parent: Instance, y: number, thickness: number, extra: number, color: Color3, material: Enum.Material?): Part
	return cyl(parent, Layout.CORE_RADIUS * 2 + extra, thickness, CFrame.new(towerAxis.X, y, towerAxis.Z), color, material)
end

Core[1] = function(parent, cf, s, variant, rng)
	-- vines with leaves; sometimes a mushroom shelf
	local h = s * 3
	deco(parent, Vector3.new(0.7, h, 0.5), cf * CFrame.new(0, 0, 0.2) * CFrame.Angles(0, 0, rng.range(-0.15, 0.15)), rgb(60, 150, 70), Enum.Material.Grass)
	for i = 1, 3 do
		ball(parent, rng.range(1.6, 2.6), (cf * CFrame.new(rng.range(-1.5, 1.5), (i - 2) * h * 0.3, 1)).Position, rgb(80, 185, 85):Lerp(rgb(255, 170, 200), if rng.next() < 0.3 then 0.8 else 0), Enum.Material.Grass)
	end
	if variant == 3 then
		cyl(parent, s * 1.1, 0.8, cf * CFrame.new(0, -h * 0.4, s * 0.4), rgb(230, 80, 70))
		cyl(parent, s * 0.3, 1.4, cf * CFrame.new(0, -h * 0.4 - 1, s * 0.3), rgb(245, 235, 215))
	end
end

Core[2] = function(parent, cf, s, variant, rng)
	if variant == 1 then
		ringBand(parent, cf.Position.Y, 2.2, 1.2, rgb(255, 250, 252))
		ringBand(parent, cf.Position.Y + 3, 1.2, 0.9, rgb(120, 220, 255))
	else
		local colors = { rgb(255, 90, 120), rgb(120, 220, 255), rgb(255, 230, 90), rgb(150, 230, 120) }
		for i = 1, 4 do
			blob(parent, Vector3.new(s * 0.5, s * 0.5, s * 0.4), cf * CFrame.new(rng.range(-s, s) * 0.6, rng.range(-s, s) * 0.6, 0.3), colors[rng.int(1, #colors)])
		end
	end
end

Core[3] = function(parent, cf, s, variant, rng)
	-- snowy ledge with icicles
	blob(parent, Vector3.new(s * 1.6, 1.6, s * 0.9), cf * CFrame.new(0, 0, s * 0.3), rgb(245, 250, 255), Enum.Material.Snow)
	for i = 1, 4 do
		local h = rng.range(0.5, 1.4) * s
		local x = (i - 2.5) * s * 0.36
		local ice = deco(parent, Vector3.new(0.9, h * 0.6, 0.9), cf * CFrame.new(x, -0.6 - h * 0.3, s * 0.35), rgb(190, 235, 255), Enum.Material.Ice)
		ice.Transparency = 0.15
		deco(parent, Vector3.new(0.45, h * 0.5, 0.45), cf * CFrame.new(x, -0.6 - h * 0.6 - h * 0.25, s * 0.35), rgb(215, 245, 255), Enum.Material.Ice).Transparency = 0.2
	end
end

Core[4] = function(parent, cf, s, variant, rng)
	if variant == 1 then
		ringBand(parent, cf.Position.Y, 2.5, 1.6, rgb(200, 160, 100), Enum.Material.Sandstone)
	else
		-- a carved tablet with glowing glyph bars
		deco(parent, Vector3.new(s * 1.2, s * 1.6, 0.8), cf * CFrame.new(0, 0, 0.3), rgb(235, 205, 145), Enum.Material.Sandstone)
		for i = 1, 3 do
			deco(parent, Vector3.new(rng.range(0.4, 0.85) * s, s * 0.14, 0.3), cf * CFrame.new(0, (i - 2) * s * 0.42, 0.85), rgb(80, 225, 235), Enum.Material.Neon)
		end
	end
end

Core[5] = function(parent, cf, s, variant, rng)
	-- glowing cracks in the rock, some dripping embers
	local x = 0
	local y = s * 1.2
	local crackA: Part? = nil
	for i = 1, 4 do
		local len = rng.range(0.5, 0.9) * s
		local a = rng.range(-0.7, 0.7)
		local part = deco(parent, Vector3.new(0.6, len, 0.4), cf * CFrame.new(x + math.sin(a) * len / 2, y - math.cos(a) * len / 2, 0.12) * CFrame.Angles(0, 0, a), rgb(255, 120, 30), Enum.Material.Neon)
		crackA = crackA or part
		x += math.sin(a) * len
		y -= math.cos(a) * len
	end
	if variant == 3 and crackA then
		light(crackA, rgb(255, 120, 40), 22, 1.6)
		emitter(crackA, { texture = FIRE, color = rgb(255, 200, 80), color2 = rgb(255, 70, 20), rate = 3, life = 1.8, speed = 3, size = 0.9, size2 = 0.1, spread = 40, emission = 1, accel = Vector3.new(0, 3, 0), face = Enum.NormalId.Back })
	end
end

Core[6] = function(parent, cf, s, variant, rng)
	local corals = { rgb(255, 120, 140), rgb(255, 170, 80), rgb(190, 110, 255) }
	if variant == 1 then
		-- seaweed
		for i = 1, 3 do
			deco(parent, Vector3.new(0.9, rng.range(1.5, 2.6) * s, 0.4), cf * CFrame.new((i - 2) * 1.6, 0, 0.5) * CFrame.Angles(0, 0, rng.range(-0.2, 0.2)), rgb(50, 170, 120):Lerp(rgb(120, 220, 140), rng.next()), Enum.Material.Grass)
		end
	else
		local c = corals[rng.int(1, #corals)]
		for j = -1, 1 do
			-- tilted out of the pillar (+Z) and fanned sideways
			cyl(parent, 0.8, s * (1.1 - math.abs(j) * 0.3), cf * CFrame.Angles(0.9, 0, j * 0.45) * CFrame.new(0, s * 0.5, 0), c)
		end
		ball(parent, s * 0.35, (cf * CFrame.new(s * 0.5, -s * 0.3, 0.3)).Position, rgb(255, 230, 150), Enum.Material.Sand)
	end
end

Core[7] = function(parent, cf, s, variant, rng)
	if variant == 1 then
		-- hazard band
		ringBand(parent, cf.Position.Y, 1.6, 1.0, rgb(255, 215, 40))
		ringBand(parent, cf.Position.Y + 1.6, 1.6, 1.0, rgb(35, 35, 40))
	else
		-- a pipe with an elbow and a goo drip
		local h = s * 3
		cyl(parent, 1.6, h, cf * CFrame.new(0, 0, 1.6), rgb(140, 148, 158), Enum.Material.Metal)
		cyl(parent, 2.1, 0.8, cf * CFrame.new(0, h * 0.3, 1.6), rgb(200, 170, 60), Enum.Material.Metal)
		cyl(parent, 2.1, 0.8, cf * CFrame.new(0, -h * 0.3, 1.6), rgb(200, 170, 60), Enum.Material.Metal)
		deco(parent, Vector3.new(0.5, s * 0.9, 0.5), cf * CFrame.new(0, -h / 2 - s * 0.45, 1.6), rgb(170, 255, 60), Enum.Material.Neon)
	end
end

Core[8] = function(parent, cf, s, variant, rng)
	if variant == 1 then
		ringBand(parent, cf.Position.Y, 1.2, 1.4, GOLD)
	else
		blob(parent, Vector3.new(s * 1.8, s * 0.8, s * 1.1), cf * CFrame.new(0, 0, s * 0.2), WHITE)
		blob(parent, Vector3.new(s * 1.1, s * 0.7, s * 0.9), cf * CFrame.new(-s * 0.6, s * 0.2, s * 0.3), WHITE)
		blob(parent, Vector3.new(s * 1.0, s * 0.6, s * 0.9), cf * CFrame.new(s * 0.6, s * 0.1, s * 0.3), rgb(235, 240, 255))
	end
end

Core[9] = function(parent, cf, s, variant, rng)
	local neons = { rgb(0, 255, 230), rgb(255, 60, 220), rgb(255, 240, 80) }
	if variant == 1 then
		ringBand(parent, cf.Position.Y, 0.7, 0.8, neons[rng.int(1, #neons)], Enum.Material.Neon)
	else
		-- circuit lines
		local c = neons[rng.int(1, #neons)]
		local h = s * 2.5
		deco(parent, Vector3.new(0.5, h, 0.3), cf * CFrame.new(0, 0, 0.1), c, Enum.Material.Neon)
		deco(parent, Vector3.new(s * 0.7, 0.5, 0.3), cf * CFrame.new(s * 0.35, h / 2, 0.1), c, Enum.Material.Neon)
		deco(parent, Vector3.new(1.4, 1.4, 0.4), cf * CFrame.new(s * 0.7, h / 2, 0.1), c, Enum.Material.Neon)
		deco(parent, Vector3.new(1.4, 1.4, 0.4), cf * CFrame.new(0, -h / 2, 0.1), c, Enum.Material.Neon)
	end
end

Core[10] = function(parent, cf, s, variant, rng)
	local bands = { rgb(255, 80, 90), rgb(255, 190, 50), rgb(255, 240, 90), rgb(90, 220, 110), rgb(80, 160, 255), rgb(190, 100, 255) }
	if variant == 1 then
		for i, c in bands do
			ringBand(parent, cf.Position.Y + (i - 1) * 0.9, 0.9, 1.0, c, Enum.Material.Neon).Transparency = 0.1
		end
	else
		-- a golden star: two crossed diamonds
		for i = 0, 1 do
			deco(parent, Vector3.new(s * 0.7, s * 0.7, 0.5), cf * CFrame.new(0, 0, 0.4) * CFrame.Angles(0, 0, i * math.pi / 4), GOLD, Enum.Material.Neon)
		end
	end
end

---------------------------------------------------------------------------------------------
-- halo between two worlds
---------------------------------------------------------------------------------------------
local function buildRing(parent: Instance, axis: Vector3, y: number, theme: Config.Theme)
	local n = 24
	local radius = DecorPlan.RING_RADIUS
	local len = 2 * math.pi * radius / n
	for i = 1, n do
		local a = i / n * math.pi * 2
		local seg = deco(parent, Vector3.new(2, 2, len * 1.02), CFrame.new(axis + Vector3.new(math.cos(a) * radius, y, math.sin(a) * radius)) * CFrame.Angles(0, -a, 0), if i % 2 == 0 then theme.accent else theme.pad, Enum.Material.Neon)
		seg.Transparency = 0.45
		seg.Name = "Halo"
	end
end

---------------------------------------------------------------------------------------------
-- public: tower scenery
---------------------------------------------------------------------------------------------
export type Stats = { parts: number, lights: number, emitters: number, outer: number, core: number, rings: number }

-- Floating set pieces, core ornaments and halos of one tower. Tower 1 (always built, seen from
-- the lobby) gets the full set; the towers built on demand get a lighter one.
function Scenery.buildTower(parent: Instance, map: Layout.Map): Stats
	local folder = Instance.new("Folder")
	folder.Name = "Scenery"
	local t = map.tower
	local axis = Vector3.new(map.origin.x, map.origin.y, map.origin.z)
	towerAxis = axis
	local padY: { [number]: number } = {}
	for k, p in map.pads do
		padY[k] = p.y
	end
	local pieces = DecorPlan.generate(Config.MapSeed, padY, Layout, {
		tower = t,
		outer = if t == 1 then nil else 6,
		core = if t == 1 then nil else 8,
	})
	local lights0, emitters0 = lightCount, emitterCount
	local nOuter, nCore, nRing = 0, 0, 0
	local function styleOf(slot: number): number
		return Layout.themeFor((t - 1) * Layout.STAGES + (slot - 1) * 10 + 1)
	end
	withMood(t, function()
		for _, piece in pieces do
			local group = Instance.new("Model")
			group.Name = ("%s_w%d"):format(piece.kind, piece.world)
			group:SetAttribute("World", piece.world)
			local rng = Layout.newRng(piece.seed)
			local pos = axis + Vector3.new(piece.x, piece.y, piece.z)
			local style = styleOf(piece.world)
			if piece.kind == "outer" then
				local cf = CFrame.lookAt(pos, Vector3.new(axis.X, pos.Y, axis.Z))
				Outer[style](group, cf, piece.size * 0.62, piece.variant, rng)
				nOuter += 1
			elseif piece.kind == "core" then
				-- on the pillar surface, looking away from the axis (so +Z of `cf` sticks out)
				local out = Vector3.new(piece.x, 0, piece.z).Unit
				local cf = CFrame.lookAt(pos, pos - out)
				Core[style](group, cf, piece.size * 0.5, piece.variant, rng)
				nCore += 1
			end
			group.Parent = folder
		end
	end)
	-- halos are painted with the (already shifted) theme of the world they open
	for _, piece in pieces do
		if piece.kind == "ring" then
			local group = Instance.new("Model")
			group.Name = "ring_w" .. piece.world
			buildRing(group, axis, piece.y, Config.theme(t, styleOf(piece.world)))
			group.Parent = folder
			nRing += 1
		end
	end
	folder.Parent = parent
	local parts = 0
	for _, d in folder:GetDescendants() do
		if d:IsA("BasePart") then
			parts += 1
		end
	end
	return { parts = parts, lights = lightCount - lights0, emitters = emitterCount - emitters0, outer = nOuter, core = nCore, rings = nRing }
end

---------------------------------------------------------------------------------------------
-- public: under-platform dressing (darker skirt + a themed prop hanging below)
---------------------------------------------------------------------------------------------
local HANG: { (parent: Instance, cf: CFrame, w: number, rng: Rng) -> () } = {
	-- 1 roots
	function(parent, cf, w, rng)
		for i = 1, 2 do
			local h = rng.range(1.2, 2.6)
			deco(parent, Vector3.new(0.35, h, 0.35), cf * CFrame.new(rng.range(-w, w) * 0.3, -h / 2, rng.range(-w, w) * 0.3) * CFrame.Angles(0, 0, rng.range(-0.2, 0.2)), rgb(120, 85, 55), Enum.Material.Wood)
		end
	end,
	-- 2 frosting drips
	function(parent, cf, w, rng)
		for i = 1, 2 do
			local h = rng.range(0.8, 1.8)
			local x, z = rng.range(-w, w) * 0.32, rng.range(-w, w) * 0.32
			deco(parent, Vector3.new(0.6, h, 0.6), cf * CFrame.new(x, -h / 2, z), rgb(255, 245, 250))
			ball(parent, 0.9, (cf * CFrame.new(x, -h, z)).Position, rgb(255, 245, 250))
		end
	end,
	-- 3 icicles
	function(parent, cf, w, rng)
		for i = 1, 3 do
			local h = rng.range(1, 2.4)
			local x, z = rng.range(-w, w) * 0.34, rng.range(-w, w) * 0.34
			deco(parent, Vector3.new(0.55, h * 0.6, 0.55), cf * CFrame.new(x, -h * 0.3, z), rgb(200, 238, 255), Enum.Material.Ice).Transparency = 0.15
			deco(parent, Vector3.new(0.28, h * 0.5, 0.28), cf * CFrame.new(x, -h * 0.85, z), rgb(225, 246, 255), Enum.Material.Ice).Transparency = 0.2
		end
	end,
	-- 4 crumbling bricks
	function(parent, cf, w, rng)
		for i = 1, 2 do
			deco(parent, Vector3.new(rng.range(0.8, 1.4), rng.range(0.6, 1.1), rng.range(0.8, 1.4)), cf * CFrame.new(rng.range(-w, w) * 0.3, -rng.range(0.3, 0.9), rng.range(-w, w) * 0.3) * CFrame.Angles(rng.range(-0.3, 0.3), rng.range(0, 1.5), 0), rgb(205, 165, 100), Enum.Material.Sandstone)
		end
	end,
	-- 5 glowing stalactite
	function(parent, cf, w, rng)
		local h = rng.range(1.4, 2.6)
		deco(parent, Vector3.new(1.0, h * 0.6, 1.0), cf * CFrame.new(0, -h * 0.3, 0), rgb(62, 54, 60), Enum.Material.Basalt)
		deco(parent, Vector3.new(0.45, h * 0.5, 0.45), cf * CFrame.new(0, -h * 0.8, 0), rgb(255, 120, 30), Enum.Material.Neon)
	end,
	-- 6 seaweed strands
	function(parent, cf, w, rng)
		for i = 1, 2 do
			local h = rng.range(1.5, 3)
			deco(parent, Vector3.new(0.5, h, 0.2), cf * CFrame.new(rng.range(-w, w) * 0.3, -h / 2, rng.range(-w, w) * 0.3) * CFrame.Angles(0, rng.range(0, 3), rng.range(-0.15, 0.15)), rgb(50, 170, 120), Enum.Material.Grass)
		end
	end,
	-- 7 goo drip
	function(parent, cf, w, rng)
		local h = rng.range(1, 2.2)
		local x, z = rng.range(-w, w) * 0.3, rng.range(-w, w) * 0.3
		deco(parent, Vector3.new(0.45, h, 0.45), cf * CFrame.new(x, -h / 2, z), rgb(170, 255, 60), Enum.Material.Neon)
		ball(parent, 0.8, (cf * CFrame.new(x, -h, z)).Position, rgb(170, 255, 60), Enum.Material.Neon)
	end,
	-- 8 cloud puff
	function(parent, cf, w, rng)
		blob(parent, Vector3.new(w * 0.9, 1.6, w * 0.9), cf * CFrame.new(0, -0.7, 0), WHITE)
	end,
	-- 9 neon underglow bar
	function(parent, cf, w, rng)
		deco(parent, Vector3.new(w * 0.7, 0.25, 0.4), cf * CFrame.new(0, -0.15, 0), if rng.next() < 0.5 then rgb(0, 255, 230) else rgb(255, 60, 220), Enum.Material.Neon)
	end,
	-- 10 crystal
	function(parent, cf, w, rng)
		local bands = { rgb(255, 80, 90), rgb(255, 190, 50), rgb(90, 220, 110), rgb(80, 160, 255), rgb(190, 100, 255) }
		local h = rng.range(1.2, 2.2)
		deco(parent, Vector3.new(0.7, h, 0.7), cf * CFrame.new(0, -h / 2, 0) * CFrame.Angles(0, math.pi / 4, 0), bands[rng.int(1, #bands)], Enum.Material.Neon).Transparency = 0.15
	end,
}

-- Top layer of a platform per world: { body colour?, body material?, cap colour?, cap material? }.
-- Worlds without an entry get a cap that is simply a lighter shade of the slab.
type CapStyle = { body: Color3?, bodyMat: Enum.Material?, cap: Color3?, capMat: Enum.Material? }
local CAPS: { [number]: CapStyle } = {
	[1] = { body = rgb(205, 155, 105), bodyMat = Enum.Material.Sand, cap = rgb(140, 235, 105), capMat = Enum.Material.Grass }, -- turf on dirt
	[3] = { cap = rgb(246, 250, 255), capMat = Enum.Material.Snow }, -- snow on ice
	[4] = { cap = rgb(250, 228, 175), capMat = Enum.Material.Sand }, -- sand on sandstone
	[5] = { cap = rgb(105, 92, 98), capMat = Enum.Material.Basalt },
	[6] = { cap = rgb(250, 228, 180), capMat = Enum.Material.Sand }, -- seabed sand on reef rock
	[7] = { capMat = Enum.Material.Metal }, -- steel deck plates on the factory slabs
	[8] = { bodyMat = Enum.Material.Marble, capMat = Enum.Material.Marble }, -- white-marble sky palace
	[9] = { bodyMat = Enum.Material.Slate, capMat = Enum.Material.Neon }, -- dark slabs, glowing tops
}

-- `slab` is a static platform. Gives it a top layer (grass on dirt, snow on ice, frosting on
-- cake...), a darker underside so the spiral overhead isn't flat-shaded slabs, and (for about a
-- third of them) a small themed prop hanging below. The slab itself - the only solid part - keeps
-- its size and position.
function Scenery.dressPlatform(model: Instance, slab: BasePart, theme: Config.Theme, tower: number, world: number, rng: Rng)
	local size = slab.Size
	local style: CapStyle = CAPS[world] or {}
	local isAlt = slab.Color == theme.alt
	withMood(tower, function()
		local body = slab.Color
		if style.body then
			body = style.body:Lerp(Color3.new(), if isAlt then 0.12 else 0)
			if tower > 1 then
				local shifted = TowerStyle.shift({ math.floor(body.R * 255 + 0.5), math.floor(body.G * 255 + 0.5), math.floor(body.B * 255 + 0.5) }, TowerStyle.mood(tower))
				body = Color3.fromRGB(shifted[1], shifted[2], shifted[3])
			end
			slab.Color = body
		end
		if style.bodyMat then
			slab.Material = style.bodyMat
		end
		local softMat = if slab.Material == Enum.Material.Neon or slab.Material == Enum.Material.Glass then Enum.Material.SmoothPlastic else slab.Material
		-- caps whose colour comes from the theme are already in the tower's palette: made outside
		-- the recording below so they are not shifted twice
		local capColor = style.cap
		local fromTheme = false
		if world == 2 then
			-- candy: white frosting on the pink cakes, pink on the white ones
			capColor = if isAlt then theme.platform else rgb(255, 250, 252)
			fromTheme = isAlt
		elseif not capColor then
			capColor = body:Lerp(Color3.new(1, 1, 1), 0.4)
			fromTheme = true
		end
		local saved = recording
		if fromTheme then
			recording = nil
		end
		local cap = deco(model, Vector3.new(size.X + 0.4, 0.3, size.Z + 0.4), slab.CFrame * CFrame.new(0, size.Y / 2 - 0.12, 0), capColor :: Color3, style.capMat or softMat)
		cap.Name = "Cap"
		local under = slab.CFrame * CFrame.new(0, -size.Y / 2, 0)
		recording = nil
		local skirt = deco(model, Vector3.new(math.max(0.6, size.X - 0.8), 0.7, math.max(0.6, size.Z - 0.8)), under * CFrame.new(0, -0.35, 0), body:Lerp(Color3.new(), 0.28), softMat)
		skirt.Name = "Skirt"
		recording = saved
		if rng.next() < 0.36 and math.min(size.X, size.Z) >= 3 then
			local hang = HANG[world]
			if hang then
				hang(model, under * CFrame.new(0, -0.7, 0), math.min(size.X, size.Z), rng)
			end
		end
	end)
end

---------------------------------------------------------------------------------------------
-- public: lobby dressing. The lobby floor is a disc of radius 150 with its top at y = 0.
---------------------------------------------------------------------------------------------
function Scenery.buildLobby(parent: Instance, start: Vector3, spawnPos: Vector3)
	local folder = Instance.new("Folder")
	folder.Name = "LobbyScenery"
	local rng = Layout.newRng(Config.MapSeed + 61)

	-- the floor becomes a floating island: rock tapering below it, a sea of clouds further down
	local rock = rgb(128, 100, 78)
	cyl(folder, 292, 10, CFrame.new(0, -9, 0), rock, Enum.Material.Slate)
	cyl(folder, 236, 18, CFrame.new(4, -23, -3), rock:Lerp(Color3.new(), 0.1), Enum.Material.Slate)
	cyl(folder, 160, 24, CFrame.new(-6, -44, 5), rock:Lerp(Color3.new(), 0.18), Enum.Material.Slate)
	cyl(folder, 84, 28, CFrame.new(3, -70, -2), rock:Lerp(Color3.new(), 0.26), Enum.Material.Slate)
	cyl(folder, 30, 26, CFrame.new(0, -97, 0), rock:Lerp(Color3.new(), 0.32), Enum.Material.Slate)
	for i = 1, 26 do
		local a = i / 26 * math.pi * 2 + rng.range(-0.08, 0.08)
		local r = rng.range(190, 330)
		local s = rng.range(50, 95)
		local cy = rng.range(-70, -34)
		local cloudCF = CFrame.new(math.cos(a) * r, cy, math.sin(a) * r) * CFrame.Angles(0, a, 0)
		ModelSlots.spawn("cloud", cloudCF * CFrame.new(0, -s * 0.16, 0), Vector3.new(s, s * 0.32, s * 0.8), folder, function()
			local cloud = blob(folder, Vector3.new(s, s * 0.32, s * 0.8), cloudCF, WHITE)
			cloud.Transparency = 0.08
			cloud.Name = "CloudSea"
			return cloud
		end, { name = "CloudSea", maxParts = 40 })
	end
	-- boulders and bushes along the rim hide the hard edge of the disc
	for i = 1, 44 do
		local a = i / 44 * math.pi * 2 + rng.range(-0.05, 0.05)
		local r = rng.range(143, 149)
		local bush = rng.next() < 0.45
		local s = rng.range(5, 10)
		local propCF = CFrame.new(math.cos(a) * r, s * 0.15, math.sin(a) * r) * CFrame.Angles(0, rng.range(0, 3), 0)
		ModelSlots.spawn(if bush then "bush" else "rock", propCF * CFrame.new(0, -s * 0.4, 0), Vector3.new(s * 1.3, s * 0.8, s), folder, function()
			return blob(folder, Vector3.new(s * 1.3, s * 0.8, s), propCF, if bush then rgb(70, 165, 80) else rgb(150, 150, 158), if bush then Enum.Material.Grass else Enum.Material.Slate)
		end, { maxParts = 50 })
	end

	-- plaza around the spawn, stone kerbs along the path
	local plazaCenter = Vector3.new(spawnPos.X, 0, spawnPos.Z)
	cyl(folder, 52, 0.12, CFrame.new(plazaCenter + Vector3.new(0, 0.06, 0)), rgb(205, 190, 165), Enum.Material.Cobblestone)
	cyl(folder, 40, 0.2, CFrame.new(plazaCenter + Vector3.new(0, 0.1, 0)), rgb(240, 226, 196), Enum.Material.Sandstone)
	local ringGlow = cyl(folder, 22, 0.3, CFrame.new(plazaCenter + Vector3.new(0, 0.15, 0)), rgb(110, 225, 255), Enum.Material.Neon)
	ringGlow.Name = "SpawnGlow"
	cyl(folder, 18.6, 0.36, CFrame.new(plazaCenter + Vector3.new(0, 0.18, 0)), rgb(240, 226, 196), Enum.Material.Sandstone)
	for _, x in { -6.6, 6.6 } do
		deco(folder, Vector3.new(1.2, 0.7, 50), CFrame.new(x, 0.35, 90), rgb(225, 225, 232), Enum.Material.Concrete)
	end

	-- lamp posts + flower beds along the path to the tower
	local flowers = { rgb(255, 110, 150), rgb(255, 215, 70), rgb(170, 120, 255), WHITE, rgb(255, 150, 60) }
	for i = 0, 2 do
		local z = 72 + i * 15
		for _, side in { -1, 1 } do
			local x = side * 10
			ModelSlots.spawn("lamp_post", CFrame.new(x, 0, z), Vector3.new(1.6, 10.9, 1.6), folder, function()
				cyl(folder, 0.7, 9, CFrame.new(x, 4.5, z), rgb(60, 62, 80), Enum.Material.Metal)
				cyl(folder, 1.6, 0.5, CFrame.new(x, 0.25, z), rgb(60, 62, 80), Enum.Material.Metal)
				local lamp = ball(folder, 2.2, Vector3.new(x, 9.8, z), rgb(255, 236, 170), Enum.Material.Neon)
				lamp.Name = "Lamp"
				light(lamp, rgb(255, 225, 160), 20, 1.2)
				return nil
			end, { maxParts = 60 })
			-- flower bed between lamps
			local bedZ = z + 7.5
			if i < 2 then
				blob(folder, Vector3.new(5, 1.2, 8), CFrame.new(x + side * 1.5, 0.2, bedZ), rgb(80, 170, 85), Enum.Material.Grass)
				for _ = 1, 5 do
					ball(folder, rng.range(0.8, 1.3), Vector3.new(x + side * 1.5 + rng.range(-1.8, 1.8), rng.range(0.8, 1.2), bedZ + rng.range(-3, 3)), flowers[rng.int(1, #flowers)])
				end
			end
		end
	end

	-- the tower entrance: gold caps, banners and glowing orbs on the START arch
	for _, x in { -8, 8 } do
		local top = start + Vector3.new(x, 14, 4)
		ball(folder, 3, top + Vector3.new(0, 1.2, 0), GOLD, Enum.Material.Neon)
		cyl(folder, 3, 0.8, CFrame.new(start + Vector3.new(x, -1.6, 4)), rgb(225, 225, 232), Enum.Material.Marble)
		local banner = deco(folder, Vector3.new(0.3, 9, 3.4), CFrame.new(start + Vector3.new(x + (if x < 0 then -1.3 else 1.3), 7, 4)), rgb(255, 90, 120))
		banner.Name = "Banner"
		deco(folder, Vector3.new(0.34, 1, 3.4), CFrame.new(start + Vector3.new(x + (if x < 0 then -1.3 else 1.3), 3, 4)), GOLD)
		local orb = ball(folder, 1.4, start + Vector3.new(x * 1.6, 4, 6), rgb(120, 230, 255), Enum.Material.Neon)
		cyl(folder, 0.5, 3.4, CFrame.new(start + Vector3.new(x * 1.6, 1.0, 6)), rgb(225, 225, 232), Enum.Material.Marble)
		emitter(orb, { texture = SPARKLES, color = rgb(160, 240, 255), color2 = rgb(255, 240, 150), rate = 6, life = 1.6, speed = 3, size = 0.8, size2 = 0.1, spread = 180, emission = 0.8 })
		light(orb, rgb(120, 230, 255), 16, 1.5)
	end

	-- the tower base: a stone plinth with gold trim and a title plate (inside the core's footprint
	-- + 8 studs, nowhere near a lane)
	local plinth = cyl(folder, 60, 3, CFrame.new(0, 1.5, 0), rgb(225, 225, 232), Enum.Material.Marble)
	plinth.Name = "Plinth"
	local plinth2 = cyl(folder, 54, 2, CFrame.new(0, 4, 0), rgb(205, 205, 215), Enum.Material.Marble)
	for _, step in { plinth, plinth2 } do
		-- solid: you can climb the steps (radius 30, the nearest lane starts at 42)
		step.CanCollide = true
		step.CanQuery = true
	end
	cyl(folder, Layout.CORE_RADIUS * 2 + 2.4, 1.4, CFrame.new(0, 5.7, 0), GOLD, Enum.Material.Neon)
	cyl(folder, Layout.CORE_RADIUS * 2 + 2.4, 1.0, CFrame.new(0, 40, 0), GOLD, Enum.Material.Neon)
	local plate = deco(folder, Vector3.new(30, 9, 1), CFrame.lookAt(Vector3.new(0, 31, Layout.CORE_RADIUS + 0.6), Vector3.new(0, 31, 200)), rgb(40, 45, 80))
	plate.Name = "TitlePlate"
	deco(folder, Vector3.new(31.4, 10.4, 0.6), plate.CFrame * CFrame.new(0, 0, 0.3), GOLD, Enum.Material.Neon)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 24
	sg.LightInfluence = 0
	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 1)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.Text = string.upper(Config.GameName) -- a name: the same in every language
	title.TextColor3 = rgb(255, 225, 90)
	title.TextStrokeTransparency = 0
	title.TextStrokeColor3 = rgb(20, 20, 45)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.04, 0)
	pad.PaddingRight = UDim.new(0.04, 0)
	pad.PaddingTop = UDim.new(0.08, 0)
	pad.PaddingBottom = UDim.new(0.08, 0)
	pad.Parent = title
	title.Parent = sg
	sg.Parent = plate

	-- two hot-air balloons drifting beside the island
	for i, spec in { { pos = Vector3.new(-120, 70, 150), color = rgb(255, 110, 130) }, { pos = Vector3.new(150, 110, 60), color = rgb(90, 180, 255) } } do
		local p = spec.pos
		-- the fallback (or the library model) is returned unparented: "Bob" must be set before it
		-- replicates, the client reads it when the model appears
		local model = ModelSlots.spawn("balloon", CFrame.new(p + Vector3.new(0, -23, 0)), Vector3.new(26.4, 36, 26.4), nil, function()
			local m = Instance.new("Model")
			m.Name = "Balloon"
			ball(m, 26, p, spec.color)
			cyl(m, 26.4, 3, CFrame.new(p), WHITE)
			cyl(m, 21, 3, CFrame.new(p + Vector3.new(0, 7.5, 0)), rgb(255, 225, 90))
			cyl(m, 21, 3, CFrame.new(p + Vector3.new(0, -7.5, 0)), rgb(255, 225, 90))
			deco(m, Vector3.new(5, 4, 5), CFrame.new(p + Vector3.new(0, -21, 0)), rgb(165, 120, 80), Enum.Material.WoodPlanks)
			for _, o in { Vector3.new(2.2, 0, 2.2), Vector3.new(-2.2, 0, 2.2), Vector3.new(2.2, 0, -2.2), Vector3.new(-2.2, 0, -2.2) } do
				deco(m, Vector3.new(0.2, 9, 0.2), CFrame.new(p + o + Vector3.new(0, -15, 0)), rgb(245, 240, 230))
			end
			return m
		end, { name = "Balloon" })
		if model then
			model:SetAttribute("Bob", i)
			model.Parent = folder
		end
	end

	folder.Parent = parent
end

---------------------------------------------------------------------------------------------
-- public: victory room dressing. `center` = middle of the round floor (radius 25, top at
-- center.Y), `outward` = unit vector pointing away from the tower.
---------------------------------------------------------------------------------------------
function Scenery.buildVictory(parent: Instance, center: Vector3, outward: Vector3)
	local folder = Instance.new("Folder")
	folder.Name = "VictoryScenery"
	local frame = CFrame.lookAt(center, center - outward) -- -Z looks back at the tower
	local bands = { rgb(255, 80, 90), rgb(255, 190, 50), rgb(255, 240, 90), rgb(90, 220, 110), rgb(80, 160, 255), rgb(190, 100, 255) }

	-- floor: glowing rim + two inlaid rings
	cyl(folder, 53, 1.2, CFrame.new(center - Vector3.new(0, 1.2, 0)), rgb(255, 170, 60))
	cyl(folder, 38, 0.12, CFrame.new(center + Vector3.new(0, 0.06, 0)), rgb(255, 170, 60))
	cyl(folder, 35, 0.16, CFrame.new(center + Vector3.new(0, 0.08, 0)), rgb(255, 235, 120))
	cyl(folder, 16, 0.2, CFrame.new(center + Vector3.new(0, 0.1, 0)), WHITE, Enum.Material.Marble)
	-- a cloud bank under the room so it doesn't hang in the void
	for i = 1, 7 do
		local a = i / 7 * math.pi * 2
		blob(folder, Vector3.new(34, 11, 28), CFrame.new(center + Vector3.new(math.cos(a) * 22, -8, math.sin(a) * 22)) * CFrame.Angles(0, a, 0), WHITE)
	end

	-- two giant golden cups flanking the WINNER sign
	for _, tx in { -16, 16 } do
		local t = frame * CFrame.new(tx, 0, 9)
		ModelSlots.spawn("trophy", t, Vector3.new(12, 17, 9), folder, function()
			cyl(folder, 8, 1.4, t * CFrame.new(0, 0.7, 0), rgb(90, 70, 50), Enum.Material.Wood)
			cyl(folder, 5.4, 1.2, t * CFrame.new(0, 2, 0), GOLD, Enum.Material.Metal)
			cyl(folder, 1.8, 4.4, t * CFrame.new(0, 4.8, 0), GOLD, Enum.Material.Metal)
			for i = 0, 3 do
				cyl(folder, 4.4 + i * 1.5, 1.5, t * CFrame.new(0, 7.7 + i * 1.5, 0), GOLD, Enum.Material.Metal)
			end
			local glow = cyl(folder, 7.2, 0.5, t * CFrame.new(0, 13.3, 0), rgb(255, 245, 170), Enum.Material.Neon)
			for _, side in { -1, 1 } do
				deco(folder, Vector3.new(0.8, 4, 0.8), t * CFrame.new(side * 5.6, 10.6, 0), GOLD, Enum.Material.Metal)
				deco(folder, Vector3.new(2.2, 0.8, 0.8), t * CFrame.new(side * 4.7, 12.3, 0), GOLD, Enum.Material.Metal)
				deco(folder, Vector3.new(2.6, 0.8, 0.8), t * CFrame.new(side * 4.4, 9, 0), GOLD, Enum.Material.Metal)
			end
			for i = 0, 1 do
				deco(folder, Vector3.new(3, 3, 0.6), t * CFrame.new(0, 16.4, 0) * CFrame.Angles(0, 0, i * math.pi / 4), rgb(255, 250, 190), Enum.Material.Neon)
			end
			light(glow, rgb(255, 230, 140), 36, 1.6)
			emitter(glow, { texture = SPARKLES, color = rgb(255, 250, 190), color2 = rgb(255, 200, 80), rate = 8, life = 2.2, speed = 8, size = 1.3, size2 = 0.2, spread = 35, emission = 0.9, accel = Vector3.new(0, -6, 0) })
			return nil
		end)
	end

	-- rainbow over the far side of the room
	local segs = 12
	for b, color in bands do
		local radius = 27 - (b - 1) * 1.5
		for i = 0, segs - 1 do
			local a = (i + 0.5) / segs * math.pi
			local len = math.pi * radius / segs * 1.06
			deco(folder, Vector3.new(len, 1.5, 1.6), frame * CFrame.new(math.cos(a) * radius, math.sin(a) * radius - 1, 20) * CFrame.Angles(0, 0, a + math.pi / 2), color, Enum.Material.Neon).Transparency = 0.12
		end
	end

	-- four searchlight beams around the room
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		local beam = cyl(folder, 3.4, 90, CFrame.new(center + Vector3.new(math.cos(a) * 25.5, 44, math.sin(a) * 25.5)) * CFrame.Angles(math.cos(a) * 0.12, 0, math.sin(a) * -0.12), bands[i + 1], Enum.Material.Neon)
		beam.Transparency = 0.9
		beam.Name = "Searchlight"
	end
	folder.Parent = parent
end

---------------------------------------------------------------------------------------------
-- shared bits for the interactive set pieces (shops, lounge, portals, gift plinths)
---------------------------------------------------------------------------------------------
-- Two lines of text floating over `part`: a big one and a smaller one. Both are localized on
-- each client through `loc` (StageGenerator.loc).
local function caption(part: BasePart, offsetY: number, width: number, loc: LocFn, topKey: string, topArgs: { [string]: any }?, topColor: Color3, bottomKey: string?, bottomArgs: { [string]: any }?, bottomColor: Color3?)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Caption"
	bb.Size = UDim2.fromScale(width, width * 0.36)
	bb.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	bb.MaxDistance = 70
	bb.LightInfluence = 0
	bb.Adornee = part
	local function line(name: string, y: number, h: number, color: Color3): TextLabel
		local l = Instance.new("TextLabel")
		l.Name = name
		l.BackgroundTransparency = 1
		l.Size = UDim2.fromScale(1, h)
		l.Position = UDim2.fromScale(0, y)
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.TextColor3 = color
		l.TextStrokeTransparency = 0
		l.TextStrokeColor3 = Color3.fromRGB(30, 30, 50)
		l.Parent = bb
		return l
	end
	local top = line("Top", 0, if bottomKey then 0.56 else 1, topColor)
	loc(top, topKey, topArgs)
	if bottomKey then
		loc(line("Bottom", 0.58, 0.42, bottomColor or WHITE), bottomKey, bottomArgs)
	end
	bb.Parent = part
end

-- A pedestal with something floating over it. Returns the base (where the ProximityPrompt goes).
local function pedestal(parent: Instance, base: CFrame, color: Color3): Part
	local foot = solid(parent, Vector3.new(1.1, 2.6, 2.6), base * CFrame.new(0, 0.55, 0) * CFrame.Angles(0, 0, math.pi / 2), rgb(235, 235, 242), Enum.Material.Marble)
	foot.Shape = Enum.PartType.Cylinder
	foot.Name = "Pedestal"
	cyl(parent, 2.2, 1.3, base * CFrame.new(0, 1.75, 0), color)
	cyl(parent, 2.9, 0.3, base * CFrame.new(0, 2.5, 0), rgb(255, 255, 255), Enum.Material.Neon)
	return foot
end

-- Small floating models of the shop items, built from parts (no uploads). `at` = centre.
local ICONS: { [string]: (parent: Instance, at: CFrame, color: Color3) -> () } = {
	speed = function(parent, at, color)
		for i = -1, 1 do
			cyl(parent, 1.9, 0.34, at * CFrame.new(0, i * 0.5, 0) * CFrame.Angles(0.18, 0, 0), color, Enum.Material.Neon)
		end
		cyl(parent, 0.5, 1.9, at * CFrame.new(0, -0.1, 0), rgb(90, 95, 110), Enum.Material.Metal)
	end,
	gravity = function(parent, at, color)
		for i = -1, 1 do
			cyl(parent, 1.9 - math.abs(i) * 0.4, 0.34, at * CFrame.new(0, i * 0.55, 0), color, Enum.Material.Neon)
		end
		ball(parent, 0.8, (at * CFrame.new(0, 1.3, 0)).Position, WHITE, Enum.Material.Neon)
	end,
	doublejump = function(parent, at, color)
		for i = 0, 1 do
			for _, side in { -1, 1 } do
				deco(parent, Vector3.new(0.4, 1.3, 0.5), at * CFrame.new(side * 0.42, i * 1.0 - 0.5, 0) * CFrame.Angles(0, 0, side * 0.75), color, Enum.Material.Neon)
			end
		end
	end,
	shield = function(parent, at, color)
		cyl(parent, 2.2, 0.4, at * CFrame.Angles(math.pi / 2, 0, 0), color)
		cyl(parent, 1.3, 0.5, at * CFrame.Angles(math.pi / 2, 0, 0), WHITE, Enum.Material.Neon)
	end,
	magnet = function(parent, at, color)
		deco(parent, Vector3.new(2, 0.6, 0.6), at * CFrame.new(0, 0.7, 0), color)
		for _, side in { -1, 1 } do
			deco(parent, Vector3.new(0.6, 1.1, 0.6), at * CFrame.new(side * 0.7, -0.1, 0), color)
			deco(parent, Vector3.new(0.62, 0.5, 0.62), at * CFrame.new(side * 0.7, -0.85, 0), WHITE, Enum.Material.Neon)
		end
	end,
	skip = function(parent, at, color)
		for i = 0, 1 do
			for _, side in { -1, 1 } do
				deco(parent, Vector3.new(0.4, 1.2, 0.5), at * CFrame.new(i * 0.9 - 0.7, side * 0.38, 0) * CFrame.Angles(0, 0, math.pi / 2 + side * 0.75), color, Enum.Material.Neon)
			end
		end
		deco(parent, Vector3.new(0.35, 1.7, 0.5), at * CFrame.new(1.05, 0, 0), color, Enum.Material.Neon)
	end,
	pocket = function(parent, at, color)
		cyl(parent, 1.9, 0.3, at * CFrame.new(0, -0.8, 0), rgb(120, 225, 255), Enum.Material.Neon)
		cyl(parent, 0.16, 2, at * CFrame.new(-0.4, 0.2, 0), WHITE, Enum.Material.Metal)
		deco(parent, Vector3.new(1.1, 0.7, 0.12), at * CFrame.new(0.2, 0.8, 0), color)
	end,
}

---------------------------------------------------------------------------------------------
-- public: shop platform next to the first pad of a world. `out` = unit vector away from the tower.
-- The deck hangs OUTSIDE the ring of pads (8..22 studs from the pad centre), where no stage runs,
-- and ends 4 studs short of the nearest floating scenery.
---------------------------------------------------------------------------------------------
export type Interactive = { id: string, part: Part }

Scenery.SHOP_NEAR = Layout.SHOP_NEAR
Scenery.SHOP_DEPTH = Layout.SHOP_DEPTH
Scenery.SHOP_WIDTH = Layout.SHOP_WIDTH

function Scenery.buildShop(parent: Instance, padPos: Vector3, out: Vector3, theme: Config.Theme, loc: LocFn): { Interactive }
	local model = Instance.new("Model")
	model.Name = "Shop"
	local depth, width = Scenery.SHOP_DEPTH, Scenery.SHOP_WIDTH
	local center = padPos + out * (Scenery.SHOP_NEAR + depth / 2)
	-- frame: origin on the deck top at its centre, -Z towards the far edge, +X along the deck
	local frame = CFrame.lookAt(center, center + out)
	local wood = rgb(245, 225, 190)
	solid(model, Vector3.new(width, 1, depth), frame * CFrame.new(0, -0.5, 0), wood, Enum.Material.WoodPlanks).Name = "ShopDeck"
	solid(model, Vector3.new(7, 1, Scenery.SHOP_NEAR - Layout.PAD_RADIUS + 1.2), frame * CFrame.new(0, -0.5, depth / 2 + (Scenery.SHOP_NEAR - Layout.PAD_RADIUS + 1.2) / 2 - 0.3), wood, Enum.Material.WoodPlanks).Name = "ShopBridge"
	deco(model, Vector3.new(width - 1, 0.8, depth - 1), frame * CFrame.new(0, -1.4, 0), wood:Lerp(Color3.new(), 0.3), Enum.Material.Wood)
	-- rails on the three open sides
	local railColor = theme.accent:Lerp(WHITE, 0.2)
	solid(model, Vector3.new(width, 2.4, 0.5), frame * CFrame.new(0, 1.2, -depth / 2 + 0.25), railColor).Name = "ShopRail"
	for _, side in { -1, 1 } do
		solid(model, Vector3.new(0.5, 2.4, depth), frame * CFrame.new(side * (width / 2 - 0.25), 1.2, 0), railColor).Name = "ShopRail"
	end
	-- striped canopy + sign over the entrance
	for _, side in { -1, 1 } do
		cyl(model, 0.7, 9.5, frame * CFrame.new(side * (width / 2 - 0.8), 4.75, depth / 2 - 0.8), WHITE)
	end
	for i = 0, 6 do
		deco(model, Vector3.new(width / 7, 0.5, 4.4), frame * CFrame.new(-width / 2 + (i + 0.5) * width / 7, 9.4, depth / 2 - 2.4) * CFrame.Angles(math.rad(10), 0, 0), if i % 2 == 0 then theme.accent else WHITE)
	end
	local sign = deco(model, Vector3.new(12, 2.6, 0.4), frame * CFrame.new(0, 11.4, depth / 2 - 0.5), rgb(40, 45, 80))
	sign.Name = "ShopSign"
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Back -- faces the pad
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 30
	sg.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = rgb(255, 225, 90)
	label.TextStrokeTransparency = 0.2
	loc(label, "shop.zone")
	label.Parent = sg
	sg.Parent = sign

	local items: { Interactive } = {}
	local n = #Powerups.List
	for i, item in Powerups.List do
		local base = frame * CFrame.new((i - (n + 1) / 2) * (width - 3) / n, 0, -depth / 2 + 2.2)
		local color = Color3.fromRGB(item.color[1], item.color[2], item.color[3])
		local foot = pedestal(model, base, color)
		local icon = ICONS[item.id]
		if icon then
			icon(model, base * CFrame.new(0, 4.2, 0), color)
		end
		caption(foot, 6.6, 5.4, loc, "power." .. item.id .. ".name", nil, WHITE, "shop.price", { price = item.price }, rgb(255, 225, 90))
		foot:SetAttribute("Item", item.id)
		table.insert(items, { id = item.id, part = foot })
	end
	model.Parent = parent
	return items
end

---------------------------------------------------------------------------------------------
-- public: gift plinth ("this is what you get at stage N"). `cf` = on the ground, facing the viewer.
---------------------------------------------------------------------------------------------
function Scenery.buildGiftPreview(parent: Instance, cf: CFrame, gift: Gifts.Gift, loc: LocFn)
	local model = Instance.new("Model")
	model.Name = "Gift_" .. gift.id
	local foot = pedestal(model, cf, GOLD)
	local box = cf * CFrame.new(0, 4.4, 0) * CFrame.Angles(0, 0.5, 0)
	local paper = rgb(170, 110, 255)
	deco(model, Vector3.new(2.6, 2.2, 2.6), box, paper)
	deco(model, Vector3.new(2.9, 0.5, 2.9), box * CFrame.new(0, 1.2, 0), paper:Lerp(WHITE, 0.25))
	deco(model, Vector3.new(0.6, 2.8, 2.7), box * CFrame.new(0, 0.1, 0), GOLD, Enum.Material.Neon)
	deco(model, Vector3.new(2.7, 2.8, 0.6), box * CFrame.new(0, 0.1, 0), GOLD, Enum.Material.Neon)
	ball(model, 0.9, (box * CFrame.new(0.3, 1.8, 0)).Position, GOLD, Enum.Material.Neon)
	ball(model, 0.9, (box * CFrame.new(-0.3, 1.8, 0)).Position, GOLD, Enum.Material.Neon)
	caption(foot, 8.6, 9, loc, "gift.at", { n = gift.stage }, rgb(255, 225, 90), "gift." .. gift.id .. ".name", nil, WHITE)
	model.Parent = parent
end

---------------------------------------------------------------------------------------------
-- public: a portal. `cf` = on the ground, facing the viewer. Returns the swirling disc (walk in).
---------------------------------------------------------------------------------------------
function Scenery.buildPortal(parent: Instance, cf: CFrame, color: Color3, key: string, args: { [string]: any }?, loc: LocFn): Part
	local model = Instance.new("Model")
	model.Name = "PortalFrame"
	-- the frame (pillars + lintel) can be a library model; the swirling disc, light, sparkles and
	-- caption below stay code-built because the walk-in trigger lives there. A model frame is
	-- decorative (no collision), the primitive pillars were solid.
	ModelSlots.spawn("portal_frame", cf, Vector3.new(13, 14, 2.4), model, function()
		for _, side in { -1, 1 } do
			solid(model, Vector3.new(2, 12, 2), cf * CFrame.new(side * 5.5, 6, 0), rgb(235, 235, 242), Enum.Material.Marble)
			ball(model, 2.4, (cf * CFrame.new(side * 5.5, 12.8, 0)).Position, color, Enum.Material.Neon)
		end
		deco(model, Vector3.new(13, 1.6, 2.2), cf * CFrame.new(0, 12.4, 0), rgb(215, 215, 228), Enum.Material.Marble)
		return nil
	end)
	local disc = cyl(model, 9.4, 0.6, cf * CFrame.new(0, 6, 0) * CFrame.Angles(math.pi / 2, 0, 0), color, Enum.Material.Neon)
	disc.Transparency = 0.25
	disc.CanTouch = true
	local inner = cyl(model, 6, 0.8, cf * CFrame.new(0, 6, 0) * CFrame.Angles(math.pi / 2, 0, 0), WHITE, Enum.Material.Neon)
	inner.Transparency = 0.35
	cyl(model, 2.6, 1, cf * CFrame.new(0, 6, 0) * CFrame.Angles(math.pi / 2, 0, 0), color, Enum.Material.Neon)
	emitter(disc, { texture = SPARKLES, color = WHITE, color2 = color, rate = 8, life = 1.6, speed = 4, size = 0.9, size2 = 0.1, spread = 180, emission = 0.9 })
	light(disc, color, 22, 1.6)
	caption(disc, 9.4, 17, loc, key, args, rgb(255, 240, 120))
	model.Parent = parent
	return disc
end

---------------------------------------------------------------------------------------------
-- public: the Winner's Lounge, a round terrace beyond the summit room of tower 1 with one
-- pedestal per free item (Shared/Perks). `center` = middle of the victory floor.
---------------------------------------------------------------------------------------------
function Scenery.buildLounge(parent: Instance, center: Vector3, outward: Vector3, loc: LocFn): { Interactive }
	local model = Instance.new("Model")
	model.Name = "Lounge"
	local mid = center + outward * 46
	local frame = CFrame.lookAt(mid, mid + outward)
	local floor = solid(model, Vector3.new(2, 40, 40), frame * CFrame.new(0, -1, 0) * CFrame.Angles(0, 0, math.pi / 2), rgb(245, 245, 250), Enum.Material.Marble)
	floor.Shape = Enum.PartType.Cylinder
	floor.Name = "LoungeFloor"
	cyl(model, 42, 1.2, frame * CFrame.new(0, -1.4, 0), GOLD)
	cyl(model, 26, 0.12, frame * CFrame.new(0, 0.06, 0), rgb(200, 215, 255))
	cyl(model, 23, 0.16, frame * CFrame.new(0, 0.08, 0), rgb(245, 245, 250), Enum.Material.Marble)
	solid(model, Vector3.new(9, 2, 5), CFrame.lookAt(center + outward * 25.5 - Vector3.new(0, 1, 0), mid - Vector3.new(0, 1, 0)), rgb(245, 245, 250), Enum.Material.Marble).Name = "LoungeBridge"
	for i = 1, 5 do
		local a = i / 5 * math.pi * 2
		blob(model, Vector3.new(26, 9, 22), frame * CFrame.new(math.cos(a) * 17, -8, math.sin(a) * 17) * CFrame.Angles(0, a, 0), WHITE)
	end
	-- sign over the way in
	for _, side in { -1, 1 } do
		cyl(model, 0.9, 11, frame * CFrame.new(side * 7, 5.5, 19), GOLD)
	end
	local sign = deco(model, Vector3.new(16, 3, 0.5), frame * CFrame.new(0, 11.5, 19), rgb(40, 45, 80))
	sign.Name = "LoungeSign"
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Back
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 30
	sg.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = rgb(255, 225, 90)
	label.TextStrokeTransparency = 0.2
	loc(label, "lounge.sign")
	label.Parent = sg
	sg.Parent = sign

	-- pedestals on a ring, leaving the entrance (towards the summit room) open
	local items: { Interactive } = {}
	local n = #Perks.List
	for i, perk in Perks.List do
		local a = math.rad(-150) + (i - 1) / (n - 1) * math.rad(300) -- 300 degrees, gap at the entrance
		local pos = frame * CFrame.new(math.sin(a) * 15.5, 0, -math.cos(a) * 15.5)
		local base = CFrame.lookAt(pos.Position, mid)
		local color = if perk.color then Color3.fromRGB(perk.color[1], perk.color[2], perk.color[3]) else rgb(120, 200, 255)
		local foot = pedestal(model, base, color)
		local orb = ball(model, 1.7, (base * CFrame.new(0, 4.1, 0)).Position, color, Enum.Material.Neon)
		orb.Transparency = 0.15
		caption(foot, 6.4, 5.2, loc, "perk." .. perk.id .. ".name", nil, WHITE, "lounge.free", nil, rgb(120, 255, 150))
		foot:SetAttribute("Perk", perk.id)
		table.insert(items, { id = perk.id, part = foot })
	end
	model.Parent = parent
	return items
end

---------------------------------------------------------------------------------------------
-- public: the base island of towers 2..10 (where the portal drops you). `padPos` = top of pad 0.
-- Returns the "back to the lobby" portal disc.
---------------------------------------------------------------------------------------------
function Scenery.buildBase(parent: Instance, padPos: Vector3, axis: Vector3, tower: number, loc: LocFn): Part
	local model = Instance.new("Model")
	model.Name = "Base"
	local out = Vector3.new(padPos.X - axis.X, 0, padPos.Z - axis.Z).Unit
	local ground = padPos.Y - 2 -- pad 0 is 2 studs thick
	local mid = Vector3.new(padPos.X, ground, padPos.Z) + out * 12
	local frame = CFrame.lookAt(mid, mid + out)
	local mood = TowerStyle.mood(tower)
	local accent = Color3.fromRGB(mood.core[1], mood.core[2], mood.core[3])
	local floor = solid(model, Vector3.new(3, 56, 56), frame * CFrame.new(0, -1.5, 0) * CFrame.Angles(0, 0, math.pi / 2), rgb(225, 225, 235), Enum.Material.Cobblestone)
	floor.Shape = Enum.PartType.Cylinder
	floor.Name = "BaseFloor"
	local rock = rgb(120, 110, 125)
	cyl(model, 48, 12, frame * CFrame.new(0, -9, 0), rock, Enum.Material.Slate)
	cyl(model, 30, 14, frame * CFrame.new(2, -22, -1), rock:Lerp(Color3.new(), 0.15), Enum.Material.Slate)
	cyl(model, 12, 14, frame * CFrame.new(1, -36, 0), rock:Lerp(Color3.new(), 0.28), Enum.Material.Slate)
	cyl(model, 58, 0.5, frame * CFrame.new(0, -0.3, 0), accent, Enum.Material.Neon)
	-- name of the tower over the way in
	for _, side in { -1, 1 } do
		solid(model, Vector3.new(2, 15, 2), frame * CFrame.new(side * 9, 7.5, 16), WHITE)
		ball(model, 2.6, (frame * CFrame.new(side * 9, 16, 16)).Position, accent, Enum.Material.Neon)
	end
	local sign = deco(model, Vector3.new(20, 4.4, 1), frame * CFrame.new(0, 15, 16), rgb(40, 45, 80))
	sign.Name = "TowerSign"
	deco(model, Vector3.new(21, 5.4, 0.6), frame * CFrame.new(0, 15, 16.2), accent, Enum.Material.Neon)
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local sg = Instance.new("SurfaceGui")
		sg.Face = face
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 30
		sg.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = rgb(255, 225, 90)
		label.TextStrokeTransparency = 0.2
		loc(label, "portal.next", { n = tower, name = { key = "tower." .. mood.key }, from = (tower - 1) * Layout.STAGES + 1, to = tower * Layout.STAGES })
		label.Parent = sg
		sg.Parent = sign
	end
	-- the way home
	local home = Scenery.buildPortal(model, CFrame.lookAt((frame * CFrame.new(15, 0, 4)).Position, Vector3.new(padPos.X, ground, padPos.Z)), rgb(120, 225, 255), "portal.home", nil, loc)
	home.Name = "HomePortal"
	model.Parent = parent
	return home
end

return Scenery
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">Session</string>
          <string name="Source"><![CDATA[--!strict
-- Per-session (non-saved) player state, leaderstats, coin awarding and the State push to the client.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local LiveEvents = require(ReplicatedStorage.Shared.LiveEvents)
local Gifts = require(ReplicatedStorage.Shared.Gifts)
local Rules = require(ReplicatedStorage.Shared.Rules)
local Powerups = require(ReplicatedStorage.Shared.Powerups)
local Perks = require(ReplicatedStorage.Shared.Perks)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)

local Session = {}

export type S = {
	joined: number, -- os.clock() at join (play-time rewards are per session)
	collected: { [number]: boolean }, -- coin pickups taken this run
	playClaimed: { [number]: boolean },
	passes: { [string]: boolean },
	inLobby: boolean, -- pressed "Lobby": fall-catcher is off until next checkpoint/return
	lastCheckpointAt: number,
	loaded: boolean,
	at: number, -- highest pad reached since the last respawn (>= profile.stage; rest pads don't save)
	coinStage: number, -- highest stage already paid this run (rest pads can be re-reached after a fall)
	roam: string?, -- Winner's Lounge explore mode in use ("glider" | "cloud"): checkpoints don't count
	shieldUntil: number, -- os.clock() until which kill bricks are ignored (a shield just absorbed a hit)
	-- speedrun (P0-2): start = server time of the first checkpoint of the run (nil = not started);
	-- valid = false as soon as anything helped (Rules.ranked(help)): skips, coils, power-ups,
	-- abilities, the teleporter, or a session that started mid-run
	run: { start: number?, valid: boolean, finalMs: number? },
	help: Rules.Help,
	deaths: { stage: number, count: number }, -- death streak on the current stage (P0-1)
	lastOfferAt: number,
}

-- Admin /event override (P0-6), shared by every module through Session.
Session.eventOverride = nil :: LiveEvents.Active?

function Session.eventActive(id: string): boolean
	return LiveEvents.isActive(id, os.time(), Config.LiveEvents :: any, Session.eventOverride)
end

Session.data = {} :: { [Player]: S }

function Session.start(player: Player): S
	local s: S = {
		joined = os.clock(),
		collected = {},
		playClaimed = {},
		passes = {},
		inLobby = false,
		lastCheckpointAt = 0,
		loaded = false,
		at = 0,
		coinStage = 0,
		roam = nil,
		shieldUntil = 0,
		run = { start = nil, valid = true },
		help = {},
		deaths = { stage = -1, count = 0 },
		lastOfferAt = -math.huge,
	}
	Session.data[player] = s
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local stage = Instance.new("IntValue")
	stage.Name = "Stage"
	stage.Parent = ls
	local wins = Instance.new("IntValue")
	wins.Name = "Wins"
	wins.Parent = ls
	ls.Parent = player
	return s
end

-- Studio-only test tools (free dev skips): Studio AND an explicit flag (Rules.studioTools).
function Session.studioTools(): boolean
	return Rules.studioTools(RunService:IsStudio(), Config.StudioFreeSkips, Workspace:GetAttribute(Config.StudioToolsAttribute) == true)
end

function Session.stop(player: Player)
	Session.data[player] = nil
end

function Session.get(player: Player): S?
	return Session.data[player]
end

function Session.hasPass(player: Player, name: string): boolean
	local s = Session.data[player]
	if not s then
		return false
	end
	if s.passes[name] then
		return true
	end
	-- Fusion = both coils in one pass (Pricing: 139 R$ vs 168 separately)
	if (name == "SpeedCoil" or name == "GravityCoil") and s.passes.Fusion then
		return true
	end
	-- Studio convenience (off by default): unconfigured passes count as owned so every pass can
	-- be tried without publishing. Off, a Studio session plays exactly like a new player's.
	return Config.StudioOwnsPasses and RunService:IsStudio() and Config.Passes[name] == 0
end

-- What is switched on for this player right now (pass + setting, or a timed shop power-up).
function Session.speedOn(player: Player, p: Data.Profile): boolean
	return (p.settings.speedCoil and Session.hasPass(player, "SpeedCoil")) or Powerups.active(p.boosts, "speed", os.time())
end

function Session.gravityOn(player: Player, p: Data.Profile): boolean
	return (p.settings.gravityCoil and Session.hasPass(player, "GravityCoil")) or Powerups.active(p.boosts, "gravity", os.time())
end

function Session.doubleJumpOn(player: Player, p: Data.Profile): boolean
	return Session.hasPass(player, "DoubleJump") or Powerups.active(p.boosts, "doublejump", os.time())
end

-- Extra jumps in the air (0, 1 = double jump, 2 = the lounge's triple jump).
function Session.airJumps(player: Player, p: Data.Profile): number
	return Perks.airJumps(p.perks.triplejump == true and Perks.unlocked(p.best), Session.doubleJumpOn(player, p))
end

-- Flags the run as assisted for every advantage that is on right now. Called when a run starts
-- and whenever a coil, power-up or ability is switched on.
function Session.refreshHelp(player: Player)
	local p = Data.get(player)
	local s = Session.data[player]
	if not p or not s then
		return
	end
	if Session.speedOn(player, p) or Session.gravityOn(player, p) then
		Session.assist(player, "coil")
	end
	if Session.doubleJumpOn(player, p) or Powerups.active(p.boosts, "magnet", os.time()) or (p.pocket ~= nil and p.pocket.stage == p.stage) then
		Session.assist(player, "powerup")
	end
	if Perks.unlocked(p.best) and (p.perks.dash == true or p.perks.triplejump == true) then
		Session.assist(player, "ability")
	end
end

-- Marks the current run as assisted: it will not be ranked (`key` = a field of Rules.Help).
function Session.assist(player: Player, key: string)
	local s = Session.data[player]
	if s then
		(s.help :: any)[key] = true
		s.run.valid = false
	end
end

-- Multiplier from time-limited sources (starter-pack boost, 2x Coins Weekend) and from the
-- permanent coin charms given at stages 300 and 900.
function Session.bonusMult(p: Data.Profile): number
	local mult = Gifts.coinMult(p.gifts)
	if os.time() < (p.boostEndsAt or 0) then
		mult *= 2
	end
	if Session.eventActive("DoubleCoinsWeekend") then
		mult *= 2
	end
	return mult
end

-- Awards coins with pass multipliers. Returns the amount actually given.
function Session.addCoins(player: Player, base: number): number
	local p = Data.get(player)
	if not p or base <= 0 then
		return 0
	end
	local mult = Session.bonusMult(p)
	if Session.hasPass(player, "DoubleCoins") then
		mult *= 2
	end
	if Session.hasPass(player, "VIP") then
		mult *= 1 + Config.VIPCoinBonus
	end
	local amount = math.floor(base * mult + 0.5)
	p.coins += amount
	p.totalCoins += amount
	return amount
end

local function dailyInfo(p: Data.Profile): (boolean, number, number)
	local now = os.time()
	local since = now - p.daily.lastClaim
	local can = since >= Config.DailyCooldown
	local streak = p.daily.streak
	if since > Config.DailyStreakWindow then
		streak = 0
	end
	local nextDay = streak + 1
	return can, math.max(0, Config.DailyCooldown - since), nextDay
end
Session.dailyInfo = dailyInfo

local pushHooks: { (Player) -> () } = {}
-- Called after every State push (stage / coins / win / rebirth changes), e.g. to refresh name tags.
function Session.onPush(fn: (Player) -> ())
	table.insert(pushHooks, fn)
end

function Session.push(player: Player)
	local p = Data.get(player)
	local s = Session.data[player]
	if not p or not s then
		return
	end
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		local st = ls:FindFirstChild("Stage") :: IntValue?
		local w = ls:FindFirstChild("Wins") :: IntValue?
		if st then
			st.Value = math.max(s.at, p.stage)
		end
		if w then
			w.Value = p.wins
		end
	end
	player:SetAttribute("Stage", math.max(s.at, p.stage))
	local canDaily, dailyIn, nextDay = dailyInfo(p)
	local claimed = {}
	for i in s.playClaimed do
		table.insert(claimed, i)
	end
	local passes = {}
	for name in Config.Passes do
		passes[name] = Session.hasPass(player, name)
	end
	local run = s.run
	local now = os.time()
	Remotes.fire("State", player, {
		run = { start = run.start, valid = run.valid, finalMs = run.finalMs, best = p.bestRunMs },
		starter = {
			available = Config.Products.StarterPack ~= 0 and not p.starterBought and now - p.firstJoin < Config.StarterPackWindow,
			endsAt = p.firstJoin + Config.StarterPackWindow,
			firstSession = now - p.firstJoin < Config.StarterPackWindow,
		},
		boostEndsAt = p.boostEndsAt,
		groupGift = Config.GroupId ~= 0 and not p.groupGiftClaimed,
		stage = p.stage,
		at = math.max(s.at, p.stage),
		base = p.base,
		best = p.best,
		gifts = p.gifts,
		boosts = p.boosts,
		charges = p.charges,
		perks = p.perks,
		roam = s.roam,
		pocket = p.pocket ~= nil and p.pocket.stage == p.stage,
		wins = p.wins,
		coins = p.coins,
		freeSkips = p.freeSkips,
		trails = p.trails,
		equippedTrail = p.equippedTrail,
		effects = p.effects,
		equippedEffect = p.equippedEffect,
		settings = p.settings,
		lang = p.lang,
		passes = passes,
		daily = { canClaim = canDaily, nextIn = dailyIn, day = nextDay },
		playSeconds = os.clock() - s.joined,
		playClaimed = claimed,
		persistent = Data.isPersistent(player),
		studio = RunService:IsStudio(),
		studioTools = Session.studioTools(),
	})
	for _, fn in pushHooks do
		task.spawn(fn, player)
	end
end

function Session.pushAll()
	for _, player in Players:GetPlayers() do
		Session.push(player)
	end
end

return Session
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">Shops</string>
          <string name="Source"><![CDATA[--!strict
-- Shop zones on the way up (one at the entrance of every world): pedestals that sell advantages
-- for coins. Catalogue and purchase rules: Shared/Powerups (pure, unit-tested). This module takes
-- the payment on the saved profile, applies the effect and makes the run "assisted" (not ranked).
--
--   speed / gravity / doublejump / magnet : timed (the end time is saved, so they survive a rejoin)
--   shield  : charges. A kill brick / laser / lava hit spends one instead of killing you
--   pocket  : charges. "Place" drops a portable checkpoint where you stand (until the next save)
--   skip    : instant, skips the next stage
-- Nothing here is random and nothing is sold for Robux directly: the Robux versions are the game
-- passes (SpeedCoil, GravityCoil, DoubleJump, InfiniteRevives) and the SkipStage product.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Powerups = require(ReplicatedStorage.Shared.Powerups)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local Session = require(script.Parent.Session)
local Towers = require(script.Parent.Towers)
local Obstacles = require(script.Parent.Obstacles)
local Checkpoints = require(script.Parent.Checkpoints)
local Cosmetics = require(script.Parent.Cosmetics)

local Shops = {}

Shops.SHIELD_SECONDS = 1.6 -- grace after a shield absorbs a hit (time to step off the kill brick)
Shops.MAGNET_RADIUS = 16
Shops.MAGNET_TICK = 0.3

local M = Remotes.M

-- Buys `id` with coins for `player`. Returns ok, message.
function Shops.buy(player: Player, id: string): (boolean, any?)
	local p = Data.get(player)
	local s = Session.get(player)
	local item = Powerups.get(id)
	if not p or not s or not item then
		return false, M("err.not_for_sale")
	end
	if id == "skip" and not Checkpoints.canSkip(player) then
		return false, M("err.at_top") -- nothing to skip here: don't take the coins
	end
	local ok, err = Powerups.buy(p :: any, id, os.time())
	if not ok then
		return false, M(err or "err.generic")
	end
	if id == "skip" then
		Checkpoints.skip(player, 1, "coins")
	elseif id == "shield" or id == "pocket" then
		Session.push(player)
	else
		Cosmetics.applyCoils(player)
		Session.refreshHelp(player)
		Session.push(player)
	end
	return true, M("msg.bought", { name = M("power." .. id .. ".name") })
end

-- Portable checkpoint: where the character stands right now, if it is standing on something.
function Shops.placePocket(player: Player): (boolean, any?)
	local p = Data.get(player)
	local s = Session.get(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not p or not s or not char or not root or not hum or hum.Health <= 0 then
		return false, M("err.not_available")
	end
	if s.inLobby or s.roam or math.max(s.at, p.stage) <= 0 then
		return false, M("err.pocket_here")
	end
	local unlimited = Session.hasPass(player, "InfiniteRevives")
	if not unlimited and (p.charges.pocket or 0) <= 0 then
		return false, M("err.no_charges")
	end
	-- must be standing on solid ground that is not a hazard or something that moves away
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char }
	local hit = Workspace:Raycast(root.Position, Vector3.new(0, -6, 0), params)
	if not hit or not hit.Instance.CanCollide or hit.Instance.Name == "Kill" or hit.Instance.Name == "Lava" then
		return false, M("err.pocket_here")
	end
	if not unlimited then
		Powerups.use(p :: any, "pocket")
	end
	local pos = root.Position + Vector3.new(0, 0.5, 0)
	p.pocket = { stage = p.stage, at = math.max(s.at, p.stage), x = pos.X, y = pos.Y, z = pos.Z }
	Session.assist(player, "powerup")
	Session.push(player)
	return true, M("msg.pocket_placed")
end

function Shops.init()
	-- a shield turns a lethal hit into a short grace period
	Obstacles.absorb = function(player: Player): boolean
		local p = Data.get(player)
		local s = Session.get(player)
		if not p or not s or not Powerups.use(p :: any, "shield") then
			return false
		end
		s.shieldUntil = os.clock() + Shops.SHIELD_SECONDS
		Session.assist(player, "powerup")
		Remotes.fire("Shield", player, { left = p.charges.shield or 0 })
		Session.push(player)
		return true
	end

	Towers.onBuilt(function(tower)
		for _, pr in tower.prompts do
			if pr.kind == "shop" then
				pr.prompt.Triggered:Connect(function(player)
					local ok, msg = Shops.buy(player, pr.id)
					Remotes.notify(player, msg, if ok then "success" else "error")
				end)
			end
		end
	end)

	Remotes.handle("BuyPower", function(player, payload)
		return Shops.buy(player, tostring(payload.id))
	end)
	Remotes.handle("PlacePocket", function(player)
		return Shops.placePocket(player)
	end)

	-- one loop for every timed effect: expiry (1 s) and the coin magnet (0.3 s)
	task.spawn(function()
		local sinceExpiry = 0
		while true do
			task.wait(Shops.MAGNET_TICK)
			sinceExpiry += Shops.MAGNET_TICK
			local now = os.time()
			local checkExpiry = sinceExpiry >= 1
			if checkExpiry then
				sinceExpiry = 0
			end
			for _, player in Players:GetPlayers() do
				local p = Data.get(player)
				local s = Session.get(player)
				if not p or not s then
					continue
				end
				if checkExpiry and Powerups.sweep(p.boosts, now) > 0 then
					Cosmetics.applyCoils(player)
					Session.push(player)
				end
				if Powerups.active(p.boosts, "magnet", now) and not s.inLobby then
					local here = math.max(s.at, p.stage)
					for stage = here, here + 2 do
						for _, coin in Obstacles.coinsOf(stage) do
							Obstacles.collectCoin(player, coin, Shops.MAGNET_RADIUS)
						end
					end
				end
			end
		end
	end)
end

return Shops
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">StageGenerator</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the world in code from the pure Layout.
--   buildLobby()   : the lobby island (once)
--   buildTower(t)  : one of the ten towers: core pillar, 100 stages, checkpoint pads, milestone
--                    banners, the shop at every world entrance, the summit room with its portal and
--                    gift, the base island (towers 2..10) and the scenery. Towers 2..10 are built
--                    and destroyed on demand by server/Towers.luau.
-- Runtime behaviour (moving parts, kill touches, fading platforms, lasers...) lives in
-- Obstacles.luau and is driven by CollectionService tags + attributes set here.
local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Locale = require(ReplicatedStorage.Shared.Locale)
local TowerStyle = require(ReplicatedStorage.Shared.TowerStyle)
local Gifts = require(ReplicatedStorage.Shared.Gifts)
local Scenery = require(script.Parent.Scenery)

local StageGenerator = {}

-- Something the player can activate: `kind` = shop | lounge | portal | home | rebirth | stall.
export type Prompt = { kind: string, id: string, prompt: ProximityPrompt }

export type Tower = {
	tower: number,
	map: Layout.Map,
	folder: Folder,
	pads: { [number]: BasePart }, -- by GLOBAL stage (tower 1 also has pad 0)
	padCFrames: { [number]: CFrame }, -- where to put a character standing on that pad
	baseCFrame: CFrame, -- standing on pad 0 (the lobby start pad / the tower's base island)
	prompts: { Prompt },
	portal: BasePart?, -- walk into it: next tower
}

export type Lobby = {
	lobbySpawn: CFrame,
	board: BasePart,
	fastBoard: BasePart,
	stageBoard: BasePart,
	stalls: { [string]: ProximityPrompt },
}

local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

---------------------------------------------------------------------------------------------
-- small helpers
---------------------------------------------------------------------------------------------
local function newPart(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Parent = parent
	return p
end

local function cylinder(parent: Instance, diameter: number, height: number, center: Vector3, color: Color3, material: Enum.Material?): Part
	local p = newPart(parent, Vector3.new(height, diameter, diameter), CFrame.new(center) * CFrame.Angles(0, 0, math.pi / 2), color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function tag(inst: Instance, name: string)
	CollectionService:AddTag(inst, name)
end

local function billboard(parent: BasePart, text: string, sizeStuds: Vector2, color: Color3, maxDistance: number, offsetY: number): BillboardGui
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromScale(sizeStuds.X, sizeStuds.Y)
	bb.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	bb.MaxDistance = maxDistance
	bb.LightInfluence = 0
	bb.AlwaysOnTop = false
	bb.Adornee = parent
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(30, 30, 50)
	label.Parent = bb
	bb.Parent = parent
	return bb
end

-- World text is localized on each client (client/World/WorldText.luau): the label keeps the English
-- text as a fallback and carries the key (+ JSON args) as attributes.
local function loc(label: Instance, key: string, args: { [string]: any }?)
	label:SetAttribute("LocKey", key)
	if args then
		label:SetAttribute("LocArgs", HttpService:JSONEncode(args))
	end
	if label:IsA("TextLabel") then
		label.Text = Locale.t("en", key, args)
	end
end
StageGenerator.loc = loc

local function locPrompt(prompt: ProximityPrompt, actionKey: string, objectKey: string)
	prompt:SetAttribute("LocAction", actionKey)
	prompt:SetAttribute("LocObject", objectKey)
	prompt.ActionText = Locale.t("en", actionKey)
	prompt.ObjectText = Locale.t("en", objectKey)
end

local function surfaceText(parent: BasePart, face: Enum.NormalId, text: string, color: Color3, bg: Color3?): TextLabel
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = if bg then 0 else 1
	label.BackgroundColor3 = bg or Color3.new()
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.3
	label.Parent = sg
	sg.Parent = parent
	return label
end

-- CFrame of a slab whose TOP is at yRel, centred at (s, lat), facing along the stage.
local function stageCF(st: Layout.Stage, s: number, lat: number, yTop: number, thick: number): CFrame
	local x, y, z = Layout.toWorld(st, s, lat, yTop)
	local pos = Vector3.new(x, y - thick / 2, z)
	return CFrame.lookAt(pos, pos + Vector3.new(st.dirX, 0, st.dirZ))
end

local function latVector(st: Layout.Stage): Vector3
	local x0, _, z0 = Layout.toWorld(st, 0, 0, 0)
	local x1, _, z1 = Layout.toWorld(st, 0, 1, 0)
	return Vector3.new(x1 - x0, 0, z1 - z0)
end

local function darker(c: Color3): Color3
	return c:Lerp(Color3.new(0, 0, 0), 0.35)
end

local function vec(v: Layout.Vec): Vector3
	return Vector3.new(v.x, v.y, v.z)
end

local function prompt(parent: Instance, actionKey: string, objectKey: string, hold: number, distance: number): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	locPrompt(p, actionKey, objectKey)
	p.HoldDuration = hold
	p.MaxActivationDistance = distance
	p.RequiresLineOfSight = false
	p.Parent = parent
	return p
end

---------------------------------------------------------------------------------------------
-- surfaces (nodes) and hazards
---------------------------------------------------------------------------------------------
local ICE = PhysicalProperties.new(0.9, 0, 0, 100, 1)

-- Per-stage random stream for purely visual choices (never touches the layout).
local dressRng: Layout.Rng = Layout.newRng(1)

-- A glyph painted on top of a special platform so its behaviour reads before you step on it:
-- arrows on movers, an hourglass on the ones that fade, "down" arrows on the ones that drop.
local function topIcon(part: BasePart, text: string, color: Color3)
	local sg = Instance.new("SurfaceGui")
	sg.Name = "Icon"
	sg.Face = Enum.NormalId.Top
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 18
	sg.LightInfluence = 0
	sg.MaxDistance = 110
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(0.8, 0.8)
	label.Position = UDim2.fromScale(0.1, 0.1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.TextTransparency = 0.1
	label.TextStrokeTransparency = 0.35
	label.TextStrokeColor3 = Color3.fromRGB(30, 30, 50)
	label.Parent = sg
	sg.Parent = part
end

-- Track of a moving platform: shows where it travels, with a glowing stop at each end.
local function moverRails(model: Instance, part: BasePart, axisIsY: boolean, amp: number, accent: Color3)
	local size = part.Size
	local dark = Color3.fromRGB(55, 58, 72)
	if axisIsY then
		for _, side in { -1, 1 } do
			local x = side * (size.X / 2 + 0.45)
			Scenery.deco(model, Vector3.new(0.45, amp * 2 + size.Y + 1, 0.45), part.CFrame * CFrame.new(x, 0, 0), dark, Enum.Material.Metal).Name = "Rail"
			for _, e in { -1, 1 } do
				Scenery.deco(model, Vector3.new(0.8, 0.5, 0.8), part.CFrame * CFrame.new(x, e * (amp + size.Y / 2 + 0.5), 0), accent, Enum.Material.Neon).Name = "RailStop"
			end
		end
	else
		local y = -size.Y / 2 - 0.45
		Scenery.deco(model, Vector3.new(amp * 2 + size.X, 0.4, 0.6), part.CFrame * CFrame.new(0, y, 0), dark, Enum.Material.Metal).Name = "Rail"
		for _, e in { -1, 1 } do
			Scenery.deco(model, Vector3.new(0.6, 1.1, 1.1), part.CFrame * CFrame.new(e * (amp + size.X / 2), y, 0), accent, Enum.Material.Neon).Name = "RailStop"
		end
	end
end

local function buildNode(st: Layout.Stage, n: Layout.Node, model: Model, theme: Config.Theme, i: number): BasePart
	local cf = stageCF(st, n.s, n.lat, n.y, n.thick)
	local size = Vector3.new(n.width, n.thick, n.len)
	local color = if i % 2 == 0 then theme.alt else theme.platform
	if n.kind == "truss" then
		local bottom = n.yBottom or 0
		local height = math.max(2, math.ceil((n.y - bottom) / 2) * 2)
		local t = Instance.new("TrussPart")
		t.Anchored = true
		t.Size = Vector3.new(2, height, 2)
		local x, y, z = Layout.toWorld(st, n.s, n.lat, n.y - height / 2)
		t.CFrame = CFrame.lookAt(Vector3.new(x, y, z), Vector3.new(x + st.dirX, y, z + st.dirZ))
		t.Color = theme.accent
		t.Material = Enum.Material.Metal
		t.Parent = model
		return t
	end
	local part = newPart(model, size, cf, color, theme.material)
	if n.kind == "platform" then
		Scenery.dressPlatform(model, part, theme, st.tower, st.theme, dressRng)
	elseif n.kind == "beam" then
		part.Color = theme.accent
		part.Material = Enum.Material.SmoothPlastic
	elseif n.kind == "ledge" then
		part.Color = theme.accent
	elseif n.kind == "moving" then
		-- lightened so an orange / pink accent can never be mistaken for a red kill brick
		part.Color = theme.accent:Lerp(Color3.new(1, 1, 1), 0.3)
		part.Material = Enum.Material.SmoothPlastic
		tag(part, "Mover")
		local axis = if n.moveAxis == "y" then Vector3.yAxis else latVector(st)
		part:SetAttribute("Axis", axis)
		part:SetAttribute("Amp", n.moveAmp or 4)
		part:SetAttribute("Period", n.movePeriod or 4)
		part:SetAttribute("Phase", n.movePhase or 0)
		part:SetAttribute("Stage", st.index)
		topIcon(part, if n.moveAxis == "y" then "▲ ▼" else "◀ ▶", Color3.fromRGB(255, 255, 255))
		moverRails(model, part, n.moveAxis == "y", n.moveAmp or 4, theme.pad)
	elseif n.kind == "disappear" then
		part.Color = theme.alt:Lerp(Color3.fromRGB(255, 255, 255), 0.35)
		part.Material = Enum.Material.SmoothPlastic
		part.Transparency = 0.15
		tag(part, "Disappear")
		part:SetAttribute("Delay", n.delay or 0.6)
		topIcon(part, "⏳", Color3.fromRGB(255, 255, 255))
	elseif n.kind == "falling" then
		part.Color = Color3.fromRGB(215, 150, 80)
		part.Material = Enum.Material.WoodPlanks
		tag(part, "Falling")
		part:SetAttribute("Delay", n.delay or 0.5)
		topIcon(part, "▼ ▼", Color3.fromRGB(90, 50, 25))
	elseif n.kind == "ice" then
		part.Color = Color3.fromRGB(180, 230, 255)
		part.Material = Enum.Material.Ice
		part.CustomPhysicalProperties = ICE
	elseif n.kind == "conveyor" then
		part.Color = Color3.fromRGB(60, 62, 72)
		part.Material = Enum.Material.DiamondPlate
		local push = Vector3.new(st.dirX, 0, st.dirZ) * (n.pushS or 0) + latVector(st) * (n.pushLat or 0)
		part.AssemblyLinearVelocity = push
		part:SetAttribute("Push", push)
		tag(part, "Conveyor")
	elseif n.kind == "bounce" then
		part.Color = Color3.fromRGB(80, 255, 110)
		part.Material = Enum.Material.Neon
		tag(part, "Bounce")
		topIcon(part, "▲", Color3.fromRGB(255, 255, 255))
	elseif n.kind == "glass" then
		part.Color = Color3.fromRGB(200, 245, 255)
		part.Material = Enum.Material.Glass
		part.Transparency = 0.8
		tag(part, "Glass")
	end
	return part
end

local function killPart(model: Instance, size: Vector3, cf: CFrame): Part
	local p = newPart(model, size, cf, Config.KillColor, Enum.Material.Neon)
	p.Name = "Kill"
	p.CastShadow = false
	tag(p, "Kill")
	return p
end

local function buildHazard(st: Layout.Stage, h: Layout.Hazard, model: Model, theme: Config.Theme)
	if h.kind == "killstrip" or h.kind == "killcube" then
		killPart(model, Vector3.new(h.width, h.height, h.len), stageCF(st, h.s, h.lat, h.y + h.height, h.height))
	elseif h.kind == "spinner" then
		local x, y, z = Layout.toWorld(st, h.s, h.lat, h.y)
		local center = Vector3.new(x, y + h.height / 2, z)
		local hub = cylinder(model, 2.4, 3, center + Vector3.new(0, 0.5, 0), theme.accent, Enum.Material.Metal)
		hub.Name = "SpinnerHub"
		local bars = h.bars or 1
		for b = 1, bars do
			local bar = killPart(model, Vector3.new(h.len, h.height, h.width), CFrame.new(center))
			bar.Name = "SpinnerBar"
			tag(bar, "Spinner")
			bar:SetAttribute("Center", center)
			bar:SetAttribute("Speed", h.speed or 2)
			bar:SetAttribute("Angle0", (b - 1) * math.pi / bars)
			bar:SetAttribute("Stage", st.index)
		end
	elseif h.kind == "lava" then
		local lava = killPart(model, Vector3.new(h.width, h.height, h.len), stageCF(st, h.s, h.lat, h.y + h.height, h.height))
		lava.Name = "Lava"
		lava.Color = Color3.fromRGB(255, 90, 20)
		lava.Material = Enum.Material.CrackedLava
		tag(lava, "Lava")
		lava:SetAttribute("Bottom", st.from.y + h.y)
		lava:SetAttribute("MinTop", st.from.y + h.y + h.height)
		lava:SetAttribute("MaxTop", st.from.y + (h.maxRise or 4))
		lava:SetAttribute("Period", h.period or 10)
		lava:SetAttribute("Stage", st.index)
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 120, 40)
		light.Range = 24
		light.Brightness = 2
		light.Shadows = false
		light.Parent = lava
		local embers = Instance.new("ParticleEmitter")
		embers.Name = "Embers"
		embers.Texture = "rbxasset://textures/particles/fire_main.dds"
		embers.Color = ColorSequence.new(Color3.fromRGB(255, 220, 90), Color3.fromRGB(255, 70, 20))
		embers.Rate = 10
		embers.Lifetime = NumberRange.new(1.2, 2.2)
		embers.Speed = NumberRange.new(3, 7)
		embers.SpreadAngle = Vector2.new(25, 25)
		embers.Size = NumberSequence.new(0.9, 0.1)
		embers.LightEmission = 1
		embers.EmissionDirection = Enum.NormalId.Top
		embers.Parent = lava
	elseif h.kind == "wall" then
		local wall = newPart(model, Vector3.new(h.width, h.height, h.len), stageCF(st, h.s, h.lat, h.y + h.height, h.height), theme.alt, theme.material)
		wall.Name = "Wall"
	elseif h.kind == "laser" then
		-- a gate of light across the walkway; Obstacles.luau switches it on and off and kills
		local cf = stageCF(st, h.s, h.lat, h.y + h.height, h.height)
		local beam = Scenery.deco(model, Vector3.new(h.width, h.height, h.len), cf, Config.KillColor, Enum.Material.Neon)
		beam.Name = "Laser"
		beam.Transparency = 0.3
		beam:SetAttribute("Period", h.period or 3)
		beam:SetAttribute("Duty", h.duty or 0.5)
		beam:SetAttribute("Phase", h.phase or 0)
		beam:SetAttribute("Stage", st.index)
		tag(beam, "Laser")
		local metal = Color3.fromRGB(55, 58, 72)
		for _, side in { -1, 1 } do
			Scenery.deco(model, Vector3.new(0.8, h.height + 0.8, 1.3), cf * CFrame.new(side * (h.width / 2 + 0.4), 0.4, 0), metal, Enum.Material.Metal).Name = "LaserPost"
			Scenery.deco(model, Vector3.new(0.5, 0.5, 1.4), cf * CFrame.new(side * (h.width / 2 + 0.4), h.height / 2 + 0.9, 0), Color3.fromRGB(255, 220, 60), Enum.Material.Neon).Name = "LaserLamp"
		end
	elseif h.kind == "wind" then
		-- invisible zone: each client pushes its own character sideways while inside
		-- (client/World/LocalFx.luau); streaks and chevrons show where it blows
		local cf = stageCF(st, h.s, h.lat, h.y + h.height, h.height)
		local zone = Scenery.deco(model, Vector3.new(h.width, h.height, h.len), cf, Color3.new(1, 1, 1))
		zone.Name = "Wind"
		zone.Transparency = 1
		local dir = latVector(st) * (if (h.push or 0) >= 0 then 1 else -1)
		zone:SetAttribute("Push", dir * math.abs(h.push or 0))
		zone:SetAttribute("Stage", st.index)
		tag(zone, "Wind")
		local streaks = Instance.new("ParticleEmitter")
		streaks.Name = "Streaks"
		streaks.Texture = SMOKE
		streaks.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
		streaks.Rate = 9
		streaks.Lifetime = NumberRange.new(1, 1.6)
		streaks.Speed = NumberRange.new(0, 0)
		streaks.Acceleration = dir * 26
		streaks.Size = NumberSequence.new(0.5, 1.4)
		streaks.Squash = NumberSequence.new(1.6)
		streaks.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.2, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		})
		streaks.Parent = zone
		-- chevrons hanging over the route, pointing where the wind blows (readable without particles)
		local routeY = st.rise * math.clamp((h.s - Layout.PAD_RADIUS) / (st.span - 2 * Layout.PAD_RADIUS), 0, 1) + 7.5
		local x, y, z = Layout.toWorld(st, h.s, 0, routeY)
		local at = Vector3.new(x, y, z)
		for k = -1, 1 do
			local tip = at + dir * (k * 2.6)
			local frame = CFrame.lookAt(tip, tip + dir)
			for _, side in { -1, 1 } do
				local bar = Scenery.deco(model, Vector3.new(0.35, 0.35, 1.8), frame * CFrame.Angles(0, side * math.rad(40), 0) * CFrame.new(0, 0, 0.9), Color3.fromRGB(235, 250, 255), Enum.Material.Neon)
				bar.Name = "WindArrow"
				bar:SetAttribute("Order", k + 1)
				tag(bar, "BeltArrow")
			end
		end
	end
end

---------------------------------------------------------------------------------------------
-- one builder per obstacle kind (common surfaces + that kind's own flavour)
---------------------------------------------------------------------------------------------
local function buildBasic(st: Layout.Stage, model: Model, theme: Config.Theme)
	for i, n in st.nodes do
		buildNode(st, n, model, theme, i)
	end
	for _, h in st.hazards do
		buildHazard(st, h, model, theme)
	end
end

local Builders: { [string]: (Layout.Stage, Model, Config.Theme) -> () } = {}
for _, kind in Layout.Kinds do
	Builders[kind] = buildBasic
end

function Builders.conveyor(st, model, theme)
	buildBasic(st, model, theme)
	-- neon chevrons on top of every belt, pointing where it pushes you
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") and CollectionService:HasTag(child, "Conveyor") then
			local push = child:GetAttribute("Push") :: Vector3?
			if push and push.Magnitude > 0 then
				local dir = push.Unit
				local top = child.Position + Vector3.new(0, child.Size.Y / 2 + 0.06, 0)
				local reach = math.min(child.Size.X, child.Size.Z) * 0.3
				for _, offset in { -1, 0, 1 } do
					local tip = top + dir * (offset * reach * 1.4)
					local frame = CFrame.lookAt(tip, tip + dir)
					for _, side in { -1, 1 } do
						local bar = Scenery.deco(model, Vector3.new(0.35, 0.1, reach), frame * CFrame.Angles(0, side * math.rad(40), 0) * CFrame.new(0, 0, reach / 2), Color3.fromRGB(255, 220, 60), Enum.Material.Neon)
						bar.Name = "Arrow"
						-- the three chevrons light up one after another in the push direction
						-- (client/World/Juice.luau), so the belt reads as running
						bar:SetAttribute("Order", offset + 1)
						tag(bar, "BeltArrow")
					end
				end
			end
		end
	end
end

function Builders.bounce(st, model, theme)
	buildBasic(st, model, theme)
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") and CollectionService:HasTag(part, "Bounce") then
			local e = Instance.new("ParticleEmitter")
			e.Texture = SPARKLES
			e.Color = ColorSequence.new(Color3.fromRGB(120, 255, 140))
			e.Rate = 6
			e.Lifetime = NumberRange.new(0.6, 1)
			e.Speed = NumberRange.new(6, 10)
			e.SpreadAngle = Vector2.new(15, 15)
			e.EmissionDirection = Enum.NormalId.Top
			e.Parent = part
		end
	end
end

function Builders.lava(st, model, theme)
	buildBasic(st, model, theme)
	-- a see-through tank around the lava so the rising slab reads as "filling up" instead of a
	-- floating block (visual only: no collisions, touches or raycasts)
	for _, lava in model:GetChildren() do
		if lava:IsA("BasePart") and CollectionService:HasTag(lava, "Lava") then
			local bottom = lava:GetAttribute("Bottom") :: number
			local top = (lava:GetAttribute("MaxTop") :: number) + 0.6
			local h = top - bottom
			local cf = lava.CFrame.Rotation + Vector3.new(lava.Position.X, bottom + h / 2, lava.Position.Z)
			local size = lava.Size
			local floor = newPart(model, Vector3.new(size.X + 1, 1, size.Z + 1), cf * CFrame.new(0, -h / 2 - 0.5, 0), darker(theme.alt), theme.material)
			floor.Name = "LavaTankFloor"
			for _, side in { { size.X / 2 + 0.25, 0, 0.5, size.Z + 1 }, { -size.X / 2 - 0.25, 0, 0.5, size.Z + 1 }, { 0, size.Z / 2 + 0.25, size.X, 0.5 }, { 0, -size.Z / 2 - 0.25, size.X, 0.5 } } do
				local wall = Scenery.deco(model, Vector3.new(side[3], h, side[4]), cf * CFrame.new(side[1], 0, side[2]), Color3.fromRGB(255, 170, 120), Enum.Material.Glass)
				wall.Transparency = 0.7
				wall.Name = "LavaTankWall"
			end
		end
	end
end

StageGenerator.Builders = Builders

---------------------------------------------------------------------------------------------
-- pads and milestones
---------------------------------------------------------------------------------------------
-- `g` = global stage of the checkpoint (nil for the base pad of towers 2..10, which belongs to
-- the summit of the tower before). Saving pads get a flag; rest pads are dimmer and smaller in
-- presence: you stand on them, but a fall takes you back to the last flag.
local function buildPad(folder: Instance, g: number?, pos: Vector3, axis: Vector3, theme: Config.Theme, thick: number): Part
	local save = g == nil or g == 0 or Layout.isSave(g)
	local color = if save then theme.pad else theme.pad:Lerp(Color3.fromRGB(150, 155, 170), 0.55)
	local pad = cylinder(folder, Layout.PAD_RADIUS * 2, thick, pos - Vector3.new(0, thick / 2, 0), color, if save then Enum.Material.Neon else Enum.Material.SmoothPlastic)
	local rim = cylinder(folder, Layout.PAD_RADIUS * 2 + 1.2, thick - 0.2, pos - Vector3.new(0, thick / 2 + 0.1, 0), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic)
	rim.Name = "PadRim"
	rim.CanTouch = false
	-- target look: a pale inlay and a glowing centre dot painted on the pad (non-solid, 0.1 stud),
	-- so the pad is a ring of light instead of one big glowing disc
	local inlay = Scenery.deco(folder, Vector3.new(0.1, Layout.PAD_RADIUS * 1.4, Layout.PAD_RADIUS * 1.4), CFrame.new(pos + Vector3.new(0, 0.02, 0)) * CFrame.Angles(0, 0, math.pi / 2), theme.pad:Lerp(Color3.new(1, 1, 1), 0.78), Enum.Material.SmoothPlastic)
	inlay.Shape = Enum.PartType.Cylinder
	inlay.Name = "PadInlay"
	local dot = Scenery.deco(folder, Vector3.new(0.14, Layout.PAD_RADIUS * 0.5, Layout.PAD_RADIUS * 0.5), CFrame.new(pos + Vector3.new(0, 0.03, 0)) * CFrame.Angles(0, 0, math.pi / 2), color, if save then Enum.Material.Neon else Enum.Material.SmoothPlastic)
	dot.Shape = Enum.PartType.Cylinder
	dot.Name = "PadDot"
	if g == nil then
		pad.Name = "BasePad"
		return pad
	end
	pad.Name = "Checkpoint_" .. g
	pad:SetAttribute("Stage", g)
	pad:SetAttribute("Save", save)
	tag(pad, "Checkpoint")
	dot:SetAttribute("Stage", g)
	tag(dot, "PadDot")
	if g > 0 then
		-- the stage number floats over the pad edge (over the flag pole on saving pads), clear of
		-- the name tag of whoever is standing on the pad
		local out = Vector3.new(pos.X - axis.X, 0, pos.Z - axis.Z).Unit
		local foot = pos + out * (Layout.PAD_RADIUS - 0.7)
		local anchor = Scenery.deco(folder, Vector3.new(1, 1, 1), CFrame.new(foot + Vector3.new(0, if save then 11.4 else 6.5, 0)), Color3.new())
		anchor.Transparency = 1
		anchor.Name = "Sign_" .. g
		billboard(anchor, tostring(g), if save then Vector2.new(5, 3) else Vector2.new(3.6, 2.2), if save then Color3.fromRGB(255, 255, 255) else Color3.fromRGB(215, 220, 235), 90, 0)
		if save then
			-- checkpoint flag on the outer edge of the pad. Each client raises it (and turns it
			-- green) for the pads that player has already reached (client/World/Juice.luau).
			local pole = Scenery.deco(folder, Vector3.new(9, 0.4, 0.4), CFrame.new(foot + Vector3.new(0, 4.5, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(245, 245, 250), Enum.Material.Metal)
			pole.Shape = Enum.PartType.Cylinder
			pole.Name = "FlagPole"
			local knob = Scenery.deco(folder, Vector3.new(0.9, 0.9, 0.9), CFrame.new(foot + Vector3.new(0, 9.2, 0)), Color3.fromRGB(255, 205, 70), Enum.Material.Neon)
			knob.Shape = Enum.PartType.Ball
			knob.Name = "FlagKnob"
			local frame = CFrame.lookAt(foot, foot + out)
			local flag = Scenery.deco(folder, Vector3.new(3.4, 2.2, 0.2), frame * CFrame.new(1.9, 2.4, 0), Color3.fromRGB(235, 235, 245), Enum.Material.SmoothPlastic)
			flag.Name = "Flag_" .. g
			flag:SetAttribute("Stage", g)
			flag:SetAttribute("Low", frame * CFrame.new(1.9, 2.4, 0))
			flag:SetAttribute("High", frame * CFrame.new(1.9, 7.6, 0))
			tag(flag, "Flag")
		end
	end
	return pad
end

-- Banner + halo over the first pad of a world (every 10 stages).
local function buildMilestone(folder: Instance, g: number, pos: Vector3)
	local style = Layout.themeFor(g + 1)
	local ringRadius = 9
	local segments = 20
	local center = pos + Vector3.new(0, 11, 0)
	for i = 1, segments do
		local a = (i / segments) * math.pi * 2
		local p = Scenery.deco(folder, Vector3.new(1.2, 1.2, 3.2), CFrame.new(center + Vector3.new(math.cos(a) * ringRadius, 0, math.sin(a) * ringRadius)) * CFrame.Angles(0, -a, 0), Config.RebirthColors[(i % #Config.RebirthColors) + 1], Enum.Material.Neon)
		p.Name = "Halo"
	end
	local anchor = Scenery.deco(folder, Vector3.new(1, 1, 1), CFrame.new(center + Vector3.new(0, 7, 0)), Color3.new())
	anchor.Transparency = 1
	anchor.Name = "Milestone_" .. g
	local bb = billboard(anchor, "", Vector2.new(28, 9), Color3.fromRGB(255, 240, 90), 300, 0)
	local label = bb:FindFirstChildOfClass("TextLabel") :: TextLabel
	loc(label, "sign.milestone", { n = g, w = g // 10 + 1, name = { key = "world." .. style } })
	local light = Instance.new("PointLight")
	light.Range = 30
	light.Brightness = 3
	light.Color = Color3.fromRGB(255, 240, 150)
	light.Shadows = false
	light.Parent = anchor
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARKLES
	e.Rate = 12
	e.Lifetime = NumberRange.new(1.5, 2.5)
	e.Speed = NumberRange.new(2, 4)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Color = ColorSequence.new(Color3.fromRGB(255, 230, 90), Color3.fromRGB(255, 120, 220))
	e.Parent = anchor
end

-- The core pillar: one segment per world in that world's material, six pilasters, an accent band
-- at every world boundary. A Persistent model: the silhouette of the tower is always there, even
-- for the parts of it that are streamed out.
local function buildCore(folder: Instance, map: Layout.Map)
	local core = Instance.new("Model")
	core.Name = "Core"
	core.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	local axis = vec(map.origin)
	for w = 1, 10 do
		local theme = Config.theme(map.tower, Layout.themeFor((map.tower - 1) * Layout.STAGES + (w - 1) * 10 + 1))
		local y0 = if w == 1 then 0 else map.pads[(w - 1) * 10].y
		local y1 = map.pads[w * 10].y
		local h = y1 - y0
		-- a 100-stud neon/glass pillar is blinding: the core uses a matte version of the theme
		local mat = if theme.material == Enum.Material.Neon or theme.material == Enum.Material.Glass then Enum.Material.SmoothPlastic else theme.material
		if mat == Enum.Material.Grass then
			mat = Enum.Material.Wood -- a giant tree trunk
		end
		local segment = cylinder(core, Layout.CORE_RADIUS * 2, h, axis + Vector3.new(0, y0 + h / 2, 0), theme.alt, mat)
		segment.Name = "Core_" .. w
		segment.CastShadow = false
		-- six pilasters, so the pillar reads as a tower instead of a flat tube
		for i = 0, 5 do
			local a = i * math.pi / 3 + math.pi / 6
			local pos = axis + Vector3.new(math.cos(a) * (Layout.CORE_RADIUS + 0.3), y0 + h / 2, math.sin(a) * (Layout.CORE_RADIUS + 0.3))
			local rib = Scenery.deco(core, Vector3.new(3, h, 1.8), CFrame.lookAt(pos, Vector3.new(axis.X, pos.Y, axis.Z)), theme.alt:Lerp(theme.accent, 0.35):Lerp(Color3.new(), 0.18), mat)
			rib.Name = "CoreRib"
		end
		local band = Scenery.deco(core, Vector3.new(2, Layout.CORE_RADIUS * 2 + 1, Layout.CORE_RADIUS * 2 + 1), CFrame.new(axis + Vector3.new(0, y1, 0)) * CFrame.Angles(0, 0, math.pi / 2), theme.accent, Enum.Material.Neon)
		band.Shape = Enum.PartType.Cylinder
		band.Name = "CoreBand_" .. w
	end
	core.Parent = folder
end

-- Clouds all the way up, tinted by the world they float in (dark smoke in the lava caves, green
-- smog around the factory, violet nebula puffs in space) and by the tower's mood.
local CLOUD_TINT: { { any } } = {
	{ { 255, 255, 255 }, 0.1 },
	{ { 255, 222, 240 }, 0.1 },
	{ { 235, 245, 255 }, 0.18 },
	{ { 255, 232, 200 }, 0.15 },
	{ { 70, 46, 46 }, 0.35 },
	{ { 190, 240, 245 }, 0.3 },
	{ { 140, 165, 100 }, 0.35 },
	{ { 255, 255, 255 }, 0.05 },
	{ { 110, 80, 200 }, 0.55 },
	{ { 255, 230, 240 }, 0.15 },
}

local function buildClouds(folder: Instance, map: Layout.Map, count: number)
	local rng = Layout.newRng(Config.MapSeed + 99 + map.tower * 17)
	local top = map.pads[Layout.STAGES].y
	local axis = vec(map.origin)
	local mood = TowerStyle.mood(map.tower)
	for _ = 1, count do
		local a = rng.range(0, math.pi * 2)
		local r = rng.range(150, 330)
		local y = rng.range(40, top + 60)
		local slot = 1
		for w = 1, 9 do
			if y > map.pads[w * 10].y then
				slot = w + 1
			end
		end
		local tint = CLOUD_TINT[Layout.themeFor((map.tower - 1) * Layout.STAGES + (slot - 1) * 10 + 1)]
		local color = Config.c3(TowerStyle.shift(tint[1], mood))
		local base = CFrame.new(axis + Vector3.new(math.cos(a) * r, y, math.sin(a) * r)) * CFrame.Angles(0, -a, 0)
		local s = rng.range(22, 44)
		for j = 1, 3 do
			local k = if j == 1 then 1 else rng.range(0.5, 0.75)
			local p = Scenery.deco(folder, Vector3.new(s * k, s * 0.42 * k, s * 1.5 * k), base * CFrame.new(if j == 1 then 0 else rng.range(-3, 3), if j == 1 then 0 else s * 0.12, if j == 1 then 0 else (j * 2 - 5) * s * 0.42), color, Enum.Material.SmoothPlastic)
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = p
			p.Transparency = tint[2] :: number
			p.Name = "Cloud"
		end
	end
end

---------------------------------------------------------------------------------------------
-- lobby
---------------------------------------------------------------------------------------------
local function buildStall(folder: Instance, nameKey: string, pos: Vector3, facing: Vector3, color: Color3, actionKey: string): ProximityPrompt
	local m = Instance.new("Model")
	m.Name = Locale.t("en", nameKey)
	local cf = CFrame.lookAt(pos, pos + facing)
	local counter = newPart(m, Vector3.new(10, 3.5, 3), cf * CFrame.new(0, 1.75, 0), Color3.fromRGB(250, 240, 225), Enum.Material.WoodPlanks)
	counter.Name = "Counter"
	for _, x in { -4.5, 4.5 } do
		newPart(m, Vector3.new(0.8, 9, 0.8), cf * CFrame.new(x, 4.5, 1.5), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic)
	end
	-- striped awning
	for i = 0, 4 do
		local stripe = newPart(m, Vector3.new(2.2, 0.6, 5), cf * CFrame.new(-4.4 + i * 2.2, 9.3, 0.5) * CFrame.Angles(math.rad(-12), 0, 0), if i % 2 == 0 then color else Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic)
		stripe.Name = "Awning"
	end
	local sign = newPart(m, Vector3.new(9, 2.4, 0.4), cf * CFrame.new(0, 11, -1), color, Enum.Material.SmoothPlastic)
	sign.Name = "Sign"
	loc(surfaceText(sign, Enum.NormalId.Front, "", Color3.fromRGB(255, 255, 255)), nameKey)
	local p = prompt(counter, actionKey, nameKey, 0, 12)
	m.Parent = folder
	return p
end

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.5
	Lighting.GlobalShadows = true
	Lighting.Ambient = Color3.fromRGB(120, 120, 140)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 170)
	-- sky light fills the faces the sun doesn't reach (otherwise the sides of platforms go black)
	Lighting.EnvironmentDiffuseScale = 0.55
	Lighting.EnvironmentSpecularScale = 0.35
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atm = Instance.new("Atmosphere")
		atm.Density = 0.25
		atm.Haze = 1
		atm.Color = Color3.fromRGB(200, 225, 255)
		atm.Decay = Color3.fromRGB(150, 190, 255)
		atm.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("Sky") then
		local sky = Instance.new("Sky") -- default built-in skybox, no uploads
		sky.Parent = Lighting
	end
	-- post-processing (bloom, colour grading, sun rays) and the per-height look are client-side:
	-- see client/World/Atmos.luau + Shared/Ambience.luau
end

function StageGenerator.buildLobby(): Lobby
	setupLighting()
	local folder = Instance.new("Folder")
	folder.Name = "Lobby"
	local deco = Instance.new("Folder")
	deco.Name = "Decor"

	local floor = cylinder(folder, 300, 4, Vector3.new(0, -2, 0), Color3.fromRGB(120, 210, 100), Enum.Material.Grass)
	floor.Name = "LobbyFloor"
	floor.CastShadow = false
	local path = newPart(folder, Vector3.new(12, 0.3, 50), CFrame.new(0, 0.15, 90), Color3.fromRGB(250, 235, 200), Enum.Material.Sandstone)
	path.Name = "Path"

	local spawnPos = Vector3.new(0, 0.5, 115)
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(spawnPos)
	spawn.Color = Color3.fromRGB(90, 200, 255)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Name = "LobbySpawn"
	spawn.Parent = folder
	local lobbySpawn = CFrame.lookAt(spawnPos + Vector3.new(0, 3.5, 0), Vector3.new(0, 4, 60))

	-- welcome arch over the tower start
	local start = Vector3.new(0, Layout.BASE_Y, Layout.RING_RADIUS)
	for _, x in { -8, 8 } do
		local post = newPart(folder, Vector3.new(2, 16, 2), CFrame.new(start + Vector3.new(x, 6, 4)), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic)
		post.Name = "ArchPost"
	end
	local beam = newPart(folder, Vector3.new(20, 4, 2), CFrame.new(start + Vector3.new(0, 15, 4)), Color3.fromRGB(255, 90, 120), Enum.Material.SmoothPlastic)
	beam.Name = "ArchSign"
	loc(surfaceText(beam, Enum.NormalId.Back, "", Color3.fromRGB(255, 255, 255)), "sign.start")
	loc(surfaceText(beam, Enum.NormalId.Front, "", Color3.fromRGB(255, 255, 255)), "sign.start")

	-- global boards (Leaderboard.luau fills them): Top Wins, Fastest Climb and Highest Stage
	local function boardAt(pos: Vector3, facing: Vector3, name: string): BasePart
		local b = newPart(folder, Vector3.new(16, 16, 1), CFrame.lookAt(pos, pos + facing), Color3.fromRGB(40, 45, 80), Enum.Material.SmoothPlastic)
		b.Name = name
		for _, dz in { -6, 6 } do
			newPart(folder, Vector3.new(1.2, 3, 1.2), b.CFrame * CFrame.new(dz, -9.5, 0), Color3.fromRGB(255, 255, 255), Enum.Material.SmoothPlastic)
		end
		return b
	end
	local board = boardAt(Vector3.new(-34, 11, 104), Vector3.new(1, 0, 0.35), "WinsBoard")
	local fastBoard = boardAt(Vector3.new(-28, 11, 86), Vector3.new(1, 0, 0.35), "FastestBoard")
	local stageBoard = boardAt(Vector3.new(-36, 11, 123), Vector3.new(1, 0, -0.1), "StageBoard")

	local stalls: { [string]: ProximityPrompt } = {}
	stalls.shop = buildStall(folder, "stall.shop", Vector3.new(32, 0, 92), Vector3.new(-1, 0, 0.2), Color3.fromRGB(255, 120, 170), "prompt.open_shop")
	stalls.store = buildStall(folder, "stall.store", Vector3.new(36, 0, 110), Vector3.new(-1, 0, 0), Color3.fromRGB(80, 200, 110), "prompt.open_store")
	stalls.rewards = buildStall(folder, "stall.rewards", Vector3.new(32, 0, 128), Vector3.new(-1, 0, -0.2), Color3.fromRGB(255, 190, 60), "prompt.claim")

	-- a few trees
	local rng = Layout.newRng(Config.MapSeed + 5)
	for _ = 1, 26 do
		local a = rng.range(0, math.pi * 2)
		local r = rng.range(80, 140)
		local base = Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		if (base - Vector3.new(8, 0, 108)).Magnitude > 44 and (base - Vector3.new(-28, 0, 86)).Magnitude > 14 and (base - Vector3.new(-36, 0, 123)).Magnitude > 14 then
			local h = rng.range(6, 10)
			local trunk = cylinder(folder, 1.6, h, base + Vector3.new(0, h / 2, 0), Color3.fromRGB(130, 90, 60), Enum.Material.Wood)
			trunk.Name = "Trunk"
			local top = newPart(folder, Vector3.new(8, 8, 8), CFrame.new(base + Vector3.new(0, h + 2.5, 0)), Color3.fromRGB(70, 180, 80):Lerp(Color3.fromRGB(255, 150, 200), rng.next() * 0.3), Enum.Material.Grass)
			top.Shape = Enum.PartType.Ball
			top.Name = "Leaves"
		end
	end

	Scenery.buildLobby(deco, start, lobbySpawn.Position)
	-- what waits at the top, shown before the first jump
	Scenery.buildGiftPreview(deco, CFrame.lookAt(start + Vector3.new(-13, -2, 9), start + Vector3.new(-13, -2, 60)), Gifts.List[1], loc)

	folder.Parent = Workspace
	deco.Parent = Workspace
	return { lobbySpawn = lobbySpawn, board = board, fastBoard = fastBoard, stageBoard = stageBoard, stalls = stalls }
end

---------------------------------------------------------------------------------------------
-- summit room (pad 100 of every tower): victory floor, rebirth pedestal, gift, portal
---------------------------------------------------------------------------------------------
local function buildSummit(folder: Instance, map: Layout.Map, prompts: { Prompt }): BasePart?
	local t = map.tower
	local axis = vec(map.origin)
	local p100 = vec(map.pads[Layout.STAGES])
	local outward = Vector3.new(p100.X - axis.X, 0, p100.Z - axis.Z).Unit
	local center = p100 + outward * 30
	local floor = cylinder(folder, 50, 2, center - Vector3.new(0, 1, 0), Color3.fromRGB(255, 225, 90), Enum.Material.SmoothPlastic)
	floor.Name = "VictoryFloor"
	-- rainbow pillars around the room
	for i = 1, 10 do
		local a = i / 10 * math.pi * 2
		local pos = center + Vector3.new(math.cos(a) * 22, 6, math.sin(a) * 22)
		local pillar = newPart(folder, Vector3.new(2, 12, 2), CFrame.new(pos), Config.RebirthColors[(i % #Config.RebirthColors) + 1], Enum.Material.Neon)
		pillar.Name = "VictoryPillar"
		pillar.CastShadow = false
		if i % 2 == 0 then
			local e = Instance.new("ParticleEmitter")
			e.Texture = SPARKLES
			e.Rate = 25
			e.Lifetime = NumberRange.new(2, 3)
			e.Speed = NumberRange.new(12, 20)
			e.SpreadAngle = Vector2.new(30, 30)
			e.Acceleration = Vector3.new(0, -12, 0)
			e.Size = NumberSequence.new(0.6)
			e.EmissionDirection = Enum.NormalId.Top
			e.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
				ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 60)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 230, 120)),
				ColorSequenceKeypoint.new(0.75, Color3.fromRGB(80, 170, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 90, 255)),
			})
			e.Parent = pillar
		end
	end
	local signPos = center + outward * 20 + Vector3.new(0, 10, 0)
	local sign = newPart(folder, Vector3.new(26, 7, 1), CFrame.lookAt(signPos, center + Vector3.new(0, 10, 0)), Color3.fromRGB(255, 90, 140), Enum.Material.SmoothPlastic)
	sign.Name = "WinnerSign"
	local signLabel = surfaceText(sign, Enum.NormalId.Front, "", Color3.fromRGB(255, 255, 255))
	if t == 1 then
		loc(signLabel, "sign.winner")
	else
		loc(signLabel, "sign.tower_clear", { n = t, name = { key = "tower." .. TowerStyle.mood(t).key } })
	end
	local pedestal = cylinder(folder, 6, 3, center + Vector3.new(0, 1.5, 0), Color3.fromRGB(255, 255, 255), Enum.Material.Marble)
	pedestal.Name = "RebirthPedestal"
	local orb = Scenery.deco(folder, Vector3.new(3, 3, 3), CFrame.new(center + Vector3.new(0, 5, 0)), Color3.fromRGB(255, 220, 90), Enum.Material.Neon)
	orb.Shape = Enum.PartType.Ball
	orb.Name = "RebirthOrb"
	table.insert(prompts, { kind = "rebirth", id = tostring(t), prompt = prompt(pedestal, "prompt.rebirth", "prompt.winner", 0.5, 12) })

	local frame = CFrame.lookAt(center, center - outward) -- -Z looks back at the tower, +X is to the right
	Scenery.buildVictory(folder, center, outward)
	-- the gift of this tower, on a plinth to the right
	Scenery.buildGiftPreview(folder, frame * CFrame.new(18, 0, -4) * CFrame.Angles(0, math.rad(-70), 0), Gifts.List[t], loc)

	local portal: BasePart? = nil
	if t < Layout.TOWERS then
		-- the way on: a portal to the base of the next tower, on the left
		local nextMood = TowerStyle.mood(t + 1)
		portal = Scenery.buildPortal(folder, frame * CFrame.new(-18, 0, -4) * CFrame.Angles(0, math.rad(70), 0), Config.c3(nextMood.core), "portal.next", { n = t + 1, name = { key = "tower." .. nextMood.key }, from = t * Layout.STAGES + 1, to = (t + 1) * Layout.STAGES }, loc)
		local p = portal :: BasePart
		p.Name = "Portal"
		p:SetAttribute("Tower", t)
		table.insert(prompts, { kind = "portal", id = tostring(t), prompt = prompt(p, "prompt.enter", "prompt.portal", 0, 14) })
	end
	if t == 1 then
		-- the Winner's Lounge: free items for everybody who got here
		for _, item in Scenery.buildLounge(folder, center, outward, loc) do
			table.insert(prompts, { kind = "lounge", id = item.id, prompt = prompt(item.part, "prompt.take", "perk." .. item.id .. ".name", 0.25, 9) })
		end
	end
	return portal
end

---------------------------------------------------------------------------------------------
function StageGenerator.buildTower(t: number): Tower
	local map = Layout.generate(Config.MapSeed, t)
	local axis = vec(map.origin)
	local first = (t - 1) * Layout.STAGES

	local root = Workspace:FindFirstChild("Towers")
	if not root then
		root = Instance.new("Folder")
		root.Name = "Towers"
		root.Parent = Workspace
	end
	local folder = Instance.new("Folder")
	folder.Name = "Tower_" .. t
	folder:SetAttribute("Tower", t)
	local scenery = Instance.new("Folder")
	scenery.Name = "Decor"
	scenery.Parent = folder
	local padFolder = Instance.new("Folder")
	padFolder.Name = "Checkpoints"
	padFolder.Parent = folder
	-- parented first: what is built below replicates as it appears, instead of in one burst
	folder.Parent = root

	buildCore(scenery, map)
	buildClouds(scenery, map, if t == 1 then 64 else 36)
	local stats = Scenery.buildTower(scenery, map)
	folder:SetAttribute("SceneryParts", stats.parts)
	folder:SetAttribute("SceneryLights", stats.lights)
	folder:SetAttribute("SceneryEmitters", stats.emitters)
	task.wait()

	local prompts: { Prompt } = {}
	local pads: { [number]: BasePart } = {}
	local padCFrames: { [number]: CFrame } = {}
	local baseCFrame = CFrame.new()
	for k = 0, Layout.STAGES do
		local g = first + k
		local theme = Config.theme(t, Layout.themeFor(math.max(g, 1)))
		local pos = vec(map.pads[k])
		local isBase = k == 0 and t > 1
		local pad = buildPad(padFolder, if isBase then nil else g, pos, axis, theme, if k == 0 then 2 else Layout.PAD_THICK)
		local nextStage = map.stages[k + 1]
		local look = if nextStage then Vector3.new(nextStage.dirX, 0, nextStage.dirZ) else Vector3.new(pos.X - axis.X, 0, pos.Z - axis.Z).Unit
		local standing = CFrame.lookAt(pos + Vector3.new(0, 3.5, 0), pos + Vector3.new(0, 3.5, 0) + look)
		if k == 0 then
			baseCFrame = standing
		end
		if not isBase then
			pads[g] = pad
			padCFrames[g] = standing
		end
		if Layout.hasShop(k) then
			buildMilestone(padFolder, g, pos)
			-- the shop at the entrance of every world
			local out = Vector3.new(pos.X - axis.X, 0, pos.Z - axis.Z).Unit
			for _, item in Scenery.buildShop(folder, pos, out, theme, loc) do
				table.insert(prompts, { kind = "shop", id = item.id, prompt = prompt(item.part, "prompt.buy", "power." .. item.id .. ".name", 0.35, 8) })
			end
		end
	end
	task.wait()

	for i, st in map.stages do
		local model = Instance.new("Model")
		model.Name = ("Stage_%04d_%s"):format(st.index, st.kind)
		model:SetAttribute("Stage", st.index)
		model:SetAttribute("Kind", st.kind)
		local theme = Config.theme(t, st.theme)
		dressRng = Layout.newRng(Config.MapSeed * 131 + st.index)
		Builders[st.kind](st, model, theme)
		for _, c in st.coins do
			local x, y, z = Layout.toWorld(st, c.s, c.lat, c.y)
			local coin = Scenery.deco(model, Vector3.new(0.5, 2.4, 2.4), CFrame.new(x, y, z), Color3.fromRGB(255, 205, 40), Enum.Material.Neon)
			coin.Shape = Enum.PartType.Cylinder -- axis = X, so the coin stands up like a wheel
			coin.CanTouch = true
			coin.Name = "Coin"
			coin:SetAttribute("CoinId", c.id)
			coin:SetAttribute("Stage", st.index)
			tag(coin, "Coin")
		end
		model.Parent = folder
		if i % 12 == 0 then
			task.wait() -- spread the build over a few frames: no server hitch when a tower appears
		end
	end

	local portal = buildSummit(folder, map, prompts)
	if t > 1 then
		-- base island with the way back to the lobby
		local home = Scenery.buildBase(folder, vec(map.pads[0]), axis, t, loc)
		table.insert(prompts, { kind = "home", id = tostring(t), prompt = prompt(home, "prompt.enter", "prompt.lobby", 0, 12) })
		if t < Layout.TOWERS + 1 then
			local p0 = vec(map.pads[0])
			Scenery.buildGiftPreview(folder, CFrame.lookAt(p0 + Vector3.new(-13, -2, 9), p0 + Vector3.new(-13, -2, 60)), Gifts.List[t], loc)
		end
	end

	return {
		tower = t,
		map = map,
		folder = folder,
		pads = pads,
		padCFrames = padCFrames,
		baseCFrame = baseCFrame,
		prompts = prompts,
		portal = portal,
	}
end

return StageGenerator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">Towers</string>
          <string name="Source"><![CDATA[--!strict
-- The ten towers, built on demand. 1,000 stages never sit in Workspace at once: tower 1 (the one
-- over the lobby) is always there, and towers 2..10 exist only while somebody is climbing them or
-- is about to arrive (the last ten stages of the tower before, or its summit). A tower nobody
-- needs is destroyed after Config.TowerIdleSeconds.
--
-- Rules.towersNeeded decides who needs what; a player never needs more than two towers.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Layout = require(ReplicatedStorage.Shared.Layout)
local Rules = require(ReplicatedStorage.Shared.Rules)
local Data = require(script.Parent.Data)
local Session = require(script.Parent.Session)
local StageGenerator = require(script.Parent.StageGenerator)
local Obstacles = require(script.Parent.Obstacles)

local Towers = {}

Towers.IDLE_SECONDS = 75
Towers.SWEEP_SECONDS = 15

local built: { [number]: StageGenerator.Tower } = {}
local building: { [number]: boolean } = {}
local lastNeeded: { [number]: number } = {}
local onBuilt: { (StageGenerator.Tower) -> () } = {}
local builtCount, releasedCount = 0, 0

-- Called for every tower right after it is built (Checkpoints wires pads, prompts and the portal).
function Towers.onBuilt(fn: (StageGenerator.Tower) -> ())
	table.insert(onBuilt, fn)
	for _, tower in built do
		fn(tower)
	end
end

function Towers.get(t: number): StageGenerator.Tower?
	return built[t]
end

-- Returns the tower, building it first if needed (yields a few frames while it builds).
function Towers.ensure(t: number): StageGenerator.Tower
	t = math.clamp(math.floor(t), 1, Layout.TOWERS)
	lastNeeded[t] = os.clock()
	while building[t] do
		task.wait()
	end
	local existing = built[t]
	if existing then
		return existing
	end
	building[t] = true
	local ok, result = pcall(StageGenerator.buildTower, t)
	building[t] = nil
	if not ok then
		error(("tower %d failed to build: %s"):format(t, tostring(result)))
	end
	local tower = result :: StageGenerator.Tower
	built[t] = tower
	builtCount += 1
	Obstacles.add(tower.folder)
	for _, fn in onBuilt do
		fn(tower)
	end
	return tower
end

local function release(t: number)
	local tower = built[t]
	if not tower or t == 1 then
		return
	end
	built[t] = nil
	releasedCount += 1
	Obstacles.remove(tower.folder)
	tower.folder:Destroy()
end

-- The checkpoint pad of global stage g, if its tower is built.
function Towers.pad(g: number): BasePart?
	local spot = Rules.padOf(Layout :: any, g)
	local tower = built[spot.tower]
	return if tower then tower.pads[g] else nil
end

-- Where a character stands for a spawn spot (Rules.spawn). Builds the tower if needed (yields).
function Towers.standing(spot: Rules.Spot): CFrame
	local tower = Towers.ensure(spot.tower)
	if spot.pad == 0 then
		return tower.baseCFrame
	end
	return tower.padCFrames[(spot.tower - 1) * Layout.STAGES + spot.pad] or tower.baseCFrame
end

function Towers.needed(player: Player): { number }
	local p = Data.get(player)
	local s = Session.get(player)
	if not p or not s then
		return { 1 }
	end
	return Rules.towersNeeded(Layout :: any, p.stage, math.max(s.at, p.stage), p.base)
end

-- Towers currently in Workspace, how many were built and released so far (performance probe).
function Towers.stats(): ({ number }, number, number)
	local list = {}
	for t in built do
		table.insert(list, t)
	end
	table.sort(list)
	return list, builtCount, releasedCount
end

function Towers.sweep()
	local now = os.clock()
	for _, player in Players:GetPlayers() do
		for _, t in Towers.needed(player) do
			lastNeeded[t] = now
			if not built[t] and not building[t] then
				task.spawn(Towers.ensure, t)
			end
		end
	end
	for t in built do
		if t ~= 1 and now - (lastNeeded[t] or 0) > Towers.IDLE_SECONDS then
			release(t)
		end
	end
end

function Towers.init()
	Towers.ensure(1)
	task.spawn(function()
		while true do
			task.wait(Towers.SWEEP_SECONDS)
			Towers.sweep()
		end
	end)
end

return Towers
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="55">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">ModelSlots</string>
            <string name="Source"><![CDATA[--!strict
-- Model slots: real 3D models (Creator Store / Toolbox / Studio AI) replace primitive props
-- WITHOUT touching code. Drop `<slot>.rbxm` (or `<slot>_1.rbxm`, `<slot>_2.rbxm`...) into
-- assets/models/; Rojo maps that folder to ServerStorage.ModelLibrary. No file for the slot ->
-- `fallback()` runs, exactly the old primitive build (an empty library changes nothing).
--
-- Safety: every Script / LocalScript / ModuleScript inside a cloned model is deleted (free models
-- can carry malicious code). A model over the per-slot part cap, or past the total budget, is
-- skipped and the primitive build is used. Server-built props only: this game builds all its
-- world props on the server, so the library lives in ServerStorage (clients never see it).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local ModelFit = require(ReplicatedStorage.Shared.ModelFit)

local ModelSlots = {}

ModelSlots.SlotPartCap = 300 -- parts of one model
ModelSlots.TotalPartCap = 2000 -- parts of every model placed (scenery budget is 4200)
local usedParts = 0
local warned: { [string]: boolean } = {}

local function warnOnce(key: string, msg: string)
	if not warned[key] then
		warned[key] = true
		warn("[ModelSlots] " .. msg)
	end
end

local function library(): Instance?
	return ServerStorage:FindFirstChild("ModelLibrary")
end

local function isUsable(i: Instance): boolean
	return i:IsA("Model") or i:IsA("BasePart")
end

local function libraryNames(lib: Instance): { [string]: boolean }
	local has: { [string]: boolean } = {}
	for _, c in lib:GetChildren() do
		if isUsable(c) then
			has[c.Name] = true
		end
	end
	return has
end

function ModelSlots.hasSlot(slotName: string): boolean
	local lib = library()
	return lib ~= nil and #ModelFit.variantNames(slotName, libraryNames(lib)) > 0
end

local function stripScripts(root: Instance): number
	local n = 0
	for _, d in root:GetDescendants() do
		if d:IsA("LuaSourceContainer") then
			d:Destroy()
			n += 1
		end
	end
	return n
end

local function countParts(root: Instance): number
	local n = if root:IsA("BasePart") then 1 else 0
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

-- collide: true keeps the whole model solid (fallback was solid); false = decorative (no
-- collision, no touch, no queries, no shadows: same as Scenery.deco).
local function prepare(root: Instance, collide: boolean)
	local function fix(p: BasePart)
		p.Anchored = true
		p.CanCollide = collide
		p.CanTouch = false
		p.CanQuery = collide
		p.CastShadow = false
		p.Massless = true
	end
	if root:IsA("BasePart") then
		fix(root)
	end
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			fix(d)
		end
	end
end

export type Options = { collide: boolean?, variantKey: Vector3?, name: string?, maxParts: number? }

-- cf: the BOTTOM CENTRE of the prop (rotation = facing), i.e. where the primitive's lowest point
-- was. targetSize: bounding box the model is scaled to fit (uniform, proportions kept).
-- parent may be nil (the caller parents it after setting attributes). Returns the placed model/part, or whatever fallback() returns when the slot has no usable model.
function ModelSlots.spawn(slotName: string, cf: CFrame, targetSize: Vector3, parent: Instance?, fallback: () -> Instance?, opts: Options?): Instance?
	local o: Options = opts or {}
	local lib = library()
	if not lib then
		return fallback()
	end
	local names = ModelFit.variantNames(slotName, libraryNames(lib))
	if #names == 0 then
		return fallback()
	end
	local key = o.variantKey or cf.Position
	local pick = names[ModelFit.pickVariant(#names, key.X, key.Z)]
	local template = lib:FindFirstChild(pick)
	if not template or not isUsable(template) then
		return fallback()
	end
	local parts = countParts(template)
	if not ModelFit.withinBudget(parts, math.min(o.maxParts or ModelSlots.SlotPartCap, ModelSlots.SlotPartCap), usedParts, ModelSlots.TotalPartCap) then
		warnOnce(pick, ("%s has %d parts (cap %d, used %d/%d): using the primitive build"):format(pick, parts, math.min(o.maxParts or ModelSlots.SlotPartCap, ModelSlots.SlotPartCap), usedParts, ModelSlots.TotalPartCap))
		return fallback()
	end

	local clone = template:Clone()
	local removed = stripScripts(clone)
	if removed > 0 then
		warnOnce(pick .. "#scripts", ("%s: removed %d script(s) found inside the model"):format(pick, removed))
	end
	prepare(clone, o.collide == true)

	if clone:IsA("Model") then
		local size = clone:GetExtentsSize()
		local scale = ModelFit.fitScale({ size.X, size.Y, size.Z }, { targetSize.X, targetSize.Y, targetSize.Z })
		clone:ScaleTo(clone:GetScale() * scale)
		-- bounding-box bottom centre -> cf
		local bbCF, bbSize = clone:GetBoundingBox()
		local pivotOffset = bbCF:ToObjectSpace(clone:GetPivot())
		clone:PivotTo(cf * CFrame.new(0, bbSize.Y / 2, 0) * pivotOffset)
	else
		local bp = clone :: BasePart
		local size = bp.Size
		local scale = ModelFit.fitScale({ size.X, size.Y, size.Z }, { targetSize.X, targetSize.Y, targetSize.Z })
		bp.Size = size * scale
		bp.CFrame = cf * CFrame.new(0, bp.Size.Y / 2, 0)
	end
	if o.name then
		clone.Name = o.name
	end
	clone:SetAttribute("ModelSlot", pick)
	clone.Parent = parent
	usedParts += parts
	return clone
end

function ModelSlots.usedParts(): number
	return usedParts
end

return ModelSlots
]]></string>
          </Properties>
        </Item>
      </Item>
