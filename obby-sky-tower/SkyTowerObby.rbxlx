    <Item class="StarterPlayerScripts" referent="60">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="61">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- Sky Tower Obby: client bootstrap.
local Net = require(script.Net)
local Lang = require(script.Lang)
local Kit = require(script.UI.Kit)
local Toast = require(script.UI.Toast)
local Hud = require(script.UI.Hud)
local Progress = require(script.UI.Progress)
local Celebrate = require(script.UI.Celebrate)
local Intro = require(script.UI.Intro)
local ShopPanel = require(script.UI.ShopPanel)
local StorePanel = require(script.UI.StorePanel)
local RewardsPanel = require(script.UI.RewardsPanel)
local SettingsPanel = require(script.UI.SettingsPanel)
local WinPanel = require(script.UI.WinPanel)
local Prompts = require(script.UI.Prompts)
local EventBar = require(script.UI.EventBar)
local StarterPanel = require(script.UI.StarterPanel)
local TravelPanel = require(script.UI.TravelPanel)
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
local TowerStyle = require(game:GetService("ReplicatedStorage").Shared.TowerStyle)
local RunTime = require(game:GetService("ReplicatedStorage").Shared.RunTime)
local Quality = require(game:GetService("ReplicatedStorage").Shared.Quality)
local LocalFx = require(script.World.LocalFx)
local Atmos = require(script.World.Atmos)
local Juice = require(script.World.Juice)
local Weather = require(script.World.Weather)
local ChatTags = require(script.World.ChatTags)
local WorldText = require(script.World.WorldText)

Kit.gui()
Intro.play()
Progress.init()
Hud.init()
ShopPanel.init()
StorePanel.init()
RewardsPanel.init()
SettingsPanel.init()
WinPanel.init()
StarterPanel.init()
TravelPanel.init()
Prompts.init()
EventBar.init()
LocalFx.init()
Atmos.init()
Juice.init()
Weather.init()
ChatTags.init()
WorldText.init()

-- saved language preference and the effects switch arrive with the State push
local effectsOn = true
Net.changed:Connect(function(s)
	Lang.apply(s.lang)
	local on = not (type(s.settings) == "table" and s.settings.effects == false)
	if on ~= effectsOn then
		effectsOn = on
		Atmos.setEffects(on)
		Juice.setEffects(on)
		Weather.setEffects(on)
	end
end)

-- lite profile: phones / tablets, the graphics slider at 1..3, or ForceLite (tests, screenshots)
do
	local Workspace = game:GetService("Workspace")
	local lite = false
	local function refresh()
		local level = 0
		pcall(function()
			level = Quality.level(UserSettings():GetService("UserGameSettings").SavedQualityLevel.Name)
		end)
		-- ForceLite: true = lite, false = never lite (tests pin the profile), unset = by device
		local forced = Workspace:GetAttribute("ForceLite")
		local now = if forced == false then false else Quality.isLite(Kit.isTouch(), level, forced == true)
		if now ~= lite then
			lite = now
			Atmos.setLite(now)
			Juice.setLite(now)
			Weather.setLite(now)
		end
		Workspace:SetAttribute("LiteProfile", lite)
	end
	refresh()
	pcall(function()
		UserSettings():GetService("UserGameSettings"):GetPropertyChangedSignal("SavedQualityLevel"):Connect(refresh)
	end)
	Workspace:GetAttributeChangedSignal("ForceLite"):Connect(refresh)
	game:GetService("UserInputService").LastInputTypeChanged:Connect(refresh)
end

Net.on("Notify", function(msg: any, kind: string?)
	Toast.show(Lang.msg(msg) or "", kind)
end)
Net.on("Celebrate", function(data)
	Celebrate.stage(data)
end)
local function moodColors(tower: number): { Color3 }
	local mood = TowerStyle.mood(tower)
	local c = Config.c3(mood.core)
	return { c:Lerp(Kit.C.ink, 0.45), c:Lerp(Kit.C.ink, 0.15) }
end

Net.on("Gift", function(data)
	Toast.show(Lang.t("gift.got", { name = { key = "gift." .. tostring(data.id) .. ".name" } }), "success")
end)
Net.on("TowerEnter", function(data)
	local tower = tonumber(data.tower) or 2
	Celebrate.show(Lang.t("celebrate.tower_enter", { n = tower }), Lang.t("tower." .. TowerStyle.mood(tower).key), true, moodColors(tower))
end)
Net.on("Win", function(data)
	local tower = tonumber(data.tower) or 1
	if tower > 1 then
		-- summit of a later tower: the gift is the headline, the portal is the next step
		local gift = if data.gift then Lang.t("gift." .. tostring(data.gift) .. ".name") else nil
		Celebrate.show(Lang.t("celebrate.tower", { n = tower }), gift, true, moodColors(tower))
		return
	end
	local sub = Lang.t("celebrate.total_wins", { n = data.wins or 1 })
	if data.newBest and data.runMs then
		sub = Lang.t("celebrate.new_best", { time = RunTime.format(data.runMs) })
	elseif data.runMs then
		sub = Lang.t("celebrate.run_time", { time = RunTime.format(data.runMs) })
	end
	Celebrate.show(Lang.t("celebrate.win"), sub, true, { Kit.C.orange, Kit.C.pink })
	task.delay(2.5, function()
		Kit.open("win")
	end)
end)
Net.on("OpenPanel", function(name: string)
	Kit.open(name)
end)

-- Ask for a fresh snapshot in case the first push happened before we connected.
task.spawn(function()
	Net.request("GetState")
end)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">Lang</string>
            <string name="Source"><![CDATA[--!strict
-- Client language: saved preference (profile.lang, set with Request "SetLanguage") or the
-- Roblox account locale. Everything user-visible goes through Lang.t / Lang.msg.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)

local Lang = {}

Lang.auto = Locale.resolve(Players.LocalPlayer.LocaleId)
Lang.code = Lang.auto
local changed = Instance.new("BindableEvent")
Lang.changed = changed.Event -- fires (newCode)

function Lang.t(key: string, args: { [string]: any }?): string
	return Locale.t(Lang.code, key, args)
end

-- Server message (string, spec or list of specs) -> text in the current language.
function Lang.msg(m: any): string?
	return Locale.message(Lang.code, m)
end

-- `pref` = saved preference ("" = follow the account locale).
function Lang.apply(pref: string?)
	local code = if pref and Locale.isSupported(pref) then pref else Lang.auto
	if code ~= Lang.code then
		Lang.code = code
		changed:Fire(code)
	end
end

return Lang
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--!strict
-- Client networking: Request wrapper, event hooks and the latest server State snapshot.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Lang = require(script.Parent.Lang)

local Net = {}

local folder = ReplicatedStorage:WaitForChild("Remotes")
local request = folder:WaitForChild("Request") :: RemoteFunction

-- Latest State pushed by the server (see server/Session.luau). Empty until the first push.
Net.state = {} :: { [string]: any }
Net.stateAt = 0
local changed = Instance.new("BindableEvent")
Net.changed = changed.Event -- fires (newState, previousState)

-- Returns ok, message (already translated; the server sends message keys), data.
function Net.request(action: string, payload: { [string]: any }?): (boolean, string?, any?)
	local ok, a, b, c = pcall(function()
		return request:InvokeServer(action, payload)
	end)
	if not ok then
		return false, Lang.t("err.connection")
	end
	return a == true, Lang.msg(b), c
end

function Net.on(eventName: string, fn: (...any) -> ())
	local e = folder:WaitForChild(eventName) :: RemoteEvent
	e.OnClientEvent:Connect(fn)
end

Net.on("State", function(s: { [string]: any })
	local prev = Net.state
	Net.state = s
	Net.stateAt = os.clock()
	changed:Fire(s, prev)
end)

-- Seconds played this session, extrapolated locally between pushes.
function Net.playSeconds(): number
	local base = Net.state.playSeconds
	if type(base) ~= "number" then
		return 0
	end
	return base + (os.clock() - Net.stateAt)
end

function Net.hasPass(name: string): boolean
	local passes = Net.state.passes
	return type(passes) == "table" and passes[name] == true
end

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="64">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">Cards</string>
              <string name="Source"><![CDATA[--!strict
-- Non-blocking offers: a slim strip at the top centre, right under the run timer: one line of
-- title and the buttons side by side. It never covers the route, and it goes away by itself.
-- Used by the "Stuck on stage N?" skip offer (P0-1) and the notification opt-in (P0-8).
local Kit = require(script.Parent.Kit)

local Cards = {}

export type CardButton = { name: string, text: string, color: Color3, onClick: () -> () }

local WIDTH = 620
local BTN_H = 48
local GAP = 8
local TITLE_H = 26
local HEIGHT = TITLE_H + BTN_H + 14

local region: Frame? = nil
local token = 0

local function ensure(): Frame
	if region then
		return region
	end
	local r = Kit.region("Card", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 90), Vector2.new(WIDTH, HEIGHT))
	r.ZIndex = 15
	r.Visible = false
	Kit.onLayout(function(touch, area, scale)
		-- between the Roblox buttons (left) and the progress bar / action column (right)
		local s = math.min(scale, area.X * (if touch then 0.46 else 0.6) / WIDTH)
		r.Position = UDim2.new(0.5, 0, 0, Kit.hudTop + 4)
		Kit.setScale(r, s)
		Kit.cardInset = if r.Visible then math.floor(HEIGHT * s) + 6 else 0
	end)
	region = r
	return r
end

function Cards.hide(name: string?)
	local r = region
	if r and r.Visible and (name == nil or r:GetAttribute("Card") == name) then
		r.Visible = false
		token += 1
		Kit.relayout()
	end
end

function Cards.current(): string?
	local r = region
	if r and r.Visible then
		return r:GetAttribute("Card") :: string?
	end
	return nil
end

-- title: already-translated text. Returns the card frame.
function Cards.show(name: string, title: string, buttons: { CardButton }, seconds: number?): Frame
	local r = ensure()
	for _, c in r:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	token += 1
	local my = token
	r:SetAttribute("Card", name)
	local body = Kit.frame(r, UDim2.fromScale(1, 1), UDim2.new(), Color3.fromRGB(24, 28, 44))
	body.Name = "Body"
	body.BackgroundTransparency = 0.25
	Kit.corner(body, 16)
	local outline = Kit.stroke(body, Color3.new(1, 1, 1), 1.5)
	outline.Transparency = 0.55
	local t = Kit.bold(body, title, UDim2.new(1, -60, 0, TITLE_H), UDim2.fromOffset(12, 4), Kit.C.yellow, nil, 22)
	t.Name = "Title"
	t.TextXAlignment = Enum.TextXAlignment.Left
	Kit.button(body, "X", UDim2.fromOffset(30, 26), UDim2.new(1, -6, 0, 4), Kit.C.red, function()
		Cards.hide(name)
	end, Vector2.new(1, 0), 18).Name = "Close"
	local n = math.max(1, #buttons)
	local w = (WIDTH - 16 - (n - 1) * GAP) / n
	for i, b in buttons do
		local btn = Kit.button(body, b.text, UDim2.fromOffset(w, BTN_H), UDim2.fromOffset(8 + (i - 1) * (w + GAP), TITLE_H + 8), b.color, function()
			Cards.hide(name)
			b.onClick()
		end, nil, 22)
		btn.Name = b.name
	end
	r.Visible = true
	Kit.relayout()
	Kit.pop(body, 0.6)
	if seconds then
		task.delay(seconds, function()
			if token == my then
				Cards.hide(name)
			end
		end)
	end
	return body
end

return Cards
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">Celebrate</string>
              <string name="Source"><![CDATA[--!strict
-- Stage-reached celebration: big pop-up text, UI confetti rain and a 3D particle burst.
-- No sounds (no uploaded assets); everything is tween/particle based.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Kit = require(script.Parent.Kit)
local Lang = require(script.Parent.Parent.Lang)

local Celebrate = {}

local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"
local CONFETTI_COLORS = {
	Kit.C.pink,
	Kit.C.yellow,
	Kit.C.blue,
	Kit.C.green,
	Kit.C.purple,
	Kit.C.orange,
}

local region: Frame? = nil
local confettiLayer: Frame? = nil

local function ensure(): (Frame, Frame)
	if region and confettiLayer then
		return region, confettiLayer
	end
	local r = Kit.region("Celebrate", Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.36), Vector2.new(700, 260))
	r.ZIndex = 30
	local layer = Kit.frame(Kit.gui(), UDim2.fromScale(1, 1), UDim2.new(), nil)
	layer.Name = "Confetti"
	layer.ZIndex = 29
	layer.ClipsDescendants = true
	region, confettiLayer = r, layer
	return r, layer
end

local function confetti(count: number)
	local _, layer = ensure()
	local h = layer.AbsoluteSize.Y
	for _ = 1, count do
		local size = math.random(8, 16)
		local piece = Kit.frame(layer, UDim2.fromOffset(size, size * 0.6), UDim2.new(math.random(), 0, 0, -20), CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)])
		piece.ZIndex = 29
		piece.Rotation = math.random(0, 360)
		local duration = 1.6 + math.random() * 1.2
		local drift = (math.random() - 0.5) * 0.25
		TweenService:Create(piece, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(piece.Position.X.Scale + drift, 0, 0, h + 30),
			Rotation = piece.Rotation + math.random(-540, 540),
		}):Play()
		task.delay(duration + 0.05, function()
			piece:Destroy()
		end)
	end
end

local function burst3D()
	local char = Players.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARKLES
	e.Rate = 0
	e.Lifetime = NumberRange.new(0.8, 1.4)
	e.Speed = NumberRange.new(18, 30)
	e.SpreadAngle = Vector2.new(60, 60)
	e.Acceleration = Vector3.new(0, -40, 0)
	e.Size = NumberSequence.new(0.7, 0.1)
	e.LightEmission = 0.8
	e.EmissionDirection = Enum.NormalId.Top
	e.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Kit.C.pink),
		ColorSequenceKeypoint.new(0.33, Kit.C.yellow),
		ColorSequenceKeypoint.new(0.66, Kit.C.blue),
		ColorSequenceKeypoint.new(1, Kit.C.green),
	})
	e.Parent = root
	e:Emit(45)
	task.delay(2, function()
		e:Destroy()
	end)
end

local showing = 0
-- `ribbon` = two colours: the subtitle sits on a banner in those colours (new world, win).
function Celebrate.show(title: string, subtitle: string?, big: boolean?, ribbon: { Color3 }?)
	local r = ensure()
	showing += 1
	local my = showing
	for _, c in r:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local t = Kit.bold(r, title, UDim2.new(1, 0, 0, if big then 130 else 100), UDim2.fromScale(0.5, 0), Kit.C.yellow, Vector2.new(0.5, 0), if big then 110 else 84)
	t.Rotation = -3
	Kit.pop(t, 0.2)
	if subtitle then
		local y = if big then 140 else 108
		if ribbon then
			local band = Kit.frame(r, UDim2.new(0.94, 0, 0, 68), UDim2.new(0.5, 0, 0, y - 6), Color3.new(1, 1, 1), Vector2.new(0.5, 0))
			band.Name = "Ribbon"
			band.ClipsDescendants = true
			Kit.corner(band, 18)
			Kit.stroke(band, Kit.C.ink, 4)
			Kit.gradient(band, ribbon[1], ribbon[2] or ribbon[1], 0)
			Kit.pop(band, 0.2)
			-- a bright sweep across the banner
			local shine = Kit.frame(band, UDim2.new(0.16, 0, 1.6, 0), UDim2.fromScale(-0.25, -0.3), Color3.new(1, 1, 1))
			shine.BackgroundTransparency = 0.6
			shine.Rotation = 14
			TweenService:Create(shine, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, 0.25), { Position = UDim2.fromScale(1.15, -0.3) }):Play()
		end
		local s = Kit.bold(r, subtitle, UDim2.new(if ribbon then 0.88 else 1, 0, 0, 56), UDim2.new(0.5, 0, 0, y), Kit.C.white, Vector2.new(0.5, 0), 44)
		Kit.pop(s, 0.4)
	end
	confetti(if big then 110 else 45)
	burst3D()
	task.delay(if big then 4 else 2.2, function()
		if showing ~= my then
			return
		end
		for _, c in r:GetChildren() do
			if c:IsA("TextLabel") then
				TweenService:Create(c, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
				local st = c:FindFirstChildOfClass("UIStroke")
				if st then
					TweenService:Create(st, TweenInfo.new(0.3), { Transparency = 1 }):Play()
				end
			elseif c:IsA("Frame") then
				c:Destroy() -- ribbon
			end
		end
	end)
end

function Celebrate.stage(data: { [string]: any })
	local stage = tonumber(data.stage) or 0
	local coins = tonumber(data.coins) or 0
	local sub = if coins > 0 then Lang.t("celebrate.coins", { n = coins }) else nil
	local title = Lang.t("celebrate.stage", { n = stage })
	if data.world and data.style then
		-- first pad of a new world: its number (1..100) and its look (1..10) in this tower's colours
		local theme = Config.theme(Layout.towerOf(stage + 1), data.style :: number)
		Celebrate.show(title, Lang.t("celebrate.world", { n = data.world, name = { key = "world." .. data.style } }), true, { theme.platform:Lerp(Kit.C.ink, 0.3), theme.accent:Lerp(Kit.C.ink, 0.3) })
		return
	end
	if stage % Layout.STAGES == 0 then
		return -- a summit: the Win event shows its own celebration
	end
	Celebrate.show(title, sub, false)
end

return Celebrate
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">EventBar</string>
              <string name="Source"><![CDATA[--!strict
-- Live-event pill under the run timer (P0-6): "2x Coins Weekend · ends in 1:02:03", or the
-- starter-pack x2 coins boost; plus a banner when an event starts.
local Workspace = game:GetService("Workspace")

local Net = require(script.Parent.Parent.Net)
local Lang = require(script.Parent.Parent.Lang)
local Kit = require(script.Parent.Kit)
local Hud = require(script.Parent.Hud)
local Celebrate = require(script.Parent.Celebrate)

local EventBar = {}

type Active = { id: string, endsAt: number }
local current: Active? = nil
local upcoming: { id: string, startsAt: number }? = nil

local function clock(sec: number): string
	sec = math.max(0, math.floor(sec))
	local h, m, s = sec // 3600, (sec % 3600) // 60, sec % 60
	if h > 0 then
		return ("%d:%02d:%02d"):format(h, m, s)
	end
	return ("%d:%02d"):format(m, s)
end

function EventBar.current(): Active?
	return current
end

function EventBar.init()
	local W = 360
	local bar = Kit.region("EventBar", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 150), Vector2.new(W, 38))
	bar.Visible = false
	local body = Kit.frame(bar, UDim2.fromScale(1, 1), UDim2.new(), Kit.C.orange)
	body.Name = "Body"
	Kit.corner(body, 19)
	Kit.stroke(body, Kit.darker(Kit.C.orange, 0.45), 3)
	Kit.gradient(body, Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 210, 160), 0)
	local label = Kit.bold(body, "", UDim2.new(1, -20, 1, -8), UDim2.fromOffset(10, 4), Kit.C.white, nil, 24)
	label.Name = "Text"
	Kit.onLayout(function()
		local s = Hud.topScale or 1
		Kit.setScale(bar, s)
		bar.Position = UDim2.new(0.5, 0, 0, math.floor(Hud.EVENT_TOP * s))
	end)

	local function tick()
		local now = Workspace:GetServerTimeNow()
		local ev = current
		if ev and ev.endsAt <= now then
			ev = nil
		end
		local boostEnds = tonumber(Net.state.boostEndsAt) or 0
		if ev then
			body.BackgroundColor3 = if ev.id == "SkipSaleHour" then Kit.C.blue else Kit.C.orange
			Kit.setText(label, "event.ends", { name = { key = "event." .. ev.id }, time = clock(ev.endsAt - now) })
		elseif boostEnds > now then
			body.BackgroundColor3 = Kit.C.green
			Kit.setText(label, "boost.active", { time = clock(boostEnds - now) })
		end
		local show = ev ~= nil or boostEnds > now
		bar.Visible = show
		Hud.setEventBarVisible(show)
	end

	Net.on("LiveEventUpdate", function(cur: any, nxt: any)
		local prevId = current and current.id
		current = if type(cur) == "table" and type(cur.id) == "string" then cur else nil
		upcoming = if type(nxt) == "table" then nxt else nil
		if current and current.id ~= prevId then
			Celebrate.show(Lang.t("event.started", { name = { key = "event." .. current.id } }), nil, false)
		end
		tick()
	end)
	task.spawn(function()
		while true do
			tick()
			task.wait(1)
		end
	end)
end

function EventBar.upcoming()
	return upcoming
end

return EventBar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- Always-on HUD, in the minimal style of tower games (see DESIGN.md, "HUD"):
--   top centre    : the run timer, big and thin (+ best time / "not ranked" under it)
--   right edge    : the tower progress bar with the head of every player (Progress.luau)
--   bottom left   : Menu + coins + wins. Menu opens the grid of panels (shop, store, rewards,
--                   settings, invite, share, group gift, starter pack); active power-ups sit over it
--   bottom centre : the level bar (stage N of 1,000) and under it the action buttons:
--                   portal / abilities when you have them, Skip Stage, Skip 10, Checkpoint, Lobby
-- On touch screens the corner block moves under the Roblox buttons (the thumbstick owns the
-- bottom left) and the actions become a column on the right, above the jump button.
local GroupService = game:GetService("GroupService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SocialService = game:GetService("SocialService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Referral = require(ReplicatedStorage.Shared.Referral)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Rules = require(ReplicatedStorage.Shared.Rules)
local Powerups = require(ReplicatedStorage.Shared.Powerups)
local LocalFx = require(script.Parent.Parent.World.LocalFx)
local RunTime = require(ReplicatedStorage.Shared.RunTime)
local Pricing = require(ReplicatedStorage.Shared.Pricing)
local Net = require(script.Parent.Parent.Net)
local Kit = require(script.Parent.Kit)
local Progress = require(script.Parent.Progress)
local Lang = require(script.Parent.Parent.Lang)
local Toast = require(script.Parent.Toast)

local Hud = {}

local productPrice: { [number]: number } = {}

local function fetchPrice(id: number, onPrice: (number) -> ())
	if id == 0 then
		return
	end
	if productPrice[id] then
		onPrice(productPrice[id])
		return
	end
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(id, Enum.InfoType.Product)
		end)
		if ok and info and info.PriceInRobux then
			productPrice[id] = info.PriceInRobux
			onPrice(info.PriceInRobux)
		end
	end)
end
Hud.fetchPrice = fetchPrice

-- Cached Robux price of a product (nil until fetched / when the id is 0).
function Hud.priceOf(id: number): number?
	return productPrice[id]
end

Hud.topScale = 1 -- scale of the top-centre HUD rows (EventBar follows it)

-- Studio test tools (free dev skips): the server says so (Studio AND a test flag, see
-- Rules.studioTools) and this client must be running in Studio too.
function Hud.studioTools(): boolean
	return Net.state.studioTools == true and RunService:IsStudio()
end

-- Skip n stages: free skip first, then Robux product, then (Studio test tools only) dev skip.
function Hud.skip(n: number)
	local s = Net.state
	if Rules.skipTarget(Layout :: any, s.at or s.stage or 0, n, s.base == true) == nil then
		Toast.show(Lang.t("toast.at_top"), "info")
		return
	end
	if n == 1 and (s.freeSkips or 0) > 0 then
		local ok, msg = Net.request("UseFreeSkip")
		if not ok and msg then
			Toast.show(msg, "error")
		end
		return
	end
	local id = if n == 10 then Config.Products.Skip10 else Pricing.skipProductId(Config.Products, s.at or s.stage or 0)
	if id ~= 0 then
		MarketplaceService:PromptProductPurchase(Players.LocalPlayer, id)
	elseif Hud.studioTools() then
		local ok, msg = Net.request("DevSkip", { n = n })
		if ok then
			Toast.show(Lang.t("toast.studio_skip"), "info")
		elseif msg then
			Toast.show(msg, "error")
		end
	end
end

-- "Minimal action" look: translucent dark glass, thin white outline, white text.
local GLASS = Color3.fromRGB(24, 28, 44)
local function glass(parent: Instance, size: UDim2, pos: UDim2): Frame
	local f = Kit.frame(parent, size, pos, GLASS)
	f.BackgroundTransparency = 0.35
	Kit.corner(f, 14)
	-- a soft top-lit sheen instead of a flat fill
	Kit.gradient(f, Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 160, 190), 90)
	local st = Kit.stroke(f, Color3.new(1, 1, 1), 1.5)
	st.Transparency = 0.55
	return f
end

-- Counter in the bottom-left corner: icon + number on glass.
local function counter(parent: Instance, x: number, w: number): (TextLabel, Frame)
	local f = glass(parent, UDim2.fromOffset(w, 44), UDim2.fromOffset(x, 3))
	local icon = Kit.frame(f, UDim2.fromOffset(32, 32), UDim2.fromOffset(6, 6), nil)
	local label = Kit.bold(f, "0", UDim2.new(1, -52, 1, -10), UDim2.fromOffset(44, 5), Kit.C.white, nil, 26)
	label.TextXAlignment = Enum.TextXAlignment.Left
	return label, icon
end

local MENU_CELL = 80
local MENU_GAP = 12
local MENU_COLS = 3 -- columns of the menu grid on PC; touch screens use MENU_COLS_TOUCH
local MENU_COLS_TOUCH = 4 -- wider and shorter, so the open grid clears the thumbstick

local function menuButton(parent: Instance, order: number, name: string, text: string, icon: string, color: Color3, onClick: () -> ()): (TextButton, Frame)
	local b = Kit.button(parent, "", UDim2.fromOffset(MENU_CELL, MENU_CELL), UDim2.new(), color, onClick)
	b.Name = name
	b.LayoutOrder = order
	Kit.icon(b, icon, UDim2.new(1, 0, 0, 44), UDim2.fromOffset(0, 2), Kit.C.white, nil, 38)
	Kit.bold(b, text, UDim2.new(1, 0, 0, 22), UDim2.new(0, 0, 1, -24), Kit.C.white, nil, 18)
	local badge = Kit.frame(b, UDim2.fromOffset(24, 24), UDim2.new(1, -10, 0, -10), Kit.C.red)
	Kit.corner(badge, 12)
	Kit.stroke(badge, Kit.C.white, 2)
	Kit.bold(badge, "!", UDim2.fromScale(1, 1), UDim2.new(), Kit.C.white, nil, 18)
	badge.Visible = false
	badge.ZIndex = 3
	return b, badge
end

local function invite()
	local player = Players.LocalPlayer
	local ok, can = pcall(function()
		return SocialService:CanSendGameInviteAsync(player)
	end)
	if not ok or not can then
		Toast.show(Lang.t("toast.invite_unavailable"), "info")
		return
	end
	local options = Instance.new("ExperienceInviteOptions")
	options.LaunchData = Referral.make(player.UserId)
	options.PromptMessage = Lang.t("invite.prompt")
	local shown = pcall(function()
		SocialService:PromptGameInvite(player, options)
	end)
	if not shown then
		Toast.show(Lang.t("toast.invite_unavailable"), "info")
	end
end

local function joinGroup()
	task.spawn(function()
		pcall(function()
			GroupService:PromptJoinAsync(Config.GroupId)
		end)
		local ok, msg = Net.request("ClaimGroupGift")
		if msg then
			Toast.show(msg, if ok then "success" else "info")
		end
	end)
end

-- All sizes are design pixels; each region is scaled as one unit by Kit.
Hud.STATS_TOP = 4 -- design px from the top of the safe area
Hud.STATS_W = 300
Hud.STATS_H = 70
Hud.EVENT_TOP = Hud.STATS_TOP + Hud.STATS_H + 4 -- where the live-event pill goes
Hud.eventBarVisible = false
local relayout: () -> () = function() end
function Hud.setEventBarVisible(v: boolean)
	if Hud.eventBarVisible ~= v then
		Hud.eventBarVisible = v
		relayout()
	end
end

function Hud.init()
	local stats = Kit.region("Stats", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, Hud.STATS_TOP), Vector2.new(Hud.STATS_W, Hud.STATS_H))
	-- run timer (P0-2): big thin digits; grey + "not ranked" once the run used help
	local timer = Kit.frame(stats, UDim2.fromScale(1, 1), UDim2.new(), nil)
	timer.Name = "RunTimer"
	local timerLabel = Kit.text(timer, "00:00.000", UDim2.new(1, 0, 0, 50), UDim2.new(), Kit.C.white, nil, 48)
	timerLabel.Name = "Time"
	timerLabel.Font = Enum.Font.Gotham
	local timerStroke = Kit.stroke(timerLabel, Kit.C.ink, 1.5)
	timerStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual -- outline the digits, not the box
	timerStroke.Transparency = 0.35
	local timerNote = Kit.bold(timer, "", UDim2.new(1, 0, 0, 18), UDim2.fromOffset(0, 50), Color3.fromRGB(240, 240, 255), nil, 15)
	timerNote.Name = "Note"

	-- bottom-left corner: Menu + coins + wins
	local CORNER_W = 342
	local corner = Kit.region("Corner", Vector2.new(0, 1), UDim2.new(0, 12, 1, -12), Vector2.new(CORNER_W, 50))
	local menuOpen = false
	local left: Frame
	local function setMenu(open: boolean)
		menuOpen = open
		left.Visible = open
	end
	local MENU_H = 50 -- design height of the Menu button (taller on phones, see onLayout)
	local menuBtn = Kit.button(corner, "@hud.menu", UDim2.fromOffset(116, MENU_H), UDim2.new(), Color3.fromRGB(62, 68, 96), function()
		setMenu(not menuOpen)
	end, nil, 26)
	menuBtn.Name = "MenuButton"
	local menuBadge = Kit.frame(menuBtn, UDim2.fromOffset(24, 24), UDim2.new(1, -8, 0, -10), Kit.C.red)
	menuBadge.Name = "Badge"
	Kit.corner(menuBadge, 12)
	Kit.stroke(menuBadge, Kit.C.white, 2)
	Kit.bold(menuBadge, "!", UDim2.fromScale(1, 1), UDim2.new(), Kit.C.white, nil, 18)
	menuBadge.Visible = false
	menuBadge.ZIndex = 3
	local coinLabel, coinIcon = counter(corner, 124, 128)
	Kit.coin(coinIcon, 30, UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5))
	local winsLabel, winsIcon = counter(corner, 258, 84)
	Kit.icon(winsIcon, "🏆", UDim2.fromScale(1, 1), UDim2.new(), Kit.C.white, nil, 24)

	left = Kit.region("Menu", Vector2.new(0, 1), UDim2.new(0, 12, 1, -120), Vector2.new(MENU_COLS * MENU_CELL + (MENU_COLS - 1) * MENU_GAP, MENU_CELL))
	left.Visible = false
	Kit.panelChanged:Connect(function()
		if Kit.current() ~= nil then
			setMenu(false)
		end
	end)
	local menuCols = MENU_COLS
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(MENU_CELL, MENU_CELL)
	grid.CellPadding = UDim2.fromOffset(MENU_GAP, MENU_GAP)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.FillDirectionMaxCells = MENU_COLS
	grid.Parent = left
	local starterBtn = menuButton(left, 0, "Starter", "@hud.starter", "🎁", Kit.C.red, function()
		Kit.toggle("starter")
	end)
	local starterPulse = Instance.new("UIScale")
	starterPulse.Parent = starterBtn:FindFirstChild("Icon")
	TweenService:Create(starterPulse, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.15 }):Play()
	starterBtn.Visible = false
	menuButton(left, 1, "Shop", "@hud.shop", "🛍", Kit.C.pink, function()
		Kit.toggle("shop")
	end)
	menuButton(left, 2, "Store", "@hud.store", "💎", Kit.C.green, function()
		Kit.toggle("store")
	end)
	local _, rewardsBadge = menuButton(left, 3, "Rewards", "@hud.rewards", "🎁", Kit.C.orange, function()
		Kit.toggle("rewards")
	end)
	menuButton(left, 4, "Settings", "@hud.settings", "⚙", Kit.C.grey, function()
		Kit.toggle("settings")
	end)
	menuButton(left, 5, "Invite", "@hud.invite", "👋", Kit.C.blue, invite)
	menuButton(left, 6, "Share", "@hud.share", "🔗", Kit.C.purple, function()
		local ok, msg = Net.request("ShareLink")
		if not ok and msg then
			Toast.show(msg, "info")
		end
	end)
	local groupBtn = menuButton(left, 7, "Group", "@hud.group", "⭐", Kit.C.yellow, joinGroup)
	groupBtn.Visible = false

	-- action buttons: a row under the level bar (PC) or a column on the right (touch). Optional
	-- buttons (portal, abilities) join the ones that are always there.
	local ACT_W = 184
	local ROW_H = 56
	local ACT_GAP = 6
	local right = Kit.region("Actions", Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -10), Vector2.new(ACT_W, ROW_H))
	local actList = Instance.new("UIListLayout")
	actList.SortOrder = Enum.SortOrder.LayoutOrder
	actList.VerticalAlignment = Enum.VerticalAlignment.Bottom
	actList.HorizontalAlignment = Enum.HorizontalAlignment.Center
	actList.Padding = UDim.new(0, ACT_GAP)
	actList.Parent = right
	-- height of each button when the actions are a column
	local columnHeight: { [GuiObject]: number } = {}

	local portalBtn = Kit.button(right, "@hud.portal", UDim2.fromOffset(ACT_W, 56), UDim2.new(), Kit.C.purple, function()
		local ok, msg = Net.request("EnterPortal")
		if not ok and msg then
			Toast.show(msg, "info")
		end
	end, nil, 26)
	portalBtn.Name = "Portal"
	portalBtn.LayoutOrder = 1
	portalBtn.Visible = false
	columnHeight[portalBtn] = 56

	local exploreBtn = Kit.button(right, "@hud.explore_off", UDim2.fromOffset(ACT_W, 52), UDim2.new(), Kit.C.red, function()
		local _, msg = Net.request("SetRoam", { id = "" })
		if msg then
			Toast.show(msg, "info")
		end
	end, nil, 22)
	exploreBtn.Name = "StopExploring"
	exploreBtn.LayoutOrder = 2
	exploreBtn.Visible = false
	columnHeight[exploreBtn] = 54

	local abilityRow = Kit.frame(right, UDim2.fromOffset(ACT_W, 52), UDim2.new(), nil)
	abilityRow.Name = "Abilities"
	abilityRow.LayoutOrder = 3
	abilityRow.Visible = false
	columnHeight[abilityRow] = 54
	local dashBtn = Kit.button(abilityRow, "@hud.dash", UDim2.new(0, 88, 1, 0), UDim2.fromOffset(0, 0), Kit.C.blue, function()
		LocalFx.dash()
	end, nil, 22)
	dashBtn.Name = "Dash"
	local pocketBtn = Kit.button(abilityRow, "@hud.pocket", UDim2.new(0, 88, 1, 0), UDim2.fromOffset(96, 0), Kit.C.orange, function()
		local ok, msg = Net.request("PlacePocket")
		if msg then
			Toast.show(msg, if ok then "success" else "info")
		end
	end, nil, 22)
	pocketBtn.Name = "Pocket"

	local skip = Kit.button(right, "", UDim2.fromOffset(ACT_W, 74), UDim2.new(), Kit.C.green, function()
		Hud.skip(1)
	end)
	skip.Name = "SkipStage"
	skip.LayoutOrder = 4
	columnHeight[skip] = 74
	local skipTitle = Kit.bold(skip, "@hud.skip", UDim2.fromScale(1, 0.52), UDim2.fromScale(0, 0.02), Kit.C.white, nil, 28)
	local skipSub = Kit.bold(skip, "", UDim2.fromScale(1, 0.36), UDim2.fromScale(0, 0.56), Color3.fromRGB(255, 255, 200), nil, 19)

	local skip10 = Kit.button(right, "@hud.skip10", UDim2.fromOffset(ACT_W, 50), UDim2.new(), Kit.C.blue, function()
		Hud.skip(10)
	end, nil, 24)
	skip10.Name = "Skip10"
	skip10.LayoutOrder = 5
	columnHeight[skip10] = 54
	local bottomRow = Kit.frame(right, UDim2.fromOffset(ACT_W, 50), UDim2.new(), nil)
	bottomRow.Name = "Bottom"
	bottomRow.LayoutOrder = 6
	columnHeight[bottomRow] = 54
	local back = Kit.button(bottomRow, "@hud.checkpoint", UDim2.new(0, 116, 1, 0), UDim2.fromOffset(0, 0), Kit.C.orange, function()
		Net.request("ReturnToCheckpoint")
	end, nil, 20)
	back.Name = "Checkpoint"
	Kit.singleLine(back, 20)
	local lobby = Kit.button(bottomRow, "@hud.lobby", UDim2.new(0, 62, 1, 0), UDim2.fromOffset(122, 0), Kit.C.grey, function()
		Net.request("GoToLobby")
	end, nil, 20)
	lobby.Name = "Lobby"
	Kit.singleLine(lobby, 20)

	-- Shapes the action list as a row (PC) or a column (touch); returns its design size.
	local function shapeActions(asRow: boolean): Vector2
		actList.FillDirection = if asRow then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
		local n, tall = 0, 0
		for c, h in columnHeight do
			c.Size = UDim2.fromOffset(ACT_W, if asRow then ROW_H else h)
			if c.Visible then
				n += 1
				tall += h
			end
		end
		local size = if asRow
			then Vector2.new(math.max(1, n) * ACT_W + math.max(0, n - 1) * ACT_GAP, ROW_H)
			else Vector2.new(ACT_W, tall + math.max(0, n - 1) * ACT_GAP)
		right.Size = UDim2.fromOffset(size.X, size.Y)
		return size
	end
	local function actionsShown(): number
		local n = 0
		for c in columnHeight do
			if c.Visible then
				n += 1
			end
		end
		return n
	end

	-- active power-ups: small chips over the menu grid (icon + time left, or charges)
	local chips = Kit.region("Boosts", Vector2.new(0, 1), UDim2.new(0, 12, 1, -70), Vector2.new(MENU_COLS * MENU_CELL + (MENU_COLS - 1) * MENU_GAP, 34))
	local chipList = Instance.new("UIListLayout")
	chipList.FillDirection = Enum.FillDirection.Horizontal
	chipList.SortOrder = Enum.SortOrder.LayoutOrder
	chipList.Padding = UDim.new(0, 6)
	chipList.Parent = chips
	local chipFor: { [string]: TextLabel } = {}
	for i, item in Powerups.List do
		if item.kind ~= "instant" then
			local color = Color3.fromRGB(item.color[1], item.color[2], item.color[3])
			local chip = Kit.frame(chips, UDim2.fromOffset(78, 34), UDim2.new(), Kit.darker(color, 0.25))
			chip.Name = "Chip_" .. item.id
			chip.LayoutOrder = i
			chip.Visible = false
			Kit.corner(chip, 17)
			Kit.stroke(chip, Kit.C.ink, 2)
			Kit.icon(chip, item.icon, UDim2.fromOffset(28, 28), UDim2.fromOffset(4, 3), Kit.C.white, nil, 22)
			local label = Kit.bold(chip, "", UDim2.new(1, -36, 1, -8), UDim2.fromOffset(32, 4), Kit.C.white, nil, 18)
			label.TextXAlignment = Enum.TextXAlignment.Left
			chipFor[item.id] = label
		end
	end

	local side = Kit.gui():FindFirstChild("Progress") :: Frame?
	local level = Kit.gui():FindFirstChild("LevelBar") :: Frame?
	local function menuHeight(): number
		local n = 0
		for _, c in left:GetChildren() do
			if c:IsA("GuiButton") and c.Visible then
				n += 1
			end
		end
		local rows = math.max(1, math.ceil(n / menuCols))
		return rows * MENU_CELL + (rows - 1) * MENU_GAP
	end
	Kit.onLayout(function(touch, area, scale)
		local cols = if touch then MENU_COLS_TOUCH else MENU_COLS
		if cols ~= menuCols then
			menuCols = cols
			grid.FillDirectionMaxCells = cols
		end
		local mh = menuHeight()
		local mw = cols * MENU_CELL + (cols - 1) * MENU_GAP
		left.Size = UDim2.fromOffset(mw, mh)
		local shown = actionsShown()
		if touch then
			-- corner block under the Roblox buttons; the thumbstick owns the bottom left
			local top = math.floor(area.Y * 0.16)
			local cs = math.min(scale, area.X * 0.34 / CORNER_W)
			-- the Menu button must stay >= 44 px tall on screen
			local mbH = math.max(MENU_H, math.ceil(46 / cs))
			menuBtn.Size = UDim2.fromOffset(116, mbH)
			corner.Size = UDim2.fromOffset(CORNER_W, mbH)
			corner.AnchorPoint = Vector2.new(0, 0)
			corner.Position = UDim2.new(0, 12, 0, top)
			Kit.setScale(corner, cs)
			chips.AnchorPoint = Vector2.new(0, 0)
			chips.Position = UDim2.new(0, 12, 0, top + math.floor((mbH + 6) * cs))
			Kit.setScale(chips, cs)
			-- the open menu is a popup in the free band between the top HUD and the level bar,
			-- right of the thumbstick (which owns the bottom left); it closes on a choice
			local stripTop = math.floor((Hud.EVENT_TOP + (if Hud.eventBarVisible then 44 else 0)) * scale)
			local gridTop = math.max(stripTop, top + math.floor((mbH + 40) * cs)) + 8
			local gridLeft = math.floor(area.X * 0.3)
			local gridBottom = area.Y - math.floor((Progress.LEVEL_H + 16) * math.min(scale, area.X * 0.4 / 420))
			local ms = math.min(scale, (gridBottom - gridTop) / mh, (area.X * 0.5 - 12) / mw)
			left.AnchorPoint = Vector2.new(0, 0)
			left.Position = UDim2.new(0, gridLeft, 0, gridTop)
			Kit.setScale(left, ms)
			-- side bar: right edge, above the jump button (which owns the bottom 35%)
			local ss = scale * 0.85
			if side then
				side.AnchorPoint = Vector2.new(1, 0)
				side.Position = UDim2.new(1, -6, 0, math.floor(area.Y * 0.12))
				side.Size = UDim2.fromOffset(Progress.SIDE_W, math.floor(area.Y * 0.5 / ss))
				Kit.setScale(side, ss)
			end
			-- action column: left of the side bar (the jump button sits right of it), bottom just
			-- above the level bar (phones; 64% of the height on tablets), shrunk to fit when the optional buttons are showing
			local size = shapeActions(false)
			local ls = math.min(scale, area.X * 0.4 / 420)
			local bottom = area.Y - math.floor((Progress.LEVEL_H + 14) * ls)
			if area.Y > 450 then
				-- tablets: the (bigger) jump button sits under the column, keep it above it
				bottom = math.floor(area.Y * 0.64)
			end
			right.AnchorPoint = Vector2.new(1, 1)
			right.Position = UDim2.new(1, -12 - math.floor(Progress.SIDE_W * ss), 0, bottom)
			Kit.setScale(right, math.min(scale, (bottom - 8) / math.max(size.Y, 1)))
			-- level bar: the free band between the thumbstick and the jump button
			if level then
				level.Size = UDim2.fromOffset(420, Progress.LEVEL_H)
				level.Position = UDim2.new(0.53, 0, 1, -6)
				Kit.setScale(level, math.min(scale, area.X * 0.4 / 420))
			end
		else
			menuBtn.Size = UDim2.fromOffset(116, MENU_H)
			corner.Size = UDim2.fromOffset(CORNER_W, MENU_H)
			corner.AnchorPoint = Vector2.new(0, 1)
			corner.Position = UDim2.new(0, 12, 1, -12)
			Kit.setScale(corner, scale)
			chips.AnchorPoint = Vector2.new(0, 1)
			chips.Position = UDim2.new(0, 12, 1, -12 - math.floor(58 * scale))
			Kit.setScale(chips, scale)
			-- the grid opens over the corner block, under the chat window
			left.AnchorPoint = Vector2.new(0, 1)
			left.Position = UDim2.new(0, 12, 1, -12 - math.floor(100 * scale))
			Kit.setScale(left, math.min(scale, (area.Y * 0.55) / mh))
			if side then
				side.AnchorPoint = Vector2.new(1, 0.5)
				side.Position = UDim2.new(1, -6, 0.5, 0)
				side.Size = UDim2.fromOffset(Progress.SIDE_W, math.floor(area.Y * 0.7 / scale))
				Kit.setScale(side, scale)
			end
			-- actions: a centred row on the bottom edge, never wider than the level bar
			local size = shapeActions(true)
			local rs = math.min(scale, area.X * 0.6 / size.X)
			right.AnchorPoint = Vector2.new(0.5, 1)
			right.Position = UDim2.new(0.5, 0, 1, -10)
			Kit.setScale(right, rs)
			if level then
				local ls = math.min(scale, area.X * 0.6 / Progress.LEVEL_W)
				level.Size = UDim2.fromOffset(Progress.LEVEL_W, Progress.LEVEL_H)
				level.Position = UDim2.new(0.5, 0, 1, -10 - (if shown > 0 then math.floor(ROW_H * rs) + 8 else 0))
				Kit.setScale(level, ls)
			end
		end
		Kit.setScale(stats, scale)
		stats.Position = UDim2.new(0.5, 0, 0, math.floor(Hud.STATS_TOP * scale))
		Hud.topScale = scale
		local rows = Hud.EVENT_TOP + (if Hud.eventBarVisible then 44 else 0)
		Kit.hudTop = math.floor(rows * scale)
	end)
	relayout = function()
		Kit.relayout()
	end

	-- both price bands (19 R$ / 29 R$): the one of the level you are on is shown
	local refreshLater: () -> () = function() end
	for _, id in { Config.Products.SkipStage, Config.Products.SkipStageHigh } do
		fetchPrice(id, function()
			refreshLater()
		end)
	end
	local skip10Price: number? = nil
	fetchPrice(Config.Products.Skip10, function(p)
		skip10Price = p
		refreshLater()
	end)

	local function refresh()
		local s = Net.state
		local at = s.at or s.stage or 0
		Kit.setRaw(coinLabel, Kit.formatNumber(s.coins or 0))
		Kit.setRaw(winsLabel, ("%d"):format(s.wins or 0))
		local free = s.freeSkips or 0
		local onBase = s.base == true
		local studio = Hud.studioTools()
		local skipId = Pricing.skipProductId(Config.Products, at)
		local skipPrice = productPrice[skipId]
		local view = Rules.skipButton(Layout :: any, at, onBase, free, skipId, studio, studio)
		local before = actionsShown()
		skip.Visible = view.visible
		Kit.setText(skipTitle, view.title)
		if view.sub == "hud.skips_left" then
			Kit.setText(skipSub, view.sub, { n = free })
		elseif view.sub == "hud.robux" and skipPrice then
			Kit.setText(skipSub, "hud.price", { price = skipPrice })
		elseif view.sub ~= "" then
			Kit.setText(skipSub, view.sub)
		else
			Kit.setRaw(skipSub, "")
		end
		skip10.Visible = Rules.skip10Visible(Layout :: any, at, onBase, Config.Products.Skip10, studio, studio)
		if skip10Price then
			Kit.setText(skip10, "hud.skip10_price", { price = skip10Price })
		else
			Kit.setText(skip10, "hud.skip10")
		end
		-- on a summit the way on is the portal
		portalBtn.Visible = Rules.isSummit(Layout :: any, at) and not onBase and at < Layout.TOTAL
		exploreBtn.Visible = s.roam ~= nil
		local charges = if type(s.charges) == "table" then s.charges else {}
		local hasDash = Players.LocalPlayer:GetAttribute("Dash") == true
		local hasPocket = (tonumber(charges.pocket) or 0) > 0 or Net.hasPass("InfiniteRevives")
		abilityRow.Visible = hasDash or hasPocket
		dashBtn.Visible = hasDash
		pocketBtn.Visible = hasPocket
		pocketBtn.Position = UDim2.fromOffset(if hasDash then 96 else 0, 0)
		if actionsShown() ~= before then
			Kit.relayout()
		end
		-- power-up chips
		local now = os.time()
		local boosts = if type(s.boosts) == "table" then s.boosts else {}
		for id, label in chipFor do
			local item = Powerups.get(id) :: Powerups.Item
			local chip = label.Parent :: Frame
			if item.kind == "timed" then
				local left = Powerups.remaining(boosts, id, now)
				chip.Visible = left > 0
				if left > 0 then
					Kit.setRaw(label, Kit.formatTime(left))
				end
			else
				local n = tonumber(charges[id]) or 0
				chip.Visible = n > 0
				if n > 0 then
					Kit.setRaw(label, "x" .. n)
				end
			end
		end
		local playClaimable = false
		local claimed = {}
		for _, i in (s.playClaimed or {}) :: { number } do
			claimed[i] = true
		end
		for i, r in Config.PlaytimeRewards do
			if not claimed[i] and Net.playSeconds() >= r.minutes * 60 then
				playClaimable = true
			end
		end
		rewardsBadge.Visible = (s.daily and s.daily.canClaim) or playClaimable
		-- menu extras: starter pack while on sale, group gift while unclaimed
		local starterOn = type(s.starter) == "table" and s.starter.available == true
		local groupOn = s.groupGift == true
		if starterBtn.Visible ~= starterOn or groupBtn.Visible ~= groupOn then
			starterBtn.Visible = starterOn
			groupBtn.Visible = groupOn
			Kit.relayout()
		end
		-- something waits behind the Menu button
		menuBadge.Visible = rewardsBadge.Visible or starterOn or groupOn
		-- timer look
		local run = s.run
		local ranked = type(run) ~= "table" or run.valid ~= false
		timerLabel.TextColor3 = if ranked then Kit.C.white else Color3.fromRGB(190, 195, 210)
		if ranked then
			if type(run) == "table" and (run.best or 0) > 0 then
				Kit.setText(timerNote, "run.best", { time = RunTime.format(run.best) })
			else
				Kit.setRaw(timerNote, "")
			end
		else
			Kit.setText(timerNote, "run.unranked")
		end
	end

	-- run clock: server time based, so it survives respawns and matches the ranked result
	task.spawn(function()
		while true do
			local run = Net.state.run
			local ms = 0
			if type(run) == "table" then
				if run.finalMs then
					ms = run.finalMs
				elseif run.start then
					ms = (Workspace:GetServerTimeNow() - run.start) * 1000
				end
			end
			Kit.setRaw(timerLabel, RunTime.format(ms))
			task.wait(0.1)
		end
	end)

	Net.changed:Connect(function(new, prev)
		refresh()
		if prev.coins and new.coins and new.coins > prev.coins then
			Kit.pop(coinLabel.Parent :: Frame, 0.85)
		end
	end)
	Lang.changed:Connect(refresh)
	task.spawn(function()
		while true do
			-- once a second while a timed power-up is counting down, otherwise every 5 s
			local ticking = false
			local boosts = Net.state.boosts
			if type(boosts) == "table" then
				for _, endsAt in boosts do
					if endsAt > os.time() then
						ticking = true
					end
				end
			end
			task.wait(if ticking then 1 else 5)
			refresh()
		end
	end)
	Players.LocalPlayer:GetAttributeChangedSignal("Dash"):Connect(refresh)
	refreshLater = refresh
	refresh()
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">Intro</string>
              <string name="Source"><![CDATA[--!strict
-- Title card shown for a couple of seconds when you join: game name, tagline, and the ten world
-- colours popping in. Covers the moment the character and the tower are still streaming in, then
-- fades away. Never blocks input.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.Kit)
local Progress = require(script.Parent.Progress)

local Intro = {}

Intro.HOLD = 2.3 -- seconds on screen before the fade
Intro.FADE = 0.6

function Intro.play()
	local gui = Instance.new("ScreenGui")
	gui.Name = "SkyTowerIntro"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 50
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local card = Instance.new("CanvasGroup")
	card.Name = "Card"
	card.Size = UDim2.fromScale(1, 1)
	card.BorderSizePixel = 0
	card.BackgroundColor3 = Color3.new(1, 1, 1)
	card.Active = false
	card.Parent = gui
	Kit.gradient(card, Color3.fromRGB(70, 150, 255), Color3.fromRGB(150, 110, 255), 90)

	local title = Kit.bold(card, string.upper(Config.GameName), UDim2.fromScale(0.84, 0.24), UDim2.fromScale(0.5, 0.4), Kit.C.yellow, Vector2.new(0.5, 0.5), 120)
	title.Name = "Title"
	title.Rotation = -2
	local stroke = title:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Thickness = 5
	end
	Kit.pop(title, 0.5)
	local tagline = Kit.bold(card, "@intro.tagline", UDim2.fromScale(0.8, 0.09), UDim2.fromScale(0.5, 0.58), Kit.C.white, Vector2.new(0.5, 0.5), 44)
	tagline.Name = "Tagline"

	-- ten world dots, popping in one after another
	local row = Kit.frame(card, UDim2.fromScale(0.6, 0.06), UDim2.fromScale(0.5, 0.7), nil, Vector2.new(0.5, 0.5))
	row.Name = "Worlds"
	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Horizontal
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.VerticalAlignment = Enum.VerticalAlignment.Center
	list.Padding = UDim.new(0.02, 0)
	list.Parent = row
	for i, color in Progress.WORLD_COLORS do
		local dot = Kit.frame(row, UDim2.fromScale(0.07, 1), UDim2.new(), color)
		dot.LayoutOrder = i
		local ratio = Instance.new("UIAspectRatioConstraint")
		ratio.Parent = dot
		Kit.corner(dot, 100)
		Kit.stroke(dot, Kit.C.ink, 3)
		local scale = Instance.new("UIScale")
		scale.Scale = 0
		scale.Parent = dot
		TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, 0.25 + i * 0.09), { Scale = 1 }):Play()
	end

	task.delay(Intro.HOLD, function()
		local fade = TweenService:Create(card, TweenInfo.new(Intro.FADE, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { GroupTransparency = 1 })
		fade:Play()
		fade.Completed:Wait()
		gui:Destroy()
	end)
end

return Intro
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--!strict
-- Cartoony UI kit: palette, builders, screen regions that scale with the viewport
-- (UIScale per region, bigger on touch devices), and a one-panel-at-a-time modal system.
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local TextService = game:GetService("TextService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Lang = require(script.Parent.Parent.Lang)
local Icons = require(ReplicatedStorage.Shared.Icons)

local Kit = {}

---------------------------------------------------------------------------------------------
-- Localized text: any text passed to the builders as "@some.key" is translated, and every
-- object set through Kit.setText is re-translated live when the language changes.
---------------------------------------------------------------------------------------------
type Bound = { key: string, args: { [string]: any }?, prop: string }
-- Strong table (Instance keys in weak tables get dropped while the Instance is still alive);
-- entries are removed when the object is destroyed.
local bound: { [Instance]: Bound } = {}

local function applyBound(obj: Instance, b: Bound)
	(obj :: any)[b.prop] = Lang.t(b.key, b.args)
end

function Kit.setText(obj: Instance, key: string, args: { [string]: any }?, prop: string?)
	local b = { key = key, args = args, prop = prop or "Text" }
	if not bound[obj] then
		obj.Destroying:Once(function()
			bound[obj] = nil
		end)
	end
	bound[obj] = b
	applyBound(obj, b)
end

-- Plain (untranslated) text, e.g. numbers; drops any key bound to the object.
function Kit.setRaw(obj: Instance, text: string)
	bound[obj] = nil;
	(obj :: any).Text = text
end

local function setInitial(obj: Instance, text: string)
	if string.sub(text, 1, 1) == "@" then
		Kit.setText(obj, string.sub(text, 2))
	else
		(obj :: any).Text = text
	end
end

Lang.changed:Connect(function()
	for obj, b in bound do
		applyBound(obj, b)
	end
end)

Kit.Font = Enum.Font.FredokaOne
Kit.C = {
	ink = Color3.fromRGB(45, 40, 80),
	white = Color3.fromRGB(255, 255, 255),
	panel = Color3.fromRGB(255, 250, 242),
	card = Color3.fromRGB(255, 255, 255),
	blue = Color3.fromRGB(70, 160, 255),
	green = Color3.fromRGB(70, 205, 105),
	yellow = Color3.fromRGB(255, 200, 45),
	pink = Color3.fromRGB(255, 105, 170),
	red = Color3.fromRGB(255, 80, 90),
	purple = Color3.fromRGB(150, 100, 255),
	orange = Color3.fromRGB(255, 150, 50),
	grey = Color3.fromRGB(170, 170, 190),
	dark = Color3.fromRGB(35, 35, 60),
}

function Kit.darker(c: Color3, f: number?): Color3
	return c:Lerp(Color3.new(0, 0, 0), f or 0.25)
end

function Kit.corner(parent: Instance, radius: number?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 14)
	c.Parent = parent
	return c
end

function Kit.stroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color or Kit.C.ink
	s.Thickness = thickness or 3
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

function Kit.gradient(parent: Instance, a: Color3, b: Color3, rotation: number?): UIGradient
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(a, b)
	g.Rotation = rotation or 90
	g.Parent = parent
	return g
end

function Kit.frame(parent: Instance, size: UDim2, pos: UDim2, color: Color3?, anchor: Vector2?): Frame
	local f = Instance.new("Frame")
	f.Size = size
	f.Position = pos
	f.AnchorPoint = anchor or Vector2.zero
	f.BackgroundColor3 = color or Kit.C.panel
	f.BackgroundTransparency = if color then 0 else 1
	f.BorderSizePixel = 0
	f.Parent = parent
	return f
end

function Kit.text(parent: Instance, text: string, size: UDim2, pos: UDim2, color: Color3?, anchor: Vector2?, maxSize: number?): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = size
	t.Position = pos
	t.AnchorPoint = anchor or Vector2.zero
	t.Font = Kit.Font
	setInitial(t, text)
	t.TextColor3 = color or Kit.C.white
	t.TextScaled = true
	t.RichText = true
	local c = Instance.new("UITextSizeConstraint")
	c.MaxTextSize = maxSize or 40
	c.Parent = t
	t.Parent = parent
	return t
end

-- Outlined white text (for text on colourful backgrounds).
function Kit.bold(parent: Instance, text: string, size: UDim2, pos: UDim2, color: Color3?, anchor: Vector2?, maxSize: number?): TextLabel
	local t = Kit.text(parent, text, size, pos, color, anchor, maxSize)
	local s = Instance.new("UIStroke")
	s.Color = Kit.C.ink
	s.Thickness = 2.5
	s.Parent = t
	return t
end

-- Button states. The face gradient ends in a darker "lip" (the 3D base of the button):
--   rest    : lip visible, scale 1
--   hover   : scale 1.04 + white outline (mouse only)
--   pressed : the face slides down over the lip, scale 0.95
-- Released / activated: springs back to rest (or hover).
local LIP = 0.86
local function faceGradient(): ColorSequence
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(0.45, Color3.fromRGB(240, 240, 240)),
		ColorSequenceKeypoint.new(LIP, Color3.fromRGB(215, 215, 215)),
		ColorSequenceKeypoint.new(LIP + 0.01, Color3.fromRGB(150, 150, 150)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 150, 150)),
	})
end

local function wireStates(btn: GuiButton, border: UIStroke, face: UIGradient)
	local scale = btn:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	scale.Parent = btn
	local hovered, down = false, false
	local function update(spring: boolean)
		local target = if down then 0.95 elseif hovered then 1.04 else 1
		local info = if spring then TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out) else TweenInfo.new(0.07)
		TweenService:Create(scale, info, { Scale = target }):Play()
		TweenService:Create(face, TweenInfo.new(0.07), { Offset = Vector2.new(0, if down then 1 - LIP else 0) }):Play()
		-- the outline follows the button colour (panels recolour buttons for on / off states)
		border.Color = if hovered and not down then Color3.new(1, 1, 1) else btn.BackgroundColor3:Lerp(Color3.new(0, 0, 0), 0.45)
	end
	btn.MouseEnter:Connect(function()
		hovered = true
		update(false)
	end)
	btn.MouseLeave:Connect(function()
		hovered, down = false, false
		update(true)
	end)
	btn.MouseButton1Down:Connect(function()
		down = true
		update(false)
	end)
	btn.MouseButton1Up:Connect(function()
		down = false
		update(true)
	end)
	btn:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
		update(false)
	end)
	-- touch taps and gamepad activations don't always send Down / Up: give them the same dip
	btn.Activated:Connect(function()
		if not down then
			down = true
			update(false)
			task.delay(0.08, function()
				down = false
				update(true)
			end)
		end
	end)
end

-- Chunky 3D-ish button: coloured face over a darker "shadow" base.
function Kit.button(parent: Instance, text: string, size: UDim2, pos: UDim2, color: Color3, onClick: () -> (), anchor: Vector2?, maxText: number?): TextButton
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = pos
	b.AnchorPoint = anchor or Vector2.zero
	b.BackgroundColor3 = color
	b.AutoButtonColor = false
	b.Font = Kit.Font
	setInitial(b, text)
	b.TextColor3 = Kit.C.white
	b.TextScaled = true
	b.RichText = true
	b.Parent = parent
	Kit.corner(b, 14)
	local st = Kit.stroke(b, Kit.darker(color, 0.45), 3)
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	local face = Instance.new("UIGradient")
	face.Color = faceGradient()
	face.Rotation = 90
	face.Parent = b
	local ts = Instance.new("UITextSizeConstraint")
	ts.MaxTextSize = maxText or 30
	ts.Parent = b
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 6)
	pad.PaddingRight = UDim.new(0, 6)
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = b
	local textStroke = Instance.new("UIStroke")
	textStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	textStroke.Color = Kit.darker(color, 0.5)
	textStroke.Thickness = 2
	textStroke.Parent = b
	wireStates(b, st, face)
	b.Activated:Connect(onClick)
	return b
end

-- An icon from the shared pack (Shared/Icons) as an ImageLabel, sized / placed like a label.
function Kit.image(parent: Instance, image: string, size: UDim2, pos: UDim2, anchor: Vector2?): ImageLabel
	local img = Instance.new("ImageLabel")
	img.Name = "Icon"
	img.BackgroundTransparency = 1
	img.BorderSizePixel = 0
	img.Image = image
	img.ScaleType = Enum.ScaleType.Fit
	img.Size = size
	img.Position = pos
	img.AnchorPoint = anchor or Vector2.zero
	img.Parent = parent
	return img
end

-- The one place emoji icons are drawn: the uploaded icon (ImageLabel, ScaleType Fit) when the
-- glyph has one in Shared/Icons with an id, otherwise the emoji exactly as before (a TextLabel).
-- Either way the object is named "Icon".
function Kit.icon(parent: Instance, glyph: string, size: UDim2, pos: UDim2, color: Color3?, anchor: Vector2?, maxSize: number?): GuiObject
	local image = Icons.forGlyphImage(glyph)
	if image then
		return Kit.image(parent, image, size, pos, anchor)
	end
	local t = Kit.text(parent, glyph, size, pos, color or Kit.C.white, anchor, maxSize)
	t.Name = "Icon"
	return t
end

-- Coin: the uploaded "coin" icon when there is one, else the drawn coin (the coin emoji is
-- missing from Roblox's emoji font).
function Kit.coin(parent: Instance, size: number, pos: UDim2, anchor: Vector2?): GuiObject
	local image = Icons.get("coin")
	if image then
		return Kit.image(parent, image, UDim2.fromOffset(size, size), pos, anchor)
	end
	local c = Kit.frame(parent, UDim2.fromOffset(size, size), pos, Color3.fromRGB(255, 205, 40), anchor)
	Kit.corner(c, size)
	Kit.stroke(c, Color3.fromRGB(200, 130, 10), math.max(2, size * 0.09))
	local inner = Kit.frame(c, UDim2.fromScale(0.56, 0.56), UDim2.fromScale(0.5, 0.5), Color3.fromRGB(255, 225, 100), Vector2.new(0.5, 0.5))
	Kit.corner(inner, size)
	Kit.stroke(inner, Color3.fromRGB(225, 160, 20), math.max(1, size * 0.06))
	return c
end

-- Keeps a short label on ONE line at the biggest size that fits (TextScaled would rather break a
-- long word like "Checkpoint" in two than shrink it). Re-fits on text / size / language changes.
function Kit.singleLine(obj: TextButton, maxSize: number)
	obj.TextScaled = false
	obj.TextWrapped = false
	local busy = false
	local function fit()
		if busy then
			return
		end
		busy = true
		local pad = obj:FindFirstChildOfClass("UIPadding")
		local padX = if pad then pad.PaddingLeft.Offset + pad.PaddingRight.Offset else 0
		local padY = if pad then pad.PaddingTop.Offset + pad.PaddingBottom.Offset else 0
		-- design (unscaled) box: TextSize is scaled by the region's UIScale just like Size
		local w = obj.Size.X.Offset - padX - 4
		-- height: own offset, or (when sized by scale) the parent's design height
		local parent = obj.Parent
		local h = obj.Size.Y.Offset
		if h <= 0 and parent and parent:IsA("GuiObject") then
			h = obj.Size.Y.Scale * parent.Size.Y.Offset + obj.Size.Y.Offset
		end
		h -= padY
		local size = math.min(maxSize, math.floor(h))
		local plain = string.gsub(obj.Text, "<[^>]+>", "")
		while size > 8 do
			local ok, bounds = pcall(function()
				return TextService:GetTextSize(plain, size, obj.Font, Vector2.new(10000, 10000))
			end)
			if not ok or bounds.X <= w then
				break
			end
			size -= 1
		end
		obj.TextSize = size
		busy = false
	end
	obj:GetPropertyChangedSignal("Text"):Connect(fit)
	obj:GetPropertyChangedSignal("Size"):Connect(fit)
	local holder = obj.Parent
	if holder and holder:IsA("GuiObject") then
		holder:GetPropertyChangedSignal("Size"):Connect(fit)
	end
	fit()
end

function Kit.pop(obj: GuiObject, from: number?)
	local scale = obj:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	scale.Parent = obj
	scale.Scale = from or 0.4
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

function Kit.formatNumber(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

function Kit.formatTime(sec: number): string
	sec = math.max(0, math.floor(sec))
	local h = sec // 3600
	local m = (sec % 3600) // 60
	local s = sec % 60
	if h > 0 then
		return ("%dh %02dm"):format(h, m)
	end
	return ("%d:%02d"):format(m, s)
end

---------------------------------------------------------------------------------------------
-- ScreenGui + scaled regions
---------------------------------------------------------------------------------------------
local gui: ScreenGui? = nil
type Region = { frame: Frame, scale: UIScale, fit: Vector2?, fitTouch: Vector2? }
local regions: { Region } = {}

function Kit.isTouch(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function baseScale(): (number, Vector2)
	local cam = Workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
	local s = math.min(vp.X / 1280, vp.Y / 720)
	if s < 1 then
		s = s ^ 0.6 -- shrink less than linearly on small screens so buttons stay tappable
	end
	if Kit.isTouch() then
		s *= 1.25 -- bigger touch targets on phones/tablets
	end
	return math.clamp(s, 0.55, 1.5), vp
end

type LayoutFn = (touch: boolean, area: Vector2, scale: number) -> ()
local layoutFns: { LayoutFn } = {}
local playerListOn: boolean? = nil

-- Usable area of the ScreenGui (the viewport minus the Roblox top bar, see CoreUISafeInsets).
function Kit.area(): Vector2
	local size = if gui then gui.AbsoluteSize else Vector2.zero
	if size.X < 10 then
		local cam = Workspace.CurrentCamera
		size = if cam then cam.ViewportSize else Vector2.new(1280, 720)
	end
	return size
end

local function rescale()
	local s = baseScale()
	local area = Kit.area()
	for _, r in regions do
		local v = s
		if r.fit then
			-- touch: a wider, shorter design box (phones are landscape) so the same panel can be
			-- scaled up more and its buttons stay >= 44 px
			local fit = if Kit.isTouch() and r.fitTouch then r.fitTouch else r.fit
			r.frame.Size = UDim2.fromOffset(fit.X, fit.Y)
			-- panels: as big as the screen allows (capped), so their buttons stay tappable on
			-- phones regardless of the HUD scale, and never past the screen edges
			v = math.min(Kit.PANEL_MAX_SCALE, (area.X - 16) / fit.X, (area.Y - 12) / fit.Y)
			-- the drop shadow (22 design px below the panel) only where it fits on screen: on
			-- phones the panel takes the whole height and the dim veil does the separating
			local window = r.frame:FindFirstChild("Window")
			if window then
				local room = math.min((area.Y - v * fit.Y) / 2 - area.Y * 0.02, (area.X - v * fit.X) / 2)
				for _, c in window:GetChildren() do
					if c.Name == "Shadow" and c:IsA("GuiObject") then
						c.Visible = room >= 26 * v
					end
				end
			end
		end
		r.scale.Scale = v
	end
	-- The right edge belongs to the tower progress bar (everybody's head is on it), so the
	-- default player list stays closed.
	local wantList = false
	if wantList ~= playerListOn then
		playerListOn = wantList
		pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, wantList)
		end)
	end
	local touch = Kit.isTouch()
	for _, fn in layoutFns do
		fn(touch, area, s)
	end
end

-- Re-runs every layout function (e.g. after a HUD element was shown or hidden).
function Kit.relayout()
	rescale()
end

-- Registers a function that re-positions regions whenever the screen size / input mode changes.
function Kit.onLayout(fn: LayoutFn)
	table.insert(layoutFns, fn)
	local s = baseScale()
	fn(Kit.isTouch(), Kit.area(), s)
end

Kit.PANEL_MAX_SCALE = 1.1
Kit.PANEL_TOUCH_H = 350 -- design height of a panel on touch screens (width 860)

-- Overrides one region's scale (call from an onLayout function; the next rescale resets it first).
function Kit.setScale(region: Frame, value: number)
	local sc = region:FindFirstChildOfClass("UIScale")
	if sc then
		sc.Scale = value
	end
end

-- Bottom edge (px from the top of the safe area) of the always-on top-centre HUD; Hud keeps it updated.
Kit.hudTop = 0
-- Height (px) of the offer strip under it while one is showing (Cards keeps it updated).
Kit.cardInset = 0

-- Current base UI scale (what regions without `fit` use).
function Kit.scale(): number
	return (baseScale())
end

function Kit.gui(): ScreenGui
	if gui then
		return gui
	end
	local g = Instance.new("ScreenGui")
	g.Name = "SkyTowerUI"
	g.ResetOnSpawn = false
	-- keep everything below the Roblox top bar (menu / chat buttons) and inside notches
	g.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	g.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = g
	local function hook()
		local cam = Workspace.CurrentCamera
		if cam then
			cam:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
		end
		rescale()
	end
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hook)
	g:GetPropertyChangedSignal("AbsoluteSize"):Connect(rescale)
	UserInputService.LastInputTypeChanged:Connect(rescale)
	hook()
	return g
end

-- A transparent container of `designSize` pixels, anchored on screen, scaled as one unit.
function Kit.region(name: string, anchor: Vector2, pos: UDim2, designSize: Vector2, fitScreen: boolean?, touchSize: Vector2?): Frame
	local f = Kit.frame(Kit.gui(), UDim2.fromOffset(designSize.X, designSize.Y), pos, nil, anchor)
	f.Name = name
	local s = Instance.new("UIScale")
	s.Parent = f
	table.insert(regions, { frame = f, scale = s, fit = if fitScreen then designSize else nil, fitTouch = touchSize })
	rescale()
	return f
end

---------------------------------------------------------------------------------------------
-- Panels (modal windows, one open at a time)
---------------------------------------------------------------------------------------------
type Panel = { root: Frame, onOpen: (() -> ())? }
local panels: { [string]: Panel } = {}
local current: string? = nil
local panelChanged = Instance.new("BindableEvent")
Kit.panelChanged = panelChanged.Event

-- Dark veil behind the open panel (covers the whole screen, top bar included). Tapping it closes
-- the panel.
local dim: TextButton? = nil
local function ensureDim(): TextButton
	if dim then
		return dim
	end
	local g = Kit.gui()
	local d = Instance.new("TextButton")
	d.Name = "Dim"
	d.Text = ""
	d.AutoButtonColor = false
	d.BackgroundColor3 = Color3.fromRGB(15, 15, 35)
	d.BackgroundTransparency = 1
	d.BorderSizePixel = 0
	d.ZIndex = 9
	d.Visible = false
	d.Parent = g
	local probe = Kit.frame(g, UDim2.fromOffset(1, 1), UDim2.new(), nil)
	probe.Name = "Origin"
	Kit.onLayout(function()
		local cam = Workspace.CurrentCamera
		local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
		local inset = GuiService:GetGuiInset()
		-- AbsolutePosition is measured from under the top bar: shift up / left to the real corner
		d.Position = UDim2.fromOffset(-probe.AbsolutePosition.X, -probe.AbsolutePosition.Y - inset.Y)
		d.Size = UDim2.fromOffset(vp.X, vp.Y)
	end)
	d.Activated:Connect(function()
		Kit.close()
	end)
	dim = d
	return d
end

local function showDim(on: boolean)
	local d = ensureDim()
	if on then
		d.Visible = true
		TweenService:Create(d, TweenInfo.new(0.18), { BackgroundTransparency = 0.5 }):Play()
	else
		d.BackgroundTransparency = 1
		d.Visible = false
	end
end

function Kit.panel(name: string, title: string, color: Color3): (Frame, Frame)
	local root = Kit.region("Panel_" .. name, Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.52), Vector2.new(640, 460), true, Vector2.new(860, Kit.PANEL_TOUCH_H))
	root.Visible = false
	root.ZIndex = 10
	ensureDim()
	-- "Window" is what pops open: a soft drop shadow under the body
	local window = Kit.frame(root, UDim2.fromScale(1, 1), UDim2.fromScale(0.5, 0.5), nil, Vector2.new(0.5, 0.5))
	window.Name = "Window"
	for i, spread in { 14, 7 } do
		local shadow = Kit.frame(window, UDim2.new(1, spread * 2, 1, spread * 2), UDim2.new(0.5, 0, 0.5, 8), Color3.new(0, 0, 0), Vector2.new(0.5, 0.5))
		shadow.Name = "Shadow"
		shadow.BackgroundTransparency = if i == 1 then 0.88 else 0.8
		Kit.corner(shadow, 24 + spread)
	end
	local body = Kit.frame(window, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), Kit.C.panel)
	body.Name = "Body"
	Kit.corner(body, 24)
	Kit.stroke(body, Kit.C.ink, 4)
	local header = Kit.frame(body, UDim2.new(1, 0, 0, 64), UDim2.fromScale(0, 0), color)
	Kit.corner(header, 24)
	Kit.gradient(header, Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 215))
	local headerFill = Kit.frame(header, UDim2.new(1, 0, 0, 24), UDim2.new(0, 0, 1, -24), Kit.darker(color, 0.12))
	headerFill.Name = "SquareBottom"
	local headerLine = Kit.frame(header, UDim2.new(1, 0, 0, 4), UDim2.new(0, 0, 1, -2), Kit.darker(color, 0.4))
	headerLine.Name = "Line"
	Kit.bold(header, title, UDim2.new(1, -140, 1, -12), UDim2.fromOffset(24, 6), Kit.C.white, nil, 38).TextXAlignment = Enum.TextXAlignment.Left
	Kit.button(header, "X", UDim2.fromOffset(52, 52), UDim2.new(1, -6, 0.5, 0), Kit.C.red, function()
		Kit.close()
	end, Vector2.new(1, 0.5), 30)
	Kit.relayout() -- decides whether this panel's shadow fits
	local content = Kit.frame(body, UDim2.new(1, -32, 1, -84), UDim2.fromOffset(16, 72), nil)
	content.Name = "Content"
	-- touch: a slimmer header gives the content the room the shorter panel took away
	Kit.onLayout(function(touch)
		header.Size = UDim2.new(1, 0, 0, if touch then 56 else 64)
		content.Size = if touch then UDim2.new(1, -32, 1, -68) else UDim2.new(1, -32, 1, -84)
		content.Position = UDim2.fromOffset(16, if touch then 60 else 72)
	end)
	panels[name] = { root = root }
	return content, root
end

function Kit.onOpen(name: string, fn: () -> ())
	local p = panels[name]
	if p then
		p.onOpen = fn
	end
end

function Kit.open(name: string)
	for n, p in panels do
		p.root.Visible = n == name
	end
	local p = panels[name]
	if not p then
		return
	end
	current = name
	showDim(true)
	Kit.pop(p.root:FindFirstChild("Window") :: Frame, 0.6)
	if p.onOpen then
		p.onOpen()
	end
	panelChanged:Fire(name)
end

function Kit.close()
	for _, p in panels do
		p.root.Visible = false
	end
	current = nil
	showDim(false)
	panelChanged:Fire(nil)
end

function Kit.toggle(name: string)
	if current == name then
		Kit.close()
	else
		Kit.open(name)
	end
end

function Kit.current(): string?
	return current
end

-- Scrolling grid used by shop/store panels.
function Kit.grid(parent: Instance, cell: Vector2, size: UDim2?, pos: UDim2?): ScrollingFrame
	local sf = Instance.new("ScrollingFrame")
	sf.Size = size or UDim2.fromScale(1, 1)
	sf.Position = pos or UDim2.fromScale(0, 0)
	sf.BackgroundTransparency = 1
	sf.BorderSizePixel = 0
	sf.ScrollBarThickness = 8
	sf.ScrollBarImageColor3 = Kit.C.ink
	sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
	sf.CanvasSize = UDim2.new()
	sf.ScrollingDirection = Enum.ScrollingDirection.Y
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(cell.X, cell.Y)
	layout.CellPadding = UDim2.fromOffset(12, 12)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = sf
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.Parent = sf
	sf.Parent = parent
	return sf
end

function Kit.card(parent: Instance, order: number): Frame
	local c = Kit.frame(parent, UDim2.fromOffset(100, 100), UDim2.new(), Kit.C.card)
	c.LayoutOrder = order
	Kit.corner(c, 16)
	Kit.stroke(c, Color3.fromRGB(220, 210, 235), 3)
	return c
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">Progress</string>
              <string name="Source"><![CDATA[--!strict
-- Progress, the way tower games show it:
--   * "Progress": a thin vertical bar on the right edge for the 100 stages of the tower you are
--     on (ten segments in the colours of its worlds, bottom = stage 0, top = summit), with your
--     head and everybody else's next to it.
--   * "LevelBar": a wide slim bar at the bottom centre for the whole climb (stage N of 1,000, a
--     tick on every summit gift), and over it the tower's name and the next gift.
-- Hud.luau places both (they depend on the input mode and on the action buttons).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Segments = require(ReplicatedStorage.Shared.Segments)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Gifts = require(ReplicatedStorage.Shared.Gifts)
local TowerStyle = require(ReplicatedStorage.Shared.TowerStyle)
local Net = require(script.Parent.Parent.Net)
local Kit = require(script.Parent.Kit)

local Progress = {}

local TOTAL = Layout.TOTAL
Progress.SIDE_W = 64 -- design px: heads (left) + track (right)
Progress.TRACK_W = 16
Progress.LEVEL_W = 760
Progress.LEVEL_H = 50 -- tower line (18) + bar (28) + gap
local thumbs: { [number]: string } = {}

-- One colour per world (10 stages each), in tower order: the bar shows which world you are in
-- and what is coming.
Progress.WORLD_COLORS = {
	Color3.fromRGB(110, 205, 90), -- Grassy Hills
	Color3.fromRGB(255, 140, 205), -- Candy Land
	Color3.fromRGB(140, 210, 255), -- Frozen Peaks
	Color3.fromRGB(240, 190, 100), -- Desert Ruins
	Color3.fromRGB(255, 110, 40), -- Lava Caves
	Color3.fromRGB(60, 195, 200), -- Ocean Reef
	Color3.fromRGB(165, 225, 50), -- Toxic Factory
	Color3.fromRGB(190, 205, 255), -- Cloud Kingdom
	Color3.fromRGB(185, 85, 255), -- Neon Space
	Color3.fromRGB(255, 205, 60), -- Rainbow Summit
}

-- The side bar shows the 100 stages of the tower you are on: ten segments in the colours of its
-- ten worlds, in the order that tower plays them.
local function worldSequence(tower: number): ColorSequence
	local points = {}
	for _, stop in Segments.colorStops(#Progress.WORLD_COLORS) do
		local style = Layout.themeFor((tower - 1) * Layout.STAGES + (stop.index - 1) * 10 + 1)
		table.insert(points, ColorSequenceKeypoint.new(stop.t, Progress.WORLD_COLORS[style]))
	end
	return ColorSequence.new(points)
end

-- Tower being climbed at global stage `stage` (on a summit: the one just finished, until the
-- portal is taken) and the position inside it (0..100).
local function towerAndSlot(stage: number, onBase: boolean): (number, number)
	if stage <= 0 then
		return 1, 0
	end
	if stage % Layout.STAGES == 0 then
		local done = stage // Layout.STAGES
		if onBase and done < Layout.TOWERS then
			return done + 1, 0
		end
		return done, Layout.STAGES
	end
	return Layout.towerOf(stage), Layout.slotOf(stage)
end
Progress.towerAndSlot = towerAndSlot

local function reveal(p: number): NumberSequence
	local points = {}
	for _, stop in Segments.revealStops(p) do
		table.insert(points, NumberSequenceKeypoint.new(stop.t, stop.value))
	end
	return NumberSequence.new(points)
end

local function headshot(userId: number): string
	local cached = thumbs[userId]
	if cached then
		return cached
	end
	thumbs[userId] = "" -- in flight
	task.spawn(function()
		local ok, url = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
		end)
		thumbs[userId] = if ok then url else ""
	end)
	return ""
end

local function stageOf(p: Player): number
	local v = p:GetAttribute("Stage")
	if type(v) == "number" then
		return v
	end
	local ls = p:FindFirstChild("leaderstats")
	local st = ls and ls:FindFirstChild("Stage")
	if st and st:IsA("IntValue") then
		return st.Value
	end
	return 0
end

function Progress.init()
	-- side bar ---------------------------------------------------------------------------------
	local side = Kit.region("Progress", Vector2.new(1, 0.5), UDim2.new(1, -6, 0.5, 0), Vector2.new(Progress.SIDE_W, 500))
	local track = Kit.frame(side, UDim2.new(0, Progress.TRACK_W, 1, 0), UDim2.fromScale(1, 0), Color3.fromRGB(255, 255, 255), Vector2.new(1, 0))
	track.Name = "Track"
	Kit.corner(track, 8)
	Kit.stroke(track, Kit.C.ink, 2.5)
	-- the whole bar in pale world colours, and on top of it the part you've climbed at full
	-- strength (same gradient, revealed up to your progress). Rotation -90: 0 is the bottom.
	local ghost = Kit.frame(track, UDim2.fromScale(1, 1), UDim2.new(), Color3.fromRGB(255, 255, 255))
	ghost.Name = "Worlds"
	Kit.corner(ghost, 8)
	local ghostGradient = Instance.new("UIGradient")
	ghostGradient.Rotation = -90
	ghostGradient.Color = worldSequence(1)
	ghostGradient.Transparency = NumberSequence.new(0.7)
	ghostGradient.Parent = ghost
	local fill = Kit.frame(track, UDim2.fromScale(1, 1), UDim2.new(), Color3.fromRGB(255, 255, 255))
	fill.Name = "Fill"
	Kit.corner(fill, 8)
	local fillGradient = Instance.new("UIGradient")
	fillGradient.Rotation = -90
	fillGradient.Color = worldSequence(1)
	fillGradient.Transparency = reveal(0)
	fillGradient.Parent = fill
	-- a tick between worlds
	for i = 1, 9 do
		local tick = Kit.frame(track, UDim2.new(1, 0, 0, 2), UDim2.fromScale(0, 1 - i / 10), Kit.C.ink)
		tick.BackgroundTransparency = 0.5
		tick.ZIndex = 2
	end
	local markers = Kit.frame(side, UDim2.new(1, -Progress.TRACK_W - 4, 1, 0), UDim2.new(), nil)
	markers.Name = "Markers"

	-- level bar --------------------------------------------------------------------------------
	local level = Kit.region("LevelBar", Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -8), Vector2.new(Progress.LEVEL_W, Progress.LEVEL_H))
	local sub = Kit.bold(level, "", UDim2.new(1, 0, 0, 18), UDim2.new(), Kit.C.white, nil, 16)
	sub.Name = "Tower"
	local bar = Kit.frame(level, UDim2.new(1, 0, 0, 28), UDim2.fromOffset(0, 21), Color3.fromRGB(24, 28, 44))
	bar.Name = "Bar"
	bar.BackgroundTransparency = 0.35
	Kit.corner(bar, 14)
	Kit.stroke(bar, Kit.C.ink, 2.5)
	local total = Kit.frame(bar, UDim2.fromScale(1, 1), UDim2.new(), Color3.fromRGB(255, 255, 255))
	total.Name = "Total"
	Kit.corner(total, 14)
	local totalGradient = Instance.new("UIGradient")
	totalGradient.Color = ColorSequence.new(Color3.fromRGB(90, 220, 110), Color3.fromRGB(255, 210, 70))
	totalGradient.Transparency = reveal(0)
	totalGradient.Parent = total
	-- a tick on every summit (a gift waits on each)
	for i = 1, Layout.TOWERS - 1 do
		local tick = Kit.frame(bar, UDim2.new(0, 2, 1, 0), UDim2.fromScale(i / Layout.TOWERS, 0), Color3.fromRGB(255, 255, 255))
		tick.BackgroundTransparency = 0.45
		tick.ZIndex = 2
	end
	local label = Kit.bold(bar, "", UDim2.new(1, -16, 1, -4), UDim2.fromOffset(8, 2), Kit.C.white, nil, 19)
	label.Name = "Label"
	label.ZIndex = 3

	local shownFraction, shownTotal = -1, -1
	local shownTower = 1
	local shownSub = ""

	local dots: { [Player]: ImageLabel } = {}
	local function dotFor(p: Player): ImageLabel
		local d = dots[p]
		if d then
			return d
		end
		local isMe = p == Players.LocalPlayer
		local size = if isMe then 38 else 28
		local img = Instance.new("ImageLabel")
		img.Name = if isMe then "Me" else "Head"
		img.Size = UDim2.fromOffset(size, size)
		img.AnchorPoint = Vector2.new(1, 0.5)
		img.BackgroundColor3 = if isMe then Kit.C.yellow else Color3.fromRGB(230, 230, 245)
		img.ZIndex = if isMe then 5 else 4
		Kit.corner(img, size)
		Kit.stroke(img, if isMe then Kit.C.orange else Kit.C.ink, if isMe then 3 else 2)
		img.Parent = markers
		dots[p] = img
		return img
	end

	Players.PlayerRemoving:Connect(function(p)
		local d = dots[p]
		if d then
			d:Destroy()
			dots[p] = nil
		end
	end)

	task.spawn(function()
		while true do
			local me = Players.LocalPlayer
			local myStage = stageOf(me)
			local tower, slot = towerAndSlot(myStage, Net.state.base == true)
			if tower ~= shownTower then
				shownTower = tower
				ghostGradient.Color = worldSequence(tower)
				fillGradient.Color = worldSequence(tower)
			end
			local fraction = math.clamp(slot / Layout.STAGES, 0, 1)
			if fraction ~= shownFraction then
				shownFraction = fraction
				fillGradient.Transparency = reveal(fraction)
			end
			local whole = math.clamp(myStage / TOTAL, 0, 1)
			if whole ~= shownTotal then
				shownTotal = whole
				totalGradient.Transparency = reveal(whole)
			end
			local gift = Gifts.next(math.max(tonumber(Net.state.best) or 0, myStage))
			local subKey = ("%d:%d:%s"):format(tower, if gift then gift.id else 0, tostring(myStage))
			if subKey ~= shownSub then
				shownSub = subKey
				Kit.setText(label, "progress.label", { stage = myStage, total = TOTAL, pct = math.floor(myStage / TOTAL * 100) })
				local name = { key = "tower." .. TowerStyle.mood(tower).key }
				if gift then
					Kit.setText(sub, "progress.sub", { n = tower, name = name, stage = gift.stage, gift = { key = "gift." .. gift.id .. ".name" } })
				else
					Kit.setText(sub, "progress.sub_done", { n = tower, name = name })
				end
			end
			local shown = 0
			for _, p in Players:GetPlayers() do
				if p == me or shown < 15 then
					if p ~= me then
						shown += 1
					end
					local d = dotFor(p)
					-- everybody on your tower is on the bar; players on other towers sit at its ends
					local theirTower, theirSlot = towerAndSlot(stageOf(p), p == me and Net.state.base == true)
					local y = if theirTower == tower then theirSlot / Layout.STAGES elseif theirTower < tower then 0 else 1
					d.Position = UDim2.new(1, 0, 1 - math.clamp(y, 0, 1), 0)
					if d.Image == "" then
						d.Image = headshot(p.UserId)
					end
				end
			end
			task.wait(0.5)
		end
	end)
end

return Progress
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">Prompts</string>
              <string name="Source"><![CDATA[--!strict
-- Server-triggered cards:
--   OfferSkip (P0-1)        "Stuck on stage N?" after a death streak: free skip / watch a video /
--                           buy a skip (Studio with product ids at 0: free dev skip).
--   AskNotifications (P0-8) "Want a ping when 2x Coins Weekend starts?" -> ExperienceNotificationService.
local AdService = game:GetService("AdService")
local ExperienceNotificationService = game:GetService("ExperienceNotificationService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Pricing = require(ReplicatedStorage.Shared.Pricing)
local Net = require(script.Parent.Parent.Net)
local Lang = require(script.Parent.Parent.Lang)
local Kit = require(script.Parent.Kit)
local Cards = require(script.Parent.Cards)
local Toast = require(script.Parent.Toast)
local Hud = require(script.Parent.Hud)

local Prompts = {}

local OFFER_SECONDS = 10

local function adAvailable(): boolean
	if Config.Products.AdSkip == 0 then
		return false
	end
	local ok, result = pcall(function()
		return AdService:GetAdAvailabilityNowAsync(Enum.AdFormat.RewardedVideo)
	end)
	return ok and type(result) == "table" and result.AdAvailabilityResult == Enum.AdAvailabilityResult.IsAvailable
end

local function say(ok: boolean, msg: string?, _data: any?)
	if msg then
		Toast.show(msg, if ok then "success" else "error")
	end
end

function Prompts.offerSkip(data: { [string]: any })
	local s = Net.state
	local stage = tonumber(data.stage) or ((s.stage or 0) + 1)
	local buttons: { Cards.CardButton } = {}
	local free = s.freeSkips or tonumber(data.freeSkips) or 0
	if free > 0 then
		table.insert(buttons, {
			name = "FreeSkip",
			text = Lang.t("offer.free", { n = free }),
			color = Kit.C.green,
			onClick = function()
				say(Net.request("UseFreeSkip"))
			end,
		})
	end
	-- ask AdService only when the card opens (it can yield), then show the card
	if data.adAvailableHint and adAvailable() then
		table.insert(buttons, {
			name = "AdSkip",
			text = Lang.t("offer.ad"),
			color = Kit.C.purple,
			onClick = function()
				say(Net.request("WatchAd", { placement = "skip" }))
			end,
		})
	end
	local skipId = Pricing.skipProductId(Config.Products, s.at or s.stage or 0)
	if skipId ~= 0 then
		Hud.fetchPrice(skipId, function() end)
		local price = Hud.priceOf(skipId)
		table.insert(buttons, {
			name = "PaidSkip",
			text = if price then Lang.t("offer.paid", { price = price }) else Lang.t("offer.paid_noprice"),
			color = Kit.C.blue,
			onClick = function()
				MarketplaceService:PromptProductPurchase(Players.LocalPlayer, skipId)
			end,
		})
	elseif Hud.studioTools() then
		table.insert(buttons, {
			name = "PaidSkip",
			text = Lang.t("offer.studio"),
			color = Kit.C.blue,
			onClick = function()
				say(Net.request("DevSkip", { n = 1 }))
			end,
		})
	end
	if #buttons == 0 then
		return
	end
	Cards.show("offer", Lang.t("offer.title", { n = stage }), buttons, OFFER_SECONDS)
end

function Prompts.askNotifications()
	local ok, can = pcall(function()
		return ExperienceNotificationService:CanPromptOptInAsync()
	end)
	if not ok or not can then
		return -- not eligible (or Studio): nothing to ask
	end
	Cards.show("notify", Lang.t("notify.title"), {
		{
			name = "Yes",
			text = Lang.t("notify.yes"),
			color = Kit.C.green,
			onClick = function()
				pcall(function()
					ExperienceNotificationService:PromptOptIn()
				end)
			end,
		},
		{ name = "No", text = Lang.t("notify.no"), color = Kit.C.grey, onClick = function() end },
	}, 15)
end

function Prompts.init()
	Net.on("OfferSkip", function(data)
		task.spawn(Prompts.offerSkip, if type(data) == "table" then data else {})
	end)
	Net.on("AskNotifications", function()
		task.spawn(Prompts.askNotifications)
	end)
	-- a skip / new checkpoint makes the offer pointless
	Net.changed:Connect(function(new, prev)
		if prev.stage and new.stage ~= prev.stage then
			Cards.hide("offer")
		end
	end)
end

return Prompts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">RewardsPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Daily reward, play-time rewards (5/15/30/60 min this session) and codes.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(script.Parent.Parent.Net)
local Kit = require(script.Parent.Kit)
local Toast = require(script.Parent.Toast)

local RewardsPanel = {}

local function say(ok: boolean, msg: string?, _extra: any?)
	if msg then
		Toast.show(msg, if ok then "success" else "error")
	end
end

function RewardsPanel.init()
	local content = Kit.panel("rewards", "@panel.rewards", Kit.C.orange)

	-- daily ------------------------------------------------------------------------------------
	local dailyTitle: TextLabel
	local daily = Kit.frame(content, UDim2.new(0.5, -8, 0, 170), UDim2.fromOffset(0, 0), Kit.C.card)
	Kit.corner(daily, 16)
	Kit.stroke(daily, Color3.fromRGB(220, 210, 235), 3)
	dailyTitle = Kit.text(daily, "@rewards.daily", UDim2.new(1, -20, 0, 34), UDim2.fromOffset(10, 8), Kit.C.ink, nil, 30)
	local dailyInfo = Kit.text(daily, "", UDim2.new(1, -20, 0, 50), UDim2.fromOffset(10, 44), Color3.fromRGB(110, 105, 140), nil, 20)
	local dailyBtn = Kit.button(daily, "@rewards.claim", UDim2.new(1, -20, 0, 56), UDim2.new(0, 10, 1, -66), Kit.C.green, function()
		say(Net.request("ClaimDaily"))
	end)

	-- codes ---------------------------------------------------------------------------------------
	local codes = Kit.frame(content, UDim2.new(0.5, -8, 0, 170), UDim2.new(0.5, 8, 0, 0), Kit.C.card)
	Kit.corner(codes, 16)
	Kit.stroke(codes, Color3.fromRGB(220, 210, 235), 3)
	local codesTitle = Kit.text(codes, "@rewards.codes", UDim2.new(1, -20, 0, 34), UDim2.fromOffset(10, 8), Kit.C.ink, nil, 30)
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, -20, 0, 48)
	box.Position = UDim2.fromOffset(10, 46)
	box.BackgroundColor3 = Color3.fromRGB(245, 242, 250)
	Kit.setText(box, "rewards.enter_code", nil, "PlaceholderText")
	box.Text = ""
	box.Font = Kit.Font
	box.TextScaled = true
	box.TextColor3 = Kit.C.ink
	box.ClearTextOnFocus = false
	Kit.corner(box, 12)
	Kit.stroke(box, Color3.fromRGB(200, 190, 220), 2)
	local tsc = Instance.new("UITextSizeConstraint")
	tsc.MaxTextSize = 26
	tsc.Parent = box
	box.Parent = codes
	local redeemBtn = Kit.button(codes, "@rewards.redeem", UDim2.new(1, -20, 0, 56), UDim2.new(0, 10, 1, -66), Kit.C.blue, function()
		local ok, msg = Net.request("RedeemCode", { code = box.Text })
		say(ok, msg)
		if ok then
			box.Text = ""
		end
	end)

	-- play time -----------------------------------------------------------------------------------
	local playTitle = Kit.text(content, "@rewards.playtime", UDim2.new(1, 0, 0, 30), UDim2.fromOffset(0, 180), Kit.C.ink, nil, 26)
	local rows: { { btn: TextButton, bar: Frame, label: TextLabel } } = {}
	local cellParts: { { cell: Frame, minutes: TextLabel, reward: TextLabel, track: Frame, label: TextLabel, btn: TextButton, x: number } } = {}
	local n = #Config.PlaytimeRewards
	for i, r in Config.PlaytimeRewards do
		local w = 1 / n
		local cell = Kit.frame(content, UDim2.new(w, -8, 0, 160), UDim2.new(w * (i - 1), 4, 0, 214), Kit.C.card)
		Kit.corner(cell, 14)
		Kit.stroke(cell, Color3.fromRGB(220, 210, 235), 3)
		local minutes = Kit.text(cell, "", UDim2.new(1, -10, 0, 26), UDim2.fromOffset(5, 4), Kit.C.ink, nil, 24)
		Kit.setText(minutes, "rewards.minutes", { n = r.minutes })
		local rewardText = Kit.text(cell, "", UDim2.new(1, -10, 0, 36), UDim2.fromOffset(5, 30), Color3.fromRGB(200, 140, 20), nil, 20)
		if r.freeSkips > 0 then
			Kit.setText(rewardText, "rewards.coins_skips", { coins = r.coins, n = r.freeSkips })
		else
			Kit.setText(rewardText, "rewards.coins", { coins = r.coins })
		end
		local track = Kit.frame(cell, UDim2.new(1, -16, 0, 8), UDim2.fromOffset(8, 70), Color3.fromRGB(230, 225, 240))
		Kit.corner(track, 5)
		local bar = Kit.frame(track, UDim2.fromScale(0, 1), UDim2.new(), Kit.C.green)
		Kit.corner(bar, 5)
		local label = Kit.text(cell, "", UDim2.new(1, -10, 0, 20), UDim2.fromOffset(5, 80), Color3.fromRGB(110, 105, 140), nil, 16)
		local btn = Kit.button(cell, "@rewards.claim", UDim2.new(1, -16, 0, 48), UDim2.new(0, 8, 1, -54), Kit.C.green, function()
			say(Net.request("ClaimPlaytime", { index = i }))
		end, nil, 20)
		rows[i] = { btn = btn, bar = bar, label = label }
		cellParts[i] = { cell = cell, minutes = minutes, reward = rewardText, track = track, label = label, btn = btn, x = w * (i - 1) }
	end

	-- Touch: wide, short panel (Kit.panel) -> shorter blocks, code box and Redeem on one row,
	-- and buttons >= 54 design px tall.
	Kit.onLayout(function(touch)
		local blockH = if touch then 120 else 170
		daily.Size = UDim2.new(0.5, -8, 0, blockH)
		codes.Size = UDim2.new(0.5, -8, 0, blockH)
		if touch then
			dailyTitle.Size = UDim2.new(1, -20, 0, 28)
			dailyTitle.Position = UDim2.fromOffset(10, 2)
			codesTitle.Size = UDim2.new(1, -20, 0, 28)
			codesTitle.Position = UDim2.fromOffset(10, 2)
			dailyInfo.Size = UDim2.new(1, -20, 0, 26)
			dailyInfo.Position = UDim2.fromOffset(10, 31)
			dailyBtn.Size = UDim2.new(1, -20, 0, 56)
			dailyBtn.Position = UDim2.new(0, 10, 1, -60)
			box.Size = UDim2.new(0.5, -14, 0, 56)
			box.Position = UDim2.new(0, 10, 1, -60)
			redeemBtn.Size = UDim2.new(0.5, -14, 0, 56)
			redeemBtn.Position = UDim2.new(0.5, 4, 1, -60)
		else
			dailyTitle.Size = UDim2.new(1, -20, 0, 34)
			dailyTitle.Position = UDim2.fromOffset(10, 8)
			codesTitle.Size = UDim2.new(1, -20, 0, 34)
			codesTitle.Position = UDim2.fromOffset(10, 8)
			dailyInfo.Size = UDim2.new(1, -20, 0, 50)
			dailyInfo.Position = UDim2.fromOffset(10, 44)
			dailyBtn.Size = UDim2.new(1, -20, 0, 56)
			dailyBtn.Position = UDim2.new(0, 10, 1, -66)
			box.Size = UDim2.new(1, -20, 0, 48)
			box.Position = UDim2.fromOffset(10, 46)
			redeemBtn.Size = UDim2.new(1, -20, 0, 56)
			redeemBtn.Position = UDim2.new(0, 10, 1, -66)
		end
		playTitle.Size = UDim2.new(1, 0, 0, if touch then 22 else 30)
		playTitle.Position = UDim2.fromOffset(0, if touch then 124 else 180)
		local w = 1 / #cellParts
		for i, c in cellParts do
			c.cell.Size = UDim2.new(w, -8, 0, if touch then 136 else 160)
			c.cell.Position = UDim2.new(w * (i - 1), 4, 0, if touch then 148 else 214)
			c.minutes.Size = UDim2.new(1, -10, 0, if touch then 24 else 26)
			c.minutes.Position = UDim2.fromOffset(5, if touch then 2 else 4)
			c.reward.Size = UDim2.new(1, -10, 0, if touch then 32 else 36)
			c.reward.Position = UDim2.fromOffset(5, if touch then 26 else 30)
			c.track.Position = UDim2.fromOffset(8, if touch then 57 else 70)
			c.label.Size = UDim2.new(1, -10, 0, if touch then 15 else 20)
			c.label.Position = UDim2.fromOffset(5, if touch then 64 else 80)
			c.btn.Size = UDim2.new(1, -16, 0, if touch then 54 else 48)
			c.btn.Position = UDim2.new(0, 8, 1, if touch then -56 else -54)
		end
	end)

	local function refresh()
		local s = Net.state
		local d = s.daily or {}
		local day = d.day or 1
		local amount = Config.DailyRewards[math.min(day, #Config.DailyRewards)]
		if Net.hasPass("VIP") then
			amount *= 2
		end
		if d.canClaim then
			Kit.setText(dailyInfo, "rewards.day_streak", { day = day, coins = amount })
			Kit.setText(dailyBtn, "rewards.claim_now")
			dailyBtn.BackgroundColor3 = Kit.C.green
		else
			Kit.setText(dailyInfo, "rewards.next_in", { time = Kit.formatTime((d.nextIn or 0) - (os.clock() - Net.stateAt)) })
			Kit.setText(dailyBtn, "rewards.claimed")
			dailyBtn.BackgroundColor3 = Kit.C.grey
		end
		local claimed = {}
		for _, i in (s.playClaimed or {}) :: { number } do
			claimed[i] = true
		end
		local played = Net.playSeconds()
		for i, r in Config.PlaytimeRewards do
			local row = rows[i]
			local need = r.minutes * 60
			local k = math.clamp(played / need, 0, 1)
			row.bar.Size = UDim2.fromScale(k, 1)
			if claimed[i] then
				Kit.setText(row.btn, "rewards.done")
				row.btn.BackgroundColor3 = Kit.C.grey
				Kit.setText(row.label, "rewards.claimed")
			elseif k >= 1 then
				Kit.setText(row.btn, "rewards.claim_now")
				row.btn.BackgroundColor3 = Kit.C.green
				Kit.setText(row.label, "rewards.ready")
			else
				Kit.setText(row.btn, "rewards.wait")
				row.btn.BackgroundColor3 = Kit.C.grey
				Kit.setRaw(row.label, Kit.formatTime(need - played))
			end
		end
	end

	Kit.onOpen("rewards", refresh)
	Net.changed:Connect(function()
		if Kit.current() == "rewards" then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if Kit.current() == "rewards" then
				refresh()
			end
		end
	end)
end

return RewardsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">SettingsPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Settings: coil toggles (speed / gravity; if the pass isn't owned the toggle offers it), the
-- visual-effects switch for slow devices, and the language picker.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(script.Parent.Parent.Net)
local Kit = require(script.Parent.Kit)
local Toast = require(script.Parent.Toast)
local Lang = require(script.Parent.Parent.Lang)
local Locale = require(ReplicatedStorage.Shared.Locale)

local SettingsPanel = {}

type Row = { key: string, pass: string?, title: string, desc: string }
local ROWS: { Row } = {
	{ key = "speedCoil", pass = "SpeedCoil", title = "@settings.speed", desc = "@settings.speed_desc" },
	{ key = "gravityCoil", pass = "GravityCoil", title = "@settings.gravity", desc = "@settings.gravity_desc" },
	{ key = "effects", pass = nil, title = "@settings.effects", desc = "@settings.effects_desc" },
}
local ROW_H = 64
local ROW_PITCH = 70
local LANG_TOP = #ROWS * ROW_PITCH -- 210
local LANG_H = 45
local LANG_PITCH = 49

local function isOn(row: Row): boolean
	local settings = Net.state.settings or {}
	-- effects default to on (profiles saved before the switch existed have no value yet)
	return if row.key == "effects" then settings.effects ~= false else settings[row.key] == true
end

function SettingsPanel.init()
	local content = Kit.panel("settings", "@panel.settings", Kit.C.grey)
	local buttons: { [string]: TextButton } = {}
	local cards: { Frame } = {}
	local labels: { TextLabel } = {}
	for i, row in ROWS do
		local card = Kit.frame(content, UDim2.new(1, 0, 0, ROW_H), UDim2.fromOffset(0, (i - 1) * ROW_PITCH), Kit.C.card)
		cards[i] = card
		Kit.corner(card, 16)
		Kit.stroke(card, Color3.fromRGB(220, 210, 235), 3)
		local t = Kit.text(card, row.title, UDim2.new(1, -196, 0, 30), UDim2.fromOffset(18, 4), Kit.C.ink, nil, 27)
		t.TextXAlignment = Enum.TextXAlignment.Left
		labels[#labels + 1] = t
		local d = Kit.text(card, row.desc, UDim2.new(1, -196, 0, 22), UDim2.fromOffset(18, 36), Color3.fromRGB(110, 105, 140), nil, 18)
		d.TextXAlignment = Enum.TextXAlignment.Left
		labels[#labels + 1] = d
		local pass = row.pass
		buttons[row.key] = Kit.button(card, "", UDim2.fromOffset(160, 50), UDim2.new(1, -10, 0.5, 0), Kit.C.green, function()
			if pass and not Net.hasPass(pass) then
				local id = Config.Passes[pass] or 0
				if id ~= 0 then
					MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, id)
				else
					Toast.show(Lang.t("toast.pass_not_on_sale"), "info")
				end
				return
			end
			local ok, msg = Net.request("SetSetting", { key = row.key, value = not isOn(row) })
			if not ok and msg then
				Toast.show(msg, "error")
			end
		end, Vector2.new(1, 0.5), 26)
		buttons[row.key].Name = "Toggle_" .. row.key
	end

	-- language picker: 4 x 3 grid of flag + native name (saved in the profile, applied live)
	local langTitle = Kit.text(content, "@settings.language", UDim2.new(1, 0, 0, 22), UDim2.fromOffset(0, LANG_TOP - 1), Kit.C.ink, nil, 22)
	langTitle.TextXAlignment = Enum.TextXAlignment.Left
	local langButtons: { [string]: TextButton } = {}
	for i, code in Locale.LANGS do
		local col, row = (i - 1) % 4, (i - 1) // 4
		local info = Locale.NATIVE[code]
		local b = Kit.button(content, info.flag .. " " .. info.name, UDim2.new(0.25, -6, 0, LANG_H), UDim2.new(col * 0.25, col * 2, 0, LANG_TOP + 22 + row * LANG_PITCH), Kit.C.blue, function()
			local ok, msg = Net.request("SetLanguage", { lang = code })
			if ok then
				Toast.show(Lang.t("toast.language", { name = info.name }), "success")
			elseif msg then
				Toast.show(msg, "error")
			end
		end, nil, 20)
		b.Name = "Lang_" .. code
		langButtons[code] = b
	end

	-- Touch: the panel is a wide, short box (see Kit.panel), so the coils sit side by side and
	-- the 12 languages go in 6 columns; every button is >= 54 design px tall.
	Kit.onLayout(function(touch)
		for i, card in cards do
			if touch then
				local half = i <= 2
				card.Size = UDim2.new(if half then 0.5 else 1, if half then -4 else 0, 0, ROW_H)
				card.Position = UDim2.new(if i == 2 then 0.5 else 0, if i == 2 then 4 else 0, 0, if i == 3 then ROW_PITCH else 0)
			else
				card.Size = UDim2.new(1, 0, 0, ROW_H)
				card.Position = UDim2.fromOffset(0, (i - 1) * ROW_PITCH)
			end
		end
		for i, row in ROWS do
			local b = buttons[row.key]
			b.Size = if touch then UDim2.fromOffset(132, 56) else UDim2.fromOffset(160, 50)
		end
		for i, l in labels do
			l.Size = UDim2.new(1, if touch then -(132 + 40) else -196, 0, l.Size.Y.Offset)
		end
		local top = if touch then 2 * ROW_PITCH + 6 else LANG_TOP
		langTitle.Position = UDim2.fromOffset(0, top - 1)
		for i, code in Locale.LANGS do
			local b = langButtons[code]
			local col, r = (i - 1) % (if touch then 6 else 4), (i - 1) // (if touch then 6 else 4)
			if touch then
				b.Size = UDim2.new(1 / 6, -6, 0, 54)
				b.Position = UDim2.new(col / 6, col, 0, top + 24 + r * 60)
			else
				b.Size = UDim2.new(0.25, -6, 0, LANG_H)
				b.Position = UDim2.new(col * 0.25, col * 2, 0, LANG_TOP + 22 + r * LANG_PITCH)
			end
		end
	end)

	local function refresh()
		for code, b in langButtons do
			b.BackgroundColor3 = if code == Lang.code then Kit.C.green else Kit.C.blue
		end
		for _, row in ROWS do
			local b = buttons[row.key]
			if row.pass and not Net.hasPass(row.pass) then
				Kit.setText(b, "settings.get_pass")
				b.BackgroundColor3 = Kit.C.yellow
			elseif isOn(row) then
				Kit.setText(b, "settings.on")
				b.BackgroundColor3 = Kit.C.green
			else
				Kit.setText(b, "settings.off")
				b.BackgroundColor3 = Kit.C.red
			end
		end
	end
	Kit.onOpen("settings", refresh)
	Net.changed:Connect(refresh)
	Lang.changed:Connect(refresh)
end

return SettingsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Coins shop: trails and effects. Buying/equipping is validated by the server.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(script.Parent.Parent.Net)
local Kit = require(script.Parent.Kit)
local Toast = require(script.Parent.Toast)
local Lang = require(script.Parent.Parent.Lang)

local ShopPanel = {}

local function colorSeq(colors: { Color3 }): ColorSequence
	if #colors == 1 then
		return ColorSequence.new(colors[1])
	end
	local kps = {}
	for i, c in colors do
		table.insert(kps, ColorSequenceKeypoint.new((i - 1) / (#colors - 1), c))
	end
	return ColorSequence.new(kps)
end

type Txt = { key: string, args: { [string]: any }? }
local function T(key: string, args: { [string]: any }?): Txt
	return { key = key, args = args }
end

local function card(grid: Instance, order: number, name: Txt, colors: { Color3 }, buttonText: Txt, buttonColor: Color3, onClick: () -> ())
	local c = Kit.card(grid, order)
	local swatch = Kit.frame(c, UDim2.new(1, -20, 0, 70), UDim2.fromOffset(10, 10), Color3.new(1, 1, 1))
	Kit.corner(swatch, 12)
	local g = Instance.new("UIGradient")
	g.Color = colorSeq(colors)
	g.Parent = swatch
	local label = Kit.text(c, "", UDim2.new(1, -16, 0, 30), UDim2.fromOffset(8, 84), Kit.C.ink, nil, 26)
	Kit.setText(label, name.key, name.args)
	local btn = Kit.button(c, "", UDim2.new(1, -20, 0, 54), UDim2.new(0, 10, 1, -62), buttonColor, onClick, nil, 24)
	Kit.setText(btn, buttonText.key, buttonText.args)
end

local function act(action: string, id: string)
	local ok, msg = Net.request(action, { id = id })
	if msg then
		Toast.show(msg, if ok then "success" else "error")
	end
end

function ShopPanel.init()
	local content = Kit.panel("shop", "@panel.shop", Kit.C.pink)
	local tab = "trails"
	local grid = Kit.grid(content, Vector2.new(180, 200), UDim2.new(1, 0, 1, -64), UDim2.fromOffset(0, 64))
	local tabs: { [string]: TextButton } = {}

	local function rebuild()
		for _, c in grid:GetChildren() do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		local s = Net.state
		local owned = (s.trails or {}) :: { [string]: boolean }
		local ownedFx = (s.effects or {}) :: { [string]: boolean }
		for name, b in tabs do
			b.BackgroundColor3 = if name == tab then Kit.C.pink else Kit.C.grey
		end
		if tab == "trails" then
			local order = 0
			if (s.wins or 0) > 0 then
				local w = s.wins :: number
				local col = Config.RebirthColors[((w - 1) % #Config.RebirthColors) + 1]
				local equipped = s.equippedTrail == "rebirth"
				card(grid, order, T("shop.rebirth", { n = w }), { col, col:Lerp(Color3.new(1, 1, 1), 0.5) }, T(if equipped then "shop.unequip" else "shop.equip"), if equipped then Kit.C.grey else Kit.C.blue, function()
					act("EquipTrail", "rebirth")
				end)
			end
			for i, t in Config.Trails do
				order = i
				local equipped = s.equippedTrail == t.id
				if t.pass then
					local has = Net.hasPass(t.pass)
					card(grid, order, T("trail." .. t.id), t.colors, T(if not has then "shop.vip_only" elseif equipped then "shop.unequip" else "shop.equip"), if has then (if equipped then Kit.C.grey else Kit.C.blue) else Kit.C.yellow, function()
						if has then
							act("EquipTrail", t.id)
						else
							Kit.open("store")
						end
					end)
				elseif t.exclusive and not owned[t.id] then
					-- Starter Pack / group exclusives are never sold for coins
					local starter = t.exclusive == "StarterPack"
					local label = if starter then "shop.starter_only" elseif t.exclusive == "Gift" then "shop.gift_only" elseif t.exclusive == "Lounge" then "shop.lounge_only" else "shop.group_only"
					card(grid, order, T("trail." .. t.id), t.colors, T(label), Kit.C.grey, function()
						local st = Net.state.starter
						if starter and type(st) == "table" and st.available then
							Kit.open("starter")
						end
					end)
				elseif owned[t.id] then
					card(grid, order, T("trail." .. t.id), t.colors, T(if equipped then "shop.unequip" else "shop.equip"), if equipped then Kit.C.grey else Kit.C.blue, function()
						act("EquipTrail", t.id)
					end)
				else
					card(grid, order, T("trail." .. t.id), t.colors, T("shop.price", { price = Kit.formatNumber(t.price) }), Kit.C.green, function()
						act("BuyTrail", t.id)
					end)
				end
			end
		else
			for i, e in Config.Effects do
				local equipped = s.equippedEffect == e.id
				local colors = { e.color, e.color:Lerp(Color3.new(1, 1, 1), 0.6) }
				if e.exclusive and not ownedFx[e.id] then
					-- tower gifts and lounge items are earned, never sold
					card(grid, i, T("effect." .. e.id), colors, T(if e.exclusive == "Gift" then "shop.gift_only" else "shop.lounge_only"), Kit.C.grey, function() end)
				elseif ownedFx[e.id] then
					card(grid, i, T("effect." .. e.id), colors, T(if equipped then "shop.unequip" else "shop.equip"), if equipped then Kit.C.grey else Kit.C.blue, function()
						act("EquipEffect", e.id)
					end)
				else
					card(grid, i, T("effect." .. e.id), colors, T("shop.price", { price = Kit.formatNumber(e.price) }), Kit.C.green, function()
						act("BuyEffect", e.id)
					end)
				end
			end
		end
	end

	tabs.trails = Kit.button(content, "@shop.trails", UDim2.fromOffset(160, 54), UDim2.fromOffset(0, 0), Kit.C.pink, function()
		tab = "trails"
		rebuild()
	end)
	tabs.effects = Kit.button(content, "@shop.effects", UDim2.fromOffset(160, 54), UDim2.fromOffset(172, 0), Kit.C.grey, function()
		tab = "effects"
		rebuild()
	end)
	local coins = Kit.text(content, "", UDim2.fromOffset(250, 40), UDim2.new(1, 0, 0, 3), Kit.C.ink, Vector2.new(1, 0), 30)
	coins.TextXAlignment = Enum.TextXAlignment.Right

	Kit.onOpen("shop", rebuild)
	Lang.changed:Connect(function()
		if Kit.current() == "shop" then
			rebuild()
		end
	end)
	Net.changed:Connect(function()
		Kit.setText(coins, "shop.price", { price = Kit.formatNumber(Net.state.coins or 0) })
		if Kit.current() == "shop" then
			rebuild()
		end
	end)
end

return ShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">StarterPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Starter Pack (P0-4): one-time popup when a first-day player reaches stage 3, and a panel behind
-- the pulsing menu button while the pack is on sale (product id set, not bought, first 24 h).
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(script.Parent.Parent.Net)
local Kit = require(script.Parent.Kit)
local Hud = require(script.Parent.Hud)

local StarterPanel = {}

local popupShown = false

local function available(): boolean
	local st = Net.state.starter
	return type(st) == "table" and st.available == true
end

function StarterPanel.init()
	local content = Kit.panel("starter", "@starter.title", Kit.C.red)
	local badge = Kit.frame(content, UDim2.fromOffset(150, 150), UDim2.fromOffset(10, 10), Kit.C.yellow)
	Kit.corner(badge, 75)
	Kit.stroke(badge, Kit.darker(Kit.C.yellow, 0.45), 4)
	badge.Rotation = -8
	local badgeText = Kit.bold(badge, "", UDim2.fromScale(0.9, 0.5), UDim2.fromScale(0.05, 0.25), Kit.C.white, nil, 56)
	local was = Kit.text(content, "", UDim2.new(1, -190, 0, 36), UDim2.fromOffset(180, 16), Color3.fromRGB(150, 140, 170), nil, 30)
	was.TextXAlignment = Enum.TextXAlignment.Left
	local items = Kit.text(content, "", UDim2.new(1, -190, 0, 96), UDim2.fromOffset(180, 58), Kit.C.ink, nil, 28)
	items.TextXAlignment = Enum.TextXAlignment.Left
	items.TextWrapped = true
	local ends = Kit.text(content, "", UDim2.new(1, 0, 0, 34), UDim2.fromOffset(0, 190), Kit.C.red, nil, 28)
	local buy = Kit.button(content, "", UDim2.fromOffset(340, 76), UDim2.new(0.5, 0, 1, -86), Kit.C.green, function()
		if Config.Products.StarterPack ~= 0 then
			MarketplaceService:PromptProductPurchase(Players.LocalPlayer, Config.Products.StarterPack)
		end
	end, Vector2.new(0.5, 0), 34)
	buy.Name = "Buy"

	local function refresh()
		-- the crossed-out value and the % are computed from the list prices (Shared/Pricing)
		Kit.setText(was, "starter.was", { price = Config.StarterPackAnchorPrice })
		Kit.setText(badgeText, "starter.discount", { pct = Config.StarterPackDiscountPct })
		Kit.setText(items, "starter.items", { n = Config.StarterPackSkips, coins = Config.StarterPackCoins, minutes = Config.StarterBoostSeconds // 60 })
		local price = Hud.priceOf(Config.Products.StarterPack)
		if price then
			Kit.setText(buy, "starter.buy", { price = price })
		else
			Kit.setText(buy, "starter.buy_noprice")
		end
		local st = Net.state.starter
		local left = if type(st) == "table" then (tonumber(st.endsAt) or 0) - os.time() else 0
		Kit.setText(ends, "starter.ends", { time = Kit.formatTime(left) })
	end
	Kit.onOpen("starter", refresh)
	Hud.fetchPrice(Config.Products.StarterPack, function()
		refresh()
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if Kit.current() == "starter" then
				if not available() then
					Kit.close()
				else
					refresh()
				end
			end
		end
	end)
	-- one-time popup at stage 3 during the first day
	Net.changed:Connect(function(new)
		if popupShown or not available() then
			return
		end
		local st = new.starter
		if (new.stage or 0) >= 3 and type(st) == "table" and st.firstSession and Kit.current() == nil then
			popupShown = true
			Kit.open("starter")
		end
	end)
end

return StarterPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">StorePanel</string>
              <string name="Source"><![CDATA[--!strict
-- Robux store: developer products and game passes. IDs of 0 are hidden.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Pricing = require(ReplicatedStorage.Shared.Pricing)
local Net = require(script.Parent.Parent.Net)
local Kit = require(script.Parent.Kit)

local StorePanel = {}

type Item = { key: string, name: string, desc: string, icon: string, color: Color3, isPass: boolean }

local ITEMS: { Item } = {
	{ key = "SkipStage", name = "Skip Stage", desc = "Jump to the next checkpoint", icon = "⏭", color = Kit.C.green, isPass = false },
	{ key = "Skip10", name = "Skip 10 Stages", desc = "Leap 10 checkpoints ahead", icon = "🚀", color = Kit.C.blue, isPass = false },
	{ key = "DoubleJump5", name = "Double Jump 5 min", desc = "Extra air jump for 5 minutes", icon = "⏫", color = Kit.C.green, isPass = false },
	{ key = "VIP", name = "VIP", desc = "[VIP] tag, gold trail, +50% coins, 2x daily", icon = "👑", color = Kit.C.yellow, isPass = true },
	{ key = "SpeedCoil", name = "Speed Coil", desc = "Run 50% faster (toggle)", icon = "⚡", color = Kit.C.orange, isPass = true },
	{ key = "GravityCoil", name = "Gravity Coil", desc = "Floaty low-gravity jumps (toggle)", icon = "🪐", color = Kit.C.purple, isPass = true },
	{ key = "Fusion", name = "Fusion Coil", desc = "Speed + Gravity coils in one", icon = "🌀", color = Kit.C.blue, isPass = true },
	{ key = "DoubleJump", name = "Double Jump", desc = "One extra jump in the air, for ever", icon = "⏫", color = Kit.C.green, isPass = true },
	{ key = "InfiniteRevives", name = "Infinite Revives", desc = "Unlimited pocket checkpoints", icon = "📍", color = Kit.C.orange, isPass = true },
	{ key = "DoubleCoins", name = "2x Coins", desc = "Double coins forever", icon = "💰", color = Kit.C.yellow, isPass = true },
	{ key = "Coins500", name = "500 Coins", desc = "Coin pack", icon = "💰", color = Kit.C.pink, isPass = false },
	{ key = "Coins2500", name = "2,500 Coins", desc = "Big coin pack", icon = "💰", color = Kit.C.pink, isPass = false },
	{ key = "Coins7000", name = "7,000 Coins", desc = "Mega coin pack", icon = "💰", color = Kit.C.pink, isPass = false },
}

local prices: { [number]: number } = {}

local function idOf(item: Item): number
	if item.isPass then
		return Config.Passes[item.key] or 0
	end
	if item.key == "SkipStage" then
		-- 19 R$ up to level 300, 29 R$ above (falls back to the other id while one is not created)
		local s = Net.state
		return Pricing.skipProductId(Config.Products, s.at or s.stage or 0)
	end
	return Config.Products[item.key] or 0
end

-- Already yours (or pointless to sell): passes you own, Fusion when you own both coils, and the
-- 5-minute double jump when the permanent pass is yours.
local function isOwned(item: Item): boolean
	if item.key == "Fusion" then
		return Net.hasPass("Fusion") or (Net.hasPass("SpeedCoil") and Net.hasPass("GravityCoil"))
	end
	if item.key == "DoubleJump5" then
		return Net.hasPass("DoubleJump")
	end
	return item.isPass and Net.hasPass(item.key)
end

function StorePanel.init()
	local content = Kit.panel("store", "@panel.store", Kit.C.green)
	local grid = Kit.grid(content, Vector2.new(280, 132))
	local empty = Kit.text(content, "@store.empty", UDim2.fromScale(1, 0.4), UDim2.fromScale(0, 0.3), Kit.C.ink, nil, 28)

	local function rebuild()
		for _, c in grid:GetChildren() do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		local count = 0
		for i, item in ITEMS do
			local id = idOf(item)
			if id ~= 0 then
				count += 1
				local c = Kit.card(grid, i)
				local iconBg = Kit.frame(c, UDim2.fromOffset(80, 80), UDim2.fromOffset(12, 20), item.color)
				Kit.corner(iconBg, 18)
				Kit.icon(iconBg, item.icon, UDim2.fromScale(0.8, 0.8), UDim2.fromScale(0.1, 0.1), Kit.C.white, nil, 50)
				local title = Kit.text(c, "@store." .. item.key .. ".name", UDim2.fromOffset(170, 30), UDim2.fromOffset(102, 10), Kit.C.ink, nil, 26)
				title.TextXAlignment = Enum.TextXAlignment.Left
				local desc = Kit.text(c, "@store." .. item.key .. ".desc", UDim2.fromOffset(170, 30), UDim2.fromOffset(102, 40), Color3.fromRGB(110, 105, 140), nil, 16)
				desc.TextXAlignment = Enum.TextXAlignment.Left
				local owned = isOwned(item)
				local btn = Kit.button(c, "", UDim2.fromOffset(166, 52), UDim2.fromOffset(102, 72), if owned then Kit.C.grey else Kit.C.green, function()
					if owned then
						return
					end
					if item.isPass then
						MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, id)
					else
						MarketplaceService:PromptProductPurchase(Players.LocalPlayer, id)
					end
				end, nil, 22)
				if owned then
					Kit.setText(btn, "store.owned")
				elseif prices[id] then
					Kit.setText(btn, "hud.price", { price = prices[id] })
				else
					Kit.setText(btn, "store.buy")
				end
				if not prices[id] and not owned then
					task.spawn(function()
						local ok, info = pcall(function()
							return MarketplaceService:GetProductInfo(id, if item.isPass then Enum.InfoType.GamePass else Enum.InfoType.Product)
						end)
						if ok and info and info.PriceInRobux then
							prices[id] = info.PriceInRobux
							Kit.setText(btn, "hud.price", { price = info.PriceInRobux })
						end
					end)
				end
			end
		end
		empty.Visible = count == 0
	end

	Kit.onOpen("store", rebuild)
	Net.changed:Connect(function()
		if Kit.current() == "store" then
			rebuild()
		end
	end)
end

return StorePanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">Toast</string>
              <string name="Source"><![CDATA[--!strict
-- Stacked toast notifications at the top of the screen.
local TweenService = game:GetService("TweenService")

local Kit = require(script.Parent.Kit)

local Toast = {}

local region: Frame? = nil
local COLORS: { [string]: Color3 } = {
	info = Kit.C.blue,
	success = Kit.C.green,
	warn = Kit.C.orange,
	error = Kit.C.red,
	coins = Kit.C.yellow,
}

local function getRegion(): Frame
	if region then
		return region
	end
	local r = Kit.region("Toasts", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 100), Vector2.new(520, 220))
	r.ZIndex = 20
	Kit.onLayout(function()
		r.Position = UDim2.new(0.5, 0, 0, Kit.hudTop + Kit.cardInset + 6) -- under the timer (and the offer strip)
	end)
	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.Padding = UDim.new(0, 8)
	list.Parent = r
	region = r
	return r
end

local order = 0
function Toast.show(text: string, kind: string?)
	local r = getRegion()
	order += 1
	local color = COLORS[kind or "info"] or Kit.C.blue
	local f = Kit.frame(r, UDim2.fromOffset(460, 50), UDim2.new(), color)
	f.LayoutOrder = order
	Kit.corner(f, 25)
	Kit.stroke(f, Kit.darker(color, 0.45), 3)
	Kit.gradient(f, Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 210))
	local label = Kit.bold(f, text, UDim2.new(1, -24, 1, -10), UDim2.fromOffset(12, 5), Kit.C.white, nil, 26)
	Kit.pop(f, 0.5)
	task.delay(3, function()
		local ti = TweenInfo.new(0.35)
		TweenService:Create(f, ti, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(label, ti, { TextTransparency = 1 }):Play()
		local st = f:FindFirstChildOfClass("UIStroke")
		if st then
			TweenService:Create(st, ti, { Transparency = 1 }):Play()
		end
		local ls = label:FindFirstChildOfClass("UIStroke")
		if ls then
			TweenService:Create(ls, ti, { Transparency = 1 }):Play()
		end
		task.wait(0.4)
		f:Destroy()
	end)
	-- keep at most 4
	local kids = {}
	for _, c in r:GetChildren() do
		if c:IsA("Frame") then
			table.insert(kids, c)
		end
	end
	if #kids > 4 then
		table.sort(kids, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		kids[1]:Destroy()
	end
end

return Toast
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">TravelPanel</string>
              <string name="Source"><![CDATA[--!strict
-- The lounge teleporter: one button per world you have already reached (the first pad of every
-- 10 stages, up to your best stage) plus the lobby. Opened by the teleporter pedestal in the
-- Winner's Lounge; the server validates the destination (Shared/Perks.canTravel).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Layout = require(ReplicatedStorage.Shared.Layout)
local Perks = require(ReplicatedStorage.Shared.Perks)
local Net = require(script.Parent.Parent.Net)
local Kit = require(script.Parent.Kit)
local Toast = require(script.Parent.Toast)
local Progress = require(script.Parent.Progress)

local TravelPanel = {}

function TravelPanel.init()
	local content = Kit.panel("travel", "@panel.travel", Kit.C.purple)
	local grid = Kit.grid(content, Vector2.new(140, 60))
	local builtFor = -1

	local function rebuild()
		local best = tonumber(Net.state.best) or 0
		if best == builtFor then
			return
		end
		builtFor = best
		for _, c in grid:GetChildren() do
			if c:IsA("GuiButton") then
				c:Destroy()
			end
		end
		for i, target in Perks.travelTargets(best) do
			local color = Kit.C.grey
			if target > 0 then
				color = Progress.WORLD_COLORS[Layout.themeFor(math.min(target + 1, Layout.TOTAL))]
			end
			local b = Kit.button(grid, "", UDim2.fromOffset(140, 60), UDim2.new(), color, function()
				local ok, msg = Net.request("Travel", { stage = target })
				if ok then
					Kit.close()
				elseif msg then
					Toast.show(msg, "info")
				end
			end, nil, 20)
			b.Name = "To_" .. target
			b.LayoutOrder = i
			if target == 0 then
				Kit.setText(b, "travel.lobby")
			else
				Kit.setText(b, "travel.world", { n = target // 10 + 1, stage = target })
			end
		end
	end
	Kit.onOpen("travel", rebuild)
	Net.changed:Connect(function()
		if Kit.current() == "travel" then
			rebuild()
		end
	end)
end

return TravelPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">WinPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Shown when you reach stage 100 (or use the pedestal in the victory room): take the portal,
-- rebirth (what you lose in red next to what you keep in green) or stay.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(script.Parent.Parent.Net)
local Kit = require(script.Parent.Kit)
local Toast = require(script.Parent.Toast)

local WinPanel = {}

function WinPanel.init()
	local content = Kit.panel("win", "@panel.win", Kit.C.yellow)
	local title = Kit.bold(content, "", UDim2.new(1, 0, 0, 50), UDim2.fromOffset(0, 0), Kit.C.yellow, nil, 46)
	-- what a rebirth costs and what it keeps, side by side: red = you lose, green = you keep
	local function column(name: string, x: number, color: Color3, headKey: string, listKey: string): Frame
		local card = Kit.frame(content, UDim2.new(0.5, -6, 0, 160), UDim2.new(x, if x > 0 then 6 else 0, 0, 56), color:Lerp(Color3.new(1, 1, 1), 0.82))
		card.Name = name
		Kit.corner(card, 16)
		Kit.stroke(card, color, 3)
		local head = Kit.frame(card, UDim2.new(1, 0, 0, 40), UDim2.new(), color)
		Kit.corner(head, 16)
		Kit.bold(head, headKey, UDim2.new(1, -16, 1, -8), UDim2.fromOffset(8, 4), Kit.C.white, nil, 26)
		local list = Kit.text(card, listKey, UDim2.new(1, -24, 1, -88), UDim2.fromOffset(12, 46), Kit.C.ink, nil, 22)
		list.Name = "List"
		list.TextWrapped = true
		return card
	end
	local lose = column("Lose", 0, Kit.C.red, "@win.lose", "@win.lose_list")
	local gain = column("Gain", 0.5, Kit.C.green, "@win.gain", "@win.gain_list")
	local swatch = Kit.frame(gain, UDim2.new(1, -60, 0, 22), UDim2.new(0.5, 0, 1, -32), Kit.C.pink, Vector2.new(0.5, 0))
	swatch.Name = "NextTrail"
	Kit.corner(swatch, 11)
	Kit.stroke(swatch, Kit.C.ink, 2)
	local rebirth = Kit.button(content, "@win.rebirth", UDim2.fromOffset(330, 66), UDim2.new(0.5, -105, 1, -68), Kit.C.green, function()
		local ok, msg = Net.request("Rebirth")
		if ok then
			Kit.close()
		elseif msg then
			Toast.show(msg, "error")
		end
	end, Vector2.new(0.5, 0), 30)
	local stay = Kit.button(content, "@win.stay", UDim2.fromOffset(200, 66), UDim2.new(0.5, 170, 1, -68), Kit.C.grey, function()
		Kit.close()
	end, Vector2.new(0.5, 0), 28)
	-- the way on: 900 more stages behind the portal
	local portal = Kit.button(content, "@win.portal", UDim2.fromOffset(540, 56), UDim2.new(0.5, 0, 1, -134), Kit.C.purple, function()
		local ok, msg = Net.request("EnterPortal")
		if ok then
			Kit.close()
		elseif msg then
			Toast.show(msg, "info")
		end
	end, Vector2.new(0.5, 0), 28)
	portal.Name = "Portal"

	-- Touch: short, wide panel (Kit.panel): slimmer cards, buttons 58 tall, all inside the content.
	Kit.onLayout(function(touch)
		for _, card in { lose, gain } do
			card.Size = UDim2.new(0.5, -6, 0, if touch then 114 else 160)
			card.Position = UDim2.new(if card == gain then 0.5 else 0, if card == gain then 6 else 0, 0, if touch then 44 else 56)
			local list = card:FindFirstChild("List") :: TextLabel
			list.Size = UDim2.new(1, -24, 1, if touch then -76 else -88)
			list.Position = UDim2.fromOffset(12, if touch then 42 else 46)
		end
		title.Size = UDim2.new(1, 0, 0, if touch then 42 else 50)
		swatch.Size = UDim2.new(1, -60, 0, if touch then 18 else 22)
		swatch.Position = UDim2.new(0.5, 0, 1, if touch then -26 else -32)
		rebirth.Size = UDim2.fromOffset(330, if touch then 58 else 66)
		rebirth.Position = UDim2.new(0.5, -105, 1, if touch then -58 else -68)
		stay.Size = UDim2.fromOffset(200, if touch then 58 else 66)
		stay.Position = UDim2.new(0.5, 170, 1, if touch then -58 else -68)
		portal.Size = UDim2.fromOffset(540, if touch then 54 else 56)
		portal.Position = UDim2.new(0.5, 0, 1, if touch then -116 else -134)
	end)

	Kit.onOpen("win", function()
		local wins = Net.state.wins or 0
		local nextColor = Config.RebirthColors[((math.max(wins, 1) - 1) % #Config.RebirthColors) + 1]
		Kit.setText(title, "win.wins", { n = wins })
		swatch.BackgroundColor3 = nextColor
		local at = tonumber(Net.state.at) or 0
		portal.Visible = at > 0 and at % 100 == 0 and at < 1000 and Net.state.base ~= true
	end)
end

return WinPanel
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="81">
          <Properties>
            <string name="Name">World</string>
          </Properties>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">Atmos</string>
              <string name="Source"><![CDATA[--!strict
-- The sky follows your height. Every world has a lighting profile (Shared/Ambience.luau: time of
-- day, atmosphere, colour grading, bloom, sun rays, stars); this module samples the camera height
-- a few times per second, blends the neighbouring profiles around each world boundary and eases
-- Lighting towards the result. Lighting changes made on a client are local, so every player sees
-- the sky of the world they are in.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Ambience = require(ReplicatedStorage.Shared.Ambience)
local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.Layout)
local TowerStyle = require(ReplicatedStorage.Shared.TowerStyle)

local Atmos = {}

Atmos.world = 1 -- world LOOK (1..10, index of Ambience.Profiles / Config.Themes) that dominates at the camera
Atmos.tower = 1 -- tower the camera is at
local worldChanged = Instance.new("BindableEvent")
Atmos.worldChanged = worldChanged.Event -- fires (world)

local bounds: { number } = {}

-- Per tower: the heights of its world boundaries and its ten sky profiles in climbing order
-- (each world's profile seen through the tower's mood). Built the first time the camera gets there.
type TowerSky = { bounds: { number }, profiles: { Ambience.Profile }, styles: { number } }
local skies: { [number]: TowerSky } = {}

local function skyOf(tower: number): TowerSky
	local known = skies[tower]
	if known then
		return known
	end
	local map = Layout.generate(Config.MapSeed, tower)
	local padY: { [number]: number } = {}
	for k, p in map.pads do
		padY[k] = p.y
	end
	local mood = TowerStyle.mood(tower)
	local profiles, styles = {}, {}
	for slot = 1, 10 do
		local style = Layout.themeFor((tower - 1) * Layout.STAGES + (slot - 1) * 10 + 1)
		styles[slot] = style
		profiles[slot] = Ambience.grade(Ambience.Profiles[style], mood :: any)
	end
	local sky: TowerSky = { bounds = Ambience.bounds(padY), profiles = profiles, styles = styles }
	skies[tower] = sky
	return sky
end

-- Tower whose axis is nearest to a world X coordinate.
function Atmos.towerAt(x: number): number
	return math.clamp(math.floor(x / Layout.TOWER_SPACING + 0.5) + 1, 1, Layout.TOWERS)
end
local bloom: BloomEffect? = nil
local rays: SunRaysEffect? = nil
local effectsOn = true
local lite = false

local function c3(v: Ambience.RGB): Color3
	return Color3.fromRGB(math.floor(v[1] + 0.5), math.floor(v[2] + 0.5), math.floor(v[3] + 0.5))
end

local function ensure(className: string): Instance
	local found = Lighting:FindFirstChildOfClass(className)
	if found then
		return found
	end
	local inst = Instance.new(className)
	inst.Parent = Lighting
	return inst
end

-- World boundaries (heights), for other client modules.
function Atmos.bounds(): { number }
	return bounds
end

-- Bloom and sun rays can be switched off (Settings -> Effects) on slow devices.
local function applyEffects()
	local on = effectsOn and not lite
	if bloom then
		bloom.Enabled = on
	end
	if rays then
		rays.Enabled = on
	end
end

function Atmos.setEffects(on: boolean)
	effectsOn = on
	applyEffects()
end

-- Lite profile (Quality.isLite): no bloom / sun rays. The sky, the fog colour and the colour
-- grade stay: they are what tells the worlds apart.
function Atmos.setLite(on: boolean)
	lite = on
	applyEffects()
end

function Atmos.init()
	bounds = skyOf(1).bounds

	local atm = ensure("Atmosphere") :: Atmosphere
	local cc = ensure("ColorCorrectionEffect") :: ColorCorrectionEffect
	local bl = ensure("BloomEffect") :: BloomEffect
	local sr = ensure("SunRaysEffect") :: SunRaysEffect
	local sky = ensure("Sky") :: Sky
	bloom, rays = bl, sr
	bl.Enabled = effectsOn and not lite
	sr.Enabled = effectsOn and not lite
	sr.Spread = 0.6

	local function apply(p: Ambience.Profile)
		Lighting.ClockTime = p.clock
		Lighting.Brightness = p.brightness
		Lighting.ExposureCompensation = p.exposure
		Lighting.Ambient = c3(p.ambient)
		Lighting.OutdoorAmbient = c3(p.outdoor)
		atm.Density = p.density
		atm.Haze = p.haze
		atm.Glare = p.glare
		atm.Color = c3(p.atmColor)
		atm.Decay = c3(p.atmDecay)
		cc.TintColor = c3(p.tint)
		cc.Saturation = p.saturation
		cc.Contrast = p.contrast
		bl.Intensity = p.bloom
		bl.Size = p.bloomSize
		bl.Threshold = p.bloomThreshold
		sr.Intensity = p.rays
		sky.StarCount = math.floor(p.stars)
	end

	local current: Ambience.Profile = Ambience.Profiles[1]
	local applied: Ambience.Profile? = nil
	local sameTargetFor = 0
	local lastTarget: Ambience.Profile? = nil
	local acc = 0
	apply(current)
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 1 / 15 then
			return
		end
		local step = acc
		acc = 0
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		local y = cam.CFrame.Position.Y
		local tower = Atmos.towerAt(cam.CFrame.Position.X)
		local sky = skyOf(tower)
		bounds = sky.bounds
		local target = Ambience.sample(y, sky.bounds, sky.profiles)
		local world = sky.styles[Ambience.worldAt(y, sky.bounds)]
		if world ~= Atmos.world or tower ~= Atmos.tower then
			Atmos.world = world
			Atmos.tower = tower
			worldChanged:Fire(world)
		end
		-- Outside the blend zones `target` is the profile table itself: once we have eased onto
		-- it for a while, snap and stop touching Lighting until the target changes.
		if target == lastTarget then
			sameTargetFor += step
		else
			sameTargetFor = 0
			lastTarget = target
		end
		if sameTargetFor > 3 then
			if applied ~= target then
				current = target
				applied = target
				apply(target)
			end
			return
		end
		current = Ambience.mix(current, target, 1 - math.exp(-step * 2.5))
		applied = nil
		apply(current)
	end)
end

return Atmos
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">ChatTags</string>
              <string name="Source"><![CDATA[--!strict
-- Chat prefixes: [VIP] for pass owners, [N Wins] for tower winners (TextChatService).
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local Lang = require(script.Parent.Parent.Lang)

local ChatTags = {}

function ChatTags.init()
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local props = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		if source then
			local p = Players:GetPlayerByUserId(source.UserId)
			if p then
				local prefix = ""
				if p:GetAttribute("VIP") == true then
					prefix ..= "<font color='#FFD24A'>[VIP]</font> "
				end
				local ls = p:FindFirstChild("leaderstats")
				local wins = ls and ls:FindFirstChild("Wins")
				if wins and wins:IsA("IntValue") and wins.Value > 0 then
					prefix ..= ("<font color='#7FD8FF'>[%s]</font> "):format(Lang.t("chat.wins", { n = wins.Value }))
				end
				if prefix ~= "" then
					props.PrefixText = prefix .. message.PrefixText
				end
			end
		end
		return props
	end
end

return ChatTags
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">Juice</string>
              <string name="Source"><![CDATA[--!strict
-- Feedback ("juice") for the local player. Everything here is local and cosmetic:
--   * checkpoint pads: the ones you've reached turn green and raise their flag, the next one gets
--     a light beacon so you always know where to go;
--   * reaching a checkpoint: shockwave ring + sparkle burst on the pad, a small camera FOV kick;
--   * dying: red flash, a puff where you fell, a short camera shake; respawning: a white ring;
--   * a shield absorbing a hit: blue flash + ring; arriving through a portal: a white flash;
--   * coins burst into sparkles; kill bricks pulse so they never read as a platform; conveyor and
--     wind chevrons run; the lobby balloons bob; the rainbow glow cycles; jump effects.
-- The world is streamed (only the stretch of tower around you is loaded), so every list here
-- follows CollectionService added / removed signals and nothing assumes a part exists.
-- One RenderStep does all the per-frame work, and only for things near the camera.
-- No sounds: the game ships without uploaded assets.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Quality = require(game:GetService("ReplicatedStorage").Shared.Quality)
local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Rules = require(ReplicatedStorage.Shared.Rules)
local Net = require(script.Parent.Parent.Net)

local Juice = {}

local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local DONE = Color3.fromRGB(50, 215, 80)
local DONE_REST = Color3.fromRGB(140, 215, 150) -- rest pads you have passed: a paler green
local BASE_FOV = 70
local NEAR = Quality.NEAR -- studs from the camera within which cosmetic loops run
local lite = false -- lite profile: scenery particles and lights off, shorter radius

local player = Players.LocalPlayer
local enabled = true -- Settings -> Visual effects

local fxFolder: Folder? = nil
local function folder(): Folder
	if fxFolder and fxFolder.Parent then
		return fxFolder
	end
	local f = Instance.new("Folder")
	f.Name = "LocalFx"
	f.Parent = Workspace
	fxFolder = f
	return f
end

local function ghost(size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.Neon
	p.Parent = folder()
	return p
end

-- Flat ring that grows and fades (a cylinder lying on the pad).
local function shockwave(pos: Vector3, color: Color3, from: number, to: number, duration: number)
	local ring = ghost(Vector3.new(0.3, from, from), CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2), color)
	ring.Shape = Enum.PartType.Cylinder
	ring.Transparency = 0.25
	TweenService:Create(ring, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.3, to, to),
		Transparency = 1,
	}):Play()
	task.delay(duration + 0.1, function()
		ring:Destroy()
	end)
end
Juice.shockwave = shockwave

local function burst(pos: Vector3, texture: string, colors: ColorSequence, count: number, speed: number, size: number, life: number, gravity: number)
	local anchor = ghost(Vector3.new(1, 1, 1), CFrame.new(pos), Color3.new())
	anchor.Transparency = 1
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture
	e.Rate = 0
	e.Lifetime = NumberRange.new(life * 0.6, life)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Acceleration = Vector3.new(0, -gravity, 0)
	e.Size = NumberSequence.new(size, size * 0.15)
	e.LightEmission = 0.7
	e.Color = colors
	e.Parent = anchor
	e:Emit(count)
	task.delay(life + 0.3, function()
		anchor:Destroy()
	end)
end

-- Settings -> Visual effects. Off = no shockwaves / flashes / camera kicks, and the scenery's
-- particle emitters and point lights are switched off locally (the cheap way to help a slow phone).
-- The lite profile keeps what belongs to an obstacle (lava embers, wind streaks): that is
-- information, not dressing.
local function inStage(inst: Instance): boolean
	local a = inst.Parent
	while a and a ~= Workspace do
		if a:GetAttribute("Kind") ~= nil then
			return true
		end
		a = a.Parent
	end
	return false
end

local function applyToScenery(inst: Instance)
	if inst:IsA("ParticleEmitter") then
		inst.Enabled = enabled and not (lite and not inStage(inst))
	elseif inst:IsA("PointLight") then
		inst.Enabled = enabled and not (lite and not inStage(inst))
	end
end

local function refreshScenery()
	for _, name in { "Decor", "Towers", "Lobby" } do
		local root = Workspace:FindFirstChild(name)
		if root then
			for _, d in root:GetDescendants() do
				applyToScenery(d)
			end
		end
	end
end

function Juice.setEffects(on: boolean)
	enabled = on
	refreshScenery()
end

-- Lite profile (Quality.isLite): the hit feedback stays, the scenery dressing goes.
function Juice.setLite(on: boolean)
	lite = on
	NEAR = if on then Quality.NEAR_LITE else Quality.NEAR
	refreshScenery()
end

---------------------------------------------------------------------------------------------
-- screen flash (own ScreenGui under the HUD, covers the whole screen)
---------------------------------------------------------------------------------------------
local flashFrame: Frame? = nil
local function flash(color: Color3, from: number, duration: number)
	local f = flashFrame
	if not f then
		local gui = Instance.new("ScreenGui")
		gui.Name = "SkyTowerFx"
		gui.IgnoreGuiInset = true
		gui.ResetOnSpawn = false
		gui.DisplayOrder = -1
		gui.Parent = player:WaitForChild("PlayerGui")
		local frame = Instance.new("Frame")
		frame.Name = "Flash"
		frame.Size = UDim2.fromScale(1, 1)
		frame.BorderSizePixel = 0
		frame.BackgroundTransparency = 1
		frame.Active = false
		frame.Parent = gui
		f = frame
		flashFrame = frame
	end
	local frame = f :: Frame
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = from
	TweenService:Create(frame, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()
end
Juice.flash = flash

---------------------------------------------------------------------------------------------
-- camera: FOV kick + shake
---------------------------------------------------------------------------------------------
local shakeUntil = 0
local shakePower = 0
local function fovKick(amount: number)
	local cam = Workspace.CurrentCamera
	if not cam or cam.CameraType ~= Enum.CameraType.Custom then
		return
	end
	cam.FieldOfView = BASE_FOV + amount
	TweenService:Create(cam, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = BASE_FOV }):Play()
end

-- A list of tagged parts that follows streaming (parts come and go).
local function tracked(tagName: string, onAdded: ((BasePart) -> ())?): { BasePart }
	local list: { BasePart } = {}
	local function add(inst: Instance)
		if inst:IsA("BasePart") then
			table.insert(list, inst)
			if onAdded then
				onAdded(inst)
			end
		end
	end
	for _, inst in CollectionService:GetTagged(tagName) do
		add(inst)
	end
	CollectionService:GetInstanceAddedSignal(tagName):Connect(add)
	CollectionService:GetInstanceRemovedSignal(tagName):Connect(function(inst)
		local i = table.find(list, inst :: any)
		if i then
			list[i] = list[#list]
			list[#list] = nil
		end
	end)
	return list
end

-- Top-centre of the pad of global stage g, from the layout (the pad itself may not be streamed in).
local maps: { [number]: Layout.Map } = {}
local function mapOf(tower: number): Layout.Map
	local m = maps[tower]
	if not m then
		m = Layout.generate(Config.MapSeed, tower)
		maps[tower] = m
	end
	return m
end
local function padTop(g: number): Vector3
	local spot = Rules.padOf(Layout :: any, g)
	local v = mapOf(spot.tower).pads[spot.pad]
	return Vector3.new(v.x, v.y, v.z)
end
Juice.padTop = padTop

---------------------------------------------------------------------------------------------
function Juice.init()
	-- pads, flags, centre dots ------------------------------------------------------------------
	-- keyed by stage; the original colour is remembered the first time a part streams in
	local pads: { [number]: BasePart } = {}
	local flags: { [number]: BasePart } = {}
	local dots: { [number]: BasePart } = {}
	local baseColor: { [BasePart]: Color3 } = {}
	local dirty = true
	local function keep(map: { [number]: BasePart })
		return function(inst: BasePart)
			local k = inst:GetAttribute("Stage")
			if type(k) == "number" then
				map[k] = inst
				baseColor[inst] = inst.Color
				dirty = true
				inst.Destroying:Once(function()
					if map[k] == inst then
						map[k] = nil
					end
					baseColor[inst] = nil
				end)
			end
		end
	end
	tracked("Checkpoint", keep(pads))
	tracked("Flag", keep(flags))
	tracked("PadDot", keep(dots))

	-- beacon on the next pad: a soft column of light + a ring that breathes
	local beam = ghost(Vector3.new(46, 3.2, 3.2), CFrame.new(0, -500, 0), Color3.fromRGB(255, 250, 190))
	beam.Shape = Enum.PartType.Cylinder
	beam.Transparency = 0.72
	beam.Name = "NextBeacon"
	local ring = ghost(Vector3.new(0.25, 14, 14), CFrame.new(0, -500, 0), Color3.fromRGB(255, 250, 190))
	ring.Shape = Enum.PartType.Cylinder
	ring.Transparency = 0.5
	ring.Name = "NextRing"
	local beaconAt: Vector3? = nil

	local shownAt = -1
	local function paint(k: number, at: number, animate: boolean)
		local reached = k >= 1 and k <= at
		local pad = pads[k]
		if pad then
			local rest = pad:GetAttribute("Save") == false
			pad.Color = if reached then (if rest then DONE_REST else DONE) else baseColor[pad] or pad.Color
		end
		local dot = dots[k]
		if dot then
			dot.Color = if reached then DONE else baseColor[dot] or dot.Color
		end
		local flag = flags[k]
		if flag then
			local target = flag:GetAttribute(if reached then "High" else "Low")
			flag.Color = if reached then DONE else baseColor[flag] or flag.Color
			if typeof(target) == "CFrame" then
				if animate and reached and k == at then
					TweenService:Create(flag, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { CFrame = target }):Play()
				else
					flag.CFrame = target
				end
			end
		end
	end
	local function showProgress(at: number, animate: boolean)
		if dirty then
			-- something streamed in: repaint everything that is loaded
			dirty = false
			for k in pads do
				paint(k, at, false)
			end
			for k in flags do
				paint(k, at, false)
			end
			for k in dots do
				paint(k, at, false)
			end
		elseif at ~= shownAt then
			for k = math.max(1, math.min(at, shownAt)), math.max(at, shownAt) do
				paint(k, at, animate)
			end
		end
		shownAt = at
		-- the next pad: across a portal it is the first pad of the next tower, and only once you
		-- stand on that tower's base
		local s = Net.state
		local nextStage = at + 1
		if nextStage <= Layout.TOTAL and Rules.canReach(Layout :: any, at, nextStage, 1, s.base == true) then
			local top = padTop(nextStage)
			beaconAt = top
			beam.CFrame = CFrame.new(top + Vector3.new(0, 23, 0)) * CFrame.Angles(0, 0, math.pi / 2)
		else
			beaconAt = nil
			beam.CFrame = CFrame.new(0, -500, 0)
			ring.CFrame = CFrame.new(0, -500, 0)
		end
	end
	local function currentAt(): number
		local s = Net.state
		return if type(s.at) == "number" then s.at elseif type(s.stage) == "number" then s.stage else 0
	end
	Net.changed:Connect(function()
		showProgress(currentAt(), true)
	end)
	showProgress(currentAt(), false)

	-- checkpoint reached -----------------------------------------------------------------------
	Net.on("Celebrate", function(data: { [string]: any })
		local k = tonumber(data.stage) or 0
		if not enabled or k <= 0 then
			return
		end
		local top = padTop(k) + Vector3.new(0, 0.2, 0)
		local theme = Config.theme(Layout.towerOf(k), Layout.themeFor(k))
		local big = data.world ~= nil or k % Layout.STAGES == 0
		shockwave(top, Color3.new(1, 1, 1), 4, if big then 46 else 28, 0.55)
		task.delay(0.12, function()
			shockwave(top, theme.accent, 4, if big then 60 else 36, 0.7)
		end)
		burst(top + Vector3.new(0, 1.5, 0), SPARKLES, ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
			ColorSequenceKeypoint.new(0.4, theme.accent),
			ColorSequenceKeypoint.new(1, DONE),
		}), if big then 70 else 36, if big then 34 else 24, 1.1, 1.2, 45)
		fovKick(if big then 12 else 7)
	end)
	Net.on("TowerEnter", function()
		if enabled then
			flash(Color3.new(1, 1, 1), 0.15, 0.9)
			fovKick(16)
		end
	end)
	Net.on("Shield", function()
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and enabled then
			flash(Color3.fromRGB(120, 170, 255), 0.6, 0.5)
			shockwave(root.Position - Vector3.new(0, 2, 0), Color3.fromRGB(120, 170, 255), 3, 18, 0.5)
		end
	end)

	-- coins --------------------------------------------------------------------------------------
	local coinById: { [number]: BasePart } = {}
	tracked("Coin", function(inst)
		local id = inst:GetAttribute("CoinId")
		if type(id) == "number" then
			coinById[id] = inst
			inst.Destroying:Once(function()
				if coinById[id] == inst then
					coinById[id] = nil
				end
			end)
		end
	end)
	Net.on("CoinCollected", function(id: number)
		local coin = coinById[id]
		if coin and enabled then
			burst(coin.Position, SPARKLES, ColorSequence.new(Color3.fromRGB(255, 240, 150), Color3.fromRGB(255, 180, 40)), 16, 14, 0.8, 0.7, 30)
		end
	end)

	-- death / respawn / jump effect -----------------------------------------------------------------
	local function onCharacter(char: Model)
		local hum = char:WaitForChild("Humanoid", 10)
		local root = char:WaitForChild("HumanoidRootPart", 10)
		if not hum or not root or not hum:IsA("Humanoid") or not root:IsA("BasePart") then
			return
		end
		if enabled then
			-- arrival ring (first spawn and every respawn)
			task.delay(0.15, function()
				if root.Parent then
					shockwave(root.Position - Vector3.new(0, 2.6, 0), Color3.fromRGB(200, 240, 255), 3, 16, 0.5)
				end
			end)
		end
		hum.Died:Once(function()
			if not enabled then
				return
			end
			local pos = root.Position
			flash(Color3.fromRGB(255, 40, 60), 0.55, 0.6)
			burst(pos, SMOKE, ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 205, 220)), 14, 9, 3.2, 0.9, -4)
			burst(pos, SPARKLES, ColorSequence.new(Color3.fromRGB(255, 90, 90), Color3.fromRGB(255, 220, 120)), 26, 26, 0.9, 0.8, 60)
			shakePower = 0.45
			shakeUntil = os.clock() + 0.35
		end)
		-- lounge jump effects: a ring or a puff of stars under your feet on every jump
		hum.StateChanged:Connect(function(_, new)
			if new ~= Enum.HumanoidStateType.Jumping or not enabled then
				return
			end
			local fx = hum:GetAttribute("JumpFx")
			if fx == "jumpfx_ring" then
				shockwave(root.Position - Vector3.new(0, 2.6, 0), Color3.new(1, 1, 1), 2, 11, 0.4)
			elseif fx == "jumpfx_stars" then
				burst(root.Position - Vector3.new(0, 2.4, 0), SPARKLES, ColorSequence.new(Color3.fromRGB(255, 240, 150), Color3.fromRGB(255, 255, 255)), 12, 10, 0.8, 0.6, 20)
			end
		end)
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end

	-- per-frame: beacon pulse, kill-brick pulse, running chevrons, camera shake, balloons, rainbow ---
	local kills: { BasePart } = {}
	tracked("Kill", function(inst)
		-- lava keeps its own colour; spinner bars and strips pulse
		if inst.Name ~= "Lava" then
			table.insert(kills, inst)
			inst.Destroying:Once(function()
				local i = table.find(kills, inst)
				if i then
					kills[i] = kills[#kills]
					kills[#kills] = nil
				end
			end)
		end
	end)
	local hot = Color3.fromRGB(255, 130, 110)

	-- conveyor / wind chevrons: a running light in the push direction
	local arrows = tracked("BeltArrow")
	local arrowBase: { [BasePart]: Color3 } = {}
	local arrowLit = Color3.fromRGB(255, 255, 210)
	local arrowStep = -1

	type Bobber = { model: Model, home: CFrame, phase: number }
	local bobbers: { Bobber } = {}
	task.spawn(function()
		local deco = Workspace:WaitForChild("Decor", 30)
		local lobby = deco and deco:WaitForChild("LobbyScenery", 30)
		if lobby then
			local function add(m: Instance)
				local phase = m:GetAttribute("Bob")
				if m:IsA("Model") and type(phase) == "number" then
					table.insert(bobbers, { model = m, home = m:GetPivot(), phase = phase })
				end
			end
			for _, m in lobby:GetChildren() do
				add(m)
			end
			lobby.ChildAdded:Connect(add)
		end
	end)

	-- effects that arrive while "Visual effects" is off stay off
	for _, name in { "Decor", "Towers", "Lobby" } do
		task.spawn(function()
			local root = Workspace:WaitForChild(name, 60)
			if root then
				root.DescendantAdded:Connect(function(d)
					if not enabled or lite then
						applyToScenery(d)
					end
				end)
			end
		end)
	end

	local slowAcc = 0
	RunService:BindToRenderStep("SkyTowerJuice", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local t = os.clock()
		local cam = Workspace.CurrentCamera
		if beaconAt then
			local s = 13 + math.sin(t * 3) * 2.2
			ring.Size = Vector3.new(0.25, s, s)
			ring.CFrame = CFrame.new(beaconAt + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.pi / 2)
			ring.Transparency = 0.45 + math.sin(t * 3) * 0.2
			beam.Transparency = 0.74 + math.sin(t * 2) * 0.08
		end
		if cam and t < shakeUntil then
			local k = shakePower * (shakeUntil - t) / 0.35
			cam.CFrame *= CFrame.Angles((math.random() - 0.5) * 0.06 * k, (math.random() - 0.5) * 0.06 * k, 0)
		end
		slowAcc += dt
		if slowAcc < 1 / 12 or not cam then
			return
		end
		slowAcc = 0
		if dirty then
			showProgress(currentAt(), false)
		end
		local camPos = cam.CFrame.Position
		local near2 = NEAR * NEAR
		local pulse = 0.5 + 0.5 * math.sin(t * 5)
		local color = Config.KillColor:Lerp(hot, pulse * 0.75)
		for _, k in kills do
			local d = k.Position - camPos
			if d.X * d.X + d.Y * d.Y + d.Z * d.Z < near2 then
				k.Color = color
			end
		end
		local step = math.floor(t * 6) % 3
		if step ~= arrowStep then
			arrowStep = step
			for _, a in arrows do
				local d = a.Position - camPos
				if d.X * d.X + d.Y * d.Y + d.Z * d.Z < near2 then
					local base = arrowBase[a]
					if not base then
						base = a.Color
						arrowBase[a] = base
						a.Destroying:Once(function()
							arrowBase[a] = nil
						end)
					end
					a.Color = if a:GetAttribute("Order") == step then arrowLit else base:Lerp(Color3.new(0, 0, 0), 0.12)
				end
			end
		end
		for i = #bobbers, 1, -1 do
			local b = bobbers[i]
			if b.model.Parent then
				b.model:PivotTo(b.home + Vector3.new(0, math.sin(t * 0.5 + b.phase * 2) * 3, 0))
			else
				table.remove(bobbers, i)
			end
		end
		-- rainbow glow (the stage-700 gift) on any character near the camera
		for _, other in Players:GetPlayers() do
			local char = other.Character
			local glow = char and char:FindFirstChild("SkyGlow")
			if glow and glow:IsA("Highlight") and glow:GetAttribute("Rainbow") then
				local c = Color3.fromHSV((t * 0.25) % 1, 0.75, 1)
				glow.FillColor = c
				glow.OutlineColor = c
			end
		end
	end)
end

return Juice
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">LocalFx</string>
              <string name="Source"><![CDATA[--!strict
-- Client-side world behaviour that must act on the LOCAL character or the local view:
--   * Bounce pads: launch your own (client-owned) character upward.
--   * Wind zones: push your character sideways while it is inside one.
--   * Abilities the server has granted (player attributes AirJumps / Dash / Roam): double and
--     triple jump, dash, and the lounge's explore mode (glider, cloud).
--   * Glass: invisible until you're close (purely visual, local).
--   * Coins: spin locally, hide the ones you've collected this run.
-- (The sky / lighting per world is World/Atmos.luau; hit feedback is World/Juice.luau.)
-- The world is streamed, so every list follows CollectionService added / removed signals, and the
-- cosmetic loops only touch what is near the camera.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.Layout)
local Perks = require(ReplicatedStorage.Shared.Perks)
local Net = require(script.Parent.Parent.Net)

local LocalFx = {}

local player = Players.LocalPlayer
local NEAR = 150

local function tracked(name: string, onAdded: ((BasePart) -> ())?): { BasePart }
	local list: { BasePart } = {}
	local function add(inst: Instance)
		if inst:IsA("BasePart") then
			table.insert(list, inst)
			if onAdded then
				onAdded(inst)
			end
		end
	end
	for _, inst in CollectionService:GetTagged(name) do
		add(inst)
	end
	CollectionService:GetInstanceAddedSignal(name):Connect(add)
	CollectionService:GetInstanceRemovedSignal(name):Connect(function(inst)
		local i = table.find(list, inst :: any)
		if i then
			list[i] = list[#list]
			list[#list] = nil
		end
	end)
	return list
end

local function parts(): (Model?, Humanoid?, BasePart?)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not char or not hum or not root or hum.Health <= 0 then
		return nil, nil, nil
	end
	return char, hum, root
end

---------------------------------------------------------------------------------------------
-- dash (exposed for the HUD button)
---------------------------------------------------------------------------------------------
local dashUntil, dashReadyAt = 0, 0
local dashDir = Vector3.zero

-- Seconds until the dash can be used again (0 = ready). -1 = you don't have it.
function LocalFx.dashCooldown(): number
	if player:GetAttribute("Dash") ~= true then
		return -1
	end
	return math.max(0, dashReadyAt - os.clock())
end

function LocalFx.dash(): boolean
	local _, hum, root = parts()
	if not hum or not root or player:GetAttribute("Dash") ~= true or os.clock() < dashReadyAt then
		return false
	end
	local dir = hum.MoveDirection
	if dir.Magnitude < 0.1 then
		local look = root.CFrame.LookVector
		dir = Vector3.new(look.X, 0, look.Z)
	end
	if dir.Magnitude < 0.1 then
		return false
	end
	dashDir = dir.Unit
	dashUntil = os.clock() + Perks.DASH_TIME
	dashReadyAt = os.clock() + Perks.DASH_COOLDOWN
	return true
end

function LocalFx.init()
	-- Bounce pads ---------------------------------------------------------------------------
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local lastBounce = 0

	-- Wind zones ------------------------------------------------------------------------------
	local winds = tracked("Wind")

	-- Air jumps (double / triple jump) ------------------------------------------------------------
	local airUsed = 0
	local released = false -- the jump key was let go since the last jump
	local lastJumpAt = 0
	UserInputService.JumpRequest:Connect(function()
		local _, hum, root = parts()
		if not hum or not root then
			return
		end
		local allowed = player:GetAttribute("AirJumps")
		local state = hum:GetState()
		local airborne = state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping
		if not airborne then
			lastJumpAt = os.clock()
			released = false
			return
		end
		if type(allowed) ~= "number" or airUsed >= allowed or not released or os.clock() - lastJumpAt < 0.15 then
			return
		end
		airUsed += 1
		released = false
		lastJumpAt = os.clock()
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(v.X, Config.JumpPower, v.Z)
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.Q then
			LocalFx.dash()
		end
	end)

	-- Explore mode visuals (local): a glider over your head / a cloud under your feet
	local prop: BasePart? = nil
	local propKind = ""
	local function setProp(kind: string)
		if kind == propKind then
			return
		end
		propKind = kind
		if prop then
			prop:Destroy()
			prop = nil
		end
		if kind == "" then
			return
		end
		local p = Instance.new("Part")
		p.Name = "RoamProp"
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.Material = Enum.Material.SmoothPlastic
		if kind == "glider" then
			p.Size = Vector3.new(9, 0.3, 3.2)
			p.Color = Color3.fromRGB(255, 110, 130)
		else
			p.Size = Vector3.new(6, 1.6, 6)
			p.Color = Color3.fromRGB(255, 255, 255)
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = p
		end
		p.Parent = Workspace
		prop = p
	end

	RunService.Heartbeat:Connect(function(dt)
		local char, hum, root = parts()
		if not char or not hum or not root then
			setProp("")
			return
		end
		local now = os.clock()
		local state = hum:GetState()
		local grounded = hum.FloorMaterial ~= Enum.Material.Air
		if grounded then
			airUsed = 0
		end
		if not hum.Jump then
			released = true
		end

		-- bounce
		if grounded and now - lastBounce >= 0.4 then
			params.FilterDescendantsInstances = { char }
			local hit = Workspace:Raycast(root.Position, Vector3.new(0, -5, 0), params)
			if hit and CollectionService:HasTag(hit.Instance, "Bounce") then
				lastBounce = now
				local v = root.AssemblyLinearVelocity
				local up = math.sqrt(2 * Workspace.Gravity * Config.BounceHeight)
				root.AssemblyLinearVelocity = Vector3.new(v.X, up, v.Z)
				hum:ChangeState(Enum.HumanoidStateType.Freefall)
			end
		end

		-- wind: while you are in the air inside a zone you drift with it at the wind speed (the
		-- Humanoid's air control cancels velocity nudges, so the drift is applied to the position;
		-- steering against it works because WalkSpeed is always higher than the wind)
		if not grounded then
			for _, zone in winds do
				local rel = zone.CFrame:PointToObjectSpace(root.Position)
				local half = zone.Size / 2
				if math.abs(rel.X) < half.X and math.abs(rel.Y) < half.Y and math.abs(rel.Z) < half.Z then
					local push = zone:GetAttribute("Push")
					if typeof(push) == "Vector3" then
						root.CFrame += push * math.min(dt, 0.05)
					end
					break
				end
			end
		end

		-- dash
		if now < dashUntil then
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(dashDir.X * Perks.DASH_SPEED, math.max(v.Y, 2), dashDir.Z * Perks.DASH_SPEED)
		end

		-- explore mode
		local roam = player:GetAttribute("Roam")
		if roam == "glider" then
			setProp("glider")
			local v = root.AssemblyLinearVelocity
			if v.Y < -Perks.GLIDE_FALL_SPEED and state == Enum.HumanoidStateType.Freefall then
				root.AssemblyLinearVelocity = Vector3.new(v.X, -Perks.GLIDE_FALL_SPEED, v.Z)
			end
			if prop then
				prop.CFrame = root.CFrame * CFrame.new(0, 3.6, 0.4) * CFrame.Angles(math.rad(-8), 0, 0)
			end
		elseif roam == "cloud" then
			setProp("cloud")
			local move = hum.MoveDirection
			local vy = 0
			if hum.Jump then
				vy = 26
			elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.ButtonL3) then
				vy = -26
			end
			-- hover: no falling, and the ride itself is moved (same reason as the wind above)
			root.AssemblyLinearVelocity = Vector3.zero
			root.CFrame += Vector3.new(move.X * Perks.CLOUD_SPEED, vy, move.Z * Perks.CLOUD_SPEED) * math.min(dt, 0.05)
			if prop then
				prop.CFrame = CFrame.new(root.Position - Vector3.new(0, 3.4, 0))
			end
		else
			setProp("")
		end
	end)

	-- Glass reveal ---------------------------------------------------------------------------
	local glass = tracked("Glass", function(g)
		g.Transparency = 1
	end)
	task.spawn(function()
		while true do
			task.wait(0.12)
			local _, _, root = parts()
			if root then
				local pos = root.Position
				for _, g in glass do
					local d = (g.Position - pos).Magnitude
					if d < NEAR then
						local target = if d < Config.GlassRevealDistance then 0.3 + 0.6 * (d / Config.GlassRevealDistance) else 1
						if math.abs(g.Transparency - target) > 0.02 then
							g.Transparency = target
						end
					end
				end
			end
		end
	end)

	-- Coins -----------------------------------------------------------------------------------
	local collected: { [number]: boolean } = {}
	local homes: { [BasePart]: CFrame } = {}
	local byId: { [number]: BasePart } = {}
	local coins = tracked("Coin", function(c)
		homes[c] = c.CFrame
		local id = c:GetAttribute("CoinId")
		if type(id) == "number" then
			byId[id] = c
			if collected[id] then
				c.Transparency = 1 -- streamed back in after you took it
			end
		end
		c.Destroying:Once(function()
			homes[c] = nil
			if type(id) == "number" and byId[id] == c then
				byId[id] = nil
			end
		end)
	end)
	RunService.RenderStepped:Connect(function()
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		local t = os.clock()
		local camPos = cam.CFrame.Position
		for _, c in coins do
			local home = homes[c]
			if home and c.Transparency < 1 then
				local d = home.Position - camPos
				if d.X * d.X + d.Y * d.Y + d.Z * d.Z < NEAR * NEAR then
					c.CFrame = CFrame.new(home.Position + Vector3.new(0, math.sin(t * 2 + home.Position.X) * 0.3, 0)) * CFrame.Angles(0, t * 2, 0)
				end
			end
		end
	end)
	Net.on("CoinCollected", function(id: number)
		collected[id] = true
		local c = byId[id]
		if c then
			TweenService:Create(c, TweenInfo.new(0.25), { Size = c.Size * 1.6, Transparency = 1 }):Play()
		end
	end)
	Net.changed:Connect(function(new, prev)
		-- rebirth resets the run: show all coins again
		if prev.at and new.at and new.at == 0 and prev.at >= Layout.STAGES then
			table.clear(collected)
			for _, c in coins do
				c.Transparency = 0
				c.Size = Vector3.new(0.5, 2.4, 2.4)
			end
		end
	end)
end

return LocalFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">Weather</string>
              <string name="Source"><![CDATA[--!strict
-- Ambient particles around the camera, one look per world: pollen over the meadow, sugar
-- sparkles, snow, blowing sand, rising embers, bubbles, toxic spores, glitter above the clouds,
-- stardust in space, rainbow sparkles at the summit. One emitter in a box that follows the
-- camera; the settings are swapped when the world changes (Atmos.worldChanged).
-- Textures are the ones that ship with Roblox (rbxasset://), no uploads.
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Quality = require(game:GetService("ReplicatedStorage").Shared.Quality)
local Atmos = require(script.Parent.Atmos)

local Weather = {}

local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

export type Look = {
	texture: string,
	colors: { Color3 },
	size: { number }, -- start, end
	rate: number,
	life: number,
	speed: number,
	drift: Vector3, -- acceleration: gravity for snow, lift for embers and bubbles, wind for sand
	up: boolean, -- emit upwards (embers, bubbles) instead of downwards
	emission: number, -- LightEmission
	transparency: number,
	spin: number,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

-- One look per world, in tower order. Rates are low on purpose: at most ~80 particles alive.
Weather.Looks = {
	{ texture = SMOKE, colors = { rgb(255, 250, 200), rgb(230, 255, 190) }, size = { 0.18, 0.1 }, rate = 9, life = 7, speed = 1.2, drift = Vector3.new(0.6, 0.15, 0.3), up = false, emission = 0.4, transparency = 0.35, spin = 20 }, -- pollen
	{ texture = SPARKLES, colors = { rgb(255, 190, 230), rgb(190, 235, 255) }, size = { 0.5, 0.1 }, rate = 10, life = 5, speed = 1.5, drift = Vector3.new(0, -0.6, 0), up = false, emission = 0.7, transparency = 0.2, spin = 60 }, -- sugar sparkles
	{ texture = SMOKE, colors = { rgb(255, 255, 255), rgb(235, 245, 255) }, size = { 0.28, 0.22 }, rate = 16, life = 6, speed = 5, drift = Vector3.new(0.8, -1.2, 0.4), up = false, emission = 0.2, transparency = 0.1, spin = 40 }, -- snow
	{ texture = SMOKE, colors = { rgb(245, 215, 160), rgb(230, 190, 130) }, size = { 0.5, 1.6 }, rate = 8, life = 5, speed = 3, drift = Vector3.new(5, 0.2, 1.5), up = false, emission = 0.1, transparency = 0.72, spin = 30 }, -- blowing sand
	{ texture = FIRE, colors = { rgb(255, 210, 90), rgb(255, 80, 20) }, size = { 0.32, 0.05 }, rate = 14, life = 4.5, speed = 4, drift = Vector3.new(0.4, 2.2, 0), up = true, emission = 1, transparency = 0.05, spin = 90 }, -- embers
	{ texture = SPARKLES, colors = { rgb(225, 250, 255), rgb(170, 235, 245) }, size = { 0.25, 0.6 }, rate = 11, life = 6, speed = 3, drift = Vector3.new(0, 1.4, 0), up = true, emission = 0.5, transparency = 0.35, spin = 10 }, -- bubbles
	{ texture = SMOKE, colors = { rgb(190, 255, 90), rgb(120, 190, 50) }, size = { 0.22, 0.5 }, rate = 10, life = 6, speed = 1.5, drift = Vector3.new(0.5, 0.5, 0.2), up = true, emission = 0.6, transparency = 0.4, spin = 30 }, -- spores
	{ texture = SPARKLES, colors = { rgb(255, 250, 225), rgb(255, 225, 140) }, size = { 0.4, 0.08 }, rate = 9, life = 5, speed = 1, drift = Vector3.new(0.3, -0.3, 0.2), up = false, emission = 0.8, transparency = 0.2, spin = 50 }, -- glitter
	{ texture = SPARKLES, colors = { rgb(120, 255, 240), rgb(255, 110, 230) }, size = { 0.35, 0.05 }, rate = 12, life = 5, speed = 0.6, drift = Vector3.new(0, 0, 0), up = false, emission = 1, transparency = 0.1, spin = 80 }, -- stardust
	{ texture = SPARKLES, colors = { rgb(255, 225, 120), rgb(255, 140, 210) }, size = { 0.55, 0.1 }, rate = 12, life = 5, speed = 1.5, drift = Vector3.new(0.2, -0.5, 0.2), up = false, emission = 0.9, transparency = 0.15, spin = 70 }, -- rainbow sparkles
} :: { Look }

local emitter: ParticleEmitter? = nil
local on = true
local rateScale = 1
local current: Look? = nil

local function apply(e: ParticleEmitter, look: Look)
	e.Texture = look.texture
	e.Color = ColorSequence.new(look.colors[1], look.colors[2] or look.colors[1])
	e.Size = NumberSequence.new(look.size[1], look.size[2])
	current = look
	e.Rate = look.rate * rateScale
	e.Lifetime = NumberRange.new(look.life * 0.7, look.life)
	e.Speed = NumberRange.new(look.speed * 0.5, look.speed)
	e.Acceleration = look.drift
	e.EmissionDirection = if look.up then Enum.NormalId.Top else Enum.NormalId.Bottom
	e.LightEmission = look.emission
	e.RotSpeed = NumberRange.new(-look.spin, look.spin)
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.15, look.transparency),
		NumberSequenceKeypoint.new(0.8, look.transparency),
		NumberSequenceKeypoint.new(1, 1),
	})
end

function Weather.setEffects(enabled: boolean)
	on = enabled
	if emitter then
		emitter.Enabled = enabled
	end
end

-- Lite profile: half of the ambient particles.
function Weather.setLite(lite: boolean)
	rateScale = if lite then Quality.WEATHER_RATE_LITE else 1
	if emitter and current then
		emitter.Rate = current.rate * rateScale
	end
end

function Weather.init()
	local box = Instance.new("Part")
	box.Name = "WeatherBox"
	box.Anchored = true
	box.CanCollide = false
	box.CanTouch = false
	box.CanQuery = false
	box.CastShadow = false
	box.Transparency = 1
	box.Size = Vector3.new(90, 46, 90)
	box.Parent = Workspace
	local e = Instance.new("ParticleEmitter")
	e.Name = "Weather"
	e.SpreadAngle = Vector2.new(35, 35)
	e.Rotation = NumberRange.new(0, 360)
	e.Enabled = on
	e.Parent = box
	emitter = e
	apply(e, Weather.Looks[math.clamp(Atmos.world, 1, #Weather.Looks)])
	Atmos.worldChanged:Connect(function(world: number)
		apply(e, Weather.Looks[math.clamp(world, 1, #Weather.Looks)])
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.2 then
			return
		end
		acc = 0
		local cam = Workspace.CurrentCamera
		if cam then
			box.CFrame = CFrame.new(cam.CFrame.Position + cam.CFrame.LookVector * Vector3.new(18, 0, 18))
		end
	end)
end

return Weather
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">WorldText</string>
              <string name="Source"><![CDATA[--!strict
-- Localizes world text built by the server. The server tags a TextLabel with the attributes
-- LocKey (+ optional LocArgs, a JSON object) and a ProximityPrompt with LocAction / LocObject;
-- this module writes the translated text locally and again whenever the language changes.
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")

local Lang = require(script.Parent.Parent.Lang)

local WorldText = {}

-- strong tables (weak Instance keys get collected while the Instance is alive); cleaned on Destroying
local labels: { [Instance]: boolean } = {}
local prompts: { [Instance]: boolean } = {}

local function decode(json: any): { [string]: any }?
	if type(json) ~= "string" or json == "" then
		return nil
	end
	local ok, t = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	return if ok and type(t) == "table" then t else nil
end

local function applyLabel(inst: Instance)
	local key = inst:GetAttribute("LocKey")
	if type(key) == "string" and (inst:IsA("TextLabel") or inst:IsA("TextButton")) then
		(inst :: any).Text = Lang.t(key, decode(inst:GetAttribute("LocArgs")))
	end
end

local function applyPrompt(inst: Instance)
	if not inst:IsA("ProximityPrompt") then
		return
	end
	local action = inst:GetAttribute("LocAction")
	local object = inst:GetAttribute("LocObject")
	if type(action) == "string" then
		inst.ActionText = Lang.t(action)
	end
	if type(object) == "string" then
		inst.ObjectText = Lang.t(object)
	end
end

local function track(inst: Instance)
	if inst:GetAttribute("LocKey") ~= nil then
		labels[inst] = true
		inst.Destroying:Once(function()
			labels[inst] = nil
		end)
		applyLabel(inst)
		inst:GetAttributeChangedSignal("LocArgs"):Connect(function()
			applyLabel(inst)
		end)
		inst:GetAttributeChangedSignal("LocKey"):Connect(function()
			applyLabel(inst)
		end)
	elseif inst:IsA("ProximityPrompt") and (inst:GetAttribute("LocAction") ~= nil or inst:GetAttribute("LocObject") ~= nil) then
		prompts[inst] = true
		inst.Destroying:Once(function()
			prompts[inst] = nil
		end)
		applyPrompt(inst)
	end
end

function WorldText.init()
	for _, d in Workspace:GetDescendants() do
		track(d)
	end
	Workspace.DescendantAdded:Connect(function(d)
		task.defer(track, d) -- attributes are set before parenting, but be safe
	end)
	Lang.changed:Connect(function()
		for inst in labels do
			applyLabel(inst)
		end
		for inst in prompts do
			applyPrompt(inst)
		end
	end)
end

-- Exposed for other client modules that build localized world text themselves.
WorldText.track = track

return WorldText
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
