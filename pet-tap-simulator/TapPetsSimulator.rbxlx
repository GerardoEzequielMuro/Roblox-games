        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">tr</string>
            <string name="Source"><![CDATA[-- Turkish (tr). Keys must match en.luau; keep {placeholders}.
return {
	-- HUD / menu
	["hint.tap"] = "Tık kazanmak için her yere dokun!",
	["hud.per_tap"] = "Her dokunuşta +{n}",
