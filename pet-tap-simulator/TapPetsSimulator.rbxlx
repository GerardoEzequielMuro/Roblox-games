        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">pt</string>
            <string name="Source"><![CDATA[-- Brazilian Portuguese (pt). Keys must match en.luau; keep {placeholders}.
return {
	-- HUD / menu
	["hint.tap"] = "Toque em qualquer lugar para ganhar Taps!",
	["hud.per_tap"] = "+{n} por toque",
	["hud.gift_ready"] = "Presente pronto!",
	["hud.friend_boost"] = "Bônus de amigos +{pct}%",
	["hud.super_luck"] = "Super Sorte {time}",
	["menu.Pets"] = "Pets",
	["menu.Upgrades"] = "Melhorias",
	["menu.Rebirth"] = "Renascer",
	["menu.Store"] = "Loja",
	["menu.Rewards"] = "Recompensas",
	["menu.Index"] = "Índice",
	["menu.Teleport"] = "Teleporte",
