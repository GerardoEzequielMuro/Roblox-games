      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Palette</string>
          <string name="Source"><![CDATA[--!strict
-- Converts Config's pure-data colors into Color3 and holds UI colors.
local Config = require(script.Parent.Config)

local Palette = {}

function Palette.rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

function Palette.rarity(name: string): Color3
	local r = Config.RarityByName[name]
	return if r then Palette.rgb(r.color) else Color3.new(1, 1, 1)
end

function Palette.material(name: string?): Enum.Material
	if not name then
		return Enum.Material.SmoothPlastic
	end
	local ok, m = pcall(function()
		return (Enum.Material :: any)[name]
	end)
	return if ok and m then m else Enum.Material.SmoothPlastic
end

Palette.Gold = Color3.fromRGB(255, 196, 38)
Palette.TierColors = {
	[0] = Color3.fromRGB(255, 255, 255),
	[1] = Color3.fromRGB(255, 205, 55),
	[2] = Color3.fromRGB(255, 120, 220),
}

-- Rainbow hue for time t (seconds) and phase offset.
function Palette.rainbow(t: number, offset: number?): Color3
	return Color3.fromHSV(((t * 0.35) + (offset or 0)) % 1, 0.75, 1)
end

return Palette
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">PetModel</string>
          <string name="Source"><![CDATA[--!strict
-- Procedural low-poly pets. PetModel.build(petId, tier, opts) returns a Model whose PrimaryPart
-- ("Root") is anchored; every other part is welded to it, so PivotTo on the model is cheap.
-- Front of the pet faces -Z (the model's LookVector).
--
-- Anatomy: three rigs ("ball" = quadruped with a big head, "block" = cube pet, "tall" = upright
-- bird-like body) and a species "family" per pet that draws the face, ears, tail and wings.
-- Parts that move (wings, tail, ears, aura orbs) hang from a Weld named "Joint" with an "Anim"
-- attribute; PetFollow drives Joint.C0 on the client. In ViewportFrames they simply stay put.
--
-- opts.lite = true (icons, hatch reveal) skips particles, lights, trails and the aura.
local Config = require(script.Parent.Config)
local Formulas = require(script.Parent.Formulas)
local Palette = require(script.Parent.Palette)

local PetModel = {}

-- lite: icons (no effects at all). fx = false: world pets on the lite profile (geometry
-- aura and orbs stay; no trail, no light, half the particles). lights: point light allowed.
export type BuildOpts = { lite: boolean?, lights: boolean?, fx: boolean? }

local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local BLACK = Color3.fromRGB(28, 26, 38)
local WHITE = Color3.fromRGB(255, 255, 255)
local BLUSH = Color3.fromRGB(255, 140, 165)
local BEAK = Color3.fromRGB(255, 170, 40)
local PINK = Color3.fromRGB(255, 130, 160)
local TONGUE = Color3.fromRGB(255, 105, 130)
local SECRET = Color3.fromRGB(170, 60, 255)

type Joint = { kind: string, hinge: CFrame, side: number }
type Rig = {
	c: Vector3, -- head centre
	r: Vector3, -- head radii
	block: boolean,
	upright: boolean,
	faceY: number, -- face centre above the head centre
	rear: number, -- z of the body's back
	footY: number, -- lowest point
	wing: Vector3, -- wing hinge (x is mirrored)
	tail: Vector3, -- tail hinge
}
type Ctx = {
	model: Model,
	root: BasePart,
	s: number,
	tint: { BasePart },
	lite: boolean,
	rig: Rig,
	color: Color3,
	accent: Color3,
	light: Color3,
	mat: Enum.Material,
	extras: { [string]: boolean },
}

local V = Vector3.new

local function lighten(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), a)
end

local function darken(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), a)
end

local function lum(c: Color3): number
	return c.R * 0.3 + c.G * 0.59 + c.B * 0.11
end

-- shape: "Block" | "Ball" | "Cylinder" | "Ellipsoid". cf and size are in pet units (scaled by ctx.s).
local function add(ctx: Ctx, name: string, shape: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, tintable: boolean?, joint: Joint?): BasePart
	local p = Instance.new("Part")
	if shape == "Ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "Cylinder" then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Name = name
	p.Size = size * ctx.s
	p.CFrame = CFrame.new(cf.Position * ctx.s) * cf.Rotation
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.Anchored = false
	if shape == "Ellipsoid" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	if joint then
		local hinge = CFrame.new(joint.hinge.Position * ctx.s) * joint.hinge.Rotation
		local weld = Instance.new("Weld")
		weld.Name = "Joint"
		weld.Part0 = ctx.root
		weld.Part1 = p
		weld.C0 = hinge
		weld.C1 = p.CFrame:ToObjectSpace(hinge)
		weld:SetAttribute("Anim", joint.kind)
		weld:SetAttribute("Side", joint.side)
		weld.Parent = p
	else
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = ctx.root
		weld.Part1 = p
		weld.Parent = p
	end
	p.Parent = ctx.model
	if tintable then
		table.insert(ctx.tint, p)
		p:SetAttribute("Tint", #ctx.tint)
	end
	return p
end

local function emitter(parent: Instance, texture: string, color: Color3, rate: number, size: number, speed: number, light: number?): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture
	e.Color = ColorSequence.new(color)
	e.Rate = rate
	e.Lifetime = NumberRange.new(0.5, 1)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.LightEmission = light or 0.8
	e.LockedToPart = false
	e.Parent = parent
	return e
end

---------------------------------------------------------------------------
-- Head surface helpers: (x, y) are offsets from the face centre, `out` pushes the point
-- away from the surface.
---------------------------------------------------------------------------
local function surfaceZ(rig: Rig, x: number, yy: number): number
	if rig.block then
		return -rig.r.Z
	end
	local k = 1 - (x / rig.r.X) ^ 2 - (yy / rig.r.Y) ^ 2
	return -rig.r.Z * math.sqrt(math.max(k, 0.04))
end

local function face(rig: Rig, x: number, y: number, out: number?): Vector3
	local yy = y + rig.faceY
	return rig.c + V(x, yy, surfaceZ(rig, x, yy) - (out or 0))
end

-- Same point, turned so a flat part hugs the curve of the head.
local function faceCF(rig: Rig, x: number, y: number, out: number?): CFrame
	local p = face(rig, x, y, out)
	if rig.block then
		return CFrame.new(p)
	end
	local yy = y + rig.faceY
	return CFrame.new(p) * CFrame.Angles(0, -math.atan2(x, -surfaceZ(rig, x, yy)) * 0.8, 0)
end

-- Height of the head's top surface at horizontal offset x.
local function crownY(rig: Rig, x: number): number
	if rig.block then
		return rig.c.Y + rig.r.Y
	end
	return rig.c.Y + rig.r.Y * math.sqrt(math.max(0.04, 1 - (x / rig.r.X) ^ 2))
end

---------------------------------------------------------------------------
-- Bodies
---------------------------------------------------------------------------
local function buildBody(ctx: Ctx, body: string, birdFeet: boolean): Rig
	local color, mat = ctx.color, ctx.mat
	local paw = lighten(color, 0.32)
	if body == "block" then
		add(ctx, "Body", "Block", V(1.6, 1.3, 1.7), CFrame.new(0, -0.35, 0.5), color, mat, true)
		add(ctx, "Head", "Block", V(1.85, 1.7, 1.7), CFrame.new(0, 0.4, -0.45), color, mat, true)
		for _, side in { -1, 1 } do
			add(ctx, "Paw", "Block", V(0.56, 0.5, 0.6), CFrame.new(0.5 * side, -1.1, -0.15), paw)
			add(ctx, "Paw", "Block", V(0.56, 0.5, 0.6), CFrame.new(0.5 * side, -1.1, 0.98), paw)
		end
		return { c = V(0, 0.4, -0.45), r = V(0.925, 0.85, 0.85), block = true, upright = false, faceY = 0, rear = 1.35, footY = -1.35, wing = V(0.72, 0.28, 0.6), tail = V(0, -0.2, 1.3) }
	elseif body == "tall" then
		add(ctx, "Body", "Ellipsoid", V(1.9, 2.4, 1.8), CFrame.new(), color, mat, true)
		add(ctx, "Belly", "Ellipsoid", V(1.35, 1.55, 0.5), CFrame.new(0, -0.42, -0.66), ctx.light)
		for _, side in { -1, 1 } do
			add(ctx, "Foot", "Ellipsoid", V(0.55, 0.3, 0.8), CFrame.new(0.42 * side, -1.13, -0.3), if birdFeet then BEAK else paw)
		end
		return { c = V(0, 0, 0), r = V(0.95, 1.2, 0.9), block = false, upright = true, faceY = 0.42, rear = 0.9, footY = -1.28, wing = V(0.86, 0.2, 0.15), tail = V(0, -0.6, 0.8) }
	end
	add(ctx, "Body", "Ellipsoid", V(1.6, 1.4, 1.9), CFrame.new(0, -0.3, 0.45), color, mat, true)
	add(ctx, "Head", "Ball", V(1.9, 1.9, 1.9), CFrame.new(0, 0.4, -0.5), color, mat, true)
	for _, side in { -1, 1 } do
		add(ctx, "Paw", "Ball", V(0.62, 0.62, 0.62), CFrame.new(0.5 * side, -0.98, -0.2), paw)
		add(ctx, "Paw", "Ball", V(0.62, 0.62, 0.62), CFrame.new(0.52 * side, -0.98, 0.95), paw)
	end
	return { c = V(0, 0.4, -0.5), r = V(0.95, 0.95, 0.95), block = false, upright = false, faceY = 0, rear = 1.4, footY = -1.29, wing = V(0.6, 0.25, 0.55), tail = V(0, -0.15, 1.3) }
end

---------------------------------------------------------------------------
-- Faces
---------------------------------------------------------------------------
-- style: "dot" (big glossy), "fierce" (sclera + slit pupil + brow), "glow" (neon, no pupil),
-- "alien" (huge tilted), "rect" (golem). k scales the eyes, out pushes them off the surface.
local function eyes(ctx: Ctx, style: string, k: number, out: number)
	local rig = ctx.rig
	for _, side in { -1, 1 } do
		local x = 0.43 * side
		if style == "fierce" or style == "glow" then
			add(ctx, "Eye", "Ellipsoid", V(0.46, 0.42, 0.2) * k, faceCF(rig, x, 0.12, out), if style == "glow" then ctx.accent else WHITE, if style == "glow" then Enum.Material.Neon else nil)
			if style == "fierce" then
				add(ctx, "Pupil", "Ellipsoid", V(0.16, 0.34, 0.12) * k, faceCF(rig, x * 0.95, 0.12, out + 0.09), BLACK)
			end
			add(ctx, "Brow", "Block", V(0.58, 0.14, 0.16) * k, faceCF(rig, x, 0.4, out + 0.06) * CFrame.Angles(0, 0, math.rad(18 * side)), darken(ctx.color, 0.5))
		elseif style == "rect" then
			add(ctx, "Eye", "Block", V(0.42, 0.24, 0.1) * k, faceCF(rig, x, 0.14, out + 0.02) * CFrame.Angles(0, 0, math.rad(10 * side)), ctx.accent, Enum.Material.Neon)
		elseif style == "alien" then
			add(ctx, "Eye", "Ellipsoid", V(0.5, 0.68, 0.24) * k, faceCF(rig, x, 0.14, out) * CFrame.Angles(0, 0, math.rad(18 * side)), BLACK)
			add(ctx, "EyeShine", "Ball", V(0.18, 0.18, 0.18) * k, CFrame.new(face(rig, x + 0.08, 0.3, out + 0.1)), Color3.fromRGB(190, 255, 200), Enum.Material.Neon)
		else
			add(ctx, "Eye", "Ellipsoid", V(0.4, 0.54, 0.24) * k, faceCF(rig, x, 0.12, out), BLACK)
			add(ctx, "EyeShine", "Ball", V(0.17, 0.17, 0.17) * k, CFrame.new(face(rig, x + 0.08, 0.26, out + 0.1)), WHITE, Enum.Material.Neon)
			add(ctx, "EyeShine", "Ball", V(0.09, 0.09, 0.09) * k, CFrame.new(face(rig, x - 0.07, 0.0, out + 0.1)), WHITE, Enum.Material.Neon)
		end
		if style == "dot" or style == "alien" then
			add(ctx, "Blush", "Ellipsoid", V(0.34, 0.18, 0.08), faceCF(rig, 0.72 * side, -0.14, 0), BLUSH)
		end
	end
end

local function beak(ctx: Ctx, out: number)
	add(ctx, "Beak", "Ellipsoid", V(0.36, 0.26, 0.5), CFrame.new(face(ctx.rig, 0, -0.12, out + 0.14)), BEAK)
end

local MUZZLE: { [string]: (ctx: Ctx) -> () } = {
	dog = function(ctx)
		local m = face(ctx.rig, 0, -0.26, 0.02)
		add(ctx, "Muzzle", "Ellipsoid", V(0.82, 0.56, 0.5), CFrame.new(m), ctx.light)
		add(ctx, "Nose", "Ellipsoid", V(0.28, 0.2, 0.18), CFrame.new(m + V(0, 0.14, -0.22)), BLACK)
		add(ctx, "Tongue", "Ellipsoid", V(0.2, 0.26, 0.1), CFrame.new(m + V(0, -0.2, -0.2)), TONGUE)
	end,
	bear = function(ctx)
		local m = face(ctx.rig, 0, -0.26, 0.02)
		add(ctx, "Muzzle", "Ellipsoid", V(0.78, 0.56, 0.42), CFrame.new(m), ctx.light)
		add(ctx, "Nose", "Ellipsoid", V(0.3, 0.22, 0.18), CFrame.new(m + V(0, 0.12, -0.19)), BLACK)
		add(ctx, "Mouth", "Ellipsoid", V(0.22, 0.07, 0.07), CFrame.new(m + V(0, -0.12, -0.2)), BLACK)
	end,
	cat = function(ctx)
		local rig = ctx.rig
		local whisker = if lum(ctx.color) > 0.8 then Color3.fromRGB(120, 120, 135) else WHITE
		for _, side in { -1, 1 } do
			add(ctx, "Cheek", "Ball", V(0.36, 0.36, 0.36), CFrame.new(face(rig, 0.17 * side, -0.26, 0)), ctx.light)
			for j = 0, 1 do
				add(ctx, "Whisker", "Block", V(0.6, 0.035, 0.035), CFrame.new(face(rig, 0.8 * side, -0.2 - 0.13 * j, 0.02)) * CFrame.Angles(0, 0, math.rad((8 - 16 * j) * side)), whisker)
			end
		end
		add(ctx, "Nose", "Ellipsoid", V(0.17, 0.13, 0.12), CFrame.new(face(rig, 0, -0.14, 0.07)), PINK)
	end,
	bunny = function(ctx)
		local rig = ctx.rig
		local m = face(rig, 0, -0.24, 0)
		add(ctx, "Muzzle", "Ellipsoid", V(0.52, 0.38, 0.3), CFrame.new(m), ctx.light)
		add(ctx, "Nose", "Ellipsoid", V(0.17, 0.13, 0.12), CFrame.new(m + V(0, 0.1, -0.14)), PINK)
		add(ctx, "Teeth", "Block", V(0.2, 0.2, 0.06), CFrame.new(face(rig, 0, -0.47, 0.03)), WHITE)
	end,
	pig = function(ctx)
		local m = face(ctx.rig, 0, -0.2, 0.06)
		add(ctx, "Snout", "Ellipsoid", V(0.72, 0.52, 0.4), CFrame.new(m), ctx.accent)
		for _, side in { -1, 1 } do
			add(ctx, "Nostril", "Ellipsoid", V(0.1, 0.18, 0.08), CFrame.new(m + V(0.13 * side, 0, -0.18)), darken(ctx.accent, 0.4))
		end
	end,
	fox = function(ctx)
		local rig = ctx.rig
		for _, side in { -1, 1 } do
			add(ctx, "Cheek", "Ellipsoid", V(0.56, 0.5, 0.36), faceCF(rig, 0.58 * side, -0.32, -0.02), ctx.light)
		end
		local m = face(rig, 0, -0.24, 0.12)
		add(ctx, "Muzzle", "Ellipsoid", V(0.62, 0.46, 0.8), CFrame.new(m), ctx.light)
		add(ctx, "Nose", "Ball", V(0.22, 0.22, 0.22), CFrame.new(m + V(0, 0.1, -0.36)), BLACK)
	end,
	wolf = function(ctx)
		local rig = ctx.rig
		for _, side in { -1, 1 } do
			add(ctx, "Cheek", "Ellipsoid", V(0.56, 0.5, 0.36), faceCF(rig, 0.58 * side, -0.32, -0.02), ctx.light)
		end
		local m = face(rig, 0, -0.24, 0.12)
		add(ctx, "Muzzle", "Ellipsoid", V(0.66, 0.48, 0.85), CFrame.new(m), ctx.light)
		add(ctx, "Nose", "Ball", V(0.22, 0.22, 0.22), CFrame.new(m + V(0, 0.1, -0.38)), BLACK)
		for _, side in { -1, 1 } do
			add(ctx, "Fang", "Block", V(0.09, 0.18, 0.07), CFrame.new(m + V(0.15 * side, -0.22, -0.22)), WHITE)
		end
	end,
	bird = function(ctx)
		beak(ctx, 0)
	end,
	phoenix = function(ctx)
		beak(ctx, 0)
		-- crest
		local rig = ctx.rig
		for i = -1, 1 do
			add(ctx, "Crest", "Ellipsoid", V(0.2, 0.75, 0.3), CFrame.new(0.22 * i, crownY(rig, 0.22 * i) + 0.22, rig.c.Z + 0.1) * CFrame.Angles(math.rad(20), 0, math.rad(-22 * i)), ctx.accent)
		end
	end,
	owl = function(ctx)
		local rig = ctx.rig
		for _, side in { -1, 1 } do
			add(ctx, "EyeDisc", "Ellipsoid", V(0.74, 0.74, 0.12), faceCF(rig, 0.43 * side, 0.12, -0.02), ctx.light)
		end
		add(ctx, "Beak", "Ellipsoid", V(0.26, 0.3, 0.34), CFrame.new(face(rig, 0, -0.16, 0.1)), BEAK)
	end,
	penguin = function(ctx)
		local rig = ctx.rig
		add(ctx, "FacePatch", "Ellipsoid", V(1.3, 1.0, 0.3), CFrame.new(face(rig, 0, 0.06, -0.08)), ctx.light)
		beak(ctx, 0.04)
		for _, side in { -1, 1 } do
			add(ctx, "Flipper", "Ellipsoid", V(0.2, 1.05, 0.62), CFrame.new(0.98 * side, -0.1, 0.05) * CFrame.Angles(0, 0, math.rad(14 * side)), ctx.color, nil, true, { kind = "Ear", hinge = CFrame.new(0.92 * side, 0.4, 0.05), side = side })
		end
	end,
	dragon = function(ctx)
		local rig = ctx.rig
		local m = face(rig, 0, -0.26, 0.18)
		add(ctx, "Snout", "Ellipsoid", V(0.9, 0.6, 0.85), CFrame.new(m), lighten(ctx.color, 0.12), ctx.mat, true)
		for _, side in { -1, 1 } do
			add(ctx, "Nostril", "Ball", V(0.11, 0.11, 0.11), CFrame.new(m + V(0.17 * side, 0.17, -0.36)), darken(ctx.color, 0.55))
			add(ctx, "Fang", "Block", V(0.09, 0.2, 0.07), CFrame.new(m + V(0.22 * side, -0.27, -0.25)), WHITE)
		end
		-- belly plates
		if not rig.upright then
			add(ctx, "Chest", "Ellipsoid", V(1.0, 0.7, 1.3), CFrame.new(0, -0.78, 0.4), ctx.accent)
		end
	end,
	unicorn = function(ctx)
		local rig = ctx.rig
		local m = face(rig, 0, -0.3, 0.12)
		add(ctx, "Muzzle", "Ellipsoid", V(0.74, 0.62, 0.7), CFrame.new(m), ctx.light)
		for _, side in { -1, 1 } do
			add(ctx, "Nostril", "Ellipsoid", V(0.09, 0.13, 0.07), CFrame.new(m + V(0.14 * side, 0.02, -0.33)), darken(ctx.accent, 0.35))
		end
		for i = 0, 3 do
			add(ctx, "Mane", "Ball", V(0.52 - i * 0.04, 0.52 - i * 0.04, 0.52 - i * 0.04), CFrame.new(0, rig.c.Y + rig.r.Y - 0.05 - i * 0.22, rig.c.Z + 0.25 + i * 0.3), ctx.accent)
		end
	end,
	golem = function(ctx)
		local rig = ctx.rig
		add(ctx, "Mouth", "Block", V(0.7, 0.09, 0.08), CFrame.new(face(rig, 0, -0.36, 0.02)), ctx.accent, Enum.Material.Neon)
		add(ctx, "Crack", "Block", V(0.08, 0.7, 0.08), CFrame.new(face(rig, 0.55, 0.45, 0.02)) * CFrame.Angles(0, 0, math.rad(-25)), ctx.accent, Enum.Material.Neon)
		add(ctx, "Crack", "Block", V(0.9, 0.1, 0.1), CFrame.new(0.2, 0.31, 0.6) * CFrame.Angles(0, math.rad(30), 0), ctx.accent, Enum.Material.Neon)
		for _, side in { -1, 1 } do
			add(ctx, "Shoulder", "Block", V(0.62, 0.55, 0.7), CFrame.new(1.02 * side, 0.05, 0.55) * CFrame.Angles(math.rad(12), math.rad(20 * side), math.rad(15 * side)), darken(ctx.color, 0.2), ctx.mat)
		end
	end,
	yeti = function(ctx)
		local rig = ctx.rig
		add(ctx, "FacePatch", "Block", V(1.4, 1.1, 0.1), CFrame.new(face(rig, 0, -0.04, 0)), ctx.accent)
		add(ctx, "Nose", "Ellipsoid", V(0.26, 0.18, 0.14), CFrame.new(face(rig, 0, -0.14, 0.1)), darken(ctx.accent, 0.55))
		for _, side in { -1, 1 } do
			add(ctx, "Fang", "Block", V(0.13, 0.22, 0.08), CFrame.new(face(rig, 0.2 * side, -0.42, 0.08)), WHITE)
		end
	end,
}
MUZZLE.alien = MUZZLE.dog

---------------------------------------------------------------------------
-- Ears
---------------------------------------------------------------------------
local function ears(ctx: Ctx, kind: string)
	local rig = ctx.rig
	local z = rig.c.Z + 0.12
	local color, accent = ctx.color, ctx.accent
	if kind == "cat" or kind == "fox" or kind == "pig" then
		local sz = if kind == "fox" then 0.86 elseif kind == "pig" then 0.52 else 0.7
		local inner = if kind == "fox" then ctx.light elseif kind == "pig" then darken(accent, 0.12) else (if lum(accent) > 0.2 then accent else PINK)
		for _, side in { -1, 1 } do
			local x = 0.56 * side
			local y = crownY(rig, 0.56) + 0.06
			add(ctx, "Ear", "Block", V(sz, sz, 0.24), CFrame.new(x, y, z) * CFrame.Angles(0, 0, math.rad(45)), color, ctx.mat, true)
			add(ctx, "EarInner", "Block", V(sz * 0.56, sz * 0.56, 0.1), CFrame.new(x, y + 0.04, z - 0.1) * CFrame.Angles(0, 0, math.rad(45)), inner)
		end
	elseif kind == "dog" then
		local earColor = if lum(accent) < lum(color) then accent else darken(color, 0.3)
		for _, side in { -1, 1 } do
			add(ctx, "Ear", "Ellipsoid", V(0.36, 1.0, 0.62), CFrame.new((rig.r.X + 0.04) * side, rig.c.Y + 0.18, z) * CFrame.Angles(0, 0, math.rad(12 * side)), earColor, nil, false, { kind = "Ear", hinge = CFrame.new((rig.r.X - 0.05) * side, rig.c.Y + 0.62, z), side = side })
		end
	elseif kind == "bunny" then
		local inner = if lum(accent) > 0.2 then accent else PINK
		for _, side in { -1, 1 } do
			local x = 0.36 * side
			local base = crownY(rig, 0.36)
			local hinge = CFrame.new(x, base - 0.1, z)
			local rot = CFrame.Angles(0, 0, math.rad(-8 * side))
			add(ctx, "Ear", "Ellipsoid", V(0.42, 1.4, 0.3), CFrame.new(x + 0.07 * side, base + 0.52, z) * rot, color, ctx.mat, true, { kind = "Ear", hinge = hinge, side = side })
			add(ctx, "EarInner", "Ellipsoid", V(0.22, 1.0, 0.1), CFrame.new(x + 0.07 * side, base + 0.52, z - 0.13) * rot, inner, nil, false, { kind = "Ear", hinge = hinge, side = side })
		end
	elseif kind == "bear" then
		for _, side in { -1, 1 } do
			local x = 0.66 * side
			local y = crownY(rig, 0.66) + 0.08
			add(ctx, "Ear", "Ball", V(0.62, 0.62, 0.62), CFrame.new(x, y, z), color, ctx.mat, true)
			add(ctx, "EarInner", "Ball", V(0.34, 0.34, 0.34), CFrame.new(x, y, z - 0.2), ctx.light)
		end
	end
end

---------------------------------------------------------------------------
-- Tails and wings
---------------------------------------------------------------------------
local function tail(ctx: Ctx, family: string)
	local rig = ctx.rig
	local function frame(pitch: number): (CFrame, Joint)
		local f = CFrame.new(rig.tail) * CFrame.Angles(math.rad(pitch), 0, 0)
		return f, { kind = "Tail", hinge = f, side = 1 }
	end
	if family == "fox" or family == "wolf" then
		local f, j = frame(-35)
		add(ctx, "Tail", "Ellipsoid", V(0.62, 0.62, 1.25), f * CFrame.new(0, 0, 0.55), ctx.color, ctx.mat, true, j)
		add(ctx, "TailTip", "Ball", V(0.5, 0.5, 0.5), f * CFrame.new(0, 0, 1.12), ctx.light, nil, false, j)
	elseif family == "cat" then
		local f, j = frame(-62)
		add(ctx, "Tail", "Ellipsoid", V(0.26, 0.26, 1.2), f * CFrame.new(0, 0, 0.55), ctx.color, ctx.mat, true, j)
		add(ctx, "TailTip", "Ball", V(0.32, 0.32, 0.32), f * CFrame.new(0, 0, 1.15), ctx.light, nil, false, j)
	elseif family == "dragon" then
		local f, j = frame(-14)
		add(ctx, "Tail", "Ellipsoid", V(0.52, 0.46, 0.95), f * CFrame.new(0, 0, 0.4), ctx.color, ctx.mat, true, j)
		add(ctx, "Tail", "Ellipsoid", V(0.36, 0.32, 0.85), f * CFrame.new(0, 0.05, 1.05), ctx.color, ctx.mat, true, j)
		add(ctx, "TailTip", "Block", V(0.42, 0.14, 0.42), f * CFrame.new(0, 0.08, 1.55) * CFrame.Angles(0, math.rad(45), 0), ctx.accent, nil, false, j)
	elseif family == "pig" then
		local f, j = frame(-30)
		add(ctx, "Tail", "Ball", V(0.3, 0.3, 0.3), f * CFrame.new(0, 0, 0.12), ctx.accent, nil, false, j)
		add(ctx, "Tail", "Ball", V(0.22, 0.22, 0.22), f * CFrame.new(0.12, 0.12, 0.26), ctx.accent, nil, false, j)
	elseif family == "bunny" then
		add(ctx, "Tail", "Ball", V(0.46, 0.46, 0.46), CFrame.new(rig.tail + V(0, 0.05, 0.05)), ctx.light)
	elseif family == "unicorn" then
		local f, j = frame(20)
		for i = 0, 2 do
			add(ctx, "Tail", "Ball", V(0.46 - i * 0.06, 0.46 - i * 0.06, 0.46 - i * 0.06), f * CFrame.new(0, 0, 0.15 + i * 0.3), ctx.accent, nil, false, j)
		end
	elseif family == "phoenix" then
		for i = -1, 1 do
			local f = CFrame.new(rig.tail) * CFrame.Angles(0, math.rad(22 * i), 0) * CFrame.Angles(math.rad(-38), 0, 0)
			add(ctx, "TailFeather", "Ellipsoid", V(0.34, 0.12, 1.3), f * CFrame.new(0, 0, 0.6), if i == 0 then ctx.accent else ctx.color, nil, i ~= 0, { kind = "Tail", hinge = f, side = 1 })
		end
	else
		local f, j = frame(-42)
		add(ctx, "Tail", "Ellipsoid", V(0.3, 0.3, 0.8), f * CFrame.new(0, 0, 0.35), ctx.color, ctx.mat, true, j)
		add(ctx, "TailTip", "Ball", V(0.3, 0.3, 0.3), f * CFrame.new(0, 0, 0.72), ctx.light, nil, false, j)
	end
end

local function wings(ctx: Ctx, family: string)
	local rig = ctx.rig
	for _, side in { -1, 1 } do
		local hinge = CFrame.new(rig.wing.X * side, rig.wing.Y, rig.wing.Z) * CFrame.Angles(0, math.rad(-32 * side), 0) * CFrame.Angles(0, 0, math.rad(24 * side))
		local j: Joint = { kind = "Wing", hinge = hinge, side = side }
		if family == "dragon" then
			add(ctx, "Wing", "Ellipsoid", V(1.7, 1.15, 0.1), hinge * CFrame.new(0.85 * side, 0.1, 0), ctx.accent, nil, false, j)
			add(ctx, "WingBone", "Block", V(1.7, 0.15, 0.15), hinge * CFrame.new(0.85 * side, 0.58, 0), darken(ctx.color, 0.15), nil, false, j)
			add(ctx, "WingBone", "Block", V(0.13, 0.9, 0.13), hinge * CFrame.new(0.9 * side, 0.12, 0) * CFrame.Angles(0, 0, math.rad(-28 * side)), darken(ctx.color, 0.15), nil, false, j)
		else
			add(ctx, "Wing", "Ellipsoid", V(1.35, 0.95, 0.14), hinge * CFrame.new(0.66 * side, 0.05, 0), ctx.accent, nil, false, j)
			add(ctx, "WingTip", "Ellipsoid", V(0.85, 0.6, 0.12), hinge * CFrame.new(1.12 * side, -0.18, -0.03), lighten(ctx.accent, 0.35), nil, false, j)
		end
	end
end

---------------------------------------------------------------------------
-- Extras
---------------------------------------------------------------------------
local EXTRA: { [string]: (ctx: Ctx) -> () } = {
	horn = function(ctx)
		local rig = ctx.rig
		local base = CFrame.new(0, crownY(rig, 0) - 0.05, rig.c.Z - 0.45) * CFrame.Angles(math.rad(-22), 0, 0)
		add(ctx, "Horn", "Block", V(0.26, 0.5, 0.26), base * CFrame.new(0, 0.22, 0) * CFrame.Angles(0, math.rad(45), 0), Palette.Gold, Enum.Material.Neon)
		add(ctx, "Horn", "Block", V(0.16, 0.46, 0.16), base * CFrame.new(0, 0.66, 0) * CFrame.Angles(0, math.rad(20), 0), lighten(Palette.Gold, 0.35), Enum.Material.Neon)
	end,
	horns = function(ctx)
		local rig = ctx.rig
		local col = if lum(ctx.accent) > lum(ctx.color) then ctx.accent else lighten(ctx.color, 0.55)
		for _, side in { -1, 1 } do
			local base = CFrame.new(0.42 * side, crownY(rig, 0.42) - 0.08, rig.c.Z + 0.15) * CFrame.Angles(math.rad(14), 0, math.rad(-24 * side))
			add(ctx, "Horn", "Block", V(0.26, 0.46, 0.26), base * CFrame.new(0, 0.2, 0), col)
			add(ctx, "Horn", "Block", V(0.16, 0.42, 0.16), base * CFrame.new(0, 0.58, 0) * CFrame.Angles(math.rad(18), 0, math.rad(-14 * side)), lighten(col, 0.3))
		end
	end,
	crown = function(ctx)
		local rig = ctx.rig
		local y = crownY(rig, 0)
		local z = rig.c.Z
		add(ctx, "CrownBase", "Cylinder", V(0.2, 0.78, 0.78), CFrame.new(0, y + 0.06, z) * CFrame.Angles(0, 0, math.rad(90)), Palette.Gold, Enum.Material.Metal)
		for i = 0, 3 do
			local a = i / 4 * math.pi * 2 + math.pi / 4
			add(ctx, "CrownPoint", "Block", V(0.17, 0.3, 0.17), CFrame.new(math.cos(a) * 0.29, y + 0.26, z + math.sin(a) * 0.29) * CFrame.Angles(0, -a, math.rad(45)), Palette.Gold, Enum.Material.Metal)
		end
		add(ctx, "CrownGem", "Ball", V(0.18, 0.18, 0.18), CFrame.new(0, y + 0.08, z - 0.4), Color3.fromRGB(255, 70, 110), Enum.Material.Neon)
	end,
	antenna = function(ctx)
		local rig = ctx.rig
		for _, side in { -1, 1 } do
			local y = crownY(rig, 0.3)
			add(ctx, "Antenna", "Block", V(0.08, 0.62, 0.08), CFrame.new(0.32 * side, y + 0.22, rig.c.Z) * CFrame.Angles(0, 0, math.rad(-15 * side)), ctx.accent)
			add(ctx, "AntennaBall", "Ball", V(0.26, 0.26, 0.26), CFrame.new(0.4 * side, y + 0.55, rig.c.Z), ctx.color, Enum.Material.Neon)
		end
	end,
	flames = function(ctx)
		local rig = ctx.rig
		local y = crownY(rig, 0)
		local core = add(ctx, "Flame", "Ellipsoid", V(0.42, 0.7, 0.42), CFrame.new(0, y + 0.22, rig.c.Z + 0.25), Color3.fromRGB(255, 120, 30), Enum.Material.Neon)
		add(ctx, "Flame", "Ellipsoid", V(0.24, 0.46, 0.24), CFrame.new(0, y + 0.3, rig.c.Z + 0.22), Color3.fromRGB(255, 225, 90), Enum.Material.Neon)
		if not ctx.lite then
			local e = emitter(core, FIRE, Color3.fromRGB(255, 140, 40), 10, 0.8 * ctx.s, 1.5, 1)
			e.Acceleration = V(0, 4, 0)
			e.SpreadAngle = Vector2.new(15, 15)
		end
	end,
	halo = function(ctx)
		local rig = ctx.rig
		local y = crownY(rig, 0) + 0.5
		for i = 0, 7 do
			local a = i / 8 * math.pi * 2
			add(ctx, "Halo", "Block", V(0.4, 0.09, 0.11), CFrame.new(math.cos(a) * 0.46, y, rig.c.Z + math.sin(a) * 0.46) * CFrame.Angles(0, -a + math.pi / 2, 0), Color3.fromRGB(255, 240, 150), Enum.Material.Neon)
		end
	end,
	spikes = function(ctx)
		local rig = ctx.rig
		local spots: { Vector3 } = { V(0, rig.c.Y + rig.r.Y * 0.72, rig.c.Z + 0.62), V(0, 0.42, 0.55), V(0, 0.28, 1.05) }
		if rig.upright then
			spots = { V(0, 0.85, 0.6), V(0, 0.3, 0.88), V(0, -0.25, 0.86) }
		end
		for i, p in spots do
			local sz = 0.36 - i * 0.04
			add(ctx, "Spike", "Block", V(sz * 0.7, sz, sz), CFrame.new(p) * CFrame.Angles(math.rad(45), 0, 0), if lum(ctx.accent) > 0.12 then ctx.accent else lighten(ctx.color, 0.4))
		end
	end,
	scarf = function(ctx)
		local rig = ctx.rig
		local red = Color3.fromRGB(230, 50, 60)
		if rig.block then
			add(ctx, "Scarf", "Block", V(2.0, 0.3, 1.85), CFrame.new(0, -0.38, -0.45), red, Enum.Material.Fabric)
			add(ctx, "ScarfEnd", "Block", V(0.36, 0.6, 0.12), CFrame.new(0.5, -0.78, -1.36) * CFrame.Angles(0, 0, math.rad(8)), red, Enum.Material.Fabric)
		elseif rig.upright then
			add(ctx, "Scarf", "Ellipsoid", V(2.04, 0.42, 1.94), CFrame.new(0, -0.08, 0), red, Enum.Material.Fabric)
			add(ctx, "ScarfEnd", "Block", V(0.36, 0.62, 0.12), CFrame.new(0.45, -0.46, -0.9) * CFrame.Angles(0, 0, math.rad(10)), red, Enum.Material.Fabric)
		else
			add(ctx, "Scarf", "Ellipsoid", V(1.78, 0.42, 1.62), CFrame.new(0, -0.24, -0.28), red, Enum.Material.Fabric)
			add(ctx, "ScarfEnd", "Block", V(0.34, 0.62, 0.14), CFrame.new(0.5, -0.66, -0.98) * CFrame.Angles(0, 0, math.rad(10)), red, Enum.Material.Fabric)
		end
	end,
	sprinkles = function(ctx)
		local rig = ctx.rig
		local cols = { Color3.fromRGB(255, 80, 80), Color3.fromRGB(80, 200, 255), Color3.fromRGB(255, 230, 60), Color3.fromRGB(120, 230, 120) }
		for i = 1, 7 do
			local a = i * 2.4
			local rr = 0.22 + (i % 3) * 0.17
			local x, zz = math.cos(a) * rr, math.sin(a) * rr
			local y = if rig.block then rig.c.Y + rig.r.Y + 0.03 else rig.c.Y + rig.r.Y * math.sqrt(math.max(0.05, 1 - (x / rig.r.X) ^ 2 - (zz / rig.r.Z) ^ 2)) + 0.02
			add(ctx, "Sprinkle", "Block", V(0.09, 0.09, 0.26), CFrame.new(x, y, rig.c.Z + zz) * CFrame.Angles(0, a, 0.3), cols[(i % #cols) + 1], Enum.Material.Neon)
		end
	end,
}

---------------------------------------------------------------------------
-- Species
---------------------------------------------------------------------------
local FAMILY: { [string]: string } = {
	piggy = "pig",
	chick = "bird",
	owl = "owl",
	arcticowl = "owl",
	nebulaowl = "owl",
	unicorn = "unicorn",
	crystalunicorn = "unicorn",
	candydragon = "dragon",
	icedragon = "dragon",
	firedragon = "dragon",
	galaxydragon = "dragon",
	celestialdragon = "dragon",
	shadowdragon = "dragon",
	jellyphoenix = "phoenix",
	frostphoenix = "phoenix",
	penguin = "penguin",
	icewolf = "wolf",
	hellhound = "wolf",
	yeti = "yeti",
	magmagolem = "golem",
	geodegolem = "golem",
	starforgetitan = "golem",
	obsidianwolf = "wolf",
	infernodrake = "dragon",
	solarphoenix = "phoenix",
	horizonowl = "owl",
	singularitydragon = "dragon",
	aurorawyrm = "dragon",
	eclipsedrake = "dragon",
	gembasilisk = "dragon",
	supernovaphoenix = "phoenix",
	alienpup = "alien",
}
local EYES: { [string]: string } = { dragon = "fierce", wolf = "fierce", yeti = "fierce", golem = "rect", alien = "alien" }
local EYE_OUT: { [string]: number } = { yeti = 0.06, penguin = 0.05, owl = 0.05 }
local EAR_OF: { [string]: string } = { wolf = "fox", pig = "pig", alien = "dog", unicorn = "cat" }
-- pets that keep their feet on the ground even though they have wings
local WALKERS: { [string]: boolean } = { chick = true }

function PetModel.family(petId: string): string
	local def = Formulas.PetById[petId]
	if not def then
		return "dog"
	end
	local f = FAMILY[petId]
	if f then
		return f
	end
	return if def.ears == "none" then "dog" else def.ears
end

---------------------------------------------------------------------------
-- Rainbow pets: call every frame (client) to cycle their tinted parts. Each part sits at
-- its own hue offset, so the pet reads as a rainbow rather than one flat colour.
---------------------------------------------------------------------------
local tintCache: { [Model]: { BasePart } } = {}

local function tintParts(model: Model): { BasePart }
	local list = tintCache[model]
	if list then
		return list
	end
	local found: { BasePart } = {}
	for _, d in model:GetChildren() do
		if d:IsA("BasePart") and d:GetAttribute("Tint") then
			table.insert(found, d)
		end
	end
	tintCache[model] = found
	model.Destroying:Once(function()
		tintCache[model] = nil
	end)
	return found
end

function PetModel.updateRainbow(model: Model, now: number)
	if not model:GetAttribute("Rainbow") then
		return
	end
	for i, p in tintParts(model) do
		p.Color = Palette.rainbow(now, i * 0.09)
	end
end

-- Builds a pet at the origin. tier: 0 Normal, 1 Golden, 2 Rainbow.
function PetModel.build(petId: string, tier: number?, opts: BuildOpts?): Model
	local t = tier or 0
	local lite = opts ~= nil and opts.lite == true
	local def = Formulas.PetById[petId] or Formulas.PetById[Config.StartingPet]
	local family = PetModel.family(def.id)
	local model = Instance.new("Model")
	model.Name = def.id
	model:SetAttribute("PetId", def.id)
	model:SetAttribute("Tier", t)

	local s = def.size * (if t == 2 then 1.15 elseif t == 1 then 1.08 else 1)
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(0.4, 0.4, 0.4)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CastShadow = false
	root.CFrame = CFrame.new()
	root.Parent = model
	model.PrimaryPart = root

	local color = Palette.rgb(def.color)
	local accent = Palette.rgb(def.accent)
	local mat = Palette.material(def.material)
	if t == 1 then
		color = Palette.Gold
		accent = Color3.fromRGB(255, 240, 170)
		mat = Enum.Material.SmoothPlastic
	elseif t == 2 then
		mat = Enum.Material.SmoothPlastic
	end
	local extras: { [string]: boolean } = {}
	for _, e in def.extras do
		extras[e] = true
	end
	local ctx: Ctx = {
		model = model,
		root = root,
		s = s,
		tint = {},
		lite = lite,
		rig = nil :: any,
		color = color,
		accent = accent,
		light = if lum(accent) > lum(color) + 0.08 then accent else lighten(color, 0.55),
		mat = mat,
		extras = extras,
	}
	local birdFeet = family == "bird" or family == "phoenix" or family == "owl" or family == "penguin"
	ctx.rig = buildBody(ctx, def.body, birdFeet)
	local rig = ctx.rig

	-- face: patches first, then the eyes on top
	local muzzle = MUZZLE[family] or MUZZLE.dog
	muzzle(ctx)
	if extras.beak and not birdFeet then
		beak(ctx, 0)
	end
	local style = EYES[family] or "dot"
	if def.rarity == "Secret" then
		style = "glow"
	end
	local order = Config.RarityByName[def.rarity].order
	eyes(ctx, style, if order >= 5 and style == "dot" then 1.12 else 1, EYE_OUT[family] or 0)

	ears(ctx, EAR_OF[family] or def.ears)
	if extras.tail or family == "bunny" or family == "unicorn" or family == "phoenix" then
		tail(ctx, family)
	end
	if extras.wings then
		wings(ctx, family)
		if not WALKERS[def.id] then
			model:SetAttribute("Flyer", true)
		end
	end
	for _, extra in def.extras do
		local fn = EXTRA[extra]
		if fn then
			fn(ctx)
		end
	end
	model:SetAttribute("FootY", rig.footY * s)
	model:SetAttribute("Size", s)

	-- Tiers
	if t == 1 then
		for _, p in ctx.tint do
			p.Reflectance = 0.1
		end
	elseif t == 2 then
		model:SetAttribute("Rainbow", true)
		for _, p in ctx.tint do
			p.Reflectance = 0.12
		end
		PetModel.updateRainbow(model, 0)
	end

	if lite then
		return model
	end

	---------------------------------------------------------------------------
	-- World-only effects: tier sparkles, rarity aura, trail, lights
	---------------------------------------------------------------------------
	local rcol = if def.rarity == "Secret" then SECRET else Palette.rarity(def.rarity)
	local fx = not (opts ~= nil and opts.fx == false)
	local rateK = if fx then 1 else 0.5
	if t >= 1 then
		emitter(root, SPARKLES, if t == 1 then Palette.Gold else WHITE, 4 * rateK, 0.7 * s, 1.5)
	end
	if order >= 5 then
		local disc = add(ctx, "Aura", "Cylinder", V(0.05, 2.9, 2.9), CFrame.new(0, rig.footY + 0.05, 0.2) * CFrame.Angles(0, 0, math.rad(90)), rcol, Enum.Material.Neon)
		disc.Transparency = 0.86
		local rim = add(ctx, "Aura", "Cylinder", V(0.04, 3.3, 3.3), CFrame.new(0, rig.footY + 0.03, 0.2) * CFrame.Angles(0, 0, math.rad(90)), lighten(rcol, 0.3), Enum.Material.Neon)
		rim.Transparency = 0.93
		emitter(root, SPARKLES, rcol, (if order >= 6 then 7 else 4) * rateK, 0.8 * s, 2)
	end
	if order >= 5 and fx then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 0.55 * s, 0.4 * s)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -0.55 * s, 0.4 * s)
		a1.Parent = root
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(lighten(rcol, 0.3), rcol)
		trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
		trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
		trail.Lifetime = 0.45
		trail.MinLength = 0.2
		trail.LightEmission = 0.8
		trail.FaceCamera = true
		trail.Parent = root
	end
	-- orbiting orbs are plain geometry, so the rarity still reads with graphics at minimum
	if order >= 5 then
		local orbs = order - 3 -- Legendary 2, Mythic 3, Secret 4
		for i = 1, orbs do
			local orb = add(ctx, "Orb", "Ball", V(0.3, 0.3, 0.3), CFrame.new(1.9, 0.2, 0), lighten(rcol, 0.25), Enum.Material.Neon, false, { kind = "Orbit", hinge = CFrame.new(), side = 1 })
			local joint = orb:FindFirstChild("Joint") :: Weld
			joint.C1 = CFrame.new()
			joint:SetAttribute("Radius", 1.9 * s)
			joint:SetAttribute("Height", (0.1 + (i % 2) * 0.5) * s)
			joint:SetAttribute("Phase", i / orbs * math.pi * 2)
		end
	end
	if def.rarity == "Secret" then
		local smoke = emitter(root, SMOKE, Color3.fromRGB(60, 20, 110), 8 * rateK, 1.6 * s, 1.2, 0.2)
		smoke.Lifetime = NumberRange.new(0.8, 1.4)
		smoke.Acceleration = V(0, 2, 0)
	end
	if fx and (extras.glow or order >= 6) and opts ~= nil and opts.lights == true then
		local light = Instance.new("PointLight")
		light.Color = if order >= 6 then rcol else accent
		light.Range = 9 * s
		light.Brightness = 1.2
		light.Shadows = false
		light.Parent = root
	end
	return model
end

return PetModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Quests</string>
          <string name="Source"><![CDATA[--!strict
-- Daily quests (pure; unit-tested with luau.exe). Everyone gets the same 3 quest kinds on a
-- given UTC day; targets scale with the player's best zone.
local Config: typeof(require(script.Parent.Config)) = if script then require(script.Parent.Config) :: any else (require :: any)("./Config")

local Quests = {}

export type Quest = { kind: string, target: number, gems: number }

function Quests.today(now: number): number
	return now // 86400
end

function Quests.resetsAt(now: number): number
	return (now // 86400 + 1) * 86400
end

function Quests.forDay(day: number, zone: number?): { Quest }
	local pool = Config.QuestPool
	local order = {}
	for i = 1, #pool do
		order[i] = i
	end
	-- Park-Miller PRNG (pure Luau, so the standalone tests get the same picks as Roblox)
	local seed = (math.floor(day) % 2147483646) + 1
	local function nextInt(n: number): number
		seed = (seed * 16807) % 2147483647
		return seed % n + 1
	end
	nextInt(1)
	for i = #order, 2, -1 do
		local j = nextInt(i)
		order[i], order[j] = order[j], order[i]
	end
	local z = math.clamp(zone or 1, 1, #Config.Zones)
	local out: { Quest } = {}
	for k = 1, math.min(Config.QuestsPerDay, #pool) do
		local def = pool[order[k]]
		table.insert(out, { kind = def.kind, target = def.targetByZone[math.min(z, #def.targetByZone)], gems = def.gems })
	end
	return out
end

return Quests
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Referral</string>
          <string name="Source"><![CDATA[--!strict
-- Referral launch data ("ref:<inviterUserId>"). Pure; unit-tested with luau.exe.
local Referral = {}

function Referral.launchData(userId: number): string
	return "ref:" .. tostring(math.floor(userId))
end

-- Inviter user id from a join's LaunchData, or nil.
function Referral.parse(launchData: any): number?
	if type(launchData) ~= "string" or #launchData > 40 then
		return nil
	end
	local digits = launchData:match("^ref:(%d+)$")
	local n = if digits then tonumber(digits) else nil
	if n and n > 0 then
		return n
	end
	return nil
end

return Referral
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="28">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="29">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="30">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Tap Pets Simulator: server bootstrap.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)

local Services = script.Parent.Services
local WorldBuilder = require(script.Parent.World.WorldBuilder)
local Data = require(Services.Data)
local Remotes = require(Services.Remotes)
local State = require(Services.State)
local Pets = require(Services.Pets)
local Eggs = require(Services.Eggs)
local Tapping = require(Services.Tapping)
local Progression = require(Services.Progression)
local Rewards = require(Services.Rewards)
local Monetization = require(Services.Monetization)
local Leaderboard = require(Services.Leaderboard)
local LiveEventService = require(Services.LiveEventService)
local QuestService = require(Services.QuestService)
local Offline = require(Services.Offline)
local Social = require(Services.Social)
local Auto = require(Services.Auto)
local Plots = require(Services.Plots)
local PolicyService = game:GetService("PolicyService")

local world = WorldBuilder.build()

State.start()
Pets.init()
Eggs.init(world.eggPositions)
Tapping.init()
Progression.init(world.zoneSpawns, world.gates)
Rewards.init()
Monetization.init()
Leaderboard.init(world.boards)
LiveEventService.init()
QuestService.init()
Offline.init()
Social.init()
Auto.init()
Plots.init(world.plots)
Data.startAutosave()

-- Extra per-player limits (requests/second sustained, burst) on top of the global 12/s.
-- Legit use is a few clicks; these stop brute force (codes), web-call spam (group, share, ads)
-- and CPU abuse (state snapshots, delete/craft loops).
for action, lim in {
	GetState = { 3, 10 },
	SetLanguage = { 2, 4 },
	RedeemCode = { 0.5, 3 },
	WatchAd = { 0.2, 2 },
	ShareLink = { 0.2, 2 },
	ClaimGroupGift = { 0.3, 2 },
	ClaimOffline = { 1, 3 },
	ClaimDaily = { 1, 2 },
	ClaimGift = { 2, 6 },
	ClaimQuest = { 3, 6 },
	ClaimQuestBonus = { 1, 2 },
	ClaimIndex = { 2, 4 },
	Teleport = { 1, 3 },
	GoPark = { 1, 3 },
	Rebirth = { 2, 4 },
	BuyZone = { 2, 4 },
	Upgrade = { 6, 12 },
	Delete = { 3, 6 },
	Craft = { 5, 10 },
	RollTrait = { 8, 16 },
	EquipBest = { 3, 6 },
	Hatch = { 5, 10 },
} :: { [string]: { number } } do
	Remotes.limit(action, lim[1], lim[2])
end

Remotes.handle("GetState", function(player)
	if not State.ready[player] then
		return false, "loading"
	end
	return true, State.snapshot(player)
end)

-- Language preference ("" = follow the Roblox account locale).
Remotes.handle("SetLanguage", function(player, payload)
	local p = Data.get(player)
	local code = payload.lang
	if not p or type(code) ~= "string" or (code ~= "" and not Locale.Supported[code]) then
		return false, Locale.m("msg.unknown_language")
	end
	p.lang = code
	State.dirty(player)
	return true
end)

local function vipTag(player: Player, char: Model)
	local head = char:WaitForChild("Head", 5)
	if not head or not State.owns(player, "VIP") then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "VIPTag"
	bb.Size = UDim2.fromOffset(80, 28)
	bb.StudsOffset = Vector3.new(0, 2.6, 0)
	bb.MaxDistance = 60
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = "VIP"
	t.TextColor3 = Color3.fromRGB(255, 215, 60)
	local s = Instance.new("UIStroke")
	s.Thickness = 2
	s.Parent = t
	t.Parent = bb
	bb.Parent = head
end

local function onCharacter(player: Player, char: Model)
	task.defer(function()
		Progression.applyWalkSpeed(player)
		vipTag(player, char)
	end)
end

-- Paid random items policy (Australia, Belgium, Netherlands, UK, Brazil for some users).
-- Restricted until PolicyService answers, so nothing is ever offered by mistake.
local function loadPolicy(player: Player)
	State.paidRandomRestricted[player] = true
	for attempt = 1, 4 do
		local ok, info = pcall(function()
			return PolicyService:GetPolicyInfoForPlayerAsync(player)
		end)
		if not player.Parent then
			return
		end
		if ok and type(info) == "table" then
			State.paidRandomRestricted[player] = info.ArePaidRandomItemsRestricted == true
			State.dirty(player)
			return
		end
		task.wait(attempt * 2)
	end
end

local connections: { [Player]: RBXScriptConnection } = {}

local function onPlayerAdded(player: Player)
	State.init(player)
	task.spawn(loadPolicy, player)
	Leaderboard.setup(player)
	connections[player] = player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)
	Data.load(player)
	if not player.Parent then
		Data.release(player)
		return
	end
	Monetization.loadPasses(player)
	if not player.Parent then
		-- left while the pass check was in flight: PlayerRemoving already ran, so nothing may be
		-- (re)created for this player now (State.ready, plot owner...) or it would leak forever
		Data.release(player)
		State.cleanup(player)
		return
	end
	Pets.clampEquipped(player)
	Offline.compute(player) -- needs passes + equipped pets for the tap value
	QuestService.ensure(player)
	Plots.assign(player)
	State.ready[player] = true
	Social.onJoin(player)
	LiveEventService.sendTo(player)
	Rewards.refreshFriends()
	State.sendFull(player)
	if player.Character then
		onCharacter(player, player.Character)
	end
	if not Data.isPersistent(player) then
		Remotes.notify(player, Locale.m("msg.no_save"), "error")
	end
end

local function onPlayerRemoving(player: Player)
	local conn = connections[player]
	if conn then
		conn:Disconnect()
		connections[player] = nil
	end
	Plots.release(player)
	Data.release(player)
	State.cleanup(player)
	Remotes.forget(player)
	Tapping.forget(player)
	task.defer(Rewards.refreshFriends)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="31">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Auto</string>
            <string name="Source"><![CDATA[--!strict
-- The "auto" toggles: Auto Tap, Auto Equip Best and Auto Rebirth. (Auto Hatch lives in Eggs,
-- because it is bound to the egg the player stands next to.)
--
-- Everything runs on the server and at the server's pace: the client only flips a saved
-- switch with SetAuto (rate limited like every Request) and the loops in Tapping / Eggs do
-- the work, so it keeps going while the player is AFK and no remote is ever spammed.
--
--  * Auto Tap    free, 1 tap/s while the player isn't tapping (the same rate as offline
--                earnings), +1/s per "Auto Tap" gem upgrade level, +5/s always with the pass.
--  * Auto Equip  re-runs Equip Best whenever the inventory changes.
--  * Auto Rebirth rebirths as soon as it is affordable. Free after 3 manual ones; the pass opens it after the first.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local M = Locale.m
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Hooks = require(script.Parent.Hooks)
local Guard = require(script.Parent.Guard)
local Pets = require(script.Parent.Pets)
local Progression = require(script.Parent.Progression)

local Auto = {}

local KEYS = { tap = "autoTap", equip = "autoEquip", rebirth = "autoRebirth" }

function Auto.rebirthUnlocked(player: Player, p: Data.Profile): boolean
	return Formulas.autoRebirthUnlocked(p.rebirths, State.passes[player] or {})
end

-- Returns ok, message.
function Auto.set(player: Player, key: string, on: boolean): (boolean, Locale.Message?)
	local p = Data.get(player)
	local field = KEYS[key]
	if not p or not field then
		return false, M("msg.bad_request")
	end
	if key == "rebirth" and on and not Auto.rebirthUnlocked(player, p) then
		return false, M("msg.autorebirth_locked", { n = Config.AutoRebirthMinRebirths })
	end
	local settings = p.settings :: { [string]: boolean }
	settings[field] = on
	if key == "equip" and on then
		Pets.equipBest(player)
	end
	State.dirty(player)
	return true
end

function Auto.init()
	Remotes.handle("SetAuto", function(player, payload)
		if not Guard.str(payload.key, 12) then
			return false, M("msg.bad_request")
		end
		return Auto.set(player, payload.key, payload.on == true)
	end)

	-- Auto Equip: a hatch or a craft may have produced something stronger
	local function reequip(player: Player)
		local p = Data.get(player)
		if p and p.settings.autoEquip then
			Pets.equipBest(player)
		end
	end
	Hooks.on("hatched", reequip)
	Hooks.on("crafted", reequip)

	-- Auto Rebirth: checked once a second by the Tapping loop
	Hooks.on("second", function(player: Player, p: Data.Profile)
		if p.settings.autoRebirth and Auto.rebirthUnlocked(player, p) and p.taps >= Formulas.rebirthCost(p.rebirths) then
			Progression.rebirth(player)
		end
	end)

	State.extras.auto = function(player, p)
		local idle = Formulas.autoTapRate(p.upgrades.AutoTap or 0, State.owns(player, "AutoTap"), true)
		return {
			tap = p.settings.autoTap,
			equip = p.settings.autoEquip,
			rebirth = p.settings.autoRebirth,
			rebirthUnlocked = Auto.rebirthUnlocked(player, p),
			tapRate = idle, -- taps per second while idle
			hatchFast = State.owns(player, "AutoHatch"),
		}
	end
end

return Auto
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Data</string>
            <string name="Source"><![CDATA[--!strict
-- Player profiles: DataStore load/save with a soft session lock, reconcile, autosave
-- and BindToClose. Adapted from Crop Kingdom.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Guard = require(script.Parent.Guard)

local Data = {}

export type PetEntry = { id: string, tier: number, locked: boolean, trait: number? }

export type Profile = {
	version: number,
	taps: number,
	gems: number,
	dice: number, -- Trait Dice (earned by playing, never sold)
	totalTaps: number,
	rebirths: number,
	zones: { number }, -- unlocked zone indexes
	pets: { [string]: PetEntry }, -- uid -> pet
	equipped: { string }, -- uids
	nextUid: number,
	upgrades: { [string]: number },
	discovered: { [string]: boolean },
	indexClaimed: { [string]: boolean }, -- tostring(zone) -> claimed
	daily: { last: number, streak: number },
	codes: { [string]: boolean },
	purchases: { string }, -- recent processed receipt PurchaseIds (idempotency)
	luckBoostLeft: number, -- seconds of Super Luck remaining (ticks while online)
	settings: { autoTap: boolean, autoEquip: boolean, autoRebirth: boolean },
	lang: string, -- UI language code, "" = use the account locale
	offlinePending: number, -- taps collected while away, waiting to be claimed
	offlineSeconds: number,
	referredBy: number, -- inviter user id (0 = none)
	referralPaid: boolean, -- inviter credited after our first 10 minutes
	referralRewards: number, -- inviter-side rewards received (lifetime cap)
	starterBought: boolean,
	ads: { day: number, count: number },
	tapBoostLeft: number, -- seconds of rewarded-video x2 taps
	quests: { day: number, list: { { kind: string, target: number, gems: number } }, progress: { number }, claimed: { boolean }, bonusClaimed: boolean },
	notifAskedAt: number,
	groupGiftClaimed: boolean,
	totalHatched: number,
	savedAt: number,
	firstJoin: number,
	playTime: number,
	lock: { job: string, t: number }?,
}

local store: DataStore? = nil
local storeOk = false
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
		storeOk = true
	else
		warn("[Data] DataStore unavailable, progress will NOT save:", result)
	end
end

Data.profiles = {} :: { [Player]: Profile }
local loadedOk: { [Player]: boolean } = {}
local nextSave: { [Player]: number } = {}
local saving: { [Player]: boolean } = {} -- a write is in flight (writes per player never overlap)
local LOCK_TTL = 150
local SAVE_ATTEMPTS = 3 -- normal saves (autosave, receipts)
local RELEASE_ATTEMPTS = 5 -- leaving / server shutdown: worth trying harder
local shutdownDeadline = math.huge -- os.clock() by which BindToClose must be done

-- Profile schema version. Add a step { [oldVersion] = function(profile) ... end } below when a
-- release changes the shape of saved data; reconcile() runs them in order on load.
Data.VERSION = 1
local MIGRATIONS: { [number]: (any) -> () } = {}
local CURRENCY_KEYS = { "taps", "gems", "dice", "totalTaps", "rebirths", "nextUid", "luckBoostLeft", "tapBoostLeft", "offlinePending", "offlineSeconds", "referralRewards", "totalHatched", "playTime" }

-- True when saving is possible at all (false in Studio without API access, or if the store failed).
function Data.canPersist(): boolean
	return storeOk
end

-- DataStore budget left for UpdateAsync (1 when it cannot be read).
local function updateBudget(): number
	local n = 1
	pcall(function()
		n = DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.UpdateAsync)
	end)
	return n
end

-- Waits (bounded) until the write budget has room. Returns false when it never did.
local function waitBudget(maxWait: number): boolean
	local t0 = os.clock()
	while updateBudget() <= 0 do
		if os.clock() - t0 >= maxWait or os.clock() > shutdownDeadline then
			return false
		end
		task.wait(0.5)
	end
	return true
end

local function defaultProfile(): Profile
	local upgrades = {}
	for _, u in Config.Upgrades do
		upgrades[u.id] = 0
	end
	local p: Profile = {
		version = Data.VERSION,
		taps = 0,
		gems = 0,
		dice = Config.TraitDice.start,
		totalTaps = 0,
		rebirths = 0,
		zones = { 1 },
		pets = {},
		equipped = {},
		nextUid = 1,
		upgrades = upgrades,
		discovered = {},
		indexClaimed = {},
		daily = { last = 0, streak = 0 },
		codes = {},
		purchases = {},
		luckBoostLeft = 0,
		settings = { autoTap = true, autoEquip = false, autoRebirth = false },
		lang = "",
		offlinePending = 0,
		offlineSeconds = 0,
		referredBy = 0,
		referralPaid = false,
		referralRewards = 0,
		starterBought = false,
		ads = { day = 0, count = 0 },
		tapBoostLeft = 0,
		quests = { day = -1, list = {}, progress = {}, claimed = {}, bonusClaimed = false },
		notifAskedAt = 0,
		groupGiftClaimed = false,
		totalHatched = 0,
		savedAt = os.time(),
		firstJoin = os.time(),
		playTime = 0,
	}
	-- starter pet, equipped
	p.pets.p1 = { id = Config.StartingPet, tier = 0, locked = false }
	p.equipped = { "p1" }
	p.nextUid = 2
	p.discovered[Config.StartingPet] = true
	return p
end
Data.defaultProfile = defaultProfile

-- Fill keys added in later versions and drop content that no longer exists in Config.
local function reconcile(p: any): Profile
	local def = defaultProfile() :: any
	if type(p) ~= "table" then
		return def :: Profile
	end
	Guard.scrub(p) -- NaN / inf from an old bug or a corrupt write never enter the session
	for k, v in def do
		if p[k] == nil then
			p[k] = v
		end
	end
	Guard.fixTypes(p, def, Guard.deepCopy) -- wrong-typed fields fall back to the default
	Guard.migrate(p, MIGRATIONS, Data.VERSION)
	Guard.clampNonNegative(p, CURRENCY_KEYS)
	for _, u in Config.Upgrades do
		local lv = p.upgrades[u.id]
		p.upgrades[u.id] = if Guard.int(lv, 0, u.maxLevel) then lv else math.clamp(math.floor(tonumber(lv) or 0), 0, u.maxLevel)
	end
	local zones, seenZone = {}, {}
	for _, z in p.zones do
		if Guard.int(z, 1, #Config.Zones) and not seenZone[z] then
			seenZone[z] = true
			table.insert(zones, z)
		end
	end
	if not seenZone[1] then
		table.insert(zones, 1, 1)
	end
	p.zones = zones
	for uid, pet in p.pets do
		if type(pet) ~= "table" or not Formulas.PetById[pet.id] then
			p.pets[uid] = nil
		else
			pet.tier = math.clamp(tonumber(pet.tier) or 0, 0, 2)
			pet.locked = pet.locked == true
			local trait = tonumber(pet.trait)
			pet.trait = if trait and Config.TraitGrades[trait] then trait else nil
		end
	end
	local eq, seenEq = {}, {}
	for _, uid in p.equipped do
		if type(uid) == "string" and p.pets[uid] and not seenEq[uid] then
			seenEq[uid] = true
			table.insert(eq, uid)
		end
	end
	p.equipped = eq
	if type(p.settings) ~= "table" then
		p.settings = {}
	end
	for k, v in def.settings do
		if type(p.settings[k]) ~= "boolean" then
			p.settings[k] = v
		end
	end
	return p :: Profile
end

Data.reconcile = reconcile

local function key(player: Player): string
	return "u_" .. player.UserId
end

function Data.load(player: Player): Profile
	if not storeOk or not store then
		local p = defaultProfile()
		Data.profiles[player] = p
		loadedOk[player] = false
		return p
	end
	local ds = store :: DataStore
	local result: any = nil
	for attempt = 1, 6 do
		local lockedByOther = false
		waitBudget(10)
		local ok, err = pcall(function()
			ds:UpdateAsync(key(player), function(old: any)
				local now = os.time()
				if type(old) == "table" and type(old.lock) == "table" and old.lock.job ~= game.JobId and now - (tonumber(old.lock.t) or 0) < LOCK_TTL and attempt < 6 then
					lockedByOther = true
					return nil -- abort write, another server still owns the session
				end
				local p = if type(old) == "table" then reconcile(old) else defaultProfile()
				p.lock = { job = game.JobId, t = now }
				result = p
				return p
			end)
		end)
		if ok and not lockedByOther and result then
			break
		end
		if not ok then
			warn("[Data] load failed for", player.Name, err)
		end
		result = nil
		if RunService:IsStudio() and not ok then
			break -- Studio without API access: fail fast, play unsaved
		end
		task.wait(if lockedByOther then 5 else Guard.backoff(attempt, 2, 10))
		if not player.Parent then
			break
		end
	end
	if not result then
		-- Never overwrite real data with a blank profile: keep this session unsaved.
		warn("[Data] could not load", player.Name, "- session will not save")
		result = defaultProfile()
		loadedOk[player] = false
	else
		loadedOk[player] = true
	end
	Data.profiles[player] = result
	return result
end

-- Writes the profile with UpdateAsync (never a blind overwrite): it aborts if another server
-- holds a fresh session lock, retries with exponential backoff, waits for write budget, and
-- never lets two writes for the same player overlap. Returns true when the data was written.
function Data.save(player: Player, release: boolean?): boolean
	local p = Data.profiles[player]
	if not p or not loadedOk[player] or not store then
		return false
	end
	if saving[player] then
		local t0 = os.clock()
		while saving[player] and os.clock() - t0 < 20 do
			task.wait(0.1)
		end
		if saving[player] or Data.profiles[player] ~= p then
			return false
		end
	end
	saving[player] = true
	local ds = store :: DataStore
	local attempts = if RunService:IsStudio() then 1 elseif release then RELEASE_ATTEMPTS else SAVE_ATTEMPTS
	local wrote = false
	for attempt = 1, attempts do
		if attempt > 1 and os.clock() > shutdownDeadline then
			break
		end
		if not waitBudget(if release then 10 else 5) and attempt > 1 then
			break
		end
		local fixed = Guard.scrub(p) -- never save NaN / inf
		Guard.clampNonNegative(p :: any, CURRENCY_KEYS)
		if fixed > 0 then
			warn("[Data] scrubbed", fixed, "non-finite values before saving", player.Name)
		end
		p.savedAt = os.time()
		p.lock = if release then nil else { job = game.JobId, t = os.time() }
		local aborted = false
		local ok, err = pcall(function()
			ds:UpdateAsync(key(player), function(old: any)
				if type(old) == "table" and type(old.lock) == "table" and old.lock.job ~= game.JobId and os.time() - (tonumber(old.lock.t) or 0) < LOCK_TTL then
					aborted = true
					return nil -- another server owns it now; don't clobber
				end
				wrote = true
				return p
			end)
		end)
		if ok then
			break -- written, or deliberately aborted by the lock check (retrying cannot help)
		end
		wrote = false
		warn("[Data] save failed for", player.Name, "attempt", attempt, err)
		if aborted or attempt >= attempts then
			break
		end
		task.wait(Guard.backoff(attempt, 1, 8))
	end
	saving[player] = nil
	return wrote
end

function Data.release(player: Player)
	Data.save(player, true)
	Data.profiles[player] = nil
	loadedOk[player] = nil
	nextSave[player] = nil
	saving[player] = nil
end

-- Per-player bookkeeping tables still holding this player (leak check in the playtest).
function Data.tracked(player: Player): number
	local n = 0
	for _, t in { Data.profiles, loadedOk, nextSave, saving } :: { { [Player]: any } } do
		if t[player] ~= nil then
			n += 1
		end
	end
	return n
end

function Data.get(player: Player): Profile?
	return Data.profiles[player]
end

function Data.isPersistent(player: Player): boolean
	return loadedOk[player] == true
end

function Data.startAutosave()
	-- Staggered: each player is saved once per AutosaveInterval, spread over the interval by
	-- the order they joined, and only while the DataStore write budget has room. No burst
	-- of writes every 90 s, however many players are in the server.
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			for _, player in Players:GetPlayers() do
				local due = nextSave[player]
				if not due then
					nextSave[player] = now + Config.AutosaveInterval
				elseif now >= due and Data.profiles[player] and not saving[player] then
					if updateBudget() > 0 then
						nextSave[player] = now + Config.AutosaveInterval
						task.spawn(Data.save, player)
						break -- at most one save per second
					end
				end
			end
		end
	end)
	game:BindToClose(function()
		if RunService:IsStudio() and not storeOk then
			return
		end
		shutdownDeadline = os.clock() + 25
		local pending = 0
		for _, player in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				Data.save(player, true)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.1)
		end
	end)
end

return Data
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Eggs</string>
            <string name="Source"><![CDATA[--!strict
-- Egg hatching: server-side validation (zone owned, distance to egg, cooldown, price,
-- inventory room), weighted roll with luck, golden chance, rare-hatch broadcast, auto-hatch.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local M = Locale.m
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Pets = require(script.Parent.Pets)
local Hooks = require(script.Parent.Hooks)
local Guard = require(script.Parent.Guard)

local Eggs = {}

export type HatchResult = { uid: string, id: string, tier: number, chance: number, rarity: string, new: boolean? }

local rng = Random.new()
local eggPositions: { [string]: Vector3 } = {}

local function broadcast(player: Player, r: HatchResult)
	local pet = Formulas.PetById[r.id]
	local rarity = Config.RarityByName[pet.rarity]
	if rarity and rarity.broadcast then
		Remotes.fireAll("Toast", {
			player = player.DisplayName,
			pet = pet.id,
			rarity = pet.rarity,
			tier = r.tier,
			chance = r.chance,
		})
	end
end

-- Rolls and grants `count` pets from an egg with no cost/distance checks.
local function rollInto(player: Player, eggId: string, count: number, force: boolean): { HatchResult }
	local p = Data.get(player) :: Data.Profile
	local luck = State.luck(player, p)
	local goldenChance = State.goldenChance(player)
	local results: { HatchResult } = {}
	for _ = 1, count do
		local petId, chance = Formulas.roll(eggId, luck, rng:NextNumber())
		local tier = if rng:NextNumber() < goldenChance then 1 else 0
		local isNew = not p.discovered[petId] -- first time this player sees the pet (NEW! badge)
		local uid = Pets.add(player, petId, tier, force)
		if uid then
			local r: HatchResult = { uid = uid, id = petId, tier = tier, chance = chance, rarity = Formulas.PetById[petId].rarity, new = isNew }
			table.insert(results, r)
			broadcast(player, r)
		end
	end
	p.totalHatched += #results
	State.dirty(player)
	Hooks.fire("hatched", player, results, eggId)
	return results
end

function Eggs.hatch(player: Player, eggId: string, count: number): (boolean, any)
	local p = Data.get(player)
	local egg = Formulas.EggById[eggId]
	if not p or not egg or egg.exclusive then
		return false, M("msg.unknown_egg")
	end
	if not Formulas.validHatchCount(count) then
		return false, M("msg.bad_amount")
	end
	if count > Formulas.maxHatch(State.passes[player] or {}) then
		return false, M(if count == Config.OctoHatchCount then "msg.need_x8" else "msg.need_x3")
	end
	if not State.hasZone(p, egg.zone) then
		return false, M("msg.unlock_first", { zone = M("zone." .. Config.Zones[egg.zone].id) })
	end
	if not Formulas.eggUnlocked(eggId, p.rebirths) then
		return false, M("msg.egg_needs_rebirth", { n = Formulas.eggMinRebirths(eggId) })
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local pos = eggPositions[eggId]
	if not root or not pos or (root.Position - pos).Magnitude > Config.EggRange then
		return false, M("msg.get_closer")
	end
	local now = os.clock()
	if now - (State.lastHatch[player] or 0) < Config.HatchCooldown - 0.2 then
		return false, "cooldown"
	end
	if not Pets.hasRoom(player, p, count) then
		return false, M("msg.inventory_full")
	end
	local cost = egg.price * count
	if not State.spendTaps(player, cost) then
		return false, M("msg.not_enough_taps")
	end
	State.lastHatch[player] = now
	return true, rollInto(player, eggId, count, false)
end

-- Exclusive (Robux / reward) Magic Egg: no taps, no distance, never blocked by a full inventory.
function Eggs.hatchExclusive(player: Player, count: number): { HatchResult }
	local results = rollInto(player, "magic", count, true)
	Remotes.fire("Hatched", player, { egg = "magic", results = results, auto = false })
	return results
end

function Eggs.init(positions: { [string]: Vector3 })
	eggPositions = positions

	Remotes.handle("Hatch", function(player, payload)
		if not Guard.str(payload.egg, 24) then
			return false, M("msg.unknown_egg")
		end
		-- anything that is not a known hatch size is rejected by Eggs.hatch
		local count = if payload.count == nil then 1 else payload.count
		return Eggs.hatch(player, payload.egg, count)
	end)

	Remotes.handle("SetAutoHatch", function(player, payload)
		if payload.egg == nil then
			State.autoHatch[player] = nil
			State.dirty(player)
			return true
		end
		local egg = if Guard.str(payload.egg, 24) then Formulas.EggById[payload.egg] else nil
		if not egg or egg.exclusive then
			return false, M("msg.unknown_egg")
		end
		local pd = Data.get(player)
		if not pd or not Formulas.eggUnlocked(egg.id, pd.rebirths) then
			return false, M("msg.egg_needs_rebirth", { n = Formulas.eggMinRebirths(egg.id) })
		end
		State.autoHatch[player] = payload.egg
		State.dirty(player)
		return true
	end)

	-- Auto hatch loop
	task.spawn(function()
		while true do
			task.wait(0.25)
			for _, player in Players:GetPlayers() do
				local eggId = State.autoHatch[player]
				if eggId then
					-- free: x1 every AutoHatchFreeCooldown; Auto Hatch pass: full speed, at the biggest
					-- hatch size the player owns (x8 / x3) that they can pay for and have room for
					local fast = State.owns(player, "AutoHatch")
					if os.clock() - (State.lastHatch[player] or 0) >= (if fast then Config.HatchCooldown else Config.AutoHatchFreeCooldown) then
						local p = Data.get(player)
						local egg = Formulas.EggById[eggId]
						local count = 1
						if fast and p and egg then
							local room = State.maxInventory(player) - State.petCount(p)
							count = Formulas.autoHatchCount(Formulas.maxHatch(State.passes[player] or {}), p.taps, egg.price, room)
						end
						local ok, res = Eggs.hatch(player, eggId, count)
						if ok then
							Remotes.fire("Hatched", player, { egg = eggId, results = res, auto = true })
						elseif res ~= "cooldown" then
							State.lastHatch[player] = os.clock() -- back off a full cooldown
							-- out of room: stop instead of failing forever, and say why
							if type(res) == "table" and res.key == "msg.inventory_full" then
								State.autoHatch[player] = nil
								State.dirty(player)
								Remotes.notify(player, M("msg.autohatch_full"), "error")
							end
						end
					end
				end
			end
		end
	end)
end

return Eggs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Guard</string>
            <string name="Source"><![CDATA[--!strict
-- Pure validation / rate-limit helpers for everything a client can send (no Roblox APIs, so
-- tests/security_test.luau runs it with plain luau). Every remote handler goes through these:
-- assume the caller can send any type, NaN, inf, negatives, huge strings and huge tables.
local Guard = {}

-- Finite number (rejects NaN, +-inf and non-numbers).
function Guard.num(x: any): boolean
	return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
end

-- Integer in [min, max] (rejects fractions, NaN, inf, non-numbers).
function Guard.int(x: any, min: number, max: number): boolean
	return Guard.num(x) and x == math.floor(x) and x >= min and x <= max
end

-- String of 1..maxLen bytes (empty allowed with allowEmpty).
function Guard.str(x: any, maxLen: number, allowEmpty: boolean?): boolean
	if type(x) ~= "string" then
		return false
	end
	local n = #x
	return n <= maxLen and (n > 0 or allowEmpty == true)
end

-- Inventory ids look like "p123": short, no control characters.
function Guard.uid(x: any): boolean
	return type(x) == "string" and #x >= 2 and #x <= 12 and string.find(x, "^p%d+$") ~= nil
end

-- Member of a whitelist set { [value] = true }.
function Guard.oneOf(x: any, set: { [any]: any }): boolean
	return (type(x) == "string" or type(x) == "number") and x == x and set[x] ~= nil
end

-- Table with at most maxKeys entries (stops counting early, so a huge table costs O(maxKeys)).
function Guard.smallTable(t: any, maxKeys: number): boolean
	if type(t) ~= "table" then
		return false
	end
	local n = 0
	for _ in t do
		n += 1
		if n > maxKeys then
			return false
		end
	end
	return true
end

-- Array (1..n, no holes, no other keys) with at most maxLen entries.
function Guard.array(t: any, maxLen: number): boolean
	if type(t) ~= "table" then
		return false
	end
	local n = 0
	for k in t do
		n += 1
		if n > maxLen or type(k) ~= "number" or k ~= n then
			return false
		end
	end
	return true
end

---------------------------------------------------------------------------
-- Token bucket: rate tokens per second, burst capacity. One bucket per key (player).
---------------------------------------------------------------------------
export type Limiter = {
	rate: number,
	burst: number,
	buckets: { [any]: { tokens: number, t: number } },
}

function Guard.limiter(rate: number, burst: number): Limiter
	return { rate = rate, burst = burst, buckets = {} }
end

-- Takes up to `want` tokens (default 1, whole numbers only); returns how many were granted.
function Guard.take(l: Limiter, key: any, now: number, want: number?): number
	local b = l.buckets[key]
	if not b then
		b = { tokens = l.burst, t = now }
		l.buckets[key] = b
	end
	local dt = now - b.t
	if dt < 0 then
		dt = 0 -- clock never runs backwards for us
	end
	b.tokens = math.min(l.burst, b.tokens + dt * l.rate)
	b.t = now
	local w = want or 1
	if not Guard.num(w) or w < 1 then
		return 0
	end
	local granted = math.min(math.floor(w), math.floor(b.tokens))
	if granted <= 0 then
		return 0
	end
	b.tokens -= granted
	return granted
end

function Guard.allow(l: Limiter, key: any, now: number): boolean
	return Guard.take(l, key, now, 1) >= 1
end

function Guard.forget(l: Limiter, key: any)
	l.buckets[key] = nil
end

function Guard.count(l: Limiter): number
	local n = 0
	for _ in l.buckets do
		n += 1
	end
	return n
end

---------------------------------------------------------------------------
-- Save safety
---------------------------------------------------------------------------
-- Replaces NaN / +-inf anywhere in a (cycle-safe, depth-capped) table by 0. Returns how many were fixed.
function Guard.scrub(t: any, depth: number?, seen: { [any]: boolean }?): number
	local d = depth or 0
	local s = seen or {}
	if type(t) ~= "table" or d > 12 or s[t] then
		return 0
	end
	s[t] = true
	local fixed = 0
	for k, v in t do
		if type(v) == "number" then
			if v ~= v or v == math.huge or v == -math.huge then
				t[k] = 0
				fixed += 1
			end
		elseif type(v) == "table" then
			fixed += Guard.scrub(v, d + 1, s)
		end
	end
	return fixed
end

-- Currency-like top-level numbers can never be negative.
function Guard.clampNonNegative(t: { [string]: any }, keys: { string }): number
	local fixed = 0
	for _, k in keys do
		local v = t[k]
		if type(v) == "number" and v < 0 then
			t[k] = 0
			fixed += 1
		end
	end
	return fixed
end

-- Makes every key of `def` have the same type in `p` (wrong type -> the default's value, via copy()).
function Guard.fixTypes(p: { [string]: any }, def: { [string]: any }, copy: (any) -> any): number
	local fixed = 0
	for k, v in def do
		if p[k] ~= nil and type(p[k]) ~= type(v) then
			p[k] = copy(v)
			fixed += 1
		end
	end
	return fixed
end

function Guard.deepCopy(v: any, depth: number?): any
	if type(v) ~= "table" or (depth or 0) > 12 then
		return v
	end
	local out = {}
	for k, x in v do
		out[k] = Guard.deepCopy(x, (depth or 0) + 1)
	end
	return out
end

-- Runs migration steps { [fromVersion] = function(profile) } until `current`. A profile from a
-- NEWER version (rolled-back server) is left alone. Returns the version it ends at.
function Guard.migrate(p: { [string]: any }, steps: { [number]: (any) -> () }, current: number): number
	local v = p.version
	if not Guard.int(v, 0, 1e6) then
		v = 1
	end
	while v < current do
		local step = steps[v]
		if step then
			step(p)
		end
		v += 1
	end
	if v > current then
		return v
	end
	p.version = current
	return current
end

-- Backoff delay for retry number `attempt` (1-based): base * 2^(attempt-1), capped.
function Guard.backoff(attempt: number, base: number, cap: number): number
	return math.min(cap, base * 2 ^ (attempt - 1))
end

return Guard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Hooks</string>
            <string name="Source"><![CDATA[--!strict
-- Tiny in-process event bus so gameplay services can report what happened (hatched, taps,
-- crafted, gems spent, rebirth) without requiring the services that react to it
-- (quests, announcements, notification prompts). Avoids require cycles.
local Hooks = {}

local listeners: { [string]: { (...any) -> () } } = {}

function Hooks.on(name: string, fn: (...any) -> ())
	local list = listeners[name]
	if not list then
		list = {}
		listeners[name] = list
	end
	table.insert(list, fn)
end

function Hooks.fire(name: string, ...: any)
	local list = listeners[name]
	if not list then
		return
	end
	for _, fn in list do
		local ok, err = pcall(fn :: any, ...)
		if not ok then
			warn("[Hooks]", name, err)
		end
	end
end

return Hooks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Leaderboard</string>
            <string name="Source"><![CDATA[--!strict
-- leaderstats (player list) + global OrderedDataStore boards (Total Taps, Rebirths) shown
-- on the SurfaceGui boards in spawn. Total Taps is stored log-encoded so it never
-- overflows the OrderedDataStore integer range.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Data = require(script.Parent.Data)
local Guard = require(script.Parent.Guard)

local Leaderboard = {}

local SCALE = 1e9
local tapsStore: OrderedDataStore? = nil
local rebirthStore: OrderedDataStore? = nil
do
	local ok, err = pcall(function()
		tapsStore = DataStoreService:GetOrderedDataStore(Config.LeaderboardTapsStore)
		rebirthStore = DataStoreService:GetOrderedDataStore(Config.LeaderboardRebirthStore)
	end)
	if not ok then
		warn("[Leaderboard] OrderedDataStore unavailable:", err)
	end
end

local function encodeTaps(n: number): number
	if not Guard.num(n) then
		return 0 -- NaN / inf never reach the board
	end
	return math.floor(math.log10(math.max(1, n) + 1) * SCALE)
end

-- Last value written per player (leaderboards only go up; unchanged scores cost no request).
local lastPushed: { [number]: { taps: number, rebirths: number } } = {}

-- OrderedDataStore write that keeps the BEST value: a stale or reset session can never lower a score.
local function pushMax(store: OrderedDataStore, key: string, value: number)
	store:UpdateAsync(key, function(old: any): any
		if type(old) == "number" and old >= value then
			return nil :: any
		end
		return value :: any
	end)
end

local function budgetLeft(): boolean
	local n = 1
	pcall(function()
		n = DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.UpdateAsync)
	end)
	return n > 20 -- leave room for profile saves
end
local function decodeTaps(v: number): number
	return 10 ^ (v / SCALE) - 1
end

local nameCache: { [number]: string } = {}
local function nameOf(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local n = if ok and name then name else ("#" .. userId)
	nameCache[userId] = n
	return n
end

function Leaderboard.setup(player: Player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local taps = Instance.new("StringValue")
	taps.Name = "Taps"
	taps.Value = "0"
	taps.Parent = ls
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = ls
	ls.Parent = player
end

function Leaderboard.updateStats(player: Player)
	local p = Data.get(player)
	local ls = player:FindFirstChild("leaderstats")
	if not p or not ls then
		return
	end
	local taps = ls:FindFirstChild("Taps") :: StringValue?
	local rebirths = ls:FindFirstChild("Rebirths") :: IntValue?
	if taps then
		taps.Value = Format.abbrev(p.totalTaps)
	end
	if rebirths then
		rebirths.Value = p.rebirths
	end
end

local function pushScores()
	for _, player in Players:GetPlayers() do
		local p = Data.get(player)
		if p and Data.isPersistent(player) and budgetLeft() then
			local key = tostring(player.UserId)
			local last: { taps: number, rebirths: number } = lastPushed[player.UserId] or { taps = -1, rebirths = -1 }
			lastPushed[player.UserId] = last
			local taps = encodeTaps(p.totalTaps)
			if tapsStore and taps > last.taps then
				if pcall(pushMax, tapsStore :: OrderedDataStore, key, taps) then
					last.taps = taps
				end
			end
			local rb = if Guard.int(p.rebirths, 0, 1e9) then p.rebirths else 0
			if rebirthStore and rb > 0 and rb > last.rebirths then
				if pcall(pushMax, rebirthStore :: OrderedDataStore, key, rb) then
					last.rebirths = rb
				end
			end
		end
	end
end

local function renderBoard(board: BasePart, rows: { { name: string, value: string } })
	local gui = board:FindFirstChild("BoardGui")
	local list = gui and gui:FindFirstChild("List")
	if not list then
		return
	end
	for _, c in list:GetChildren() do
		if c:IsA("TextLabel") then
			c:Destroy()
		end
	end
	if #rows == 0 then
		rows = { { name = "No scores yet", value = "" } }
	end
	local medals = { Color3.fromRGB(255, 215, 60), Color3.fromRGB(220, 225, 235), Color3.fromRGB(230, 150, 90) }
	for i, row in rows do
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, 0.095, 0)
		t.Font = Enum.Font.FredokaOne
		t.TextScaled = true
		t.TextXAlignment = Enum.TextXAlignment.Left
		t.TextColor3 = medals[i] or Color3.new(1, 1, 1)
		t.Text = if row.value == "" then row.name else string.format("#%d  %s  —  %s", i, row.name, row.value)
		t.LayoutOrder = i
		if row.value == "" then
			t:SetAttribute("LocKey", "world.board_empty")
		end
		t.Parent = list
	end
end

local function fetch(store: OrderedDataStore?, decode: (number) -> string): { { name: string, value: string } }
	local rows = {}
	if not store then
		return rows
	end
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, 10)
	end)
	if not ok or not pages then
		return rows
	end
	for _, entry in (pages :: DataStorePages):GetCurrentPage() do
		local e = entry :: any
		table.insert(rows, { name = nameOf(tonumber(e.key) or 0), value = decode(e.value) })
	end
	return rows
end

function Leaderboard.init(boards: { [string]: BasePart })
	Players.PlayerRemoving:Connect(function(player)
		lastPushed[player.UserId] = nil
	end)
	task.spawn(function()
		while true do
			for _, player in Players:GetPlayers() do
				Leaderboard.updateStats(player)
			end
			task.wait(1)
		end
	end)
	task.spawn(function()
		task.wait(10)
		while true do
			pcall(pushScores)
			local ok, err = pcall(function()
				if boards.taps then
					renderBoard(boards.taps, fetch(tapsStore, function(v)
						return Format.abbrev(decodeTaps(v))
					end))
				end
				if boards.rebirths then
					renderBoard(boards.rebirths, fetch(rebirthStore, function(v)
						return tostring(v)
					end))
				end
			end)
			if not ok then
				warn("[Leaderboard]", err)
			end
			task.wait(Config.LeaderboardUpdateInterval)
		end
	end)
end

return Leaderboard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">LiveEventService</string>
            <string name="Source"><![CDATA[--!strict
-- Live events: the UTC schedule (Lucky Hour every 3 h, Golden Weekend) plus an admin override
-- (/event <id> <minutes>) shared across servers with MessagingService. Pushes the effects into
-- State.eventEffects (luck / golden multipliers) and tells clients through LiveEventUpdate.
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local Config = require(ReplicatedStorage.Shared.Config)
local LiveEvents = require(ReplicatedStorage.Shared.LiveEvents)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local M = Locale.m

local LiveEventService = {}

local TOPIC = "TPS_LiveEvent"
local override: LiveEvents.Override? = nil
local lastKey = ""

local function payload(): { [string]: any }
	local now = os.time()
	local active = LiveEvents.active(now, override)
	local nextAt, nextId = LiveEvents.nextStart(now)
	return { active = active, current = active[1], nextAt = nextAt, nextId = nextId, serverTime = now }
end

local function isAdmin(userId: number): boolean
	return table.find(Config.AdminUserIds, userId) ~= nil
end

-- Recomputes the active events; on change updates luck for everyone and notifies clients.
function LiveEventService.refresh(force: boolean?)
	local now = os.time()
	local active = LiveEvents.active(now, override)
	local parts = {}
	for _, a in active do
		table.insert(parts, a.id .. "@" .. a.endsAt)
	end
	local key = table.concat(parts, ",")
	if key == lastKey and not force then
		return
	end
	local started = {}
	for _, a in active do
		if not lastKey:find(a.id .. "@", 1, true) then
			table.insert(started, a.id)
		end
	end
	lastKey = key
	State.eventEffects = LiveEvents.effects(active)
	for _, player in Players:GetPlayers() do
		State.dirty(player)
	end
	local data = payload()
	data.started = started
	Remotes.fireAll("LiveEventUpdate", data)
end

function LiveEventService.sendTo(player: Player)
	Remotes.fire("LiveEventUpdate", player, payload())
end

function LiveEventService.setOverride(id: string, endsAt: number)
	override = { id = id, endsAt = endsAt }
	LiveEventService.refresh()
end

-- "/event LuckyHour 15" from an admin. Returns ok, message.
function LiveEventService.command(userId: number, text: string): (boolean, Locale.Message)
	if not isAdmin(userId) then
		return false, M("msg.admin_only")
	end
	local id, minutesText = text:match("^%s*/event%s+(%w+)%s+(%d+)%s*$")
	local minutes = tonumber(minutesText)
	if not id or not Config.LiveEventDefs[id] or not minutes or minutes < 1 or minutes > Config.LiveEventMaxMinutes then
		return false, M("msg.event_usage", { max = Config.LiveEventMaxMinutes })
	end
	local endsAt = os.time() + minutes * 60
	LiveEventService.setOverride(id, endsAt)
	if game.PlaceId ~= 0 then
		task.spawn(pcall, function()
			MessagingService:PublishAsync(TOPIC, { id = id, endsAt = endsAt })
		end)
	end
	return true, M("msg.event_started", { event = M("event." .. id), minutes = minutes })
end

function LiveEventService.init()
	State.eventEffects = LiveEvents.effects(LiveEvents.active(os.time(), nil))

	if game.PlaceId ~= 0 then
		task.spawn(function()
			pcall(function()
				MessagingService:SubscribeAsync(TOPIC, function(message)
					local d = message.Data
					if type(d) == "table" and type(d.id) == "string" and Config.LiveEventDefs[d.id] and type(d.endsAt) == "number" then
						override = { id = d.id, endsAt = math.min(d.endsAt, os.time() + Config.LiveEventMaxMinutes * 60) }
						LiveEventService.refresh()
					end
				end)
			end)
		end)
	end

	-- admin chat command
	task.spawn(function()
		local ok, err = pcall(function()
			local cmd = Instance.new("TextChatCommand")
			cmd.Name = "LiveEventCommand"
			cmd.PrimaryAlias = "/event"
			cmd.Triggered:Connect(function(source: TextSource, text: string)
				local player = Players:GetPlayerByUserId(source.UserId)
				if not player then
					return
				end
				local _, message = LiveEventService.command(source.UserId, text)
				Remotes.notify(player, message, "info")
			end)
			cmd.Parent = TextChatService:WaitForChild("TextChatCommands", 10) or TextChatService
		end)
		if not ok then
			warn("[LiveEvents] chat command unavailable:", err)
		end
	end)

	task.spawn(function()
		while true do
			LiveEventService.refresh()
			task.wait(1)
		end
	end)
end

return LiveEventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Monetization</string>
            <string name="Source"><![CDATA[--!strict
-- Game passes (ownership cache + purchase-finished grant) and developer products
-- (ProcessReceipt, idempotent by PurchaseId stored in the profile and saved before
-- returning PurchaseGranted).
local AdService = game:GetService("AdService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local M = Locale.m
local Data = require(script.Parent.Data)
local Guard = require(script.Parent.Guard)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Rewards = require(script.Parent.Rewards)
local Pets = require(script.Parent.Pets)
local Progression = require(script.Parent.Progression)
local Offline = require(script.Parent.Offline)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Format = require(ReplicatedStorage.Shared.Format)

local Monetization = {}

local MAX_RECEIPTS = 60
local adInFlight: { [Player]: boolean } = {}

local passByGamepassId: { [number]: typeof(Config.Passes[1]) } = {}
for _, pass in Config.Passes do
	if pass.id ~= 0 then
		passByGamepassId[pass.id] = pass
	end
end
local productById: { [number]: typeof(Config.Products[1]) } = {}
for _, product in Config.Products do
	if product.id ~= 0 then
		productById[product.id] = product
	end
end
local adPlacementById: { [number]: string } = {}
for placement, id in Config.AdProducts :: { [string]: number } do
	if id ~= 0 then
		adPlacementById[id] = placement
	end
end

-- Starter Pack: live product, not bought, within 24 h of the first join.
function Monetization.starterState(p: Data.Profile): { available: boolean, endsAt: number, price: number, fullPrice: number }
	local product = Config.ProductByKey.StarterPack
	local endsAt = p.firstJoin + Config.StarterPack.windowSeconds
	local available = product ~= nil and product.id ~= 0 and not p.starterBought and os.time() < endsAt
	return { available = available, endsAt = endsAt, price = if product then product.price else 0, fullPrice = Config.StarterPack.fullPrice }
end

local function adDay(): number
	return os.time() // 86400
end

local function adsLeft(p: Data.Profile): number
	if p.ads.day ~= adDay() then
		return Config.AdDailyCap
	end
	return math.max(0, Config.AdDailyCap - p.ads.count)
end

-- Grants an ad placement's reward (called from ProcessReceipt).
local function grantAd(player: Player, p: Data.Profile, placement: string)
	if placement == "AdBoost" then
		p.tapBoostLeft += Config.AdBoostMinutes * 60
		State.dirty(player)
		Remotes.notify(player, M("msg.ad_boost", { n = Config.AdBoostMinutes }), "success")
	elseif placement == "AdOffline" then
		local amount = Offline.claim(player, 2)
		if amount <= 0 then
			amount = Formulas.tapsForMinutes(Config.AdOfflineFallbackMinutes, State.tapValue(player, p))
			State.addTaps(player, amount, false)
		end
		Remotes.notify(player, M("reward.taps", { n = Format.abbrev(amount) }), "success")
	end
end

local function onPassChanged(player: Player)
	Pets.clampEquipped(player)
	Progression.applyWalkSpeed(player)
	State.dirty(player)
	State.replicateEquipped(player)
end

-- Called once per join (yields on web calls).
function Monetization.loadPasses(player: Player)
	local owned = State.passes[player] or {}
	State.passes[player] = owned
	local grantAll = Config.StudioGrantAllPasses and RunService:IsStudio()
	for _, pass in Config.Passes do
		if grantAll then
			owned[pass.key] = true
		elseif pass.id ~= 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.id)
			end)
			if ok and has then
				owned[pass.key] = true
			end
		end
	end
	Formulas.applyIncluded(owned) -- x8 Hatch includes x3 Hatch
end

local function grantReceipt(player: Player, p: Data.Profile, receipt: any, purchaseId: string): Enum.ProductPurchaseDecision
	if table.find(p.purchases, purchaseId) then
		-- Granted earlier in this session. Acknowledge only once it is really on disk (the first
		-- attempt's save may have failed; the marker lives in memory until a save succeeds).
		if Data.isPersistent(player) and not Data.save(player) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local product = productById[receipt.ProductId]
	local adPlacement = adPlacementById[receipt.ProductId]
	if not product and not adPlacement then
		warn("[Monetization] unknown product", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local ok, err = pcall(function()
		if adPlacement then
			grantAd(player, p, adPlacement)
		elseif product and product.kind == "starter" then
			p.starterBought = true
			State.addGems(player, Config.StarterPack.gems)
			p.luckBoostLeft += Config.StarterPack.luckMinutes * 60
			Rewards.grant(player, { kind = "egg", amount = Config.StarterPack.eggs })
			State.dirty(player)
		elseif product then
			Rewards.grant(player, { kind = product.kind, amount = product.amount, label = product.name })
		end
	end)
	if not ok then
		warn("[Monetization] grant failed", err)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(p.purchases, purchaseId)
	while #p.purchases > MAX_RECEIPTS do
		table.remove(p.purchases, 1)
	end
	-- Persist before acknowledging, so a crash can't grant twice or lose the purchase.
	if Data.isPersistent(player) and not Data.save(player) then
		-- (a lock abort or a failed write both land here)
		-- Keep the marker in memory: when Roblox retries, the marker short-circuits to
		-- PurchaseGranted once a later save succeeds; if the server dies first, both the
		-- grant and the marker are lost together and the retry grants it again.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if product then
		Remotes.notify(player, M("msg.thanks", { item = M("product." .. product.key .. ".name") }), "success")
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local receiptBusy: { [string]: boolean } = {} -- PurchaseIds being granted right now

local function processReceipt(receipt: any): Enum.ProductPurchaseDecision
	if type(receipt) ~= "table" or not Guard.int(receipt.PlayerId, 1, 2 ^ 52) or not Guard.int(receipt.ProductId, 1, 2 ^ 52) or receipt.PurchaseId == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local p = Data.get(player)
	if not p or not State.ready[player] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- The profile failed to load (DataStore down): granting now would be lost on leave, yet
	-- acknowledged. Roblox retries the receipt on the next join / next call.
	if Data.canPersist() and not Data.isPersistent(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	if receiptBusy[purchaseId] then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- same receipt already in flight (yielding save)
	end
	receiptBusy[purchaseId] = true
	local decision = Enum.ProductPurchaseDecision.NotProcessedYet
	local okCall, res = pcall(function()
		decision = grantReceipt(player, p, receipt, purchaseId)
	end)
	receiptBusy[purchaseId] = nil
	if not okCall then
		warn("[Monetization] receipt error", res)
	end
	return decision
end

function Monetization.init()
	MarketplaceService.ProcessReceipt = processReceipt

	State.extras.starter = function(player, p)
		local st = Monetization.starterState(p)
		-- the pack contains an egg, so the whole pack is a paid random item
		if State.paidRandomRestricted[player] ~= false then
			st.available = false
		end
		return st
	end
	State.extras.ads = function(_player, p)
		return { left = adsLeft(p), boost = Config.AdProducts.AdBoost ~= 0, offline = Config.AdProducts.AdOffline ~= 0 }
	end

	-- Rewarded video: validate the placement and daily cap, then show the ad. The reward
	-- itself arrives through ProcessReceipt (the ad is tied to a developer product).
	Remotes.handle("WatchAd", function(player, payload)
		local p = Data.get(player)
		local placement = payload.placement
		local id = if Guard.str(placement, 24) then (Config.AdProducts :: any)[placement] else nil
		if not p or type(id) ~= "number" then
			return false, M("msg.ad_unavailable")
		end
		if id == 0 then
			return false, M("msg.ad_unavailable")
		end
		if adsLeft(p) <= 0 then
			return false, M("msg.ad_cap")
		end
		if adInFlight[player] then
			return false, M("msg.slow_down") -- one ad at a time (the call yields; no parallel cap bypass)
		end
		if p.ads.day ~= adDay() then
			p.ads = { day = adDay(), count = 0 }
		end
		adInFlight[player] = true
		local ok, result = pcall(function()
			local reward = (AdService :: any):CreateAdRewardFromDevProductId(id)
			return (AdService :: any):ShowRewardedVideoAdAsync(player, reward)
		end)
		adInFlight[player] = nil
		if not ok then
			warn("[Monetization] ad failed", result)
			return false, M("msg.ad_unavailable")
		end
		if p.ads.day ~= adDay() then
			p.ads = { day = adDay(), count = 0 }
		end
		p.ads.count += 1
		State.dirty(player)
		return true, tostring(if typeof(result) == "EnumItem" then (result :: any).Name else result)
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		adInFlight[player] = nil
	end)

	-- Server-side event (a client cannot fire it); only known pass ids of a loaded session count.
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, gamePassId: number, purchased: boolean)
		if purchased ~= true or not Guard.int(gamePassId, 1, 2 ^ 52) or not State.ready[player] then
			return
		end
		local pass = passByGamepassId[gamePassId]
		if pass then
			State.passes[player] = State.passes[player] or {}
			State.passes[player][pass.key] = true
			Formulas.applyIncluded(State.passes[player])
			onPassChanged(player)
			Remotes.notify(player, M("msg.pass_unlocked", { item = M("pass." .. pass.key .. ".name") }), "success")
		end
	end)
end

return Monetization
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Offline</string>
            <string name="Source"><![CDATA[--!strict
-- Offline earnings: on join, time since the last save (capped at 8 h, 12 h with VIP) x tap
-- value x Config.OfflineTapsPerSecond becomes offlinePending, claimed with ClaimOffline.
-- An unclaimed amount is kept and only replaced by a larger one.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Format = require(ReplicatedStorage.Shared.Format)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local M = Locale.m

local Offline = {}

function Offline.capSeconds(player: Player): number
	return (if State.owns(player, "VIP") then Config.OfflineCapHoursVIP else Config.OfflineCapHours) * 3600
end

-- Call after passes and equipped pets are loaded (uses the live tap value).
function Offline.compute(player: Player, now: number?)
	local p = Data.get(player)
	if not p then
		return
	end
	local t = now or os.time()
	local cap = Offline.capSeconds(player)
	local seconds = math.clamp(t - (p.savedAt or t), 0, cap)
	if seconds < Config.OfflineMinSeconds then
		return
	end
	local amount = Formulas.offlineEarnings(State.tapValue(player, p), seconds, cap)
	if amount > (p.offlinePending or 0) then
		p.offlinePending = amount
		p.offlineSeconds = seconds
		State.dirty(player)
	end
end

-- Grants the pending taps (x mult). Returns the amount granted.
function Offline.claim(player: Player, mult: number?): number
	local p = Data.get(player)
	if not p or (p.offlinePending or 0) <= 0 then
		return 0
	end
	local amount = p.offlinePending * (mult or 1)
	p.offlinePending = 0
	p.offlineSeconds = 0
	State.addTaps(player, amount)
	State.dirty(player)
	return amount
end

function Offline.init()
	State.extras.offline = function(_player, p)
		return { pending = p.offlinePending or 0, seconds = p.offlineSeconds or 0 }
	end
	Remotes.handle("ClaimOffline", function(player)
		local amount = Offline.claim(player, 1)
		if amount <= 0 then
			return false, M("msg.nothing_to_claim")
		end
		return true, M("reward.taps", { n = Format.abbrev(amount) })
	end)
end

return Offline
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Pets</string>
            <string name="Source"><![CDATA[--!strict
-- Pet inventory: add, equip / unequip / equip best, delete, lock, craft Golden/Rainbow.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local M = Locale.m
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Hooks = require(script.Parent.Hooks)
local Guard = require(script.Parent.Guard)

local Pets = {}
Pets.giveDice = function(_player: Player, _n: number) end
local traitRng = Random.new()

local function power(profile: Data.Profile, uid: string): number
	local pet = profile.pets[uid]
	if not pet then
		return 0
	end
	return Formulas.petPower(pet.id, pet.tier, State.maxZone(profile), pet.trait)
end

function Pets.hasRoom(player: Player, profile: Data.Profile, count: number): boolean
	return State.petCount(profile) + count <= State.maxInventory(player)
end

-- Adds a pet (auto-equips it if a slot is free). Returns the uid, or nil if the inventory is full.
-- force = true ignores the inventory cap (paid pets must never be lost).
function Pets.add(player: Player, petId: string, tier: number, force: boolean?): string?
	local p = Data.get(player)
	if not p or not Formulas.PetById[petId] then
		return nil
	end
	if not force and not Pets.hasRoom(player, p, 1) then
		return nil
	end
	local uid = "p" .. p.nextUid
	p.nextUid += 1
	p.pets[uid] = { id = petId, tier = tier, locked = false }
	p.discovered[petId] = true
	if #p.equipped < State.maxEquip(player, p) then
		table.insert(p.equipped, uid)
	end
	State.dirty(player)
	return uid
end

-- Trim equipped list if slots shrank (e.g. pass revoked in Studio testing).
function Pets.clampEquipped(player: Player)
	local p = Data.get(player)
	if not p then
		return
	end
	local max = State.maxEquip(player, p)
	while #p.equipped > max do
		table.remove(p.equipped)
	end
end

function Pets.equipBest(player: Player)
	local p = Data.get(player)
	if not p then
		return
	end
	local uids = {}
	for uid in p.pets do
		table.insert(uids, uid)
	end
	table.sort(uids, function(a, b)
		local pa, pb = power(p, a), power(p, b)
		if pa == pb then
			return a < b
		end
		return pa > pb
	end)
	local max = State.maxEquip(player, p)
	local eq = {}
	for i = 1, math.min(max, #uids) do
		eq[i] = uids[i]
	end
	p.equipped = eq
	State.dirty(player)
end

local function removePet(p: Data.Profile, uid: string)
	p.pets[uid] = nil
	local i = table.find(p.equipped, uid)
	if i then
		table.remove(p.equipped, i)
	end
end

function Pets.init()
	Remotes.handle("Equip", function(player, payload)
		local p = Data.get(player)
		local uid = payload.uid
		if not p or not Guard.uid(uid) or not p.pets[uid] then
			return false, M("msg.unknown_pet")
		end
		if table.find(p.equipped, uid) then
			return true
		end
		if #p.equipped >= State.maxEquip(player, p) then
			return false, M("msg.slots_full")
		end
		table.insert(p.equipped, uid)
		State.dirty(player)
		return true
	end)

	Remotes.handle("Unequip", function(player, payload)
		local p = Data.get(player)
		if not p or not Guard.uid(payload.uid) then
			return false, M("msg.unknown_pet")
		end
		local i = table.find(p.equipped, payload.uid)
		if i then
			table.remove(p.equipped, i)
			State.dirty(player)
		end
		return true
	end)

	Remotes.handle("EquipBest", function(player)
		Pets.equipBest(player)
		return true
	end)

	Remotes.handle("Lock", function(player, payload)
		local p = Data.get(player)
		if not p or not Guard.uid(payload.uid) or not p.pets[payload.uid] then
			return false, M("msg.unknown_pet")
		end
		p.pets[payload.uid].locked = payload.locked == true
		State.dirty(player)
		return true
	end)

	Remotes.handle("Delete", function(player, payload)
		local p = Data.get(player)
		if not p or not Guard.array(payload.uids, 400) then
			return false, M("msg.bad_request")
		end
		local n = 0
		for _, uid in payload.uids do
			if n >= 200 then
				break
			end
			if Guard.uid(uid) then
				local pet = p.pets[uid]
				if pet and not pet.locked then
					removePet(p, uid)
					n += 1
				end
			end
		end
		if n == 0 then
			return false, M("msg.nothing_deleted")
		end
		State.dirty(player)
		return true, n
	end)

	-- Trait roll: spends Trait Dice, always gives a grade (it replaces the old one).
	Remotes.handle("RollTrait", function(player, payload)
		local p = Data.get(player)
		local pet = if p and Guard.uid(payload.uid) then p.pets[payload.uid] else nil
		if not p or not pet then
			return false, M("msg.unknown_pet")
		end
		if p.dice < Config.TraitRollCost then
			return false, M("msg.no_dice")
		end
		p.dice -= Config.TraitRollCost
		local grade = Formulas.rollTrait(traitRng:NextNumber())
		pet.trait = grade
		State.dirty(player)
		Hooks.fire("traitRolled", player, grade)
		return true, grade
	end)

	-- Trait Dice come from playing: rebirths, daily quests, index pages
	local function giveDice(player: Player, n: number)
		local p = Data.get(player)
		if p and n > 0 then
			p.dice += n
			State.dirty(player)
			Remotes.notify(player, M("msg.got_dice", { n = n }), "success")
		end
	end
	Pets.giveDice = giveDice
	Hooks.on("rebirth", function(player: Player)
		giveDice(player, Config.TraitDice.rebirth)
	end)
	Hooks.on("questClaimed", function(player: Player, bonus: boolean)
		giveDice(player, if bonus then Config.TraitDice.questBonus else Config.TraitDice.quest)
	end)
	Hooks.on("indexClaimed", function(player: Player)
		giveDice(player, Config.TraitDice.index)
	end)

	-- Craft: consumes CraftCost unlocked pets with the same id+tier as payload.uid.
	Remotes.handle("Craft", function(player, payload)
		local p = Data.get(player)
		if not p or not Guard.uid(payload.uid) then
			return false, M("msg.unknown_pet")
		end
		local base = p.pets[payload.uid]
		if not base then
			return false, M("msg.unknown_pet")
		end
		if base.tier >= 2 then
			return false, M("msg.already_rainbow")
		end
		local sameEquipped, sameFree = {}, {}
		for uid, pet in p.pets do
			if pet.id == base.id and pet.tier == base.tier and (not pet.locked or uid == payload.uid) then
				if table.find(p.equipped, uid) then
					table.insert(sameEquipped, uid)
				else
					table.insert(sameFree, uid)
				end
			end
		end
		if #sameEquipped + #sameFree < Config.CraftCost then
			return false, M("msg.need_craft", { n = Config.CraftCost, tier = M("tier." .. base.tier) })
		end
		-- use unequipped copies first
		local used = {}
		for _, uid in sameFree do
			if #used < Config.CraftCost then
				table.insert(used, uid)
			end
		end
		for _, uid in sameEquipped do
			if #used < Config.CraftCost then
				table.insert(used, uid)
			end
		end
		local wasEquipped = false
		for _, uid in used do
			if table.find(p.equipped, uid) then
				wasEquipped = true
			end
			removePet(p, uid)
		end
		local newTier = base.tier + 1
		local uid = Pets.add(player, base.id, newTier, true) :: string
		if wasEquipped and not table.find(p.equipped, uid) then
			table.insert(p.equipped, uid)
		end
		Remotes.notify(player, M("msg.crafted", { pet = M("pet.tiered", { tier = M("tier." .. newTier), pet = M("pet." .. base.id) }) }), "success")
		State.dirty(player)
		Hooks.fire("crafted", player, newTier)
		return true, uid
	end)
end

return Pets
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Plots</string>
            <string name="Source"><![CDATA[--!strict
-- Pet Park: every player gets a plot behind the spawn plaza. Their equipped pets stand on
-- its pedestals (drawn by each client: ParkFx) and the chest holds what the pets collected
-- while the player was away - the same offline earnings as before, now something you can
-- walk up to, see and open. Nothing new is earned here, so the economy is unchanged.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)
local Format = require(ReplicatedStorage.Shared.Format)
local M = Locale.m
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Offline = require(script.Parent.Offline)
local WorldBuilder = require(script.Parent.Parent.World.WorldBuilder)

local Plots = {}

local plots: { WorldBuilder.Plot } = {}
local owners: { [number]: Player } = {}

function Plots.of(player: Player): number?
	local i = player:GetAttribute("Plot")
	return if type(i) == "number" then i else nil
end

-- Gives the player the first free plot (none left: they simply have no plot this session).
function Plots.assign(player: Player): number?
	if Plots.of(player) then
		return Plots.of(player)
	end
	for i, plot in plots do
		if not owners[i] then
			owners[i] = player
			plot.model:SetAttribute("OwnerId", player.UserId)
			plot.model:SetAttribute("OwnerName", player.DisplayName)
			player:SetAttribute("Plot", i)
			return i
		end
	end
	return nil
end

function Plots.release(player: Player)
	for i, owner in owners do
		if owner == player then
			owners[i] = nil
			plots[i].model:SetAttribute("OwnerId", 0)
			plots[i].model:SetAttribute("OwnerName", "")
		end
	end
end

-- Plots in use (leak check in the playtest).
function Plots.used(): number
	local n = 0
	for _ in owners do
		n += 1
	end
	return n
end

-- Opens the player's own chest. Returns ok, message.
function Plots.collect(player: Player, index: number): (boolean, Locale.Message)
	if owners[index] ~= player then
		return false, M("msg.not_your_chest")
	end
	local amount = Offline.claim(player, 1)
	if amount <= 0 then
		return false, M("msg.nothing_to_claim")
	end
	return true, M("reward.taps", { n = Format.abbrev(amount) })
end

function Plots.init(list: { WorldBuilder.Plot })
	plots = list
	for i, plot in plots do
		local prompt = plot.chest:FindFirstChildOfClass("ProximityPrompt")
		if prompt then
			prompt.Triggered:Connect(function(player)
				local ok, msg = Plots.collect(player, i)
				Remotes.notify(player, msg, if ok then "success" else "info")
			end)
		end
	end

	Remotes.handle("GoPark", function(player)
		local i = Plots.of(player)
		local plot = if i then plots[i] else nil
		local char = player.Character
		if not plot or not char then
			return false, M("msg.no_plot")
		end
		pcall(function()
			player:RequestStreamAroundAsync(plot.spawn.Position, 2)
		end)
		if char.Parent then
			char:PivotTo(plot.spawn)
		end
		return true
	end)

	State.extras.plot = function(player, _p)
		return Plots.of(player) or 0
	end
end

return Plots
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Progression</string>
            <string name="Source"><![CDATA[--!strict
-- Zones (gate purchase, teleport, anti-trespass), rebirth and gem upgrades.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local M = Locale.m
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Format = require(ReplicatedStorage.Shared.Format)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Hooks = require(script.Parent.Hooks)
local Guard = require(script.Parent.Guard)
local WorldBuilder = require(script.Parent.Parent.World.WorldBuilder)

local Progression = {}

local zoneSpawns: { [number]: CFrame } = {}

function Progression.applyWalkSpeed(player: Player)
	local p = Data.get(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if p and hum then
		hum.WalkSpeed = Config.BaseWalkSpeed + (p.upgrades.WalkSpeed or 0) * Config.UpgradeById.WalkSpeed.perLevel
	end
end

function Progression.teleport(player: Player, zone: number)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local cf = zoneSpawns[zone]
	if root and cf then
		-- instance streaming: ask for the destination first so the player never lands in a void
		pcall(function()
			player:RequestStreamAroundAsync(cf.Position, 2)
		end)
		if char and char.Parent then
			(char :: Model):PivotTo(cf + Vector3.new(math.random(-6, 6), 0, 0))
		end
	end
end

-- Rebirth (manual request or Auto Rebirth). Returns ok, message.
function Progression.rebirth(player: Player): (boolean, Locale.Message?)
	local p = Data.get(player)
	if not p then
		return false, nil
	end
	local cost = Formulas.rebirthCost(p.rebirths)
	if p.taps < cost then
		return false, M("msg.need_rebirth", { n = Format.abbrev(cost) })
	end
	local gems = Formulas.rebirthGems(p.rebirths)
	p.taps = 0
	p.rebirths += 1
	State.addGems(player, gems)
	State.dirty(player)
	Hooks.fire("rebirth", player)
	Remotes.notify(player, M("msg.rebirth", { mult = tostring(Formulas.rebirthMult(p.rebirths)), gems = gems }), "success")
	for _, eggId in Formulas.eggsUnlockedAt(p.rebirths) do
		Remotes.notify(player, M("msg.egg_unlocked", { egg = M("egg." .. eggId), zone = M("zone." .. Config.Zones[Formulas.EggById[eggId].zone].id) }), "success")
	end
	return true, nil
end

function Progression.buyZone(player: Player, zone: number): (boolean, Locale.Message?)
	local p = Data.get(player)
	local z = Config.Zones[zone]
	if not p or not z then
		return false, M("msg.unknown_zone")
	end
	if State.hasZone(p, zone) then
		return false, M("msg.already_unlocked")
	end
	if not State.hasZone(p, zone - 1) then
		return false, M("msg.unlock_first", { zone = M("zone." .. Config.Zones[zone - 1].id) })
	end
	if not State.spendTaps(player, z.cost) then
		return false, M("msg.need_taps", { n = Format.abbrev(z.cost) })
	end
	table.insert(p.zones, zone)
	State.dirty(player)
	Remotes.notify(player, M("msg.unlocked_zone", { zone = M("zone." .. z.id) }), "success")
	return true
end

function Progression.init(spawns: { [number]: CFrame }, gates: { [number]: BasePart })
	zoneSpawns = spawns

	for zone, barrier in gates do
		local prompt = barrier:FindFirstChildOfClass("ProximityPrompt")
		if prompt then
			prompt.Triggered:Connect(function(player)
				local ok, err = Progression.buyZone(player, zone)
				if not ok and err then
					Remotes.notify(player, err, "error")
				end
			end)
		end
	end

	Remotes.handle("BuyZone", function(player, payload)
		if not Guard.int(payload.zone, 1, #Config.Zones) then
			return false, M("msg.unknown_zone")
		end
		return Progression.buyZone(player, payload.zone)
	end)

	Remotes.handle("Teleport", function(player, payload)
		local p = Data.get(player)
		if not p or not Guard.int(payload.zone, 1, #Config.Zones) or not State.hasZone(p, payload.zone) then
			return false, M("msg.zone_locked")
		end
		Progression.teleport(player, payload.zone)
		return true
	end)

	Remotes.handle("Rebirth", function(player)
		return Progression.rebirth(player)
	end)

	Remotes.handle("Upgrade", function(player, payload)
		local p = Data.get(player)
		local u = if Guard.str(payload.id, 24) then Config.UpgradeById[payload.id] else nil
		if not p or not u then
			return false, M("msg.unknown_upgrade")
		end
		local level = p.upgrades[u.id] or 0
		if level >= u.maxLevel then
			return false, M("msg.maxed")
		end
		local cost = Formulas.upgradeCost(u.id, level)
		if not State.spendGems(player, cost) then
			return false, M("msg.not_enough_gems")
		end
		p.upgrades[u.id] = level + 1
		Hooks.fire("gemsSpent", player, cost)
		if u.id == "WalkSpeed" then
			Progression.applyWalkSpeed(player)
		end
		State.dirty(player)
		return true
	end)

	-- Anti-trespass: noclip/teleport exploits into locked zones get sent back.
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in Players:GetPlayers() do
				local p = Data.get(player)
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
				if p and root and State.ready[player] then
					local zone = WorldBuilder.zoneAt(root.Position.Z)
					if not State.hasZone(p, zone) then
						Progression.teleport(player, State.maxZone(p))
						Remotes.notify(player, M("msg.zone_locked"), "error")
					end
				end
			end
		end
	end)

end

return Progression
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[--!strict
-- Daily quests: 3 per UTC day (Shared/Quests), progress from gameplay hooks, gem rewards and a
-- Magic Egg bonus for finishing all three. Progress is pushed with the small "Quests" event
-- (throttled) instead of full state snapshots, because taps update it several times a second.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Quests = require(ReplicatedStorage.Shared.Quests)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Rewards = require(script.Parent.Rewards)
local Hooks = require(script.Parent.Hooks)
local Guard = require(script.Parent.Guard)
local M = Locale.m

local QuestService = {}

local dirty: { [Player]: boolean } = {}
local lastPush: { [Player]: number } = {}
local PUSH_INTERVAL = 2

-- Makes sure the profile holds today's quests (fresh list at the first access of a new day).
function QuestService.ensure(player: Player, forcedKinds: { string }?): Data.Profile?
	local p = Data.get(player)
	if not p then
		return nil
	end
	local day = Quests.today(os.time())
	if p.quests.day ~= day or forcedKinds then
		local list = Quests.forDay(day, State.maxZone(p))
		if forcedKinds then
			local byKind = {}
			for _, def in Config.QuestPool do
				byKind[def.kind] = def
			end
			list = {}
			for _, kind in forcedKinds do
				local def = byKind[kind]
				if def then
					table.insert(list, { kind = kind, target = def.targetByZone[math.min(State.maxZone(p), #def.targetByZone)], gems = def.gems })
				end
			end
		end
		p.quests = { day = day, list = list, progress = {}, claimed = {}, bonusClaimed = false }
		for i in list do
			p.quests.progress[i] = 0
			p.quests.claimed[i] = false
		end
		dirty[player] = true
	end
	return p
end

function QuestService.snapshot(player: Player): { [string]: any }?
	local p = QuestService.ensure(player)
	if not p then
		return nil
	end
	local list = {}
	for i, q in p.quests.list do
		table.insert(list, { kind = q.kind, target = q.target, gems = q.gems, progress = math.min(p.quests.progress[i] or 0, q.target), claimed = p.quests.claimed[i] == true })
	end
	return { list = list, bonusClaimed = p.quests.bonusClaimed, bonus = Config.QuestBonus, resetsAt = Quests.resetsAt(os.time()), serverTime = os.time() }
end

function QuestService.add(player: Player, kind: string, amount: number)
	local p = QuestService.ensure(player)
	if not p or amount <= 0 then
		return
	end
	for i, q in p.quests.list do
		if q.kind == kind and not p.quests.claimed[i] then
			local before = p.quests.progress[i] or 0
			if before < q.target then
				p.quests.progress[i] = math.min(q.target, before + amount)
				dirty[player] = true
			end
		end
	end
end

function QuestService.init()
	State.extras.quests = function(player)
		return QuestService.snapshot(player)
	end

	Hooks.on("hatched", function(player: Player, results: { any })
		QuestService.add(player, "hatch", #results)
		local epicPlus = 0
		for _, r in results do
			local rarity = Config.RarityByName[r.rarity]
			if rarity and rarity.order >= Config.RarityByName.Epic.order then
				epicPlus += 1
			end
		end
		QuestService.add(player, "rarity", epicPlus)
	end)
	Hooks.on("tapsAccepted", function(player: Player, n: number)
		QuestService.add(player, "taps", n)
	end)
	Hooks.on("crafted", function(player: Player, tier: number)
		if tier == 1 then
			QuestService.add(player, "craft", 1)
		end
	end)
	Hooks.on("gemsSpent", function(player: Player, n: number)
		QuestService.add(player, "gems", n)
	end)

	Remotes.handle("ClaimQuest", function(player, payload)
		local p = QuestService.ensure(player)
		local i = payload.i
		if not p or not Guard.int(i, 1, 16) or not p.quests.list[i] then
			return false, M("msg.unknown_quest")
		end
		local q = p.quests.list[i]
		if p.quests.claimed[i] then
			return false, M("msg.already_claimed")
		end
		if (p.quests.progress[i] or 0) < q.target then
			return false, M("msg.not_ready")
		end
		p.quests.claimed[i] = true
		dirty[player] = true
		Hooks.fire("questClaimed", player, false)
		return true, Rewards.grant(player, { kind = "gems", amount = q.gems })
	end)

	Remotes.handle("ClaimQuestBonus", function(player)
		local p = QuestService.ensure(player)
		if not p then
			return false, M("msg.error")
		end
		if p.quests.bonusClaimed then
			return false, M("msg.already_claimed")
		end
		for i in p.quests.list do
			if not p.quests.claimed[i] then
				return false, M("msg.quests_first")
			end
		end
		p.quests.bonusClaimed = true
		dirty[player] = true
		Hooks.fire("questClaimed", player, true)
		return true, Rewards.grant(player, Config.QuestBonus :: any)
	end)

	-- play-time quests + day rollover + throttled progress pushes
	task.spawn(function()
		local acc = 0
		while true do
			task.wait(0.5)
			acc += 0.5
			local minute = acc >= 60
			if minute then
				acc -= 60
			end
			for _, player in Players:GetPlayers() do
				if State.ready[player] then
					if minute then
						QuestService.add(player, "playMinutes", 1)
					end
					QuestService.ensure(player)
					-- progress pushes: at most one every PUSH_INTERVAL per player
					local now = os.clock()
					if dirty[player] and now - (lastPush[player] or 0) >= PUSH_INTERVAL then
						dirty[player] = nil
						lastPush[player] = now
						Remotes.fire("Quests", player, QuestService.snapshot(player))
					end
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
		lastPush[player] = nil
	end)
end

return QuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Remotes</string>
            <string name="Source"><![CDATA[--!strict
-- Creates ReplicatedStorage.Remotes and routes Request(action, payload) to handlers,
-- with a per-player token-bucket rate limit. Adapted from Crop Kingdom.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage.Shared.Locale)
local Guard = require(script.Parent.Guard)
local M = Locale.m

local Remotes = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"

-- Server -> client events
local events: { [string]: RemoteEvent } = {}
for _, name in { "State", "Currency", "Notify", "Toast", "Hatched", "Reward", "LiveEventUpdate", "AskNotifications", "Quests" } do
	local e = Instance.new("RemoteEvent")
	e.Name = name
	e.Parent = folder
	events[name] = e
end

-- Client -> server tap batches (fire-and-forget, its own rate limit lives in Tapping)
local tapEvent = Instance.new("RemoteEvent")
tapEvent.Name = "Tap"
tapEvent.Parent = folder
Remotes.TapEvent = tapEvent

local request = Instance.new("RemoteFunction")
request.Name = "Request"
request.Parent = folder

type Handler = (player: Player, payload: any) -> (boolean, any?)
local handlers: { [string]: Handler } = {}
local actionLimiters: { [string]: Guard.Limiter } = {}
local globalLimiter = Guard.limiter(12, 30) -- requests per second sustained / burst, all actions
local MAX_ACTION_LEN = 32
local MAX_PAYLOAD_KEYS = 256
-- Players that already left: a late call must not re-create their bookkeeping (leak).
local departed: { [Player]: boolean } = setmetatable({}, { __mode = "k" }) :: any

-- perSecond / burst: optional extra per-player limit for this action alone (expensive or
-- brute-forceable ones: codes, ads, group check, craft, delete...). The global limit still applies.
function Remotes.handle(action: string, fn: Handler, perSecond: number?, burst: number?)
	handlers[action] = fn
	if perSecond then
		actionLimiters[action] = Guard.limiter(perSecond, burst or math.max(1, perSecond * 2))
	end
end

-- Sets (or replaces) the per-player limit of an already registered action.
function Remotes.limit(action: string, perSecond: number, burst: number)
	actionLimiters[action] = Guard.limiter(perSecond, burst)
end

-- Traffic counters (remote calls since the server started); the playtest reads them.
Remotes.stats = { out = 0, tapIn = 0, requestIn = 0 }

function Remotes.fire(name: string, player: Player, ...: any)
	Remotes.stats.out += 1
	events[name]:FireClient(player, ...)
end

function Remotes.fireAll(name: string, ...: any)
	Remotes.stats.out += 1
	events[name]:FireAllClients(...)
end

-- message: a Locale message ({ key, args }); the client renders it in the player's language.
function Remotes.notify(player: Player, message: Locale.Message, kind: string?)
	Remotes.stats.out += 1
	events.Notify:FireClient(player, message, kind or "info")
end

function Remotes.forget(player: Player)
	departed[player] = true
	Guard.forget(globalLimiter, player)
	for _, l in actionLimiters do
		Guard.forget(l, player)
	end
end

-- Limiter entries still held for this player (leak check).
function Remotes.tracked(player: Player): number
	local n = if globalLimiter.buckets[player] then 1 else 0
	for _, l in actionLimiters do
		if l.buckets[player] then
			n += 1
		end
	end
	return n
end

request.OnServerInvoke = function(player: Player, action: any, payload: any)
	Remotes.stats.requestIn += 1
	if departed[player] or not player.Parent then
		return false, M("msg.error")
	end
	if not Guard.str(action, MAX_ACTION_LEN) then
		return false, M("msg.bad_request")
	end
	local now = os.clock()
	if not Guard.allow(globalLimiter, player, now) then
		return false, M("msg.slow_down")
	end
	local fn = handlers[action :: string]
	if not fn then
		return false, M("msg.unknown_action")
	end
	local limiter = actionLimiters[action :: string]
	if limiter and not Guard.allow(limiter, player, now) then
		return false, M("msg.slow_down")
	end
	if payload ~= nil and not Guard.smallTable(payload, MAX_PAYLOAD_KEYS) then
		return false, M("msg.bad_request")
	end
	local ok, a, b2 = pcall(fn, player, payload or {})
	if not ok then
		warn("[Remotes]", action, "error:", a)
		return false, M("msg.error")
	end
	return a, b2
end

folder.Parent = ReplicatedStorage

return Remotes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[--!strict
-- Retention: daily streak, codes, free in-session gifts, index (collection) rewards and
-- the friend boost. Rewards.grant is also used by Monetization for developer products.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local M = Locale.m
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Format = require(ReplicatedStorage.Shared.Format)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Hooks = require(script.Parent.Hooks)
local Guard = require(script.Parent.Guard)
local Eggs = require(script.Parent.Eggs)

local Rewards = {}

type Reward = { kind: string, amount: number, label: string? }

-- Applies a reward and returns a short description of what was given.
function Rewards.grant(player: Player, reward: { kind: string, amount: number, label: string? }): Locale.Message
	local p = Data.get(player)
	if not p then
		return M("msg.error")
	end
	if reward.kind == "taps" then
		local amount = Formulas.tapsForMinutes(reward.amount, State.tapValue(player, p))
		State.addTaps(player, amount, false)
		Remotes.fire("Reward", player, { kind = "taps", amount = amount })
		return M("reward.taps", { n = Format.abbrev(amount) })
	elseif reward.kind == "gems" then
		State.addGems(player, reward.amount)
		Remotes.fire("Reward", player, { kind = "gems", amount = reward.amount })
		return M("reward.gems", { n = reward.amount })
	elseif reward.kind == "luck" then
		p.luckBoostLeft += reward.amount * 60
		State.dirty(player)
		Remotes.fire("Reward", player, { kind = "luck", amount = reward.amount })
		return M("reward.luck", { n = reward.amount })
	elseif reward.kind == "egg" then
		Eggs.hatchExclusive(player, reward.amount)
		return if reward.amount > 1 then M("reward.eggs", { n = reward.amount }) else M("reward.egg1")
	end
	return M("msg.error")
end

-- Every non-secret, non-exclusive pet that belongs to a zone's index page.
function Rewards.zonePets(zone: number): { string }
	local list = {}
	for _, pet in Config.Pets do
		if pet.zone == zone then
			table.insert(list, pet.id)
		end
	end
	return list
end

-- Friendship is looked up once per pair (web call) and cached for the server's lifetime.
local friendCache: { [string]: boolean } = {}
local friendCount = 0
local function areFriends(a: Player, b: Player): boolean
	local lo, hi = math.min(a.UserId, b.UserId), math.max(a.UserId, b.UserId)
	local key = lo .. ":" .. hi
	local cached = friendCache[key]
	friendCount += if cached == nil then 1 else 0
	if friendCount > 3000 then
		table.clear(friendCache) -- bounded: pairs of everyone who ever shared this server
		friendCount = 0
	end
	if cached ~= nil then
		return cached
	end
	local ok, isFriend = pcall(function()
		return a:IsFriendsWithAsync(b.UserId)
	end)
	if not ok then
		return false -- retry next refresh
	end
	friendCache[key] = isFriend == true
	return isFriend == true
end

local function countFriends(player: Player): number
	local n = 0
	for _, other in Players:GetPlayers() do
		if other ~= player and areFriends(player, other) then
			n += 1
		end
	end
	return n
end

function Rewards.refreshFriends()
	for _, player in Players:GetPlayers() do
		if State.ready[player] then
			local n = countFriends(player)
			if n ~= State.friends[player] then
				State.friends[player] = n
				State.dirty(player)
			end
		end
	end
end

function Rewards.init()
	Remotes.handle("ClaimDaily", function(player)
		local p = Data.get(player)
		if not p then
			return false
		end
		local now = os.time()
		if now - p.daily.last < Config.DailyCooldown then
			return false, M("msg.daily_wait", { time = Format.time(Config.DailyCooldown - (now - p.daily.last)) })
		end
		if now - p.daily.last > Config.DailyStreakWindow then
			p.daily.streak = 0
		end
		local day = (p.daily.streak % #Config.DailyRewards) + 1
		p.daily.streak += 1
		p.daily.last = now
		local text = Rewards.grant(player, Config.DailyRewards[day])
		State.dirty(player)
		Data.save(player)
		return true, text
	end)

	Remotes.handle("ClaimGift", function(player, payload)
		local i = payload.index
		local gift = if Guard.int(i, 1, #Config.Gifts) then Config.Gifts[i] else nil
		local claimed = State.giftsClaimed[player]
		if not gift or not claimed then
			return false, M("msg.unknown_gift")
		end
		if claimed[i] then
			return false, M("msg.already_claimed")
		end
		local elapsed = os.clock() - (State.sessionStart[player] or os.clock())
		if elapsed + 1 < gift.minutes * 60 then
			return false, M("msg.not_ready")
		end
		claimed[i] = true
		local text = Rewards.grant(player, gift.reward)
		State.dirty(player)
		return true, text
	end)

	Remotes.handle("RedeemCode", function(player, payload)
		local p = Data.get(player)
		if not p or not Guard.str(payload.code, 30) then
			return false, M("msg.invalid_code")
		end
		local code = payload.code:upper():gsub("%s", "")
		local reward = Config.Codes[code]
		if not reward then
			return false, M("msg.invalid_code")
		end
		if p.codes[code] then
			return false, M("msg.already_redeemed")
		end
		p.codes[code] = true
		local text = Rewards.grant(player, reward)
		State.dirty(player)
		return true, text
	end)

	Remotes.handle("ClaimIndex", function(player, payload)
		local p = Data.get(player)
		local zone = payload.zone
		if not p or not Guard.int(zone, 1, #Config.Zones) or not Config.Zones[zone] then
			return false, M("msg.unknown_zone")
		end
		local key = tostring(zone)
		if p.indexClaimed[key] then
			return false, M("msg.already_claimed")
		end
		for _, id in Rewards.zonePets(zone) do
			if not p.discovered[id] then
				return false, M("msg.index_incomplete", { zone = M("zone." .. Config.Zones[zone].id) })
			end
		end
		p.indexClaimed[key] = true
		Hooks.fire("indexClaimed", player, zone)
		local gems = Config.IndexRewardGems[zone] or 0
		State.addGems(player, gems)
		State.dirty(player)
		return true, M("msg.index_claimed", { gems = gems, pct = math.floor(Config.IndexTapBonus * 100) })
	end)

	task.spawn(function()
		while true do
			task.wait(15)
			pcall(Rewards.refreshFriends)
		end
	end)
end

return Rewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Social</string>
            <string name="Source"><![CDATA[--!strict
-- Social features:
--   * cross-server rare-hatch announcements (MessagingService "TPS_RareHatch")
--   * referrals: invitee gift on join, inviter credited after the invitee's first 10 minutes
--     (DataStore TapPets_Referrals_v1 keyed by inviter), drained on join and every 120 s
--   * share-link prompt, group-join gift pet, notification opt-in ask
local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Referral = require(ReplicatedStorage.Shared.Referral)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Rewards = require(script.Parent.Rewards)
local Pets = require(script.Parent.Pets)
local Hooks = require(script.Parent.Hooks)
local Guard = require(script.Parent.Guard)
local M = Locale.m

local Social = {}

local live = game.PlaceId ~= 0 -- MessagingService / DataStores only work in a published place

---------------------------------------------------------------------------
-- Cross-server rare hatches
---------------------------------------------------------------------------
local RARE_TOPIC = "TPS_RareHatch"
local outbox: { any } = {}
local inbox: { any } = {}

local function isGlobalWorthy(r: any): boolean
	return r.rarity == "Mythic" or r.rarity == "Secret" or r.tier == 2
end

function Social.queueGlobal(player: Player, r: any)
	if not live then
		return
	end
	table.insert(outbox, { n = player.DisplayName, p = r.id, t = r.tier, r = r.rarity, o = Format.chance(r.chance), j = game.JobId })
	while #outbox > 10 do
		table.remove(outbox, 1)
	end
end

---------------------------------------------------------------------------
-- Referrals
---------------------------------------------------------------------------
local refStore: DataStore? = nil
if live then
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(Config.ReferralStore)
	end)
	if ok then
		refStore = store
	end
end

-- Invitee side, on join. Returns true when the invitee gift was granted.
function Social.applyReferral(player: Player, launchData: any): boolean
	local p = Data.get(player)
	local inviter = Referral.parse(launchData)
	if not p or not inviter or inviter == player.UserId or p.referredBy ~= 0 or p.playTime >= Config.ReferralMinPlaySeconds then
		return false
	end
	p.referredBy = inviter
	Rewards.grant(player, Config.ReferralInviteeGift :: any)
	Remotes.notify(player, M("msg.referral_welcome"), "success")
	State.dirty(player)
	return true
end

-- Invitee side: after 10 minutes of play, credit the inviter once.
local function creditInviter(player: Player)
	local p = Data.get(player)
	if not p or p.referredBy == 0 or p.referralPaid or p.playTime < Config.ReferralMinPlaySeconds then
		return
	end
	p.referralPaid = true
	local store = refStore
	if not store then
		return
	end
	local inviter, me = p.referredBy, player.UserId
	task.spawn(function()
		local ok, err = pcall(function()
			store:UpdateAsync(tostring(inviter), function(old: any)
				local list = if type(old) == "table" then old else {}
				for _, e in list do
					if e.u == me then
						return list
					end
				end
				table.insert(list, { u = me, t = os.time() })
				while #list > 50 do
					table.remove(list, 1)
				end
				return list
			end)
		end)
		if not ok then
			warn("[Social] referral credit failed", err)
		end
	end)
end

-- Inviter side: take the pending entries and grant one reward per friend (lifetime cap).
local function drainReferrals(player: Player)
	local p = Data.get(player)
	local store = refStore
	if not p or not store or not Data.isPersistent(player) then
		return
	end
	local taken: { any } = {}
	local ok = pcall(function()
		store:UpdateAsync(tostring(player.UserId), function(old: any)
			if type(old) ~= "table" or #old == 0 then
				return nil
			end
			taken = old
			return {}
		end)
	end)
	if not ok then
		return
	end
	for _ in taken do
		if p.referralRewards >= Config.ReferralLifetimeCap then
			break
		end
		p.referralRewards += 1
		Rewards.grant(player, Config.ReferralInviterGift :: any)
		Remotes.notify(player, M("msg.referral_reward"), "success")
	end
end

---------------------------------------------------------------------------
-- Notification opt-in ask (after the first Legendary+ hatch or rebirth, at most weekly)
---------------------------------------------------------------------------
local function maybeAskNotifications(player: Player)
	local p = Data.get(player)
	if not p or os.time() - p.notifAskedAt <= Config.NotifAskInterval then
		return
	end
	p.notifAskedAt = os.time()
	Remotes.fire("AskNotifications", player)
end

function Social.onJoin(player: Player)
	local ok, joinData = pcall(function()
		return player:GetJoinData()
	end)
	if ok and type(joinData) == "table" then
		Social.applyReferral(player, joinData.LaunchData)
	end
	task.spawn(drainReferrals, player)
end

function Social.init()
	Hooks.on("hatched", function(player: Player, results: { any })
		local legendary = false
		for _, r in results do
			if isGlobalWorthy(r) then
				Social.queueGlobal(player, r)
			end
			local rarity = Config.RarityByName[r.rarity]
			if rarity and rarity.order >= Config.RarityByName.Legendary.order then
				legendary = true
			end
		end
		if legendary then
			maybeAskNotifications(player)
		end
	end)
	Hooks.on("rebirth", function(player: Player)
		local p = Data.get(player)
		if p and p.rebirths == 1 then
			maybeAskNotifications(player)
		end
	end)

	Remotes.handle("ShareLink", function(player)
		local ok, err = pcall(function()
			(SocialService :: any):PromptLinkSharingAsync(player, {
				LaunchData = Referral.launchData(player.UserId),
				ExpirationSeconds = Config.ReferralLinkSeconds,
			})
		end)
		if not ok then
			warn("[Social] link sharing unavailable:", err)
			return false, M("msg.share_unavailable")
		end
		return true
	end)

	Remotes.handle("ClaimGroupGift", function(player)
		local p = Data.get(player)
		if not p or Config.GroupId == 0 then
			return false, M("msg.group_unavailable")
		end
		if p.groupGiftClaimed then
			return false, M("msg.already_claimed")
		end
		local ok, member = pcall(function()
			return (player :: any):IsInGroupAsync(Config.GroupId)
		end)
		if not ok then
			ok, member = pcall(function()
				return (player :: any):IsInGroup(Config.GroupId) -- older engines
			end)
		end
		if not ok or not member then
			return false, M("msg.join_group_first")
		end
		if not Pets.hasRoom(player, p, 1) then
			return false, M("msg.free_a_slot")
		end
		p.groupGiftClaimed = true
		Pets.add(player, Config.GroupGiftPet, 0, true)
		State.dirty(player)
		return true, M("msg.group_gift", { pet = M("pet." .. Config.GroupGiftPet) })
	end)

	State.extras.social = function(_player, p)
		return { groupGiftClaimed = p.groupGiftClaimed, referralRewards = p.referralRewards, referredBy = p.referredBy }
	end

	if live then
		task.spawn(function()
			pcall(function()
				MessagingService:SubscribeAsync(RARE_TOPIC, function(message)
					local d = message.Data
					if type(d) ~= "table" or d.j == game.JobId or not Guard.str(d.p, 40) or not Formulas.PetById[d.p] then
						return
					end
					table.insert(inbox, { n = string.sub(tostring(d.n), 1, 40), p = d.p, t = if Guard.int(d.t, 0, 2) then d.t else 0, o = string.sub(tostring(d.o), 1, 24) })
					while #inbox > 5 do
						table.remove(inbox, 1)
					end
				end)
			end)
		end)
		-- publish at most one message every 2 s
		task.spawn(function()
			while true do
				task.wait(2)
				local msg = table.remove(outbox, 1)
				if msg then
					pcall(function()
						MessagingService:PublishAsync(RARE_TOPIC, msg)
					end)
				end
			end
		end)
		-- show incoming ones one every 4 s
		task.spawn(function()
			while true do
				task.wait(4)
				local d = table.remove(inbox, 1)
				if d then
					Remotes.fireAll("Toast", { player = tostring(d.n), pet = d.p, rarity = Formulas.PetById[d.p].rarity, tier = tonumber(d.t) or 0, chanceText = tostring(d.o), global = true })
				end
			end
		end)
	end

	-- referral upkeep
	task.spawn(function()
		local acc = 0
		while true do
			task.wait(30)
			acc += 30
			for _, player in Players:GetPlayers() do
				if State.ready[player] then
					creditInviter(player)
					if acc >= 120 then
						task.spawn(drainReferrals, player)
					end
				end
			end
			if acc >= 120 then
				acc = 0
			end
		end
	end)
end

return Social
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
-- Session state that isn't persisted (passes, friends, gifts, auto-hatch...) plus the
-- derived stats every service needs (tap value, luck, equip slots) and the dirty-flag
-- replication of the profile to its owner.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)

local State = {}

State.passes = {} :: { [Player]: { [string]: boolean } }
State.friends = {} :: { [Player]: number }
State.sessionStart = {} :: { [Player]: number }
State.giftsClaimed = {} :: { [Player]: { [number]: boolean } }
State.autoHatch = {} :: { [Player]: string? }
State.lastHatch = {} :: { [Player]: number }
State.ready = {} :: { [Player]: boolean }
-- PolicyService: true when the player can't buy paid random items (or until we know).
State.paidRandomRestricted = {} :: { [Player]: boolean }
-- Multipliers from active live events (set by LiveEventService).
State.eventEffects = { luckMult = 1, goldenMult = 1 }
-- Extra snapshot sections contributed by other services (quests, offline, starter...).
State.extras = {} :: { [string]: (Player, Data.Profile) -> any }

local dirtyFull: { [Player]: boolean } = {}
local dirtyCurrency: { [Player]: boolean } = {}
local lastCurrency: { [Player]: number } = {}
-- Currency-only updates go out at most this often per player (the client counts up
-- smoothly and predicts its own taps, so 2 a second reads the same as 5).
local CURRENCY_INTERVAL = 0.5

function State.init(player: Player)
	State.passes[player] = State.passes[player] or {}
	State.friends[player] = 0
	State.sessionStart[player] = os.clock()
	State.giftsClaimed[player] = {}
	State.lastHatch[player] = 0
end

function State.cleanup(player: Player)
	State.passes[player] = nil
	State.friends[player] = nil
	State.sessionStart[player] = nil
	State.giftsClaimed[player] = nil
	State.autoHatch[player] = nil
	State.lastHatch[player] = nil
	State.ready[player] = nil
	State.paidRandomRestricted[player] = nil
	dirtyFull[player] = nil
	dirtyCurrency[player] = nil
	lastCurrency[player] = nil
end

-- Per-player bookkeeping tables still holding this player (leak check in the playtest).
function State.tracked(player: Player): number
	local n = 0
	for _, t in { State.passes, State.friends, State.sessionStart, State.giftsClaimed, State.autoHatch, State.lastHatch, State.ready, State.paidRandomRestricted, dirtyFull, dirtyCurrency, lastCurrency } :: { { [Player]: any } } do
		if t[player] ~= nil then
			n += 1
		end
	end
	return n
end

function State.owns(player: Player, passKey: string): boolean
	local p = State.passes[player]
	return p ~= nil and p[passKey] == true
end

function State.maxZone(profile: Data.Profile): number
	local m = 1
	for _, z in profile.zones do
		if z > m then
			m = z
		end
	end
	return m
end

function State.hasZone(profile: Data.Profile, zone: number): boolean
	return table.find(profile.zones, zone) ~= nil
end

function State.maxEquip(player: Player, profile: Data.Profile): number
	return Formulas.maxEquip(profile.upgrades.PetSlots or 0, State.passes[player] or {})
end

function State.maxInventory(player: Player): number
	return Formulas.maxInventory(State.passes[player] or {})
end

function State.petPowerSum(profile: Data.Profile): number
	local maxZone = State.maxZone(profile)
	local sum = 0
	for _, uid in profile.equipped do
		local pet = profile.pets[uid]
		if pet then
			sum += Formulas.petPower(pet.id, pet.tier, maxZone, pet.trait)
		end
	end
	return sum
end

function State.indexZonesDone(profile: Data.Profile): number
	local n = 0
	for _ in profile.indexClaimed do
		n += 1
	end
	return n
end

function State.tapValue(player: Player, profile: Data.Profile): number
	return Formulas.tapValue({
		petPower = State.petPowerSum(profile),
		rebirths = profile.rebirths,
		tapPowerLevel = profile.upgrades.TapPower or 0,
		passes = State.passes[player] or {},
		friends = State.friends[player] or 0,
		indexZonesDone = State.indexZonesDone(profile),
		tapBoost = profile.tapBoostLeft > 0,
	})
end

function State.luck(player: Player, profile: Data.Profile): number
	return Formulas.luck(profile.upgrades.Luck or 0, State.passes[player] or {}, profile.luckBoostLeft > 0, State.eventEffects.luckMult)
end

function State.goldenChance(player: Player): number
	return Formulas.goldenChance(State.owns(player, "MagicEggs"), State.eventEffects.goldenMult)
end

function State.petCount(profile: Data.Profile): number
	local n = 0
	for _ in profile.pets do
		n += 1
	end
	return n
end

---------------------------------------------------------------------------
-- Currency helpers (server-authoritative; the only way currency changes)
---------------------------------------------------------------------------
function State.addTaps(player: Player, amount: number, countsTowardTotal: boolean?)
	local p = Data.get(player)
	if not p or amount ~= amount or amount <= 0 then
		return
	end
	p.taps += amount
	if countsTowardTotal ~= false then
		p.totalTaps += amount
	end
	dirtyCurrency[player] = true
end

function State.spendTaps(player: Player, amount: number): boolean
	local p = Data.get(player)
	if not p or p.taps < amount then
		return false
	end
	p.taps -= amount
	dirtyCurrency[player] = true
	return true
end

function State.addGems(player: Player, amount: number)
	local p = Data.get(player)
	if not p then
		return
	end
	p.gems += amount
	dirtyCurrency[player] = true
end

function State.spendGems(player: Player, amount: number): boolean
	local p = Data.get(player)
	if not p or p.gems < amount then
		return false
	end
	p.gems -= amount
	dirtyCurrency[player] = true
	return true
end

---------------------------------------------------------------------------
-- Replication
---------------------------------------------------------------------------
function State.dirty(player: Player)
	dirtyFull[player] = true
end

-- Other clients render this player's pets from this attribute: "petId:tier,petId:tier"
function State.replicateEquipped(player: Player)
	local p = Data.get(player)
	if not p then
		return
	end
	local parts = {}
	for _, uid in p.equipped do
		local pet = p.pets[uid]
		if pet then
			table.insert(parts, pet.id .. ":" .. pet.tier)
		end
	end
	player:SetAttribute("EquippedPets", table.concat(parts, ","))
	player:SetAttribute("VIP", State.owns(player, "VIP"))
end

function State.snapshot(player: Player): { [string]: any }?
	local p = Data.get(player)
	if not p then
		return nil
	end
	local gifts = {}
	local claimed = State.giftsClaimed[player]
	if claimed then
		for i in claimed do
			table.insert(gifts, i)
		end
	end
	local snap: { [string]: any } = {
		taps = p.taps,
		gems = p.gems,
		dice = p.dice,
		totalTaps = p.totalTaps,
		rebirths = p.rebirths,
		zones = p.zones,
		pets = p.pets,
		equipped = p.equipped,
		upgrades = p.upgrades,
		discovered = p.discovered,
		indexClaimed = p.indexClaimed,
		passes = State.passes[player] or {},
		maxEquip = State.maxEquip(player, p),
		maxInventory = State.maxInventory(player),
		tapValue = State.tapValue(player, p),
		luck = State.luck(player, p),
		luckBoostLeft = p.luckBoostLeft,
		rebirthCost = Formulas.rebirthCost(p.rebirths),
		rebirthGems = Formulas.rebirthGems(p.rebirths),
		daily = { streak = p.daily.streak, last = p.daily.last },
		serverTime = os.time(),
		giftsClaimed = gifts,
		sessionElapsed = os.clock() - (State.sessionStart[player] or os.clock()),
		autoTap = p.settings.autoTap,
		autoHatch = State.autoHatch[player],
		friends = State.friends[player] or 0,
		totalHatched = p.totalHatched,
		persistent = Data.isPersistent(player),
		lang = p.lang,
		tapBoostLeft = p.tapBoostLeft,
		goldenChance = State.goldenChance(player),
		paidRandomRestricted = State.paidRandomRestricted[player] ~= false,
	}
	for key, fn in State.extras do
		local ok, v = pcall(fn, player, p)
		if ok then
			snap[key] = v
		else
			warn("[State] snapshot extra", key, v)
		end
	end
	return snap
end

function State.sendFull(player: Player)
	local snap = State.snapshot(player)
	if snap then
		Remotes.fire("State", player, snap)
		State.replicateEquipped(player)
	end
	dirtyFull[player] = nil
	dirtyCurrency[player] = nil
	lastCurrency[player] = os.clock()
end

local function flush()
	local now = os.clock()
	for _, player in Players:GetPlayers() do
		if State.ready[player] then
			if dirtyFull[player] then
				State.sendFull(player)
			elseif dirtyCurrency[player] and now - (lastCurrency[player] or 0) >= CURRENCY_INTERVAL then
				dirtyCurrency[player] = nil
				lastCurrency[player] = now
				local p = Data.get(player)
				if p then
					Remotes.fire("Currency", player, { taps = p.taps, gems = p.gems, totalTaps = p.totalTaps })
				end
			end
		end
	end
end

function State.start()
	task.spawn(function()
		while true do
			task.wait(0.2)
			local ok, err = pcall(function()
				flush()
			end)
			if not ok then
				warn("[State] flush error", err)
			end
		end
	end)
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Tapping</string>
            <string name="Source"><![CDATA[--!strict
-- Server-authoritative tapping. Clients send a tap COUNT every ~0.25s; the server clamps
-- it with a token bucket (Config.MaxTapsPerSecond) so autoclickers can't exceed the cap.
-- Also runs the Auto Tap pass, the Super Luck countdown and play time.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local M = Locale.m
local Data = require(script.Parent.Data)
local Remotes = require(script.Parent.Remotes)
local State = require(script.Parent.State)
local Hooks = require(script.Parent.Hooks)
local Guard = require(script.Parent.Guard)

local Tapping = {}

type Bucket = { tokens: number, t: number }
local buckets: { [Player]: Bucket } = {}
local lastManual: { [Player]: number } = {} -- os.clock() of the last accepted manual tap
local tapValueCache: { [Player]: { v: number, t: number } } = {}
-- Tap EVENTS per second (the client sends one batch every Config.TapSendInterval): extra
-- batches beyond this are dropped before any work is done.
local eventLimiter = Guard.limiter(8, 16)

local function tapValue(player: Player, p: Data.Profile): number
	local c = tapValueCache[player]
	local now = os.clock()
	if c and now - c.t < 0.5 then
		return c.v
	end
	local v = State.tapValue(player, p)
	tapValueCache[player] = { v = v, t = now }
	return v
end

function Tapping.invalidate(player: Player)
	tapValueCache[player] = nil
end

function Tapping.forget(player: Player)
	buckets[player] = nil
	tapValueCache[player] = nil
	lastManual[player] = nil
	Guard.forget(eventLimiter, player)
end

-- Bookkeeping entries still held for this player (leak check).
function Tapping.tracked(player: Player): number
	local n = 0
	for _, t in { buckets, tapValueCache, lastManual, eventLimiter.buckets } :: { { [Player]: any } } do
		if t[player] ~= nil then
			n += 1
		end
	end
	return n
end

-- Auto taps per second right now (0 when the switch is off).
function Tapping.autoRate(player: Player, p: Data.Profile, now: number): number
	if not p.settings.autoTap then
		return 0
	end
	local last = lastManual[player] or State.sessionStart[player] or now
	return Formulas.autoTapRate(p.upgrades.AutoTap or 0, State.owns(player, "AutoTap"), now - last >= Config.AutoTapIdleSeconds)
end

local function onTap(player: Player, count: any)
	Remotes.stats.tapIn += 1
	if not Guard.num(count) or not player.Parent then
		return
	end
	count = math.floor(math.min(count, 10000))
	if count <= 0 then
		return
	end
	local p = Data.get(player)
	if not p or not State.ready[player] then
		return
	end
	local now = os.clock()
	if not Guard.allow(eventLimiter, player, now) then
		return
	end
	local b = buckets[player]
	local cap = Config.MaxTapsPerSecond + Config.TapBurst
	if not b then
		b = { tokens = cap, t = now }
		buckets[player] = b
	end
	b.tokens = math.min(cap, b.tokens + (now - b.t) * Config.MaxTapsPerSecond)
	b.t = now
	local accepted = math.min(count, math.floor(b.tokens))
	if accepted <= 0 then
		return
	end
	b.tokens -= accepted
	lastManual[player] = now
	State.addTaps(player, accepted * tapValue(player, p))
	Hooks.fire("tapsAccepted", player, accepted)
end

function Tapping.init()
	Remotes.TapEvent.OnServerEvent:Connect(onTap)

	Remotes.handle("SetAutoTap", function(player, payload)
		local p = Data.get(player)
		if not p then
			return false
		end
		p.settings.autoTap = payload.on == true
		State.dirty(player)
		return true
	end)

	-- Auto Tap pass + timers
	task.spawn(function()
		local STEP = 0.2
		local acc = 0
		while true do
			task.wait(STEP)
			acc += STEP
			local wholeSecond = acc >= 1
			if wholeSecond then
				acc -= 1
			end
			for _, player in Players:GetPlayers() do
				local p = Data.get(player)
				if p and State.ready[player] then
					local rate = Tapping.autoRate(player, p, os.clock())
					if rate > 0 then
						State.addTaps(player, rate * STEP * tapValue(player, p))
					end
					if wholeSecond then
						p.playTime += 1
						Hooks.fire("second", player, p)
						if p.tapBoostLeft > 0 then
							p.tapBoostLeft = math.max(0, p.tapBoostLeft - 1)
							if p.tapBoostLeft == 0 then
								Tapping.invalidate(player)
								State.dirty(player)
							end
						end
						if p.luckBoostLeft > 0 then
							p.luckBoostLeft = math.max(0, p.luckBoostLeft - 1)
							if p.luckBoostLeft == 0 then
								Remotes.notify(player, M("msg.super_luck_ended"), "info")
								State.dirty(player)
							end
						end
					end
				end
			end
		end
	end)
end

return Tapping
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="50">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">ModelSlots</string>
            <string name="Source"><![CDATA[--!strict
-- Model slots: lets real 3D models (Creator Store / Toolbox / Studio AI) replace the
-- primitive-built props WITHOUT touching code. Drop `tree.rbxm`, `tree_1.rbxm`, ... into
-- assets/models/ (Rojo maps that folder to ServerStorage.ModelLibrary). If a slot has no
-- model, `fallback` (the current primitive build) runs unchanged.
local ServerStorage = game:GetService("ServerStorage")

local Math = require(script.Parent.ModelSlotsMath)

local ModelSlots = {}

ModelSlots.MAX_VARIANTS = 16
ModelSlots.DEFAULT_SLOT_CAP = 300 -- parts per model; above this the primitive is used
ModelSlots.TOTAL_CAP = 1500 -- parts from library models in the whole world

export type Options = {
	collide: boolean?, -- keep collision parity with the primitive (default false)
	maxParts: number?, -- per-slot part cap (default DEFAULT_SLOT_CAP)
}

local used = 0
local warned: { [string]: boolean } = {}

local function warnOnce(key: string, msg: string)
	if not warned[key] then
		warned[key] = true
		warn("[ModelSlots] " .. msg)
	end
end

-- Called at the start of every world build.
function ModelSlots.resetBudget()
	used = 0
end

function ModelSlots.partsUsed(): number
	return used
end

local function library(): Instance?
	return ServerStorage:FindFirstChild("ModelLibrary")
end

-- Templates present for a slot ("tree", "tree_1", ...), only Models and BaseParts.
local function templates(slot: string): { Instance }
	local lib = library()
	local out: { Instance } = {}
	if not lib then
		return out
	end
	for _, name in Math.variantNames(slot, ModelSlots.MAX_VARIANTS) do
		local child = lib:FindFirstChild(name)
		if child and (child:IsA("Model") or child:IsA("BasePart")) then
			table.insert(out, child)
		end
	end
	return out
end

function ModelSlots.has(slot: string): boolean
	return #templates(slot) > 0
end

-- Free Toolbox models can hide scripts: delete every one (and warn).
local function stripScripts(inst: Instance, slot: string): number
	local removed = 0
	for _, d in inst:GetDescendants() do
		if d:IsA("LuaSourceContainer") then
			d:Destroy()
			removed += 1
		end
	end
	if inst:IsA("LuaSourceContainer") then
		removed += 1
	end
	if removed > 0 then
		warnOnce("scripts:" .. slot, string.format("slot '%s' contained %d script(s); removed them", slot, removed))
	end
	return removed
end

local function countParts(inst: Instance): number
	local n = if inst:IsA("BasePart") then 1 else 0
	for _, d in inst:GetDescendants() do
		if d:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

local function configureParts(inst: Instance, collide: boolean)
	local function apply(p: BasePart)
		p.Anchored = true
		p.CanCollide = collide
		p.CanQuery = collide
		p.CanTouch = false -- the world budget: nothing touchable
		p.CastShadow = false -- the world budget: shadow casters
		p.Massless = true
		if collide and p:IsA("MeshPart") then
			p.CollisionFidelity = Enum.CollisionFidelity.Box
		end
	end
	if inst:IsA("BasePart") then
		apply(inst)
	end
	for _, d in inst:GetDescendants() do
		if d:IsA("BasePart") then
			apply(d)
		elseif d:IsA("Constraint") or d:IsA("WeldConstraint") then
			d:Destroy() -- anchored and static: joints only cause trouble
		end
	end
end

-- Scales `inst` to fit targetSize (uniform) and rests its bottom-centre on cf.Position,
-- facing cf's rotation.
local function place(inst: Instance, cf: CFrame, targetSize: Vector3)
	if inst:IsA("Model") then
		local _, size = inst:GetBoundingBox()
		local k = Math.fitScale(size.X, size.Y, size.Z, targetSize.X, targetSize.Y, targetSize.Z)
		inst:ScaleTo(inst:GetScale() * k)
		local boxCf, boxSize = inst:GetBoundingBox()
		local pivotToBox = inst:GetPivot():ToObjectSpace(boxCf)
		local wantBox = cf * CFrame.new(0, boxSize.Y / 2, 0)
		inst:PivotTo(wantBox * pivotToBox:Inverse())
	else
		local part = inst :: BasePart
		local k = Math.fitScale(part.Size.X, part.Size.Y, part.Size.Z, targetSize.X, targetSize.Y, targetSize.Z)
		part.Size = part.Size * k
		part.CFrame = cf * CFrame.new(0, part.Size.Y / 2, 0)
	end
end

-- Spawns the model for `slotName` (or a variant picked from the position) at cf, fitted to
-- targetSize (studs, bottom on cf.Position). With no usable model (none in the library,
-- too many parts, budget spent) it calls `fallback` and returns whatever that returns.
function ModelSlots.spawn(slotName: string, cf: CFrame, targetSize: Vector3, parent: Instance, fallback: () -> Instance?, options: Options?): Instance?
	local list = templates(slotName)
	if #list == 0 then
		return fallback()
	end
	local collide = options ~= nil and options.collide == true
	local cap = if options ~= nil and options.maxParts ~= nil then options.maxParts else ModelSlots.DEFAULT_SLOT_CAP
	local template = list[Math.pickVariant(#list, cf.Position.X, cf.Position.Z)]
	local clone = template:Clone()
	stripScripts(clone, slotName)
	local parts = countParts(clone)
	if not Math.withinBudget(parts, cap, used, ModelSlots.TOTAL_CAP) then
		warnOnce("budget:" .. template.Name, string.format("slot '%s' skipped (%d parts; cap %d, world total %d/%d); using the primitive", template.Name, parts, cap, used, ModelSlots.TOTAL_CAP))
		clone:Destroy()
		return fallback()
	end
	used += parts
	configureParts(clone, collide)
	place(clone, cf, targetSize)
	clone.Name = slotName
	clone:SetAttribute("ModelSlot", slotName)
	if clone:IsA("Model") then
		clone.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	end
	clone.Parent = parent
	return clone
end

return ModelSlots
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">ModelSlotsMath</string>
            <string name="Source"><![CDATA[--!strict
-- Pure helpers for ModelSlots (no Roblox API, so they run under plain `luau`):
-- the fit-to-box scale, the deterministic variant picker and the part-budget check.
local M = {}

-- Uniform scale so a model of size (sx, sy, sz) fits inside the target box (tx, ty, tz),
-- keeping its proportions: the tightest axis wins. Degenerate sizes return 1.
function M.fitScale(sx: number, sy: number, sz: number, tx: number, ty: number, tz: number): number
	local best = math.huge
	for _, pair in { { sx, tx }, { sy, ty }, { sz, tz } } do
		local s, t = pair[1], pair[2]
		if s > 1e-4 and t > 0 then
			best = math.min(best, t / s)
		end
	end
	if best == math.huge then
		return 1
	end
	return best
end

-- Deterministic integer hash of a world position (studs are rounded to 1/4).
function M.hash(x: number, z: number): number
	local ix = math.floor(x * 4 + 0.5)
	local iz = math.floor(z * 4 + 0.5)
	local h = (ix * 73856093 + iz * 19349663) % 2147483647
	if h < 0 then
		h += 2147483647
	end
	return h
end

-- Picks one of `count` variants (1..count) from a position: same place, same model; a
-- forest spreads over all the variants that exist.
function M.pickVariant(count: number, x: number, z: number): number
	if count <= 1 then
		return 1
	end
	return M.hash(x, z) % count + 1
end

-- Slot names in lookup order: "tree", "tree_1", "tree_2", ... up to maxVariants.
function M.variantNames(slot: string, maxVariants: number): { string }
	local out = { slot }
	for i = 1, maxVariants do
		table.insert(out, slot .. "_" .. i)
	end
	return out
end

-- Part budget: a model is used only when it is within the per-slot cap and the running
-- total for the whole world stays under the global cap.
function M.withinBudget(parts: number, perSlotCap: number, used: number, totalCap: number): boolean
	return parts > 0 and parts <= perSlotCap and used + parts <= totalCap
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the whole map in code: 5 themed zones along +Z separated by gates, eggs on
-- pedestals, landmarks, scenery, spawn plaza, leaderboard boards and lighting.
--
-- Every zone has its own border style, props, two landmarks, path lamps and a horizon
-- (hills, mountains, volcanoes, planets) on a "skirt" of ground beyond the invisible walls,
-- so the map never ends in a flat edge. Things that should move (windmill, UFO, planets,
-- balloons) carry the "TpsAnim" tag; the client animates them (WorldFx).
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Palette = require(ReplicatedStorage.Shared.Palette)
local ModelSlots = require(script.Parent.ModelSlots)

local WorldBuilder = {}

export type Plot = { model: Model, chest: BasePart, spawn: CFrame }

export type WorldInfo = {
	plots: { Plot },
	eggPositions: { [string]: Vector3 },
	zoneSpawns: { [number]: CFrame },
	gates: { [number]: BasePart },
	boards: { [string]: BasePart },
}

local L = Config.ZoneLength
local W = Config.ZoneWidth
local GATE_W, GATE_H = 22, 18
local WALL_H = 80
local SKIRT = 320 -- ground beyond the side walls (scenery only)
local PARK_DEPTH = 68 -- Pet Park: the strip behind the spawn plaza

local FIRE = "rbxasset://textures/particles/fire_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"

local rgb = Palette.rgb
local V = Vector3.new
local C = Color3.fromRGB
local WHITE = C(255, 255, 255)

type Props = { [string]: any }
type Reserved = { pos: Vector3, r: number }

local function lighten(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), a)
end

local function darken(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), a)
end

local function part(parent: Instance, props: Props): BasePart
	local className = props.ClassName or "Part"
	local p = Instance.new(className) :: BasePart
	p.Anchored = true
	p.CanTouch = false -- nothing in the world uses Touched
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		if k ~= "ClassName" and k ~= "Shape" and k ~= "Mesh" then
			(p :: any)[k] = v
		end
	end
	if props.Shape then
		(p :: any).Shape = props.Shape
	end
	if props.Mesh then
		local m = Instance.new("SpecialMesh")
		m.MeshType = props.Mesh
		m.Parent = p
	end
	p.Parent = parent
	return p
end

-- Scenery: never collides, never casts a shadow, invisible to raycasts.
local function deco(parent: Instance, props: Props): BasePart
	if props.CanCollide == nil then
		props.CanCollide = false
	end
	if props.CastShadow == nil then
		props.CastShadow = false
	end
	props.CanQuery = false
	props.CanTouch = false
	return part(parent, props)
end

-- Upright cylinder.
local function cyl(parent: Instance, name: string, pos: Vector3, diameter: number, height: number, color: Color3, material: Enum.Material?, extra: Props?): BasePart
	local props: Props = { Name = name, Shape = Enum.PartType.Cylinder, Size = V(height, diameter, diameter), CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), Color = color, Material = material or Enum.Material.SmoothPlastic }
	if extra then
		for k, v in extra do
			props[k] = v
		end
	end
	return deco(parent, props)
end

local function ball(parent: Instance, name: string, pos: Vector3, size: number, color: Color3, material: Enum.Material?, extra: Props?): BasePart
	local props: Props = { Name = name, Shape = Enum.PartType.Ball, Size = V(size, size, size), Position = pos, Color = color, Material = material or Enum.Material.SmoothPlastic }
	if extra then
		for k, v in extra do
			props[k] = v
		end
	end
	return deco(parent, props)
end

-- Squashed / stretched sphere.
local function ell(parent: Instance, name: string, pos: Vector3, size: Vector3, color: Color3, material: Enum.Material?, extra: Props?): BasePart
	local props: Props = { Name = name, Mesh = Enum.MeshType.Sphere, Size = size, Position = pos, Color = color, Material = material or Enum.Material.SmoothPlastic }
	if extra then
		for k, v in extra do
			props[k] = v
		end
	end
	return deco(parent, props)
end

-- "Painted" contact shadow: a dark disc on the ground under big props. Real-time shadows
-- switch off below graphics level 4; this keeps things planted at any setting.
local function blob(parent: Instance, pos: Vector3, diameter: number, ground: Color3?)
	deco(parent, { Name = "Blob", Shape = Enum.PartType.Cylinder, Size = V(0.06, diameter, diameter), CFrame = CFrame.new(pos.X, 0.05, pos.Z) * CFrame.Angles(0, 0, math.rad(90)), Color = darken(ground or C(70, 110, 60), 0.45), Transparency = 0.45 })
end

-- Client-side motion (WorldFx): spin around a local axis and/or bob up and down.
-- The client moves these, so the resting CFrame travels as an attribute, and models are
-- streamed whole.
local function anim(inst: Instance, spinAxis: Vector3?, spinSpeed: number?, bobAmp: number?, bobSpeed: number?)
	if inst:IsA("Model") then
		inst.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	end
	if inst:IsA("PVInstance") then
		inst:SetAttribute("Rest", inst:GetPivot())
	end
	if spinAxis then
		inst:SetAttribute("SpinAxis", spinAxis)
		inst:SetAttribute("SpinSpeed", spinSpeed or 1)
	end
	if bobAmp then
		inst:SetAttribute("BobAmp", bobAmp)
		inst:SetAttribute("BobSpeed", bobSpeed or 1)
	end
	CollectionService:AddTag(inst, "TpsAnim")
end

local function light(parent: Instance, color: Color3, range: number, brightness: number?)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness or 1.2
	l.Shadows = false
	l.Parent = parent
end

local function emitter(parent: Instance, texture: string, color: Color3, rate: number, size: number, speed: number, lifetime: number): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture
	e.Color = ColorSequence.new(color)
	e.Rate = rate
	e.Lifetime = NumberRange.new(lifetime * 0.7, lifetime)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, size * 0.2) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1) })
	e.LightEmission = 0.8
	e.Parent = parent
	return e
end

-- Low-poly mountain: a cube standing on one corner, optionally with a smaller "cap" cube
-- (snow / lava) on the tip.
local PEAK_TILT = CFrame.Angles(math.atan(1 / math.sqrt(2)), 0, 0) * CFrame.Angles(0, 0, math.rad(45))
local function peak(parent: Instance, x: number, z: number, height: number, yaw: number, color: Color3, material: Enum.Material, capColor: Color3?, capMaterial: Enum.Material?): number
	local s = height / 0.866
	local cf = CFrame.new(x, 0, z) * CFrame.Angles(0, yaw, 0) * PEAK_TILT
	deco(parent, { Name = "Peak", Size = V(s, s, s), CFrame = cf, Color = color, Material = material })
	if capColor then
		local cs = s * (if capMaterial == Enum.Material.Neon then 0.2 else 0.36)
		deco(parent, { Name = "PeakCap", Size = V(cs, cs, cs), CFrame = CFrame.new(x, height - cs * 0.866 + 1.5, z) * CFrame.Angles(0, yaw, 0) * PEAK_TILT, Color = capColor, Material = capMaterial or Enum.Material.SmoothPlastic })
	end
	return height
end

local function zoneCenter(i: number): number
	return (i - 1) * L
end

local function label(parent: Instance, text: string, size: UDim2, offset: Vector3, color: Color3, maxDist: number?): BillboardGui
	local bb = Instance.new("BillboardGui")
	bb.Size = size
	bb.StudsOffset = offset
	bb.AlwaysOnTop = false
	bb.MaxDistance = maxDist or 120
	bb.LightInfluence = 0
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.TextColor3 = color
	t.Text = text
	t.RichText = true
	t.Name = "Text"
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = C(30, 20, 40)
	stroke.Parent = t
	t.Parent = bb
	bb.Parent = parent
	return bb
end

local function surfaceText(p: BasePart, face: Enum.NormalId, text: string, color: Color3): TextLabel
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 30
	sg.LightInfluence = 0
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.TextColor3 = color
	t.Text = text
	t.Name = "Text"
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 4
	stroke.Color = C(30, 20, 40)
	stroke.Parent = t
	t.Parent = sg
	sg.Parent = p
	return t
end

---------------------------------------------------------------------------
-- Props (scattered inside each zone)
---------------------------------------------------------------------------
type Deco = (folder: Instance, pos: Vector3, rng: Random) -> ()

local function treePrimitive(folder: Instance, pos: Vector3, rng: Random, scale: number?)
	local k = scale or 1
	local h = rng:NextNumber(7, 12) * k
	if k == 1 then
		blob(folder, pos, 9)
	end
	part(folder, { Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = V(h, 1.8 * k, 1.8 * k), CFrame = CFrame.new(pos + V(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = C(120, 80, 50), Material = Enum.Material.Wood, CastShadow = k == 1 })
	local greens = { C(80, 180, 70), C(60, 160, 60), C(110, 200, 80), C(150, 215, 90) }
	for i = 1, 4 do
		local r = rng:NextNumber(4.5, 7) * k
		local off = V(rng:NextNumber(-2.2, 2.2) * k, h + rng:NextNumber(-1, 3) * k, rng:NextNumber(-2.2, 2.2) * k)
		part(folder, { Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.one * r, Position = pos + off, Color = greens[i], Material = Enum.Material.Grass, CanCollide = false, CastShadow = i == 1 and k == 1 })
	end
end

local function tree(folder: Instance, pos: Vector3, rng: Random, scale: number?)
	if not (scale == nil or scale == 1) then
		treePrimitive(folder, pos, rng, scale)
		return
	end
	ModelSlots.spawn("tree", CFrame.new(pos), V(14, 16, 14), folder, function()
		treePrimitive(folder, pos, rng, scale)
		return nil
	end, { collide = true })
end

local function flower(folder: Instance, pos: Vector3, rng: Random)
	local cols = { C(255, 90, 120), C(255, 220, 60), C(170, 120, 255), WHITE, C(255, 150, 60) }
	local col = cols[rng:NextInteger(1, #cols)]
	local h = rng:NextNumber(1.1, 1.9)
	deco(folder, { Name = "Stem", Size = V(0.22, h, 0.22), Position = pos + V(0, h / 2, 0), Color = C(60, 150, 60) })
	ell(folder, "Bloom", pos + V(0, h + 0.15, 0), V(1.2, 0.5, 1.2), col)
	ball(folder, "Heart", pos + V(0, h + 0.3, 0), 0.5, C(255, 215, 70))
end

local function bushPrimitive(folder: Instance, pos: Vector3, rng: Random)
	local greens = { C(60, 150, 60), C(75, 170, 70), C(95, 185, 80) }
	for i = 1, 3 do
		local r = rng:NextNumber(3, 4.6)
		deco(folder, { Name = "Bush", Shape = Enum.PartType.Ball, Size = Vector3.one * r, Position = pos + V(rng:NextNumber(-1.6, 1.6), r * 0.3, rng:NextNumber(-1.6, 1.6)), Color = greens[i], Material = Enum.Material.Grass })
	end
	if rng:NextNumber() < 0.6 then
		for _ = 1, 3 do
			ball(folder, "Berry", pos + V(rng:NextNumber(-1.8, 1.8), rng:NextNumber(1.6, 2.6), rng:NextNumber(-1.8, 1.8)), 0.55, C(255, 80, 110))
		end
	end
end

local function bush(folder: Instance, pos: Vector3, rng: Random)
	if not (true) then
		bushPrimitive(folder, pos, rng)
		return
	end
	ModelSlots.spawn("bush", CFrame.new(pos), V(6, 4, 6), folder, function()
		bushPrimitive(folder, pos, rng)
		return nil
	end, { collide = false })
end

local function mushroomPrimitive(folder: Instance, pos: Vector3, rng: Random)
	local k = rng:NextNumber(0.8, 1.7)
	local cap = if rng:NextNumber() < 0.7 then C(235, 60, 70) else C(255, 170, 60)
	blob(folder, pos, 4 * k)
	cyl(folder, "Stem", pos + V(0, 1.1 * k, 0), 1.1 * k, 2.2 * k, C(250, 240, 225))
	ell(folder, "Cap", pos + V(0, 2.4 * k, 0), V(4 * k, 2 * k, 4 * k), cap)
	for i = 1, 4 do
		local a = i * 1.7
		ball(folder, "Dot", pos + V(math.cos(a) * 1.1 * k, 3.05 * k, math.sin(a) * 1.1 * k), 0.6 * k, WHITE)
	end
end

local function mushroom(folder: Instance, pos: Vector3, rng: Random)
	if not (true) then
		mushroomPrimitive(folder, pos, rng)
		return
	end
	ModelSlots.spawn("mushroom", CFrame.new(pos), V(5, 5, 5), folder, function()
		mushroomPrimitive(folder, pos, rng)
		return nil
	end, { collide = false })
end

local function rockPrimitive(folder: Instance, pos: Vector3, rng: Random, color: Color3?, mat: Enum.Material?)
	local s = rng:NextNumber(2, 5)
	part(folder, { Name = "Rock", Size = V(s, s * 0.7, s * 0.9), CFrame = CFrame.new(pos + V(0, s * 0.25, 0)) * CFrame.Angles(rng:NextNumber(0, 0.5), rng:NextNumber(0, 6), rng:NextNumber(0, 0.5)), Color = color or C(140, 140, 150), Material = mat or Enum.Material.Slate, CastShadow = false })
	if rng:NextNumber() < 0.5 then
		local s2 = s * 0.55
		deco(folder, { Name = "Rock", Size = V(s2, s2 * 0.7, s2), CFrame = CFrame.new(pos + V(s * 0.6, s2 * 0.25, s * 0.3)) * CFrame.Angles(rng:NextNumber(0, 0.5), rng:NextNumber(0, 6), 0), Color = darken(color or C(140, 140, 150), 0.12), Material = mat or Enum.Material.Slate })
	end
end

local function rock(folder: Instance, pos: Vector3, rng: Random, color: Color3?, mat: Enum.Material?)
	if not (color == nil) then
		rockPrimitive(folder, pos, rng, color, mat)
		return
	end
	ModelSlots.spawn("rock", CFrame.new(pos), V(5, 3.5, 5), folder, function()
		rockPrimitive(folder, pos, rng, color, mat)
		return nil
	end, { collide = true })
end

local function lollipopPrimitive(folder: Instance, pos: Vector3, rng: Random, scale: number?)
	local k = scale or 1
	local h = rng:NextNumber(6, 11) * k
	local cols = { C(255, 80, 150), C(90, 200, 255), C(255, 200, 60), C(150, 110, 255), C(120, 230, 150) }
	local c = cols[rng:NextInteger(1, #cols)]
	if k == 1 then
		blob(folder, pos, 5, C(255, 180, 215))
	end
	part(folder, { Name = "Stick", Size = V(0.6 * k, h, 0.6 * k), Position = pos + V(0, h / 2, 0), Color = WHITE, CastShadow = false })
	local yaw = rng:NextNumber(0, math.pi * 2)
	local cf = CFrame.new(pos + V(0, h + 2.4 * k, 0)) * CFrame.Angles(0, yaw, 0)
	deco(folder, { Name = "Candy", Shape = Enum.PartType.Cylinder, Size = V(1.2 * k, 6 * k, 6 * k), CFrame = cf, Color = c })
	deco(folder, { Name = "Swirl", Shape = Enum.PartType.Cylinder, Size = V(1.3 * k, 4.2 * k, 4.2 * k), CFrame = cf, Color = WHITE })
	deco(folder, { Name = "Swirl", Shape = Enum.PartType.Cylinder, Size = V(1.4 * k, 2.4 * k, 2.4 * k), CFrame = cf, Color = c })
end

local function lollipop(folder: Instance, pos: Vector3, rng: Random, scale: number?)
	if not (scale == nil or scale == 1) then
		lollipopPrimitive(folder, pos, rng, scale)
		return
	end
	ModelSlots.spawn("lollipop", CFrame.new(pos), V(7, 13, 7), folder, function()
		lollipopPrimitive(folder, pos, rng, scale)
		return nil
	end, { collide = true })
end

local function candyCane(folder: Instance, pos: Vector3, rng: Random, scale: number?)
	local k = scale or 1
	local seg = rng:NextInteger(6, 9)
	local red = C(230, 40, 60)
	for i = 0, seg - 1 do
		part(folder, { Name = "Cane", Size = V(1.2, 1.2, 1.2) * k, Position = pos + V(0, (0.6 + i * 1.2) * k, 0), Color = if i % 2 == 0 then red else WHITE, CastShadow = false })
	end
	for i = 1, 3 do
		deco(folder, { Name = "Hook", Size = V(1.2, 1.2, 1.2) * k, Position = pos + V(i * 1.1 * k, (seg * 1.2 + (if i == 3 then -0.6 else 0.2)) * k, 0), Color = if i % 2 == 0 then red else WHITE })
	end
end

local function gumdrop(folder: Instance, pos: Vector3, rng: Random)
	local cols = { C(255, 90, 90), C(120, 230, 120), C(255, 220, 80), C(190, 120, 255) }
	local s = rng:NextNumber(3, 6)
	part(folder, { Name = "Gumdrop", Shape = Enum.PartType.Ball, Size = Vector3.one * s, Position = pos + V(0, s * 0.2, 0), Color = cols[rng:NextInteger(1, #cols)], Material = Enum.Material.Glass, Transparency = 0.15, CastShadow = false })
end

local function cupcakePrimitive(folder: Instance, pos: Vector3, rng: Random)
	local k = rng:NextNumber(1, 1.8)
	local wraps = { C(120, 200, 255), C(255, 210, 90), C(180, 140, 255) }
	local frosts = { C(255, 150, 200), C(255, 245, 235), C(150, 235, 200) }
	blob(folder, pos, 5.5 * k, C(255, 180, 215))
	part(folder, { Name = "Wrapper", Shape = Enum.PartType.Cylinder, Size = V(2.2 * k, 3.4 * k, 3.4 * k), CFrame = CFrame.new(pos + V(0, 1.1 * k, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = wraps[rng:NextInteger(1, #wraps)], CastShadow = false })
	local frost = frosts[rng:NextInteger(1, #frosts)]
	ell(folder, "Frosting", pos + V(0, 2.7 * k, 0), V(4.2 * k, 2.2 * k, 4.2 * k), frost)
	ell(folder, "Frosting", pos + V(0, 3.7 * k, 0), V(2.8 * k, 1.7 * k, 2.8 * k), frost)
	ball(folder, "Cherry", pos + V(0, 4.8 * k, 0), 1.1 * k, C(230, 40, 70))
end

local function cupcake(folder: Instance, pos: Vector3, rng: Random)
	if not (true) then
		cupcakePrimitive(folder, pos, rng)
		return
	end
	ModelSlots.spawn("cupcake", CFrame.new(pos), V(7, 7, 7), folder, function()
		cupcakePrimitive(folder, pos, rng)
		return nil
	end, { collide = true })
end

local function iceCream(folder: Instance, pos: Vector3, rng: Random)
	local k = rng:NextNumber(1, 1.5)
	local scoops = { C(255, 170, 200), C(170, 235, 200), C(255, 240, 200), C(150, 100, 70) }
	blob(folder, pos, 5 * k, C(255, 180, 215))
	part(folder, { Name = "Cone", Shape = Enum.PartType.Cylinder, Size = V(3.4 * k, 2.2 * k, 2.2 * k), CFrame = CFrame.new(pos + V(0, 1.7 * k, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = C(225, 170, 100), Material = Enum.Material.Fabric, CastShadow = false })
	cyl(folder, "ConeRim", pos + V(0, 3.5 * k, 0), 3 * k, 0.5 * k, C(235, 185, 115), Enum.Material.Fabric)
	for i = 0, 1 do
		ball(folder, "Scoop", pos + V(0, (4.7 + i * 2.1) * k, 0), (3.2 - i * 0.5) * k, scoops[rng:NextInteger(1, #scoops)])
	end
	ball(folder, "Cherry", pos + V(0, 8.2 * k, 0), 0.9 * k, C(230, 40, 70))
end

local function pinePrimitive(folder: Instance, pos: Vector3, rng: Random, scale: number?)
	local k = scale or 1
	local h = rng:NextNumber(9, 15) * k
	if k == 1 then
		blob(folder, pos, 10, C(200, 215, 235))
	end
	part(folder, { Name = "Trunk", Size = V(1.4 * k, 3 * k, 1.4 * k), Position = pos + V(0, 1.5 * k, 0), Color = C(100, 70, 50), Material = Enum.Material.Wood, CastShadow = false })
	local layers = 4
	for i = 0, layers - 1 do
		local w = (8 - i * 1.7) * k
		local y = 3 * k + i * (h - 3 * k) / layers
		local yaw = math.rad(45 + i * 20)
		part(folder, { Name = "Needles", Size = V(w, 2.4 * k, w), CFrame = CFrame.new(pos + V(0, y, 0)) * CFrame.Angles(0, yaw, 0), Color = C(40, 110, 80), Material = Enum.Material.Grass, CanCollide = i == 0, CastShadow = i == 0 and k == 1 })
		deco(folder, { Name = "Snow", Size = V(w * 0.8, 0.5 * k, w * 0.8), CFrame = CFrame.new(pos + V(0, y + 1.4 * k, 0)) * CFrame.Angles(0, yaw, 0), Color = C(250, 252, 255), Material = Enum.Material.Snow })
	end
end

local function pine(folder: Instance, pos: Vector3, rng: Random, scale: number?)
	if not (scale == nil or scale == 1) then
		pinePrimitive(folder, pos, rng, scale)
		return
	end
	ModelSlots.spawn("pine", CFrame.new(pos), V(12, 16, 12), folder, function()
		pinePrimitive(folder, pos, rng, scale)
		return nil
	end, { collide = true })
end

local function crystalPrimitive(folder: Instance, pos: Vector3, rng: Random, color: Color3?, neon: boolean?, scale: number?)
	local c = color or C(150, 210, 255)
	local k = scale or 1
	for _ = 1, rng:NextInteger(2, 4) do
		local h = rng:NextNumber(3, 8) * k
		part(folder, { Name = "Crystal", Size = V(1.4 * k, h, 1.4 * k), CFrame = CFrame.new(pos + V(rng:NextNumber(-1.5, 1.5) * k, h * 0.4, rng:NextNumber(-1.5, 1.5) * k)) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6), rng:NextNumber(-0.4, 0.4)), Color = c, Material = if neon then Enum.Material.Neon else Enum.Material.Glass, Transparency = if neon then 0 else 0.25, CastShadow = false })
	end
end

local function crystal(folder: Instance, pos: Vector3, rng: Random, color: Color3?, neon: boolean?, scale: number?)
	if not (color == nil and neon == nil and scale == nil) then
		crystalPrimitive(folder, pos, rng, color, neon, scale)
		return
	end
	ModelSlots.spawn("crystal", CFrame.new(pos), V(4, 8, 4), folder, function()
		crystalPrimitive(folder, pos, rng, color, neon, scale)
		return nil
	end, { collide = true })
end

local function snowmanPrimitive(folder: Instance, pos: Vector3, _rng: Random)
	local white = C(250, 252, 255)
	blob(folder, pos, 5.5, C(200, 215, 235))
	part(folder, { Name = "Snow1", Shape = Enum.PartType.Ball, Size = Vector3.one * 4, Position = pos + V(0, 1.8, 0), Color = white, Material = Enum.Material.Snow, CastShadow = false })
	deco(folder, { Name = "Snow2", Shape = Enum.PartType.Ball, Size = Vector3.one * 3, Position = pos + V(0, 4.6, 0), Color = white, Material = Enum.Material.Snow })
	deco(folder, { Name = "Snow3", Shape = Enum.PartType.Ball, Size = Vector3.one * 2.2, Position = pos + V(0, 6.8, 0), Color = white, Material = Enum.Material.Snow })
	deco(folder, { Name = "Carrot", Size = V(0.35, 0.35, 1.3), Position = pos + V(0, 6.8, -1.4), Color = C(255, 140, 30) })
	for _, s in { -1, 1 } do
		ball(folder, "Eye", pos + V(0.4 * s, 7.2, -0.95), 0.35, C(20, 20, 20))
		deco(folder, { Name = "Arm", Size = V(2.6, 0.25, 0.25), CFrame = CFrame.new(pos + V(2.3 * s, 5.1, 0)) * CFrame.Angles(0, 0, math.rad(25 * s)), Color = C(95, 65, 45) })
	end
	cyl(folder, "HatBrim", pos + V(0, 7.85, 0), 2.4, 0.2, C(35, 35, 45))
	cyl(folder, "Hat", pos + V(0, 8.5, 0), 1.6, 1.2, C(35, 35, 45))
	ell(folder, "Scarf", pos + V(0, 5.95, 0), V(2.6, 0.7, 2.6), C(230, 50, 60), Enum.Material.Fabric)
end

local function snowman(folder: Instance, pos: Vector3, _rng: Random)
	if not (true) then
		snowmanPrimitive(folder, pos, _rng)
		return
	end
	ModelSlots.spawn("snowman", CFrame.new(pos), V(5, 9, 5), folder, function()
		snowmanPrimitive(folder, pos, _rng)
		return nil
	end, { collide = true })
end

local function snowMound(folder: Instance, pos: Vector3, rng: Random)
	local s = rng:NextNumber(6, 12)
	ell(folder, "Mound", pos + V(0, 0.2, 0), V(s, s * 0.35, s * rng:NextNumber(0.7, 1.1)), C(250, 252, 255), Enum.Material.Snow)
end

local function lavaPool(folder: Instance, pos: Vector3, rng: Random)
	local r = rng:NextNumber(6, 12)
	local pool = cyl(folder, "LavaPool", pos + V(0, 0.1, 0), r, 0.4, C(255, 110, 20), Enum.Material.Neon)
	cyl(folder, "LavaRim", pos + V(0, 0.05, 0), r + 1.6, 0.34, C(50, 38, 38), Enum.Material.Basalt)
	light(pool, C(255, 120, 40), r, 2)
	local fire = emitter(pool, FIRE, C(255, 150, 40), 5, 1.5, 4, 1.1)
	fire.LightEmission = 1
end

local function obsidian(folder: Instance, pos: Vector3, rng: Random)
	crystal(folder, pos, rng, C(35, 25, 40), false)
end

local function stalagmite(folder: Instance, pos: Vector3, rng: Random)
	local h = rng:NextNumber(5, 11)
	local col = C(62, 48, 48)
	blob(folder, pos, 5, C(60, 45, 45))
	part(folder, { Name = "Spike", Size = V(2.6, h * 0.55, 2.6), CFrame = CFrame.new(pos + V(0, h * 0.27, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), Color = col, Material = Enum.Material.Basalt, CastShadow = false })
	deco(folder, { Name = "Spike", Size = V(1.6, h * 0.4, 1.6), CFrame = CFrame.new(pos + V(0, h * 0.7, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), Color = darken(col, 0.15), Material = Enum.Material.Basalt })
	deco(folder, { Name = "Spike", Size = V(0.8, h * 0.25, 0.8), CFrame = CFrame.new(pos + V(0, h * 0.98, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), Color = C(255, 120, 30), Material = Enum.Material.Neon })
end

local function lavaCrack(folder: Instance, pos: Vector3, rng: Random)
	local yaw = rng:NextNumber(0, math.pi)
	local at = CFrame.new(pos + V(0, 0.07, 0)) * CFrame.Angles(0, yaw, 0)
	for i = 0, 3 do
		local len = rng:NextNumber(4, 8)
		local seg = at * CFrame.Angles(0, if i % 2 == 0 then 0.55 else -0.55, 0)
		deco(folder, { Name = "Crack", Size = V(0.5, 0.12, len), CFrame = seg * CFrame.new(0, 0, len / 2), Color = C(255, 120, 30), Material = Enum.Material.Neon })
		at = seg * CFrame.new(0, 0, len) * CFrame.Angles(0, if i % 2 == 0 then -0.55 else 0.55, 0)
	end
end

local function planet(folder: Instance, pos: Vector3, rng: Random)
	local cols = { C(255, 120, 200), C(120, 200, 255), C(255, 210, 90), C(150, 255, 170) }
	local c = cols[rng:NextInteger(1, #cols)]
	local s = rng:NextNumber(5, 12)
	local y = rng:NextNumber(18, 40)
	local model = Instance.new("Model")
	model.Name = "Planet"
	local body = deco(model, { Name = "Planet", Shape = Enum.PartType.Ball, Size = Vector3.one * s, Position = pos + V(0, y, 0), Color = c })
	deco(model, { Name = "Ring", Shape = Enum.PartType.Cylinder, Size = V(0.3, s * 1.8, s * 1.8), CFrame = CFrame.new(pos + V(0, y, 0)) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), 0, math.rad(90) + rng:NextNumber(-0.4, 0.4)), Color = WHITE, Material = Enum.Material.Neon, Transparency = 0.3 })
	model.PrimaryPart = body
	model.Parent = folder
	anim(model, V(0, 1, 0), rng:NextNumber(0.1, 0.3), rng:NextNumber(0.6, 1.4), rng:NextNumber(0.4, 0.9))
end

local function star(folder: Instance, pos: Vector3, rng: Random)
	ball(folder, "Star", pos + V(0, rng:NextNumber(6, 30), 0), rng:NextNumber(0.6, 1.4), C(255, 250, 200), Enum.Material.Neon)
end

local function asteroid(folder: Instance, pos: Vector3, rng: Random)
	local s = rng:NextNumber(4, 9)
	local model = Instance.new("Model")
	model.Name = "Asteroid"
	local body = deco(model, { Name = "Rock", Size = V(s, s * 0.75, s * 0.9), CFrame = CFrame.new(pos + V(0, rng:NextNumber(16, 36), 0)) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), rng:NextNumber(0, 6)), Color = C(70, 60, 110), Material = Enum.Material.Slate })
	deco(model, { Name = "Gem", Size = V(s * 0.3, s * 0.7, s * 0.3), CFrame = body.CFrame * CFrame.new(0, s * 0.45, 0) * CFrame.Angles(0.3, 0, 0.2), Color = C(120, 220, 255), Material = Enum.Material.Neon })
	model.PrimaryPart = body
	model.Parent = folder
	anim(model, V(0.3, 1, 0.2).Unit, rng:NextNumber(0.1, 0.35), rng:NextNumber(0.8, 1.8), rng:NextNumber(0.3, 0.7))
end

local DECOR: { [string]: { { fn: Deco, count: number } } } = {
	meadow = { { fn = tree, count = 24 }, { fn = flower, count = 46 }, { fn = bush, count = 14 }, { fn = mushroom, count = 12 }, { fn = rock, count = 9 } },
	candy = { { fn = lollipop, count = 18 }, { fn = candyCane, count = 10 }, { fn = gumdrop, count = 18 }, { fn = cupcake, count = 12 }, { fn = iceCream, count = 9 } },
	frost = { { fn = pine, count = 24 }, { fn = crystal, count = 12 }, { fn = snowman, count = 6 }, { fn = snowMound, count = 16 } },
	lava = {
		{ fn = lavaPool, count = 9 },
		{ fn = obsidian, count = 12 },
		{ fn = stalagmite, count = 16 },
		{ fn = lavaCrack, count = 14 },
		{
			fn = function(f, p, r)
				rock(f, p, r, C(60, 45, 45), Enum.Material.Basalt)
			end,
			count = 14,
		},
	},
	cosmic = {
		{ fn = planet, count = 10 },
		{ fn = star, count = 40 },
		{ fn = asteroid, count = 9 },
		{
			fn = function(f, p, r)
				crystal(f, p, r, C(170, 110, 255), true)
			end,
			count = 14,
		},
	},
}

---------------------------------------------------------------------------
-- Zone borders (the visible edge; the invisible walls do the blocking)
---------------------------------------------------------------------------
local BORDER: { [string]: (folder: Instance, zc: number) -> () } = {
	meadow = function(folder, zc)
		local wood = C(205, 165, 115)
		for _, s in { -1, 1 } do
			local x = s * (W / 2 - 1)
			for z = zc - L / 2 + 4, zc + L / 2 - 4, 8 do
				deco(folder, { Name = "Post", Size = V(1.1, 5.6, 1.1), Position = V(x, 2.8, z), Color = wood, Material = Enum.Material.Wood })
			end
			for _, y in { 2, 4.2 } do
				deco(folder, { Name = "Rail", Size = V(0.5, 0.8, L), Position = V(x, y, zc), Color = lighten(wood, 0.12), Material = Enum.Material.Wood })
			end
			deco(folder, { Name = "Hedge", Size = V(5, 4.4, L), Position = V(s * (W / 2 + 3.5), 2.2, zc), Color = C(55, 140, 60), Material = Enum.Material.Grass })
		end
	end,
	candy = function(folder, zc)
		local tops = { C(255, 90, 90), C(120, 230, 120), C(255, 220, 80), C(190, 120, 255), C(90, 200, 255) }
		for _, s in { -1, 1 } do
			local x = s * (W / 2 - 1)
			local i = 0
			for z = zc - L / 2 + 4, zc + L / 2 - 4, 8 do
				i += 1
				deco(folder, { Name = "Post", Size = V(1.4, 6, 1.4), Position = V(x, 3, z), Color = if i % 2 == 0 then C(230, 40, 60) else WHITE })
				ball(folder, "Gumball", V(x, 6.6, z), 2.2, tops[i % #tops + 1], Enum.Material.Glass)
			end
			deco(folder, { Name = "Rail", Size = V(0.8, 1, L), Position = V(x, 3.4, zc), Color = C(255, 245, 250) })
			deco(folder, { Name = "Frosting", Size = V(4, 3, L), Position = V(s * (W / 2 + 3), 1.5, zc), Color = C(255, 235, 245) })
		end
	end,
	frost = function(folder, zc)
		local rng = Random.new(303)
		for _, s in { -1, 1 } do
			for z = zc - L / 2 + 4, zc + L / 2 - 4, 8 do
				local h = rng:NextNumber(5, 10)
				deco(folder, { Name = "IceBlock", Size = V(3, h, 8.2), CFrame = CFrame.new(s * (W / 2 - 1.5), h / 2, z) * CFrame.Angles(0, 0, rng:NextNumber(-0.06, 0.06)), Color = C(165, 215, 255), Material = Enum.Material.Ice, Transparency = 0.12 })
			end
			deco(folder, { Name = "SnowBank", Size = V(7, 3.2, L), Position = V(s * (W / 2 + 4), 1.2, zc), Color = C(250, 252, 255), Material = Enum.Material.Snow })
		end
	end,
	lava = function(folder, zc)
		local rng = Random.new(404)
		for _, s in { -1, 1 } do
			for z = zc - L / 2 + 4, zc + L / 2 - 4, 8 do
				local h = rng:NextNumber(6, 13)
				deco(folder, { Name = "Spike", Size = V(3.2, h, 5.4), CFrame = CFrame.new(s * (W / 2 - 1.5), h / 2 - 0.8, z) * CFrame.Angles(rng:NextNumber(-0.22, 0.22), rng:NextNumber(0, 1), rng:NextNumber(-0.22, 0.22)), Color = C(45, 35, 38), Material = Enum.Material.Basalt })
			end
			deco(folder, { Name = "Glow", Size = V(1.4, 0.3, L), Position = V(s * (W / 2 - 4), 0.12, zc), Color = C(255, 110, 25), Material = Enum.Material.Neon })
		end
	end,
	cosmic = function(folder, zc)
		for _, s in { -1, 1 } do
			local x = s * (W / 2 - 1.2)
			for z = zc - L / 2 + 6, zc + L / 2 - 6, 16 do
				deco(folder, { Name = "Pylon", Size = V(1.6, 8, 1.6), Position = V(x, 4, z), Color = C(40, 32, 80), Material = Enum.Material.Metal })
				ball(folder, "PylonOrb", V(x, 8.8, z), 2, C(120, 220, 255), Enum.Material.Neon)
			end
			deco(folder, { Name = "Beam", Size = V(0.35, 0.35, L), Position = V(x, 6, zc), Color = C(190, 120, 255), Material = Enum.Material.Neon, Transparency = 0.15 })
			deco(folder, { Name = "Beam", Size = V(0.35, 0.35, L), Position = V(x, 3, zc), Color = C(120, 220, 255), Material = Enum.Material.Neon, Transparency = 0.15 })
			deco(folder, { Name = "Edge", Size = V(1.6, 0.4, L), Position = V(s * (W / 2 - 0.8), 0.15, zc), Color = C(130, 90, 255), Material = Enum.Material.Neon })
		end
	end,
}

---------------------------------------------------------------------------
-- Path lamps
---------------------------------------------------------------------------
local function lamps(folder: Instance, zc: number, zone: any)
	for _, s in { -1, 1 } do
		for z = zc - L / 2 + 26, zc + L / 2 - 26, 42 do
			local pos = V(s * 11.5, 0, z)
			if zone.decor == "meadow" then
				deco(folder, { Name = "LampPost", Size = V(0.7, 7, 0.7), Position = pos + V(0, 3.5, 0), Color = C(110, 75, 50), Material = Enum.Material.Wood })
				deco(folder, { Name = "LampArm", Size = V(2, 0.4, 0.4), Position = pos + V(-s * 0.8, 6.8, 0), Color = C(110, 75, 50), Material = Enum.Material.Wood })
				ball(folder, "Lantern", pos + V(-s * 1.6, 6, 0), 1.5, C(255, 225, 120), Enum.Material.Neon)
			elseif zone.decor == "candy" then
				for i = 0, 4 do
					deco(folder, { Name = "LampPost", Size = V(0.9, 1.4, 0.9), Position = pos + V(0, 0.7 + i * 1.4, 0), Color = if i % 2 == 0 then C(255, 120, 190) else WHITE })
				end
				ball(folder, "Lantern", pos + V(0, 8, 0), 2.4, C(255, 170, 220), Enum.Material.Neon)
			elseif zone.decor == "frost" then
				deco(folder, { Name = "LampPost", Size = V(0.8, 6, 0.8), Position = pos + V(0, 3, 0), Color = C(170, 200, 230), Material = Enum.Material.Ice })
				deco(folder, { Name = "Lantern", Size = V(1.6, 1.6, 1.6), CFrame = CFrame.new(pos + V(0, 7, 0)) * CFrame.Angles(math.rad(45), 0, math.rad(45)), Color = C(150, 225, 255), Material = Enum.Material.Neon })
			elseif zone.decor == "lava" then
				deco(folder, { Name = "LampPost", Size = V(1.2, 5, 1.2), Position = pos + V(0, 2.5, 0), Color = C(55, 42, 42), Material = Enum.Material.Basalt })
				local bowl = cyl(folder, "Brazier", pos + V(0, 5.3, 0), 2.6, 0.8, C(40, 30, 32), Enum.Material.Basalt)
				local flame = ball(folder, "Lantern", pos + V(0, 6.1, 0), 1.4, C(255, 140, 40), Enum.Material.Neon)
				local fire = emitter(bowl, FIRE, C(255, 160, 50), 12, 2, 5, 0.8)
				fire.EmissionDirection = Enum.NormalId.Right
				fire.LightEmission = 1
				light(flame, C(255, 140, 50), 20, 1.6)
			else
				local orb = ball(folder, "Lantern", pos + V(0, 6, 0), 2, C(190, 130, 255), Enum.Material.Neon)
				cyl(folder, "LampBase", pos + V(0, 0.25, 0), 3, 0.5, C(60, 45, 120), Enum.Material.Metal)
				anim(orb, nil, nil, 0.7, 1.3)
				light(orb, C(170, 120, 255), 20, 1.4)
			end
		end
	end
end

---------------------------------------------------------------------------
-- Landmarks: two per zone, off the path. Each returns the circle it occupies.
---------------------------------------------------------------------------
local function windmillPrimitive(folder: Instance, pos: Vector3, facing: number): Reserved
	local model = Instance.new("Model")
	model.Name = "Windmill"
	local towerH = 24
	part(model, { Name = "Tower", Shape = Enum.PartType.Cylinder, Size = V(towerH, 11, 11), CFrame = CFrame.new(pos + V(0, towerH / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = C(250, 240, 220), Material = Enum.Material.Plaster })
	cyl(model, "Band", pos + V(0, 8, 0), 11.4, 1.2, C(200, 90, 80))
	ell(model, "Roof", pos + V(0, towerH + 1.5, 0), V(13, 9, 13), C(200, 70, 70))
	deco(model, { Name = "Door", Size = V(3, 5, 0.6), Position = pos + V(facing * 5.4, 2.5, 0), Color = C(120, 80, 50), Material = Enum.Material.Wood })
	ball(model, "Window", pos + V(facing * 5.2, 13, 0), 2.4, C(150, 220, 255), Enum.Material.Glass)
	-- blades turn around the hub's X axis
	local blades = Instance.new("Model")
	blades.Name = "Blades"
	local hubPos = pos + V(facing * 6.6, towerH - 3, 0)
	local hub = deco(blades, { Name = "Hub", Shape = Enum.PartType.Ball, Size = V(2.4, 2.4, 2.4), Position = hubPos, Color = C(120, 80, 50), Material = Enum.Material.Wood })
	for i = 0, 3 do
		local rot = CFrame.new(hubPos) * CFrame.Angles(math.rad(i * 90), 0, 0)
		deco(blades, { Name = "Arm", Size = V(0.5, 15, 0.7), CFrame = rot * CFrame.new(0, 7.5, 0), Color = C(120, 80, 50), Material = Enum.Material.Wood })
		deco(blades, { Name = "Sail", Size = V(0.3, 10.5, 3.6), CFrame = rot * CFrame.new(0, 9, 1.9), Color = C(255, 250, 235), Material = Enum.Material.Fabric })
	end
	blades.PrimaryPart = hub
	blades.Parent = model
	anim(blades, V(1, 0, 0), 0.7)
	model.Parent = folder
	return { pos = pos, r = 18 }
end

local function windmill(folder: Instance, pos: Vector3, facing: number): Reserved
	ModelSlots.spawn("windmill", CFrame.new(pos) * CFrame.Angles(0, -math.pi / 2 * facing, 0), V(26, 34, 26), folder, function()
		windmillPrimitive(folder, pos, facing)
		return nil
	end, { collide = true })
	return { pos = pos, r = 18 }
end

local function duck(folder: Instance, pos: Vector3, yaw: number)
	local model = Instance.new("Model")
	model.Name = "Duck"
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	local body = deco(model, { Name = "Body", Mesh = Enum.MeshType.Sphere, Size = V(1.8, 1.4, 2.4), CFrame = cf, Color = C(255, 225, 70) })
	deco(model, { Name = "Head", Shape = Enum.PartType.Ball, Size = V(1.2, 1.2, 1.2), CFrame = cf * CFrame.new(0, 0.9, -0.9), Color = C(255, 225, 70) })
	deco(model, { Name = "Beak", Size = V(0.5, 0.25, 0.6), CFrame = cf * CFrame.new(0, 0.8, -1.6), Color = C(255, 150, 30) })
	model.PrimaryPart = body
	model.Parent = folder
	anim(model, V(0, 1, 0), 0.25, 0.12, 2.2)
end

local function pond(folder: Instance, pos: Vector3): Reserved
	local rng = Random.new(77)
	cyl(folder, "Pond", pos + V(0, 0.08, 0), 34, 0.3, C(90, 185, 245), Enum.Material.Glass, { Reflectance = 0.2 })
	cyl(folder, "PondShore", pos + V(0, 0.04, 0), 38, 0.24, C(225, 205, 150), Enum.Material.Sand)
	for i = 1, 9 do
		local a = i / 9 * math.pi * 2 + 0.3
		rock(folder, pos + V(math.cos(a) * 17.5, 0, math.sin(a) * 17.5), rng)
	end
	for i = 1, 4 do
		local a = i * 1.9
		local p = pos + V(math.cos(a) * 8, 0.28, math.sin(a) * 8)
		cyl(folder, "LilyPad", p, 3.4, 0.12, C(70, 170, 80))
		if i % 2 == 0 then
			ell(folder, "Lily", p + V(0, 0.4, 0), V(1.4, 0.7, 1.4), C(255, 160, 200))
		end
	end
	duck(folder, pos + V(4, 0.75, -3), 0.6)
	duck(folder, pos + V(-6, 0.75, 5), 2.4)
	return { pos = pos, r = 22 }
end

local function cakePrimitive(folder: Instance, pos: Vector3): Reserved
	local tiers = { { d = 26, h = 8, c = C(255, 150, 200) }, { d = 19, h = 7, c = C(255, 245, 225) }, { d = 12, h = 6, c = C(150, 235, 205) } }
	local y = 0
	for t, tier in tiers do
		part(folder, { Name = "CakeTier", Shape = Enum.PartType.Cylinder, Size = V(tier.h, tier.d, tier.d), CFrame = CFrame.new(pos + V(0, y + tier.h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = tier.c })
		cyl(folder, "Icing", pos + V(0, y + tier.h, 0), tier.d + 0.8, 0.9, WHITE)
		local drips = 10 - t * 2
		for i = 1, drips do
			local a = i / drips * math.pi * 2 + t
			ell(folder, "Drip", pos + V(math.cos(a) * tier.d / 2, y + tier.h - 0.9, math.sin(a) * tier.d / 2), V(2.2, 3 + (i % 3), 2.2), WHITE)
		end
		y += tier.h
	end
	for i = 1, 5 do
		local a = i / 5 * math.pi * 2
		local p = pos + V(math.cos(a) * 3.6, y, math.sin(a) * 3.6)
		deco(folder, { Name = "Candle", Size = V(0.7, 3.4, 0.7), Position = p + V(0, 1.7, 0), Color = if i % 2 == 0 then C(120, 200, 255) else C(255, 210, 90) })
		local flame = ell(folder, "Flame", p + V(0, 4, 0), V(0.8, 1.4, 0.8), C(255, 200, 70), Enum.Material.Neon)
		anim(flame, nil, nil, 0.15, 6 + i)
	end
	ball(folder, "Cherry", pos + V(0, y + 1.6, 0), 3.2, C(230, 40, 70))
	return { pos = pos, r = 20 }
end

local function cake(folder: Instance, pos: Vector3): Reserved
	ModelSlots.spawn("cake", CFrame.new(pos), V(28, 24, 28), folder, function()
		cakePrimitive(folder, pos)
		return nil
	end, { collide = true })
	return { pos = pos, r = 22 }
end

local function chocolatePond(folder: Instance, pos: Vector3): Reserved
	cyl(folder, "Chocolate", pos + V(0, 0.08, 0), 34, 0.3, C(110, 65, 40), nil, { Reflectance = 0.25 })
	cyl(folder, "Shore", pos + V(0, 0.04, 0), 38, 0.24, C(255, 245, 225))
	for i = 1, 6 do
		local a = i * 1.1
		local rr = 4 + (i % 3) * 4
		local m = cyl(folder, "Marshmallow", pos + V(math.cos(a) * rr, 0.9, math.sin(a) * rr), 2.6, 2, if i % 2 == 0 then C(255, 200, 225) else WHITE)
		anim(m, nil, nil, 0.18, 1.2 + i * 0.2)
	end
	-- chocolate fountain in the middle
	cyl(folder, "FountainBase", pos + V(0, 1.5, 0), 6, 3, C(255, 235, 245))
	cyl(folder, "FountainBowl", pos + V(0, 3.4, 0), 8, 0.8, C(255, 150, 200))
	cyl(folder, "FountainStem", pos + V(0, 5.8, 0), 2, 4, C(255, 235, 245))
	local top = ell(folder, "FountainTop", pos + V(0, 8.2, 0), V(4, 2, 4), C(110, 65, 40), nil, { Reflectance = 0.25 })
	local drip = emitter(top, SMOKE, C(120, 70, 45), 14, 0.9, 5, 0.9)
	drip.Acceleration = V(0, -30, 0)
	drip.SpreadAngle = Vector2.new(60, 60)
	drip.LightEmission = 0
	drip.EmissionDirection = Enum.NormalId.Top
	return { pos = pos, r = 22 }
end

local function iglooPrimitive(folder: Instance, pos: Vector3, facing: number): Reserved
	local white = C(245, 250, 255)
	part(folder, { Name = "Igloo", Shape = Enum.PartType.Ball, Size = V(24, 24, 24), Position = pos + V(0, -1, 0), Color = white, Material = Enum.Material.Snow })
	for i = 1, 3 do
		cyl(folder, "IglooRing", pos + V(0, i * 2.6, 0), 24.3 * math.sqrt(1 - ((i * 2.6 + 1) / 12) ^ 2), 0.25, C(200, 225, 245), Enum.Material.Ice)
	end
	deco(folder, { Name = "Tunnel", Shape = Enum.PartType.Cylinder, Size = V(7, 8, 8), Position = pos + V(facing * 11.5, 2.2, 0), Color = white, Material = Enum.Material.Snow, CanCollide = true })
	deco(folder, { Name = "Door", Shape = Enum.PartType.Cylinder, Size = V(7.3, 5.4, 5.4), Position = pos + V(facing * 11.6, 1.8, 0), Color = C(40, 50, 75) })
	ball(folder, "Lantern", pos + V(facing * 15.4, 6.4, 0), 1.4, C(255, 215, 120), Enum.Material.Neon)
	return { pos = pos, r = 19 }
end

local function igloo(folder: Instance, pos: Vector3, facing: number): Reserved
	ModelSlots.spawn("igloo", CFrame.new(pos) * CFrame.Angles(0, -math.pi / 2 * facing, 0), V(28, 16, 28), folder, function()
		iglooPrimitive(folder, pos, facing)
		return nil
	end, { collide = true })
	return { pos = pos, r = 19 }
end

local function frozenLake(folder: Instance, pos: Vector3): Reserved
	local rng = Random.new(91)
	cyl(folder, "Lake", pos + V(0, 0.08, 0), 36, 0.3, C(170, 225, 255), Enum.Material.Ice, { Reflectance = 0.3, CanCollide = true })
	cyl(folder, "LakeShore", pos + V(0, 0.04, 0), 40, 0.24, C(250, 252, 255), Enum.Material.Snow)
	for i = 1, 5 do
		local a = i * 1.3
		deco(folder, { Name = "IceCrack", Size = V(0.25, 0.06, rng:NextNumber(6, 12)), CFrame = CFrame.new(pos + V(math.cos(a) * 6, 0.26, math.sin(a) * 6)) * CFrame.Angles(0, a * 2, 0), Color = WHITE, Material = Enum.Material.Neon, Transparency = 0.4 })
	end
	-- crystal spire on the far shore
	for i = 1, 5 do
		local h = 10 + i * 4
		deco(folder, { Name = "Spire", Size = V(3.2, h, 3.2), CFrame = CFrame.new(pos + V(14 + (i % 3) * 2.2, h * 0.42, 12 - i * 2)) * CFrame.Angles(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, 6), rng:NextNumber(-0.25, 0.25)), Color = C(140, 210, 255), Material = Enum.Material.Glass, Transparency = 0.2, CanCollide = true })
	end
	return { pos = pos, r = 24 }
end

local function volcanoPrimitive(folder: Instance, pos: Vector3): Reserved
	local rock = C(58, 44, 44)
	local tiers = { { d = 34, h = 8 }, { d = 26, h = 7 }, { d = 18, h = 7 }, { d = 11, h = 6 } }
	local y = 0
	for i, t in tiers do
		part(folder, { Name = "Volcano", Shape = Enum.PartType.Cylinder, Size = V(t.h, t.d, t.d), CFrame = CFrame.new(pos + V(0, y + t.h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = if i % 2 == 0 then darken(rock, 0.12) else rock, Material = Enum.Material.Basalt })
		y += t.h
	end
	local crater = cyl(folder, "Crater", pos + V(0, y + 0.1, 0), 8.6, 0.5, C(255, 120, 25), Enum.Material.Neon)
	light(crater, C(255, 120, 40), 40, 2.5)
	local fire = emitter(crater, FIRE, C(255, 150, 40), 22, 4, 12, 1.4)
	fire.EmissionDirection = Enum.NormalId.Right
	fire.LightEmission = 1
	local smoke = emitter(crater, SMOKE, C(70, 55, 55), 5, 9, 9, 5)
	smoke.EmissionDirection = Enum.NormalId.Right
	smoke.LightEmission = 0
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 5), NumberSequenceKeypoint.new(1, 16) })
	-- lava running down two sides
	for i = 0, 1 do
		local yaw = i * 2.2 + 0.4
		deco(folder, { Name = "LavaFlow", Size = V(3, 0.5, 33), CFrame = CFrame.new(pos + V(0, y, 0)) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(math.rad(-58), 0, 0) * CFrame.new(0, 0.2, 17.5), Color = C(255, 120, 25), Material = Enum.Material.Neon })
	end
	return { pos = pos, r = 22 }
end

local function volcano(folder: Instance, pos: Vector3): Reserved
	ModelSlots.spawn("volcano", CFrame.new(pos), V(36, 34, 36), folder, function()
		volcanoPrimitive(folder, pos)
		return nil
	end, { collide = true })
	return { pos = pos, r = 22 }
end

local function lavaLake(folder: Instance, pos: Vector3): Reserved
	local rng = Random.new(55)
	local lake = cyl(folder, "LavaLake", pos + V(0, 0.1, 0), 36, 0.4, C(255, 105, 20), Enum.Material.Neon)
	cyl(folder, "LavaShore", pos + V(0, 0.05, 0), 40, 0.34, C(45, 34, 36), Enum.Material.Basalt)
	light(lake, C(255, 120, 40), 36, 2)
	local bubbles = emitter(lake, FIRE, C(255, 170, 60), 14, 2.2, 5, 1.2)
	bubbles.EmissionDirection = Enum.NormalId.Right
	bubbles.LightEmission = 1
	for i = 1, 5 do
		local a = i * 1.4
		local rr = 5 + (i % 3) * 4
		rock(folder, pos + V(math.cos(a) * rr, 0.1, math.sin(a) * rr), rng, C(50, 38, 40), Enum.Material.Basalt)
	end
	return { pos = pos, r = 23 }
end

local function ufo(folder: Instance, pos: Vector3): Reserved
	local model = Instance.new("Model")
	model.Name = "Ufo"
	local y = 24
	local disc = deco(model, { Name = "Disc", Shape = Enum.PartType.Cylinder, Size = V(2.4, 22, 22), CFrame = CFrame.new(pos + V(0, y, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = C(170, 175, 200), Material = Enum.Material.Metal })
	deco(model, { Name = "Rim", Shape = Enum.PartType.Cylinder, Size = V(1, 26, 26), CFrame = CFrame.new(pos + V(0, y - 0.4, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = C(110, 115, 150), Material = Enum.Material.Metal })
	deco(model, { Name = "Dome", Shape = Enum.PartType.Ball, Size = V(11, 11, 11), Position = pos + V(0, y + 1.6, 0), Color = C(130, 230, 255), Material = Enum.Material.Glass, Transparency = 0.35 })
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		deco(model, { Name = "Light", Shape = Enum.PartType.Ball, Size = V(1.6, 1.6, 1.6), Position = pos + V(math.cos(a) * 11.5, y - 0.9, math.sin(a) * 11.5), Color = if i % 2 == 0 then C(255, 230, 90) else C(255, 110, 200), Material = Enum.Material.Neon })
	end
	local beam = deco(model, { Name = "Beam", Shape = Enum.PartType.Cylinder, Size = V(y - 1, 10, 10), CFrame = CFrame.new(pos + V(0, (y - 1) / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = C(140, 255, 200), Material = Enum.Material.Neon, Transparency = 0.82 })
	light(beam, C(140, 255, 200), 26, 1.5)
	model.PrimaryPart = disc
	model.Parent = folder
	anim(model, V(1, 0, 0), 0.5, 1.2, 0.9) -- the disc's X axis points up (cylinder)
	cyl(folder, "LandingPad", pos + V(0, 0.1, 0), 14, 0.3, C(120, 220, 255), Enum.Material.Neon, { Transparency = 0.5 })
	return { pos = pos, r = 18 }
end

local function rocketPrimitive(folder: Instance, pos: Vector3): Reserved
	cyl(folder, "Pad", pos + V(0, 0.4, 0), 22, 0.8, C(70, 60, 120), Enum.Material.Metal, { CanCollide = true })
	cyl(folder, "PadRing", pos + V(0, 0.85, 0), 18, 0.2, C(255, 210, 80), Enum.Material.Neon)
	part(folder, { Name = "RocketBody", Shape = Enum.PartType.Cylinder, Size = V(22, 8, 8), CFrame = CFrame.new(pos + V(0, 15, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = C(245, 245, 250) })
	cyl(folder, "Stripe", pos + V(0, 20, 0), 8.2, 2, C(235, 60, 70))
	ell(folder, "Nose", pos + V(0, 27, 0), V(8, 11, 8), C(235, 60, 70))
	ball(folder, "Window", pos + V(0, 17, -3.6), 3, C(120, 220, 255), Enum.Material.Neon)
	for i = 0, 2 do
		local cf = CFrame.new(pos + V(0, 6.5, 0)) * CFrame.Angles(0, i * math.pi * 2 / 3, 0)
		deco(folder, { Name = "Fin", ClassName = "WedgePart", Size = V(1, 8, 5), CFrame = cf * CFrame.new(0, 0, 6.2), Color = C(235, 60, 70) })
	end
	local nozzle = cyl(folder, "Nozzle", pos + V(0, 3, 0), 5.5, 2.4, C(90, 90, 110), Enum.Material.Metal)
	local smoke = emitter(nozzle, SMOKE, C(230, 230, 245), 6, 3.5, 3, 2.2)
	smoke.EmissionDirection = Enum.NormalId.Left
	smoke.LightEmission = 0.2
	return { pos = pos, r = 15 }
end

local function rocket(folder: Instance, pos: Vector3): Reserved
	ModelSlots.spawn("rocket", CFrame.new(pos), V(22, 34, 22), folder, function()
		rocketPrimitive(folder, pos)
		return nil
	end, { collide = true })
	return { pos = pos, r = 15 }
end

local function portal(folder: Instance, pos: Vector3)
	local model = Instance.new("Model")
	model.Name = "Portal"
	local cy = 17
	local core = deco(model, { Name = "Core", Shape = Enum.PartType.Cylinder, Size = V(0.6, 24, 24), CFrame = CFrame.new(pos + V(0, cy, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = C(150, 90, 255), Material = Enum.Material.Neon, Transparency = 0.55 })
	for i = 1, 16 do
		local a = i / 16 * math.pi * 2
		deco(model, { Name = "RingSeg", Size = V(5.6, 2.4, 2.4), CFrame = CFrame.new(pos + V(math.cos(a) * 14, cy + math.sin(a) * 14, 0)) * CFrame.Angles(0, 0, a + math.pi / 2), Color = if i % 2 == 0 then C(120, 220, 255) else C(255, 120, 220), Material = Enum.Material.Neon })
	end
	model.PrimaryPart = core
	model.Parent = folder
	anim(model, V(1, 0, 0), 0.35)
	local swirl = emitter(core, SPARKLES, C(200, 160, 255), 18, 1.6, 6, 1.6)
	swirl.SpreadAngle = Vector2.new(180, 180)
	swirl.LightEmission = 1
	light(core, C(170, 120, 255), 40, 2)
	for _, s in { -1, 1 } do
		deco(folder, { Name = "PortalBase", Size = V(6, 4, 6), Position = pos + V(s * 13, 2, 0), Color = C(40, 32, 80), Material = Enum.Material.Metal, CanCollide = true })
	end
end

local function rockArch(folder: Instance, z: number)
	local rng = Random.new(66)
	local col = C(58, 44, 46)
	for _, s in { -1, 1 } do
		for i = 0, 2 do
			part(folder, { Name = "ArchRock", Size = V(7 - i, 7, 7 - i), CFrame = CFrame.new(s * (13.5 - i * 0.8), 3.5 + i * 6.6, z) * CFrame.Angles(rng:NextNumber(-0.12, 0.12), rng:NextNumber(0, 1), rng:NextNumber(-0.12, 0.12)), Color = if i % 2 == 0 then col else darken(col, 0.15), Material = Enum.Material.Basalt, CastShadow = false })
		end
	end
	part(folder, { Name = "ArchTop", Size = V(34, 5.5, 7), CFrame = CFrame.new(0, 22.5, z) * CFrame.Angles(0, 0.05, 0.03), Color = col, Material = Enum.Material.Basalt, CastShadow = false })
	deco(folder, { Name = "ArchGlow", Size = V(30, 0.5, 1.2), Position = V(0, 19.6, z), Color = C(255, 120, 30), Material = Enum.Material.Neon })
end

-- Builds a zone's landmarks and returns the areas props must keep out of.
local function landmarks(folder: Instance, zone: any, zc: number): { Reserved }
	local a, b = V(-56, 0, zc + 64), V(56, 0, zc - 38)
	if zone.decor == "meadow" then
		return { windmill(folder, a, 1), pond(folder, b) }
	elseif zone.decor == "candy" then
		return { cake(folder, a), chocolatePond(folder, b) }
	elseif zone.decor == "frost" then
		return { igloo(folder, a, 1), frozenLake(folder, b) }
	elseif zone.decor == "lava" then
		rockArch(folder, zc - 62)
		return { volcano(folder, a), lavaLake(folder, b), { pos = V(-13.5, 0, zc - 62), r = 9 }, { pos = V(13.5, 0, zc - 62), r = 9 } }
	end
	portal(folder, V(0, 0, zc + L / 2 - 16))
	return { ufo(folder, a), rocket(folder, b) }
end

---------------------------------------------------------------------------
-- Horizon: the ground beyond the walls plus big silhouettes
---------------------------------------------------------------------------
local function horizon(folder: Instance, zone: any, zc: number)
	local i = zone.index
	local rng = Random.new(2000 + i)
	local ground = rgb(zone.ground)
	local mat = Palette.material(zone.groundMaterial)
	if zone.decor ~= "cosmic" then
		for _, s in { -1, 1 } do
			deco(folder, { Name = "Skirt", Size = V(SKIRT, 4, L), Position = V(s * (W / 2 + SKIRT / 2 + 2), -2.15, zc), Color = darken(ground, 0.08), Material = mat })
		end
	end
	for _, s in { -1, 1 } do
		local function at(minOut: number, maxOut: number): (number, number)
			return s * (W / 2 + rng:NextNumber(minOut, maxOut)), zc + rng:NextNumber(-L / 2 + 10, L / 2 - 10)
		end
		if zone.decor == "meadow" then
			local greens = { C(95, 185, 75), C(80, 170, 70), C(115, 200, 85) }
			for k = 1, 5 do
				local size = rng:NextNumber(90, 150)
				local x, z = at(40, 150)
				x += s * size * 0.3
				ball(folder, "Hill", V(x, -size * 0.3, z), size, greens[k % 3 + 1], Enum.Material.Grass)
				tree(folder, V(x + rng:NextNumber(-8, 8), size * 0.19, z + rng:NextNumber(-8, 8)), rng, 2.4)
			end
			for _ = 1, 3 do
				local x, z = at(200, 270)
				peak(folder, x, z, rng:NextNumber(90, 130), rng:NextNumber(0, 6), C(120, 150, 190), Enum.Material.Slate, WHITE, Enum.Material.Snow)
			end
		elseif zone.decor == "candy" then
			local bodies = { C(255, 170, 205), C(175, 235, 210), C(255, 225, 160), C(200, 170, 255) }
			for k = 1, 5 do
				local size = rng:NextNumber(80, 140)
				local x, z = at(40, 150)
				x += s * size * 0.3
				local c = V(x, -size * 0.3, z)
				ball(folder, "Hill", c, size, bodies[k % 4 + 1])
				ball(folder, "HillFrosting", c + V(0, size * 0.115, 0), size * 0.8, WHITE)
				ball(folder, "HillCherry", V(x, size * 0.2 + 4, z), 9, C(230, 40, 70))
			end
			for _ = 1, 4 do
				local x, z = at(18, 120)
				lollipop(folder, V(x, 0, z), rng, 3.2)
			end
			for _ = 1, 2 do
				local x, z = at(30, 110)
				candyCane(folder, V(x, 0, z), rng, 3)
			end
		elseif zone.decor == "frost" then
			for k = 1, 6 do
				local x, z = at(if k <= 3 then 70 else 170, if k <= 3 then 150 else 270)
				peak(folder, x, z, rng:NextNumber(70, 140), rng:NextNumber(0, 6), if k % 2 == 0 then C(150, 185, 225) else C(175, 205, 240), Enum.Material.Slate, C(250, 252, 255), Enum.Material.Snow)
			end
			for _ = 1, 7 do
				local x, z = at(14, 70)
				pine(folder, V(x, 0, z), rng, 2.2)
			end
			for _ = 1, 3 do
				local x, z = at(20, 80)
				crystal(folder, V(x, 0, z), rng, C(150, 210, 255), false, 3)
			end
		elseif zone.decor == "lava" then
			for k = 1, 5 do
				local x, z = at(if k <= 3 then 70 else 170, if k <= 3 then 150 else 260)
				local h = rng:NextNumber(70, 125)
				peak(folder, x, z, h, rng:NextNumber(0, 6), if k % 2 == 0 then C(52, 40, 42) else C(68, 50, 50), Enum.Material.Basalt, C(255, 115, 25), Enum.Material.Neon)
				if k <= 2 then
					local vent = deco(folder, { Name = "Vent", Size = V(4, 1, 4), Position = V(x, h + 2, z), Transparency = 1 })
					local smoke = emitter(vent, SMOKE, C(80, 60, 60), 2, 26, 12, 8)
					smoke.LightEmission = 0
					smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 14), NumberSequenceKeypoint.new(1, 40) })
				end
			end
			for _ = 1, 4 do
				local x, z = at(15, 120)
				deco(folder, { Name = "LavaRiver", Size = V(rng:NextNumber(8, 16), 0.3, rng:NextNumber(60, 120)), CFrame = CFrame.new(x, -0.05, z) * CFrame.Angles(0, rng:NextNumber(-0.7, 0.7), 0), Color = C(255, 110, 25), Material = Enum.Material.Neon })
			end
		else
			-- cosmic: the zone floats in the void. Big planets, moons and drifting rock.
			local cols = { C(255, 130, 200), C(120, 200, 255), C(255, 200, 110), C(150, 120, 255) }
			for k = 1, 3 do
				local size = rng:NextNumber(70, 150)
				local x, z = at(120, 260)
				local y = rng:NextNumber(-30, 90)
				local model = Instance.new("Model")
				model.Name = "GiantPlanet"
				local body = deco(model, { Name = "Planet", Shape = Enum.PartType.Ball, Size = V(size, size, size), Position = V(x, y, z), Color = cols[(k + (if s > 0 then 1 else 0)) % 4 + 1] })
				if k ~= 2 then
					deco(model, { Name = "Ring", Shape = Enum.PartType.Cylinder, Size = V(1.2, size * 1.9, size * 1.9), CFrame = CFrame.new(x, y, z) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), 0, math.rad(90) + rng:NextNumber(-0.4, 0.4)), Color = C(255, 240, 220), Material = Enum.Material.Neon, Transparency = 0.45 })
				end
				model.PrimaryPart = body
				model.Parent = folder
				anim(model, V(0, 1, 0), 0.05)
			end
			for _ = 1, 9 do
				local x, z = at(10, 120)
				local sz = rng:NextNumber(10, 26)
				local rockPart = deco(folder, { Name = "Drift", Size = V(sz, sz * 0.6, sz * 0.8), CFrame = CFrame.new(x, rng:NextNumber(-25, 30), z) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), rng:NextNumber(0, 6)), Color = C(62, 52, 105), Material = Enum.Material.Slate })
				anim(rockPart, V(0.2, 1, 0.3).Unit, rng:NextNumber(0.05, 0.15), rng:NextNumber(1, 3), rng:NextNumber(0.2, 0.5))
			end
			-- underside of the floating island
			deco(folder, { Name = "Underside", Size = V(W * 0.5, 26, L * 0.9), Position = V(s * W * 0.22, -17, zc), Color = C(35, 28, 70), Material = Enum.Material.Slate })
		end
	end
end

---------------------------------------------------------------------------
-- Eggs
---------------------------------------------------------------------------
local function buildEgg(folder: Instance, egg: typeof(Config.Eggs[1]), pos: Vector3, index: number)
	local model = Instance.new("Model")
	model.Name = "Egg_" .. egg.id
	model:SetAttribute("EggId", egg.id)
	local spots = rgb(egg.spots)
	local shellColor = rgb(egg.color)
	part(model, { Name = "Step", Shape = Enum.PartType.Cylinder, Size = V(0.6, 15, 15), CFrame = CFrame.new(pos + V(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = C(176, 172, 196), Material = Enum.Material.Marble })
	local pedestal = part(model, { Name = "Pedestal", Shape = Enum.PartType.Cylinder, Size = V(1.4, 11, 11), CFrame = CFrame.new(pos + V(0, 1.1, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = C(214, 210, 228), Material = Enum.Material.Marble })
	cyl(model, "Trim", pos + V(0, 1.7, 0), 11.4, 0.22, spots, Enum.Material.Neon)
	cyl(model, "StepTrim", pos + V(0, 0.62, 0), 15.4, 0.12, lighten(spots, 0.15))
	ell(model, "Cushion", pos + V(0, 2.2, 0), V(6.6, 1.6, 6.6), if egg.exclusive then C(120, 60, 200) else lighten(spots, 0.2), Enum.Material.Fabric)
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		local p = pos + V(math.cos(a) * 6.4, 0.6, math.sin(a) * 6.4)
		deco(model, { Name = "Post", Size = V(0.9, 2.6, 0.9), Position = p + V(0, 1.3, 0), Color = C(200, 196, 216), Material = Enum.Material.Marble })
		local orb = ball(model, "PostOrb", p + V(0, 3.2, 0), 1.3, spots, Enum.Material.Neon)
		anim(orb, nil, nil, 0.25, 2 + i * 0.3)
	end
	-- light pillar: visible from across the zone
	cyl(model, "Pillar", pos + V(0, 24, 0), 5.5, 44, lighten(spots, 0.2), Enum.Material.Neon, { Transparency = 0.9 })

	local shell = part(model, { Name = "Shell", Size = V(5.5, 7, 5.5), Mesh = Enum.MeshType.Sphere, Position = pos + V(0, 5.9, 0), Color = shellColor, CanCollide = true, CastShadow = false })
	shell:SetAttribute("Rest", shell.CFrame) -- the client spins the shell; this is where it rests
	local function weldToShell(p: BasePart)
		p:SetAttribute("Offset", shell.CFrame:ToObjectSpace(p.CFrame))
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = shell
		weld.Part1 = p
		weld.Parent = p
	end
	local rng = Random.new(#egg.id * 97)
	if index % 2 == 0 or egg.exclusive then
		-- belted egg
		weldToShell(ell(model, "Spot", shell.Position, V(5.75, 1.1, 5.75), spots))
		weldToShell(ell(model, "Spot", shell.Position + V(0, 2.55, 0), V(3.3, 1.2, 3.3), spots))
		for i = 1, 5 do
			local a = i / 5 * math.pi * 2
			weldToShell(ball(model, "Spot", shell.Position + V(math.cos(a) * 2.45, -1.7, math.sin(a) * 2.45), 0.9, lighten(spots, 0.35)))
		end
	else
		for i = 1, 8 do
			local a = i * 2.2
			local y = rng:NextNumber(-2, 2.2)
			local rr = 2.75 * math.sqrt(1 - (y / 3.5) ^ 2)
			weldToShell(ball(model, "Spot", shell.Position + V(math.cos(a) * rr, y, math.sin(a) * rr), rng:NextNumber(1, 1.6), spots))
		end
	end
	local sparkle = emitter(shell, SPARKLES, lighten(spots, 0.3), if egg.exclusive then 9 else 3, 1, 3, 1.4)
	sparkle.Name = "Sparkle"
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.LightEmission = 1
	light(shell, lighten(spots, 0.3), 12, 0.45)

	model.PrimaryPart = pedestal
	local price = if egg.exclusive then '<font color="#7CFF7C">ROBUX EXCLUSIVE</font>' else Format.abbrev(egg.price) .. " Taps"
	-- world text carries Loc* attributes; the client rewrites it in the player's language
	local eggLabel = label(shell, string.format('%s\n<font color="#FFE066">%s</font>', egg.name, price), UDim2.fromScale(12, 4.8), V(0, 6.6, 0), Color3.new(1, 1, 1), 170)
	;(eggLabel:FindFirstChild("Text") :: TextLabel):SetAttribute("LocEgg", egg.id)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "EggPrompt"
	prompt.ActionText = "Open"
	prompt.ObjectText = egg.name
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("EggId", egg.id)
	prompt.Parent = pedestal
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model.Parent = folder
end

---------------------------------------------------------------------------
-- Leaderboard boards
---------------------------------------------------------------------------
local function buildBoard(folder: Instance, name: string, title: string, pos: Vector3, color: Color3): BasePart
	local board = part(folder, { Name = "Board_" .. name, Size = V(16, 20, 1), CFrame = CFrame.lookAt(pos, pos + V(0, 0, 1)), Color = C(40, 35, 60) })
	part(folder, { Name = "Frame", Size = V(17, 21, 0.8), CFrame = board.CFrame * CFrame.new(0, 0, 0.2), Color = color, Material = Enum.Material.Neon })
	for _, s in { -1, 1 } do
		part(folder, { Name = "Leg", Size = V(1, pos.Y, 1), Position = V(pos.X + 7 * s, pos.Y / 2 - 5, pos.Z + 0.5), Color = C(60, 50, 80) })
		ball(folder, "BoardOrb", V(pos.X + 8.5 * s, pos.Y + 11.4, pos.Z), 2.2, lighten(color, 0.3), Enum.Material.Neon)
	end
	deco(folder, { Name = "BoardRoof", Size = V(19, 1.4, 3), Position = V(pos.X, pos.Y + 11.2, pos.Z), Color = C(60, 50, 80) })
	local sg = Instance.new("SurfaceGui")
	sg.Name = "BoardGui"
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 25
	sg.LightInfluence = 0
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.BackgroundTransparency = 1
	titleLabel.Size = UDim2.new(1, 0, 0.12, 0)
	titleLabel.Font = Enum.Font.FredokaOne
	titleLabel.TextScaled = true
	titleLabel.TextColor3 = color
	titleLabel.Text = title
	titleLabel:SetAttribute("LocKey", "world.board_" .. name:lower())
	titleLabel.Parent = sg
	local list = Instance.new("Frame")
	list.Name = "List"
	list.BackgroundTransparency = 1
	list.Position = UDim2.fromScale(0.04, 0.13)
	list.Size = UDim2.fromScale(0.92, 0.85)
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0.005, 0)
	layout.Parent = list
	list.Parent = sg
	sg.Parent = board
	return board
end

---------------------------------------------------------------------------
-- Spawn plaza
---------------------------------------------------------------------------
local function balloons(folder: Instance, pos: Vector3, rng: Random)
	local cols = { C(255, 90, 110), C(90, 200, 255), C(255, 215, 70), C(140, 230, 120), C(190, 120, 255) }
	deco(folder, { Name = "BalloonPost", Size = V(0.6, 3, 0.6), Position = pos + V(0, 1.5, 0), Color = C(235, 235, 245) })
	for i = 1, 5 do
		local off = V(rng:NextNumber(-2.4, 2.4), rng:NextNumber(9, 14), rng:NextNumber(-2.4, 2.4))
		local model = Instance.new("Model")
		model.Name = "Balloon"
		local b = deco(model, { Name = "Balloon", Mesh = Enum.MeshType.Sphere, Size = V(3, 3.7, 3), Position = pos + off, Color = cols[i], Reflectance = 0.15 })
		local from = pos + V(0, 3, 0)
		local to = pos + off - V(0, 1.8, 0)
		deco(model, { Name = "String", Size = V(0.08, 0.08, (to - from).Magnitude), CFrame = CFrame.lookAt((from + to) / 2, to), Color = WHITE })
		model.PrimaryPart = b
		model.Parent = folder
		anim(model, nil, nil, 0.35, 0.9 + i * 0.17)
	end
end

local function buildSpawn(world: Instance, info: WorldInfo)
	local spawnFolder = Instance.new("Folder")
	spawnFolder.Name = "Spawn"
	spawnFolder.Parent = world
	local centre = V(0, 0, -75)
	local rng = Random.new(11)
	part(spawnFolder, { Name = "PlazaRing", Shape = Enum.PartType.Cylinder, Size = V(0.3, 46, 46), CFrame = CFrame.new(0, 0.15, -75) * CFrame.Angles(0, 0, math.rad(90)), Color = C(255, 200, 90), Material = Enum.Material.SmoothPlastic, CastShadow = false })
	part(spawnFolder, { Name = "Plaza", Shape = Enum.PartType.Cylinder, Size = V(0.4, 40, 40), CFrame = CFrame.new(0, 0.2, -75) * CFrame.Angles(0, 0, math.rad(90)), Color = C(245, 235, 210), Material = Enum.Material.Pebble, CastShadow = false })
	cyl(spawnFolder, "PlazaStar", centre + V(0, 0.42, 0), 22, 0.06, C(255, 170, 205))
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "SpawnLocation"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Size = V(10, 1, 10)
	spawn.CFrame = CFrame.new(0, 0.5, -75) * CFrame.Angles(0, math.rad(180), 0)
	spawn.Color = C(255, 200, 80)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Duration = 0
	spawn.CanTouch = false
	spawn.Parent = spawnFolder
	-- pillars with glowing orbs around the plaza (the way forward stays open)
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2 + math.pi / 10
		if math.abs(math.sin(a)) < 0.92 then
			local p = centre + V(math.cos(a) * 25, 0, math.sin(a) * 25)
			if math.abs(p.X) > 9 then
				part(spawnFolder, { Name = "Pillar", Shape = Enum.PartType.Cylinder, Size = V(5, 2.4, 2.4), CFrame = CFrame.new(p + V(0, 2.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = C(250, 245, 235), Material = Enum.Material.Marble, CastShadow = false })
				cyl(spawnFolder, "PillarCap", p + V(0, 5.2, 0), 3.2, 0.5, C(255, 200, 90))
				local orb = ball(spawnFolder, "PillarOrb", p + V(0, 6.6, 0), 2, if i % 2 == 0 then C(255, 130, 200) else C(110, 210, 255), Enum.Material.Neon)
				anim(orb, nil, nil, 0.3, 1.4 + i * 0.1)
			end
		end
	end
	balloons(spawnFolder, centre + V(-27, 0, -14), rng)
	balloons(spawnFolder, centre + V(27, 0, -14), rng)
	-- flower ring
	for i = 1, 22 do
		local a = i / 22 * math.pi * 2
		if math.abs(math.cos(a)) > 0.3 then
			flower(spawnFolder, centre + V(math.cos(a) * 21.5, 0.2, math.sin(a) * 21.5), rng)
		end
	end
	-- title sign
	local signPos = V(0, 17, -104)
	local title = part(spawnFolder, { Name = "TitleSign", Size = V(44, 9, 1), CFrame = CFrame.lookAt(signPos, V(0, 17, 0)), Color = C(255, 120, 190) })
	surfaceText(title, Enum.NormalId.Front, "TAP PETS SIMULATOR", Color3.new(1, 1, 1))
	deco(spawnFolder, { Name = "SignFrame", Size = V(46, 11, 0.8), Position = signPos + V(0, 0, -0.25), Color = C(255, 215, 70), Material = Enum.Material.Neon })
	deco(spawnFolder, { Name = "SignBack", Size = V(48, 13, 0.6), Position = signPos + V(0, 0, -0.6), Color = C(120, 70, 190) })
	for _, s in { -1, 1 } do
		part(spawnFolder, { Name = "SignPost", Size = V(1.6, 12, 1.6), Position = V(s * 19, 6, -104.4), Color = C(120, 70, 190), CastShadow = false })
		ball(spawnFolder, "SignStar", V(s * 24.5, 24, -104), 3, C(255, 225, 90), Enum.Material.Neon)
	end
	-- welcome arch over the path
	for _, s in { -1, 1 } do
		part(spawnFolder, { Name = "ArchPost", Size = V(1.6, 15, 1.6), Position = V(s * 10.5, 7.5, -46), Color = WHITE, CastShadow = false })
		ball(spawnFolder, "ArchOrb", V(s * 10.5, 15.8, -46), 2.6, C(255, 200, 80), Enum.Material.Neon)
	end
	local flagCols = { C(255, 90, 110), C(255, 215, 70), C(140, 230, 120), C(90, 200, 255), C(190, 120, 255) }
	for i = 0, 8 do
		local x = -9 + i * 2.25
		local sag = 1.6 * (1 - ((i - 4) / 4) ^ 2)
		deco(spawnFolder, { Name = "Flag", ClassName = "WedgePart", Size = V(0.2, 2, 1.6), CFrame = CFrame.new(x, 13.2 - sag, -46) * CFrame.Angles(0, math.rad(90), math.rad(180)), Color = flagCols[i % #flagCols + 1] })
	end
	deco(spawnFolder, { Name = "FlagLine", Size = V(21, 0.15, 0.15), Position = V(0, 13.6, -46), Color = WHITE })

	info.boards.taps = buildBoard(spawnFolder, "Taps", "TOP TAPPERS", V(-42, 14, -100), C(90, 200, 255))
	info.boards.rebirths = buildBoard(spawnFolder, "Rebirths", "TOP REBIRTHS", V(42, 14, -100), C(255, 200, 60))
end

---------------------------------------------------------------------------
-- Pet Park: 12 plots behind the spawn plaza (2 rows of 6 along an aisle). The server hands
-- one to each player (Services/Plots); clients put the owner's pets on the pedestals.
---------------------------------------------------------------------------
local PLOT_COLORS = { C(255, 120, 150), C(255, 170, 70), C(255, 215, 80), C(130, 220, 120), C(90, 200, 255), C(175, 130, 255) }

local function buildPlot(parent: Instance, index: number, centre: Vector3, front: number): Plot
	local model = Instance.new("Model")
	model.Name = "Plot" .. index
	model:SetAttribute("OwnerId", 0)
	model:SetAttribute("OwnerName", "")
	-- pets look down the plot towards the aisle (front = +1: towards +Z)
	model:SetAttribute("Facing", if front > 0 then math.pi else 0)
	local accent = PLOT_COLORS[(index - 1) % #PLOT_COLORS + 1]
	local pad = part(model, { Name = "Pad", Size = V(24, 0.4, 22), Position = centre + V(0, 0.2, 0), Color = C(250, 242, 220), Material = Enum.Material.Sand, CastShadow = false })
	deco(model, { Name = "PadRim", Size = V(25.4, 0.2, 23.4), Position = centre + V(0, 0.1, 0), Color = accent })
	local slot = 0
	for row = 0, 1 do
		for col = -1, 1 do
			slot += 1
			local p = centre + V(col * 7.4, 1, -front * (row * 7 - 1.5))
			part(model, { Name = "Pedestal" .. slot, Shape = Enum.PartType.Cylinder, Size = V(1.2, 4, 4), CFrame = CFrame.new(p) * CFrame.Angles(0, 0, math.rad(90)), Color = if row == 0 then lighten(accent, 0.55) else lighten(accent, 0.35), CastShadow = false })
		end
	end
	-- chest at the front, facing the aisle
	local chestPos = centre + V(6.5, 0, front * 8.2)
	local chest = part(model, { Name = "Chest", Size = V(4.4, 2.6, 3), Position = chestPos + V(0, 1.7, 0), Color = C(150, 95, 55), Material = Enum.Material.Wood, CastShadow = false })
	deco(model, { Name = "ChestLid", Size = V(4.7, 0.9, 3.3), Position = chestPos + V(0, 3.4, 0), Color = C(255, 205, 70) })
	deco(model, { Name = "ChestLock", Size = V(0.9, 1.1, 0.4), Position = chestPos + V(0, 2.6, front * 1.6), Color = C(255, 235, 140) })
	local glow = ball(model, "ChestGlow", chestPos + V(0, 4.6, 0), 1.6, C(255, 230, 110), Enum.Material.Neon, { Transparency = 1 })
	anim(glow, nil, nil, 0.3, 2.4)
	local chestLabel = label(chest, "", UDim2.fromScale(11, 2.6), V(0, 5.2, 0), Color3.new(1, 1, 1), 70)
	;(chestLabel:FindFirstChild("Text") :: TextLabel).Name = "ChestText"
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ChestPrompt"
	prompt.ActionText = "Collect"
	prompt.ObjectText = "Pet chest"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("Chest", index)
	prompt.Parent = chest
	-- name sign
	local signPos = centre + V(-7, 0, front * 9.4)
	deco(model, { Name = "SignPost", Size = V(0.6, 5, 0.6), Position = signPos + V(0, 2.5, 0), Color = C(120, 80, 50), Material = Enum.Material.Wood })
	local board = part(model, { Name = "SignBoard", Size = V(9, 2.6, 0.5), Position = signPos + V(0, 5.4, 0), Color = darken(accent, 0.2), CanCollide = false, CastShadow = false })
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		surfaceText(board, face, "", Color3.new(1, 1, 1)).Name = "OwnerText"
	end
	model.PrimaryPart = pad
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model.Parent = parent
	return { model = model, chest = chest, spawn = CFrame.lookAt(centre + V(0, 4, front * 15), centre + V(0, 4, 0)) }
end

local function buildPark(world: Instance, info: WorldInfo, zStart: number)
	local park = Instance.new("Folder")
	park.Name = "Park"
	park.Parent = world
	local dressing = Instance.new("Folder")
	dressing.Name = "ParkDressing"
	dressing.Parent = world
	local zc = zStart - PARK_DEPTH / 2
	part(dressing, { Name = "Ground", Size = V(W, 4, PARK_DEPTH), Position = V(0, -2, zc), Color = C(125, 205, 95), Material = Enum.Material.Grass })
	local aisleZ = zc
	deco(dressing, { Name = "Aisle", Size = V(W - 8, 0.2, 9), Position = V(0, 0.1, aisleZ), Color = C(235, 215, 160), Material = Enum.Material.Sand })
	deco(dressing, { Name = "Walk", Size = V(12, 0.2, PARK_DEPTH / 2 + 4), Position = V(0, 0.1, (zStart + aisleZ) / 2 + 2), Color = C(235, 215, 160), Material = Enum.Material.Sand })
	for _, s in { -1, 1 } do
		part(dressing, { Name = "InvisibleWall", Size = V(2, WALL_H, PARK_DEPTH), Position = V(s * (W / 2 + 1), WALL_H / 2, zc), Transparency = 1 })
		deco(dressing, { Name = "Hedge", Size = V(5, 4.4, PARK_DEPTH), Position = V(s * (W / 2 + 3.5), 2.2, zc), Color = C(55, 140, 60), Material = Enum.Material.Grass })
	end
	-- entrance arch, seen from the plaza
	for _, s in { -1, 1 } do
		part(dressing, { Name = "ArchPost", Size = V(1.8, 13, 1.8), Position = V(s * 9, 6.5, zStart - 2), Color = C(250, 245, 235), CastShadow = false })
		ball(dressing, "ArchOrb", V(s * 9, 13.9, zStart - 2), 2.6, C(255, 140, 200), Enum.Material.Neon)
	end
	local beam = part(dressing, { Name = "ParkSign", Size = V(22, 4, 1), Position = V(0, 12.5, zStart - 2), Color = C(120, 70, 190), CanCollide = false, CastShadow = false })
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		surfaceText(beam, face, "PET PARK", C(255, 225, 90)):SetAttribute("LocKey", "world.park")
	end
	deco(dressing, { Name = "ParkSignFrame", Size = V(23, 5, 0.6), Position = V(0, 12.5, zStart - 2), Color = C(255, 215, 70), Material = Enum.Material.Neon })
	local index = 0
	for row = 0, 1 do
		local front = if row == 0 then -1 else 1 -- both rows face the aisle
		for col = 0, 5 do
			index += 1
			local x = -70 + col * 28
			local z = aisleZ - front * 17
			table.insert(info.plots, buildPlot(park, index, V(x, 0, z), front))
		end
	end
end

---------------------------------------------------------------------------
-- Gates
---------------------------------------------------------------------------
local function buildGate(gatesFolder: Instance, zone: any, zc: number): BasePart
	local i = zone.index
	local gz = zc - L / 2
	local gate = Instance.new("Model")
	gate.Name = "Gate" .. i
	local wall = rgb(zone.wall)
	local accent = rgb(zone.path)
	local glow = if zone.decor == "candy" then C(255, 245, 190) elseif zone.decor == "frost" then C(150, 225, 255) elseif zone.decor == "lava" then C(255, 120, 30) else C(190, 120, 255)
	local sideW = (W - GATE_W) / 2
	for _, s in { -1, 1 } do
		local x = s * (GATE_W / 2 + sideW / 2)
		part(gate, { Name = "Wall", Size = V(sideW, GATE_H, 3), Position = V(x, GATE_H / 2, gz), Color = wall, Material = Enum.Material.Brick })
		deco(gate, { Name = "WallTop", Size = V(sideW, 1.4, 4), Position = V(x, GATE_H + 0.7, gz), Color = lighten(wall, 0.25) })
		deco(gate, { Name = "WallBase", Size = V(sideW, 1.6, 3.8), Position = V(x, 0.8, gz), Color = darken(wall, 0.22) })
		for k = 0, 5 do
			deco(gate, { Name = "Merlon", Size = V(4, 2.2, 3.4), Position = V(s * (GATE_W / 2 + 10 + k * 11.5), GATE_H + 2.5, gz), Color = lighten(wall, 0.12) })
		end
		local px = s * (GATE_W / 2 + 2)
		part(gate, { Name = "Pillar", Size = V(4, GATE_H + 6, 4), Position = V(px, (GATE_H + 6) / 2, gz), Color = accent, Material = Palette.material(zone.pathMaterial) })
		deco(gate, { Name = "PillarCap", Size = V(5.6, 1.4, 5.6), Position = V(px, GATE_H + 6.7, gz), Color = lighten(wall, 0.2) })
		local orb = ball(gate, "PillarOrb", V(px, GATE_H + 9.4, gz), 3.4, glow, Enum.Material.Neon)
		anim(orb, nil, nil, 0.3, 1.5)
		if i >= 4 then
			light(orb, glow, 22, 1.4)
		end
		for _, zo in { -2.15, 2.15 } do
			deco(gate, { Name = "PillarStrip", Size = V(0.6, GATE_H + 4, 0.3), Position = V(px - s * 1.4, (GATE_H + 4) / 2, gz + zo), Color = glow, Material = Enum.Material.Neon })
		end
	end
	local arch = part(gate, { Name = "Arch", Size = V(GATE_W + 8, 5, 4), Position = V(0, GATE_H + 3.5, gz), Color = wall })
	surfaceText(arch, Enum.NormalId.Front, zone.name:upper(), Color3.new(1, 1, 1)):SetAttribute("LocZone", i)
	surfaceText(arch, Enum.NormalId.Back, zone.name:upper(), Color3.new(1, 1, 1)):SetAttribute("LocZone", i)
	deco(gate, { Name = "ArchTrim", Size = V(GATE_W + 9, 0.6, 4.6), Position = V(0, GATE_H + 6.3, gz), Color = glow, Material = Enum.Material.Neon })
	deco(gate, { Name = "ArchTrim", Size = V(GATE_W + 9, 0.6, 4.6), Position = V(0, GATE_H + 0.7, gz), Color = glow, Material = Enum.Material.Neon })
	part(gate, { Name = "InvisibleTop", Size = V(W, WALL_H - GATE_H, 3), Position = V(0, GATE_H + (WALL_H - GATE_H) / 2, gz), Transparency = 1 })
	local barrier = part(gate, {
		Name = "Barrier",
		Size = V(GATE_W, GATE_H, 1.5),
		Position = V(0, GATE_H / 2, gz),
		Color = accent,
		Material = Enum.Material.ForceField,
		Transparency = 0.2,
	})
	barrier:SetAttribute("Zone", i)
	surfaceText(barrier, Enum.NormalId.Front, string.format("LOCKED\n%s Taps", Format.abbrev(zone.cost)), C(255, 230, 90)):SetAttribute("LocGate", i)
	local burst = emitter(barrier, SPARKLES, glow, 0, 2, 14, 1.2)
	burst.Name = "Unlock"
	burst.SpreadAngle = Vector2.new(180, 180)
	burst.LightEmission = 1
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "GatePrompt"
	prompt.ActionText = "Unlock (" .. Format.abbrev(zone.cost) .. " Taps)"
	prompt.ObjectText = zone.name
	prompt.HoldDuration = 0.25
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("Zone", i)
	prompt.Parent = barrier
	gate.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	gate.Parent = gatesFolder
	return barrier
end

---------------------------------------------------------------------------
-- Build
---------------------------------------------------------------------------
function WorldBuilder.build(): WorldInfo
	ModelSlots.resetBudget()
	local info: WorldInfo = { plots = {}, eggPositions = {}, zoneSpawns = {}, gates = {}, boards = {} }

	local old = Workspace:FindFirstChild("World")
	if old then
		old:Destroy()
	end
	local baseplate = Workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end

	local world = Instance.new("Folder")
	world.Name = "World"
	local eggsFolder = Instance.new("Folder")
	eggsFolder.Name = "Eggs"
	eggsFolder.Parent = world
	local gatesFolder = Instance.new("Folder")
	gatesFolder.Name = "Gates"
	gatesFolder.Parent = world

	local nZones = #Config.Zones
	local zStart = -L / 2
	local zEnd = zoneCenter(nZones) + L / 2

	for _, zone in Config.Zones do
		local i = zone.index
		local folder = Instance.new("Folder")
		folder.Name = "Zone" .. i .. "_" .. zone.id
		folder.Parent = world
		local zc = zoneCenter(i)
		local pathColor = rgb(zone.path)
		part(folder, { Name = "Ground", Size = V(W, 4, L), Position = V(0, -2, zc), Color = rgb(zone.ground), Material = Palette.material(zone.groundMaterial) })
		part(folder, { Name = "Path", Size = V(16, 0.2, L), Position = V(0, 0.1, zc), Color = pathColor, Material = Palette.material(zone.pathMaterial), CanCollide = false, CastShadow = false })
		for _, s in { -1, 1 } do
			deco(folder, { Name = "PathEdge", Size = V(1.2, 0.3, L), Position = V(s * 8.6, 0.15, zc), Color = if zone.decor == "cosmic" then C(120, 220, 255) else darken(pathColor, 0.18), Material = if zone.decor == "cosmic" or zone.decor == "lava" then Enum.Material.Neon else Enum.Material.SmoothPlastic })
			part(folder, { Name = "InvisibleWall", Size = V(2, WALL_H, L), Position = V(s * (W / 2 + 1), WALL_H / 2, zc), Transparency = 1 })
		end
		if zone.decor == "candy" then
			-- polka dots on the candy floor
			local dots = Random.new(515)
			local cols = { C(255, 205, 230), C(255, 240, 250), C(255, 160, 205) }
			for k = 1, 16 do
				local x = dots:NextNumber(14, W / 2 - 12) * (if k % 2 == 0 then 1 else -1)
				cyl(folder, "Dot", V(x, 0.04, zc + dots:NextNumber(-L / 2 + 12, L / 2 - 12)), dots:NextNumber(10, 22), 0.08, cols[k % 3 + 1])
			end
		end

		-- zone spawn (teleport target)
		local spawnZ = if i == 1 then -75 else zc - L / 2 + 22
		info.zoneSpawns[i] = CFrame.new(0, 4, spawnZ) * CFrame.Angles(0, math.rad(180), 0)

		local border = BORDER[zone.decor]
		if border then
			local borderFolder = Instance.new("Folder")
			borderFolder.Name = "Border"
			borderFolder.Parent = folder
			border(borderFolder, zc)
		end
		-- the horizon is the backdrop: always loaded, like a skybox (everything else streams)
		local scenery = Instance.new("Model")
		scenery.Name = "Horizon"
		scenery.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
		scenery.Parent = folder
		horizon(scenery, zone, zc)
		local lampFolder = Instance.new("Folder")
		lampFolder.Name = "Lamps"
		lampFolder.Parent = folder
		lamps(lampFolder, zc, zone)
		local landmarkFolder = Instance.new("Folder")
		landmarkFolder.Name = "Landmarks"
		landmarkFolder.Parent = folder
		local reserved = landmarks(landmarkFolder, zone, zc)

		-- props (deterministic)
		local rng = Random.new(1000 + i)
		local decoFolder = Instance.new("Folder")
		decoFolder.Name = "Decor"
		decoFolder.Parent = folder
		for _, egg in Config.Eggs do
			if egg.zone == i or (i == 1 and egg.zone == 0) then
				table.insert(reserved, { pos = V(egg.offsetX, 0, zc + egg.offsetZ), r = 17 })
			end
		end
		for _, entry in DECOR[zone.decor] or ({} :: { { fn: Deco, count: number } }) do
			local placed, tries = 0, 0
			while placed < entry.count and tries < entry.count * 20 do
				tries += 1
				local x = rng:NextNumber(-W / 2 + 8, W / 2 - 8)
				local z = rng:NextNumber(zc - L / 2 + 14, zc + L / 2 - 14)
				local pos = V(x, 0, z)
				local ok = math.abs(x) > 14
				for _, e in reserved do
					if (e.pos - pos).Magnitude < e.r then
						ok = false
					end
				end
				if i == 1 and z < -42 and math.abs(x) < 44 then
					ok = false -- keep the spawn plaza clear
				end
				if ok then
					entry.fn(decoFolder, pos, rng)
					placed += 1
				end
			end
		end

		if i > 1 then
			info.gates[i] = buildGate(gatesFolder, zone, zc)
		end

		for index, egg in Config.Eggs do
			local ez = if egg.zone == 0 then 1 else egg.zone
			if ez == i then
				local pos = V(egg.offsetX, 0, zc + egg.offsetZ)
				info.eggPositions[egg.id] = pos + V(0, 4, 0)
				buildEgg(eggsFolder, egg, pos, index)
			end
		end
	end

	-- End walls + the ground behind them
	local first = Config.Zones[1]
	local parkEnd = zStart - PARK_DEPTH
	part(world, { Name = "BackWall", Size = V(W, WALL_H, 2), Position = V(0, WALL_H / 2, parkEnd - 1), Transparency = 1 })
	deco(world, { Name = "BackHedge", Size = V(W + 10, 4.4, 5), Position = V(0, 2.2, parkEnd - 3.5), Color = C(55, 140, 60), Material = Enum.Material.Grass })
	deco(world, { Name = "BackSkirt", Size = V(W + SKIRT * 2 + 4, 4, 240), Position = V(0, -2.15, zStart - 120), Color = darken(rgb(first.ground), 0.08), Material = Palette.material(first.groundMaterial) })
	local backRng = Random.new(808)
	for k = 1, 6 do
		local size = backRng:NextNumber(90, 150)
		local x = -260 + k * 75 + backRng:NextNumber(-15, 15)
		ball(world, "Hill", V(x, -size * 0.3, parkEnd - 60 - size * 0.3 - backRng:NextNumber(0, 50)), size, if k % 2 == 0 then C(95, 185, 75) else C(80, 170, 70), Enum.Material.Grass)
	end
	for k = 1, 4 do
		peak(world, -230 + k * 95, parkEnd - 215, backRng:NextNumber(100, 150), backRng:NextNumber(0, 6), C(120, 150, 190), Enum.Material.Slate, WHITE, Enum.Material.Snow)
	end
	part(world, { Name = "EndWall", Size = V(W, WALL_H, 2), Position = V(0, WALL_H / 2, zEnd + 1), Transparency = 1 })
	deco(world, { Name = "EndEdge", Size = V(W, 0.4, 1.6), Position = V(0, 0.15, zEnd - 0.8), Color = C(130, 90, 255), Material = Enum.Material.Neon })

	buildSpawn(world, info)
	buildPark(world, info, zStart)

	world.Parent = Workspace

	-- Lighting (the client retunes it per zone: WorldFx)
	Lighting.ClockTime = 14.2
	Lighting.Brightness = 2.4
	Lighting.Ambient = C(120, 115, 130)
	Lighting.OutdoorAmbient = C(150, 155, 160)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atm = Instance.new("Atmosphere")
		atm.Density = 0.28
		atm.Offset = 0.1
		atm.Haze = 1.2
		atm.Glare = 0.2
		atm.Color = C(205, 225, 255)
		atm.Decay = C(150, 190, 255)
		atm.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.45
		bloom.Size = 22
		bloom.Threshold = 1.5
		bloom.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("SunRaysEffect") then
		local rays = Instance.new("SunRaysEffect")
		rays.Intensity = 0.07
		rays.Spread = 0.7
		rays.Parent = Lighting
	end
	-- a soft far blur: the horizon props melt into the sky and the play area reads sharper
	-- (the client switches it off on the lite profile, like bloom and sun rays)
	if not Lighting:FindFirstChildOfClass("DepthOfFieldEffect") then
		local dof = Instance.new("DepthOfFieldEffect")
		dof.FarIntensity = 0.12
		dof.NearIntensity = 0
		dof.FocusDistance = 70
		dof.InFocusRadius = 90
		dof.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("Sky") then
		local sky = Instance.new("Sky")
		sky.StarCount = 5000
		sky.SunAngularSize = 16
		sky.MoonAngularSize = 14
		sky.Parent = Lighting
	end
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if terrain and not terrain:FindFirstChildOfClass("Clouds") then
		local clouds = Instance.new("Clouds")
		clouds.Cover = 0.55
		clouds.Density = 0.45
		clouds.Color = WHITE
		clouds.Parent = terrain
	end

	return info
end

function WorldBuilder.zoneAt(z: number): number
	return math.clamp(math.floor((z + L / 2) / L) + 1, 1, #Config.Zones)
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="54">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Folder" referent="55">
      <Properties>
        <string name="Name">ModelLibrary</string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="56">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">90</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="57">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="58">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Ads</string>
            <string name="Source"><![CDATA[--!strict
-- Rewarded video ads (client side). A placement's button only shows when its developer
-- product is set (Config.AdProducts), today's cap isn't used up and AdService says a video is
-- available right now. The reward is granted by the server's ProcessReceipt.
local AdService = game:GetService("AdService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(script.Parent.Net)
local Lang = require(script.Parent.Lang)

local Ads = {}

local available = false
local checkedAt = -math.huge
local checking = false

local function anyPlacementLive(): boolean
	for _, id in Config.AdProducts :: { [string]: number } do
		if id ~= 0 then
			return true
		end
	end
	return false
end

-- Asks AdService at most once a minute, only when a placement could be shown.
local function refreshAvailability()
	if checking or os.clock() - checkedAt < 60 or not anyPlacementLive() then
		return
	end
	checking = true
	task.spawn(function()
		local ok, result = pcall(function()
			return (AdService :: any):GetAdAvailabilityNowAsync((Enum :: any).AdFormat.RewardedVideo)
		end)
		available = ok and result ~= nil and (result :: any).AdAvailabilityResult == (Enum :: any).AdAvailabilityResult.IsAvailable
		checkedAt = os.clock()
		checking = false
	end)
end

function Ads.canShow(placement: string): boolean
	local id = (Config.AdProducts :: any)[placement]
	local s = Net.state
	if type(id) ~= "number" or id == 0 or not s or not s.ads or s.ads.left <= 0 then
		return false
	end
	refreshAvailability()
	return available
end

local notify: (string, string?) -> () = function() end
function Ads.setNotifier(fn: (string, string?) -> ())
	notify = fn
end

function Ads.watch(placement: string)
	local ok, res = Net.request("WatchAd", { placement = placement })
	if not ok then
		notify(Lang.msg(res), "error")
	end
	checkedAt = -math.huge -- re-check availability after a video
end

return Ads
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">Guide</string>
            <string name="Source"><![CDATA[--!strict
-- The "what do I do next" line at the top of the screen, with a progress bar, plus a beam
-- of light from the player to the thing they should walk to (first egg, next gate).
-- Guide.current is pure (state in, objective out) so the playtest can check every step.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Formulas = require(ReplicatedStorage.Shared.Formulas)

local Guide = {}

export type Objective = {
	key: string, -- translation key
	args: { [string]: any },
	zoneArg: number?, -- args.zone is filled with this zone's translated name
	progress: number, -- 0..1
	target: Vector3?, -- where the beam points
	window: string?, -- window opened when the objective is clicked
}

local FIRST_EGG = Config.Eggs[1]
local HATCH_GOAL = 5

local function eggPosition(egg: typeof(Config.Eggs[1])): Vector3
	local zone = if egg.zone == 0 then 1 else egg.zone
	return Vector3.new(egg.offsetX, 6, (zone - 1) * Config.ZoneLength + egg.offsetZ)
end

local function gatePosition(zone: number): Vector3
	return Vector3.new(0, 6, (zone - 1) * Config.ZoneLength - Config.ZoneLength / 2)
end

function Guide.current(s: { [string]: any }): Objective
	local hatched = s.totalHatched or 0
	local taps = s.taps or 0
	if hatched < 1 then
		if taps < FIRST_EGG.price then
			return { key = "goal.earn", args = { n = Format.abbrev(FIRST_EGG.price) }, progress = taps / FIRST_EGG.price }
		end
		return { key = "goal.hatch1", args = {}, progress = 1, target = eggPosition(FIRST_EGG) }
	end
	if hatched < HATCH_GOAL then
		return { key = "goal.hatchN", args = { n = HATCH_GOAL, have = hatched }, progress = hatched / HATCH_GOAL, target = if taps >= FIRST_EGG.price then eggPosition(FIRST_EGG) else nil }
	end
	-- next gate or rebirth, whichever is cheaper
	local nextZone = #(s.zones or { 1 }) + 1
	local zone = Config.Zones[nextZone]
	local rebirthCost = s.rebirthCost or Formulas.rebirthCost(s.rebirths or 0)
	if zone and zone.cost <= rebirthCost then
		if taps >= zone.cost then
			return { key = "goal.gate", args = {}, zoneArg = nextZone, progress = 1, target = gatePosition(nextZone), window = "Teleport" }
		end
		return { key = "goal.zone", args = {}, zoneArg = nextZone, progress = taps / zone.cost, window = "Teleport" }
	end
	if taps >= rebirthCost then
		return { key = "goal.rebirth_ready", args = {}, progress = 1, window = "Rebirth" }
	end
	return { key = "goal.rebirth", args = { mult = tostring(Formulas.rebirthMult((s.rebirths or 0) + 1)) }, progress = taps / rebirthCost, window = "Rebirth" }
end

---------------------------------------------------------------------------
-- Beam to the target
---------------------------------------------------------------------------
local anchor: BasePart? = nil
local beam: Beam? = nil
local a0: Attachment? = nil

local function ensure()
	if anchor then
		return
	end
	local p = Instance.new("Part")
	p.Name = "GuideTarget"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.Parent = Workspace
	anchor = p
	local at = Instance.new("Attachment")
	at.Parent = p
	local b = Instance.new("Beam")
	b.Name = "GuideBeam"
	b.Color = ColorSequence.new(Color3.fromRGB(255, 225, 90), Color3.fromRGB(255, 255, 255))
	b.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.75), NumberSequenceKeypoint.new(0.2, 0.25), NumberSequenceKeypoint.new(1, 0.15) })
	b.Width0 = 1.2
	b.Width1 = 2.2
	b.FaceCamera = true
	b.LightEmission = 0.6
	b.Segments = 1
	b.Attachment1 = at
	b.Enabled = false
	b.Parent = p
	beam = b
end

-- Points the beam at target (nil hides it). Hidden when the player is already there.
function Guide.point(target: Vector3?)
	ensure()
	local b = beam :: Beam
	local char = Players.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not target or not root or (root.Position - target).Magnitude < 20 then
		b.Enabled = false
		return
	end
	if not a0 or a0.Parent ~= root then
		if a0 then
			a0:Destroy()
		end
		local at = Instance.new("Attachment")
		at.Name = "GuideFrom"
		at.Parent = root
		a0 = at
		b.Attachment0 = at
	end
	(anchor :: BasePart).Position = target
	b.Enabled = true
end

function Guide.beamOn(): boolean
	return beam ~= nil and beam.Enabled
end

return Guide
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">Lang</string>
            <string name="Source"><![CDATA[--!strict
-- Client language: the saved preference (profile.lang) or the account locale. Static labels
-- register with Lang.bind and re-render live when the language changes; dynamic texts are
-- rebuilt by their windows' refresh functions (Net.Changed "full" fires on a switch).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Net = require(script.Parent.Net)

local Lang = {}

-- Studio preview: the workspace attribute ForceLanguage (e.g. "de") overrides everything.
local forced = workspace:GetAttribute("ForceLanguage")
local forcedCode: string? = if type(forced) == "string" and Locale.Supported[forced] then forced else nil

Lang.code = forcedCode or Locale.resolve(Players.LocalPlayer.LocaleId)
local changed = Instance.new("BindableEvent")
Lang.Changed = changed.Event

type Binding = { prop: string, key: string, args: { [string]: any }? }
-- Strong keys on purpose: Instance proxies in weak tables can be collected while the
-- Instance is still alive. Entries are dropped when the object is destroyed.
local bound: { [Instance]: Binding } = {}

function Lang.t(key: string, args: { [string]: any }?): string
	return Locale.t(Lang.code, key, args)
end

-- Server messages ({ key, args }) or plain strings.
function Lang.msg(m: any): string
	return Locale.msg(Lang.code, m)
end

-- Sets obj[prop] (default "Text") to the translation and keeps it updated.
function Lang.bind(obj: Instance, key: string, args: { [string]: any }?, prop: string?)
	local b: Binding = { prop = prop or "Text", key = key, args = args }
	if not bound[obj] then
		obj.Destroying:Once(function()
			bound[obj] = nil
		end)
	end
	bound[obj] = b;
	(obj :: any)[b.prop] = Lang.t(key, args)
end

function Lang.unbind(obj: Instance)
	bound[obj] = nil
end

-- Upper-cases only plain ASCII (string.upper would mangle UTF-8 letters).
function Lang.upper(s: string): string
	return if s:find("[\128-\255]") then s else s:upper()
end

function Lang.pet(id: string, tier: number?): string
	local name = Lang.t("pet." .. id)
	if tier and tier > 0 then
		return Lang.t("pet.tiered", { tier = Lang.t("tier." .. tier), pet = name })
	end
	return name
end

function Lang.rarity(name: string): string
	return Lang.t("rarity." .. name)
end

function Lang.zone(index: number): string
	local z = Config.Zones[index]
	return if z then Lang.t("zone." .. z.id) else "?"
end

function Lang.egg(id: string): string
	return Lang.t("egg." .. id)
end

-- "5 min of Taps", "25 Gems"... for Config reward entries.
function Lang.rewardLabel(reward: { kind: string, amount: number }): string
	return Lang.t("rewardlabel." .. reward.kind, { n = reward.amount })
end

function Lang.set(code: string)
	if not Locale.Supported[code] then
		code = Locale.Default
	end
	if code == Lang.code then
		return
	end
	Lang.code = code
	for obj, b in bound do
		if obj.Parent then
			(obj :: any)[b.prop] = Lang.t(b.key, b.args)
		end
	end
	changed:Fire(code)
	Net.refresh()
end

-- Follow the saved preference when the server state arrives or changes.
Net.Changed:Connect(function(kind)
	if kind ~= "full" then
		return
	end
	local pref = Net.get("lang")
	local want = forcedCode or (if type(pref) == "string" and Locale.Supported[pref] then pref else Locale.resolve(Players.LocalPlayer.LocaleId))
	if want ~= Lang.code then
		Lang.set(want)
	end
end)

return Lang
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">LiveEventClient</string>
            <string name="Source"><![CDATA[--!strict
-- Client mirror of the live-event state (LiveEventUpdate), with a Changed signal.
local Net = require(script.Parent.Net)

local LiveEventClient = {}

LiveEventClient.data = nil :: { [string]: any }?
LiveEventClient.receivedAt = os.clock()
local changed = Instance.new("BindableEvent")
LiveEventClient.Changed = changed.Event -- (data, startedIds)

-- Server-clock "now" estimate.
function LiveEventClient.now(): number
	local d = LiveEventClient.data
	if not d then
		return os.time()
	end
	return d.serverTime + (os.clock() - LiveEventClient.receivedAt)
end

-- Active events that haven't ended yet (by the estimated server clock).
function LiveEventClient.active(): { { id: string, endsAt: number } }
	local d = LiveEventClient.data
	local out = {}
	if d and d.active then
		local now = LiveEventClient.now()
		for _, a in d.active do
			if a.endsAt > now then
				table.insert(out, a)
			end
		end
	end
	return out
end

Net.event("LiveEventUpdate").OnClientEvent:Connect(function(data)
	LiveEventClient.data = data
	LiveEventClient.receivedAt = os.clock()
	changed:Fire(data, data.started or {})
end)

return LiveEventClient
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="63">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Tap Pets Simulator: client bootstrap.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

ReplicatedStorage:WaitForChild("Remotes")

local Net = require(script.Parent.Net)
local Purchase = require(script.Parent.Purchase)
local Tapper = require(script.Parent.Tapper)
local PetFollow = require(script.Parent.PetFollow)
local WorldFx = require(script.Parent.WorldFx)
local WorldText = require(script.Parent.WorldText)
local ParkFx = require(script.Parent.ParkFx)
local UI = script.Parent.UI
local Theme = require(UI.Theme)
local Toasts = require(UI.Toasts)
local Hud = require(UI.Hud)
local HatchCinematic = require(UI.HatchCinematic)
local EggPanel = require(UI.EggPanel)
local PetsWindow = require(UI.PetsWindow)
local ProgressWindows = require(UI.ProgressWindows)
local StoreWindow = require(UI.StoreWindow)
local RewardsWindow = require(UI.RewardsWindow)
local IndexWindow = require(UI.IndexWindow)
local QuestsWindow = require(UI.QuestsWindow)
local InviteWindow = require(UI.InviteWindow)
local Popups = require(UI.Popups)
local Ads = require(script.Parent.Ads)

Purchase.setNotifier(Toasts.show)
Ads.setNotifier(Toasts.show)
Toasts.init()
Hud.init()
PetsWindow.init()
ProgressWindows.init()
StoreWindow.init()
RewardsWindow.init()
IndexWindow.init()
QuestsWindow.init()
InviteWindow.init()
Popups.init()
EggPanel.init()
Tapper.init()
PetFollow.init()
WorldFx.init()
WorldText.init()
ParkFx.init()

HatchCinematic.setBusyCallback(function(busy)
	Tapper.setEnabled(not busy)
end)
HatchCinematic.setBurstCallback(WorldFx.eggBurst)
if Hud.tapsPill then
	local pill = Hud.tapsPill
	Tapper.setCounter(pill, function()
		Theme.pop(pill, 1.07)
	end)
end

Net.event("Hatched").OnClientEvent:Connect(function(data)
	HatchCinematic.play(data.egg, data.results, data.auto)
end)
]]></string>
          </Properties>
