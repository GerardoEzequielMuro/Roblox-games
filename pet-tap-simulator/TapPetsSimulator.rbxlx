-- One-time gift for joining the Roblox group (not in any egg).
do
	local pup = P("grouppup", "Group Pup", "Legendary", 0, "ball", { 120, 200, 255 }, { 255, 255, 255 }, "dog", { "tail", "scarf" }, 1.1, 0)
	pup.giftOnly = true
	table.insert(Config.Pets, pup)
