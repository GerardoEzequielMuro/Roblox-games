        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--!strict
-- Client networking: remotes, the replicated profile snapshot, and change signals.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Request = Remotes:WaitForChild("Request") :: RemoteFunction

local Net = {}

Net.state = nil :: { [string]: any }?
Net.receivedAt = os.clock()

local changed = Instance.new("BindableEvent")
Net.Changed = changed.Event -- (kind: "full" | "currency")

function Net.event(name: string): RemoteEvent
	return Remotes:WaitForChild(name) :: RemoteEvent
end

-- Returns ok, result (result is an error string when ok == false).
function Net.request(action: string, payload: { [string]: any }?): (boolean, any)
	local ok, a, b = pcall(function()
		return Request:InvokeServer(action, payload)
	end)
	if not ok then
		return false, { key = "toast.connection" }
	end
	return a == true, b
end

-- Local optimistic change (e.g. predicted taps); server snapshots overwrite it.
function Net.bump()
	changed:Fire("currency")
end

-- Re-run every "full" listener (e.g. after a language switch).
function Net.refresh()
	if Net.state then
		changed:Fire("full")
	end
end

function Net.get(key: string): any
	local s = Net.state
	return if s then s[key] else nil
end

function Net.owns(passKey: string): boolean
	local passes = Net.get("passes")
	return passes ~= nil and passes[passKey] == true
end

Net.event("State").OnClientEvent:Connect(function(snapshot)
	Net.state = snapshot
	Net.receivedAt = os.clock()
	changed:Fire("full")
end)

Net.event("Currency").OnClientEvent:Connect(function(c)
	local s = Net.state
	if s then
		s.taps = c.taps
		s.gems = c.gems
		s.totalTaps = c.totalTaps
		changed:Fire("currency")
	end
end)

-- Initial pull (the push may have happened before this script connected).
task.spawn(function()
	for _ = 1, 40 do
		if Net.state then
			return
		end
		local ok, snap = Net.request("GetState")
		if ok and snap and not Net.state then
			Net.state = snap
			Net.receivedAt = os.clock()
			changed:Fire("full")
			return
		end
		task.wait(0.5)
	end
end)

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">ParkFx</string>
            <string name="Source"><![CDATA[--!strict
-- Pet Park, client side: puts each owner's equipped pets on the pedestals of their plot,
-- writes the owner's name on the sign, and shows what is waiting in your own chest.
-- Cheap on purpose: statues are "lite" pet builds (no particles, lights or joints), they are
-- only built for plots near the camera, and everything is refreshed by one loop once a second.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Format = require(ReplicatedStorage.Shared.Format)
local PetModel = require(ReplicatedStorage.Shared.PetModel)
local Net = require(script.Parent.Net)
local Lang = require(script.Parent.Lang)
local Quality = require(script.Parent.Quality)

local ParkFx = {}

local RANGE = 110 -- studs from the camera: statues of other players' plots
local PEDESTALS = 6

type Shown = { key: string, models: { Model } }
local shown: { [Instance]: Shown } = {}

local folder = Instance.new("Folder")
folder.Name = "ParkPets"
folder.Parent = Workspace

local function clear(plot: Instance)
	local s = shown[plot]
	if s then
		for _, m in s.models do
			m:Destroy()
		end
		shown[plot] = nil
	end
end

local function ownerOf(plot: Instance): Player?
	local id = plot:GetAttribute("OwnerId")
	if type(id) ~= "number" or id == 0 then
		return nil
	end
	return Players:GetPlayerByUserId(id)
end

local function build(plot: Instance, key: string)
	clear(plot)
	local models: { Model } = {}
	local slot = 0
	for entry in key:gmatch("[^,]+") do
		local id, tier = entry:match("^(.-):(%d)$")
		slot += 1
		local pedestal = plot:FindFirstChild("Pedestal" .. slot)
		if id and pedestal and pedestal:IsA("BasePart") and slot <= PEDESTALS then
			local m = PetModel.build(id, tonumber(tier) or 0, { lite = true })
			local foot = (m:GetAttribute("FootY") :: number?) or -1.3
			local facing = plot:GetAttribute("Facing")
			local yaw = if type(facing) == "number" then facing else 0
			-- stand on top of the pedestal (an upright cylinder: its X size is the height)
			local top = pedestal.Position + Vector3.new(0, pedestal.Size.X / 2 - foot, 0)
			m:PivotTo(CFrame.new(top) * CFrame.Angles(0, yaw, 0))
			m.Parent = folder
			table.insert(models, m)
		end
	end
	shown[plot] = { key = key, models = models }
end

-- Statues currently built, plots tracked (playtest).
function ParkFx.counts(): (number, number)
	local statues, plots = 0, 0
	for _, s in shown do
		plots += 1
		statues += #s.models
	end
	return statues, plots
end

local function refresh(park: Instance)
	local camera = Workspace.CurrentCamera
	local camPos = if camera then camera.CFrame.Position else Vector3.zero
	local state = Net.state
	local me = Players.LocalPlayer
	for _, plot in park:GetChildren() do
		if not plot:IsA("Model") then
			continue
		end
		local owner = ownerOf(plot)
		local mine = owner == me
		-- sign
		local sign = plot:FindFirstChild("OwnerText", true)
		if sign and sign:IsA("TextLabel") then
			local name = plot:GetAttribute("OwnerName")
			local text = if owner and type(name) == "string" and name ~= "" then name else Lang.t("park.free")
			if sign.Text ~= text then
				sign.Text = text
				sign.TextColor3 = if owner then Color3.new(1, 1, 1) else Color3.fromRGB(190, 190, 205)
			end
		end
		-- chest label: only your own chest tells you what is inside
		local label = plot:FindFirstChild("ChestText", true)
		if label and label:IsA("TextLabel") then
			local text = ""
			local ready = false
			if mine and state then
				local pending = if state.offline then state.offline.pending or 0 else 0
				ready = pending > 0
				text = if ready then Lang.t("park.pending", { n = Format.abbrev(pending) }) else Lang.t("park.empty")
			end
			if label.Text ~= text then
				label.Text = text
				label.TextColor3 = if ready then Color3.fromRGB(255, 225, 90) else Color3.fromRGB(235, 235, 245)
			end
			local glow = plot:FindFirstChild("ChestGlow", true)
			if glow and glow:IsA("BasePart") then
				glow.Transparency = if ready then 0.25 else 1
			end
		end
		-- statues
		local key = ""
		if owner then
			local pos = plot:GetPivot().Position
			local near = (pos - camPos).Magnitude < RANGE
			if near and (mine or not Quality.lite) then
				local eq = owner:GetAttribute("EquippedPets")
				key = if type(eq) == "string" then eq else ""
			end
		end
		local s = shown[plot]
		if key == "" then
			if s then
				clear(plot)
			end
		elseif not s or s.key ~= key then
			build(plot, key)
		end
	end
	-- plots that streamed out
	for plot in shown do
		if not plot.Parent then
			clear(plot)
		end
	end
end

function ParkFx.init()
	task.spawn(function()
		local world = Workspace:WaitForChild("World", 60)
		local park = world and world:WaitForChild("Park", 60)
		if not park then
			return
		end
		while true do
			local ok, err = pcall(function()
				refresh(park)
			end)
			if not ok then
				warn("[ParkFx]", err)
			end
			task.wait(1)
		end
	end)
end

return ParkFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">PetFollow</string>
            <string name="Source"><![CDATA[--!strict
-- Renders every player's equipped pets (from the replicated "EquippedPets" attribute).
-- Client-side only: the server stores which pets are equipped and never moves a part.
-- Walkers hop along behind the player and face where they are going, flyers hover and flap,
-- tails wag, ears flop, aura orbs orbit, and each pet drops a soft blob shadow.
-- PetFollow.pulse() makes the local player's pets hop (called on every tap).
--
-- One RenderStepped loop drives everything. Level of detail (see Quality):
--  * the local player's pets always get the full treatment
--  * other players: at most Quality.remotePets pets each, none beyond Quality.remoteCull,
--    positions updated every other frame beyond Quality.slowDistance
--  * joints and rainbow colours only animate within Quality.animDistance of the camera
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local PetModel = require(ReplicatedStorage.Shared.PetModel)
local Quality = require(script.Parent.Quality)

local PetFollow = {}

type JointAnim = { weld: Weld, base: CFrame, kind: string, side: number, radius: number, height: number, phase: number }
type Pet = {
	model: Model,
	shadow: BasePart,
	joints: { JointAnim },
	pos: Vector3?,
	yaw: number,
	phase: number, -- hop cycle
	hop: number, -- current hop height (smoothed)
	tapAt: number, -- os.clock() of the last tap hop
	footY: number,
	size: number,
	flyer: boolean,
	rainbow: boolean,
	seed: number,
}
type Rig = { key: string, pets: { Pet }, isLocal: boolean, order: number }

local folder = Instance.new("Folder")
folder.Name = "ClientPets"
folder.Parent = Workspace

-- owner: a Player, or a BasePart standing in for another player (PetFollow.addGhost)
local rigs: { [Instance]: Rig } = {}
local connections: { [Instance]: RBXScriptConnection } = {}
local localPlayer = Players.LocalPlayer
local pulseIndex = 0
local rigCount = 0
local frame = 0

local function destroyPet(pet: Pet)
	pet.model:Destroy()
	pet.shadow:Destroy()
end

local function clear(owner: Instance)
	local rig = rigs[owner]
	if rig then
		for _, pet in rig.pets do
			destroyPet(pet)
		end
		rigs[owner] = nil
	end
end

local function makeShadow(): BasePart
	local p = Instance.new("Part")
	p.Name = "PetShadow"
	p.Shape = Enum.PartType.Cylinder
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.Color = Color3.fromRGB(20, 15, 30)
	p.Transparency = 0.62
	p.Size = Vector3.new(0.08, 2, 2)
	return p
end

local function makePet(id: string, tier: number, isLocal: boolean, index: number): Pet
	local model = PetModel.build(id, tier, { lights = isLocal and Quality.petFx, fx = Quality.petFx })
	local joints: { JointAnim } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Weld") and d.Name == "Joint" then
			table.insert(joints, {
				weld = d,
				base = d.C0,
				kind = d:GetAttribute("Anim") :: string,
				side = (d:GetAttribute("Side") :: number?) or 1,
				radius = (d:GetAttribute("Radius") :: number?) or 0,
				height = (d:GetAttribute("Height") :: number?) or 0,
				phase = (d:GetAttribute("Phase") :: number?) or 0,
			})
		end
	end
	local shadow = makeShadow()
	shadow.Parent = folder
	model.Parent = folder
	return {
		model = model,
		shadow = shadow,
		joints = joints,
		pos = nil,
		yaw = 0,
		phase = index * 1.7,
		hop = 0,
		tapAt = -10,
		footY = (model:GetAttribute("FootY") :: number?) or -1.3,
		size = (model:GetAttribute("Size") :: number?) or 1,
		flyer = model:GetAttribute("Flyer") == true,
		rainbow = model:GetAttribute("Rainbow") == true,
		seed = index * 1.3,
	}
end

local function rebuild(owner: Instance, force: boolean?)
	local key = owner:GetAttribute("EquippedPets")
	local keyStr = if type(key) == "string" then key else ""
	local rig = rigs[owner]
	if rig and rig.key == keyStr and not force then
		return
	end
	local isLocal = owner == localPlayer
	local limit = if isLocal then math.huge else Quality.remotePets
	local old: { Pet } = if rig then rig.pets else {}
	rigCount += 1
	local newRig: Rig = { key = keyStr, pets = {}, isLocal = isLocal, order = if rig then rig.order else rigCount }
	local index = 0
	for entry in keyStr:gmatch("[^,]+") do
		local id, tier = entry:match("^(.-):(%d)$")
		if id and index < limit then
			index += 1
			local pet = makePet(id, tonumber(tier) or 0, isLocal, index)
			-- keep walking from where the previous pet in this slot stood
			local prev = old[index]
			if prev then
				pet.pos = prev.pos
				pet.yaw = prev.yaw
			end
			table.insert(newRig.pets, pet)
		end
	end
	for _, pet in old do
		destroyPet(pet)
	end
	rigs[owner] = newRig
end

local function watch(player: Player)
	rebuild(player)
	connections[player] = player:GetAttributeChangedSignal("EquippedPets"):Connect(function()
		rebuild(player)
	end)
end

local function unwatch(owner: Instance)
	local conn = connections[owner]
	if conn then
		conn:Disconnect()
		connections[owner] = nil
	end
	clear(owner)
end

-- Slot i of n: arc behind the player, second row when > 6 pets.
local function slotOffset(i: number, n: number): Vector3
	local perRow = 6
	local row = (i - 1) // perRow
	local inRow = math.min(perRow, n - row * perRow)
	local idx = (i - 1) % perRow
	local spread = math.rad(32)
	local angle = (idx - (inRow - 1) / 2) * spread
	local radius = 6.5 + row * 4
	return Vector3.new(math.sin(angle) * radius, 0, math.cos(angle) * radius)
end

local function lerpAngle(a: number, b: number, t: number): number
	local d = (b - a + math.pi) % (2 * math.pi) - math.pi
	return a + d * t
end

-- Renders a set of pets following an arbitrary part, as if it were another player
-- (performance tests and screenshots). key: "petId:tier,petId:tier".
function PetFollow.addGhost(part: BasePart, key: string)
	part:SetAttribute("EquippedPets", key)
	rebuild(part)
	part.Destroying:Once(function()
		unwatch(part)
	end)
end

-- Number of pet models currently parented to the world (after distance culling).
function PetFollow.visibleCount(): number
	local n = 0
	for _, rig in rigs do
		for _, pet in rig.pets do
			if pet.model.Parent then
				n += 1
			end
		end
	end
	return n
end

-- Owners being tracked and live attribute connections (leak check in the playtest).
function PetFollow.tracked(): (number, number)
	local r, c = 0, 0
	for _ in rigs do
		r += 1
	end
	for _ in connections do
		c += 1
	end
	return r, c
end

-- The local player's pets hop, one after another, on every tap.
function PetFollow.pulse()
	local rig = rigs[localPlayer]
	if not rig or #rig.pets == 0 then
		return
	end
	pulseIndex = pulseIndex % #rig.pets + 1
	rig.pets[pulseIndex].tapAt = os.clock()
end

local TAP_HOP = 0.3

local function animateJoints(pet: Pet, now: number, moving: boolean)
	for _, j in pet.joints do
		if j.kind == "Wing" then
			local a = if pet.flyer then math.sin(now * 11 + pet.seed) * 0.55 elseif moving or pet.hop > 0.1 then math.sin(now * 16 + pet.seed) * 0.5 else math.sin(now * 2 + pet.seed) * 0.06
			j.weld.C0 = j.base * CFrame.Angles(0, 0, j.side * a)
		elseif j.kind == "Tail" then
			j.weld.C0 = j.base * CFrame.Angles(0, math.sin(now * (if moving then 11 else 5) + pet.seed) * 0.38, 0)
		elseif j.kind == "Ear" then
			j.weld.C0 = j.base * CFrame.Angles(0, 0, j.side * (math.sin(now * 3 + pet.seed) * 0.06 + pet.hop * 0.22))
		elseif j.kind == "Orbit" then
			j.weld.C0 = CFrame.Angles(0, now * 2.2 + j.phase, 0) * CFrame.new(j.radius, j.height + math.sin(now * 3 + j.phase) * 0.15, 0)
		end
	end
end

function PetFollow.init()
	for _, p in Players:GetPlayers() do
		watch(p)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(unwatch)
	-- the profile changed (phone <-> PC preview, graphics slider): rebuild with the new detail
	Quality.Changed:Connect(function()
		for owner in rigs do
			rebuild(owner, true)
		end
	end)

	RunService.RenderStepped:Connect(function(frameDt: number)
		frame += 1
		local now = os.clock()
		local camera = Workspace.CurrentCamera
		local camPos = if camera then camera.CFrame.Position else Vector3.zero
		for owner, rig in rigs do
			local char = if owner:IsA("Player") then owner.Character else nil
			local root = if owner:IsA("BasePart") then owner else (char and char:FindFirstChild("HumanoidRootPart") :: BasePart?)
			local dist = if root then (root.Position - camPos).Magnitude else math.huge
			if not root or (not rig.isLocal and dist > Quality.remoteCull) then
				for _, pet in rig.pets do
					if pet.model.Parent then
						pet.model.Parent = nil
						pet.shadow.Parent = nil
					end
					pet.pos = nil
				end
				continue
			end
			-- far rigs of other players move every other frame (staggered between rigs)
			local dt = frameDt
			if not rig.isLocal and dist > Quality.slowDistance then
				if (frame + rig.order) % 2 == 0 then
					continue
				end
				dt = frameDt * 2
			end
			local follow = 1 - math.exp(-dt * 7)
			local turn = 1 - math.exp(-dt * 10)
			local settle = 1 - math.exp(-dt * 12)
			local base = (root :: BasePart).CFrame
			local playerYaw = math.atan2(-base.LookVector.X, -base.LookVector.Z)
			local flat = CFrame.new(base.Position) * CFrame.Angles(0, playerYaw, 0)
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local groundY = base.Position.Y - (if hum then hum.HipHeight + (root :: BasePart).Size.Y / 2 else 3)
			local detailed = dist < Quality.animDistance
			local n = #rig.pets
			for i, pet in rig.pets do
				if not pet.model.Parent then
					pet.model.Parent = folder
					pet.shadow.Parent = folder
				end
				local slot = (flat * CFrame.new(slotOffset(i, n))).Position
				local target = Vector3.new(slot.X, 0, slot.Z)
				local prev = pet.pos
				local cur: Vector3
				if not prev or (Vector3.new(prev.X, 0, prev.Z) - target).Magnitude > 60 then
					cur = target
					pet.yaw = playerYaw
				else
					cur = prev:Lerp(target, follow)
				end
				pet.pos = cur
				local move = if prev then cur - prev else Vector3.zero
				local speed = if dt > 0 then move.Magnitude / dt else 0
				local moving = speed > 1.5
				pet.yaw = lerpAngle(pet.yaw, if moving then math.atan2(-move.X, -move.Z) else playerYaw, turn)

				-- height above the ground
				local rest = -pet.footY
				local lift: number
				if pet.flyer then
					lift = 1.4 + math.sin(now * 2.6 + pet.seed) * 0.3
					pet.hop = 0
				else
					local want = 0
					if moving then
						pet.phase += dt * (7 + math.min(speed, 30) * 0.22)
						want = math.abs(math.sin(pet.phase)) * (0.55 + math.min(speed, 24) * 0.02)
					end
					pet.hop += (want - pet.hop) * settle
					lift = pet.hop + math.sin(now * 2.2 + pet.seed) * 0.04
				end
				local tapT = now - pet.tapAt
				if tapT < TAP_HOP then
					lift += math.sin(tapT / TAP_HOP * math.pi) * 0.85
				end
				local pitch = -math.clamp(speed * 0.012, 0, 0.28)
				if tapT < TAP_HOP then
					pitch += math.sin(tapT / TAP_HOP * math.pi) * 0.25
				end
				local roll = math.sin(now * 2 + pet.seed) * 0.05
				pet.model:PivotTo(CFrame.new(cur.X, groundY + rest + lift, cur.Z) * CFrame.Angles(0, pet.yaw, 0) * CFrame.Angles(pitch, 0, roll))

				local d = pet.size * 2.3 * (1 - math.clamp(lift / 7, 0, 0.45))
				pet.shadow.Size = Vector3.new(0.08, d, d)
				pet.shadow.CFrame = CFrame.new(cur.X, groundY + 0.07, cur.Z) * CFrame.Angles(0, 0, math.rad(90))

				if detailed then
					animateJoints(pet, now, moving)
					if pet.rainbow then
						PetModel.updateRainbow(pet.model, now)
					end
				end
			end
		end
	end)
end

return PetFollow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">Purchase</string>
            <string name="Source"><![CDATA[--!strict
-- Robux purchase prompts. Items with id 0 in Config are not live yet.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Lang = require(script.Parent.Lang)
local Net = require(script.Parent.Net)

local Purchase = {}

local notify: (string, string?) -> () = function(_text, _kind) end
function Purchase.setNotifier(fn: (string, string?) -> ())
	notify = fn
end

-- Paid random items (eggs, packs with an egg, luck, Taps): not sold where PolicyService
-- restricts them. Unknown (state not loaded yet) counts as restricted.
function Purchase.restricted(): boolean
	return Net.get("paidRandomRestricted") ~= false
end

function Purchase.passBlocked(key: string): boolean
	return Formulas.isPaidRandomPass(key) and Purchase.restricted()
end

function Purchase.productBlocked(key: string): boolean
	return Formulas.isPaidRandomProduct(key) and Purchase.restricted()
end

function Purchase.pass(key: string)
	if Purchase.passBlocked(key) then
		notify(Lang.t("egg.restricted"), "info")
		return
	end
	local pass = Config.PassByKey[key]
	if not pass or pass.id == 0 then
		notify(Lang.t("toast.coming_soon", { item = Lang.t("pass." .. key .. ".name") }), "info")
		return
	end
	MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, pass.id)
end

function Purchase.product(key: string)
	if Purchase.productBlocked(key) then
		notify(Lang.t("egg.restricted"), "info")
		return
	end
	local product = Config.ProductByKey[key]
	if not product or product.id == 0 then
		notify(Lang.t("toast.coming_soon", { item = Lang.t("product." .. key .. ".name") }), "info")
		return
	end
	MarketplaceService:PromptProductPurchase(Players.LocalPlayer, product.id)
end

-- Odds of the random item a product gives, as numeric percentages that add up to 100 plus
-- the Golden chance, localized: "Sparkle Cat 70% · Crystal Unicorn 29% · ... · Golden 1%".
-- nil for products with a fixed reward. Shown on the store card and the offer card, before
-- the purchase prompt (paid random items rule). The exclusive egg's entries are all Rare+,
-- so luck scales every weight equally and the odds do not depend on the buyer's luck.
function Purchase.oddsText(key: string): string?
	local eggId = Formulas.productEgg(key)
	if not eggId then
		return nil
	end
	local parts = {}
	for _, o in Formulas.displayOdds(eggId, 1) do
		table.insert(parts, Lang.pet(o.pet) .. " " .. o.text)
	end
	local golden = (Net.get("goldenChance") :: number?) or 0
	if golden > 0 then
		-- same text as the egg panel's Golden line
		local pct = Format.chance(golden * 100):gsub("%%", "")
		table.insert(parts, Lang.t("egg.golden", { pct = pct }))
	end
	return table.concat(parts, " · ")
end

-- What a paid probability modifier does to the odds, with this player's numbers:
-- "Luck x1.10 → x1.60" (Lucky, Super Lucky, VIP, Super Luck boost) or "Golden 1% → 10%" (Magic Eggs).
-- The exact odds after luck are on every egg panel. nil for items that change no odds.
function Purchase.effectText(key: string): string?
	local s = Net.state
	if not s then
		return nil
	end
	if key == "MagicEggs" then
		-- the live-event multiplier (Golden Weekend) is whatever the server's number implies
		local owns = Net.owns("MagicEggs")
		local plain = Formulas.goldenChance(owns, 1)
		local ev = if plain > 0 and s.goldenChance then s.goldenChance / plain else 1
		local before = Formulas.goldenChance(owns, ev)
		local after = Formulas.goldenChance(true, ev)
		local function pct(c: number): string
			return (Format.chance(c * 100):gsub("%%", ""))
		end
		return Lang.t("egg.golden", { pct = pct(before) }) .. " → " .. pct(after) .. "%"
	end
	if key ~= "Lucky" and key ~= "SuperLucky" and key ~= "VIP" and key ~= "SuperLuck" then
		return nil
	end
	local level = (s.upgrades and s.upgrades.Luck) or 0
	local passes = table.clone((Net.get("passes") :: { [string]: boolean }?) or {})
	local boosted = (s.luckBoostLeft or 0) > 0
	local base = Formulas.luck(level, passes, boosted, 1)
	local eventLuck = if base > 0 and s.luck then s.luck / base else 1
	local before = Formulas.luck(level, passes, boosted, eventLuck)
	if key == "SuperLuck" then
		boosted = true -- stacks time if it is already running
	else
		passes[key] = true
	end
	local after = Formulas.luck(level, passes, boosted, eventLuck)
	return Lang.t("egg.luck", { luck = string.format("%.2f", before) }) .. " → x" .. string.format("%.2f", after)
end

-- Text for a store card: the odds of a random reward, or the odds change of a luck item.
function Purchase.cardOdds(key: string): string?
	return Purchase.oddsText(key) or Purchase.effectText(key)
end

function Purchase.passAvailable(key: string): boolean
	local pass = Config.PassByKey[key]
	return pass ~= nil and pass.id ~= 0 and not Purchase.passBlocked(key)
end

function Purchase.productAvailable(key: string): boolean
	local product = Config.ProductByKey[key]
	return product ~= nil and product.id ~= 0 and not Purchase.productBlocked(key)
end

return Purchase
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">Quality</string>
            <string name="Source"><![CDATA[--!strict
-- Device / graphics profile. "lite" = phones and tablets, or a player who turned the Roblox
-- graphics slider down to 3 or less. Lite keeps the look (shapes, colours, UI) and drops the
-- expensive extras: fewer particles, no pet lights or trails, fewer pets drawn for other
-- players, no real-time shadows or post-processing. PC at normal quality is untouched.
--
-- Workspace attribute ForceLite = true previews it in Studio.
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Quality = {}

local changed = Instance.new("BindableEvent")
Quality.Changed = changed.Event

local FULL = {
	particles = 1, -- multiplier on ambient / tap / hatch particle counts
	petFx = true, -- pet trails, point lights, full emitter rates
	remotePets = 9, -- pets drawn per other player
	remoteCull = 220, -- studs: other players' pets beyond this are not drawn
	animDistance = 110, -- studs: joints / rainbow only animate this close to the camera
	slowDistance = 70, -- studs: beyond this, other players' pets update every other frame
	shadows = true, -- real-time shadows + bloom / sun rays
}
local LITE = {
	particles = 0.5,
	petFx = false,
	remotePets = 4,
	remoteCull = 110,
	animDistance = 55,
	slowDistance = 35,
	shadows = false,
}

Quality.lite = false
Quality.level = 0 -- Roblox graphics level 1..10 (0 = automatic)
Quality.particles = FULL.particles
Quality.petFx = FULL.petFx
Quality.remotePets = FULL.remotePets
Quality.remoteCull = FULL.remoteCull
Quality.animDistance = FULL.animDistance
Quality.slowDistance = FULL.slowDistance
Quality.shadows = FULL.shadows

local function savedLevel(): number
	local level = 0
	pcall(function()
		local saved = UserSettings():GetService("UserGameSettings").SavedQualityLevel
		level = tonumber(saved.Name:match("(%d+)$")) or 0
	end)
	return level
end

-- Pure rule, exported for tests.
function Quality.isLite(touchOnly: boolean, level: number, forced: boolean): boolean
	return forced or touchOnly or (level > 0 and level <= 3)
end

local function refresh()
	local level = savedLevel()
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local lite = Quality.isLite(touchOnly, level, Workspace:GetAttribute("ForceLite") == true)
	local was = Quality.lite
	Quality.level = level
	Quality.lite = lite
	local src = if lite then LITE else FULL
	Quality.particles = src.particles
	Quality.petFx = src.petFx
	Quality.remotePets = src.remotePets
	Quality.remoteCull = src.remoteCull
	Quality.animDistance = src.animDistance
	Quality.slowDistance = src.slowDistance
	Quality.shadows = src.shadows
	if was ~= lite then
		changed:Fire(lite)
	end
end

refresh()
pcall(function()
	UserSettings():GetService("UserGameSettings"):GetPropertyChangedSignal("SavedQualityLevel"):Connect(refresh)
end)
Workspace:GetAttributeChangedSignal("ForceLite"):Connect(refresh)

return Quality
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">Tapper</string>
            <string name="Source"><![CDATA[--!strict
-- Tap anywhere (mouse / touch) to earn Taps. Taps are counted locally, batched and sent
-- every Config.TapSendInterval; the server clamps them.
--
-- Local feedback per tap: a +N that pops and floats away, a ring, a burst of sparks, a token
-- that flies into the Taps counter (which bumps when it lands), the pets hop, and a combo
-- counter that follows the taps with milestone shout-outs. The combo is feedback only: it
-- never changes what a tap is worth. Everything is pooled, so fast tapping allocates nothing.
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Palette = require(ReplicatedStorage.Shared.Palette)
local Net = require(script.Parent.Net)
local Lang = require(script.Parent.Lang)
local PetFollow = require(script.Parent.PetFollow)
local Quality = require(script.Parent.Quality)
local Theme = require(script.Parent.UI.Theme)
local Root = require(script.Parent.UI.Root)

local Tapper = {}

local tapEvent = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Tap") :: RemoteEvent

local fxGui = Theme.new("ScreenGui", {
	Name = "TapFx",
	ResetOnSpawn = false,
	ScreenInsets = Enum.ScreenInsets.None,
	DisplayOrder = 5,
	Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
}) :: ScreenGui
-- everything is positioned inside this full-screen layer (input positions are converted
-- with layer.AbsolutePosition, so insets never matter)
local layer = Theme.new("Frame", { Name = "Layer", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = fxGui }) :: Frame

local pending = 0
local tokens = Config.MaxTapsPerSecond
local lastRefill = os.clock()
local enabled = true

-- where flying tokens land (the HUD sets it)
local counter: GuiObject? = nil
local onCounterHit: () -> () = function() end

function Tapper.setEnabled(on: boolean)
	enabled = on
end

function Tapper.setCounter(target: GuiObject, onHit: () -> ())
	counter = target
	onCounterHit = onHit
end

---------------------------------------------------------------------------
-- Combo (visual only)
---------------------------------------------------------------------------
local COMBO_WINDOW = 1.4 -- seconds without a tap before the combo drops
local COMBO_SHOW = 5
local MILESTONES: { [number]: string } = { [25] = "tap.nice", [50] = "tap.great", [100] = "tap.insane" }
local combo = 0
local lastTap = -10

Tapper.combo = 0

local function comboColor(n: number, now: number): Color3
	if n >= 100 then
		return Palette.rainbow(now * 2)
	elseif n >= 50 then
		return Theme.Pink
	elseif n >= 25 then
		return Theme.Orange
	elseif n >= 10 then
		return Theme.Yellow
	end
	return Theme.White
end

-- 1 .. 1.35: numbers and sparks grow with the combo
local function comboScale(n: number): number
	return 1 + math.min(n, 100) / 100 * 0.35
end

---------------------------------------------------------------------------
-- Pools
---------------------------------------------------------------------------
type Num = { label: TextLabel, stroke: UIStroke, scale: UIScale }
local numPool: { Num } = {}
local ringPool: { { frame: Frame, stroke: UIStroke } } = {}
local sparkPool: { Frame } = {}
type Token = { frame: Frame, from: Vector2, ctrl: Vector2, t: number }
local tokenPool: { Frame } = {}
local flying: { Token } = {}

local function takeNum(): Num
	local n = table.remove(numPool)
	if n then
		n.label.Visible = true
		return n
	end
	local label = Theme.text({ Text = "", AnchorPoint = Vector2.new(0.5, 1), Stroke = 3, Parent = layer })
	label.AutoLocalize = false
	local scale = Theme.new("UIScale", { Parent = label }) :: UIScale
	return { label = label, stroke = label:FindFirstChildOfClass("UIStroke") :: UIStroke, scale = scale }
end

local function takeRing(): { frame: Frame, stroke: UIStroke }
	local r = table.remove(ringPool)
	if r then
		r.frame.Visible = true
		return r
	end
	local frame = Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Parent = layer }, { Theme.corner(999) }) :: Frame
	local stroke = Theme.new("UIStroke", { Color = Theme.White, Parent = frame }) :: UIStroke
	return { frame = frame, stroke = stroke }
end

local function takeSpark(): Frame
	local s = table.remove(sparkPool)
	if s then
		s.Visible = true
		return s
	end
	return Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Parent = layer }, { Theme.corner(3) }) :: Frame
end

local function takeToken(): Frame
	local t = table.remove(tokenPool)
	if t then
		t.Visible = true
		return t
	end
	return Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Theme.Yellow, ZIndex = 3, Parent = layer }, { Theme.corner(999), Theme.stroke(2) }) :: Frame
end

local SPARK_COLORS = { Theme.Yellow, Theme.White, Theme.Pink, Color3.fromRGB(140, 230, 255) }

local function fx(pos: Vector2, value: number, n: number)
	local s = Root.scale
	local now = os.clock()
	local k = comboScale(n)
	local color = comboColor(n, now)

	-- ring
	local ring = takeRing()
	ring.frame.Size = UDim2.fromOffset(20 * s, 20 * s)
	ring.frame.Position = UDim2.fromOffset(pos.X, pos.Y)
	ring.stroke.Thickness = 5 * s
	ring.stroke.Transparency = 0
	ring.stroke.Color = color
	TweenService:Create(ring.frame, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Size = UDim2.fromOffset(96 * s * k, 96 * s * k) }):Play()
	TweenService:Create(ring.stroke, TweenInfo.new(0.35), { Transparency = 1, Thickness = 1 }):Play()

	-- floating number: pops, then drifts up and fades
	local num = takeNum()
	local label = num.label
	label.Text = "+" .. Format.abbrev(value)
	label.Size = UDim2.fromOffset(220 * s, 46 * s * k)
	label.Position = UDim2.fromOffset(pos.X + math.random(-20, 20) * s, pos.Y - 10 * s)
	label.TextColor3 = if n >= 10 then color else SPARK_COLORS[math.random(1, #SPARK_COLORS)]
	label.TextTransparency = 0
	label.Rotation = math.random(-12, 12)
	local sizeLimit = label:FindFirstChildOfClass("UITextSizeConstraint")
	if sizeLimit then
		sizeLimit.MaxTextSize = math.floor(40 * s * k)
	end
	num.stroke.Transparency = 0
	num.scale.Scale = 0.4
	TweenService:Create(num.scale, TweenInfo.new(0.16, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	local rise = UDim2.fromOffset(label.Position.X.Offset + math.random(-30, 30) * s, pos.Y - 120 * s)
	TweenService:Create(label, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = rise, Rotation = 0 }):Play()
	TweenService:Create(label, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.45), { TextTransparency = 1 }):Play()
	TweenService:Create(num.stroke, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.45), { Transparency = 1 }):Play()

	-- sparks
	local sparks: { Frame } = {}
	local count = if Quality.lite then 3 else 5
	for i = 1, count do
		local sp = takeSpark()
		local a = (i / count + math.random() * 0.2) * math.pi * 2
		local dist = (46 + math.random() * 40) * s * k
		local size = math.random(6, 11) * s
		sp.Size = UDim2.fromOffset(size, size)
		sp.Position = UDim2.fromOffset(pos.X, pos.Y)
		sp.Rotation = math.random(0, 90)
		sp.BackgroundColor3 = if n >= 10 then color else SPARK_COLORS[(i % #SPARK_COLORS) + 1]
		sp.BackgroundTransparency = 0
		TweenService:Create(sp, TweenInfo.new(0.38, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.fromOffset(pos.X + math.cos(a) * dist, pos.Y + math.sin(a) * dist),
			BackgroundTransparency = 1,
			Rotation = sp.Rotation + 180,
			Size = UDim2.fromOffset(size * 0.4, size * 0.4),
		}):Play()
		table.insert(sparks, sp)
	end

	-- token that flies into the counter
	if counter and #flying < 14 then
		local token = takeToken()
		local size = 16 * s
		token.Size = UDim2.fromOffset(size, size)
		token.Position = UDim2.fromOffset(pos.X, pos.Y)
		token.BackgroundTransparency = 0
		table.insert(flying, { frame = token, from = pos, ctrl = pos + Vector2.new(math.random(-140, 140) * s, -math.random(40, 150) * s), t = 0 })
	end

	task.delay(0.4, function()
		ring.frame.Visible = false
		table.insert(ringPool, ring)
		for _, sp in sparks do
			sp.Visible = false
			table.insert(sparkPool, sp)
		end
	end)
	task.delay(0.85, function()
		label.Visible = false
		table.insert(numPool, num)
	end)
end

---------------------------------------------------------------------------
-- Combo label (follows the taps) and milestone shout
---------------------------------------------------------------------------
local comboLabel = Theme.text({ Text = "", Size = UDim2.fromOffset(240, 40), AnchorPoint = Vector2.new(0.5, 1), Stroke = 3, MaxTextSize = 30, TextTransparency = 1, ZIndex = 4, Parent = layer })
comboLabel.AutoLocalize = false
local comboStroke = comboLabel:FindFirstChildOfClass("UIStroke") :: UIStroke
comboStroke.Transparency = 1
local comboPop = Theme.new("UIScale", { Parent = comboLabel }) :: UIScale
local comboAt = Vector2.zero
local comboShown = false

local shout = Theme.text({ Text = "", Size = UDim2.fromOffset(700, 90), Position = UDim2.fromScale(0.5, 0.24), AnchorPoint = Vector2.new(0.5, 0.5), Stroke = 4, MaxTextSize = 80, TextTransparency = 1, ZIndex = 5, Parent = layer })
local shoutStroke = shout:FindFirstChildOfClass("UIStroke") :: UIStroke
shoutStroke.Transparency = 1
local shoutScale = Theme.new("UIScale", { Parent = shout }) :: UIScale

local function milestone(key: string, color: Color3)
	shout.Text = Lang.t(key)
	shout.TextColor3 = color
	shout.TextTransparency = 0
	shoutStroke.Transparency = 0
	shout.Rotation = math.random(-6, 6)
	shoutScale.Scale = 2.2 * Root.scale
	TweenService:Create(shoutScale, TweenInfo.new(0.28, Enum.EasingStyle.Back), { Scale = Root.scale }):Play()
	TweenService:Create(shout, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.7), { TextTransparency = 1 }):Play()
	TweenService:Create(shoutStroke, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.7), { Transparency = 1 }):Play()
	Theme.play("buy", 0.4, 1.3)
end

local function bumpCombo(pos: Vector2): number
	local now = os.clock()
	if now - lastTap > COMBO_WINDOW then
		combo = 0
	end
	combo += 1
	lastTap = now
	Tapper.combo = combo
	comboAt = pos
	if combo >= COMBO_SHOW then
		local s = Root.scale
		comboLabel.Text = Lang.t("tap.combo", { n = combo })
		comboLabel.TextColor3 = comboColor(combo, now)
		comboLabel.Size = UDim2.fromOffset(240 * s, 40 * s)
		local limit = comboLabel:FindFirstChildOfClass("UITextSizeConstraint")
		if limit then
			limit.MaxTextSize = math.floor(30 * s * comboScale(combo))
		end
		comboLabel.TextTransparency = 0
		comboStroke.Transparency = 0
		if not comboShown then
			comboLabel.Position = UDim2.fromOffset(pos.X, pos.Y - 150 * s)
		end
		comboShown = true
		comboPop.Scale = 1.25
		TweenService:Create(comboPop, TweenInfo.new(0.14), { Scale = 1 }):Play()
	end
	local key = MILESTONES[combo] or (if combo > 100 and combo % 100 == 0 then "tap.insane" else nil)
	if key then
		milestone(key, comboColor(combo, now))
	end
	return combo
end

local function tap(inputPos: Vector2)
	if not enabled or not Net.state then
		return
	end
	local now = os.clock()
	tokens = math.min(Config.MaxTapsPerSecond, tokens + (now - lastRefill) * Config.MaxTapsPerSecond)
	lastRefill = now
	if tokens < 1 then
		return
	end
	tokens -= 1
	pending += 1
	local value = (Net.state :: any).tapValue or 1
	-- optimistic local count so the HUD feels instant (server state overwrites it)
	local s = Net.state :: any
	s.taps += value
	Net.bump()
	local pos = inputPos - layer.AbsolutePosition
	local n = bumpCombo(pos)
	fx(pos, value, n)
	PetFollow.pulse()
	Theme.play("tap", 0.18, 0.9 + math.min(n, 40) * 0.012 + math.random() * 0.08)
end

-- Same path as a real click at this input position (playtests and the screenshot showcase).
-- It goes through the same client token bucket, and the server clamps taps anyway.
function Tapper.simulate(inputPos: Vector2)
	tap(inputPos)
end

-- Screen zones the Roblox touch controls own (fractions of the viewport): the thumbstick
-- (bottom-left) and the jump button (bottom-right). A touch that starts there is movement,
-- not a tap.
local THUMBSTICK_ZONE = { x0 = -1, x1 = 0.4, y0 = 0.55, y1 = 2 }
local JUMP_ZONE = { x0 = 0.72, x1 = 2, y0 = 0.6, y1 = 2 }

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui

local function inZone(fx: number, fy: number, z: { x0: number, x1: number, y0: number, y1: number }): boolean
	return fx >= z.x0 and fx <= z.x1 and fy >= z.y0 and fy <= z.y1
end

-- pos: input position (below the topbar inset, like InputObject.Position).
-- True when the tap landed on UI (any button, text box or solid panel) or, for touches,
-- on the thumbstick / jump areas.
function Tapper.isBlocked(pos: Vector2, isTouch: boolean): boolean
	if isTouch then
		local cam = workspace.CurrentCamera
		if cam then
			local vp = cam.ViewportSize
			local abs = pos + GuiService:GetGuiInset()
			local fx, fy = abs.X / vp.X, abs.Y / vp.Y
			if inZone(fx, fy, THUMBSTICK_ZONE) or inZone(fx, fy, JUMP_ZONE) then
				return true
			end
		end
	end
	for _, g in playerGui:GetGuiObjectsAtPosition(pos.X, pos.Y) do
		if g:IsDescendantOf(fxGui) then
			continue
		end
		if g:IsA("GuiButton") or g:IsA("TextBox") then
			return true
		end
		if g.BackgroundTransparency < 0.95 then
			return true
		end
	end
	return false
end

function Tapper.init()
	local lastTouch = -1
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local t = input.UserInputType
		local isTouch = t == Enum.UserInputType.Touch
		if not isTouch and t ~= Enum.UserInputType.MouseButton1 then
			return
		end
		if isTouch then
			lastTouch = os.clock()
		elseif os.clock() - lastTouch < 0.1 then
			return -- emulated mouse click from the same touch
		end
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		if Tapper.isBlocked(pos, isTouch) then
			return
		end
		tap(pos)
	end)

	local lastHit = 0
	RunService.RenderStepped:Connect(function(dt: number)
		local now = os.clock()
		-- combo label trails the last tap and fades when the combo drops
		if comboShown then
			local s = Root.scale
			local want = UDim2.fromOffset(comboAt.X, comboAt.Y - 150 * s)
			comboLabel.Position = comboLabel.Position:Lerp(want, math.min(1, dt * 14))
			if combo >= 100 then
				comboLabel.TextColor3 = comboColor(combo, now)
			end
			if now - lastTap > COMBO_WINDOW then
				comboShown = false
				combo = 0
				Tapper.combo = 0
				TweenService:Create(comboLabel, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
				TweenService:Create(comboStroke, TweenInfo.new(0.25), { Transparency = 1 }):Play()
			end
		end
		-- tokens fly along a curve into the Taps counter
		if #flying > 0 then
			local target = Vector2.zero
			local c = counter
			if c then
				target = c.AbsolutePosition + Vector2.new(c.AbsoluteSize.Y * 0.5, c.AbsoluteSize.Y * 0.5) - layer.AbsolutePosition
			end
			for i = #flying, 1, -1 do
				local f = flying[i]
				f.t += dt / 0.42
				local t = math.min(1, f.t)
				local e = t * t
				local a = f.from:Lerp(f.ctrl, e)
				local b = f.ctrl:Lerp(target, e)
				local p = a:Lerp(b, e)
				f.frame.Position = UDim2.fromOffset(p.X, p.Y)
				if t >= 1 then
					f.frame.Visible = false
					table.insert(tokenPool, f.frame)
					table.remove(flying, i)
					if now - lastHit > 0.09 then
						lastHit = now
						onCounterHit()
					end
				end
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.TapSendInterval)
			if pending > 0 then
				tapEvent:FireServer(pending)
				pending = 0
			end
		end
	end)
end

return Tapper
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="70">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">EggPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Egg panel: opens from the egg's ProximityPrompt, shows the odds (after luck) and the
-- Hatch x1 / x3 / x8 / Auto buttons (or Robux buttons for the exclusive Magic Egg).
-- Keys while open: E = x1 (re-triggers the prompt), R = x3, Q = x8, T = auto.
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Palette = require(ReplicatedStorage.Shared.Palette)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)
local PetIcon = require(script.Parent.PetIcon)
local Toasts = require(script.Parent.Toasts)
local HatchCinematic = require(script.Parent.HatchCinematic)
local Net = require(script.Parent.Parent.Net)
local Lang = require(script.Parent.Parent.Lang)
local Hud = require(script.Parent.Hud)
local LiveEventClient = require(script.Parent.Parent.LiveEventClient)
local Purchase = require(script.Parent.Parent.Purchase)

local EggPanel = {}

local currentEgg: string? = nil
local eggPos: Vector3? = nil
local busy = false

-- assigned in init
EggPanel.open = function(_eggId: string, _position: Vector3) end
EggPanel.close = function() end

function EggPanel.init()
	-- PC: bottom center. Touch: top center (the bottom corners belong to the thumbstick and
	-- jump button); the HUD side columns hide while it's open.
	local panel = Theme.panel({
		Name = "EggPanel",
		Size = UDim2.fromOffset(680, 280),
		Position = if Root.isTouch then UDim2.new(0.5, 0, 0, 8) else UDim2.new(0.5, 0, 1, -12),
		AnchorPoint = if Root.isTouch then Vector2.new(0.5, 0) else Vector2.new(0.5, 1),
		Visible = false,
		Corner = 22,
		StrokeThickness = 4,
		Parent = Root.gui,
	})
	Root.mount(panel)
	Theme.shadow(panel, 22)
	local title = Theme.text({ Text = "", Size = UDim2.new(1, -40, 0, 40), Position = UDim2.fromOffset(20, 6), MaxTextSize = 34, TextColor3 = Theme.Ink, Stroke = false, Parent = panel })
	local luckLabel = Theme.text({ Text = "", Size = UDim2.new(1, -40, 0, 22), Position = UDim2.fromOffset(20, 44), MaxTextSize = 20, TextColor3 = Theme.Green, Stroke = false, Parent = panel })
	local odds = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -24, 0, 128), Position = UDim2.fromOffset(12, 68), Parent = panel }, {
		Theme.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center),
	})
	local buttonRow = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -24, 0, 66), Position = UDim2.new(0, 12, 1, -74), Parent = panel }, {
		Theme.list(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center),
	})

	local function hatch(count: number)
		local egg = currentEgg
		if not egg or busy then
			return
		end
		local def = Formulas.EggById[egg]
		if def.exclusive then
			if count == 8 then
				return -- the Robux egg has no x8
			end
			Purchase.product(if count == 3 then "MagicEgg3" else "MagicEgg1")
			return
		end
		local needRebirths = Formulas.eggMinRebirths(egg)
		if needRebirths > ((Net.get("rebirths") :: number?) or 0) then
			Toasts.show(Lang.t("msg.egg_needs_rebirth", { n = needRebirths }), "error")
			return
		end
		local needPass = Formulas.hatchPass(count)
		if needPass and count > Formulas.maxHatch((Net.get("passes") :: { [string]: boolean }?) or {}) then
			Purchase.pass(needPass)
			return
		end
		if HatchCinematic.isPlaying() then
			return
		end
		busy = true
		local ok, res = Net.request("Hatch", { egg = egg, count = count })
		busy = false
		if ok then
			HatchCinematic.play(egg, res, false)
		elseif res ~= "cooldown" then
			Toasts.show(Lang.msg(res), "error")
		end
	end

	-- four buttons fit the 680 px panel: x1, x3, x8, Auto (the Robux egg uses x1 / x3 only)
	local b1 = Theme.button({ Text = "", Color = Theme.Green, Size = UDim2.fromOffset(152, 58), LayoutOrder = 1, TextSize = 22, Parent = buttonRow, OnClick = function()
		hatch(1)
	end })
	local b3 = Theme.button({ Text = "", Color = Theme.Orange, Size = UDim2.fromOffset(152, 58), LayoutOrder = 2, TextSize = 22, Parent = buttonRow, OnClick = function()
		hatch(3)
	end })
	local b8 = Theme.button({ Text = "", Color = Theme.Red, Size = UDim2.fromOffset(152, 58), LayoutOrder = 3, TextSize = 22, Parent = buttonRow, OnClick = function()
		hatch(8)
	end })
	local function toggleAuto()
		local egg = currentEgg
		if not egg or Formulas.EggById[egg].exclusive then
			return
		end
		local on = Net.get("autoHatch") == egg
		local ok, err = Net.request("SetAutoHatch", if on then {} else { egg = egg })
		if not ok and err then
			Toasts.show(Lang.msg(err), "error")
		end
	end
	local bAuto = Theme.button({ Text = "", Color = Theme.Purple, Size = UDim2.fromOffset(152, 58), LayoutOrder = 4, TextSize = 22, Parent = buttonRow, OnClick = toggleAuto })
	-- keyboard hints (PC only)
	if not Root.isTouch then
		for key, b in { E = b1, R = b3, Q = b8, T = bAuto } :: { [string]: TextButton } do
			local chip = Theme.new("Frame", { Name = "Key", Size = UDim2.fromOffset(28, 26), Position = UDim2.fromOffset(-8, -10), BackgroundColor3 = Theme.Ink, ZIndex = b.ZIndex + 2, Parent = b }, { Theme.corner(8), Theme.new("UIStroke", { Thickness = 2, Color = Theme.White }) })
			local t = Theme.text({ Text = key, Stroke = false, Size = UDim2.new(1, -6, 1, -4), Position = UDim2.fromOffset(3, 2), MaxTextSize = 18, Parent = chip })
			t.ZIndex = b.ZIndex + 3
			t.AutoLocalize = false
		end
	end
	Theme.button({ Text = "X", Color = Theme.Red, Size = UDim2.fromOffset(56, 56), Position = UDim2.new(1, 14, 0, -14), AnchorPoint = Vector2.new(1, 0), Corner = 27, Parent = panel, OnClick = function()
		EggPanel.close()
	end })

	local function refreshButtons()
		local egg = currentEgg
		if not egg then
			return
		end
		local def = Formulas.EggById[egg]
		local s = Net.state
		luckLabel.TextColor3 = Theme.Green
		local golden = Lang.t("egg.golden", { pct = Format.chance((if s then s.goldenChance or 0 else 0) * 100):gsub("%%", "") })
		if def.exclusive then
			local p1, p3 = Config.ProductByKey.MagicEgg1, Config.ProductByKey.MagicEgg3
			local blocked = Purchase.productBlocked("MagicEgg1")
			local off = Lang.t(if blocked then "egg.restricted" else "egg.coming_soon")
			Theme.setButton(b1, if Purchase.productAvailable("MagicEgg1") then (Lang.t("egg.buy1") .. "  R$" .. p1.price) else off, if blocked then Theme.Grey else Theme.Green)
			Theme.setButton(b3, if Purchase.productAvailable("MagicEgg3") then (Lang.t("egg.buy3") .. "  R$" .. p3.price) else off, if blocked then Theme.Grey else Theme.Orange)
			b3.Visible = not blocked
			b8.Visible = false
			bAuto.Visible = false
			luckLabel.Text = Lang.t("egg.exclusive_note") .. "  ·  ⭐ " .. golden
			return
		end
		-- rebirth-gated egg the player can't open yet: odds stay visible (the carrot), buttons say why
		local needRebirths = Formulas.eggMinRebirths(egg)
		if needRebirths > ((if s then s.rebirths else 0) or 0) then
			Theme.setButton(b1, Lang.t("egg.locked_btn", { n = needRebirths }), Theme.Grey)
			b3.Visible = false
			b8.Visible = false
			bAuto.Visible = false
			luckLabel.Text = Lang.t("msg.egg_needs_rebirth", { n = needRebirths })
			luckLabel.TextColor3 = Theme.Orange
			return
		end
		b3.Visible = true
		b8.Visible = true
		bAuto.Visible = true
		local taps = if s then s.taps else 0
		Theme.setButton(b1, Lang.t("egg.hatch1") .. "  " .. Format.abbrev(def.price), if taps >= def.price then Theme.Green else Theme.Grey)
		local maxHatch = Formulas.maxHatch((Net.get("passes") :: { [string]: boolean }?) or {})
		if maxHatch >= 3 then
			Theme.setButton(b3, Lang.t("egg.hatch3") .. "  " .. Format.abbrev(def.price * 3), if taps >= def.price * 3 then Theme.Orange else Theme.Grey)
		else
			Theme.setButton(b3, "⭐ " .. Lang.t("egg.x3_locked"), Theme.Blue)
		end
		if maxHatch >= 8 then
			Theme.setButton(b8, Lang.t("egg.hatch8") .. "  " .. Format.abbrev(def.price * 8), if taps >= def.price * 8 then Theme.Red else Theme.Grey)
		else
			Theme.setButton(b8, "⭐ " .. Lang.t("egg.x8_locked"), Theme.Blue)
		end
		local autoOn = s and s.autoHatch == egg
		Theme.setButton(bAuto, Lang.t(if autoOn then "egg.auto_on" else "egg.auto_off"), if autoOn then Theme.Green else Theme.Purple)
		local luck = if s then s.luck else 1
		local extra = if s and (s.luckBoostLeft or 0) > 0 then ("  🍀 " .. Lang.t("egg.super_luck")) else ""
		for _, ev in LiveEventClient.active() do
			extra ..= "  ✨ " .. Lang.t("event." .. ev.id)
		end
		luckLabel.Text = Lang.t("egg.luck", { luck = string.format("%.2f", luck) }) .. "  ·  ⭐ " .. golden .. extra
	end

	local function buildOdds()
		for _, c in odds:GetChildren() do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		local egg = currentEgg
		if not egg then
			return
		end
		local s = Net.state
		local luck = if s and not Formulas.EggById[egg].exclusive then s.luck else 1
		local discovered = if s then s.discovered else {}
		-- numeric percentages that add up to exactly 100, shown before anything is spent
		for i, o in Formulas.displayOdds(egg, luck) do
			local pet = Formulas.PetById[o.pet]
			local secret = pet.rarity == "Secret"
			local rc = if secret then Color3.fromRGB(90, 50, 130) else Palette.rarity(pet.rarity)
			local cell = Theme.new("Frame", { Size = UDim2.fromOffset(100, 128), LayoutOrder = i, BackgroundColor3 = Color3.new(1, 1, 1), Parent = odds }, {
				Theme.corner(14),
				Theme.stroke(3),
				Theme.gradient(Theme.lighten(rc, 0.55), Theme.darken(rc, 0.05)),
			})
			Theme.gloss(cell, 14, 0.7)
			local icon = PetIcon.new(o.pet, 0, secret and not discovered[o.pet])
			icon.Size = UDim2.new(1, -6, 0, 78)
			icon.Position = UDim2.fromOffset(3, 1)
			icon.Parent = cell
			local plate = Theme.new("Frame", { Size = UDim2.new(1, -8, 0, 46), Position = UDim2.new(0, 4, 1, -50), BackgroundColor3 = Theme.Ink, BackgroundTransparency = 0.4, BorderSizePixel = 0, Parent = cell }, { Theme.corner(10) })
			local pct = Theme.text({ Name = "Chance", Text = o.text, Size = UDim2.new(1, -6, 0, 24), Position = UDim2.fromOffset(3, 1), MaxTextSize = 22, TextColor3 = Theme.Yellow, Parent = plate })
			pct.AutoLocalize = false
			pct:SetAttribute("Units", o.units)
			Theme.text({ Text = if secret and not discovered[o.pet] then Lang.t("egg.unknown") else Lang.pet(pet.id), Size = UDim2.new(1, -6, 0, 20), Position = UDim2.fromOffset(3, 24), MaxTextSize = 16, Parent = plate })
		end
		local def = Formulas.EggById[egg]
		title.Text = Lang.egg(def.id)
	end

	EggPanel.open = function(eggId: string, position: Vector3)
		if currentEgg == eggId and panel.Visible then
			hatch(1) -- pressing E again hatches
			return
		end
		currentEgg = eggId
		eggPos = position
		buildOdds()
		refreshButtons()
		panel.Visible = true
		Hud.setDockVisible(false)
		if Root.isTouch then
			Hud.setSidesVisible(false)
		end
		Theme.pop(panel, 0.8)
	end

	EggPanel.close = function()
		currentEgg = nil
		eggPos = nil
		panel.Visible = false
		Hud.setDockVisible(true)
		if Root.isTouch then
			Hud.setSidesVisible(true)
		end
	end

	-- Paid random items policy: players PolicyService restricts (and everyone until the
	-- answer arrives) don't get the Robux-only egg at all: its prompt and sign are switched
	-- off on this client, and a stray trigger only explains why.
	local function isExclusive(eggId: any): boolean
		local def = if type(eggId) == "string" then Formulas.EggById[eggId] else nil
		return def ~= nil and def.exclusive == true
	end
	local function syncExclusive(inst: Instance)
		if inst:IsA("ProximityPrompt") and isExclusive(inst:GetAttribute("EggId")) then
			inst.Enabled = not Purchase.restricted()
		elseif inst:IsA("BillboardGui") then
			local model = inst:FindFirstAncestorOfClass("Model")
			if model and isExclusive(model:GetAttribute("EggId")) then
				inst.Enabled = not Purchase.restricted()
			end
		end
	end
	local eggsFolder: Instance? = nil
	local function syncAllExclusive()
		if eggsFolder then
			for _, d in eggsFolder:GetDescendants() do
				syncExclusive(d)
			end
		end
	end
	task.spawn(function()
		local world = Workspace:WaitForChild("World", 60)
		local eggs = world and world:WaitForChild("Eggs", 60)
		if eggs then
			eggsFolder = eggs
			eggs.DescendantAdded:Connect(syncExclusive)
			syncAllExclusive()
		end
	end)
	local lastRestricted: boolean? = nil
	Net.Changed:Connect(function(kind)
		if kind == "full" and Purchase.restricted() ~= lastRestricted then
			lastRestricted = Purchase.restricted()
			syncAllExclusive()
		end
	end)

	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if player ~= Players.LocalPlayer then
			return
		end
		local eggId = prompt:GetAttribute("EggId")
		if isExclusive(eggId) and Purchase.restricted() then
			Toasts.show(Lang.t("egg.restricted"), "info")
			return
		end
		if type(eggId) == "string" then
			local parent = prompt.Parent
			local pos = if parent and parent:IsA("BasePart") then parent.Position else Vector3.zero
			EggPanel.open(eggId, pos)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not currentEgg then
			return
		end
		if input.KeyCode == Enum.KeyCode.R then
			hatch(3)
		elseif input.KeyCode == Enum.KeyCode.Q then
			hatch(8)
		elseif input.KeyCode == Enum.KeyCode.T then
			toggleAuto()
		end
	end)

	Lang.Changed:Connect(function()
		if currentEgg then
			buildOdds()
			refreshButtons()
		end
	end)

	Net.Changed:Connect(function(kind)
		if not currentEgg then
			return
		end
		refreshButtons()
		if kind == "full" then
			-- luck may have changed
			local luckNow = Net.get("luck")
			if luckNow ~= panel:GetAttribute("Luck") then
				panel:SetAttribute("Luck", luckNow)
				buildOdds()
			end
		end
	end)

	-- close when walking away
	task.spawn(function()
		while true do
			task.wait(0.3)
			if currentEgg and eggPos then
				local char = Players.LocalPlayer.Character
				local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
				if not root or (root.Position - eggPos).Magnitude > Config.EggRange + 2 then
					EggPanel.close()
				end
			end
		end
	end)

end

return EggPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">HatchCinematic</string>
              <string name="Source"><![CDATA[--!strict
-- Hatch cinematic. The egg drops in, shakes harder and harder while cracks glow in the
-- colour of what is inside, bursts into shards and confetti, and the pet spins in with its
-- rarity ribbon, odds and a NEW! badge for first discoveries. Legendary and above get a
-- coloured flash, a sunburst, a screen shake and extra confetti waves.
-- Supports 1 or 3 eggs at once, a faster "auto" variant, and a queue.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Palette = require(ReplicatedStorage.Shared.Palette)
local PetModel = require(ReplicatedStorage.Shared.PetModel)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)
local Net = require(script.Parent.Parent.Net)
local Lang = require(script.Parent.Parent.Lang)
local Quality = require(script.Parent.Parent.Quality)

local HatchCinematic = {}

type Result = { uid: string, id: string, tier: number, chance: number, rarity: string, new: boolean? }
type Job = { egg: string, results: { Result }, auto: boolean }

local queue: { Job } = {}
local playing = false
local onBusy: (boolean) -> () = function(_) end
local onBurst: (string) -> () = function(_) end
-- RenderStepped connections of the job being played (dropped if the job errors out)
local active: { RBXScriptConnection } = {}

local function track(conn: RBXScriptConnection): RBXScriptConnection
	table.insert(active, conn)
	return conn
end

local function dropConnections()
	for _, c in active do
		c:Disconnect()
	end
	table.clear(active)
end

function HatchCinematic.setBusyCallback(fn: (boolean) -> ())
	onBusy = fn
end

-- Called with the egg id at the moment the shells burst (world egg reacts).
function HatchCinematic.setBurstCallback(fn: (string) -> ())
	onBurst = fn
end

local SECRET = Color3.fromRGB(170, 60, 255)
local EGG_R = Vector3.new(2.75, 3.5, 2.75)

local function rarityColor(rarity: string): Color3
	return if rarity == "Secret" then SECRET else Palette.rarity(rarity)
end

local function backOut(x: number): number
	local c1 = 1.70158
	local c3 = c1 + 1
	return 1 + c3 * (x - 1) ^ 3 + c1 * (x - 1) ^ 2
end

-- Point on the front of the egg shell (the camera looks from -Z).
local function shellPoint(x: number, y: number): Vector3
	local k = math.max(0.02, 1 - (x / EGG_R.X) ^ 2 - (y / EGG_R.Y) ^ 2)
	return Vector3.new(x, y, -EGG_R.Z * math.sqrt(k) - 0.04)
end

local CRACKS = {
	{ { -1.5, 0.9 }, { -0.8, 0.3 }, { -0.2, 1.0 }, { 0.5, 0.2 }, { 1.1, 0.9 }, { 1.7, 0.4 } },
	{ { -1.0, -0.9 }, { -0.3, -0.3 }, { 0.4, -1.1 }, { 1.0, -0.5 } },
	{ { -0.2, 1.0 }, { 0.1, 1.9 }, { -0.3, 2.5 } },
}

type EggRig = { model: Model, cracks: { BasePart } }

local function buildEggModel(eggId: string, glow: Color3): EggRig
	local egg = Formulas.EggById[eggId]
	local model = Instance.new("Model")
	local shell = Instance.new("Part")
	shell.Name = "Shell"
	shell.Size = EGG_R * 2
	shell.Color = Palette.rgb(egg.color)
	shell.Anchored = true
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = shell
	shell.Parent = model
	model.PrimaryPart = shell
	local rng = Random.new(7)
	for i = 1, 8 do
		local a = i * 2.2
		local y = rng:NextNumber(-2, 2.2)
		local rr = 2.75 * math.sqrt(1 - (y / 3.5) ^ 2)
		local spot = Instance.new("Part")
		spot.Shape = Enum.PartType.Ball
		spot.Size = Vector3.one * rng:NextNumber(1, 1.6)
		spot.Color = Palette.rgb(egg.spots)
		spot.Anchored = true
		spot.CFrame = CFrame.new(math.cos(a) * rr, y, math.sin(a) * rr)
		spot.Parent = model
	end
	local cracks: { BasePart } = {}
	for _, line in CRACKS do
		for i = 1, #line - 1 do
			local a = shellPoint(line[i][1], line[i][2])
			local b = shellPoint(line[i + 1][1], line[i + 1][2])
			local seg = Instance.new("Part")
			seg.Name = "Crack"
			seg.Anchored = true
			seg.Material = Enum.Material.Neon
			seg.Color = glow
			seg.Size = Vector3.new(0.16, 0.16, (a - b).Magnitude + 0.1)
			seg.CFrame = CFrame.lookAt((a + b) / 2, b)
			seg.Transparency = 1
			seg.Parent = model
			table.insert(cracks, seg)
		end
	end
	return { model = model, cracks = cracks }
end

local function viewport(model: Model, dist: number): (ViewportFrame, Camera)
	local vp = Instance.new("ViewportFrame")
	vp.BackgroundTransparency = 1
	vp.Size = UDim2.fromScale(1, 1)
	vp.Ambient = Color3.fromRGB(200, 200, 215)
	vp.LightColor = Color3.fromRGB(255, 255, 255)
	vp.LightDirection = Vector3.new(-1, -2, 1.5)
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.CFrame = CFrame.lookAt(Vector3.new(0, 1, -dist), Vector3.new(0, 0, 0))
	cam.Parent = vp
	vp.CurrentCamera = cam
	model.Parent = vp
	return vp, cam
end

-- A turning fan of soft rays (rarity shine behind the pet, sunburst behind the row).
local function rays(parent: Instance, size: number, count: number, width: number, color: Color3, alpha: number, z: number): Frame
	local burst = Theme.new("Frame", {
		Size = UDim2.fromOffset(size, size),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = parent,
	}) :: Frame
	for k = 0, count - 1 do
		Theme.new("Frame", {
			Size = UDim2.new(0, width, 1, 0),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Rotation = k * (180 / count),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = z,
			Parent = burst,
		}, {
			Theme.new("UIGradient", {
				Rotation = 90,
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, alpha), NumberSequenceKeypoint.new(1, 1) }),
			}),
		})
	end
	return burst
end

---------------------------------------------------------------------------
-- 2D confetti (one update loop per cinematic)
---------------------------------------------------------------------------
type Bit = { f: Frame, x: number, y: number, vx: number, vy: number, vr: number, life: number, t: number }

local function confetti(layer: Frame, bits: { Bit }, at: Vector2, colors: { Color3 }, count: number, power: number)
	local s = Root.scale
	for _ = 1, math.ceil(count * Quality.particles) do
		local a = math.random() * math.pi * 2
		local sp = (0.35 + math.random() * 0.65) * power * s
		local w = math.random(7, 13) * s
		local f = Theme.new("Frame", {
			Size = UDim2.fromOffset(w, w * (0.5 + math.random() * 0.6)),
			Position = UDim2.fromOffset(at.X, at.Y),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = colors[math.random(1, #colors)],
			BorderSizePixel = 0,
			Rotation = math.random(0, 360),
			ZIndex = 8,
			Parent = layer,
		}, { Theme.corner(2) }) :: Frame
		table.insert(bits, { f = f, x = at.X, y = at.Y, vx = math.cos(a) * sp, vy = math.sin(a) * sp - 260 * s, vr = math.random(-540, 540), life = 0.9 + math.random() * 0.6, t = 0 })
	end
end

local function stepConfetti(bits: { Bit }, dt: number)
	local g = 1100 * Root.scale
	for i = #bits, 1, -1 do
		local b = bits[i]
		b.t += dt
		if b.t >= b.life then
			b.f:Destroy()
			table.remove(bits, i)
		else
			b.vy += g * dt
			b.vx *= 1 - math.min(1, dt * 1.2)
			b.x += b.vx * dt
			b.y += b.vy * dt
			b.f.Position = UDim2.fromOffset(b.x, b.y)
			b.f.Rotation += b.vr * dt
			local left = b.life - b.t
			if left < 0.3 then
				b.f.BackgroundTransparency = 1 - left / 0.3
			end
		end
	end
end

---------------------------------------------------------------------------
type Shard = { part: BasePart, v: Vector3, spin: CFrame }
type Slot = {
	frame: Frame,
	holder: Frame,
	scale: UIScale,
	egg: EggRig,
	vp: ViewportFrame,
	cam: Camera,
	info: Frame,
	glow: Frame,
	color: Color3,
	order: number,
	shards: { Shard },
}

local function playJob(job: Job)
	local n = #job.results
	local auto = job.auto
	local overlay = Theme.new("TextButton", {
		Name = "Hatch",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(20, 15, 35),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = Root.overlay,
	}) :: TextButton
	TweenService:Create(overlay, TweenInfo.new(0.2), { BackgroundTransparency = if auto then 0.75 else 0.3 }):Play()
	local layer = Theme.new("Frame", { Name = "Fx", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 8, Parent = overlay }) :: Frame
	local row = Theme.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(n * 320, 450),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 2,
		Parent = overlay,
	}, { Theme.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) }) :: Frame
	-- a big hatch (x8) is shrunk until the whole row fits the screen width
	local fit = math.min(1, (Root.gui.AbsoluteSize.X * 0.96) / math.max(1, n * 310 * Root.scale * (if auto then 0.7 else 1)))
	Theme.new("UIScale", { Scale = Root.scale * (if auto then 0.7 else 1) * fit, Parent = row })

	local best = 1
	local bestColor = Color3.new(1, 1, 1)
	local slots: { Slot } = {}
	for i, r in job.results do
		local pet = Formulas.PetById[r.id]
		local rc = rarityColor(r.rarity)
		local order = Config.RarityByName[r.rarity].order
		if order > best then
			best = order
			bestColor = rc
		end
		local frame = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(300, 440), LayoutOrder = i, Parent = row }) :: Frame
		local scale = Theme.new("UIScale", { Scale = 0.2, Parent = frame }) :: UIScale
		local glow = Theme.new("Frame", {
			Size = UDim2.fromOffset(210, 210),
			Position = UDim2.fromOffset(150, 150),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Theme.lighten(rc, 0.25),
			BackgroundTransparency = 1,
			ZIndex = 1,
			Parent = frame,
		}, { Theme.corner(999) }) :: Frame
		local holder = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(300, 300), ZIndex = 3, Parent = frame }) :: Frame
		local egg = buildEggModel(job.egg, Theme.lighten(rc, 0.35))
		local vp, cam = viewport(egg.model, 17)
		vp.ZIndex = 3
		vp.Parent = holder
		local info = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(300, 130), Position = UDim2.fromOffset(0, 300), Visible = false, ZIndex = 5, Parent = frame }) :: Frame
		Theme.new("UIScale", { Parent = info })
		Theme.text({ Text = Lang.pet(pet.id, r.tier), Size = UDim2.fromOffset(300, 44), MaxTextSize = 38, Stroke = 3, ZIndex = 5, Parent = info })
		local ribbon = Theme.new("Frame", {
			Size = UDim2.fromOffset(230, 40),
			Position = UDim2.fromOffset(35, 46),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 5,
			Parent = info,
		}, { Theme.corner(20), Theme.stroke(3), Theme.gradient(Theme.lighten(rc, 0.3), Theme.darken(rc, 0.08)) })
		Theme.text({ Text = Lang.upper(Lang.rarity(r.rarity)), Size = UDim2.new(1, -20, 1, -8), Position = UDim2.fromOffset(10, 4), MaxTextSize = 28, Stroke = 2.5, ZIndex = 6, Parent = ribbon })
		local stats = Theme.text({
			Text = Format.chance(r.chance) .. "  ·  " .. Lang.t("hatch.power", { n = Format.abbrev(Formulas.petPower(r.id, r.tier, #(Net.get("zones") or { 1 }))) }),
			Size = UDim2.fromOffset(300, 28),
			Position = UDim2.fromOffset(0, 92),
			TextColor3 = Theme.Yellow,
			MaxTextSize = 24,
			ZIndex = 5,
			Parent = info,
		})
		stats.AutoLocalize = false
		if r.new then
			local badge = Theme.new("Frame", {
				Name = "New",
				Size = UDim2.fromOffset(96, 40),
				Position = UDim2.fromOffset(226, 26),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Rotation = 12,
				BackgroundColor3 = Color3.new(1, 1, 1),
				Visible = false,
				ZIndex = 7,
				Parent = frame,
			}, { Theme.corner(14), Theme.stroke(3), Theme.gradient(Theme.lighten(Theme.Red, 0.25), Theme.Red), Theme.new("UIScale", {}) })
			Theme.text({ Key = "hatch.new", Size = UDim2.new(1, -10, 1, -6), Position = UDim2.fromOffset(5, 3), MaxTextSize = 26, ZIndex = 8, Parent = badge })
		end
		table.insert(slots, { frame = frame, holder = holder, scale = scale, egg = egg, vp = vp, cam = cam, info = info, glow = glow, color = rc, order = order, shards = {} })
		task.delay((i - 1) * 0.07, function()
			TweenService:Create(scale, TweenInfo.new(0.32, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end)
	end

	local bits: { Bit } = {}
	local alive = true
	local fxConn = track(RunService.RenderStepped:Connect(function(dt)
		stepConfetti(bits, dt)
	end))
	local function center(slot: Slot): Vector2
		return slot.holder.AbsolutePosition + slot.holder.AbsoluteSize / 2 - layer.AbsolutePosition
	end

	---------------------------------------------------------------------------
	-- Shake: wobble grows, cracks light up one by one, the glow behind the egg builds
	---------------------------------------------------------------------------
	Theme.play("hatch", 0.4)
	local shakeTime = if auto then 0.55 else 1.25
	local t0 = os.clock()
	local lit = 0
	local conn = track(RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		local k = math.clamp(t / shakeTime, 0, 1)
		for i, s in slots do
			local amp = 0.06 + k * k * 0.42
			local wob = math.sin(t * (16 + k * 34) + i) * amp
			s.egg.model:PivotTo(CFrame.new(0, math.abs(wob) * 0.9 + math.abs(math.sin(t * 9 + i)) * k * 0.5, 0) * CFrame.Angles(math.sin(t * 23 + i) * amp * 0.25, 0, wob))
			local want = math.floor(k * 1.15 * #s.egg.cracks)
			for c = 1, math.min(want, #s.egg.cracks) do
				s.egg.cracks[c].Transparency = 0
			end
			s.glow.BackgroundTransparency = 1 - math.max(0, k - 0.35) * 0.95
			local g = 210 + k * 70 + math.sin(t * 20) * 8 * k
			s.glow.Size = UDim2.fromOffset(g, g)
		end
		local step = math.floor(k * 6)
		if step > lit then
			lit = step
			Theme.play("tap", 0.25, 0.8 + step * 0.12)
		end
	end))
	task.wait(shakeTime)
	conn:Disconnect()

	---------------------------------------------------------------------------
	-- Burst
	---------------------------------------------------------------------------
	local flashColor = if best >= 5 then Theme.lighten(bestColor, 0.55) else Color3.new(1, 1, 1)
	local flash = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = flashColor, BackgroundTransparency = if auto then 0.35 else 0, ZIndex = 50, Parent = overlay })
	TweenService:Create(flash, TweenInfo.new(if best >= 5 then 0.7 else 0.4), { BackgroundTransparency = 1 }):Play()
	if best >= 5 and not auto then
		local sun = rays(overlay, 1700, 9, 150, Theme.lighten(bestColor, 0.3), 0.72, 1)
		TweenService:Create(sun, TweenInfo.new(24, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), { Rotation = 360 }):Play()
		TweenService:Create(overlay, TweenInfo.new(0.4), { BackgroundColor3 = Theme.darken(bestColor, 0.82), BackgroundTransparency = 0.18 }):Play()
	end
	onBurst(job.egg)

	local eggDef = Formulas.EggById[job.egg]
	local shellColor, spotColor = Palette.rgb(eggDef.color), Palette.rgb(eggDef.spots)
	local pets: { Model } = {}
	local offsets: { Vector3 } = {}
	local dists: { number } = {}
	for i, s in slots do
		s.egg.model:Destroy()
		local r = job.results[i]
		-- shell shards
		local rng = Random.new(i * 31)
		for k = 1, if auto then 6 else 11 do
			local shard: BasePart = Instance.new("WedgePart")
			shard.Anchored = true
			shard.Size = Vector3.new(rng:NextNumber(0.2, 0.35), rng:NextNumber(0.9, 1.7), rng:NextNumber(0.9, 1.7))
			shard.Color = if k % 4 == 0 then spotColor else shellColor
			local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.2, 1), rng:NextNumber(-0.6, 0.3)).Unit
			shard.CFrame = CFrame.new(dir * 2) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), rng:NextNumber(0, 6))
			shard.Parent = s.vp
			table.insert(s.shards, { part = shard, v = dir * rng:NextNumber(12, 22) + Vector3.new(0, 6, 0), spin = CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(-0.3, 0.3), rng:NextNumber(-0.3, 0.3)) })
		end
		local m = PetModel.build(r.id, r.tier, { lite = true })
		m.Parent = s.vp
		table.insert(pets, m)
		local cf, size = m:GetBoundingBox()
		local radius = size.Magnitude * 0.5
		table.insert(offsets, cf.Position)
		table.insert(dists, radius / math.tan(math.rad(s.cam.FieldOfView / 2)) * 0.96)
		-- rarity shine behind the pet
		local burst = rays(s.frame, 300, 6, 34, Theme.lighten(s.color, 0.35), 0.35, 0)
		burst.Position = UDim2.fromOffset(150, 150)
		TweenService:Create(burst, TweenInfo.new(9, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), { Rotation = 360 }):Play()
		s.glow.BackgroundColor3 = s.color
		s.glow.BackgroundTransparency = 0.7
		s.glow.Size = UDim2.fromOffset(190, 190)
		Theme.new("UIStroke", { Thickness = 6, Color = Theme.lighten(s.color, 0.3), Transparency = 0.25, Parent = s.glow })
		TweenService:Create(s.glow, TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Size = UDim2.fromOffset(222, 222) }):Play()
		-- expanding ring
		local ring = Theme.new("Frame", { Size = UDim2.fromOffset(60, 60), Position = UDim2.fromOffset(150, 150), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 2, Parent = s.frame }, { Theme.corner(999) })
		local ringStroke = Theme.new("UIStroke", { Thickness = 10, Color = Theme.lighten(s.color, 0.45), Parent = ring })
		TweenService:Create(ring, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(420, 420) }):Play()
		TweenService:Create(ringStroke, TweenInfo.new(0.5), { Transparency = 1, Thickness = 1 }):Play()

		s.info.Visible = true
		Theme.pop(s.info, 1.5)
		local badge = s.frame:FindFirstChild("New") :: Frame?
		if badge then
			badge.Visible = true
			Theme.pop(badge, 2.4)
		end
		local colors = { s.color, Theme.lighten(s.color, 0.45), Color3.new(1, 1, 1), Theme.Yellow }
		confetti(layer, bits, center(s), colors, (if auto then 8 else 14) + s.order * (if auto then 2 else 5), 520 + s.order * 70)
	end
	Theme.play("buy", 0.5, 0.8 + best * 0.1)
	if best >= 5 then
		Theme.play("boom", if auto then 0.12 else 0.22, 1.25)
	end

	local spinStart = os.clock()
	local rowBase = row.Position
	local spin = track(RunService.RenderStepped:Connect(function(dt)
		local t = os.clock() - spinStart
		local e = backOut(math.clamp(t / 0.45, 0, 1))
		for i, m in pets do
			local s = slots[i]
			-- spins in, then sways
			local yaw = math.rad(24) + math.sin(t * 1.5) * 0.55 + (1 - math.clamp(t / 0.55, 0, 1)) ^ 2 * math.pi * 2
			m:PivotTo(CFrame.new(0, math.sin(t * 3) * 0.18, 0) * CFrame.Angles(0, yaw, 0))
			PetModel.updateRainbow(m, os.clock())
			local dist = dists[i] * (2.6 - 1.6 * e)
			local look = offsets[i]
			s.cam.CFrame = CFrame.lookAt(look + Vector3.new(0, dists[i] * 0.12, -dist), look)
			for k = #s.shards, 1, -1 do
				local sh = s.shards[k]
				sh.v += Vector3.new(0, -40, 0) * dt
				sh.part.CFrame = (sh.part.CFrame + sh.v * dt) * sh.spin
				if t > 0.8 then
					sh.part:Destroy()
					table.remove(s.shards, k)
				end
			end
		end
		if best >= 5 and not auto and t < 0.45 then
			local a = (1 - t / 0.45) * 14 * Root.scale
			row.Position = rowBase + UDim2.fromOffset((math.random() * 2 - 1) * a, (math.random() * 2 - 1) * a)
		else
			row.Position = rowBase
		end
	end))
	if best >= 5 and not auto then
		-- extra confetti waves for the big ones
		for wave = 1, if best >= 6 then 4 else 2 do
			task.delay(wave * 0.3, function()
				if not alive then
					return
				end
				for _, s in slots do
					if s.order >= 5 then
						confetti(layer, bits, center(s), { s.color, Theme.lighten(s.color, 0.5), Color3.new(1, 1, 1), Theme.Yellow }, 22, 760)
					end
				end
				Theme.play("tap", 0.25, 1.4 + wave * 0.1)
			end)
		end
	end

	local hold = if auto then 1.0 elseif best >= 5 then 3.4 else 2.1
	local skipped = false
	overlay.Activated:Connect(function()
		skipped = true
	end)
	local waited = 0
	while waited < hold and not (skipped and waited > 0.5) do
		waited += task.wait()
	end
	alive = false
	spin:Disconnect()
	fxConn:Disconnect()
	table.clear(active)
	local fade = TweenService:Create(overlay, TweenInfo.new(0.15), { BackgroundTransparency = 1 })
	fade:Play()
	row.Visible = false
	layer.Visible = false
	fade.Completed:Wait()
	overlay:Destroy()
end

local function pump()
	if playing then
		return
	end
	playing = true
	onBusy(true)
	while #queue > 0 do
		local job = table.remove(queue, 1) :: Job
		local ok, err = pcall(function()
			playJob(job)
		end)
		if not ok then
			warn("[Hatch] cinematic error", err)
			dropConnections()
			for _, c in Root.overlay:GetChildren() do
				if c.Name == "Hatch" then
					c:Destroy()
				end
			end
		end
	end
	playing = false
	onBusy(false)
end

function HatchCinematic.play(eggId: string, results: { any }, auto: boolean?)
	if #results == 0 then
		return
	end
	-- auto-hatch jobs don't pile up: keep at most one waiting
	if auto and #queue > 0 then
		return
	end
	table.insert(queue, { egg = eggId, results = results :: any, auto = auto == true })
	task.spawn(pump)
end

function HatchCinematic.isPlaying(): boolean
	return playing
end

return HatchCinematic
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- HUD, laid out the way the top simulators do it (see docs: ROBLOX-HUD-GUIA).
--
-- PC:    top-centre   objective with a progress bar (what to do next)
--        left         rebirth line, Gems and Taps as bars with an icon, then the menu grid
--        bottom-centre dock: Rewards · the big TAP button (with +N per tap) · Pets (count badge)
--        right        gift timer, live event, boosts, offers, the four auto chips
-- Touch: currencies + menu top-left and the right column at the top, so the thumbstick
--        (bottom-left) and jump button (bottom-right) stay free; the dock sits between them.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local HudUnlock = require(ReplicatedStorage.Shared.HudUnlock)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)
local Windows = require(script.Parent.Windows)
local Toasts = require(script.Parent.Toasts)
local Net = require(script.Parent.Parent.Net)
local Lang = require(script.Parent.Parent.Lang)
local LiveEventClient = require(script.Parent.Parent.LiveEventClient)
local Ads = require(script.Parent.Parent.Ads)
local Guide = require(script.Parent.Parent.Guide)
local Tapper = require(script.Parent.Parent.Tapper)

local Hud = {}

local shown = { taps = 0, gems = 0 }
local target = { taps = 0, gems = 0 }

local EVENT_COLORS = { LuckyHour = Theme.Green, GoldenWeekend = Theme.Yellow }
local EVENT_ICONS = { LuckyHour = "🍀", GoldenWeekend = "⭐" }

-- iconName: image from the shared icon pack (Theme.setIcon); the emoji is the fallback.
local function pill(parent: Instance, icon: string, iconName: string, color: Color3, width: number, height: number): (Frame, TextLabel)
	local f = Theme.new("Frame", {
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = parent,
	}, { Theme.corner(height // 2), Theme.stroke(3), Theme.new("UIGradient", { Color = Theme.buttonFace(color), Rotation = 90 }) })
	Theme.gloss(f, height // 2, 0.78)
	local iconFrame = Theme.new("Frame", {
		Size = UDim2.fromOffset(height + 8, height + 8),
		Position = UDim2.new(0, -4, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Theme.Paper,
		Parent = f,
	}, { Theme.corner((height + 8) // 2), Theme.stroke(3), Theme.gradient(Theme.White, Theme.lighten(color, 0.6)) })
	Theme.icon(icon, { Size = UDim2.fromScale(0.75, 0.75), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Parent = iconFrame }, iconName)
	local label = Theme.text({ Text = "0", Size = UDim2.new(1, -(height + 18), 1, -8), Position = UDim2.new(0, height + 10, 0, 4), TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 34, Stroke = 3, Parent = f })
	label.AutoLocalize = false
	Theme.new("UIScale", { Parent = f })
	return f, label
end

Hud.tapsPill = nil :: Frame?
local sides: { GuiObject } = {}
local dockHolder: GuiObject? = nil

-- Touch layout hides the side columns while a top panel (egg panel) is open.
function Hud.setSidesVisible(visible: boolean)
	for _, s in sides do
		s.Visible = visible
	end
end

-- The egg panel (PC: bottom-centre) takes the dock's place while it is open.
function Hud.setDockVisible(visible: boolean)
	if dockHolder then
		dockHolder.Visible = visible
	end
end

-- Pets and Rewards live in the bottom dock; everything else is in the menu grid.
local MENU: { { any } } = {
	{ "Upgrades", "⬆️", Theme.Teal },
	{ "Rebirth", "🔁", Theme.Purple },
	{ "Quests", "📜", Theme.Orange },
	{ "Store", "🛒", Theme.Green },
	{ "Index", "📖", Theme.Blue },
	{ "Teleport", "🌀", Theme.Yellow },
	{ "Invite", "💌", Theme.Pink },
	{ "Codes", "🎟️", Theme.Red },
}

function Hud.init()
	local gui = Root.gui
	local touch = Root.isTouch
	-- icon in front of a button's text (see Theme.lead)
	local function lead(b: TextButton, emoji: string, name: string?): string
		return Theme.lead(b:FindFirstChild("Label") :: TextLabel, emoji, name)
	end
	local badges: { [string]: Frame } = {}
	local badgeText: { [string]: TextLabel } = {}

	-- Square icon button with a label underneath (menu grid and dock).
	local function iconButton(parent: Instance, name: string, icon: string, color: Color3, order: number, onClick: () -> ()): TextButton
		local b = Theme.button({
			Name = name,
			Color = color,
			LayoutOrder = order,
			Corner = 18,
			OnClick = onClick,
			Parent = parent,
		})
		-- earlier buttons draw above later ones, so a badge poking out to the right is not
		-- hidden by the neighbour (ZIndexBehavior.Sibling)
		b.ZIndex = 20 - order
		local label = b:FindFirstChild("Label") :: TextLabel
		Theme.setIcon(label, icon)
		label.Size = UDim2.new(1, -16, 0.58, 0)
		label.Position = UDim2.new(0.5, 0, 0.36, 0)
		local st = label:FindFirstChildOfClass("UIStroke")
		if st then
			st.Enabled = false
		end
		Theme.text({ Key = "menu." .. name, Size = UDim2.new(1, -8, 0.28, 0), Position = UDim2.new(0.5, 0, 0.84, 0), AnchorPoint = Vector2.new(0.5, 0.5), MaxTextSize = 17, Parent = b })
		badges[name] = Theme.badge(b)
		badgeText[name] = (badges[name] :: any):FindFirstChildOfClass("TextLabel")
		return b
	end

	---------------------------------------------------------------------------
	-- Currencies + menu (left)
	---------------------------------------------------------------------------
	local COLS, CELL, GAP = if touch then 4 else 3, if touch then 62 else 80, if touch then 6 else 10
	local rows = math.ceil(#MENU / COLS)
	local menuW, menuH = COLS * CELL + (COLS - 1) * GAP, rows * CELL + (rows - 1) * GAP
	local CUR_H = if touch then 94 else 142 -- currency block height
	local left = Theme.new("Frame", {
		Name = "Left",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(math.max(menuW, if touch then 240 else 264), CUR_H + menuH),
		Position = if touch then UDim2.fromOffset(14, 8) else UDim2.new(0, 14, 0.6, 0),
		AnchorPoint = if touch then Vector2.zero else Vector2.new(0, 0.5),
		Parent = gui,
	})
	local currencies = Theme.new("Frame", { Name = "Currencies", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, CUR_H), Parent = left })
	-- rebirth line
	local rebirthLabel = Theme.text({
		Name = "Rebirths",
		Text = "",
		Size = UDim2.fromOffset(250, 24),
		Position = UDim2.fromOffset(6, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 20,
		TextColor3 = Theme.lighten(Theme.Purple, 0.45),
		Visible = not touch,
		Parent = currencies,
	})
	local gemsPill, gemsLabel = pill(currencies, "💎", "gem", Theme.Teal, if touch then 170 else 214, if touch then 40 else 44)
	local tapsPill, tapsLabel = pill(currencies, "👆", "coin", Theme.Blue, if touch then 220 else 250, if touch then 44 else 50)
	if touch then
		tapsPill.Position = UDim2.fromOffset(4, 0)
		gemsPill.Position = UDim2.fromOffset(4, 52)
	else
		gemsPill.Position = UDim2.fromOffset(4, 30)
		tapsPill.Position = UDim2.fromOffset(4, 84)
	end
	Hud.tapsPill = tapsPill
	local menu = Theme.new("Frame", {
		Name = "Menu",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(menuW, menuH),
		Position = UDim2.fromOffset(0, CUR_H),
		Parent = left,
	}, {
		Theme.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(CELL, CELL),
			CellPadding = UDim2.fromOffset(GAP, GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	table.insert(sides, Root.mount(left))
	-- buttons that appear as the player progresses (HudUnlock), keyed by HudUnlock name
	local unlockables: { [string]: GuiObject } = {}
	for i, e in MENU do
		local name = e[1]
		unlockables[name] = iconButton(menu, name, e[2], e[3], i, function()
			Windows.toggle(name)
		end)
	end

	---------------------------------------------------------------------------
	-- Dock (bottom-centre): Rewards · TAP · Pets
	---------------------------------------------------------------------------
	local dock = Theme.new("Frame", {
		Name = "Dock",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(300, 128),
		Position = UDim2.new(if touch then 0.56 else 0.5, 0, 1, -8),
		AnchorPoint = Vector2.new(0.5, 1),
		Parent = gui,
	})
	dockHolder = Root.mount(dock)
	local rewardsB = iconButton(dock, "Rewards", "🎁", Theme.Pink, 1, function()
		Windows.toggle("Rewards")
	end)
	rewardsB.ZIndex = 5 -- its badge overlaps the TAP button
		rewardsB.Size = UDim2.fromOffset(84, 84)
	rewardsB.Position = UDim2.fromOffset(0, 36)
	local petsB = iconButton(dock, "Pets", "🐾", Theme.Orange, 3, function()
		Windows.toggle("Pets")
	end)
	petsB.Size = UDim2.fromOffset(84, 84)
	petsB.Position = UDim2.fromOffset(216, 36)
	-- the pets badge shows how many you own (blue, not an alert)
	local petsCount = Theme.new("Frame", { Name = "Count", Size = UDim2.fromOffset(40, 26), Position = UDim2.new(1, -30, 0, -10), BackgroundColor3 = Theme.Blue, ZIndex = 10, Parent = petsB }, { Theme.corner(13), Theme.stroke(2) })
	local petsCountText = Theme.text({ Text = "0", Size = UDim2.new(1, -6, 1, -4), Position = UDim2.fromOffset(3, 2), MaxTextSize = 18, Parent = petsCount })
	petsCountText.ZIndex = 11
	petsCountText.AutoLocalize = false
	-- the big tap button: same thing as tapping the world, always under the thumb
	local tapB = Theme.button({
		Name = "TapButton",
		Text = "👆",
		Color = Theme.Yellow,
		Size = UDim2.fromOffset(112, 96),
		Position = UDim2.fromOffset(94, 0),
		Corner = 30,
		TextSize = 60,
		Parent = dock,
	})
	local tapIcon = tapB:FindFirstChild("Label") :: TextLabel
	Theme.setIcon(tapIcon, "👆", "tap")
	local tapIconStroke = tapIcon:FindFirstChildOfClass("UIStroke")
	if tapIconStroke then
		tapIconStroke.Enabled = false
	end
	tapB.Activated:Connect(function()
		Tapper.simulate(tapB.AbsolutePosition + Vector2.new(tapB.AbsoluteSize.X / 2, -6 * Root.scale))
	end)
	local perTap = Theme.text({
		Name = "PerTap",
		Text = "",
		Size = UDim2.fromOffset(200, 28),
		Position = UDim2.fromOffset(50, 98),
		MaxTextSize = 24,
		Stroke = 3,
		TextColor3 = Theme.Yellow,
		Parent = dock,
	})
	-- First-session hint over the TAP button (it was lost in the HUD rewrite): wobbles until
	-- the player has tapped a bit, then fades out for good.
	local hint = Theme.text({
		Name = "TapHint",
		Key = "hint.tap",
		Size = UDim2.fromOffset(460, 40),
		Position = UDim2.new(0.5, 0, 0, -12),
		AnchorPoint = Vector2.new(0.5, 1),
		MaxTextSize = 34,
		Stroke = 3,
		TextColor3 = Theme.Yellow,
		Parent = dock,
	})
	local hintStroke = hint:FindFirstChildOfClass("UIStroke")
	task.spawn(function()
		local t = 0
		while hint.Parent do
			t += task.wait()
			hint.Rotation = math.sin(t * 3) * 3
			local s = Net.state
			if (s and (s.totalTaps or 0) > 60) or t > 90 then
				local info = TweenInfo.new(0.5)
				TweenService:Create(hint, info, { TextTransparency = 1 }):Play()
				if hintStroke then
					TweenService:Create(hintStroke, info, { Transparency = 1 }):Play()
				end
				task.wait(0.6)
				hint:Destroy()
			end
		end
	end)

	---------------------------------------------------------------------------
	-- Objective (top-centre): what to do next, with a progress bar
	---------------------------------------------------------------------------
	local objective = Theme.new("TextButton", {
		Name = "Objective",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(if touch then 320 else 380, 60),
		Position = UDim2.new(if touch then 0.53 else 0.5, 0, 0, 4),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = gui,
	})
	local objectiveHolder = Root.mount(objective)
	if touch then
		table.insert(sides, objectiveHolder)
	end
	local objectiveText = Theme.text({ Name = "Text", Text = "", Size = UDim2.new(1, 0, 0, 30), MaxTextSize = 26, Stroke = 3, Parent = objective })
	local objBarBg = Theme.new("Frame", { Name = "Bar", Size = UDim2.new(1, -40, 0, 20), Position = UDim2.fromOffset(20, 34), BackgroundColor3 = Theme.Ink, BackgroundTransparency = 0.35, Parent = objective }, { Theme.corner(10), Theme.stroke(3) })
	local objBar = Theme.new("Frame", { Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = objBarBg }, { Theme.corner(10), Theme.gradient(Theme.lighten(Theme.Green, 0.35), Theme.Green) })
	local objPct = Theme.text({ Name = "Pct", Text = "", Size = UDim2.new(1, 0, 1, -2), Position = UDim2.fromOffset(0, 1), MaxTextSize = 16, Parent = objBarBg })
	objPct.AutoLocalize = false
	local objWindow: string? = nil
	objective.Activated:Connect(function()
		if objWindow then
			Windows.open(objWindow)
		end
	end)
	local function refreshObjective()
		local s = Net.state
		if not s then
			return
		end
		local o = Guide.current(s)
		local args = table.clone(o.args)
		if o.zoneArg then
			args.zone = Lang.zone(o.zoneArg)
		end
		local text = Lang.t(o.key, args)
		if objectiveText.Text ~= text then
			objectiveText.Text = text
			Theme.pop(objective, 1.12)
		end
		local p = math.clamp(o.progress, 0, 1)
		objBar.Size = UDim2.fromScale(math.max(p, 0.03), 1)
		objBar.BackgroundColor3 = if p >= 1 then Theme.Yellow else Color3.new(1, 1, 1)
		local pct = math.floor(p * 100) .. "%"
		if objPct.Text ~= pct then
			objPct.Text = pct
		end
		objWindow = o.window
		Guide.point(o.target)
	end

	---------------------------------------------------------------------------
	-- Right column: gift timer, live event, offers, boosts, auto toggles
	---------------------------------------------------------------------------
	local right = Theme.new("Frame", {
		Name = "Right",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(210, 440),
		Position = if touch then UDim2.new(1, -14, 0, 8) else UDim2.new(1, -16, 0.55, 0),
		AnchorPoint = if touch then Vector2.new(1, 0) else Vector2.new(1, 0.5),
		Parent = gui,
	}, { Theme.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right, if touch then Enum.VerticalAlignment.Top else Enum.VerticalAlignment.Center) })
	table.insert(sides, Root.mount(right))

	local giftButton = Theme.button({
		Name = "GiftTimer",
		Key = "hud.gift_ready",
		Color = Theme.Pink,
		Size = UDim2.fromOffset(200, 56),
		LayoutOrder = 1,
		Parent = right,
		OnClick = function()
			Windows.open("Rewards")
		end,
	})
	-- live event pill
	local eventPill = Theme.new("Frame", {
		Name = "EventPill",
		Size = UDim2.fromOffset(200, 44),
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = 2,
		Visible = false,
		Parent = right,
	}, { Theme.corner(22), Theme.stroke(3) })
	local eventGradient = Theme.gradient(Theme.lighten(Theme.Green, 0.3), Theme.Green)
	eventGradient.Parent = eventPill
	local eventText = Theme.text({ Text = "", Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), MaxTextSize = 22, Parent = eventPill })

	-- Boost status: small dark chips (icon + timer) instead of loose coloured text.
	local function statusChip(name: string, emoji: string, color: Color3, order: number): (Frame, TextLabel)
		local f = Theme.new("Frame", {
			Name = name,
			Size = UDim2.fromOffset(200, 32),
			BackgroundColor3 = Theme.Ink,
			BackgroundTransparency = 0.25,
			LayoutOrder = order,
			Visible = false,
			Parent = right,
		}, { Theme.corner(16), Theme.stroke(2, Theme.darken(color, 0.35)) })
		Theme.icon(emoji, { Size = UDim2.fromOffset(26, 26), Position = UDim2.new(0, 5, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = f })
		local t = Theme.text({ Name = "Text", Text = "", Size = UDim2.new(1, -44, 1, -6), Position = UDim2.fromOffset(36, 3), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.lighten(color, 0.25), MaxTextSize = 20, Parent = f })
		return f, t
	end
	local luckChip, luckLabel = statusChip("SuperLuck", "🍀", Theme.Green, 3)
	local boostChip, boostLabel = statusChip("TapBoost", "⚡", Theme.Red, 4)
	local friendChip, friendLabel = statusChip("FriendBoost", "👥", Theme.Yellow, 5)

	local starterButton = Theme.button({
		Name = "StarterPack",
		Text = "",
		Color = Theme.Orange,
		Size = UDim2.fromOffset(200, 56),
		LayoutOrder = 6,
		TextSize = 24,
		Parent = right,
		OnClick = function()
			Hud.onStarterClick()
		end,
	})
	starterButton.Visible = false
	local adButton = Theme.button({
		Name = "AdBoost",
		Text = "",
		Color = Theme.Red,
		Size = UDim2.fromOffset(200, 56),
		LayoutOrder = 7,
		TextSize = 22,
		Parent = right,
		OnClick = function()
			Ads.watch("AdBoost")
		end,
	})
	adButton.Visible = false

	-- Auto toggles: one chip each, green = ON, grey = OFF. The server does the work (and
	-- sets the pace), so they keep running while the player is away from the keyboard.
	local autoGrid = Theme.new("Frame", {
		Name = "Auto",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(200, 118),
		LayoutOrder = 8,
		Parent = right,
	}, {
		Theme.new("UIGridLayout", { CellSize = UDim2.fromOffset(97, 56), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	type Chip = { button: TextButton, name: TextLabel, state: TextLabel, key: string, icon: string, on: boolean? }
	local chips: { [string]: Chip } = {}
	local function autoState(key: string): boolean
		local s = Net.state
		if not s then
			return false
		end
		if key == "hatch" then
			return s.autoHatch ~= nil
		end
		return s.auto ~= nil and s.auto[key] == true
	end
	local function toggleAuto(key: string)
		local on = not autoState(key)
		local ok, err
		if key == "hatch" then
			if on then
				-- needs an egg: the egg panel's Auto button starts it
				Toasts.show(Lang.t("toast.autohatch_hint"), "info")
				return
			end
			ok, err = Net.request("SetAutoHatch", {})
		else
			ok, err = Net.request("SetAuto", { key = key, on = on })
		end
		if ok then
			Toasts.show(Lang.t("toast.auto", { name = Lang.t("hud.auto." .. key), state = Lang.t(if on then "hud.on" else "hud.off") }), if on then "success" else "info")
		elseif err then
			Toasts.show(Lang.msg(err), "error")
		end
	end
	for i, spec in { { "tap", "AutoTap", "🤖" }, { "hatch", "AutoHatch", "🥚" }, { "equip", "AutoEquip", "🐾" }, { "rebirth", "AutoRebirth", "🔁" } } do
		local key, name, icon = spec[1], spec[2], spec[3]
		local b = Theme.button({
			Name = name,
			Text = "",
			Color = Theme.Grey,
			LayoutOrder = i,
			Corner = 14,
			Parent = autoGrid,
			OnClick = function()
				toggleAuto(key)
			end,
		})
		local top = b:FindFirstChild("Label") :: TextLabel
		top.Size = UDim2.new(1, -34, 0.5, -2)
		top.Position = UDim2.new(0.5, 13, 0.3, 0)
		local iconHolder = Theme.icon(icon, { Name = "ChipIcon", Size = UDim2.fromOffset(24, 24), Position = UDim2.new(0, 6, 0.3, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = b })
		iconHolder.ZIndex = top.ZIndex
		local topLimit = top:FindFirstChildOfClass("UITextSizeConstraint")
		if topLimit then
			topLimit.MaxTextSize = 18
		end
		local state = Theme.text({ Name = "State", Text = "", Size = UDim2.new(1, -8, 0.42, 0), Position = UDim2.new(0.5, 0, 0.72, 0), AnchorPoint = Vector2.new(0.5, 0.5), MaxTextSize = 17, Parent = b })
		state.ZIndex = top.ZIndex
		chips[key] = { button = b, name = top, state = state, key = key, icon = icon }
		unlockables[name] = b
	end
	local function refreshChips()
		for key, chip in chips do
			local on = autoState(key)
			local label = Lang.t("hud.auto." .. key)
			if chip.name.Text ~= label then
				chip.name.Text = label
			end
			if chip.on ~= on or chip.state.Text == "" then
				chip.on = on
				Theme.setButton(chip.button, nil, if on then Theme.Green else Theme.Grey)
			end
			local text = Lang.t(if on then "hud.on" else "hud.off")
			if key == "tap" and on then
				local s = Net.state
				local rate = if s and s.auto then s.auto.tapRate else 0
				text = text .. " · " .. tostring(rate) .. "/s"
			end
			if chip.state.Text ~= text then
				chip.state.Text = text
			end
		end
	end

	-- the starter button pulses while the offer is live
	local starterScale = starterButton:FindFirstChildOfClass("UIScale") :: UIScale
	task.spawn(function()
		while true do
			if starterButton.Visible then
				local t = TweenService:Create(starterScale, TweenInfo.new(0.5, Enum.EasingStyle.Sine), { Scale = 1.06 })
				t:Play()
				t.Completed:Wait()
				TweenService:Create(starterScale, TweenInfo.new(0.5, Enum.EasingStyle.Sine), { Scale = 1 }):Play()
				task.wait(0.6)
			else
				task.wait(1)
			end
		end
	end)

	---------------------------------------------------------------------------
	-- Count-up and refresh
	---------------------------------------------------------------------------
	RunService.RenderStepped:Connect(function(dt: number)
		local a = math.min(1, dt * 9)
		for k, v in target do
			local cur = shown[k]
			if math.abs(v - cur) < 1 then
				shown[k] = v
			else
				shown[k] = cur + (v - cur) * a
			end
		end
		-- only touch the labels when the text really changes (no layout work on idle frames)
		local tapsText = Format.abbrev(shown.taps)
		if tapsText ~= tapsLabel.Text then
			tapsLabel.Text = tapsText
		end
		local gemsText = Format.abbrev(shown.gems)
		if gemsText ~= gemsLabel.Text then
			gemsLabel.Text = gemsText
		end
	end)

	-- Progressive HUD: a new player sees Rewards, TAP, Pets and the Store; the other buttons
	-- and auto chips appear (with a pop) as they are reached, and never hide again.
	local unlocked: { [string]: boolean } = {}
	local firstUnlock = true
	local function applyUnlocks(s: any)
		local vis = HudUnlock.visible(s)
		local anyChip = false
		for name, obj in unlockables do
			local show = vis[name] == true or unlocked[name] == true
			if show and not unlocked[name] then
				unlocked[name] = true
				if not firstUnlock then
					task.defer(function()
						Theme.pop(obj, 1.35)
					end)
					Theme.play("open", 0.35, 1.3)
				end
			end
			if obj.Visible ~= show then
				obj.Visible = show
			end
			if show and obj.Parent == autoGrid then
				anyChip = true
			end
		end
		autoGrid.Visible = anyChip
		firstUnlock = false
	end

	local lastTaps, lastGems = nil :: number?, nil :: number?
	local lastFull = 0
	local function refresh(kind: string?)
		local s = Net.state
		if not s then
			return
		end
		target.taps = s.taps
		target.gems = s.gems
		if lastGems and s.gems > lastGems then
			Theme.pop(gemsPill, 1.2)
		end
		if lastTaps and s.taps > lastTaps + (s.tapValue or 1) * 20 then
			Theme.pop(tapsPill, 1.12)
		end
		lastTaps, lastGems = s.taps, s.gems
		-- currency-only updates arrive several times a second: the rest is refreshed on full
		-- snapshots, and at most twice a second in between (objective progress, badges)
		local now = os.clock()
		if kind ~= "full" and now - lastFull < 0.5 then
			return
		end
		lastFull = now
		local perTapText = "+" .. Format.abbrev(math.max(1, s.tapValue or 1))
		if perTap.Text ~= perTapText then
			perTap.Text = perTapText
		end
		local rebirthText = Theme.lead(rebirthLabel, "🔁") .. Lang.t("rebirth.count", { n = s.rebirths }) .. "  ·  x" .. tostring(Formulas.rebirthMult(s.rebirths))
		if rebirthLabel.Text ~= rebirthText then
			rebirthLabel.Text = rebirthText
		end
		local petCount = 0
		for _ in s.pets do
			petCount += 1
		end
		petsCountText.Text = tostring(petCount)

		refreshChips()
		applyUnlocks(s)
		refreshObjective()
		friendLabel.Text = if (s.friends or 0) > 0 then Lang.t("hud.friend_boost", { pct = math.floor(Formulas.friendBoost(s.friends) * 100) }) else ""
		friendChip.Visible = friendLabel.Text ~= ""

		-- badges
		badges.Rebirth.Visible = s.taps >= s.rebirthCost
		local nextZone = Config.Zones[#s.zones + 1]
		badges.Teleport.Visible = nextZone ~= nil and s.taps >= nextZone.cost
		local indexReady = false
		for _, zone in Config.Zones do
			if not s.indexClaimed[tostring(zone.index)] then
				local all = true
				for _, pet in Config.Pets do
					if pet.zone == zone.index and not s.discovered[pet.id] then
						all = false
						break
					end
				end
				if all then
					indexReady = true
				end
			end
		end
		badges.Index.Visible = indexReady
		Hud.refreshQuestBadge()
	end

	function Hud.refreshQuestBadge()
		local s = Net.state
		local q = s and s.quests
		local ready = 0
		if q then
			local allClaimed = true
			for _, quest in q.list do
				if not quest.claimed then
					allClaimed = false
					if quest.progress >= quest.target then
						ready += 1
					end
				end
			end
			if allClaimed and not q.bonusClaimed and #q.list > 0 then
				ready += 1
			end
		end
		badges.Quests.Visible = ready > 0
		local bt = badgeText.Quests
		if bt then
			bt.Text = tostring(ready)
		end
	end

	Net.Changed:Connect(refresh)
	refresh("full")

	-- Timers (gifts, daily, luck, events, offers) once per second
	local function tick()
		local s = Net.state
		if not s then
			return
		end
		local since = os.clock() - Net.receivedAt
		local elapsed = s.sessionElapsed + since
		local claimed = {}
		for _, i in s.giftsClaimed do
			claimed[i] = true
		end
		local nextIn: number? = nil
		local ready = false
		for i, g in Config.Gifts do
			if not claimed[i] then
				local left = g.minutes * 60 - elapsed
				if left <= 0 then
					ready = true
				elseif not nextIn or left < nextIn then
					nextIn = left
				end
			end
		end
		local serverNow = s.serverTime + since
		local dailyReady = serverNow - s.daily.last >= Config.DailyCooldown
		badges.Rewards.Visible = ready or dailyReady
		giftButton.Visible = ready or nextIn ~= nil
		local giftLead = lead(giftButton, "🎁")
		Theme.setButton(giftButton, if ready then (giftLead .. Lang.t("hud.gift_ready")) elseif nextIn then (giftLead .. Format.time(nextIn)) else "", if ready then Theme.Pink else Theme.Purple)
		local luckLeft = math.max(0, (s.luckBoostLeft or 0) - since)
		luckLabel.Text = if luckLeft > 0 then Lang.t("hud.super_luck", { time = Format.time(luckLeft) }) else ""
		luckChip.Visible = luckLeft > 0
		local boostLeft = math.max(0, (s.tapBoostLeft or 0) - since)
		boostLabel.Text = if boostLeft > 0 then Lang.t("hud.tap_boost", { time = Format.time(boostLeft) }) else ""
		boostChip.Visible = boostLeft > 0

		-- live event
		local active = LiveEventClient.active()
		local ev = active[1]
		-- no event running: count down to the next scheduled one (the real UTC schedule)
		local evData = LiveEventClient.data
		local nextId: string? = if evData then evData.nextId else nil
		local nextLeft: number? = if evData and evData.nextAt then evData.nextAt - LiveEventClient.now() else nil
		eventPill.Visible = ev ~= nil or (nextId ~= nil and nextLeft ~= nil and nextLeft > 0)
		if ev then
			local c = EVENT_COLORS[ev.id] or Theme.Green
			eventGradient.Color = ColorSequence.new(Theme.lighten(c, 0.3), c)
			eventText.Text = Theme.lead(eventText, EVENT_ICONS[ev.id] or "✨") .. Lang.t("event." .. ev.id) .. " " .. Format.time(ev.endsAt - LiveEventClient.now())
		elseif nextId and nextLeft and nextLeft > 0 then
			eventGradient.Color = ColorSequence.new(Theme.lighten(Theme.Grey, 0.3), Theme.Grey)
			eventText.Text = Theme.lead(eventText, EVENT_ICONS[nextId] or "✨") .. Lang.t("event.next", { event = Lang.t("event." .. nextId), time = Format.time(nextLeft) })
		end

		-- starter pack
		local st = s.starter
		starterButton.Visible = st ~= nil and st.available and serverNow < st.endsAt
		if starterButton.Visible then
			Theme.setButton(starterButton, lead(starterButton, "🎉") .. Lang.t("starter.button") .. " " .. Format.time(st.endsAt - serverNow))
		end
		-- rewarded video boost
		adButton.Visible = boostLeft <= 0 and Ads.canShow("AdBoost")
		if adButton.Visible then
			Theme.setButton(adButton, lead(adButton, "📺") .. Lang.t("ads.boost_button", { n = Config.AdBoostMinutes }))
		end
		-- the beam follows the player, so re-aim it as they walk
		refreshObjective()
	end
	Lang.Changed:Connect(tick)
	LiveEventClient.Changed:Connect(function(data, started)
		tick()
		for _, id in started do
			Toasts.banner((EVENT_ICONS[id] or "✨") .. " " .. Lang.t("event.started", { event = Lang.t("event." .. id) }), EVENT_COLORS[id] or Theme.Green)
		end
	end)
	task.spawn(function()
		while true do
			tick()
			task.wait(1)
		end
	end)

	-- Reward popups (taps/gems given by rewards)
	Net.event("Reward").OnClientEvent:Connect(function(r)
		if r.kind == "taps" then
			Toasts.show(Lang.t("toast.got_taps", { n = Format.abbrev(r.amount) }), "success")
			Theme.pop(tapsPill, 1.25)
		elseif r.kind == "gems" then
			Toasts.show(Lang.t("toast.got_gems", { n = Format.abbrev(r.amount) }), "success")
		elseif r.kind == "luck" then
			Toasts.show(Lang.t("toast.got_luck", { n = r.amount }), "success")
		end
		Theme.play("buy", 0.4, 1.2)
	end)
end

-- Set by Popups (opens the Starter Pack offer card).
Hud.onStarterClick = function() end
Hud.refreshQuestBadge = function() end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">IndexWindow</string>
              <string name="Source"><![CDATA[--!strict
-- Index / collection book: % discovered overall and per zone, silhouettes for unknown
-- pets, and a claimable reward for completing each zone's page.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Palette = require(ReplicatedStorage.Shared.Palette)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)
local Windows = require(script.Parent.Windows)
local PetIcon = require(script.Parent.PetIcon)
local Toasts = require(script.Parent.Toasts)
local Net = require(script.Parent.Parent.Net)
local Lang = require(script.Parent.Parent.Lang)

local IndexWindow = {}

-- page 1..5 = zones, 6 = exclusive & secret
local function petsOnPage(page: number): { typeof(Config.Pets[1]) }
	local list = {}
	for _, p in Config.Pets do
		if (page <= #Config.Zones and p.zone == page) or (page > #Config.Zones and p.zone == 0) then
			table.insert(list, p)
		end
	end
	return list
end

function IndexWindow.init()
	local w = Windows.create("Index", "📖", "win.index", Theme.Blue, Vector2.new(820, 540), 450)
	local body = w.body
	local page = 1

	local tabs = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 56), Parent = body }, { Theme.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left) })
	local total = Theme.text({ Text = "", Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 60), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 24, Parent = body })
	-- scrolls: the rebirth-gated eggs put up to 21 pets on one page (Cosmic Void)
	local grid = Theme.new("ScrollingFrame", {
		BackgroundColor3 = Theme.PaperDark,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, -158),
		Position = UDim2.fromOffset(0, 92),
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.Ink,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = body,
	}, {
		Theme.corner(14),
		Theme.padding(10),
		Theme.new("UIGridLayout", { CellSize = UDim2.fromOffset(106, 120), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }),
	}) :: ScrollingFrame
	local claim = Theme.button({
		Text = "",
		Color = Theme.Green,
		Size = UDim2.fromOffset(460, 56),
		Position = UDim2.new(0.5, 0, 1, -2),
		AnchorPoint = Vector2.new(0.5, 1),
		TextSize = 24,
		Parent = body,
		OnClick = function()
			local ok, res = Net.request("ClaimIndex", { zone = page })
			Toasts.show(Lang.msg(res), if ok then "success" else "error")
		end,
	})

	local tabButtons: { TextButton } = {}
	local refresh: () -> ()
	local names = {}
	for _, z in Config.Zones do
		table.insert(names, "zone." .. z.id)
	end
	table.insert(names, "index.special")
	for i, key in names do
		tabButtons[i] = Theme.button({
			Key = key,
			Color = Theme.Grey,
			Size = UDim2.fromOffset(if Root.isTouch then 116 else 124, 56),
			LayoutOrder = i,
			TextSize = 18,
			Parent = tabs,
			OnClick = function()
				page = i
				refresh()
			end,
		})
	end

	local builtKey = ""
	refresh = function()
		local s = Net.state
		if not s then
			return
		end
		local discovered = s.discovered
		-- overall %
		local have, all = 0, 0
		for _, p in Config.Pets do
			if p.rarity ~= "Secret" then
				all += 1
				if discovered[p.id] then
					have += 1
				end
			end
		end
		total.Text = Lang.t("index.total", { have = have, all = all, pct = math.floor(have / all * 100), bonus = math.floor(Config.IndexTapBonus * 100) })
		for i, b in tabButtons do
			local zone = Config.Zones[i]
			Theme.setButton(b, nil, if i == page then (if zone then Palette.rgb(zone.ground) else Theme.Purple) else Theme.Grey)
		end
		-- rebuild grid only when page/discoveries change
		local list = petsOnPage(page)
		local keyParts = { tostring(page), Lang.code }
		for _, p in list do
			table.insert(keyParts, if discovered[p.id] then "1" else "0")
		end
		local key = table.concat(keyParts)
		if key ~= builtKey then
			builtKey = key
			for _, c in grid:GetChildren() do
				if c:IsA("Frame") then
					c:Destroy()
				end
			end
			for i, p in list do
				local known = discovered[p.id] == true
				local rc = if p.rarity == "Secret" then Color3.fromRGB(90, 50, 130) else Palette.rarity(p.rarity)
				local cell = Theme.new("Frame", { LayoutOrder = i, BackgroundColor3 = Color3.new(1, 1, 1), Parent = grid }, {
					Theme.corner(14),
					Theme.stroke(3),
					Theme.gradient(Theme.lighten(rc, 0.55), if known then Theme.darken(rc, 0.05) else Theme.Grey),
				})
				Theme.gloss(cell, 14, 0.7)
				local icon = PetIcon.new(p.id, 0, not known)
				icon.Size = UDim2.new(1, -6, 1, -32)
				icon.Position = UDim2.fromOffset(3, 1)
				icon.Parent = cell
				local plate = Theme.new("Frame", { Size = UDim2.new(1, -8, 0, 26), Position = UDim2.new(0, 4, 1, -30), BackgroundColor3 = Theme.Ink, BackgroundTransparency = 0.4, BorderSizePixel = 0, Parent = cell }, { Theme.corner(9) })
				Theme.text({ Text = if known then Lang.pet(p.id) else Lang.t("egg.unknown"), Size = UDim2.new(1, -6, 1, -2), Position = UDim2.fromOffset(3, 1), MaxTextSize = 18, Parent = plate })
			end
		end
		-- claim button
		if page <= #Config.Zones then
			claim.Visible = true
			local done = true
			for _, p in list do
				if not discovered[p.id] then
					done = false
				end
			end
			if s.indexClaimed[tostring(page)] then
				Theme.setButton(claim, "✓ " .. Lang.t("index.claimed"), Theme.Grey)
			elseif done then
				Theme.setButton(claim, Lang.t("index.claim", { gems = Config.IndexRewardGems[page] or 0, bonus = math.floor(Config.IndexTapBonus * 100) }), Theme.Green)
			else
				Theme.setButton(claim, Lang.t("index.find", { gems = Config.IndexRewardGems[page] or 0, bonus = math.floor(Config.IndexTapBonus * 100) }), Theme.Grey)
			end
		else
			claim.Visible = false
		end
	end
	w.onOpen = refresh
	Net.Changed:Connect(function(kind)
		if kind == "full" and Windows.isOpen("Index") then
			refresh()
		end
	end)
end

return IndexWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">InviteWindow</string>
              <string name="Source"><![CDATA[--!strict
-- Invite friends (game invite + share link, both carry "ref:<userId>" launch data) and the
-- one-time group-join gift.
local GroupService = game:GetService("GroupService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")

local Config = require(ReplicatedStorage.Shared.Config)
local Referral = require(ReplicatedStorage.Shared.Referral)
local Theme = require(script.Parent.Theme)
local Windows = require(script.Parent.Windows)
local Toasts = require(script.Parent.Toasts)
local Net = require(script.Parent.Parent.Net)
local Lang = require(script.Parent.Parent.Lang)

local InviteWindow = {}

local player = Players.LocalPlayer

local function inviteFriends()
	local ok, can = pcall(function()
		return SocialService:CanSendGameInviteAsync(player)
	end)
	if not ok or not can then
		Toasts.show(Lang.t("invite.unavailable"), "error")
		return
	end
	local shown = pcall(function()
		local options = Instance.new("ExperienceInviteOptions")
		options.LaunchData = Referral.launchData(player.UserId)
		options.PromptMessage = Lang.t("invite.prompt", { gems = Config.ReferralInviteeGift.amount })
		SocialService:PromptGameInvite(player, options)
	end)
	if not shown then
		Toasts.show(Lang.t("invite.unavailable"), "error")
	end
end

function InviteWindow.init()
	local w = Windows.create("Invite", "💌", "win.invite", Theme.Pink, Vector2.new(600, 470))
	local body = w.body
	Theme.text({ Key = "invite.desc", Args = { gems = Config.ReferralInviteeGift.amount }, TextWrapped = true, Size = UDim2.new(1, -20, 0, 84), Position = UDim2.fromOffset(10, 0), TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 24, Parent = body })
	local count = Theme.text({ Text = "", Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 88), TextColor3 = Theme.Grey, Stroke = false, MaxTextSize = 20, Parent = body })
	local row = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 64), Position = UDim2.fromOffset(0, 124), Parent = body }, {
		Theme.list(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center),
	})
	Theme.button({ Text = "", Key = "invite.button", Color = Theme.Green, Size = UDim2.fromOffset(250, 62), LayoutOrder = 1, TextSize = 26, Parent = row, OnClick = inviteFriends })
	Theme.button({
		Key = "invite.share",
		Color = Theme.Blue,
		Size = UDim2.fromOffset(250, 62),
		LayoutOrder = 2,
		TextSize = 26,
		Parent = row,
		OnClick = function()
			local ok, err = Net.request("ShareLink")
			if not ok then
				Toasts.show(Lang.msg(err), "error")
			end
		end,
	})

	-- group gift
	local group = Theme.panel({ Size = UDim2.new(1, -20, 0, 150), Position = UDim2.fromOffset(10, 204), BackgroundColor3 = Color3.new(1, 1, 1), Visible = false, Parent = body })
	Theme.text({ Text = "🐶", Stroke = false, Size = UDim2.fromOffset(64, 64), Position = UDim2.fromOffset(14, 14), Parent = group })
	Theme.text({ Key = "group.desc", Args = { pet = { key = "pet." .. Config.GroupGiftPet } }, TextWrapped = true, Size = UDim2.new(1, -100, 0, 64), Position = UDim2.fromOffset(88, 14), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 22, Parent = group })
	Theme.button({
		Key = "group.join",
		Color = Theme.Purple,
		Size = UDim2.fromOffset(260, 56),
		Position = UDim2.new(0.5, 0, 1, -10),
		AnchorPoint = Vector2.new(0.5, 1),
		TextSize = 24,
		Parent = group,
		OnClick = function()
			pcall(function()
				(GroupService :: any):PromptJoinAsync(Config.GroupId)
			end)
			local ok, res = Net.request("ClaimGroupGift")
			Toasts.show(Lang.msg(res), if ok then "success" else "error")
		end,
	})

	local function refresh()
		local s = Net.state
		local social = s and s.social
		count.Text = Lang.t("invite.count", { n = if social then social.referralRewards else 0, max = Config.ReferralLifetimeCap })
		group.Visible = Config.GroupId ~= 0 and social ~= nil and not social.groupGiftClaimed
	end
	w.onOpen = refresh
	Net.Changed:Connect(function(kind)
		if kind == "full" and Windows.isOpen("Invite") then
			refresh()
		end
	end)
end

return InviteWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">PetIcon</string>
              <string name="Source"><![CDATA[--!strict
-- ViewportFrame thumbnails of procedural pets (inventory, index, egg odds, hatch reveal).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PetModel = require(ReplicatedStorage.Shared.PetModel)

local PetIcon = {}

-- Points the viewport camera at the model's bounding box from the front (the pet faces -Z).
-- fill: 1 = the bounding sphere just fits; bigger values zoom out.
function PetIcon.frame(cam: Camera, model: Model, fill: number?)
	local cf, size = model:GetBoundingBox()
	local radius = size.Magnitude * 0.5
	local dist = radius / math.tan(math.rad(cam.FieldOfView / 2)) * (fill or 0.84)
	local center = cf.Position
	cam.CFrame = CFrame.lookAt(center + Vector3.new(0, radius * 0.22, -dist), center)
end

-- silhouette = true renders the pet as a black shape (undiscovered in the index).
function PetIcon.new(petId: string, tier: number?, silhouette: boolean?, yaw: number?): ViewportFrame
	local vp = Instance.new("ViewportFrame")
	vp.BackgroundTransparency = 1
	vp.Size = UDim2.fromScale(1, 1)
	vp.Ambient = Color3.fromRGB(190, 190, 205)
	vp.LightColor = Color3.fromRGB(255, 255, 255)
	vp.LightDirection = Vector3.new(-1, -2, 1.5)
	if silhouette then
		vp.ImageColor3 = Color3.new(0, 0, 0)
	end
	local model = PetModel.build(petId, tier or 0, { lite = true })
	model:PivotTo(CFrame.Angles(0, math.rad(yaw or 28), 0))
	model.Parent = vp
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	PetIcon.frame(cam, model)
	cam.Parent = vp
	vp.CurrentCamera = cam
	return vp
end

return PetIcon
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">PetsWindow</string>
              <string name="Source"><![CDATA[--!strict
-- Pets inventory: grid with rarity frames + power, detail panel (equip, lock, craft,
-- delete), Equip Best and multi-delete mode.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Palette = require(ReplicatedStorage.Shared.Palette)
local Theme = require(script.Parent.Theme)
local Windows = require(script.Parent.Windows)
local PetIcon = require(script.Parent.PetIcon)
local Toasts = require(script.Parent.Toasts)
local Net = require(script.Parent.Parent.Net)
local Lang = require(script.Parent.Parent.Lang)

local PetsWindow = {}
PetsWindow.selectFirst = function() end
-- icons alive, cells total (virtualization check in the playtest)
PetsWindow.iconCount = function(): (number, number)
	return 0, 0
end

type Cell = { button: TextButton, trait: Frame, traitText: TextLabel, key: string, power: TextLabel, equipped: Frame, lock: TextLabel, check: Frame, stroke: UIStroke, ring: Frame, petId: string, tier: number, icon: ViewportFrame? }

local SECRET = Color3.fromRGB(190, 90, 255)

function PetsWindow.init()
	local w = Windows.create("Pets", "🐾", "win.pets", Theme.Orange, Vector2.new(820, 520))
	local body = w.body

	local top = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 54), Parent = body })
	-- "+" next to the caps: more equip slots are an upgrade away
	Theme.button({
		Name = "MoreSlots",
		Text = "+",
		Color = Theme.Green,
		Size = UDim2.fromOffset(56, 56),
		Position = UDim2.new(1, -398, 0, -1),
		Corner = 28,
		TextSize = 30,
		Parent = top,
		OnClick = function()
			Windows.open("Upgrades")
		end,
	})
	local countLabel = Theme.text({ Text = "", Size = UDim2.new(1, -410, 1, -8), Position = UDim2.fromOffset(0, 4), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 26, Parent = top })
	local deleteMode = false
	local selected: { [string]: boolean } = {}
	local selectedUid: string? = nil

	local refresh: () -> ()

	Theme.button({
		Key = "pets.equip_best",
		Color = Theme.Green,
		Size = UDim2.fromOffset(160, 56),
		Position = UDim2.new(1, -340, 0, -1),
		TextSize = 26,
		Parent = top,
		OnClick = function()
			Net.request("EquipBest")
		end,
	})
	local deleteButton: TextButton
	deleteButton = Theme.button({
		Key = "pets.delete_mode",
		Color = Theme.Red,
		Size = UDim2.fromOffset(170, 56),
		TextSize = 26,
		Position = UDim2.new(1, -170, 0, -1),
		Parent = top,
		OnClick = function()
			if deleteMode then
				local uids = {}
				for uid in selected do
					table.insert(uids, uid)
				end
				if #uids > 0 then
					local ok, res = Net.request("Delete", { uids = uids })
					Toasts.show(if ok then (if res == 1 then Lang.t("toast.deleted1") else Lang.t("toast.deleted", { n = res })) else Lang.msg(res), if ok then "success" else "error")
				end
				deleteMode = false
				table.clear(selected)
			else
				deleteMode = true
				selectedUid = nil
			end
			refresh()
		end,
	})

	-- Grid
	local grid = Theme.new("ScrollingFrame", {
		Size = UDim2.new(1, -280, 1, -64),
		Position = UDim2.fromOffset(0, 64),
		BackgroundColor3 = Theme.PaperDark,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.Ink,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = body,
	}, {
		Theme.corner(14),
		Theme.padding(10),
		Theme.new("UIGridLayout", { CellSize = UDim2.fromOffset(100, 112), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	}) :: ScrollingFrame

	-- Detail panel
	local detail = Theme.panel({ Size = UDim2.new(0, 266, 1, -64), Position = UDim2.new(1, -266, 0, 64), BackgroundColor3 = Color3.fromRGB(255, 255, 255), Parent = body })
	-- stage: rarity-coloured backdrop with turning rays behind a slowly spinning pet
	local stage = Theme.new("Frame", { Name = "Stage", Size = UDim2.new(1, -16, 0, 112), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = Color3.new(1, 1, 1), ClipsDescendants = true, Parent = detail }, { Theme.corner(12), Theme.stroke(3) })
	local stageGradient = Theme.gradient(Theme.lighten(Theme.Grey, 0.55), Theme.lighten(Theme.Grey, 0.2))
	stageGradient.Parent = stage
	local stageRays = Theme.new("Frame", { Size = UDim2.fromOffset(340, 340), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Parent = stage })
	for k = 0, 5 do
		Theme.new("Frame", { Size = UDim2.new(0, 30, 1, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Rotation = k * 30, BackgroundColor3 = Theme.White, BackgroundTransparency = 0.72, BorderSizePixel = 0, Parent = stageRays })
	end
	TweenService:Create(stageRays, TweenInfo.new(16, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), { Rotation = 360 }):Play()
	local detailIcon = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(150, 108), Position = UDim2.new(0.5, 0, 0, 3), AnchorPoint = Vector2.new(0.5, 0), ZIndex = 2, Parent = stage })
	local emptyIcon = Theme.text({ Text = "🐾", Stroke = false, Size = UDim2.fromOffset(84, 84), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), TextTransparency = 0.45, ZIndex = 2, Parent = stage })
	local detailName = Theme.text({ Key = "pets.select", Size = UDim2.new(1, -16, 0, 32), Position = UDim2.fromOffset(8, 122), TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 26, Parent = detail })
	local ribbon = Theme.new("Frame", { Size = UDim2.new(1, -60, 0, 26), Position = UDim2.fromOffset(30, 154), BackgroundColor3 = Color3.new(1, 1, 1), Visible = false, Parent = detail }, { Theme.corner(14), Theme.stroke(2) })
	local ribbonGradient = Theme.gradient(Theme.White, Theme.Grey)
	ribbonGradient.Parent = ribbon
	local detailRarity = Theme.text({ Text = "", Size = UDim2.new(1, -12, 1, -4), Position = UDim2.fromOffset(6, 2), MaxTextSize = 20, Parent = ribbon })
	local detailPower = Theme.text({ Text = "", Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(8, 181), TextColor3 = Theme.Orange, MaxTextSize = 22, Parent = detail })
	-- trait: grade + bonus, and the roll odds (numeric %, shown before rolling)
	local detailTrait = Theme.text({ Name = "Trait", Text = "", Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 205), MaxTextSize = 20, Parent = detail })
	local detailOdds = Theme.text({ Name = "TraitOdds", Text = "", Size = UDim2.new(1, -12, 0, 18), Position = UDim2.fromOffset(6, 227), TextColor3 = Theme.Grey, Stroke = false, MaxTextSize = 14, Visible = false, Parent = detail })
	detailOdds.AutoLocalize = false
	do
		local parts = {}
		for _, g in Config.TraitGrades do
			table.insert(parts, g.name .. " " .. Format.chance(g.chance))
		end
		detailOdds.Text = table.concat(parts, "  ")
	end
	local buttons = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -20, 0, 122), Position = UDim2.new(0, 10, 1, -130), Parent = detail }, {
		Theme.new("UIGridLayout", { CellSize = UDim2.new(0.5, -5, 0, 56), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local equipB = Theme.button({ Key = "pets.equip", Color = Theme.Green, LayoutOrder = 1, Parent = buttons, TextSize = 24 })
	local lockB = Theme.button({ Key = "pets.lock", Color = Theme.Blue, LayoutOrder = 2, Parent = buttons, TextSize = 24 })
	local craftB = Theme.button({ Text = "", Color = Theme.Yellow, LayoutOrder = 3, Parent = buttons, TextSize = 22 })
	-- (single deletes go through Delete Mode; this slot rolls a trait)
	local traitB = Theme.button({ Name = "RollTrait", Text = "", Color = Theme.Purple, LayoutOrder = 4, Parent = buttons, TextSize = 22 })

	local function act(action: string, payload: { [string]: any })
		local ok, res = Net.request(action, payload)
		if not ok and res then
			Toasts.show(Lang.msg(res), "error")
		end
		return ok, res
	end
	equipB.Activated:Connect(function()
		if not selectedUid then
			return
		end
		local eq = Net.get("equipped") or {}
		act(if table.find(eq, selectedUid) then "Unequip" else "Equip", { uid = selectedUid })
	end)
	lockB.Activated:Connect(function()
		local pets = Net.get("pets")
		if selectedUid and pets and pets[selectedUid] then
			act("Lock", { uid = selectedUid, locked = not pets[selectedUid].locked })
		end
	end)
	craftB.Activated:Connect(function()
		if selectedUid then
			local ok, newUid = act("Craft", { uid = selectedUid })
			if ok then
				selectedUid = newUid
			end
		end
	end)
	traitB.Activated:Connect(function()
		if selectedUid then
			local ok, grade = act("RollTrait", { uid = selectedUid })
			local g = if ok and type(grade) == "number" then Config.TraitGrades[grade] else nil
			if g then
				Toasts.show(Lang.t("pets.trait_rolled", { grade = g.name, pct = math.floor((g.mult - 1) * 100 + 0.5) }), "success")
				Theme.pop(detailTrait, 1.5)
				Theme.play("buy", 0.45, 0.9 + grade * 0.12)
			end
		end
	end)

	local cells: { [string]: Cell } = {}
	local iconKey = ""

	local function maxZone(): number
		return #(Net.get("zones") or { 1 })
	end

	local function makeCell(uid: string, pet: { id: string, tier: number, locked: boolean }): Cell
		local def = Formulas.PetById[pet.id]
		local rc = if def.rarity == "Secret" then Color3.fromRGB(60, 40, 80) else Palette.rarity(def.rarity)
		local stroke = Theme.stroke(3)
		local b = Theme.new("TextButton", {
			Name = uid,
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Color3.new(1, 1, 1),
		}, { Theme.corner(14), stroke, Theme.gradient(Theme.lighten(rc, 0.55), Theme.darken(rc, 0.05)) }) :: TextButton
		Theme.gloss(b, 14, 0.7)
		-- the 3D icon is created lazily, only while the cell is on screen (see updateIcons)
		-- dark plate so the power reads on any rarity colour
		local plate = Theme.new("Frame", { Size = UDim2.new(1, -8, 0, 24), Position = UDim2.new(0, 4, 1, -28), BackgroundColor3 = Theme.Ink, BackgroundTransparency = 0.4, BorderSizePixel = 0, Parent = b }, { Theme.corner(9) })
		local power = Theme.text({ Text = "", Size = UDim2.new(1, -6, 1, -2), Position = UDim2.fromOffset(3, 1), MaxTextSize = 19, Parent = plate })
		power.AutoLocalize = false
		local ring = Theme.new("Frame", { Name = "Selected", Size = UDim2.new(1, -6, 1, -6), Position = UDim2.fromOffset(3, 3), BackgroundTransparency = 1, Visible = false, Parent = b }, { Theme.corner(11), Theme.new("UIStroke", { Thickness = 3, Color = Theme.White }) })
		local hover = Theme.new("UIScale", { Parent = b })
		b.MouseEnter:Connect(function()
			TweenService:Create(hover, TweenInfo.new(0.1), { Scale = 1.05 }):Play()
		end)
		b.MouseLeave:Connect(function()
			TweenService:Create(hover, TweenInfo.new(0.12), { Scale = 1 }):Play()
		end)
		local equipped = Theme.new("Frame", { Size = UDim2.fromOffset(26, 26), Position = UDim2.fromOffset(-6, -6), BackgroundColor3 = Theme.Green, Visible = false, Parent = b }, { Theme.corner(13), Theme.stroke(2) })
		Theme.text({ Text = "✓", Parent = equipped })
		local lock = Theme.text({ Text = "🔒", Stroke = false, Size = UDim2.fromOffset(24, 24), Position = UDim2.new(1, -24, 0, 2), Visible = false, Parent = b })
		local check = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Red, BackgroundTransparency = 0.45, Visible = false, Parent = b }, { Theme.corner(14) })
		Theme.text({ Text = "✕", Size = UDim2.fromScale(0.6, 0.6), Position = UDim2.fromScale(0.2, 0.2), Parent = check })
		if pet.tier > 0 then
			Theme.text({ Text = if pet.tier == 1 then "★" else "🌈", Stroke = pet.tier == 1, TextColor3 = Palette.Gold, Size = UDim2.fromOffset(26, 26), Position = UDim2.new(1, -26, 1, -52), Parent = b })
		end
		b.Activated:Connect(function()
			Theme.play("click", 0.3)
			if deleteMode then
				local p = (Net.get("pets") or {})[uid]
				if p and p.locked then
					Toasts.show(Lang.t("toast.pet_locked"), "error")
					return
				end
				if selected[uid] then
					selected[uid] = nil
				else
					selected[uid] = true
				end
			else
				selectedUid = uid
			end
			refresh()
		end)
		b.Parent = grid
		-- trait grade badge (top-left, under the equipped tick)
		local traitBadge = Theme.new("Frame", { Name = "TraitBadge", Size = UDim2.fromOffset(24, 24), Position = UDim2.new(0, 3, 1, -54), BackgroundColor3 = Theme.Grey, Visible = false, Parent = b }, { Theme.corner(8), Theme.stroke(2) }) :: Frame
		local traitText = Theme.text({ Text = "", Size = UDim2.new(1, -4, 1, -2), Position = UDim2.fromOffset(2, 1), MaxTextSize = 18, Parent = traitBadge })
		traitText.AutoLocalize = false
		return { button = b, trait = traitBadge, traitText = traitText, key = pet.id .. ":" .. pet.tier, power = power, equipped = equipped, lock = lock, check = check, stroke = stroke, ring = ring, petId = pet.id, tier = pet.tier, icon = nil }
	end

	-- Virtualized grid: a full inventory is 150 pets, and every icon is a ViewportFrame with
	-- ~40 parts. Only the cells inside the scrolling window (plus one row) keep their icon.
	local function updateIcons()
		if not Windows.isOpen("Pets") then
			return -- closing: the icons were dropped on purpose
		end
		local top = grid.AbsolutePosition.Y
		local bottom = top + grid.AbsoluteSize.Y
		local margin = 130
		for _, c in cells do
			local y = c.button.AbsolutePosition.Y
			local visible = y + c.button.AbsoluteSize.Y > top - margin and y < bottom + margin
			if visible and not c.icon then
				local icon = PetIcon.new(c.petId, c.tier)
				icon.Size = UDim2.new(1, -6, 1, -28)
				icon.Position = UDim2.fromOffset(3, 1)
				icon.Parent = c.button
				c.icon = icon
			elseif not visible and c.icon then
				c.icon:Destroy()
				c.icon = nil
			end
		end
	end
	PetsWindow.iconCount = function(): (number, number)
		local icons, total = 0, 0
		for _, c in cells do
			total += 1
			if c.icon then
				icons += 1
			end
		end
		return icons, total
	end
	grid:GetPropertyChangedSignal("CanvasPosition"):Connect(updateIcons)
	grid:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateIcons)
	local gridLayout = grid:FindFirstChildOfClass("UIGridLayout")
	if gridLayout then
		gridLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateIcons)
	end

	refresh = function()
		if not Windows.isOpen("Pets") then
			return
		end
		local s = Net.state
		if not s then
			return
		end
		local pets = s.pets
		local eqSet: { [string]: boolean } = {}
		for _, uid in s.equipped do
			eqSet[uid] = true
		end
		local n = 0
		local uids = {}
		for uid, pet in pets do
			n += 1
			table.insert(uids, uid)
			local c = cells[uid]
			if c and c.key ~= pet.id .. ":" .. pet.tier then
				c.button:Destroy()
				cells[uid] = nil
			end
		end
		for uid, c in cells do
			if not pets[uid] then
				c.button:Destroy()
				cells[uid] = nil
				selected[uid] = nil
			end
		end
		local mz = maxZone()
		table.sort(uids, function(a, b)
			local ea, eb = eqSet[a] == true, eqSet[b] == true
			if ea ~= eb then
				return ea
			end
			local pa = Formulas.petPower(pets[a].id, pets[a].tier, mz, pets[a].trait)
			local pb = Formulas.petPower(pets[b].id, pets[b].tier, mz, pets[b].trait)
			if pa ~= pb then
				return pa > pb
			end
			return a < b
		end)
		for i, uid in uids do
			local pet = pets[uid]
			local c = cells[uid] or makeCell(uid, pet)
			cells[uid] = c
			c.button.LayoutOrder = i
			c.power.Text = "+" .. Format.abbrev(Formulas.petPower(pet.id, pet.tier, mz, pet.trait))
			local tg = if pet.trait then Config.TraitGrades[pet.trait] else nil
			c.trait.Visible = tg ~= nil
			if tg then
				c.traitText.Text = tg.name
				c.trait.BackgroundColor3 = Palette.rgb(tg.color)
			end
			c.equipped.Visible = eqSet[uid] == true
			c.stroke.Color = if eqSet[uid] then Theme.darken(Theme.Green, 0.35) else Theme.Ink
			c.stroke.Thickness = if eqSet[uid] then 4 else 3
			c.ring.Visible = not deleteMode and uid == selectedUid
			c.lock.Visible = pet.locked
			c.check.Visible = deleteMode and selected[uid] == true
		end
		countLabel.Text = Lang.t("pets.count", { n = n, max = s.maxInventory, eq = #s.equipped, maxEq = s.maxEquip })
		-- once the grid layout has placed the cells (new cells sit at 0,0 until then)
		task.delay(0.05, function()
			if Windows.isOpen("Pets") then
				updateIcons()
			end
		end)
		local selCount = 0
		for _ in selected do
			selCount += 1
		end
		Theme.setButton(deleteButton, if deleteMode then (if selCount > 0 then Lang.t("pets.delete_n", { n = selCount }) else Lang.t("pets.cancel")) else Lang.t("pets.delete_mode"), if deleteMode then Theme.Orange else Theme.Red)

		-- detail
		local sel = if selectedUid then pets[selectedUid] else nil
		buttons.Visible = sel ~= nil
		emptyIcon.Visible = sel == nil
		ribbon.Visible = sel ~= nil
		local key = if sel and selectedUid then (selectedUid .. sel.id .. sel.tier) else ""
		if key ~= iconKey then
			iconKey = key
			detailIcon:ClearAllChildren()
			if sel then
				PetIcon.new(sel.id, sel.tier, false, 0).Parent = detailIcon
			end
		end
		if sel and selectedUid then
			local def = Formulas.PetById[sel.id]
			Lang.unbind(detailName)
			detailName.Text = Lang.pet(def.id, sel.tier)
			local rc = if def.rarity == "Secret" then SECRET else Palette.rarity(def.rarity)
			detailRarity.Text = Lang.upper(Lang.rarity(def.rarity))
			ribbonGradient.Color = ColorSequence.new(Theme.lighten(rc, 0.3), Theme.darken(rc, 0.08))
			stageGradient.Color = ColorSequence.new(Theme.lighten(rc, 0.6), Theme.lighten(rc, 0.12))
			detailPower.Text = Lang.t("pets.power", { n = Format.abbrev(Formulas.petPower(sel.id, sel.tier, mz, sel.trait)) })
			local tg = if sel.trait then Config.TraitGrades[sel.trait] else nil
			detailTrait.Text = if tg then Lang.t("pets.trait", { grade = tg.name, pct = math.floor((tg.mult - 1) * 100 + 0.5) }) else Lang.t("pets.no_trait")
			detailTrait.TextColor3 = if tg then Palette.rgb(tg.color) else Theme.Grey
			detailOdds.Visible = true
			Theme.setButton(traitB, "🎲 " .. Lang.t("pets.roll", { n = s.dice or 0 }), if (s.dice or 0) >= Config.TraitRollCost then Theme.Purple else Theme.Grey)
			Theme.setButton(equipB, Lang.t(if eqSet[selectedUid] then "pets.unequip" else "pets.equip"), if eqSet[selectedUid] then Theme.Grey else Theme.Green)
			Theme.setButton(lockB, Lang.t(if sel.locked then "pets.unlock" else "pets.lock"))
			local same = 0
			for _, p in pets do
				if p.id == sel.id and p.tier == sel.tier and not p.locked then
					same += 1
				end
			end
			if sel.locked then
				same += 1
			end
			craftB.Visible = sel.tier < 2
			Theme.setButton(craftB, Lang.t(if sel.tier == 0 then "pets.craft_gold" else "pets.craft_rainbow", { have = math.min(same, Config.CraftCost), need = Config.CraftCost }), if same >= Config.CraftCost then Theme.Yellow else Theme.Grey)
		else
			Lang.unbind(detailName)
			detailName.Text = Lang.t(if deleteMode then "pets.select_delete" else "pets.select")
			detailRarity.Text = ""
			detailPower.Text = ""
			detailTrait.Text = ""
			detailOdds.Visible = false
			stageGradient.Color = ColorSequence.new(Theme.lighten(Theme.Grey, 0.55), Theme.lighten(Theme.Grey, 0.2))
		end
	end

	-- Selects the strongest equipped pet (screenshot showcase / tests).
	PetsWindow.selectFirst = function()
		local s = Net.state
		if s and s.equipped[1] then
			selectedUid = s.equipped[1]
			refresh()
		end
	end
	w.onOpen = refresh
	w.onClose = function()
		deleteMode = false
		table.clear(selected)
		-- closed: drop every icon (they come back for the visible rows on the next open)
		for _, c in cells do
			if c.icon then
				c.icon:Destroy()
				c.icon = nil
			end
		end
	end
	-- the selected pet turns slowly on its stage
	RunService.RenderStepped:Connect(function()
		if not Windows.isOpen("Pets") then
			return
		end
		local vp = detailIcon:FindFirstChildOfClass("ViewportFrame")
		local model = vp and vp:FindFirstChildOfClass("Model")
		if model then
			model:PivotTo(CFrame.Angles(0, os.clock() * 0.9, 0))
		end
	end)
	Net.Changed:Connect(function(kind)
		if kind == "full" then
			refresh()
		end
	end)
end

return PetsWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">Popups</string>
              <string name="Source"><![CDATA[--!strict
-- One-at-a-time centered cards: offline earnings, Starter Pack offer, notification opt-in.
local ExperienceNotificationService = game:GetService("ExperienceNotificationService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)
local Toasts = require(script.Parent.Toasts)
local Hud = require(script.Parent.Hud)
local Net = require(script.Parent.Parent.Net)
local Lang = require(script.Parent.Parent.Lang)
local Purchase = require(script.Parent.Parent.Purchase)
local Ads = require(script.Parent.Parent.Ads)

local Popups = {}

type ButtonSpec = { text: string, color: Color3, onClick: () -> () }
type Card = { frame: Frame, holder: Frame, close: () -> () }

local current: Card? = nil

-- A centered card with an icon, title, rich body text and up to 2 buttons. odds: a line of
-- numeric odds shown on a plate above the buttons (offers that contain a random item).
function Popups.card(icon: string, title: string, body: string, buttons: { ButtonSpec }, extra: ((Frame) -> ())?, odds: string?): Card
	if current then
		current.close()
	end
	local frame = Theme.panel({
		Name = "Popup",
		Size = UDim2.fromOffset(520, 320),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 60,
		Corner = 24,
		StrokeThickness = 4,
		Parent = Root.gui,
	})
	local holder = Root.mount(frame)
	holder.ZIndex = 60
	Theme.shadow(frame, 24)
	Theme.pop(frame, 0.7)
	local card: Card
	local function close()
		if current == card then
			current = nil
		end
		holder:Destroy()
	end
	card = { frame = frame, holder = holder, close = close }
	current = card
	Theme.icon(icon, { Size = UDim2.fromOffset(64, 64), Position = UDim2.new(0.5, 0, 0, 8), AnchorPoint = Vector2.new(0.5, 0), ZIndex = 61, Parent = frame })
	Theme.text({ Text = title, Size = UDim2.new(1, -40, 0, 40), Position = UDim2.fromOffset(20, 74), TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 34, ZIndex = 61, Parent = frame })
	Theme.text({ Text = body, RichText = true, TextWrapped = true, Size = UDim2.new(1, -48, 0, if odds then 58 else 96), Position = UDim2.fromOffset(24, 118), TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 24, ZIndex = 61, Parent = frame })
	if odds then
		local plate = Theme.new("Frame", { Name = "OddsPlate", Size = UDim2.new(1, -48, 0, 50), Position = UDim2.fromOffset(24, 180), BackgroundColor3 = Theme.PaperDark, ZIndex = 61, Parent = frame }, { Theme.corner(10), Theme.stroke(2, Theme.lighten(Theme.Ink, 0.5)) })
		local t = Theme.text({ Name = "Odds", Text = odds, TextWrapped = true, Size = UDim2.new(1, -12, 1, -6), Position = UDim2.fromOffset(6, 3), TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 17, Parent = plate })
		t.ZIndex = 62
		t.AutoLocalize = false
	end
	local row = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -32, 0, 64), Position = UDim2.new(0, 16, 1, -80), ZIndex = 61, Parent = frame }, {
		Theme.list(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center),
	})
	for i, spec in buttons do
		local b = Theme.button({
			Text = spec.text,
			Color = spec.color,
			Size = UDim2.fromOffset(if #buttons > 1 then 220 else 280, 60),
			LayoutOrder = i,
			TextSize = 26,
			Parent = row,
			OnClick = function()
				spec.onClick()
			end,
		})
		for _, d in b:GetDescendants() do
			if d:IsA("GuiObject") then
				d.ZIndex = 62
			end
		end
		b.ZIndex = 62
	end
	local x = Theme.button({ Text = "X", Color = Theme.Red, Size = UDim2.fromOffset(54, 54), Position = UDim2.new(1, 14, 0, -14), AnchorPoint = Vector2.new(1, 0), Corner = 27, Parent = frame, OnClick = close })
	x.ZIndex = 63
	for _, d in x:GetDescendants() do
		if d:IsA("GuiObject") then
			d.ZIndex = 64
		end
	end
	if extra then
		extra(frame)
	end
	Theme.pop(frame, 0.7)
	return card
end

---------------------------------------------------------------------------
-- Offline earnings
---------------------------------------------------------------------------
local offlineShownFor = 0
local function showOffline()
	local s = Net.state
	local o = s and s.offline
	if not o or o.pending <= 0 or o.pending == offlineShownFor then
		return
	end
	offlineShownFor = o.pending
	local buttons: { ButtonSpec } = {
		{
			text = Lang.t("offline.claim"),
			color = Theme.Green,
			onClick = function()
				local ok, res = Net.request("ClaimOffline")
				Toasts.show(Lang.msg(res), if ok then "success" else "error")
				if current then
					current.close()
				end
			end,
		},
	}
	if Ads.canShow("AdOffline") then
		table.insert(buttons, {
			text = "📺 " .. Lang.t("ads.offline_button"),
			color = Theme.Orange,
			onClick = function()
				Ads.watch("AdOffline")
				if current then
					current.close()
				end
			end,
		})
	end
	Popups.card("💤", Lang.t("offline.title"), Lang.t("offline.body", { time = Format.time(o.seconds), n = "<b>" .. Format.abbrev(o.pending) .. "</b>" }), buttons)
end

---------------------------------------------------------------------------
-- Starter Pack (first 24 h): popup after the 3rd hatch of the session, then a HUD button
---------------------------------------------------------------------------
local function showStarter()
	local s = Net.state
	local st = s and s.starter
	if not s or not st or not st.available then
		return
	end
	local pct = math.floor((1 - st.price / st.fullPrice) * 100 + 0.5)
	local body = string.format(
		"%s\n<s>R$ %d</s>  <b>R$ %d</b>  ·  %s",
		Lang.t("starter.body", { gems = Config.StarterPack.gems, min = Config.StarterPack.luckMinutes }),
		st.fullPrice,
		st.price,
		Lang.t("starter.ends", { time = Format.time(st.endsAt - (s.serverTime + os.clock() - Net.receivedAt)) })
	)
	Popups.card("🎉", Lang.t("starter.title"), body, {
		{
			text = Lang.t("starter.buy") .. "  R$" .. st.price,
			color = Theme.Green,
			onClick = function()
				Purchase.product("StarterPack")
			end,
		},
	}, function(frame)
		local tag = Theme.new("Frame", { Size = UDim2.fromOffset(96, 44), Position = UDim2.fromOffset(-12, 16), Rotation = -10, BackgroundColor3 = Theme.Red, ZIndex = 63, Parent = frame }, { Theme.corner(12), Theme.stroke(3) })
		local t = Theme.text({ Text = Lang.t("starter.discount", { pct = pct }), ZIndex = 64, Parent = tag })
		t.ZIndex = 64
	end, Purchase.oddsText("StarterPack"))
end

function Popups.init()
	Hud.onStarterClick = showStarter

	local sessionStartHatched: number? = nil
	local starterShown = false
	Net.Changed:Connect(function(kind)
		if kind ~= "full" then
			return
		end
		local s = Net.state
		if not s then
			return
		end
		showOffline()
		sessionStartHatched = sessionStartHatched or s.totalHatched
		if not starterShown and s.starter and s.starter.available and s.totalHatched - (sessionStartHatched :: number) >= Config.StarterPack.popupAfterHatches then
			starterShown = true
			task.delay(4, showStarter) -- after the hatch cinematic
		end
	end)

	-- Notification opt-in, asked by the server after a big moment (first Legendary / rebirth)
	Net.event("AskNotifications").OnClientEvent:Connect(function()
		local ok, can = pcall(function()
			return (ExperienceNotificationService :: any):CanPromptOptInAsync()
		end)
		if not ok or not can then
			return
		end
		task.wait(3)
		Popups.card("🔔", Lang.t("notif.title"), Lang.t("notif.body"), {
			{
				text = Lang.t("notif.yes"),
				color = Theme.Green,
				onClick = function()
					if current then
						current.close()
					end
					pcall(function()
						(ExperienceNotificationService :: any):PromptOptIn()
					end)
				end,
			},
			{
				text = Lang.t("notif.no"),
				color = Theme.Grey,
				onClick = function()
					if current then
						current.close()
					end
				end,
			},
		})
	end)
end

return Popups
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">ProgressWindows</string>
              <string name="Source"><![CDATA[--!strict
-- Upgrades (gems), Rebirth, Teleport and Codes & Language windows.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Locale = require(ReplicatedStorage.Shared.Locale)
local Palette = require(ReplicatedStorage.Shared.Palette)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)
local Windows = require(script.Parent.Windows)
local Toasts = require(script.Parent.Toasts)
local Net = require(script.Parent.Parent.Net)
local Lang = require(script.Parent.Parent.Lang)

local ProgressWindows = {}

local function request(action: string, payload: { [string]: any }?, successText: string?): (boolean, any)
	local ok, res = Net.request(action, payload)
	if ok then
		Theme.play("buy", 0.4, 1.1)
		if successText then
			Toasts.show(successText, "success")
		elseif type(res) == "table" and res.key then
			Toasts.show(Lang.msg(res), "success")
		end
	elseif res then
		Toasts.show(Lang.msg(res), "error")
	end
	return ok, res
end

local UPGRADE_ICONS = { TapPower = "👆", Luck = "🍀", PetSlots = "🐾", WalkSpeed = "👟", AutoTap = "🤖" }
local UPGRADE_ICON_NAMES = { TapPower = "fist", Luck = "luck", PetSlots = "paw", WalkSpeed = "rocket", AutoTap = "auto" }

local function upgrades()
	local w = Windows.create("Upgrades", "⬆️", "win.upgrades", Theme.Teal, Vector2.new(640, 500), 412)
	local list = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = w.body }, { Theme.list(Enum.FillDirection.Vertical, 8) })
	type Row = { level: TextLabel, buy: TextButton, bar: Frame }
	local rows: { [string]: Row } = {}
	for i, u in Config.Upgrades do
		local row = Theme.panel({ Size = UDim2.new(1, 0, 0, 76), LayoutOrder = i, BackgroundColor3 = Color3.new(1, 1, 1), Parent = list })
		Theme.icon(UPGRADE_ICONS[u.id] or "⭐", { Size = UDim2.fromOffset(54, 54), Position = UDim2.fromOffset(14, 11), Parent = row }, UPGRADE_ICON_NAMES[u.id])
		Theme.text({ Key = "upgrade." .. u.id .. ".name", Size = UDim2.new(1, -380, 0, 28), Position = UDim2.fromOffset(84, 6), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 26, Parent = row })
		Theme.text({ Key = "upgrade." .. u.id .. ".desc", Size = UDim2.new(1, -380, 0, 20), Position = UDim2.fromOffset(84, 34), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Grey, Stroke = false, MaxTextSize = 19, Parent = row })
		local barBg = Theme.new("Frame", { Size = UDim2.new(1, -380, 0, 10), Position = UDim2.fromOffset(84, 58), BackgroundColor3 = Theme.PaperDark, Parent = row }, { Theme.corner(5) })
		local bar = Theme.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Teal, Parent = barBg }, { Theme.corner(5) })
		local level = Theme.text({ Text = "", Size = UDim2.fromOffset(90, 30), Position = UDim2.new(1, -286, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 24, Parent = row })
		local id = u.id
		local buy = Theme.button({
			Text = "",
			Color = Theme.Teal,
			Size = UDim2.fromOffset(180, 56),
			Position = UDim2.new(1, -12, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			TextSize = 24,
			Parent = row,
			OnClick = function()
				request("Upgrade", { id = id }, Lang.t("toast.upgraded", { name = Lang.t("upgrade." .. id .. ".name") }))
			end,
		})
		rows[u.id] = { level = level, buy = buy, bar = bar }
	end
	local function refresh()
		local s = Net.state
		if not s then
			return
		end
		for _, u in Config.Upgrades do
			local r = rows[u.id]
			local lvl = s.upgrades[u.id] or 0
			r.level.Text = Lang.t("upgrades.level", { lvl = lvl, max = u.maxLevel })
			r.bar.Size = UDim2.fromScale(lvl / u.maxLevel, 1)
			if lvl >= u.maxLevel then
				Theme.clearLead(r.buy:FindFirstChild("Label") :: TextLabel)
				Theme.setButton(r.buy, Lang.t("upgrades.max"), Theme.Grey)
			else
				local cost = Formulas.upgradeCost(u.id, lvl)
				Theme.setButton(r.buy, Theme.lead(r.buy:FindFirstChild("Label") :: TextLabel, "💎") .. Format.abbrev(cost), if s.gems >= cost then Theme.Teal else Theme.Grey)
			end
		end
	end
	w.onOpen = refresh
	Net.Changed:Connect(function()
		if Windows.isOpen("Upgrades") then
			refresh()
		end
	end)
end

local function rebirth()
	local w = Windows.create("Rebirth", "🔁", "win.rebirth", Theme.Purple, Vector2.new(600, 440))
	local body = w.body
	local touch = Root.isTouch -- phone window body is only ~270 px tall: tighter rows
	local info = Theme.text({ Text = "", RichText = true, Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 0), TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 28, Parent = body })
	-- two cards: what a rebirth takes (red) and what it gives (green)
	local function column(x: number, titleKey: string, color: Color3): TextLabel
		local card = Theme.panel({ Size = UDim2.new(0.5, -16, 0, if touch then 88 else 116), Position = UDim2.new(x, if x == 0 then 10 else 6, 0, 34), BackgroundColor3 = Theme.lighten(color, 0.82), Parent = body })
		Theme.text({ Key = titleKey, Size = UDim2.new(1, -12, 0, 28), Position = UDim2.fromOffset(6, 4), TextColor3 = Theme.darken(color, 0.15), Stroke = false, MaxTextSize = 24, Parent = card })
		return Theme.text({ Text = "", RichText = true, TextWrapped = true, Size = UDim2.new(1, -16, 1, -38), Position = UDim2.fromOffset(8, 34), TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 21, Parent = card })
	end
	local loseText = column(0, "rebirth.lose", Theme.Red)
	local getText = column(0.5, "rebirth.get", Theme.Green)
	local barBg = Theme.new("Frame", { Size = UDim2.new(1, -40, 0, 34), Position = UDim2.fromOffset(20, if touch then 130 else 162), BackgroundColor3 = Theme.PaperDark, Parent = body }, { Theme.corner(17), Theme.stroke(3) })
	local bar = Theme.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = barBg }, { Theme.corner(18), Theme.gradient(Theme.lighten(Theme.Purple, 0.3), Theme.Purple) })
	local barText = Theme.text({ Text = "", Size = UDim2.fromScale(1, 0.8), Position = UDim2.fromScale(0, 0.1), MaxTextSize = 22, Parent = barBg })
	barText.AutoLocalize = false
	Theme.text({ Key = "rebirth.note", TextWrapped = true, Size = UDim2.new(1, -20, 0, if touch then 40 else 44), Position = UDim2.fromOffset(10, if touch then 168 else 202), TextColor3 = Theme.Grey, Stroke = false, MaxTextSize = 19, Parent = body })
	local confirm = false
	local button: TextButton
	button = Theme.button({
		Key = "rebirth.button",
		Color = Theme.Purple,
		Size = UDim2.fromOffset(300, if touch then 56 else 70),
		Position = UDim2.new(0.5, 0, 1, if touch then -2 else -10),
		AnchorPoint = Vector2.new(0.5, 1),
		TextSize = 36,
		Parent = body,
		OnClick = function()
			local s = Net.state
			if not s or s.taps < s.rebirthCost then
				Toasts.show(Lang.t("toast.not_enough_taps"), "error")
				return
			end
			if not confirm then
				confirm = true
				Theme.setButton(button, Lang.t("rebirth.confirm"), Theme.Orange)
				task.delay(3, function()
					confirm = false
					Theme.setButton(button, Lang.t("rebirth.button"), Theme.Purple)
				end)
				return
			end
			confirm = false
			Theme.setButton(button, Lang.t("rebirth.button"), Theme.Purple)
			local ok, err = Net.request("Rebirth")
			if not ok and err then
				Toasts.show(Lang.msg(err), "error")
			else
				Theme.play("buy", 0.6, 0.8)
			end
		end,
	})
	local function refresh()
		local s = Net.state
		if not s then
			return
		end
		local now = Formulas.rebirthMult(s.rebirths)
		local nxt = Formulas.rebirthMult(s.rebirths + 1)
		info.Text = Lang.t("rebirth.count", { n = "<b>" .. s.rebirths .. "</b>" })
		loseText.Text = "<b>" .. Lang.t("rebirth.lose_taps", { n = Format.abbrev(s.taps) }) .. "</b>"
		getText.Text = table.concat({
			"<b>" .. Lang.t("rebirth.mult", { from = "x" .. tostring(now), to = "x" .. tostring(nxt) }) .. "</b>",
			"💎 +" .. s.rebirthGems .. "   🎲 +" .. Config.TraitDice.rebirth,
		}, "\n")
		local pct = math.clamp(s.taps / s.rebirthCost, 0, 1)
		bar.Size = UDim2.fromScale(math.max(pct, 0.04), 1)
		barText.Text = Lang.t("rebirth.progress", { have = Format.abbrev(s.taps), need = Format.abbrev(s.rebirthCost) })
	end
	w.onOpen = refresh
	Net.Changed:Connect(function()
		if Windows.isOpen("Rebirth") then
			refresh()
		end
	end)
end

local function teleport()
	local w = Windows.create("Teleport", "🌀", "win.teleport", Theme.Yellow, Vector2.new(560, 500), 410)
	local list = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = w.body }, { Theme.list(Enum.FillDirection.Vertical, 8) })
	local buttons: { TextButton } = {}
	local parkButton = Theme.button({
		Name = "Park",
		Text = "",
		Color = Theme.Purple,
		Size = UDim2.new(1, -10, 0, 60),
		LayoutOrder = 0,
		TextSize = 28,
		Parent = list,
		OnClick = function()
			local ok, err = Net.request("GoPark")
			if ok then
				Windows.close()
			elseif err then
				Toasts.show(Lang.msg(err), "error")
			end
		end,
	})
	for i, zone in Config.Zones do
		buttons[i] = Theme.button({
			Text = "",
			Color = Palette.rgb(zone.ground),
			Size = UDim2.new(1, -10, 0, 60),
			LayoutOrder = i,
			TextSize = 30,
			Parent = list,
			OnClick = function()
				local s = Net.state
				if not s then
					return
				end
				if table.find(s.zones, i) then
					local ok, err = Net.request("Teleport", { zone = i })
					if ok then
						Windows.close()
					elseif err then
						Toasts.show(Lang.msg(err), "error")
					end
				else
					request("BuyZone", { zone = i })
				end
			end,
		})
	end
	local function refresh()
		local s = Net.state
		if not s then
			return
		end
		Theme.setButton(parkButton, "🏡  " .. Lang.t("teleport.park"))
		for i, zone in Config.Zones do
			local owned = table.find(s.zones, i) ~= nil
			local prevOwned = i == 1 or table.find(s.zones, i - 1) ~= nil
			local name = Lang.zone(i)
			local text = if owned then ("✈️  " .. name) elseif prevOwned then ("🔒 " .. Lang.t("teleport.unlock", { zone = name, cost = Format.abbrev(zone.cost) })) else ("🔒 " .. name)
			Theme.setButton(buttons[i], text, if owned then Palette.rgb(zone.ground) elseif prevOwned and s.taps >= zone.cost then Theme.Green else Theme.Grey)
		end
	end
	w.onOpen = refresh
	Net.Changed:Connect(function()
		if Windows.isOpen("Teleport") then
			refresh()
		end
	end)
end

local function codes()
	local w = Windows.create("Codes", "🎟️", "win.codes", Theme.Red, Vector2.new(580, 500), 360)
	local body = w.body
	local box = Theme.new("TextBox", {
		Size = UDim2.new(1, -200, 0, 60),
		Position = UDim2.fromOffset(4, 4),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Text = "",
		Font = Theme.Font,
		TextScaled = true,
		TextColor3 = Theme.Ink,
		ClearTextOnFocus = false,
		Parent = body,
	}, { Theme.corner(14), Theme.stroke(3), Theme.padding(10) }) :: TextBox
	Lang.bind(box, "codes.placeholder", nil, "PlaceholderText")
	Theme.button({
		Key = "codes.redeem",
		Color = Theme.Green,
		Size = UDim2.fromOffset(180, 60),
		Position = UDim2.new(1, -4, 0, 4),
		AnchorPoint = Vector2.new(1, 0),
		TextSize = 30,
		Parent = body,
		OnClick = function()
			local ok = request("RedeemCode", { code = box.Text })
			if ok then
				box.Text = ""
			end
		end,
	})
	Theme.text({ Key = "codes.follow", Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 72), TextColor3 = Theme.Grey, Stroke = false, MaxTextSize = 20, Parent = body })

	-- Language picker
	Theme.text({ Text = "🌐", Stroke = false, Size = UDim2.fromOffset(32, 32), Position = UDim2.fromOffset(4, 110), Parent = body })
	Theme.text({ Key = "settings.language", Size = UDim2.new(1, -60, 0, 32), Position = UDim2.fromOffset(42, 110), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 28, Parent = body })
	local grid = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 200), Position = UDim2.fromOffset(0, 150), Parent = body }, {
		Theme.new("UIGridLayout", { CellSize = UDim2.new(0.25, -8, 0, 56), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local langButtons: { [string]: TextButton } = {}
	for i, l in Locale.Languages do
		local code = l.code
		local b = Theme.button({
			Text = l.flag .. " " .. l.name,
			Color = Theme.Grey,
			LayoutOrder = i,
			TextSize = 22,
			Corner = 12,
			Parent = grid,
			OnClick = function()
				if code == Lang.code then
					return
				end
				local s = Net.state
				if s then
					s.lang = code -- optimistic: the server confirms with the next snapshot
				end
				Lang.set(code)
				Toasts.show(Lang.t("toast.language", { name = l.name }), "success")
				local ok, err = Net.request("SetLanguage", { lang = code })
				if not ok and err then
					Toasts.show(Lang.msg(err), "error")
				end
			end,
		})
		-- names are shown in their own language: never auto-translate them
		b.AutoLocalize = false
		langButtons[code] = b
	end
	local function refresh()
		for code, b in langButtons do
			Theme.setButton(b, nil, if code == Lang.code then Theme.Green else Theme.Blue)
		end
	end
	w.onOpen = refresh
	Lang.Changed:Connect(refresh)
	refresh()
end

function ProgressWindows.init()
	upgrades()
	rebirth()
	teleport()
	codes()
end

return ProgressWindows
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">QuestsWindow</string>
              <string name="Source"><![CDATA[--!strict
-- Daily quests: 3 progress bars with gem rewards + a Magic Egg bonus for finishing all three.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Format)
local Theme = require(script.Parent.Theme)
local Windows = require(script.Parent.Windows)
local Toasts = require(script.Parent.Toasts)
local Hud = require(script.Parent.Hud)
local Net = require(script.Parent.Parent.Net)
local Lang = require(script.Parent.Parent.Lang)

local QuestsWindow = {}

local ICONS = { hatch = "🥚", taps = "👆", craft = "⭐", gems = "💎", playMinutes = "⏱️", rarity = "🟣" }

function QuestsWindow.init()
	local w = Windows.create("Quests", "📜", "win.quests", Theme.Orange, Vector2.new(640, 500), 400)
	local body = w.body
	local resets = Theme.text({ Text = "", Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Grey, Stroke = false, MaxTextSize = 22, Parent = body })
	local list = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -34), Position = UDim2.fromOffset(0, 34), Parent = body }, { Theme.list(Enum.FillDirection.Vertical, 10) })

	type Row = { frame: Frame, icon: TextLabel, text: TextLabel, bar: Frame, barText: TextLabel, button: TextButton }
	local rows: { Row } = {}
	local function makeRow(order: number, onClick: () -> ()): Row
		local frame = Theme.panel({ Size = UDim2.new(1, 0, 0, 84), LayoutOrder = order, BackgroundColor3 = Color3.new(1, 1, 1), Parent = list })
		local icon = Theme.text({ Text = "", Stroke = false, Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset(12, 16), Parent = frame })
		local text = Theme.text({ Text = "", Size = UDim2.new(1, -270, 0, 30), Position = UDim2.fromOffset(74, 8), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 24, Parent = frame })
		local barBg = Theme.new("Frame", { Size = UDim2.new(1, -270, 0, 26), Position = UDim2.fromOffset(74, 46), BackgroundColor3 = Theme.PaperDark, Parent = frame }, { Theme.corner(13), Theme.stroke(2) })
		local bar = Theme.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = barBg }, { Theme.corner(13), Theme.gradient(Theme.lighten(Theme.Orange, 0.3), Theme.Orange) })
		local barText = Theme.text({ Text = "", Size = UDim2.fromScale(1, 0.85), Position = UDim2.fromScale(0, 0.08), MaxTextSize = 18, Parent = barBg })
		barText.AutoLocalize = false
		local button = Theme.button({ Text = "", Color = Theme.Grey, Size = UDim2.fromOffset(170, 56), Position = UDim2.new(1, -12, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), TextSize = 22, Parent = frame, OnClick = onClick })
		return { frame = frame, icon = icon, text = text, bar = bar, barText = barText, button = button }
	end
	local function claimResult(ok: boolean, res: any)
		Toasts.show(Lang.msg(res), if ok then "success" else "error")
	end
	for i = 1, 3 do
		rows[i] = makeRow(i, function()
			claimResult(Net.request("ClaimQuest", { i = i }))
		end)
	end
	local bonus = makeRow(4, function()
		claimResult(Net.request("ClaimQuestBonus"))
	end)

	local function gemLead(b: TextButton): string
		return Theme.lead(b:FindFirstChild("Label") :: TextLabel, "💎")
	end
	local function refresh()
		Hud.refreshQuestBadge()
		if not Windows.isOpen("Quests") then
			return
		end
		local s = Net.state
		local q = s and s.quests
		if not q then
			return
		end
		local allClaimed = true
		for i, row in rows do
			local quest = q.list[i]
			row.frame.Visible = quest ~= nil
			if quest then
				Theme.setIcon(row.icon, ICONS[quest.kind] or "⭐")
				row.text.Text = Lang.t("quest." .. quest.kind, { n = Format.abbrev(quest.target) })
				row.bar.Size = UDim2.fromScale(math.clamp(quest.progress / quest.target, 0.03, 1), 1)
				row.barText.Text = Format.abbrev(quest.progress) .. " / " .. Format.abbrev(quest.target)
				if quest.claimed then
					Theme.clearLead(row.button:FindFirstChild("Label") :: TextLabel)
					Theme.setButton(row.button, "✓ " .. Lang.t("quests.done"), Theme.Grey)
				elseif quest.progress >= quest.target then
					Theme.setButton(row.button, gemLead(row.button) .. quest.gems .. "  " .. Lang.t("quests.claim"), Theme.Green)
				else
					Theme.setButton(row.button, gemLead(row.button) .. quest.gems, Theme.Grey)
				end
				if not quest.claimed then
					allClaimed = false
				end
			end
		end
		local done = 0
		for _, quest in q.list do
			if quest.claimed then
				done += 1
			end
		end
		Theme.setIcon(bonus.icon, "🔮", "egg")
		bonus.text.Text = Lang.t("quests.bonus")
		bonus.bar.Size = UDim2.fromScale(math.clamp(done / math.max(1, #q.list), 0.03, 1), 1)
		bonus.barText.Text = done .. " / " .. #q.list
		if q.bonusClaimed then
			Theme.setButton(bonus.button, "✓ " .. Lang.t("quests.done"), Theme.Grey)
		else
			Theme.setButton(bonus.button, Lang.t("quests.claim"), if allClaimed then Theme.Purple else Theme.Grey)
		end
		local now = q.serverTime + (os.clock() - Net.receivedAt)
		resets.Text = Theme.lead(resets, "⏰") .. Lang.t("quests.resets", { time = Format.time(q.resetsAt - now) })
	end
	w.onOpen = refresh
	Net.Changed:Connect(function(kind)
		if kind == "full" then
			refresh()
		end
	end)
	-- lightweight progress pushes from the server
	Net.event("Quests").OnClientEvent:Connect(function(q)
		local s = Net.state
		if s and q then
			s.quests = q
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if Windows.isOpen("Quests") then
				refresh()
			end
		end
	end)
end

return QuestsWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">RewardsWindow</string>
              <string name="Source"><![CDATA[--!strict
-- Daily streak (7 days) and free in-session timed gifts.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Theme = require(script.Parent.Theme)
local Windows = require(script.Parent.Windows)
local Toasts = require(script.Parent.Toasts)
local Net = require(script.Parent.Parent.Net)
local Lang = require(script.Parent.Parent.Lang)

local RewardsWindow = {}

local ICONS = { taps = "👆", gems = "💎", luck = "🍀", egg = "🔮" }
-- icon pack names (Taps as a currency are the coin, the Magic Egg is the egg)
local ICON_NAMES = { taps = "coin", gems = "gem", luck = "luck", egg = "egg" }

function RewardsWindow.init()
	local w = Windows.create("Rewards", "🎁", "win.rewards", Theme.Pink, Vector2.new(820, 520), 450)
	local body = w.body

	-- Daily
	Theme.text({ Key = "rewards.daily", Size = UDim2.new(0.5, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 28, Parent = body })
	-- current streak (days in a row), right of the title; the real server-side count
	local streakLabel = Theme.text({ Text = "", Size = UDim2.new(0.5, 0, 0, 30), Position = UDim2.fromScale(0.5, 0), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Theme.Orange, Stroke = false, MaxTextSize = 26, Parent = body })
	streakLabel.AutoLocalize = false
	local dailyRow = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 120), Position = UDim2.fromOffset(0, 34), Parent = body }, {
		Theme.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center),
	})
	type DayCard = { frame: Frame, stroke: UIStroke, check: TextLabel }
	local days: { DayCard } = {}
	for i, r in Config.DailyRewards do
		local f = Theme.panel({ Size = UDim2.fromOffset(100, 116), LayoutOrder = i, BackgroundColor3 = Color3.new(1, 1, 1), Parent = dailyRow })
		Theme.text({ Key = "rewards.day", Args = { n = i }, Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 4), TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 20, Parent = f })
		Theme.icon(ICONS[r.kind] or "⭐", { Size = UDim2.fromOffset(46, 46), Position = UDim2.new(0.5, 0, 0, 26), AnchorPoint = Vector2.new(0.5, 0), Parent = f }, ICON_NAMES[r.kind])
		Theme.text({ Key = "rewardlabel." .. r.kind, Args = { n = r.amount }, TextWrapped = true, Size = UDim2.new(1, -8, 0, 34), Position = UDim2.fromOffset(4, 76), TextColor3 = Theme.Grey, Stroke = false, MaxTextSize = 15, Parent = f })
		local check = Theme.text({ Text = "✓", TextColor3 = Theme.Green, Size = UDim2.fromOffset(34, 34), Position = UDim2.new(1, -30, 0, -8), Visible = false, Parent = f })
		days[i] = { frame = f, stroke = f:FindFirstChildOfClass("UIStroke") :: UIStroke, check = check }
	end
	local dailyButton = Theme.button({
		Text = "",
		Color = Theme.Green,
		Size = UDim2.fromOffset(280, 56),
		Position = UDim2.new(0.5, 0, 0, 162),
		AnchorPoint = Vector2.new(0.5, 0),
		TextSize = 28,
		Parent = body,
		OnClick = function()
			local ok, res = Net.request("ClaimDaily")
			Toasts.show(Lang.msg(res), if ok then "success" else "error")
		end,
	})

	-- Gifts
	Theme.text({ Key = "rewards.gifts", Size = UDim2.new(0.8, 0, 0, 30), Position = UDim2.fromOffset(0, 228), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 28, Parent = body })
	local giftGrid = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 180), Position = UDim2.fromOffset(0, 264), Parent = body }, {
		Theme.new("UIGridLayout", { CellSize = UDim2.fromOffset(180, 82), CellPadding = UDim2.fromOffset(12, 10), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }),
	})
	local giftButtons: { TextButton } = {}
	for i in Config.Gifts do
		giftButtons[i] = Theme.button({
			Text = "",
			Color = Theme.Purple,
			LayoutOrder = i,
			TextSize = 20,
			Parent = giftGrid,
			OnClick = function()
				local ok, res = Net.request("ClaimGift", { index = i })
				if not ok then
					Toasts.show(Lang.msg(res), "error")
				end
			end,
		})
	end

	local function refresh()
		local s = Net.state
		if not s then
			return
		end
		local serverNow = s.serverTime + (os.clock() - Net.receivedAt)
		local sinceLast = serverNow - s.daily.last
		local streak = s.daily.streak
		if sinceLast > Config.DailyStreakWindow then
			streak = 0
		end
		streakLabel.Text = if streak > 0 then "🔥 " .. Lang.t("rewards.streak", { n = streak }) else ""
		local todayIndex = (streak % #Config.DailyRewards) + 1
		local ready = sinceLast >= Config.DailyCooldown
		local claimedThisCycle = streak % #Config.DailyRewards
		for i, d in days do
			d.check.Visible = i <= claimedThisCycle and not (ready and claimedThisCycle == 0)
			d.stroke.Color = if i == todayIndex and ready then Theme.Green else Theme.Ink
			d.stroke.Thickness = if i == todayIndex and ready then 5 else 3
		end
		Theme.setButton(dailyButton, if ready then Lang.t("rewards.claim_day", { n = todayIndex }) else Lang.t("rewards.next_in", { time = Format.time(Config.DailyCooldown - sinceLast) }), if ready then Theme.Green else Theme.Grey)

		local elapsed = s.sessionElapsed + (os.clock() - Net.receivedAt)
		local claimed = {}
		for _, i in s.giftsClaimed do
			claimed[i] = true
		end
		for i, g in Config.Gifts do
			local b = giftButtons[i]
			local icon = ICONS[g.reward.kind] or "🎁"
			local label = Lang.rewardLabel(g.reward)
			if claimed[i] then
				Theme.setButton(b, "✓ " .. label, Theme.Grey)
			else
				local left = g.minutes * 60 - elapsed
				if left <= 0 then
					Theme.setButton(b, icon .. " " .. Lang.t("rewards.claim") .. "\n" .. label, Theme.Green)
				else
					Theme.setButton(b, icon .. " " .. Format.time(left) .. "\n" .. label, Theme.Purple)
				end
			end
		end
	end
	w.onOpen = refresh
	refresh()
	Net.Changed:Connect(function(kind)
		if kind == "full" and Windows.isOpen("Rewards") then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if Windows.isOpen("Rewards") then
				refresh()
			end
		end
	end)
end

return RewardsWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">Root</string>
              <string name="Source"><![CDATA[--!strict
-- The ScreenGuis for the game UI plus resolution scaling and the touch layout flag.
-- Scaling is applied per top-level element through Root.mount (a holder frame with a
-- UIScale), because a UIScale on the ScreenGui itself would also shrink full-screen
-- layouts and edge anchoring.
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)

local Root = {}

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui

-- Phones/tablets: the Roblox thumbstick (bottom-left) and jump button (bottom-right) own
-- those corners, so the HUD moves to the top and panels open at the top.
-- (Studio can't emulate touch: workspace attribute ForceTouchLayout previews it.)
Root.isTouch = (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) or Workspace:GetAttribute("ForceTouchLayout") == true

Root.gui = Theme.new("ScreenGui", {
	Name = "TapPetsUI",
	ResetOnSpawn = false,
	ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets, -- stays clear of the Roblox topbar buttons
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = playerGui,
}) :: ScreenGui

-- Full-screen overlay (hatch cinematic), ignores insets, drawn above everything.
Root.overlay = Theme.new("ScreenGui", {
	Name = "TapPetsOverlay",
	ResetOnSpawn = false,
	ScreenInsets = Enum.ScreenInsets.None,
	DisplayOrder = 10,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = playerGui,
}) :: ScreenGui

Root.scale = 1
local scales: { UIScale } = {}
local changed = Instance.new("BindableEvent")
Root.Changed = changed.Event

-- Design size 1100x560 of usable (safe-area) space: ~0.8 on a 920x505 phone, capped at 1.1
-- on big monitors so the PC layout stays compact.
local function compute(): number
	local size = Root.gui.AbsoluteSize
	if size.X < 10 or size.Y < 10 then
		local cam = Workspace.CurrentCamera
		if not cam then
			return 1
		end
		size = cam.ViewportSize
	end
	if Root.isTouch then
		-- Phones: never below 0.8 (44 px buttons, 11 px text stay real); the touch layout in
		-- Hud/Windows is compact enough to fit at that scale. Tablets top out at 1.
		return math.clamp(math.min(size.X / 940, size.Y / 390), 0.8, 1)
	end
	return math.clamp(math.min(size.X / 1100, size.Y / 560), 0.5, 1.1)
end

local playerListShown: boolean? = nil
local function apply()
	Root.scale = compute()
	for _, s in scales do
		s.Scale = Root.scale
	end
	-- The default player list covers the right-side HUD on small screens.
	local cam = Workspace.CurrentCamera
	local show = cam ~= nil and cam.ViewportSize.X >= 1000 and not Root.isTouch
	if show ~= playerListShown then
		playerListShown = show
		pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, show)
		end)
	end
	changed:Fire(Root.scale)
end

-- Wraps a top-level GuiObject in a holder that carries the resolution UIScale. The holder
-- takes the object's Size/Position/AnchorPoint, so edge anchoring keeps working, and the
-- object stays free to use its own UIScale for pop animations.
function Root.mount(obj: GuiObject, parent: Instance?): Frame
	local holder = Theme.new("Frame", {
		Name = obj.Name .. "Holder",
		BackgroundTransparency = 1,
		Size = obj.Size,
		Position = obj.Position,
		AnchorPoint = obj.AnchorPoint,
		ZIndex = obj.ZIndex,
		Parent = parent or Root.gui,
	}) :: Frame
	local s = Theme.new("UIScale", { Scale = Root.scale, Parent = holder }) :: UIScale
	table.insert(scales, s)
	obj.AnchorPoint = Vector2.new(0.5, 0.5)
	obj.Position = UDim2.fromScale(0.5, 0.5)
	obj.Parent = holder
	return holder
end

local function hookCamera()
	local cam = Workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(apply)
	end
	apply()
end
Root.gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(apply)
hookCamera()
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hookCamera)

return Root
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">StoreWindow</string>
              <string name="Source"><![CDATA[--!strict
-- Robux store: game passes and developer products. Items with id 0 in Config are hidden,
-- and so are paid random items for players PolicyService restricts. The cards are rebuilt
-- when that flag arrives or changes (it is unknown until the first state snapshot).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Palette = require(ReplicatedStorage.Shared.Palette)
local Theme = require(script.Parent.Theme)
local Windows = require(script.Parent.Windows)
local Net = require(script.Parent.Parent.Net)
local Lang = require(script.Parent.Parent.Lang)
local Purchase = require(script.Parent.Parent.Purchase)

local StoreWindow = {}

local PASS_ICONS = { AutoTap = "🤖", TripleHatch = "🥚", OctoHatch = "🥚", AutoHatch = "🔄", AutoRebirth = "🔁", Lucky = "🍀", SuperLucky = "🍀", VIP = "👑", PetSlots = "🐾", PetSlots2 = "🐾", Storage = "🎒", DoubleTaps = "✌️", MagicEggs = "✨" }
local PRODUCT_ICONS = { taps = "👆", gems = "💎", luck = "🍀", egg = "🔮" }
-- icon pack names where the emoji's default mapping is not the right picture
local PRODUCT_ICON_NAMES = { taps = "coin", egg = "egg" }
-- ribbon on the biggest pack of each kind
local BEST = { TapsLarge = true, GemsHuge = true, MagicEgg3 = true }

-- Cards on screen: passes, products (playtest).
StoreWindow.counts = function(): (number, number)
	return 0, 0
end
StoreWindow.rebuild = function() end

function StoreWindow.init()
	local w = Windows.create("Store", "🛒", "win.store", Theme.Green, Vector2.new(820, 520))
	local scroll = Theme.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.Ink,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = w.body,
	}, { Theme.list(Enum.FillDirection.Vertical, 12), Theme.padding(6) })

	local function section(titleKey: string, order: number): (Frame, TextLabel)
		local label = Theme.text({ Key = titleKey, Size = UDim2.new(1, 0, 0, 34), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 30, LayoutOrder = order, Parent = scroll })
		local grid = Theme.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = order + 1,
			Parent = scroll,
		}, { Theme.new("UIGridLayout", { CellSize = UDim2.fromOffset(180, 236), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder }) })
		return grid, label
	end

	local passGrid, passTitle = section("store.passes", 1)
	local productGrid, productTitle = section("store.boosts", 3)
	-- empty state (no product IDs configured yet): big cart + message, centred
	local empty = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 380), LayoutOrder = 10, Visible = false, Parent = scroll }) :: Frame
	local emptyDisc = Theme.new("Frame", { Size = UDim2.fromOffset(150, 150), Position = UDim2.new(0.5, 0, 0, 70), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1), Parent = empty }, { Theme.corner(75), Theme.stroke(4), Theme.gradient(Theme.White, Theme.lighten(Theme.Green, 0.55)) })
	Theme.icon("\u{1F6D2}", { Size = UDim2.fromScale(0.62, 0.62), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Parent = emptyDisc })
	Theme.text({ Key = "store.soon", Size = UDim2.new(1, -40, 0, 44), Position = UDim2.fromOffset(20, 236), TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 32, Parent = empty })

	type Card = { frame: Frame, buy: TextButton, key: string }
	local passCards: { Card } = {}
	local productCards = 0

	-- One icon template for every pass and product: a disc in the item's colour with turning
	-- rays behind the emoji (the look every simulator uses for its pass icons).
	-- oddsKey: product whose random reward's odds are printed on the card (paid random items
	-- show numeric odds before the purchase prompt).
	local oddsLabels: { [TextLabel]: string } = {}
	local function card(parent: Instance, order: number, color: Color3, icon: string, iconName: string?, nameKey: string, descKey: string, price: number, best: boolean, onBuy: () -> (), oddsKey: string?): (Frame, TextButton)
		local f = Theme.panel({ LayoutOrder = order, BackgroundColor3 = Color3.new(1, 1, 1), Parent = parent })
		local top = Theme.new("Frame", { Size = UDim2.new(1, 0, 0, 78), BackgroundColor3 = Color3.new(1, 1, 1), ClipsDescendants = true, Parent = f }, { Theme.corner(16), Theme.gradient(Theme.lighten(color, 0.35), Theme.darken(color, 0.05)) })
		local rays = Theme.new("Frame", { Size = UDim2.fromOffset(230, 230), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Parent = top })
		for k = 0, 5 do
			Theme.new("Frame", { Size = UDim2.new(0, 22, 1, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Rotation = k * 30, BackgroundColor3 = Theme.White, BackgroundTransparency = 0.78, BorderSizePixel = 0, Parent = rays })
		end
		TweenService:Create(rays, TweenInfo.new(20, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), { Rotation = 360 }):Play()
		local disc = Theme.new("Frame", { Size = UDim2.fromOffset(64, 64), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), Parent = top }, { Theme.corner(32), Theme.stroke(3), Theme.gradient(Theme.White, Theme.lighten(color, 0.6)) })
		Theme.icon(icon, { Size = UDim2.fromScale(0.7, 0.7), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Parent = disc }, iconName)
		if best then
			local ribbon = Theme.new("Frame", { Size = UDim2.fromOffset(96, 24), Position = UDim2.new(1, -6, 0, 6), AnchorPoint = Vector2.new(1, 0), Rotation = 6, BackgroundColor3 = Theme.Red, ZIndex = 3, Parent = f }, { Theme.corner(8), Theme.stroke(2) })
			local t = Theme.text({ Key = "store.best", Size = UDim2.new(1, -6, 1, -2), Position = UDim2.fromOffset(3, 1), MaxTextSize = 15, Parent = ribbon })
			t.ZIndex = 4
		end
		Theme.text({ Key = nameKey, Size = UDim2.new(1, -12, 0, 24), Position = UDim2.fromOffset(6, 80), TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 22, Parent = f })
		Theme.text({ Key = descKey, TextWrapped = true, Size = UDim2.new(1, -12, 0, if oddsKey then 30 else 64), Position = UDim2.fromOffset(6, 104), TextColor3 = Theme.darken(Theme.Grey, 0.25), Stroke = false, MaxTextSize = 16, Parent = f })
		if oddsKey then
			local plate = Theme.new("Frame", { Name = "OddsPlate", Size = UDim2.new(1, -12, 0, 40), Position = UDim2.fromOffset(6, 134), BackgroundColor3 = Theme.lighten(color, 0.8), Parent = f }, { Theme.corner(8) })
			local odds = Theme.text({ Name = "Odds", Text = Purchase.cardOdds(oddsKey) or "", TextWrapped = true, Size = UDim2.new(1, -8, 1, -4), Position = UDim2.fromOffset(4, 2), TextColor3 = Theme.Ink, Stroke = false, MaxTextSize = 14, Parent = plate })
			odds.AutoLocalize = false
			oddsLabels[odds] = oddsKey
		end
		-- Robux prices are purple everywhere
		local b = Theme.button({ Text = "R$ " .. price, Color = Theme.Purple, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.new(0.5, 0, 1, -8), AnchorPoint = Vector2.new(0.5, 1), TextSize = 24, Parent = f, OnClick = onBuy })
		return f, b
	end

	local function refresh()
		-- the Golden chance in the odds changes with the Magic Eggs pass and Golden Weekend
		for label, key in oddsLabels do
			if label.Parent then
				label.Text = Purchase.cardOdds(key) or ""
			else
				oddsLabels[label] = nil
			end
		end
		for _, c in passCards do
			if Net.owns(c.key) then
				Theme.setButton(c.buy, Lang.t("store.owned") .. " ✓", Theme.Grey)
			end
		end
	end

	local function build()
		for _, grid in { passGrid, productGrid } do
			for _, c in grid:GetChildren() do
				if c:IsA("Frame") then
					c:Destroy()
				end
			end
		end
		table.clear(passCards)
		table.clear(oddsLabels)
		productCards = 0
		for i, pass in Config.Passes do
			if Purchase.passAvailable(pass.key) then
				local key = pass.key
				local f, b = card(passGrid, i, Palette.rgb(pass.color), PASS_ICONS[pass.key] or "⭐", nil, "pass." .. pass.key .. ".name", "pass." .. pass.key .. ".desc", pass.price, false, function()
					if not Net.owns(key) then
						Purchase.pass(key)
					end
				end, if Purchase.cardOdds(key) then key else nil)
				table.insert(passCards, { frame = f, buy = b, key = key })
			end
		end
		for i, product in Config.Products do
			if Purchase.productAvailable(product.key) and not Config.HiddenProductKinds[product.kind] then
				productCards += 1
				local key = product.key
				card(productGrid, i, Palette.rgb(product.color), PRODUCT_ICONS[product.kind] or "⭐", PRODUCT_ICON_NAMES[product.kind], "product." .. product.key .. ".name", "product." .. product.key .. ".desc", product.price, BEST[product.key] == true, function()
					Purchase.product(key)
				end, if Purchase.cardOdds(key) then key else nil)
			end
		end
		empty.Visible = #passCards + productCards == 0
		passTitle.Visible, passGrid.Visible = #passCards > 0, #passCards > 0
		productTitle.Visible, productGrid.Visible = productCards > 0, productCards > 0
		refresh()
	end
	StoreWindow.rebuild = build
	StoreWindow.counts = function(): (number, number)
		return #passCards, productCards
	end

	build()
	w.onOpen = refresh
	Lang.Changed:Connect(refresh)
	local lastRestricted: any = "unset"
	Net.Changed:Connect(function(kind)
		if kind ~= "full" then
			return
		end
		local restricted = Purchase.restricted()
		if restricted ~= lastRestricted then
			lastRestricted = restricted
			build()
		elseif Windows.isOpen("Store") then
			refresh()
		end
	end)
end

return StoreWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
-- Bright cartoony UI kit: colors, a tiny instance factory and reusable widgets.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Icons = require(ReplicatedStorage.Shared.Icons)
local Lang = require(script.Parent.Parent.Lang)

local Theme = {}

Theme.Font = Enum.Font.FredokaOne
Theme.Ink = Color3.fromRGB(43, 33, 64) -- outlines / dark text
Theme.Paper = Color3.fromRGB(255, 250, 240)
Theme.PaperDark = Color3.fromRGB(240, 230, 215)
Theme.Blue = Color3.fromRGB(63, 169, 245)
Theme.Yellow = Color3.fromRGB(255, 210, 63)
Theme.Pink = Color3.fromRGB(255, 111, 181)
Theme.Green = Color3.fromRGB(92, 214, 92)
Theme.Red = Color3.fromRGB(255, 90, 90)
Theme.Purple = Color3.fromRGB(165, 105, 255)
Theme.Orange = Color3.fromRGB(255, 160, 60)
Theme.Teal = Color3.fromRGB(60, 210, 190)
Theme.Grey = Color3.fromRGB(170, 170, 185)
Theme.White = Color3.new(1, 1, 1)

-- create("Frame", { props }, { children })
function Theme.new(className: string, props: { [string]: any }?, children: { any }?): any
	local inst = Instance.new(className) :: any
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				inst[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Theme.corner(r: number?): any
	return Theme.new("UICorner", { CornerRadius = UDim.new(0, r or 14) })
end

function Theme.stroke(thickness: number?, color: Color3?): any
	return Theme.new("UIStroke", { Thickness = thickness or 3, Color = color or Theme.Ink, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function Theme.textStroke(thickness: number?): any
	return Theme.new("UIStroke", { Thickness = thickness or 2, Color = Theme.Ink, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual })
end

function Theme.padding(px: number): any
	local u = UDim.new(0, px)
	return Theme.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function Theme.gradient(top: Color3, bottom: Color3): any
	return Theme.new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = 90 })
end

function Theme.lighten(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), a)
end

function Theme.darken(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), a)
end

function Theme.list(dir: Enum.FillDirection?, padding: number?, hAlign: Enum.HorizontalAlignment?, vAlign: Enum.VerticalAlignment?): any
	return Theme.new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
	})
end

function Theme.text(props: { [string]: any }): TextLabel
	local t = Theme.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextColor3 = Theme.White,
		TextScaled = true,
		Size = UDim2.fromScale(1, 1),
	})
	for k, v in props do
		if k ~= "Parent" and k ~= "Stroke" and k ~= "MaxTextSize" and k ~= "Key" and k ~= "Args" then
			(t :: any)[k] = v
		end
	end
	if props.Key then
		Lang.bind(t, props.Key, props.Args)
	end
	if props.Stroke ~= false then
		local st = Theme.textStroke(if type(props.Stroke) == "number" then props.Stroke else 2)
		st.Parent = t
	end
	local sizeConstraint = Theme.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 40, MinTextSize = 8 })
	sizeConstraint.Parent = t
	if props.Parent then
		t.Parent = props.Parent
	end
	return t
end

---------------------------------------------------------------------------
-- Icons: the shared image pack (Shared/Icons) when it is uploaded, the emoji otherwise.
-- Every icon slot is a TextLabel "holder": with no image id it shows the emoji exactly as
-- before; with an id the text is cleared and an ImageLabel (ScaleType Fit) fills it.
---------------------------------------------------------------------------
Theme.EMOJI_ICONS = {
	["⬆️"] = "upgrade",
	["🔁"] = "rebirth",
	["📜"] = "quest",
	["🛒"] = "shop",
	["📖"] = "book",
	["🌀"] = "teleport",
	["💌"] = "invite",
	["🎟️"] = "ticket",
	["🎁"] = "gift",
	["🐾"] = "paw",
	["👆"] = "tap",
	["💎"] = "gem",
	["🤖"] = "auto",
	["🔄"] = "auto",
	["🥚"] = "egg",
	["🍀"] = "luck",
	["⚡"] = "bolt",
	["⭐"] = "star",
	["👑"] = "crown",
	["⏱️"] = "clock",
	["⏰"] = "clock",
	["🔮"] = "orb",
	["👥"] = "group",
	["✨"] = "aura",
	["🔒"] = "lock",
	["✌️"] = "fist",
	["👟"] = "rocket",
	["🎉"] = "gift",
	["🌐"] = "planet",
	["🟣"] = "orb",
} :: { [string]: string }

-- Image for an emoji (or an explicit pack name), nil while the pack is not uploaded.
function Theme.iconImage(emoji: string, name: string?): string?
	local n = name or Theme.EMOJI_ICONS[emoji]
	return if n then Icons.get(n) else nil
end

-- Shows `emoji` (or the pack image `name`, defaulting to the emoji's mapping) in a holder label.
function Theme.setIcon(holder: TextLabel, emoji: string, name: string?)
	local img = Theme.iconImage(emoji, name)
	local image = holder:FindFirstChild("IconImage") :: ImageLabel?
	if not img then
		if image then
			image:Destroy()
		end
		if holder.Text ~= emoji then
			holder.Text = emoji
		end
		return
	end
	holder.Text = ""
	if not image then
		local created = Instance.new("ImageLabel")
		created.Name = "IconImage"
		created.BackgroundTransparency = 1
		created.ScaleType = Enum.ScaleType.Fit
		created.Size = UDim2.fromScale(1, 1)
		created.ZIndex = holder.ZIndex
		created.Parent = holder
		image = created
	end
	(image :: ImageLabel).Image = img
end

-- A new icon holder. props are TextLabel props (Size, Position, AnchorPoint, ZIndex, Parent...).
function Theme.icon(emoji: string, props: { [string]: any }?, name: string?): TextLabel
	local p = table.clone(props or {})
	p.Text = emoji
	p.Stroke = false
	p.Name = p.Name or "Icon"
	local zIndex = p.ZIndex
	p.ZIndex = nil
	local t = Theme.text(p)
	if zIndex then
		t.ZIndex = zIndex
	end
	Theme.setIcon(t, emoji, name)
	return t
end

-- Icon in front of a text: returns the prefix to put before the text. Without an image it is
-- the emoji and a space (the text looks exactly as before); with one, an image sits at the
-- label's left edge (the label gets a left padding for it) and the prefix is empty.
function Theme.lead(label: TextLabel, emoji: string, name: string?): string
	local img = Theme.iconImage(emoji, name)
	local image = label:FindFirstChild("LeadIcon") :: ImageLabel?
	if not img then
		if image then
			image:Destroy()
			local pad = label:FindFirstChild("LeadPad")
			if pad then
				pad:Destroy()
			end
		end
		return emoji .. " "
	end
	if not image then
		local h = label.AbsoluteSize.Y
		if h < 4 then
			local parent = label.Parent
			local parentH = if parent and parent:IsA("GuiObject") then parent.Size.Y.Offset else 0
			h = label.Size.Y.Offset + label.Size.Y.Scale * parentH
		end
		h = math.clamp(if h > 0 then h else 28, 14, 64)
		Theme.new("UIPadding", { Name = "LeadPad", PaddingLeft = UDim.new(0, h + 4), Parent = label })
		image = Theme.new("ImageLabel", {
			Name = "LeadIcon",
			BackgroundTransparency = 1,
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromOffset(h, h),
			Position = UDim2.new(0, -(h + 4), 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			ZIndex = label.ZIndex,
			Parent = label,
		})
	end
	(image :: ImageLabel).Image = img
	return ""
end

-- Removes a lead icon (for states of the same label that have no icon, like "✓ Done").
function Theme.clearLead(label: TextLabel)
	local image = label:FindFirstChild("LeadIcon")
	if image then
		image:Destroy()
	end
	local pad = label:FindFirstChild("LeadPad")
	if pad then
		pad:Destroy()
	end
end

function Theme.panel(props: { [string]: any }): Frame
	local f = Theme.new("Frame", {
		BackgroundColor3 = Theme.Paper,
		BorderSizePixel = 0,
	}, {
		Theme.corner(props.Corner or 16),
		Theme.stroke(props.StrokeThickness or 3),
		-- soft top-to-bottom shade: multiplies whatever background colour the caller sets
		Theme.new("UIGradient", { Name = "Shade", Color = ColorSequence.new(Theme.White, Color3.fromRGB(232, 228, 242)), Rotation = 90 }),
	})
	for k, v in props do
		if k ~= "Parent" and k ~= "Corner" and k ~= "StrokeThickness" then
			(f :: any)[k] = v
		end
	end
	if props.Parent then
		f.Parent = props.Parent
	end
	return f
end

---------------------------------------------------------------------------
-- Sounds (built-in rbxasset sounds that exist in every Roblox install)
---------------------------------------------------------------------------
local sounds: { [string]: Sound } = {}
-- Only these ship in content/sounds: action_*.mp3/ogg, impact_*.mp3, oof/ouch.ogg, volume_slider.ogg.
local SOUND_IDS = {
	tap = "rbxasset://sounds/volume_slider.ogg",
	click = "rbxasset://sounds/volume_slider.ogg",
	open = "rbxasset://sounds/action_jump.mp3",
	buy = "rbxasset://sounds/action_jump_land.mp3",
	hatch = "rbxasset://sounds/impact_water.mp3",
	error = "rbxasset://sounds/action_get_up.mp3",
	boom = "rbxasset://sounds/impact_explosion_03.mp3",
}
function Theme.play(name: string, volume: number?, pitch: number?)
	local id = SOUND_IDS[name]
	if not id then
		return
	end
	local snd = sounds[name]
	if not snd then
		local created = Instance.new("Sound")
		created.SoundId = id
		created.Parent = SoundService
		sounds[name] = created
		snd = created
	end
	snd.Volume = volume or 0.4
	snd.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(snd)
end

---------------------------------------------------------------------------
-- Button with squash feedback
---------------------------------------------------------------------------
export type ButtonOpts = {
	Text: string?,
	Key: string?, -- translation key (overrides Text, re-renders on language change)
	Args: { [string]: any }?,
	Color: Color3?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	LayoutOrder: number?,
	Parent: Instance?,
	TextSize: number?,
	Corner: number?,
	OnClick: (() -> ())?,
	Name: string?,
}

-- Chunky button face: light top, flat middle and a darker "lip" along the bottom edge.
function Theme.buttonFace(color: Color3): ColorSequence
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, Theme.lighten(color, 0.34)),
		ColorSequenceKeypoint.new(0.45, color),
		ColorSequenceKeypoint.new(0.84, Theme.darken(color, 0.04)),
		ColorSequenceKeypoint.new(0.85, Theme.darken(color, 0.24)),
		ColorSequenceKeypoint.new(1, Theme.darken(color, 0.3)),
	})
end

-- Soft white highlight across the top of a rounded surface (buttons, pills, cards).
function Theme.gloss(parent: GuiObject, corner: number, alpha: number?): Frame
	local g = Theme.new("Frame", {
		Name = "Gloss",
		Size = UDim2.new(1, -10, 0.4, 0),
		Position = UDim2.new(0, 5, 0, 4),
		BackgroundColor3 = Theme.White,
		BackgroundTransparency = alpha or 0.8,
		BorderSizePixel = 0,
		ZIndex = parent.ZIndex,
		Parent = parent,
	}, { Theme.corner(math.max(4, corner - 4)) }) :: Frame
	return g
end

-- Drop shadow behind a mounted panel: lives in the panel's holder and follows its visibility.
function Theme.shadow(panel: GuiObject, corner: number?)
	local holder = panel.Parent
	if not holder or not holder:IsA("GuiObject") then
		return
	end
	local sh = Theme.new("Frame", {
		Name = "Shadow",
		Size = UDim2.new(1, 8, 1, 8),
		Position = UDim2.new(0.5, 0, 0.5, 9),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(15, 10, 30),
		BackgroundTransparency = 0.68,
		BorderSizePixel = 0,
		ZIndex = panel.ZIndex - 1,
		Visible = panel.Visible,
		Parent = holder,
	}, { Theme.corner((corner or 22) + 4) })
	panel:GetPropertyChangedSignal("Visible"):Connect(function()
		sh.Visible = panel.Visible
	end)
end

function Theme.button(opts: ButtonOpts): TextButton
	local color = opts.Color or Theme.Blue
	local b = Theme.new("TextButton", {
		Name = opts.Name or "Button",
		Size = opts.Size or UDim2.fromOffset(160, 50),
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.zero,
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = opts.LayoutOrder or 0,
	}, {
		Theme.corner(opts.Corner or 14),
		Theme.stroke(3),
		Theme.new("UIGradient", { Color = Theme.buttonFace(color), Rotation = 90 }),
	}) :: TextButton
	Theme.gloss(b, opts.Corner or 14)
	local label = Theme.text({
		Name = "Label",
		Text = opts.Text or "",
		Size = UDim2.new(1, -12, 1, -8),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = opts.TextSize or 30,
		Key = opts.Key,
		Args = opts.Args,
		Parent = b,
	})
	label.ZIndex = b.ZIndex + 1
	local scale = Theme.new("UIScale", { Parent = b })
	b.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.9 }):Play()
	end)
	local function release()
		TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	b.MouseButton1Up:Connect(release)
	b.MouseLeave:Connect(release)
	b.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.05 }):Play()
	end)
	if opts.OnClick then
		local cb = opts.OnClick
		b.Activated:Connect(function()
			Theme.play("click", 0.35)
			cb()
		end)
	end
	if opts.Parent then
		b.Parent = opts.Parent
	end
	return b
end

function Theme.setButton(b: TextButton, text: string?, color: Color3?)
	local label = b:FindFirstChild("Label") :: TextLabel?
	if text and label then
		Lang.unbind(label)
		label.Text = text
	end
	if color then
		local g = b:FindFirstChildOfClass("UIGradient")
		if g then
			g.Color = Theme.buttonFace(color)
		end
	end
end

-- Little red "!" badge on a button.
function Theme.badge(parent: GuiObject): Frame
	local f = Theme.new("Frame", {
		Name = "Badge",
		Size = UDim2.fromOffset(24, 24),
		Position = UDim2.new(1, -8, 0, -8),
		BackgroundColor3 = Theme.Red,
		Visible = false,
		ZIndex = 10,
		Parent = parent,
	}, { Theme.corner(12), Theme.stroke(2) })
	local t = Theme.text({ Text = "!", ZIndex = 11, Parent = f })
	t.ZIndex = 11
	local pulse = Theme.new("UIScale", { Parent = f })
	TweenService:Create(pulse, TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.22 }):Play()
	return f
end

function Theme.pop(obj: GuiObject, amount: number?)
	local s = obj:FindFirstChildOfClass("UIScale") or Theme.new("UIScale", { Parent = obj })
	local sc = s :: UIScale
	sc.Scale = amount or 1.15
	TweenService:Create(sc, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">Toasts</string>
              <string name="Source"><![CDATA[--!strict
-- Notifications (personal) and server-wide rare-hatch announcements.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Format = require(ReplicatedStorage.Shared.Format)
local Palette = require(ReplicatedStorage.Shared.Palette)
local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)
local Net = require(script.Parent.Parent.Net)
local Lang = require(script.Parent.Parent.Lang)

local Toasts = {}

local stack = Theme.new("Frame", {
	Name = "Toasts",
	BackgroundTransparency = 1,
	Size = UDim2.fromOffset(560, 300),
	-- PC: below the objective line and the banner; touch: between the HUD columns
	Position = if Root.isTouch then UDim2.new(0.5, 0, 0, 84) else UDim2.new(0.5, 0, 0, 176),
	AnchorPoint = Vector2.new(0.5, 0),
	ZIndex = 40,
	Parent = Root.gui,
}, { Theme.list(Enum.FillDirection.Vertical, 6) })
Root.mount(stack)

local KIND_COLORS = {
	info = Theme.Blue,
	success = Theme.Green,
	error = Theme.Red,
}

local order = 0
function Toasts.show(text: string, kind: string?, duration: number?)
	order += 1
	local color = KIND_COLORS[kind or "info"] or Theme.Blue
	local f = Theme.new("Frame", {
		Size = UDim2.fromOffset(520, 44),
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = order,
		Parent = stack,
	}, { Theme.corner(22), Theme.stroke(3), Theme.gradient(Theme.lighten(color, 0.2), color) })
	local sc = Theme.new("UIScale", { Scale = 0.5, Parent = f })
	Theme.text({ Text = text, Size = UDim2.new(1, -24, 1, -10), Position = UDim2.fromOffset(12, 5), MaxTextSize = 26, Parent = f })
	TweenService:Create(sc, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	if kind == "error" then
		Theme.play("error", 0.3, 0.7)
	end
	task.delay(duration or 2.6, function()
		local t = TweenService:Create(sc, TweenInfo.new(0.2), { Scale = 0 })
		t:Play()
		t.Completed:Wait()
		f:Destroy()
	end)
	-- keep the stack short
	local frames = {}
	for _, c in stack:GetChildren() do
		if c:IsA("Frame") then
			table.insert(frames, c)
		end
	end
	if #frames > 5 then
		table.sort(frames, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		frames[1]:Destroy()
	end
end

-- Big banner for Legendary+ hatches from anyone in the server.
local banner = Theme.new("Frame", {
	Name = "Announce",
	Size = UDim2.fromOffset(640, 64),
	Position = if Root.isTouch then UDim2.new(0.5, 0, 0, 8) else UDim2.new(0.5, 0, 0, 100),
	AnchorPoint = Vector2.new(0.5, 0),
	BackgroundColor3 = Color3.new(1, 1, 1),
	Visible = false,
	ZIndex = 45,
	Parent = Root.gui,
}, { Theme.corner(18), Theme.stroke(4) })
Root.mount(banner).ClipsDescendants = false
local HIDDEN = UDim2.new(0.5, 0, 0.5, -160)
local SHOWN = UDim2.new(0.5, 0, 0.5, 0)
banner.Position = HIDDEN
local bannerGradient = Theme.new("UIGradient", { Rotation = 0, Parent = banner })
local bannerText = Theme.text({ Size = UDim2.new(1, -24, 1, -12), Position = UDim2.fromOffset(12, 6), MaxTextSize = 30, RichText = true, Stroke = 3, Parent = banner })
local queue: { { text: string, color: Color3 } } = {}
local busy = false

local function nextBanner()
	if busy or #queue == 0 then
		return
	end
	busy = true
	local item = table.remove(queue, 1) :: { text: string, color: Color3 }
	bannerText.Text = item.text
	bannerGradient.Color = ColorSequence.new(Theme.lighten(item.color, 0.3), item.color)
	banner.Visible = true
	banner.Position = HIDDEN
	TweenService:Create(banner, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Position = SHOWN }):Play()
	task.delay(3.4, function()
		local t = TweenService:Create(banner, TweenInfo.new(0.25), { Position = HIDDEN })
		t:Play()
		t.Completed:Wait()
		banner.Visible = false
		busy = false
		nextBanner()
	end)
end

-- Big top banner (rare hatches, live events). Keeps at most 5 waiting.
function Toasts.banner(text: string, color: Color3)
	table.insert(queue, { text = text, color = color })
	while #queue > 5 do
		table.remove(queue, 1)
	end
	nextBanner()
end

-- Rare hatch from this server, or from another server (data.global, gold banner).
-- Translated per recipient: the server only sends ids.
function Toasts.announce(data: { [string]: any })
	local c = Palette.rarity(data.rarity)
	if data.rarity == "Secret" then
		c = Color3.fromRGB(170, 60, 255)
	end
	local hex = c:Lerp(Color3.new(1, 1, 1), 0.5):ToHex()
	local chance = if type(data.chanceText) == "string" then data.chanceText else Format.chance(tonumber(data.chance) or 0)
	if data.global then
		local petText = string.format('<font color="#%s">%s</font>', hex, Lang.pet(data.pet, data.tier))
		Toasts.banner("🌍 " .. Lang.t("announce.global", { player = data.player, pet = petText, chance = chance }), Color3.fromRGB(255, 190, 40))
		return
	end
	local petText = string.format('<font color="#%s">%s %s</font>', hex, Lang.rarity(data.rarity), Lang.pet(data.pet, data.tier))
	Toasts.banner(Lang.t("announce.hatch", { player = data.player, pet = petText, chance = chance }), c)
end

function Toasts.init()
	Net.event("Notify").OnClientEvent:Connect(function(message, kind)
		Toasts.show(Lang.msg(message), kind)
	end)
	Net.event("Toast").OnClientEvent:Connect(function(data)
		Toasts.announce(data)
	end)
end

return Toasts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">Windows</string>
              <string name="Source"><![CDATA[--!strict
-- Window manager: one modal window at a time, pop-in animation, shared chrome (shadow,
-- glossy header, icon medallion, close button) and a dim layer over the world.
local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)
local Root = require(script.Parent.Root)
local Lang = require(script.Parent.Parent.Lang)

local Windows = {}

export type Window = {
	name: string,
	frame: Frame,
	body: Frame,
	onOpen: (() -> ())?,
	onClose: (() -> ())?,
}

local windows: { [string]: Window } = {}
local current: string? = nil
local changed = Instance.new("BindableEvent")
Windows.Changed = changed.Event

-- Dim layer between the world and the HUD while a window is open. It lives in its own
-- full-screen ScreenGui below the main UI, so the HUD stays bright and clickable (you can
-- jump straight to another window). Clicking the dim closes the window.
local dimGui = Theme.new("ScreenGui", {
	Name = "TapPetsDim",
	ResetOnSpawn = false,
	ScreenInsets = Enum.ScreenInsets.None,
	DisplayOrder = -1,
	Parent = Root.gui.Parent,
}) :: ScreenGui
local dim = Theme.new("TextButton", {
	Name = "Dim",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.fromRGB(18, 12, 34),
	BackgroundTransparency = 1,
	Text = "",
	AutoButtonColor = false,
	Visible = false,
	Parent = dimGui,
}) :: TextButton

local function setDim(on: boolean)
	if on then
		dim.Visible = true
		TweenService:Create(dim, TweenInfo.new(0.18), { BackgroundTransparency = 0.5 }):Play()
	else
		local t = TweenService:Create(dim, TweenInfo.new(0.15), { BackgroundTransparency = 1 })
		t:Play()
		t.Completed:Once(function()
			if current == nil then
				dim.Visible = false
			end
		end)
	end
end

-- Creates window chrome and returns it; the caller fills `body`. titleKey is a translation key.
-- canvasH: on touch the body becomes a vertical ScrollingFrame with this canvas height (design
-- px), because phone windows are only ~270 px of body tall; ignored on PC.
function Windows.create(name: string, icon: string, titleKey: string, color: Color3, size: Vector2?, canvasH: number?): Window
	local sz = size or Vector2.new(720, 470)
	if Root.isTouch then
		-- Phones are ~330 px tall once the topbar is out: compact window (scaled 0.8 by Root).
		sz = Vector2.new(math.min(sz.X, 780), math.min(sz.Y, 350))
	end
	local frame = Theme.panel({
		Name = name .. "Window",
		Size = UDim2.fromOffset(sz.X, sz.Y),
		Position = UDim2.fromScale(0.5, if Root.isTouch then 0.5 else 0.52),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		ZIndex = 20,
		Parent = Root.gui,
		Corner = 22,
		StrokeThickness = 4,
	})
	Theme.new("UIScale", { Parent = frame })
	Root.mount(frame)
	Theme.shadow(frame, 22)
	local header = Theme.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 21,
		Parent = frame,
	}, { Theme.corner(22), Theme.gradient(Theme.lighten(color, 0.3), color) })
	-- square off the header's bottom corners
	Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.new(0, 0, 1, -22),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 21,
		Parent = header,
	}, { Theme.gradient(Theme.lighten(color, 0.04), Theme.darken(color, 0.08)) })
	Theme.gloss(header, 22, 0.82)
	-- dark rule under the header
	Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 4),
		Position = UDim2.new(0, 0, 1, -2),
		BackgroundColor3 = Theme.Ink,
		BorderSizePixel = 0,
		ZIndex = 22,
		Parent = header,
	})
	-- icon medallion poking out of the top-left corner
	local medal = Theme.new("Frame", {
		Name = "Medal",
		Size = UDim2.fromOffset(70, 70),
		Position = UDim2.fromOffset(-16, -18),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 23,
		Parent = frame,
	}, { Theme.corner(35), Theme.stroke(4), Theme.gradient(Theme.White, Theme.lighten(color, 0.55)) })
	Theme.icon(icon, { Size = UDim2.fromScale(0.66, 0.66), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 24, Parent = medal })
	local titleLabel = Theme.text({
		Text = "",
		Size = UDim2.new(1, -210, 0, 42),
		Position = UDim2.new(0, 68, 0, 7),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 36,
		Stroke = 3,
		Parent = header,
	})
	titleLabel.ZIndex = 22
	local function setTitle()
		titleLabel.Text = Lang.t(titleKey)
	end
	setTitle()
	Lang.Changed:Connect(setTitle)
	local close = Theme.button({
		Text = "X",
		Color = Theme.Red,
		Size = UDim2.fromOffset(56, 56),
		Position = UDim2.new(1, 16, 0, -16),
		AnchorPoint = Vector2.new(1, 0),
		Corner = 28,
		Parent = frame,
		OnClick = function()
			Windows.close()
		end,
	})
	close.ZIndex = 30
	for _, d in close:GetDescendants() do
		if d:IsA("GuiObject") then
			d.ZIndex = 31
		end
	end
	local body: Frame
	if Root.isTouch and canvasH then
		body = Theme.new("ScrollingFrame", {
			Name = "Body",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.new(1, -20, 1, -72),
			Position = UDim2.new(0, 10, 0, 64),
			CanvasSize = UDim2.new(0, 0, 0, canvasH),
			ScrollBarThickness = 6,
			ScrollBarImageColor3 = Theme.Ink,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ZIndex = 21,
			Parent = frame,
		}) :: any
	else
		body = Theme.new("Frame", {
			Name = "Body",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -28, 1, -76),
			Position = UDim2.new(0, 14, 0, 64),
			ZIndex = 21,
			Parent = frame,
		}) :: Frame
	end
	local w: Window = { name = name, frame = frame, body = body }
	windows[name] = w
	return w
end

function Windows.isOpen(name: string): boolean
	return current == name
end

function Windows.close()
	if not current then
		return
	end
	local w = windows[current]
	current = nil
	if w then
		local s = w.frame:FindFirstChildOfClass("UIScale") :: UIScale
		local t = TweenService:Create(s, TweenInfo.new(0.12), { Scale = 0.85 })
		t:Play()
		t.Completed:Once(function()
			if current ~= w.name then
				w.frame.Visible = false
			end
		end)
		if w.onClose then
			w.onClose()
		end
	end
	setDim(false)
	changed:Fire(nil)
end

function Windows.open(name: string)
	if current == name then
		return
	end
	if current then
		local prev = windows[current]
		if prev then
			prev.frame.Visible = false
			if prev.onClose then
				prev.onClose()
			end
		end
	end
	local w = windows[name]
	if not w then
		return
	end
	current = name
	local s = w.frame:FindFirstChildOfClass("UIScale") :: UIScale
	s.Scale = 0.6
	w.frame.Visible = true
	TweenService:Create(s, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	setDim(true)
	Theme.play("open", 0.3)
	if w.onOpen then
		w.onOpen()
	end
	changed:Fire(name)
end

function Windows.toggle(name: string)
	if current == name then
		Windows.close()
	else
		Windows.open(name)
	end
end

dim.Activated:Connect(function()
	Windows.close()
end)

return Windows
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">WorldFx</string>
            <string name="Source"><![CDATA[--!strict
-- Local world effects:
--  * eggs spin and bob, and jump with a burst of sparkles when the player hatches one
--  * gates the player owns open (with a burst the moment they are bought)
--  * every zone has its own sky: clock, light, Atmosphere, clouds, colour grade and
--    drifting particles (pollen, sugar, snow, embers, stardust) around the camera
--  * world props tagged "TpsAnim" spin / bob (windmill, UFO, planets, balloons, lanterns)
--  * the "entering zone" banner
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Palette = require(ReplicatedStorage.Shared.Palette)
local Net = require(script.Parent.Net)
local Theme = require(script.Parent.UI.Theme)
local Root = require(script.Parent.UI.Root)
local Lang = require(script.Parent.Lang)
local Quality = require(script.Parent.Quality)

local WorldFx = {}

local C = Color3.fromRGB
local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

---------------------------------------------------------------------------
-- Per-zone look
---------------------------------------------------------------------------
type ZoneLook = {
	clock: number,
	brightness: number,
	ambient: Color3,
	outdoor: Color3,
	atmosphere: { Density: number, Offset: number, Haze: number, Glare: number, Color: Color3, Decay: Color3 },
	tint: Color3,
	saturation: number,
	contrast: number,
	cloudCover: number,
	cloudColor: Color3,
	weather: string,
}

local LOOKS: { ZoneLook } = {
	{ -- Spawn Meadow: clear summer afternoon
		clock = 14.2,
		brightness = 2.4,
		ambient = C(120, 120, 125),
		outdoor = C(150, 158, 160),
		atmosphere = { Density = 0.28, Offset = 0.1, Haze = 1.2, Glare = 0.2, Color = C(205, 225, 255), Decay = C(150, 190, 255) },
		tint = C(255, 252, 242),
		saturation = 0.12,
		contrast = 0.05,
		cloudCover = 0.55,
		cloudColor = C(255, 255, 255),
		weather = "pollen",
	},
	{ -- Candy Land: pink golden hour
		clock = 16.4,
		brightness = 2.5,
		ambient = C(150, 120, 140),
		outdoor = C(180, 150, 170),
		atmosphere = { Density = 0.32, Offset = 0.2, Haze = 1.8, Glare = 0.35, Color = C(255, 205, 232), Decay = C(255, 160, 210) },
		tint = C(255, 232, 246),
		saturation = 0.2,
		contrast = 0.04,
		cloudCover = 0.7,
		cloudColor = C(255, 195, 228),
		weather = "sugar",
	},
	{ -- Frost Peak: cold overcast noon, snowing
		clock = 11.2,
		brightness = 2,
		ambient = C(130, 145, 165),
		outdoor = C(160, 175, 195),
		atmosphere = { Density = 0.42, Offset = 0.25, Haze = 2.4, Glare = 0.1, Color = C(222, 236, 255), Decay = C(190, 215, 255) },
		tint = C(226, 240, 255),
		saturation = -0.05,
		contrast = 0.04,
		cloudCover = 0.86,
		cloudColor = C(235, 242, 255),
		weather = "snow",
	},
	{ -- Lava Caves: red dusk under smoke
		clock = 17.6,
		brightness = 2.2,
		ambient = C(170, 95, 75),
		outdoor = C(175, 105, 85),
		atmosphere = { Density = 0.36, Offset = 0.3, Haze = 2.2, Glare = 0.5, Color = C(255, 135, 75), Decay = C(150, 45, 20) },
		tint = C(255, 208, 184),
		saturation = 0.15,
		contrast = 0.12,
		cloudCover = 0.9,
		cloudColor = C(85, 50, 48),
		weather = "embers",
	},
	{ -- Cosmic Void: night, stars
		clock = 0,
		brightness = 2,
		ambient = C(150, 132, 215),
		outdoor = C(140, 124, 208),
		atmosphere = { Density = 0.3, Offset = 0, Haze = 1, Glare = 0, Color = C(95, 72, 165), Decay = C(40, 20, 90) },
		tint = C(218, 208, 255),
		saturation = 0.2,
		contrast = 0.08,
		cloudCover = 0.18,
		cloudColor = C(125, 95, 205),
		weather = "stardust",
	},
}

---------------------------------------------------------------------------
-- Eggs
---------------------------------------------------------------------------
type EggSpin = { id: string, shell: BasePart, base: CFrame, parts: { { part: BasePart, offset: CFrame } }, phase: number, burstAt: number, sparkle: ParticleEmitter? }

local eggList: { EggSpin } = {}

-- Egg models are streamed whole (Atomic), so they come and go as the player moves between
-- zones. The shell's resting CFrame is an attribute, because this script moves the shell.
local addEgg: (model: Instance) -> ()
function addEgg(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local shell = model:FindFirstChild("Shell") :: BasePart?
	if not shell then
		-- the model arrived before its parts: try again when the shell shows up
		task.spawn(function()
			if model:WaitForChild("Shell", 10) then
				addEgg(model)
			end
		end)
		return
	end
	local id = (model:GetAttribute("EggId") :: string?) or ""
	for _, e in eggList do
		if e.shell == shell then
			return
		end
	end
	local rest = shell:GetAttribute("Rest")
	local base = if typeof(rest) == "CFrame" then rest else shell.CFrame
	local parts = {}
	for _, d in model:GetChildren() do
		if d:IsA("BasePart") and d.Name == "Spot" then
			local off = d:GetAttribute("Offset")
			table.insert(parts, { part = d, offset = if typeof(off) == "CFrame" then off else base:ToObjectSpace(d.CFrame) })
		end
	end
	local sparkle = shell:FindFirstChild("Sparkle")
	table.insert(eggList, {
		id = id,
		shell = shell,
		base = base,
		parts = parts,
		phase = #id * 0.7,
		burstAt = -10,
		sparkle = if sparkle and sparkle:IsA("ParticleEmitter") then sparkle else nil,
	})
end

local function removeEgg(model: Instance)
	for i = #eggList, 1, -1 do
		if eggList[i].shell.Parent == model or not eggList[i].shell.Parent then
			table.remove(eggList, i)
		end
	end
end

local function collectEggs()
	local world = Workspace:WaitForChild("World", 30)
	local eggs = world and world:WaitForChild("Eggs", 30)
	if not eggs then
		return
	end
	for _, model in eggs:GetChildren() do
		addEgg(model)
	end
	eggs.ChildAdded:Connect(addEgg)
	eggs.ChildRemoved:Connect(removeEgg)
end

-- Eggs currently tracked (streamed in).
function WorldFx.eggCount(): number
	return #eggList
end

-- The world egg jumps and throws sparkles (called when its shell bursts in the cinematic).
function WorldFx.eggBurst(eggId: string)
	for _, e in eggList do
		if e.id == eggId then
			e.burstAt = os.clock()
			if e.sparkle then
				e.sparkle:Emit(36)
			end
		end
	end
end

local function zoneAt(z: number): number
	local L = Config.ZoneLength
	return math.clamp(math.floor((z + L / 2) / L) + 1, 1, #Config.Zones)
end

---------------------------------------------------------------------------
-- Tagged props
---------------------------------------------------------------------------
type Animated = { inst: PVInstance, base: CFrame, axis: Vector3?, speed: number, bobAmp: number, bobSpeed: number, phase: number }

local animated: { Animated } = {}

local function addAnimated(inst: Instance)
	if not inst:IsA("PVInstance") then
		return
	end
	for _, a in animated do
		if a.inst == inst then
			return
		end
	end
	local axis = inst:GetAttribute("SpinAxis")
	local rest = inst:GetAttribute("Rest")
	table.insert(animated, {
		inst = inst,
		base = if typeof(rest) == "CFrame" then rest else inst:GetPivot(),
		axis = if typeof(axis) == "Vector3" then axis else nil,
		speed = (inst:GetAttribute("SpinSpeed") :: number?) or 0,
		bobAmp = (inst:GetAttribute("BobAmp") :: number?) or 0,
		bobSpeed = (inst:GetAttribute("BobSpeed") :: number?) or 1,
		phase = #animated * 0.9,
	})
end

---------------------------------------------------------------------------
-- Weather: emitters in a box that follows the camera
---------------------------------------------------------------------------
local function weatherEmitters(): ({ [string]: ParticleEmitter }, BasePart, BasePart)
	local function box(name: string, size: Vector3): BasePart
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Transparency = 1
		p.Size = size
		p.Parent = Workspace
		return p
	end
	local sky = box("WeatherSky", Vector3.new(110, 1, 110)) -- above the camera: things that fall
	local near = box("WeatherNear", Vector3.new(90, 36, 90)) -- around the camera: things that float
	local k = Quality.particles
	local function make(parent: BasePart, texture: string, color: ColorSequence, rate: number, size: number, life: number, speed: number, dir: Enum.NormalId, accel: Vector3, emission: number): ParticleEmitter
		local e = Instance.new("ParticleEmitter")
		e.Texture = texture
		e.Color = color
		e.Rate = rate * k
		e.Lifetime = NumberRange.new(life * 0.7, life)
		e.Speed = NumberRange.new(speed * 0.6, speed)
		e.EmissionDirection = dir
		e.Acceleration = accel
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.15, size), NumberSequenceKeypoint.new(0.85, size), NumberSequenceKeypoint.new(1, 0) })
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.15, 0.15), NumberSequenceKeypoint.new(0.8, 0.25), NumberSequenceKeypoint.new(1, 1) })
		e.LightEmission = emission
		e.RotSpeed = NumberRange.new(-60, 60)
		e.Rotation = NumberRange.new(0, 360)
		e.SpreadAngle = Vector2.new(25, 25)
		e.Enabled = false
		e.Parent = parent
		return e
	end
	local list: { [string]: ParticleEmitter } = {
		pollen = make(near, SPARKLES, ColorSequence.new(C(255, 250, 200)), 7, 0.45, 6, 1.2, Enum.NormalId.Top, Vector3.new(0.6, 0.2, 0), 0.6),
		sugar = make(near, SPARKLES, ColorSequence.new(C(255, 170, 215), C(190, 235, 255)), 12, 0.6, 5, 2, Enum.NormalId.Bottom, Vector3.new(0.5, -0.6, 0), 0.7),
		snow = make(sky, SMOKE, ColorSequence.new(C(255, 255, 255)), 85, 0.42, 5.5, 13, Enum.NormalId.Bottom, Vector3.new(2.5, 0, 0.8), 0.4),
		embers = make(near, FIRE, ColorSequence.new(C(255, 170, 60), C(255, 80, 20)), 30, 0.5, 3.2, 6, Enum.NormalId.Top, Vector3.new(1, 3, 0), 1),
		stardust = make(near, SPARKLES, ColorSequence.new(C(200, 225, 255), C(215, 170, 255)), 16, 0.55, 4.5, 0.6, Enum.NormalId.Top, Vector3.new(0, 0.1, 0), 1),
	}
	return list, sky, near
end

---------------------------------------------------------------------------
function WorldFx.init()
	-- Eggs + tagged props + weather boxes, all in one render step
	local weather, skyBox, nearBox = weatherEmitters()
	task.spawn(function()
		collectEggs()
		Workspace:WaitForChild("World", 30)
		for _, inst in CollectionService:GetTagged("TpsAnim") do
			addAnimated(inst)
		end
		CollectionService:GetInstanceAddedSignal("TpsAnim"):Connect(addAnimated)
		-- streamed out: forget it (it is added again, at rest, when it streams back in)
		CollectionService:GetInstanceRemovedSignal("TpsAnim"):Connect(function(inst: Instance)
			for i = #animated, 1, -1 do
				if (animated[i].inst :: Instance) == inst then
					table.remove(animated, i)
				end
			end
		end)
	end)
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local camera = Workspace.CurrentCamera
		local camPos = if camera then camera.CFrame.Position else Vector3.zero
		for _, e in eggList do
			if not e.shell.Parent then
				continue
			end
			local hop = 0
			local since = t - e.burstAt
			if since < 0.6 then
				hop = math.sin(since / 0.6 * math.pi) * 2.2
			end
			local cf = e.base * CFrame.new(0, math.sin(t * 1.6 + e.phase) * 0.35 + hop, 0) * CFrame.Angles(0, t * 0.6 + e.phase + (if since < 0.6 then (1 - math.cos(since / 0.6 * math.pi)) * math.pi else 0), 0)
			e.shell.CFrame = cf
			for _, sp in e.parts do
				sp.part.CFrame = cf * sp.offset
			end
		end
		local animRange = if Quality.lite then 260 else 520
		for _, a in animated do
			if a.inst.Parent and (a.base.Position - camPos).Magnitude < animRange then
				local cf = a.base
				if a.bobAmp ~= 0 then
					cf = CFrame.new(0, math.sin(t * a.bobSpeed + a.phase) * a.bobAmp, 0) * cf
				end
				if a.axis then
					cf *= CFrame.fromAxisAngle(a.axis, t * a.speed)
				end
				a.inst:PivotTo(cf)
			end
		end
		skyBox.CFrame = CFrame.new(camPos + Vector3.new(0, 34, 0))
		nearBox.CFrame = CFrame.new(camPos + Vector3.new(0, 6, 0))
	end)

	-- Gates
	local known: { [number]: boolean }? = nil
	local function refreshGates()
		local s = Net.state
		local world = Workspace:FindFirstChild("World")
		local gates = world and world:FindFirstChild("Gates")
		if not s or not gates then
			return
		end
		local first = known == nil
		local now: { [number]: boolean } = {}
		for _, gate in gates:GetChildren() do
			local barrier = gate:FindFirstChild("Barrier") :: BasePart?
			if barrier then
				local zone = barrier:GetAttribute("Zone") :: number
				local open = table.find(s.zones, zone) ~= nil
				now[zone] = open
				barrier.CanCollide = not open
				barrier.Transparency = if open then 1 else 0.2
				for _, d in barrier:GetChildren() do
					if d:IsA("SurfaceGui") then
						d.Enabled = not open
					elseif d:IsA("ProximityPrompt") then
						d.Enabled = not open
					end
				end
				-- just bought: burst of sparkles where the barrier was
				if open and not first and known and not known[zone] then
					local burst = barrier:FindFirstChild("Unlock")
					if burst and burst:IsA("ParticleEmitter") then
						burst:Emit(90)
					end
					Theme.play("boom", 0.2, 1.4)
				end
			end
		end
		known = now
	end
	Net.Changed:Connect(function(kind)
		if kind == "full" then
			refreshGates()
		end
	end)
	task.spawn(function()
		local world = Workspace:WaitForChild("World", 30)
		local gates = world and world:WaitForChild("Gates", 30)
		refreshGates()
		if gates then
			-- gates stream in as the player gets near them
			gates.ChildAdded:Connect(function()
				task.defer(refreshGates)
			end)
		end
	end)

	-- Lite profile: no real-time shadows or post-processing (they are a bonus, never the
	-- base of the look), half the weather.
	local function applyProfile()
		Lighting.GlobalShadows = Quality.shadows
		for _, fx in Lighting:GetChildren() do
			if fx:IsA("BloomEffect") or fx:IsA("SunRaysEffect") or fx:IsA("DepthOfFieldEffect") then
				fx.Enabled = Quality.shadows
			end
		end
	end
	applyProfile()
	Quality.Changed:Connect(applyProfile)

	-- Ambience + banner
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "ZoneTint"
	cc.Parent = Lighting
	local banner = Theme.text({
		Text = "",
		Size = UDim2.fromOffset(700, 80),
		Position = UDim2.fromScale(0.5, 0.26),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = 72,
		Stroke = 4,
		TextTransparency = 1,
		Parent = Root.gui,
	})
	Root.mount(banner)
	local bannerStroke = banner:FindFirstChildOfClass("UIStroke") :: UIStroke
	bannerStroke.Transparency = 1
	local currentZone = 0

	local clock = Instance.new("NumberValue")
	clock.Value = Lighting.ClockTime
	clock.Changed:Connect(function(v)
		Lighting.ClockTime = v % 24
	end)

	local function applyLook(z: number, seconds: number)
		local look = LOOKS[z] or LOOKS[1]
		local info = TweenInfo.new(seconds, Enum.EasingStyle.Sine)
		TweenService:Create(Lighting, info, { Brightness = look.brightness, Ambient = look.ambient, OutdoorAmbient = look.outdoor }):Play()
		-- the clock takes the short way round (18:00 -> 00:00 goes through the evening, not back through noon)
		local from = Lighting.ClockTime
		local to = look.clock
		if to - from > 12 then
			from += 24
		elseif from - to > 12 then
			to += 24
		end
		clock.Value = from
		TweenService:Create(clock, info, { Value = to }):Play()
		TweenService:Create(cc, info, { TintColor = look.tint, Saturation = look.saturation, Contrast = look.contrast }):Play()
		local atm = Lighting:FindFirstChildOfClass("Atmosphere")
		if atm then
			TweenService:Create(atm, info, look.atmosphere :: any):Play()
		end
		local terrain = Workspace:FindFirstChildOfClass("Terrain")
		local clouds = terrain and terrain:FindFirstChildOfClass("Clouds")
		if clouds then
			TweenService:Create(clouds, info, { Cover = look.cloudCover, Color = look.cloudColor }):Play()
		end
		for name, e in weather do
			e.Enabled = name == look.weather
		end
	end

	task.spawn(function()
		while true do
			local char = Players.LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local z = zoneAt(root.Position.Z)
				if z ~= currentZone then
					local first = currentZone == 0
					currentZone = z
					local zone = Config.Zones[z]
					applyLook(z, if first then 0 else 2.5)
					if not first then
						banner.Text = Lang.upper(Lang.zone(z))
						banner.TextColor3 = Theme.lighten(Palette.rgb(zone.ground), 0.3)
						Theme.pop(banner, 1.3)
						TweenService:Create(banner, TweenInfo.new(0.4), { TextTransparency = 0 }):Play()
						TweenService:Create(bannerStroke, TweenInfo.new(0.4), { Transparency = 0 }):Play()
						task.delay(2, function()
							if currentZone == z then
								TweenService:Create(banner, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
								TweenService:Create(bannerStroke, TweenInfo.new(0.6), { Transparency = 1 }):Play()
							end
						end)
					end
				end
			end
			task.wait(0.5)
		end
	end)
end

return WorldFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">WorldText</string>
            <string name="Source"><![CDATA[--!strict
-- Localizes the world text the server builds (egg labels, gate signs, leaderboard titles,
-- proximity prompts). The server tags each TextLabel with a Loc* attribute; this module
-- rewrites it in the player's language and again whenever the language changes.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Formulas = require(ReplicatedStorage.Shared.Formulas)
local Lang = require(script.Parent.Lang)
local Net = require(script.Parent.Net)

local WorldText = {}

local function render(obj: Instance)
	if obj:IsA("TextLabel") then
		local eggId = obj:GetAttribute("LocEgg")
		local gate = obj:GetAttribute("LocGate")
		local zone = obj:GetAttribute("LocZone")
		local key = obj:GetAttribute("LocKey")
		if type(eggId) == "string" then
			local egg = Formulas.EggById[eggId]
			if egg then
				local state = Net.state
				local need = Formulas.eggMinRebirths(eggId)
				local price = if egg.exclusive
					then ('<font color="#7CFF7C">' .. Lang.t("world.robux_exclusive") .. "</font>")
					elseif state and (state.rebirths or 0) < need then ('<font color="#FF8A8A">' .. Lang.t("world.egg_locked", { n = need }) .. "</font>")
					else Lang.t("world.price_taps", { n = Format.abbrev(egg.price) })
				obj.Text = string.format('%s\n<font color="#FFE066">%s</font>', Lang.egg(eggId), price)
			end
		elseif type(gate) == "number" and Config.Zones[gate] then
			obj.Text = Lang.t("world.gate_locked") .. "\n" .. Lang.t("world.price_taps", { n = Format.abbrev(Config.Zones[gate].cost) })
		elseif type(zone) == "number" then
			obj.Text = Lang.upper(Lang.zone(zone))
		elseif type(key) == "string" then
			obj.Text = Lang.t(key)
		end
	elseif obj:IsA("ProximityPrompt") then
		local eggId = obj:GetAttribute("EggId")
		local zone = obj:GetAttribute("Zone")
		if obj:GetAttribute("Chest") then
			obj.ActionText = Lang.t("prompt.collect")
			obj.ObjectText = Lang.t("park.chest_name")
		elseif type(eggId) == "string" then
			obj.ActionText = Lang.t("prompt.open")
			obj.ObjectText = Lang.egg(eggId)
		elseif type(zone) == "number" and Config.Zones[zone] then
			obj.ActionText = Lang.t("prompt.unlock", { cost = Format.abbrev(Config.Zones[zone].cost) })
			obj.ObjectText = Lang.zone(zone)
		end
	end
end

function WorldText.init()
	task.spawn(function()
		local world = Workspace:WaitForChild("World", 60)
		if not world then
			return
		end
		local function all()
			for _, d in world:GetDescendants() do
				render(d)
			end
		end
		all()
		-- leaderboard rows are rebuilt every minute
		world.DescendantAdded:Connect(function(d)
			task.defer(render, d)
		end)
		Lang.Changed:Connect(all)
		-- rebirth-gated egg signs flip from "locked" to the price when the player rebirths
		local lastRebirths = -1
		Net.Changed:Connect(function(kind)
			local r = (Net.get("rebirths") :: number?) or 0
			if kind == "full" and r ~= lastRebirths then
				lastRebirths = r
				all()
			end
		end)
	end)
end

return WorldText
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="89">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">true</bool>
      <int name="StreamingMinRadius">128</int>
      <int name="StreamingTargetRadius">512</int>
    </Properties>
  </Item>
</roblox>