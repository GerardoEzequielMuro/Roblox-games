	["menu.Pets"] = "Evcil Hayvanlar",
	["menu.Upgrades"] = "Yükseltmeler",
	["menu.Rebirth"] = "Yeniden Doğuş",
	["menu.Store"] = "Mağaza",
	["menu.Rewards"] = "Ödüller",
	["menu.Index"] = "Dizin",
	["menu.Teleport"] = "Işınlan",
	["menu.Codes"] = "Kodlar",

	-- toasts built on the client
	["toast.autohatch_hint"] = "Bir yumurta aç ve başlamak için Oto'ya bas",
	["toast.got_taps"] = "+{n} Tık!",
	["toast.got_gems"] = "+{n} Elmas!",
	["toast.got_luck"] = "Süper Şans +{n} dk!",
	["toast.coming_soon"] = "{item} yakında geliyor!",
	["toast.deleted"] = "{n} evcil hayvan silindi",
	["toast.deleted1"] = "1 evcil hayvan silindi",
	["toast.pet_locked"] = "Bu evcil hayvan kilitli",
	["toast.upgraded"] = "{name} yükseltildi!",
	["toast.not_enough_taps"] = "Henüz yeterli Tık yok!",
	["toast.language"] = "Dil: {name}",
	["toast.connection"] = "Bağlantı sorunu",

	-- windows
	["win.pets"] = "Evcil Hayvanlar",
